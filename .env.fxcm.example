# ========== FXCM Configuration (Primary Data Source) ==========
# Get token from: https://www.fxcm.com/markets/demo-account/
# After signup: Trading Station → Account → API Access → Generate Token

FXCM_API_TOKEN=your_fxcm_demo_token_here
FXCM_ENVIRONMENT=demo  # or 'live' for real account

# ========== MetaApi Configuration (Fallback) ==========
# Only needed if FXCM fails or unavailable

META_API_TOKEN=your_metaapi_token_here
META_API_ACCOUNT_ID=your_metaapi_account_id_here

# Or use Vantage-specific credentials
META_API_TOKEN_VANTAGE=your_vantage_token
META_API_ACCOUNT_ID_VANTAGE=your_vantage_account

# ========== Application Settings ==========

# Logging level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Data cache directory
DATA_CACHE_DIR=data/backtest_candles

# Backtest output directory
BACKTEST_OUTPUT_DIR=data/backtest

# ========== Strategy Defaults ==========

# Risk per trade (%)
DEFAULT_RISK_PERCENT=0.5

# Account size (USD)
DEFAULT_ACCOUNT_SIZE=50000

# Max position size (lots)
DEFAULT_MAX_LOT_SIZE=10.0

# Stop loss buffer (pips)
DEFAULT_SL_BUFFER_PIPS=1.0

# Min risk/reward ratio
DEFAULT_MIN_RR_RATIO=2.0

# ========== Execution Settings ==========

# Execution mode: 'close' or 'next_open'
# close: Fill at bar N close (TradingView default)
# next_open: Fill at bar N+1 open (more realistic)
EXECUTION_MODE=close

# Slippage (ticks)
DEFAULT_SLIPPAGE_TICKS=3

# Commission (%)
DEFAULT_COMMISSION_PCT=0.0

# ========== Development ==========

# Enable debug mode (verbose logging)
DEBUG=false

# Disable Numba JIT (for debugging)
NUMBA_DISABLE_JIT=0

# ========== Notes ==========
# 1. Copy this file to `.env` and fill in your credentials
# 2. Never commit `.env` to Git (already in .gitignore)
# 3. For production, use environment-specific files:
#    - .env.development
#    - .env.production
# 4. FXCM is recommended for Israel/Middle East (low latency)
# 5. All timestamps are UTC (no timezone conversion needed)
