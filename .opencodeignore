# ═══════════════════════════════════════════════════════════════
# OpenCode Context Exclusions
# ═══════════════════════════════════════════════════════════════
# Philosophy: Exclude EVERYTHING from indexing. Agent reads files
# on-demand using MODULE_MAP.md. Only AGENTS.md (loaded via
# opencode.json instructions) and root metadata are indexed.
# ═══════════════════════════════════════════════════════════════

# ── ALL source code (read on demand via MODULE_MAP) ──
src/**
config/**
scripts/**
frontend/**
tests/**

# ── Agent tooling (other agents' workspace data) ──
.antigravity/**
.gstack/**
.claude/**
.agents/**
.ralph/**
.bg-shell/**
.opencode/**

# ── Planning docs (read on demand) ──
.planning/**

# ── ML + Data ──
ml/**
data/**
migrations/**

# ── Logs ──
logs/**

# ── Docs ──
docs/**

# ── Workspaces ──
.workspaces/**

# ── Secrets ──
.env
.env.*
!.env.example

# ── Build / deploy artifacts ──
Dockerfile*
docker-compose.yml
nixpacks*.toml
railway.json
Makefile
install-services.sh
start.sh

# ── Binary and generated formats ──
**/*.csv
**/*.parquet
**/*.log
**/*.lock
**/*.pkl
**/*.rdb
**/*.pyc
**/*.pyc

# ── Runtime caches ──
.venv/**
venv/**
node_modules/**
__pycache__/**
.next/**
.pytest_cache/**
.ruff_cache/**
.mypy_cache/**