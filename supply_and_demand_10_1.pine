// Helper: safe percentage (returns 0.0 instead of na to avoid NaN in tables)
safe_percent(wins, total) =>
    total > 0 ? (wins * 100.0) / total : 0.0

// Helper: bucket symbol type for RR stats
get_symbol_bucket() =>
    sym = syminfo.ticker
    if str.contains(sym, "XAU")
        "XAU"
    else if str.contains(sym, "JPY")
        "JPY"
    else
        "OTHER"

// === PERFORMANCE TABLE STATE & RENDERER ===
var table performanceTable = na

draw_performance_table(tbl) =>
    table result = tbl

    if show_performance_table and barstate.islastconfirmedhistory
        if na(result)
            // Compact 5-row table with professional dark theme
            result := table.new(position.top_right, 2, 6, 
                 bgcolor = color.new(color.rgb(30, 35, 40), 5), 
                 border_width = 1, border_color = color.new(color.white, 70), 
                 frame_width = 1, frame_color = color.new(color.white, 70))

        if not na(result)
            // === BUILT-IN STRATEGY METRICS ===
            float net_profit = strategy.netprofit
            int total_closed = strategy.closedtrades
            int total_open = strategy.opentrades
            int total_trades = total_closed + total_open
            float gross_profit = strategy.grossprofit
            float gross_loss = math.abs(strategy.grossloss)
            float max_dd = strategy.max_drawdown
            int win_trades = strategy.wintrades
            
            // Calculate derived metrics with divide-by-zero protection
            float win_rate = total_closed > 0 ? (float(win_trades) / float(total_closed)) * 100 : 0.0
            float profit_factor = gross_loss > 0 ? gross_profit / gross_loss : (gross_profit > 0 ? 999.99 : 0.0)
            
            // Color for Net Profit (green if positive, red if negative)
            color profit_color = net_profit >= 0 ? color.rgb(0, 200, 100) : color.rgb(255, 80, 80)
            
            // === HEADER ===
            table.cell(result, 0, 0, "📊 RESULTS", text_color = color.white, bgcolor = color.rgb(40, 40, 40), text_size = size.small, text_halign = text.align_left)
            table.cell(result, 1, 0, "", bgcolor = color.rgb(40, 40, 40))
            
            // === 1. NET PROFIT ===
            table.cell(result, 0, 1, "Net Profit", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            string profit_str = (net_profit >= 0 ? "$" : "-$") + str.tostring(math.abs(net_profit), "#,##0.00")
            table.cell(result, 1, 1, profit_str, text_color = profit_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)
            
            // === 2. TOTAL TRADES ===
            table.cell(result, 0, 2, "Total Trades", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            table.cell(result, 1, 2, str.tostring(total_trades), text_color = color.rgb(200, 200, 200), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)
            
            // === 3. WIN RATE ===
            table.cell(result, 0, 3, "Win Rate", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            string wr_str = str.tostring(win_rate, "#.00") + "% (" + str.tostring(win_trades) + "/" + str.tostring(total_closed) + ")"
            color wr_color = win_rate >= 50 ? color.rgb(0, 200, 100) : color.rgb(255, 180, 80)
            table.cell(result, 1, 3, wr_str, text_color = wr_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)
            
            // === 4. PROFIT FACTOR ===
            table.cell(result, 0, 4, "Profit Factor", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            string pf_str = gross_loss > 0 ? str.tostring(profit_factor, "#.00") : (gross_profit > 0 ? "∞" : "N/A")
            color pf_color = profit_factor >= 1.5 ? color.rgb(0, 200, 100) : (profit_factor >= 1.0 ? color.rgb(255, 180, 80) : color.rgb(255, 80, 80))
            table.cell(result, 1, 4, pf_str, text_color = pf_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)
            
            // === 5. MAX DRAWDOWN ===
            table.cell(result, 0, 5, "Max Drawdown", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            string dd_str = "-$" + str.tostring(math.abs(max_dd), "#,##0.00")
            table.cell(result, 1, 5, dd_str, text_color = color.rgb(255, 100, 100), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)

    result

// === POSITION SIZING TRACKING (for debug table) ===
var int   last_pos_size_units    = na  // Last calculated position size in units
var float last_pos_size_lots     = na  // Last calculated position size in lots
var float last_pos_size_entry    = na  // Last entry price used for position sizing
var float last_pos_size_sl       = na  // Last stop loss used for position sizing
var float last_pos_size_balance  = na  // Last account balance used
var float last_pos_size_risk_pct = na  // Last risk percentage used
var float last_pos_size_sl_pips  = na  // Last SL in pips
var float last_pos_size_usdjpy_rate = na  // Last USDJPY rate (if applicable)
var bool  last_pos_size_valid    = false  // Whether last position size was valid
var string last_pos_size_error   = ""  // Last position size error message
var bool  last_pos_size_dry_run  = false  // Whether last sizing was in dry run mode

// Pending long entry (for next-bar execution, non-repainting)
var bool  long_signal_pending    = false
var float long_pending_sl_price  = na
var float long_pending_tp_price  = na
var float long_pending_sl_pips   = na
var string long_pending_entry_type = na  // Entry type: "DIR LONG", "BOC LONG", "FLIP LONG"

// Pending short entry (for next-bar execution, non-repainting)
var bool  short_signal_pending   = false
var float short_pending_sl_price = na
var float short_pending_tp_price = na
var float short_pending_sl_pips  = na

// One global guard: only one long entry per bar
// One global guard: only one long/short entry per bar
var int last_global_long_entry_bar = na
var int last_global_short_entry_bar = na

// === ENTRY TRIGGER SYNC FLAG (for Zone Inspector synchronization) ===
// This flag is set to true when an entry is triggered, BEFORE the zone is marked inactive
// Reset at the start of each bar to ensure accurate display
var bool entryTriggeredThisBar = false
var int triggeredZoneId = na

// Reset at start of each bar
if barstate.isconfirmed[1] or barstate.isfirst
    entryTriggeredThisBar := false
    triggeredZoneId := na

// === TARGET SWEPT DEBUG TRACKING ===
// Track when targetSwept becomes true for visual debugging
var bool targetSweptThisBar = false
if barstate.isconfirmed[1] or barstate.isfirst
    targetSweptThisBar := false

// === TRADE PER DAY TRACKING ===
var int current_day_trades = 0
var int last_trade_day = na



is_late_friday() =>
    day_of_week = dayofweek(time, "Etc/GMT+5")
    current_hour = hour(time, "Etc/GMT+5")
    day_of_week == dayofweek.friday and current_hour >= 20



// === TRADE PER DAY TRACKING (INLINE) ===
// Reset trade count if new day
current_day_start = time("D", "Etc/GMT+5")
if na(last_trade_day) or current_day_start != last_trade_day
    current_day_trades := 0
    last_trade_day := current_day_start

// Helper to check if trades allowed
trades_allowed_today() =>
    current_day_trades < max_trades_per_day

// === DEBUG TABLE COLOR CODING FUNCTIONS ===
getZoneStateColor(state) =>
    state == "Untapped" ? color.aqua : color.red

getAccuracyColor(status) =>
    status == "Accuracy Adjusted" ? color.yellow : color.rgb(200, 200, 200)

getLiquidityColor(status) =>
    status == "Yes" ? color.green : (status == "No" ? color.red : color.rgb(200, 200, 200))


// === Helper: Bull/Bear ===
is_strong_bull(idx) =>
    close[idx] > open[idx] and (math.abs(close[idx] - open[idx]) / (high[idx] - low[idx]) > 0.5)

is_strong_bear(idx) =>
    close[idx] < open[idx] and (math.abs(close[idx] - open[idx]) / (high[idx] - low[idx]) > 0.5)

is_bullish(idx) => close[idx] > open[idx]
is_bearish(idx) => close[idx] < open[idx]

// Doji detection: body is less than 20% of total range (including equal open/close)
is_doji(idx) =>
    totalRange = high[idx] - low[idx]
    bodySize = math.abs(close[idx] - open[idx])
    totalRange > 0 ? (bodySize / totalRange) < 0.20 : true

// Flexible base detection: bearish OR doji counts as valid base for demand zones
is_bearish_or_doji(idx) => is_bearish(idx) or is_doji(idx)

// Flexible base detection: bullish OR doji counts as valid base for supply zones
is_bullish_or_doji(idx) => is_bullish(idx) or is_doji(idx)

// Flexible impulse detection: bullish OR neutral (for mixed impulse candles)
is_bullish_or_neutral(idx) => close[idx] >= open[idx]  // includes green and doji
is_bearish_or_neutral(idx) => close[idx] <= open[idx]  // includes red and doji

// Strong impulse check: at least 50% body, moving in the right direction
is_strong_bullish_impulse(idx) =>
    totalRange = high[idx] - low[idx]
    bodySize = close[idx] - open[idx]
    close[idx] > open[idx] and (totalRange > 0 ? (bodySize / totalRange) >= 0.40 : false)

is_strong_bearish_impulse(idx) =>
    totalRange = high[idx] - low[idx]
    bodySize = open[idx] - close[idx]
    close[idx] < open[idx] and (totalRange > 0 ? (bodySize / totalRange) >= 0.40 : false)

// Helper: locate zone index by UZID
findDemandZoneIndexByUZID(targetUZID) =>
    int idx = na
    if array.size(demandZones) > 0
        for i = 0 to array.size(demandZones) - 1
            Zone z = array.get(demandZones, i)
            if z.id == targetUZID
                idx := i
    idx

findSupplyZoneIndexByUZID(targetUZID) =>
    int idx = na
    if array.size(supplyZones) > 0
        for i = 0 to array.size(supplyZones) - 1
            Zone z = array.get(supplyZones, i)
            if z.id == targetUZID
                idx := i
    idx

// === Helper: deactivate demand zones after a trade ===
// === Helper: deactivate demand zones after a trade ===
deactivateDemandZone(idx) =>
    if idx >= 0 and idx < array.size(demandZones)
        Zone z = array.get(demandZones, idx)
        z.active := false
        // Optional: Change visual style to indicate inactive/used
        // For now, we keep the same style or maybe dim it?
        // Original code just reset colors which might be redundant if they are already set.
        // But let's keep it consistent.
        box.set_bgcolor(z.boxId, col_demand_bg)
        box.set_border_color(z.boxId, col_demand_border)

// === Helper: deactivate supply zones after a trade ===
deactivateSupplyZone(idx) =>
    if idx >= 0 and idx < array.size(supplyZones)
        Zone z = array.get(supplyZones, idx)
        z.active := false
        box.set_bgcolor(z.boxId, col_supply_bg)
        box.set_border_color(z.boxId, col_supply_border)

deactivateOverlappingSupplyZones(refLow, refHigh) =>
    for k = 0 to array.size(supplyZones) - 1
        Zone z = array.get(supplyZones, k)
        if z.active
            overlaps = not (z.top < refLow or z.bottom > refHigh)
            if overlaps
                deactivateSupplyZone(k)

deactivateOverlappingDemandZones(refLow, refHigh) =>
    for k = 0 to array.size(demandZones) - 1
        Zone z = array.get(demandZones, k)
        if z.active
            overlaps = not (z.top < refLow or z.bottom > refHigh)
            if overlaps
                deactivateDemandZone(k)

// === DEMAND ZONE CREATION ===
// isHistorical = true  -> created during initial backfill scan
// isHistorical = false -> created in live processing (recent bars)

// === MANUAL ZONE CREATION ===
// Creates a zone at user-specified price levels (runs once on first bar after enable)
var bool manual_zone_created = false
if enable_manual_zone and manual_zone_top > 0 and manual_zone_bottom > 0 and manual_zone_top > manual_zone_bottom and not manual_zone_created
    manual_zone_created := true
    bool isDemandManual = manual_zone_type == "Demand"
    
    // Increment appropriate counter
    int manualZoneId = 0
    if isDemandManual
        demand_zone_counter += 1
        manualZoneId := demand_zone_counter
    else
        supply_zone_counter += 1
        manualZoneId := supply_zone_counter
    
    // Create visual box
    color zoneBgColor = isDemandManual ? col_demand_bg : col_supply_bg
    box manualBox = box.new(left = bar_index - 50, top = manual_zone_top, right = bar_index + extend_bars, bottom = manual_zone_bottom,
         border_color = isDemandManual ? col_demand_border : col_supply_border,
         border_width = 2,
         bgcolor = zoneBgColor,
         xloc = xloc.bar_index)
         
    // Create ID Label
    string id_text = " ⭐ MANUAL " + (isDemandManual ? "D-" : "S-") + str.tostring(manualZoneId) + " "
    float mid = (manual_zone_top + manual_zone_bottom) / 2.0
    color lbl_bg_color = isDemandManual ? color.new(#089981, 0) : color.new(#f23645, 0)
    label idLbl = label.new(x = bar_index - 50, y = mid, text = id_text,
         style = label.style_label_left, textcolor = color.white, color = lbl_bg_color,
         size = size.tiny, textalign = text.align_center, xloc = xloc.bar_index)

    // Create Zone Object
    Zone manualZ = Zone.new()
    manualZ.id := manualZoneId
    manualZ.boxId := manualBox
    manualZ.top := manual_zone_top
    manualZ.bottom := manual_zone_bottom
    manualZ.active := true
    manualZ.createdBarIndex := bar_index - 50
    manualZ.isHistorical := false
    manualZ.startTime := time
    manualZ.idLabel := idLbl
    manualZ.isAccuracy := false
    manualZ.liquidityValid := false
    manualZ.liquiditySwept := false
    
    // Add to appropriate array
    if isDemandManual
        array.push(demandZones, manualZ)
        db_upsertZone(manualZ, "DEMAND")
    else
        array.push(supplyZones, manualZ)
        db_upsertZone(manualZ, "SUPPLY")



// --- 1. DEMAND ZONE DETECTION (recent bars) ---
if barstate.isconfirmed and bar_index > 10
    // Use is_bearish_or_doji to catch zones with doji/small-body base candles
    if is_bullish(0) and is_bullish(1) and is_bullish(2) and is_bearish_or_doji(3)
        baseTime = time[3]
        if not is_base_bar_used(baseTime, used_demand_base_times)
            demand_zone_counter += 1
            createZone(3, true, false, demand_zone_counter)
    else if is_bullish(0) and is_bullish(1) and is_bearish_or_doji(2)
        baseTime = time[2]
        if not is_base_bar_used(baseTime, used_demand_base_times)
            demand_zone_counter += 1
            createZone(2, true, false, demand_zone_counter)
    else if is_bullish(0) and is_bearish_or_doji(1)
        baseTime = time[1]
        if not is_base_bar_used(baseTime, used_demand_base_times)
            demand_zone_counter += 1
            createZone(1, true, false, demand_zone_counter)
    // FLEXIBLE IMPULSE: At least one strong bullish + rest bullish/neutral, with bearish/doji base
    else if is_strong_bullish_impulse(0) and is_bullish_or_neutral(1) and is_bullish_or_neutral(2) and is_bearish_or_doji(3)
        baseTime = time[3]
        if not is_base_bar_used(baseTime, used_demand_base_times)
            demand_zone_counter += 1
            createZone(3, true, false, demand_zone_counter)
    else if is_strong_bullish_impulse(0) and is_bullish_or_neutral(1) and is_bearish_or_doji(2)
        baseTime = time[2]
        if not is_base_bar_used(baseTime, used_demand_base_times)
            demand_zone_counter += 1
            createZone(2, true, false, demand_zone_counter)
    // CONSOLIDATION BREAKOUT: Multiple small candles then strong impulse
    else if is_strong_bullish_impulse(0) and is_doji(1) and is_doji(2)
        baseTime = time[2]
        if not is_base_bar_used(baseTime, used_demand_base_times)
            demand_zone_counter += 1
            createZone(2, true, false, demand_zone_counter)

// Initial historical scan (once)
if barstate.isconfirmed and not initial_scan_done and bar_index > 50
    initial_scan_done := true
    max_scan = math.min(100, bar_index)

    for i = 2 to max_scan
        baseTimeDemand = time[i]
        // Use is_bearish_or_doji for historical scan too
        if i >= 3 and is_bearish_or_doji(i) and is_bullish(i - 1) and is_bullish(i - 2) and is_bullish(i - 3)
            if not is_base_bar_used(baseTimeDemand, used_demand_base_times)
                demand_zone_counter += 1
                createZone(i, true, true, demand_zone_counter)
        else if is_bearish_or_doji(i) and is_bullish(i - 1) and is_bullish(i - 2)
            if not is_base_bar_used(baseTimeDemand, used_demand_base_times)
                demand_zone_counter += 1
                createZone(i, true, true, demand_zone_counter)
        else if is_bearish_or_doji(i) and is_bullish(i - 1)
            if not is_base_bar_used(baseTimeDemand, used_demand_base_times)
                demand_zone_counter += 1
                createZone(i, true, true, demand_zone_counter)
        // FLEXIBLE IMPULSE (historical): strong bullish + neutral impulse candles
        else if i >= 3 and is_bearish_or_doji(i) and is_bullish_or_neutral(i - 1) and is_bullish_or_neutral(i - 2) and is_strong_bullish_impulse(i - 3)
            if not is_base_bar_used(baseTimeDemand, used_demand_base_times)
                demand_zone_counter += 1
                createZone(i, true, true, demand_zone_counter)
        else if is_bearish_or_doji(i) and is_bullish_or_neutral(i - 1) and is_strong_bullish_impulse(i - 2)
            if not is_base_bar_used(baseTimeDemand, used_demand_base_times)
                demand_zone_counter += 1
                createZone(i, true, true, demand_zone_counter)
        // CONSOLIDATION BREAKOUT (historical)
        else if is_doji(i) and is_doji(i - 1) and is_strong_bullish_impulse(i - 2)
            if not is_base_bar_used(baseTimeDemand, used_demand_base_times)
                demand_zone_counter += 1
                createZone(i, true, true, demand_zone_counter)

        baseTimeSupply = time[i]
        // Use is_bullish_or_doji for supply zone historical scan
        if i >= 3 and is_bullish_or_doji(i) and is_bearish(i - 1) and is_bearish(i - 2) and is_bearish(i - 3)
            if not is_base_bar_used(baseTimeSupply, used_supply_base_times)
                supply_zone_counter += 1
                createZone(i, false, true, supply_zone_counter)
        else if is_bullish_or_doji(i) and is_bearish(i - 1) and is_bearish(i - 2)
            if not is_base_bar_used(baseTimeSupply, used_supply_base_times)
                supply_zone_counter += 1
                createZone(i, false, true, supply_zone_counter)
        else if is_bullish_or_doji(i) and is_bearish(i - 1)
            if not is_base_bar_used(baseTimeSupply, used_supply_base_times)
                supply_zone_counter += 1
                createZone(i, false, true, supply_zone_counter)

// --- 2. SUPPLY ZONE DETECTION (recent bars) ---
if barstate.isconfirmed and bar_index > 10
    // Use is_bullish_or_doji to catch supply zones with doji/small-body base candles
    if is_bearish(0) and is_bearish(1) and is_bearish(2) and is_bullish_or_doji(3)
        baseTime = time[3]
        if not is_base_bar_used(baseTime, used_supply_base_times)
            supply_zone_counter += 1
            createZone(3, false, false, supply_zone_counter)
    else if is_bearish(0) and is_bearish(1) and is_bullish_or_doji(2)
        baseTime = time[2]
        if not is_base_bar_used(baseTime, used_supply_base_times)
            supply_zone_counter += 1
            createZone(2, false, false, supply_zone_counter)
    else if is_bearish(0) and is_bullish_or_doji(1)
        baseTime = time[1]
        if not is_base_bar_used(baseTime, used_supply_base_times)
            supply_zone_counter += 1
            createZone(1, false, false, supply_zone_counter)
    // FLEXIBLE IMPULSE: At least one strong bearish + rest bearish/neutral, with bullish/doji base
    else if is_strong_bearish_impulse(0) and is_bearish_or_neutral(1) and is_bearish_or_neutral(2) and is_bullish_or_doji(3)
        baseTime = time[3]
        if not is_base_bar_used(baseTime, used_supply_base_times)
            supply_zone_counter += 1
            createZone(3, false, false, supply_zone_counter)
    else if is_strong_bearish_impulse(0) and is_bearish_or_neutral(1) and is_bullish_or_doji(2)
        baseTime = time[2]
        if not is_base_bar_used(baseTime, used_supply_base_times)
            supply_zone_counter += 1
            createZone(2, false, false, supply_zone_counter)
    // CONSOLIDATION BREAKOUT: Multiple small candles then strong impulse
    else if is_strong_bearish_impulse(0) and is_doji(1) and is_doji(2)
        baseTime = time[2]
        if not is_base_bar_used(baseTime, used_supply_base_times)
            supply_zone_counter += 1
            createZone(2, false, false, supply_zone_counter)

// === LIQUIDITY VALIDATION FUNCTIONS ===
// Validate liquidity: must break previous structure by at least a few pips
// === SWING DETECTION FOR LIQUIDITY ===
// Check if a bar is a valid swing for liquidity detection
// barOffset is the offset from current bar_index where the liquidity/fractal occurred
// For example, if fractal is at bar_index - fractalsPeriod, then barOffset = fractalsPeriod
isValidSwingForLiquidity(barOffset, isHigh) =>
    // Check if the bar at barOffset is a valid swing
    // For 2-candle swing: bar[barOffset-1] must be lower/higher than both bar[barOffset-2] and bar[barOffset]
    // For 1-candle swing: bar[barOffset-1] must be lower/higher than bar[barOffset]
    
    // 2-candle swing detection (Williams Fractal pattern)
    isTwoCandleSwingLow = low[barOffset - 1] < low[barOffset - 2] and low[barOffset - 1] < low[barOffset]
    isTwoCandleSwingHigh = high[barOffset - 1] > high[barOffset - 2] and high[barOffset - 1] > high[barOffset]
    
    // 1-candle swing detection (simpler pattern)
    isOneCandleSwingLow = low[barOffset - 1] < low[barOffset]
    isOneCandleSwingHigh = high[barOffset - 1] > high[barOffset]
    
    // Combined validation
    if isHigh
        // For high liquidity: check if it's a valid swing high
        liqHighValid = isTwoCandleSwingHigh or (useOneCandleLiquidity and isOneCandleSwingHigh)
        liqHighValid
    else
        // For low liquidity: check if it's a valid swing low
        liqLowValid = isTwoCandleSwingLow or (useOneCandleLiquidity and isOneCandleSwingLow)
        liqLowValid

// Simplified validation - check if liquidity breaks previous swing
validate_liquidity_formation(liqBarIdx, zoneCreatedBarIdx, liqPrice, isHigh) =>
    if liqBarIdx <= zoneCreatedBarIdx
        false
    else
        // First, check if the liquidity bar itself is a valid swing
        // For new fractals being validated: fractalBar = bar_index - fractalsPeriod
        // So the offset from current bar_index to the fractal bar is fractalsPeriod
        // We check if the bar at offset fractalsPeriod is a valid swing
        // For existing liquidity, we can't reliably check historical swings, so we skip the check
        liqBarAge = liqBarIdx - zoneCreatedBarIdx
        is_new_fractal = (liqBarAge <= fractalsPeriod + 2)  // New fractal is close to current bar
        
        is_valid_swing = true  // Default to true for existing liquidity
        if is_new_fractal and fractalsPeriod >= 2  // Only check for new fractals with enough bars
            is_valid_swing := isValidSwingForLiquidity(fractalsPeriod, isHigh)
        
        if not is_valid_swing
            false  // Not a valid swing, reject
        else
            // Find previous swing high/low before liquidity formation
            float prev_swing = na
            bars_to_check = math.min(liqBarIdx - zoneCreatedBarIdx + 10, 30)  // Look back reasonable amount
            
            // Look back to find previous significant swing using the same swing logic,
            // without relying on additional fractal helper calls.
            for offset = fractalsPeriod to bars_to_check
                if isHigh
                    // Check if this offset forms a valid swing high
                    if isValidSwingForLiquidity(offset, true)
                        float swing_val = high[offset]
                        if na(prev_swing) or swing_val > prev_swing
                            prev_swing := swing_val
                else
                    // Check if this offset forms a valid swing low
                    if isValidSwingForLiquidity(offset, false)
                        float swing_val = low[offset]
                        if na(prev_swing) or swing_val < prev_swing
                            prev_swing := swing_val
            
            // Must break previous structure by at least 2 pips
            if not na(prev_swing)
                if isHigh
                    liqPrice > prev_swing + (pip_size * 2)
                else
                    liqPrice < prev_swing - (pip_size * 2)
            else
                true  // If no previous swing found, assume valid (first liquidity)

// === LIQUIDITY VISUAL HELPERS (CONNECTORS, LABELS, COLOR ON SWEEP) ===
// === LIQUIDITY VISUAL HELPERS (CONNECTORS ONLY - Info labels removed, use Zone Inspector) ===
clearDemandLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(demandZones)
        Zone z = array.get(demandZones, idx)
        if not na(z.connectorLine)
            line.delete(z.connectorLine)
            z.connectorLine := na
        if not na(z.inducementHLine)
            line.delete(z.inducementHLine)
            z.inducementHLine := na
        if not na(z.targetHLine)
            line.delete(z.targetHLine)
            z.targetHLine := na

updateDemandLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(demandZones)
        Zone z = array.get(demandZones, idx)
        
        if na(z.liquidityPrice) or na(z.liquidityBarIndex) or na(z.createdBarIndex) or not show_liquidity_connectors
            clearDemandLiquidityVisual(idx)
            true
        else
            float mid = (z.top + z.bottom) / 2.0

            // === ZONE-TO-LIQUIDITY CONNECTOR LINE (DEMAND) ===
            // Neutral gray color - differentiate swept vs pending by style/width
            // Demand connector: solid style
            // Not swept: width 1, dotted | Swept: width 2, solid
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            
            lineStyle = z.liquiditySwept ? line.style_solid : line.style_dotted
            lineWidth = z.liquiditySwept ? 2 : 1
            z.connectorLine := line.new(x1 = z.createdBarIndex, y1 = mid, x2 = z.liquidityBarIndex, y2 = z.liquidityPrice,
                                  xloc = xloc.bar_index, extend = extend.none,
                                  color = liq_line_color, style = lineStyle, width = lineWidth)
            
            // === HORIZONTAL LINE FOR INDUCEMENT (dashed orange, at liqLowPrice) ===
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            
            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                color indColor = z.liquiditySwept ? color.new(color.orange, 0) : color.new(color.orange, 50)
                int lineEnd = bar_index + 20
                z.inducementHLine := line.new(x1 = z.liqLowBar, y1 = z.liqLowPrice, 
                                               x2 = lineEnd, y2 = z.liqLowPrice,
                                               xloc = xloc.bar_index, extend = extend.none,
                                               color = indColor, style = line.style_dashed, width = 1)
            
            // === HORIZONTAL LINE FOR TARGET (solid lime, at liqHighPrice) ===
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            
            if not na(z.liqHighPrice) and not na(z.liqHighBar)
                color tgtColor = z.targetSwept ? color.new(color.lime, 0) : color.new(color.lime, 50)
                int lineEnd = bar_index + 20
                z.targetHLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice, 
                                           x2 = lineEnd, y2 = z.liqHighPrice,
                                           xloc = xloc.bar_index, extend = extend.none,
                                           color = tgtColor, style = line.style_solid, width = 1)
            true


clearSupplyLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(supplyZones)
        Zone z = array.get(supplyZones, idx)
        if not na(z.connectorLine)
            line.delete(z.connectorLine)
            z.connectorLine := na
        if not na(z.targetLine)
            line.delete(z.targetLine)
            z.targetLine := na
        if not na(z.inducementHLine)
            line.delete(z.inducementHLine)
            z.inducementHLine := na
        if not na(z.targetHLine)
            line.delete(z.targetHLine)
            z.targetHLine := na

updateSupplyLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(supplyZones)
        Zone z = array.get(supplyZones, idx)
        
        // For Supply: draw connectors to both liqHigh (Inducement) and liqLow (Target)
        if na(z.liqHighPrice) or na(z.liqHighBar) or na(z.createdBarIndex) or not show_liquidity_connectors
            clearSupplyLiquidityVisual(idx)
            true
        else
            float zBottom = z.bottom

            // === LINE 1: Zone to Inducement HIGH (gray, dashed) ===
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            
            indStyle = z.liquiditySwept ? line.style_dashed : line.style_dotted
            indWidth = z.liquiditySwept ? 2 : 1
            z.connectorLine := line.new(x1 = z.createdBarIndex, y1 = zBottom, x2 = z.liqHighBar, y2 = z.liqHighPrice,
                                  xloc = xloc.bar_index, extend = extend.none,
                                  color = liq_line_color, style = indStyle, width = indWidth)
            
            // === LINE 2: Inducement HIGH to Target LOW (gray, solid) ===
            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                if not na(z.targetLine)
                    line.delete(z.targetLine)
                
                // Gray solid line for Target - distinct from Inducement dotted line
                targetColor = color.new(color.gray, 25)
                targetStyle = line.style_solid
                targetWidth = z.targetSwept ? 2 : 1
                z.targetLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice, x2 = z.liqLowBar, y2 = z.liqLowPrice,
                                      xloc = xloc.bar_index, extend = extend.none,
                                      color = targetColor, style = targetStyle, width = targetWidth)
            
            // === HORIZONTAL LINE FOR INDUCEMENT (dashed orange, at liqHighPrice) ===
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            
            if not na(z.liqHighPrice) and not na(z.liqHighBar)
                color indColor = z.liquiditySwept ? color.new(color.orange, 0) : color.new(color.orange, 50)
                int lineEnd = bar_index + 20
                z.inducementHLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice, 
                                               x2 = lineEnd, y2 = z.liqHighPrice,
                                               xloc = xloc.bar_index, extend = extend.none,
                                               color = indColor, style = line.style_dashed, width = 1)
            
            // === HORIZONTAL LINE FOR TARGET (solid lime, at liqLowPrice) ===
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            
            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                color tgtColor = z.targetSwept ? color.new(color.lime, 0) : color.new(color.lime, 50)
                int lineEnd = bar_index + 20
                z.targetHLine := line.new(x1 = z.liqLowBar, y1 = z.liqLowPrice, 
                                           x2 = lineEnd, y2 = z.liqLowPrice,
                                           xloc = xloc.bar_index, extend = extend.none,
                                           color = tgtColor, style = line.style_solid, width = 1)
            true


// === LIQUIDITY VALIDATION: SINGLE SOURCE OF TRUTH ===
// This helper is the ONLY place that decides whether a detected liquidity level
// is structurally valid for entries, for both demand and supply zones.
// It enforces:
//  1) Geometric relationship (liq above demand zone / below supply zone)
//  2) Opposite-candle count in the band using `countOppositeCandlesInBand` data
//  3) 1‑candle vs 2‑candle rule (useOneCandleLiquidity)
//  4) Zone impulse must have caused a liquidity sweep at creation (zoneCausedSweep)
isLiquidityValidForEntry(isDemand, idx) =>
    if idx < 0
        false
    else
        float zHigh = na
        float zLow  = na
        int   zCreatedBar = na
        float liqLevel = na
        int   liqBar   = na
        int   oppCount = 0
        bool  zoneCausedSweep = false

        if isDemand
            if idx >= array.size(demandZones)
                false
            else
                Zone z = array.get(demandZones, idx)
                zHigh := z.top
                zLow  := z.bottom
                zCreatedBar := z.createdBarIndex
                liqLevel := z.liquidityPrice
                liqBar   := z.liquidityBarIndex
                oppCount := z.liquidityCandleCount
                zoneCausedSweep := z.causedSweep
        else
            if idx >= array.size(supplyZones)
                false
            else
                Zone z = array.get(supplyZones, idx)
                zHigh := z.top
                zLow  := z.bottom
                zCreatedBar := z.createdBarIndex
                liqLevel := z.liquidityPrice
                liqBar   := z.liquidityBarIndex
                oppCount := z.liquidityCandleCount
                zoneCausedSweep := z.causedSweep

        // 1) Geometric check: liquidity must be on the correct side of zone
        // Respects use_inducement_linking toggle
        bool geomOk = false
        float dist_pips = na
        float sideTol = syminfo.mintick * liq_side_tol_ticks
        
        if isDemand
            if use_inducement_linking
                // MODEL B (Inducement): For demand, liquidity LOW must be ABOVE zoneHigh
                geomOk := not na(liqLevel) and liqLevel >= (zHigh - sideTol)
                dist_pips := (liqLevel - zHigh) / pip_size
            else
                // MODEL A (Standard): For demand, liquidity LOW must be BELOW zoneLow
                geomOk := not na(liqLevel) and liqLevel <= (zLow + sideTol)
                dist_pips := (zLow - liqLevel) / pip_size
        else
            if use_inducement_linking
                // MODEL B (Inducement): For supply, liquidity HIGH must be BELOW zoneLow
                geomOk := not na(liqLevel) and liqLevel <= (zLow + sideTol)
                dist_pips := (zLow - liqLevel) / pip_size
            else
                // MODEL A (Standard): For supply, liquidity HIGH must be ABOVE zoneHigh
                geomOk := not na(liqLevel) and liqLevel >= (zHigh - sideTol)
                dist_pips := (liqLevel - zHigh) / pip_size

        if not geomOk
            false
        else
            // 2) Liquidity must form after zone creation
            bool timingOk = not na(zCreatedBar) and not na(liqBar) and liqBar > zCreatedBar
            if not timingOk
                false
            else
                // 3) Opposite candle count rule - STRICT (no proximity exception)
                // Liquidity MUST have at least minCandles opposite candles forming the leg
                int minCandles = useOneCandleLiquidity ? 1 : 2
                bool candlesOk = oppCount >= minCandles
                
                if not candlesOk
                    false
                else
                    // 4) Zone impulse must have caused a sweep at creation
                    zoneCausedSweep



isValidEntry(isDemand, idx) =>
    [canEnter, reason, z] = validate_entry_conditions(isDemand, idx)

    // Note: Timing filter is now checked INSIDE validate_entry_conditions 
    // to prioritize the "Blocked by Timing" reason string.

    if canEnter
        // Score Validation (Stub)
        bool score_ok = enableScoreFilterStub ? score_pass_stub() : true
        if not score_ok
            canEnter := false
            reason := "Score Low (Stub)"

    if canEnter
        // Directional candle check with hammer/inverted hammer support
        float bodySize = math.abs(close - open)
        float candleRange = high - low
        float lowerWick = math.min(open, close) - low
        float upperWick = high - math.max(open, close)
        
        // Hammer detection: Long lower wick (>= 60% of range), small body
        bool isHammer = lowerWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3
        
        // Inverted hammer: Long upper wick (>= 60% of range), small body
        bool isInvertedHammer = upperWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3
        
        bool correct_direction = false
        if isDemand
            // For demand: Standard bullish OR hammer (even if slightly bearish)
            correct_direction := (close > open) or isHammer
        else
            // For supply: Standard bearish OR inverted hammer
            correct_direction := (close < open) or isInvertedHammer
        
        if not correct_direction
            canEnter := false
            reason := isDemand ? "Waiting for Bullish Close or Hammer" : "Waiting for Bearish Close or Inv. Hammer"

    // Only one entry per bar & no existing position
    if canEnter
        int lastEntryBar = isDemand ? last_global_long_entry_bar : last_global_short_entry_bar
        bool noEntryThisBar = na(lastEntryBar) or bar_index > lastEntryBar
        if not noEntryThisBar
            canEnter := false
            reason := isDemand ? "Long entry already taken this bar" : "Short entry already taken this bar"

    if canEnter and strategy.position_size != 0
        canEnter := false
        reason := "Existing position open (no stacking)"

    // DEBUG: Pre-Sweep Gate Proof
    if debug_gate_proof and (canEnter or str.contains(reason, "Touched Pre-Sweep"))
        bool touchedNow_debug = isDemand ? (low <= z.top) : (high >= z.bottom)
        bool sweptNow_debug = z.liquiditySweptBarIndex == bar_index
        string debugText = "GATE PROOF ID: " + str.tostring(z.id) + 
                           "\ntouchedNow: " + str.tostring(touchedNow_debug) +
                           "\nsweptNow: " + str.tostring(sweptNow_debug) +
                           "\nz.touchedPre: " + str.tostring(z.touchedPreSweep) + 
                           "\nz.swept: " + str.tostring(z.liquiditySwept) +
                           "\nz.eligible: " + str.tostring(z.eligibleEntry) +
                           "\nz.firstTouch: " + str.tostring(z.firstTouchBarIndex) +
                           "\nz.sweepBar: " + str.tostring(z.liquiditySweptBarIndex)
                           
        label.new(bar_index, isDemand ? z.top : z.bottom, debugText, 
                  color=color.black, textcolor=color.white, style=isDemand ? label.style_label_up : label.style_label_down, size=size.normal)

    [canEnter, reason]

// Wrapper functions for backward compatibility
isValidDemandEntry(idx) => isValidEntry(true, idx)
isValidSupplyEntry(idx) => isValidEntry(false, idx)

// === GLOBAL SWING CALCULATIONS ===
// Calculate these once per bar to avoid "ta.* should be called on each calculation" warnings
int global_swing_lookback = math.min(liq_link_lookback_bars, liq_fallback_lookback)
float global_swing_low = ta.lowest(low, global_swing_lookback)
int global_swing_low_bar = bar_index - ta.lowestbars(low, global_swing_lookback)
float global_swing_high = ta.highest(high, global_swing_lookback)
int global_swing_high_bar = bar_index - ta.highestbars(high, global_swing_lookback)

// === TRACK LIQUIDITY AND ZONE STATUS (DEMAND) ===
// CRITICAL: Only validate liquidity sweeps for LIVE zones (not historical backfill)
if array.size(demandZones) > 0 and barstate.isconfirmed
    current_close = close
    current_open = open
    
    for i = 0 to array.size(demandZones) - 1
        Zone z = array.get(demandZones, i)
        if z.active
            // Skip historical zones - we don't validate sweeps for them
            if z.isHistorical
                continue  // Skip all liquidity validation for historical zones
            
            // === VALIDATE EXISTING LIQUIDITY ===
            // Clear invalid liquidity that doesn't match the selected mode
            if not na(z.liquidityPrice)
                float sideTol = syminfo.mintick * liq_side_tol_ticks
                bool isInvalid = false
                
                if use_inducement_linking
                    // MODEL B (Inducement): Liquidity LOW must be ABOVE zone (z.top)
                    // Invalid if it's BELOW zone top (minus tolerance)
                    if z.liquidityPrice < (z.top - sideTol)
                        isInvalid := true
                else
                    // MODEL A (Standard): Liquidity LOW must be BELOW zone (z.bottom)
                    // Invalid if it's ABOVE zone bottom (plus tolerance)
                    if z.liquidityPrice > (z.bottom + sideTol)
                        isInvalid := true
                
                if isInvalid
                    // Invalid liquidity - clear it
                    z.liquidityPrice := na
                    z.liquidityBarIndex := na
                    z.liquiditySwept := false
                    z.liquiditySweptBarIndex := na
                    z.causedSweep := false
                    z.structureSweepLevel := na
                    z.structureSweepLevelBar := na
                    // Reset per-zone liquidity validity / count
                    z.liquidityValid := false
                    z.liquidityCandleCount := 0
                    // Clear any visual connector/label for this zone's liquidity
                    clearDemandLiquidityVisual(i)
            
            // === DEMAND LIQUIDITY SELECTION (Throttled for Performance) ===
            // Skip heavy scanning if liquidity already found and not swept
            if not (z.liquidityValid and not z.liquiditySwept)
                f_scan_demand_liquidity(i)
            
            // === DEMAND SWEEP DETECTION (via modular function) ===
            bool wasSweptBefore = z.liquiditySwept
            f_check_demand_sweeps(i)
            bool isSweptNow = z.liquiditySwept

            // === PRE-SWEEP TOUCH INVALIDATION (DEMAND) ===
            // CRITICAL RULE: If zone is touched BEFORE it sweeps liquidity, it becomes permanently invalid.
            // Exception: If it sweeps AND is touched on the SAME bar, it's valid (standard entry).
            
            // 1. Check for touch on current candle
            // Strict touch: Low is inside, or Low splits the zone. Basically if price reaches the zone.
            bool touchedNow = low <= z.top
            
            // 2. If touched NOW, but not yet swept (and didn't just sweep this bar), mark as invalid
            // z.liquiditySwept has been updated by f_check_demand_sweeps to include current bar sweeps.
            // So if z.liquiditySwept is FALSE here, it means it hasn't been swept ever, including now.
            if touchedNow and not z.liquiditySwept and not z.touchedPreSweep
                z.touchedPreSweep := true
                if na(z.firstTouchBarIndex)
                    z.firstTouchBarIndex := bar_index
                z.eligibleEntry := false
                if debug_invalidation
                    label.new(bar_index, z.top, "INVALID: TOUCHED PRE-SWEEP D-" + str.tostring(z.id) + "\n(Touched without Sweep)", style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.tiny)
            
            // 3. Update Eligibility: Must be swept AND NOT touched pre-sweep
            z.eligibleEntry := z.liquiditySwept and not z.touchedPreSweep

            // 4. PERSIST STATE changes back to array (Critical for struct updates)
            array.set(demandZones, i, z)

            if z.touchedPreSweep and not na(z.boxId)
                box.set_bgcolor(z.boxId, color.new(color.gray, 90))

            // Update demand liquidity visuals
            updateDemandLiquidityVisual(i)
            
            if current_close > z.top and not z.leftZone
                z.leftZone := true
                z.leftWithBearish := current_close < current_open

            // === LENIENT MITIGATION CHECK (DEMAND) ===
            // Zone is only invalidated if:
            // 1) Price CLOSES inside the zone, OR
            // 2) Price wicks THROUGH the entire zone (breach - low goes below zone bottom)
            // Simple touch/wick INTO zone is allowed - zone stays live for entry
            if not z.mitigated
                bool is_future_bar = not na(z.createdBarIndex) and bar_index > z.createdBarIndex
                
                // Close inside zone (bearish invalidation)
                bool closes_inside = close <= z.top and close >= z.bottom
                
                // Breach - price wicks through entire zone (wick below zone bottom)
                bool breaches_zone = low < z.bottom
                
                // SIMULTANEOUS SWEEP: If current bar sweeps target, allow entry
                bool current_bar_sweeping = not na(z.structureSweepLevel) and high > z.structureSweepLevel
                
                // Only mitigate if liquidty NOT yet swept AND (close inside OR breach) AND not sweeping
                if is_future_bar and not z.liquiditySwept and (closes_inside or breaches_zone) and not current_bar_sweeping
                    z.mitigated := true
                    z.mitigationTime := time
                    z.inactiveReason := closes_inside ? "Close inside zone" : "Price breached zone"
                    if not na(z.boxId)
                        box.set_bgcolor(z.boxId, color.new(color.gray, 85))
                        box.set_border_color(z.boxId, color.gray)

// === TRACK LIQUIDITY AND ZONE STATUS (SUPPLY) ===
// CRITICAL: Only validate liquidity sweeps for LIVE zones (not historical backfill)
// For supply zones, liquidity is BELOW the zone - must be a proper swing LOW
if array.size(supplyZones) > 0 and barstate.isconfirmed
    current_close = close
    current_open = open
    current_low = low
    
    for i = 0 to array.size(supplyZones) - 1
        Zone z = array.get(supplyZones, i)
        if z.active
            // Skip historical zones - we don't validate sweeps for them
            if z.isHistorical
                continue  // Skip all liquidity validation for historical zones
            
            // === VALIDATE EXISTING LIQUIDITY ===
            // Clear invalid liquidity that doesn't match the selected mode
            if not na(z.liquidityPrice)
                float sideTol = syminfo.mintick * liq_side_tol_ticks
                bool isInvalid = false
                
                if use_inducement_linking
                    // MODEL B (Inducement): Liquidity HIGH must be BELOW zone (z.bottom)
                    // Invalid if it's ABOVE zone bottom (plus tolerance)
                    if z.liquidityPrice > (z.bottom + sideTol)
                        isInvalid := true
                else
                    // MODEL A (Standard): Liquidity HIGH must be ABOVE zone (z.top)
                    // Invalid if it's BELOW zone top (minus tolerance)
                    if z.liquidityPrice < (z.top - sideTol)
                        isInvalid := true
                
                if isInvalid
                    // Invalid liquidity - clear it completely
                    z.liquidityPrice := na
                    z.liquidityBarIndex := na
                    z.liquiditySwept := false
                    z.liquiditySweptBarIndex := na
                    z.causedSweep := false
                    z.structureSweepLevel := na
                    z.structureSweepLevelBar := na
                    // Reset candle count when liquidity is cleared
                    z.liquidityCandleCount := 0
                    z.liquidityValid := false
                    // Clear any visual connector/label for this zone's liquidity
                    clearSupplyLiquidityVisual(i)

            // === SUPPLY LIQUIDITY SELECTION (Throttled for Performance) ===
            // Skip heavy scanning if liquidity already found and not swept
            if not (z.liquidityValid and not z.liquiditySwept)
                f_scan_supply_liquidity(i)
            
            // === SUPPLY SWEEP DETECTION (via modular function) ===
            bool wasSweptBefore = z.liquiditySwept
            f_check_supply_sweeps(i)
            bool isSweptNow = z.liquiditySwept

            // === PRE-SWEEP TOUCH INVALIDATION (SUPPLY) ===
            // CRITICAL RULE: If zone is touched BEFORE it sweeps liquidity, it becomes permanently invalid.
            
            // 1. Check for touch on current candle
            // Strict touch: High is inside/above bottom.
            bool touchedNow = high >= z.bottom
            
            // 2. If touched NOW, but not yet swept, mark as invalid
            // z.liquiditySwept is current (just updated).
            if touchedNow and not z.liquiditySwept and not z.touchedPreSweep
                z.touchedPreSweep := true
                if na(z.firstTouchBarIndex)
                    z.firstTouchBarIndex := bar_index
                z.eligibleEntry := false
                if debug_invalidation
                    label.new(bar_index, z.bottom, "INVALID: TOUCHED PRE-SWEEP S-" + str.tostring(z.id) + "\n(Touched without Sweep)", style=label.style_label_up, color=color.gray, textcolor=color.white, size=size.tiny)
            
            // 3. Update Eligibility
            z.eligibleEntry := z.liquiditySwept and not z.touchedPreSweep

            // 4. PERSIST STATE
            array.set(supplyZones, i, z)

            if z.touchedPreSweep and not na(z.boxId)
                box.set_bgcolor(z.boxId, color.new(color.gray, 90))

            // Update supply liquidity visuals
            updateSupplyLiquidityVisual(i)

            if current_close < z.bottom and not z.leftZone
                z.leftZone := true


            
            // === LENIENT MITIGATION CHECK (SUPPLY) ===
            // Zone is only invalidated if:
            // 1) Price CLOSES inside the zone, OR
            // 2) Price wicks THROUGH the entire zone (breach - high goes above zone top)
            // Simple touch/wick INTO zone is allowed - zone stays live for entry
            if not z.mitigated
                bool is_future_bar = not na(z.createdBarIndex) and bar_index > z.createdBarIndex
                
                // Close inside zone (bullish invalidation)
                bool closes_inside = close >= z.bottom and close <= z.top
                
                // Breach - price wicks through entire zone (wick above zone top)
                bool breaches_zone = high > z.top
                
                // SIMULTANEOUS SWEEP: If current bar sweeps target, allow entry
                bool current_bar_sweeping = not na(z.structureSweepLevel) and low < z.structureSweepLevel
                
                // Only mitigate if liquidty NOT yet swept AND (close inside OR breach) AND not sweeping
                if is_future_bar and not z.liquiditySwept and (closes_inside or breaches_zone) and not current_bar_sweeping
                    z.mitigated := true
                    z.mitigationTime := time
                    z.inactiveReason := closes_inside ? "Close inside zone" : "Price breached zone"
                    if not na(z.boxId)
                        box.set_bgcolor(z.boxId, color.new(color.gray, 85))
                        box.set_border_color(z.boxId, color.gray)


// === ZONE INVALIDATION (DEMAND) ===
if array.size(demandZones) > 0
    current_close = close
    current_open  = open
    current_low   = low
    // Keep candle color for wick-based invalidation after leaving the zone
    bool is_bearish_c  = current_close < current_open
    pip_buffer    = pip_size * 0.1
    
    for i = array.size(demandZones) - 1 to 0
        Zone z = array.get(demandZones, i)
        if z.active
            // Check if price has left the zone
            if current_close > z.top and not z.leftZone
                z.leftZone := true
                z.leftWithBearish := current_close < current_open
            
            // Time Check
            bool isTooOld = not na(z.startTime) and (time - z.startTime) > (24 * 60 * 60 * 1000)
            
            // Invalidation Conditions:
            // 1. Close inside (bearish)
            bool bearish_close_inside = current_close <= z.top and current_close >= z.bottom
            // 2. Close below (Standard invalidation)
            bool close_below_zone     = current_close < z.bottom
            // 3. Mitigation (Bearish wick after leaving) - RELAXED: Removed strict invalidation
            // bool wicks_into_zone      = current_low <= (z.top + pip_buffer) and current_low >= (z.bottom - pip_buffer)
            // bool bearish_wick_after_leaving = z.leftZone and z.leftWithBearish and is_bearish_c and wicks_into_zone
            // 4. Wick below zone (optional via input)
            bool wick_below_zone = current_low < z.bottom

            if bearish_close_inside or close_below_zone or isTooOld or (invalidate_on_wick and wick_below_zone)
                remove_zone_all_arrays(true, i)

// === ZONE INVALIDATION (SUPPLY) ===
if array.size(supplyZones) > 0
    current_close = close
    current_open  = open
    current_high  = high
    
    for i = array.size(supplyZones) - 1 to 0
        Zone z = array.get(supplyZones, i)
        if z.active
            // Time Check
            bool isTooOld = not na(z.startTime) and (time - z.startTime) > (24 * 60 * 60 * 1000)
            
            // Invalidation Conditions:
            // 1. Close inside (bullish)
            bool bullish_close_inside = current_close >= z.bottom and current_close <= z.top
            // 2. Close above (Standard invalidation)
            bool close_above_zone     = current_close > z.top
            // 3. Wick above zone (optional via input)
            bool wick_above_zone = current_high > z.top

            if bullish_close_inside or close_above_zone or isTooOld or (invalidate_on_wick and wick_above_zone)
                remove_zone_all_arrays(false, i)

// === UPDATE ZONE BOXES AND LABELS (Dynamic Extension + UZID) ===
// Update demand zone boxes to extend to exact bar count and update labels with UZID
if show_zones and show_demand_zones and array.size(demandZones) > 0 and barstate.isconfirmed
    for i = 0 to array.size(demandZones) - 1
        Zone z = array.get(demandZones, i)
        if z.active
            // Get creation bar index and update box right edge to extend exactly 'extend_bars' bars
            if not na(z.createdBarIndex)
                int left_bar_index = z.createdBarIndex
                int right_bar_index = left_bar_index + extend_bars
                if not na(z.boxId)
                    // Update box right edge for exact extension
                    box.set_right(z.boxId, right_bar_index)
                    // Update colors based on Accuracy status
                    if z.isAccuracy
                        box.set_bgcolor(z.boxId, color.new(#00bcd4, 65))
                        box.set_border_width(z.boxId, 2)
                    else
                        box.set_bgcolor(z.boxId, col_demand_bg)
                        box.set_border_width(z.boxId, 1)
                    box.set_border_color(z.boxId, col_demand_border)
                    
                    if not na(z.idLabel)
                        float lbl_mid = (z.top + z.bottom) / 2
                        label.set_x(z.idLabel, bar_index)
                        label.set_y(z.idLabel, lbl_mid)
                        string demandAccTag = z.isAccuracy ? "⭐ ACC " : ""
                        label.set_text(z.idLabel, " " + demandAccTag + "D-" + str.tostring(z.id) + " ")
                        label.set_style(z.idLabel, label.style_label_left)
                        label.set_textcolor(z.idLabel, color.white)
                        label.set_color(z.idLabel, color.new(#089981, 0))  // Solid green
                        label.set_size(z.idLabel, size.normal)
                        label.set_textalign(z.idLabel, text.align_center)

// Update supply zone boxes to extend to exact bar count and update labels with UZID
if show_zones and show_supply_zones and array.size(supplyZones) > 0 and barstate.isconfirmed
    for i = 0 to array.size(supplyZones) - 1
        Zone z = array.get(supplyZones, i)
        if z.active
            // Get creation bar index and update box right edge to extend exactly 'extend_bars' bars
            if not na(z.createdBarIndex)
                int left_bar_index = z.createdBarIndex
                int right_bar_index = left_bar_index + extend_bars
                if not na(z.boxId)
                    // Update box right edge for exact extension
                    box.set_right(z.boxId, right_bar_index)
                    // Update colors based on Accuracy status
                    if z.isAccuracy
                        box.set_bgcolor(z.boxId, color.new(#00bcd4, 65))
                        box.set_border_width(z.boxId, 2)
                    else
                        box.set_bgcolor(z.boxId, col_supply_bg)
                        box.set_border_width(z.boxId, 1)
                    box.set_border_color(z.boxId, col_supply_border)
                    
                    if not na(z.idLabel)
                        float lbl_mid = (z.top + z.bottom) / 2
                        label.set_x(z.idLabel, bar_index)
                        label.set_y(z.idLabel, lbl_mid)
                        string supplyAccTag = z.isAccuracy ? "⭐ ACC " : ""
                        label.set_text(z.idLabel, " " + supplyAccTag + "S-" + str.tostring(z.id) + " ")
                        label.set_style(z.idLabel, label.style_label_left)
                        label.set_textcolor(z.idLabel, color.white)
                        label.set_color(z.idLabel, color.new(#f23645, 0))  // Solid red
                        label.set_size(z.idLabel, size.normal)
                        label.set_textalign(z.idLabel, text.align_center)
            
            // Zone ID is now displayed using plottext() in the main plotting section

// Zone IDs are created with labels when zones are created - see createDemandZone() and createSupplyZone()
// Labels are positioned at the left edge (creation bar) and remain anchored there

// === FLIP ENTRY DETECTION (30M CANDLE BOUNDARY) ===
// Detect 30m candle change using chart-time (no security call needed)
is_new_30m_candle = ta.change(time("30")) != 0

// Flip entry logic for demand zones - RESTORED TO ORIGINAL STRUCTURE
if enable_flip_entry and array.size(demandZones) > 0 and allow_long_trades and is_new_30m_candle and strategy.position_size == 0
    current_close = close
    current_open = open
    current_low = low
    current_high = high
    is_bullish_candle = current_close > current_open
    
    for i = 0 to array.size(demandZones) - 1
        Zone z = array.get(demandZones, i)
        
        // Use base validation WITHOUT timing filter (flip entries are ALLOWED during timing windows)
        [base_can_enter_demand, base_reason_demand, _z] = validate_entry_conditions(true, i)
        
        if base_can_enter_demand
            // Flip Entry specific checks
            float zoneSize = z.top - z.bottom
            
            // Check if wick goes into zone (current candle approach)
            bool wick_into_zone = current_low <= z.top and current_low >= z.bottom
            float wick_size = current_close - current_low
            float wick_percent_of_zone = zoneSize > 0 ? (wick_size / zoneSize * 100) : 0
            
            // Strong flip in entry direction (bullish)
            bool strong_flip = is_bullish_candle and (current_close - current_open) > (current_high - current_low) * 0.6
            
            // Wick fully formed (bottom wick for longs)
            bool wick_fully_formed = current_low < current_open and current_low < current_close
            
            // Check if wick size meets threshold
            bool wick_threshold_met = wick_percent_of_zone >= flip_wick_threshold_pct
            
            // PRIMED FLIP: Zone was primed on previous candle, now we have bullish close
            bool primed_flip = z.primed and z.primedBar == bar_index - 1 and is_bullish_candle
            
            // Flip-specific gate: Either standard flip OR primed flip
            bool can_flip_enter = enable_flip_entry and (primed_flip or (wick_into_zone and strong_flip and wick_fully_formed and (wick_threshold_met or true)))
            
            if can_flip_enter and barstate.isconfirmed
                bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue
                
                // Flip entry: use PREVIOUS candle's close as entry price
                entry_price = close[1]
                
                // SL = deepest wick of the priming candle (stored in primedWickLevel)
                // Fallback to previous candle's low if primedWickLevel not set
                stop_loss_price = not na(z.primedWickLevel) ? z.primedWickLevel : low[1]
                
                // Optional buffer: only apply if user explicitly sets it > 0
                if stop_loss_buffer_pips > 0
                    stop_loss_price := stop_loss_price - (stop_loss_buffer_pips * pip_size)
                
                // --- SAFETY CLAMP (LONG) ---
                // Validate and clamp SL
                [adjusted_sl, v_sl_pips, v_sl_valid] = validate_safety_clamp(true, entry_price, stop_loss_price)
                stop_loss_price := adjusted_sl
                sl_pips = v_sl_pips
                float pip_distance = sl_pips * pip_size

                if not v_sl_valid
                    continue  // Invalid SL, skip this trade
                
                // Calculate setup score (REMOVED) - using stub
                score_ok = enableScoreFilterStub ? score_pass_stub() : true
                
                // Only take trades that pass stub filter
                if not score_ok
                    continue
                
                // Calculate TP using Updated Rules
                float take_profit_price = na
                
                // Reset BE variables
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false
                
                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    
                    // Apply double TP
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                        
                    if not na(tp_r)
                        take_profit_price := entry_price + (pip_distance * tp_r)
                        
                    // Store BE settings
                    if move_be
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl
                
                // --- TP DISTANCE VALIDATION ---
                if not validate_tp_distance(entry_price, take_profit_price, min_tp_distance_pips)
                    continue  // Skip this trade
                
                // Check for USDJPY rate failure for JPY pairs (before position sizing)
                if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                    // Fetch USDJPY rate using helper
                    [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                    if not usdjpy_success_check
                        // Show warning label and skip trade
                        // Warning labels removed for clean chart
                        // if show_entry_labels
                        //     label.new(x = bar_index, y = high, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                        //               style = label.style_label_down, color = color.new(color.orange, 0),
                        //               textcolor = color.white, size = size.normal)
                        continue  // Skip this trade
                
                // Position sizing with enhanced validation
                balance  = account_size_usd
                risk_pct = risk_per_trade_pct
                
                // Apply 0.5R adjustment for second trade of the day
                if current_day_trades == 1 and max_trades_per_day == 2
                    risk_pct := risk_pct * 0.5
                
                // Enhanced position sizing validation
                [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_validation_details, pos_sl_fixed] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, false)
                
                // Use the corrected SL from validation
                stop_loss_price := pos_sl_fixed
                
                // Store position sizing details for debug table
                last_pos_size_entry := entry_price
                last_pos_size_sl := stop_loss_price
                last_pos_size_balance := balance
                last_pos_size_risk_pct := risk_pct
                last_pos_size_sl_pips := sl_pips
                last_pos_size_valid := pos_is_valid
                last_pos_size_error := pos_error_msg
                last_pos_size_dry_run := dry_run_mode
                
                if pos_is_valid
                    last_pos_size_units := pos_qty_units
                    last_pos_size_lots := pos_qty_lots
                    
                    // Get USDJPY rate for tracking
                    if str.contains(syminfo.ticker, "JPY")
                        [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                        if usdjpy_track_success_result
                            last_pos_size_usdjpy_rate := usdjpy_track_rate_result
                        else
                            last_pos_size_usdjpy_rate := na
                else
                    last_pos_size_units := na
                    last_pos_size_lots := na
                    last_pos_size_usdjpy_rate := na
                    
                    // Show warning label for validation failure
                    // Warning labels removed for clean chart
                    // if show_entry_labels
                    //     label.new(x = bar_index, y = high, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                    //               style = label.style_label_down, color = color.new(color.red, 0),
                    //               textcolor = color.white, size = size.normal)

                // 🔥 ENTRY EXECUTION - ALL actions happen together
                if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                    // FINAL GUARD: Re-validate entry permission using base validation (no timing block for flip)
                    [isEntryPermitted, entryPermitReason, _zFlip] = validate_entry_conditions(true, i)
                    
                    // Diagnostic labels silenced - Zone Inspector tracks this data
                    // if debug_enabled and show_entry_labels
                    //     string debugMsg = "FLIP CHECK D-" + str.tostring(z.id) + "\nisEntryPermitted: " + str.tostring(isEntryPermitted) + "\nReason: " + entryPermitReason
                    //     label.new(x = bar_index, y = high + (high - low) * 0.5, text = debugMsg,
                    //               style = label.style_label_down, color = isEntryPermitted ? color.green : color.red,
                    //               textcolor = color.white, size = size.small)
                    
                    if not isEntryPermitted
                        continue  // Skip this entry if not permitted
                    
                    // Set entry sync flag BEFORE marking zone as used (for Zone Inspector)
                    entryTriggeredThisBar := true
                    triggeredZoneId := z.id
                    
                    // Dry run mode: show what would be executed without actually executing
                    if dry_run_mode
                        // Dry run labels removed for clean chart
                        // if show_entry_labels
                        //     label.new(x = bar_index, y = entry_price, text = "🔵 DRY RUN: Long Flip\nQty: " + str.tostring(pos_qty_units) + " units\nSL: " + str.tostring(stop_loss_price, "#.####"),
                        //               style = label.style_label_up, color = color.new(color.blue, 0),
                        //               textcolor = color.white, size = size.normal)
                        
                        if not na(stop_loss_price)
                            sl_pips_display = not na(sl_pips) ? str.tostring(sl_pips, "#.##") + " pips" : "N/A"
                            // label.new(x = bar_index, y = stop_loss_price,
                            //           text = "DRY RUN SL: " + str.tostring(stop_loss_price, "#.####") + "\n(" + sl_pips_display + ")",
                            //           style = label.style_label_left, color = color.new(color.orange, 0),
                            //           textcolor = color.white, size = size.normal)
                    else
                        // 1. EXECUTE THE ENTRY (using close[1] as entry)
                        string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                        // Pass empty comment if entry labels are shown (to avoid duplicate [NRM] display)
                        string entryComment = show_entry_labels ? "" : typeTag
                        strategy.entry("Long Flip", strategy.long, qty = pos_qty_units, comment = entryComment)
                    
                    // 2. ATTACH EXIT ORDERS
                    if not na(take_profit_price) and take_profit_price > 0
                        strategy.exit("Long Flip Exit", "Long Flip", stop = stop_loss_price, limit = take_profit_price)
                    else
                        strategy.exit("Long Flip Exit", "Long Flip", stop = stop_loss_price)
                    
                    // Zone and trade tracking (skip incrementing trade count in dry run)
                    if not dry_run_mode
                        // 3. SET ACTIVE ENTRY ID
                        active_entry_id := "Long Flip"
                    
                        // 4. INCREMENT TRADE COUNT
                        current_day_trades += 1
                    
                    // 5. MARK ZONE AS USED (even in dry run to avoid duplicate signals)
                    z.lastEntryBar := bar_index
                    z.active := false
                    last_global_long_entry_bar := bar_index
                    
                    // 6. DEACTIVATE ZONES
                    // Deactivate overlapping demand zones
                    deactivateOverlappingDemandZones(z.top, z.bottom)
                    
                    // 7. VISUALS
                    if show_entry_labels
                        string label_text = "🔵 LONG FLIP"
                        // Score labels removed
                        
                        label.new(x = bar_index, y = low - (pip_size * 5), text = label_text,
                                  style = label.style_label_up, color = color.new(color.blue, 0),
                                  textcolor = color.white, size = size.normal)
                    
                    // 8. TRACK TRADE (even in dry run for display purposes)
                    trade_entry_price := entry_price
                    trade_original_sl := stop_loss_price
                    trade_current_sl := stop_loss_price
                    labels_created := false
                    tp1_hit := false
                    trade_tp1_price := na
                    if not na(stop_loss_price)
                        trade_original_sl_pips := (entry_price - stop_loss_price) / pip_size
                    if not na(take_profit_price) and take_profit_price > entry_price
                        trade_tp1_price := take_profit_price
                    
                    // 8. SHOW LABELS (inside entry block) - only if not dry run (dry run labels shown above)
                    if not dry_run_mode and show_entry_labels and not debug_mode
                        // Simple clean label - no scores or details
                        entry_text = "🟢 LONG"
                        float y_long = low - (atr14 * long_label_offset_atr) - (syminfo.mintick * long_label_offset_ticks)
                        label.new(x = bar_index, y = y_long, text = entry_text,
                                  style = label.style_label_up, color = color.new(color.green, 0),
                                  textcolor = color.white, size = size.small)
                        
                        // SL/TP labels removed for clean chart - strategy arrows are sufficient
                        // if not na(stop_loss_price)
                        //     sl_pips_display = not na(sl_pips) ? str.tostring(sl_pips, "#.##") + " pips" : "N/A"
                        //     label.new(x = bar_index, y = stop_loss_price,
                        //               text = "SL: " + str.tostring(stop_loss_price, "#.####") + "\n(" + sl_pips_display + ")",
                        //               style = label.style_label_left, color = color.new(color.red, 0),
                        //               textcolor = color.white, size = size.normal)
                        
                        // if not na(take_profit_price)
                        //     tp_rr_display = not na(sl_pips) and sl_pips > 0 ? str.tostring((take_profit_price - entry_price) / (entry_price - stop_loss_price), "#.##") + " RR" : "N/A"
                        //     label.new(x = bar_index, y = take_profit_price,
                        //               text = "TP: " + str.tostring(take_profit_price, "#.####") + "\n(" + tp_rr_display + ")",
                        //               style = label.style_label_left, color = color.new(color.green, 0),
                        //               textcolor = color.white, size = size.normal)
                        
                        labels_created := true
                
                break

// Flip entry logic for supply zones (SHORT) - NEW
if enable_flip_entry and array.size(supplyZones) > 0 and allow_short_trades and is_new_30m_candle and strategy.position_size == 0
    current_close = close
    current_open = open
    current_low = low
    current_high = high
    is_bearish_candle = current_close < current_open
    
    for i = 0 to array.size(supplyZones) - 1
        Zone z = array.get(supplyZones, i)
        
        // Use base validation WITHOUT timing filter (flip entries are ALLOWED during timing windows)
        [base_can_enter_supply, base_reason_supply, _z] = validate_entry_conditions(false, i)
        
        if base_can_enter_supply
            // Flip Entry specific checks
            float zoneSize = z.top - z.bottom
            
            // Check if wick goes into zone (current candle approach)
            bool wick_into_zone = current_high >= z.bottom and current_high <= z.top
            float wick_size = current_high - current_close
            float wick_percent_of_zone = zoneSize > 0 ? (wick_size / zoneSize * 100) : 0
            
            // Strong flip in entry direction (bearish)
            bool strong_flip = is_bearish_candle and (current_open - current_close) > (current_high - current_low) * 0.6
            
            // Wick fully formed (top wick for shorts)
            bool wick_fully_formed = current_high > current_open and current_high > current_close
            
            // Check if wick size meets threshold
            bool wick_threshold_met = wick_percent_of_zone >= flip_wick_threshold_pct
            
            // PRIMED FLIP: Zone was primed on previous candle, now we have bearish close
            bool primed_flip = z.primed and z.primedBar == bar_index - 1 and is_bearish_candle
            
            // Flip-specific gate: Either standard flip OR primed flip
            bool can_flip_enter = enable_flip_entry and (primed_flip or (wick_into_zone and strong_flip and wick_fully_formed and (wick_threshold_met or true)))
            
            if can_flip_enter and barstate.isconfirmed
                bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue
                
                // Flip entry: use PREVIOUS candle's close as entry price
                entry_price = close[1]
                
                // SL = deepest wick of the priming candle (stored in primedWickLevel)
                // Fallback to previous candle's high if primedWickLevel not set
                stop_loss_price = not na(z.primedWickLevel) ? z.primedWickLevel : high[1]
                
                // Optional buffer: only apply if user explicitly sets it > 0
                if stop_loss_buffer_pips > 0
                    stop_loss_price := stop_loss_price + (stop_loss_buffer_pips * pip_size)
                
                // --- SAFETY CLAMP (SHORT) ---
                // Validate and Clamp SL
                [adjusted_sl, v_sl_pips, v_sl_valid] = validate_safety_clamp(false, entry_price, stop_loss_price)
                stop_loss_price := adjusted_sl
                sl_pips = v_sl_pips
                float pip_distance = sl_pips * pip_size
                
                if not v_sl_valid
                    continue  // Invalid SL, skip this trade
                
                // Calculate setup score (REMOVED) - using stub
                score_ok = enableScoreFilterStub ? score_pass_stub() : true
                
                // Only take trades that pass stub filter
                if not score_ok
                    continue
                
                // Calculate TP using Updated Rules
                float take_profit_price = na
                
                // Reset BE variables
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false
                
                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    
                    // Apply double TP
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                        
                    if not na(tp_r)
                        take_profit_price := entry_price - (pip_distance * tp_r)
                        
                    // Store BE settings - ALWAYS for 5-minute mode, otherwise check use_fixed_rr
                    if move_be
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl
                
                // --- TP DISTANCE VALIDATION ---
                if not validate_tp_distance(entry_price, take_profit_price, min_tp_distance_pips)
                    continue  // Skip this trade
                
                // Check for USDJPY rate failure for JPY pairs (before position sizing)
                if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                    // Fetch USDJPY rate using helper
                    [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                    if not usdjpy_success_check
                        // Show warning label and skip trade
                        if show_entry_labels
                            label.new(x = bar_index, y = low, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                                      style = label.style_label_up, color = color.new(color.orange, 0),
                                      textcolor = color.white, size = size.normal)
                        continue  // Skip this trade
                
                // Position sizing with enhanced validation
                balance  = account_size_usd
                risk_pct = risk_per_trade_pct
                
                // Apply 0.5R adjustment for second trade of the day
                if current_day_trades == 1 and max_trades_per_day == 2
                    risk_pct := risk_pct * 0.5
                
                // Enhanced position sizing validation
                [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_validation_details, pos_sl_fixed] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, false)
                
                // Use the corrected SL from validation
                stop_loss_price := pos_sl_fixed
                
                // Store position sizing details for debug table
                last_pos_size_entry := entry_price
                last_pos_size_sl := stop_loss_price
                last_pos_size_balance := balance
                last_pos_size_risk_pct := risk_pct
                last_pos_size_sl_pips := sl_pips
                last_pos_size_valid := pos_is_valid
                last_pos_size_error := pos_error_msg
                last_pos_size_dry_run := dry_run_mode
                
                if pos_is_valid
                    last_pos_size_units := pos_qty_units
                    last_pos_size_lots := pos_qty_lots
                    
                    // Get USDJPY rate for tracking
                    if str.contains(syminfo.ticker, "JPY")
                        [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                        if usdjpy_track_success_result
                            last_pos_size_usdjpy_rate := usdjpy_track_rate_result
                        else
                            last_pos_size_usdjpy_rate := na
                else
                    last_pos_size_units := na
                    last_pos_size_lots := na
                    last_pos_size_usdjpy_rate := na
                    
                    // Show warning label for validation failure
                    if show_entry_labels
                        label.new(x = bar_index, y = low, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                                  style = label.style_label_up, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.normal)

                // 🔥 ENTRY EXECUTION - ALL actions happen together
                if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                    // FINAL GUARD: Re-validate entry permission using base validation (no timing block for flip)
                    [isEntryPermitted, entryPermitReason, _zFlip] = validate_entry_conditions(false, i)
                    
                    // Diagnostic labels silenced - Zone Inspector tracks this data
                    // if debug_enabled and show_entry_labels
                    //     string debugMsg = "FLIP CHECK S-" + str.tostring(z.id) + "\nisEntryPermitted: " + str.tostring(isEntryPermitted) + "\nReason: " + entryPermitReason
                    //     label.new(x = bar_index, y = low - (high - low) * 0.5, text = debugMsg,
                    //               style = label.style_label_up, color = isEntryPermitted ? color.green : color.red,
                    //               textcolor = color.white, size = size.small)
                    
                    if not isEntryPermitted
                        continue  // Skip this entry if not permitted
                    
                    // Set entry sync flag BEFORE marking zone as used (for Zone Inspector)
                    entryTriggeredThisBar := true
                    triggeredZoneId := z.id
                    
                    // Dry run mode: show what would be executed without actually executing
                    if dry_run_mode
                        // Dry run labels removed for clean chart
                        // if show_entry_labels
                        //     label.new(x = bar_index, y = entry_price, text = "🔴 DRY RUN: Short Flip\nQty: " + str.tostring(pos_qty_units) + " units\nSL: " + str.tostring(stop_loss_price, "#.####"),
                        //               style = label.style_label_down, color = color.new(color.red, 0),
                        //               textcolor = color.white, size = size.normal)
                        
                        if not na(stop_loss_price)
                            sl_pips_display = not na(sl_pips) ? str.tostring(sl_pips, "#.##") + " pips" : "N/A"
                            // label.new(x = bar_index, y = stop_loss_price,
                            //           text = "DRY RUN SL: " + str.tostring(stop_loss_price, "#.####") + "\n(" + sl_pips_display + ")",
                            //           style = label.style_label_left, color = color.new(color.orange, 0),
                            //           textcolor = color.white, size = size.normal)
                    else
                        // 1. EXECUTE THE ENTRY (using close[1] as entry)
                        string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                        // Pass empty comment if entry labels are shown (to avoid duplicate [NRM] display)
                        string entryComment = show_entry_labels ? "" : typeTag
                        strategy.entry("Short Flip", strategy.short, qty = pos_qty_units, comment = entryComment)
                    
                    // 2. ATTACH EXIT ORDERS
                    if not na(take_profit_price) and take_profit_price > 0
                        strategy.exit("Short Flip Exit", "Short Flip", stop = stop_loss_price, limit = take_profit_price)
                    else
                        strategy.exit("Short Flip Exit", "Short Flip", stop = stop_loss_price)
                    
                    // Zone and trade tracking (skip incrementing trade count in dry run)
                    if not dry_run_mode
                        // 3. SET ACTIVE ENTRY ID
                        active_entry_id := "Short Flip"
                    
                        // 4. INCREMENT TRADE COUNT
                        current_day_trades += 1
                    
                    // 5. MARK ZONE AS USED (even in dry run to avoid duplicate signals)
                    z.lastEntryBar := bar_index
                    z.active := false
                    last_global_short_entry_bar := bar_index
                    
                    // 6. DEACTIVATE ZONES
                    // Deactivate overlapping supply zones
                    deactivateOverlappingSupplyZones(z.top, z.bottom)
                    
                    // 7. VISUALS
                    if show_entry_labels
                        // Simple clean label - no scores or details
                        string label_text = "🔴 SHORT"
                        label.new(x = bar_index, y = high + (pip_size * 5), text = label_text,
                                  style = label.style_label_down, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.small)
                
                break



            

// === PRIMED ENTRY EXECUTION (5-MINUTE DELAY) ===
// Check if any demand zone was primed on the PREVIOUS bar and execute entry now
// CRITICAL: The confirmation candle MUST touch the zone OR be a flip scenario
if barstate.isconfirmed and array.size(demandZones) > 0 and allow_long_trades and strategy.position_size == 0
    for i = 0 to array.size(demandZones) - 1
        Zone z = array.get(demandZones, i)
        // Check if zone was primed on the previous bar (5-minute delay)
        if z.active and z.primed and z.primedBar == bar_index - 1
            // Re-validate entry conditions on this new bar
            [still_valid, revalidateReason] = isValidDemandEntry(i)
            
            // Check current candle direction for flip logic
            bool is_bullish_now = close > open
            bool is_bearish_now = close < open
            
            // CRITICAL: Check if THIS candle's wick touches the zone (for demand: low must enter zone)
            bool wick_touches_zone = low <= z.top and low >= z.bottom
            
            // FLIP SCENARIO: Strong opposite direction candle that would trigger a flip
            // For demand primed entry, a flip would be a strong bearish move
            // (Not implemented here - flip entries are handled separately)
            
            // Diagnostic labels silenced - Zone Inspector tracks this data
            // if debug_full and show_entry_labels
            //     string debugMsg = "⏰ PRIMED CHECK D-" + str.tostring(z.id) + "\nWick Touches Zone: " + str.tostring(wick_touches_zone) + "\nStill Valid: " + str.tostring(still_valid) + "\nBullish Now: " + str.tostring(is_bullish_now)
            //     label.new(x = bar_index, y = high + (high - low) * 0.8, text = debugMsg,
            //               style = label.style_label_down, color = color.new(color.purple, 20),
            //               textcolor = color.white, size = size.tiny)
            
            // ONLY execute if: zone touch on this candle + still valid + bullish close
            if still_valid and is_bullish_now and wick_touches_zone
                // === EXECUTE PRIMED LONG ENTRY ===
                bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    z.primed := false
                    continue
                
                // Entry at current close (after 5-minute confirmation)
                float entry_price = close
                
                // SL = deepest wick from priming candle (stored in primedWickLevel)
                float stop_loss_price = z.primedWickLevel - (stop_loss_buffer_pips * pip_size)
                
                // Safety clamp
                float minGap_long = math.max(syminfo.mintick * 2, pip_size * 2.0)
                if stop_loss_price >= entry_price - minGap_long
                    stop_loss_price := entry_price - minGap_long
                
                float pip_distance = entry_price - stop_loss_price
                if pip_distance <= 0
                    z.primed := false
                    continue
                
                float sl_pips = pip_distance / pip_size
                
                // Score (REMOVED) - using stub
                score_ok = enableScoreFilterStub ? score_pass_stub() : true
                
                if not score_ok
                    z.primed := false
                    continue
                
                // TP Calculation
                float take_profit_price = na
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false
                
                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                    if not na(tp_r)
                        take_profit_price := entry_price + (pip_distance * tp_r)
                    if move_be
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl
                
                // Position sizing
                float qty_units_raw = calc_pos_size_units(entry_price, stop_loss_price, account_size_usd, risk_per_trade_pct, false)
                int pos_qty_units = int(math.round(qty_units_raw))
                pos_qty_units := math.max(pos_qty_units, 1)
                
                bool pos_is_valid = pos_qty_units >= min_position_size_units and pos_qty_units <= int(max_position_size_lots * 100000)
                
                if pos_is_valid and pos_qty_units > 0
                    entryTriggeredThisBar := true
                    triggeredZoneId := z.id
                    
                    if dry_run_mode
                        // Dry run labels removed for clean chart
                        // if show_entry_labels
                        //     label.new(x = bar_index, y = entry_price, text = "🔵 DRY RUN: Primed Long\nQty: " + str.tostring(pos_qty_units) + " units",
                        //               style = label.style_label_up, color = color.new(color.blue, 0),
                        //               textcolor = color.white, size = size.normal)
                        int dummy_var = 0  // Dummy statement to prevent empty block error
                    else
                        string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                        string entryComment = show_entry_labels ? "" : typeTag
                        strategy.entry("Long Primed", strategy.long, qty = pos_qty_units, comment = entryComment)
                    
                    if not na(take_profit_price) and take_profit_price > 0
                        strategy.exit("Long Primed Exit", "Long Primed", stop = stop_loss_price, limit = take_profit_price)
                    else
                        strategy.exit("Long Primed Exit", "Long Primed", stop = stop_loss_price)
                    
                    if not dry_run_mode
                        active_entry_id := "Long Primed"
                        current_day_trades += 1
                    
                    z.lastEntryBar := bar_index
                    z.active := false
                    z.primed := false
                    last_global_long_entry_bar := bar_index
                    
                    deactivateOverlappingDemandZones(z.top, z.bottom)
                    
                    if show_entry_labels
                        // Simple clean label - no scores or details
                        string label_text = "🟢 LONG"
                        float y_long = low - (atr14 * long_label_offset_atr) - (syminfo.mintick * long_label_offset_ticks)
                        label.new(x = bar_index, y = y_long, text = label_text,
                                  style = label.style_label_up, color = color.new(color.green, 0),
                                  textcolor = color.white, size = size.small)
                    
                    break
            else
                // Cancel primed entry - either: no zone touch, conditions invalid, or bearish close
                if debug_full and show_entry_labels
                    bool wick_touches_zone_cancel = low <= z.top and low >= z.bottom
                    string cancelReason = not wick_touches_zone_cancel ? "No Zone Touch" : (not is_bullish_now ? "Bearish Close" : "Invalid")
                    label.new(x = bar_index, y = high, text = "❌ PRIMED CANCELLED\nD-" + str.tostring(z.id) + "\n" + cancelReason,
                              style = label.style_label_down, color = color.new(color.gray, 20),
                              textcolor = color.white, size = size.tiny)
                z.primed := false

// === LONG ENTRY DETECTION (PRIMING PHASE) ===
// Instead of entering immediately, PRIME the zone for entry on the next candle
if barstate.isconfirmed and array.size(demandZones) > 0 and allow_long_trades
    current_close = close
    current_open  = open
    current_low   = low
    is_bullish_close = current_close > current_open
    
    for i = 0 to array.size(demandZones) - 1
        Zone z = array.get(demandZones, i)
        if z.active and not z.primed  // Don't re-prime already primed zones
            // Unified demand entry validation (shared with flip entries)
            [can_enter, entryReason] = isValidDemandEntry(i)

            // === PERFORMANCE STATS: ENTRY CHECKS (DEMAND) ===
            stat_total_entry_checks += 1
            if not can_enter
                if str.contains(entryReason, "timing")
                    stat_entries_blocked_by_timing += 1
                if str.contains(entryReason, "liquidity") or str.contains(entryReason, "Liq ")
                    stat_entries_blocked_by_liquidity += 1

            if can_enter
                // 2. Price Action: Bullish close ABOVE the zone
                // Note: isValidDemandEntry no longer checks this, so we check it here.
                bool bullish_close = close > open
                
                if not bullish_close
                    continue

                bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue

                entry_price = current_close

                float deepest_wick_in_zone = na
                for j = 0 to 5
                    if low[j] <= z.top and low[j] >= z.bottom
                        if na(deepest_wick_in_zone) or low[j] < deepest_wick_in_zone
                            deepest_wick_in_zone := low[j]
                
                if na(deepest_wick_in_zone)
                    deepest_wick_in_zone := current_low

                // SL Calculation: Use the LOWER of (deepest wick, zone bottom) minus buffer
                stop_loss_price = math.min(deepest_wick_in_zone, z.bottom) - (stop_loss_buffer_pips * pip_size)
                
                // --- SAFETY CLAMP (LONG) ---
                // Validate and Clamp SL
                [adjusted_sl, v_sl_pips, v_sl_valid] = validate_safety_clamp(true, entry_price, stop_loss_price)
                stop_loss_price := adjusted_sl
                sl_pips = v_sl_pips
                float pip_distance = sl_pips * pip_size
                
                if not v_sl_valid
                    continue
                
                // Calculate Score (REMOVED) - using stub
                score_ok = enableScoreFilterStub ? score_pass_stub() : true
                
                if not score_ok
                    continue
                
                // TP Calculation
                float take_profit_price = na
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false
                
                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                        
                    if not na(tp_r)
                        take_profit_price := entry_price + (pip_distance * tp_r)
                        
                    // Store BE settings
                    if move_be
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl
                
                // --- TP DISTANCE VALIDATION ---
                if not validate_tp_distance(entry_price, take_profit_price, min_tp_distance_pips)
                    continue  // Skip this trade
                
                // USDJPY Check
                if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                    [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                    if not usdjpy_success_check
                        if show_entry_labels
                            label.new(x = bar_index, y = high, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                                      style = label.style_label_down, color = color.new(color.orange, 0),
                                      textcolor = color.white, size = size.normal)
                        continue
                
                // Position Sizing
                balance  = account_size_usd
                risk_pct = risk_per_trade_pct
                
                if current_day_trades == 1 and max_trades_per_day == 2
                    risk_pct := risk_pct * 0.5
                
                [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_validation_details, pos_sl_fixed] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, false)
                
                // Use the corrected SL from validation
                stop_loss_price := pos_sl_fixed
                
                last_pos_size_entry := entry_price
                last_pos_size_sl := stop_loss_price
                last_pos_size_balance := balance
                last_pos_size_risk_pct := risk_pct
                last_pos_size_sl_pips := sl_pips
                last_pos_size_valid := pos_is_valid
                last_pos_size_error := pos_error_msg
                last_pos_size_dry_run := dry_run_mode
                
                if pos_is_valid
                    last_pos_size_units := pos_qty_units
                    last_pos_size_lots := pos_qty_lots
                    if str.contains(syminfo.ticker, "JPY")
                        [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                        if usdjpy_track_success_result
                            last_pos_size_usdjpy_rate := usdjpy_track_rate_result
                        else
                            last_pos_size_usdjpy_rate := na
                else
                    last_pos_size_units := na
                    last_pos_size_lots := na
                    last_pos_size_usdjpy_rate := na
                    if show_entry_labels
                        label.new(x = bar_index, y = high, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                                  style = label.style_label_down, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.normal)

                // === PRIMING PHASE: Set zone as primed instead of entering immediately ===
                // Entry will execute on the NEXT candle (5-minute delay for confirmation)
                if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                    // FINAL GUARD: Re-validate entry permission (same as Zone Inspector)
                    [isEntryPermitted, entryPermitReason] = isValidDemandEntry(i)
                    
                    if not isEntryPermitted
                        continue  // Skip this entry if not permitted
                    
                    // Calculate deepest wick for SL storage
                    float deepest_wick_for_sl = na
                    for j = 0 to 5
                        if low[j] <= z.top and low[j] >= z.bottom
                            if na(deepest_wick_for_sl) or low[j] < deepest_wick_for_sl
                                deepest_wick_for_sl := low[j]
                    if na(deepest_wick_for_sl)
                        deepest_wick_for_sl := math.min(current_low, z.bottom)
                    
                    // SET PRIMED FLAGS - Entry will happen on next candle
                    z.primed := true
                    z.primedBar := bar_index
                    z.primedWickLevel := deepest_wick_for_sl
                    
                    // DEBUG: Show priming label
                    if debug_enabled and show_entry_labels
                        string debugMsg = "⏳ PRIMED D-" + str.tostring(z.id) + "\nWaiting for next candle\nWick Level: " + str.tostring(deepest_wick_for_sl, format.mintick)
                        label.new(x = bar_index, y = high + (high - low) * 0.5, text = debugMsg,
                                  style = label.style_label_down, color = color.new(color.orange, 20),
                                  textcolor = color.white, size = size.small)

                break

// === PRIMED SHORT ENTRY EXECUTION (5-MINUTE DELAY) ===
// Check if any supply zone was primed on the PREVIOUS bar and execute entry now
// CRITICAL: The confirmation candle MUST touch the zone OR be a flip scenario
if barstate.isconfirmed and array.size(supplyZones) > 0 and allow_short_trades and strategy.position_size == 0
    for i = 0 to array.size(supplyZones) - 1
        Zone z = array.get(supplyZones, i)
        // Check if zone was primed on the previous bar (5-minute delay)
        if z.active and z.primed and z.primedBar == bar_index - 1
            // Re-validate entry conditions on this new bar
            [still_valid, revalidateReason] = isValidSupplyEntry(i)
            
            // Check current candle direction for flip logic
            bool is_bearish_now = close < open
            bool is_bullish_now = close > open
            
            // CRITICAL: Check if THIS candle's wick touches the zone (for supply: high must enter zone)
            bool wick_touches_zone = high >= z.bottom and high <= z.top
            
            // Diagnostic labels silenced - Zone Inspector tracks this data
            // if debug_full and show_entry_labels
            //     string debugMsg = "⏰ PRIMED CHECK S-" + str.tostring(z.id) + "\nWick Touches Zone: " + str.tostring(wick_touches_zone) + "\nStill Valid: " + str.tostring(still_valid) + "\nBearish Now: " + str.tostring(is_bearish_now)
            //     label.new(x = bar_index, y = low - (high - low) * 0.8, text = debugMsg,
            //               style = label.style_label_up, color = color.new(color.purple, 20),
            //               textcolor = color.white, size = size.tiny)
            
            // ONLY execute if: zone touch on this candle + still valid + bearish close
            if still_valid and is_bearish_now and wick_touches_zone
                // === EXECUTE PRIMED SHORT ENTRY ===
                bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    z.primed := false
                    continue
                
                // Entry at current close (after 5-minute confirmation)
                float entry_price = close
                
                // SL = highest wick from priming candle (stored in primedWickLevel)
                float stop_loss_price = z.primedWickLevel + (stop_loss_buffer_pips * pip_size)
                
                // Safety clamp
                float minGap_short = math.max(syminfo.mintick * 2, pip_size * 2.0)
                if stop_loss_price <= entry_price + minGap_short
                    stop_loss_price := entry_price + minGap_short
                
                float pip_distance = stop_loss_price - entry_price
                if pip_distance <= 0
                    z.primed := false
                    continue
                
                float sl_pips = pip_distance / pip_size
                
                // Score (REMOVED) - using stub
                score_ok = enableScoreFilterStub ? score_pass_stub() : true
                
                if not score_ok
                    z.primed := false
                    continue
                
                // TP Calculation
                float take_profit_price = na
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false
                
                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                    if not na(tp_r)
                        take_profit_price := entry_price - (pip_distance * tp_r)
                    if move_be
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl
                
                // Position sizing
                float qty_units_raw = calc_pos_size_units(entry_price, stop_loss_price, account_size_usd, risk_per_trade_pct, true)
                int pos_qty_units = int(math.round(qty_units_raw))
                pos_qty_units := math.max(pos_qty_units, 1)
                
                bool pos_is_valid = pos_qty_units >= min_position_size_units and pos_qty_units <= int(max_position_size_lots * 100000)
                
                if pos_is_valid and pos_qty_units > 0
                    entryTriggeredThisBar := true
                    triggeredZoneId := z.id
                    
                    if dry_run_mode
                        // Dry run labels removed for clean chart
                        // if show_entry_labels
                        //     label.new(x = bar_index, y = entry_price, text = "🔴 DRY RUN: Primed Short\nQty: " + str.tostring(pos_qty_units) + " units",
                        //               style = label.style_label_down, color = color.new(color.red, 0),
                        //               textcolor = color.white, size = size.normal)
                        int dummy_var = 0  // Dummy statement to prevent empty block error
                    else
                        string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                        string entryComment = show_entry_labels ? "" : typeTag
                        strategy.entry("Short Primed", strategy.short, qty = pos_qty_units, comment = entryComment)
                    
                    if not na(take_profit_price) and take_profit_price > 0
                        strategy.exit("Short Primed Exit", "Short Primed", stop = stop_loss_price, limit = take_profit_price)
                    else
                        strategy.exit("Short Primed Exit", "Short Primed", stop = stop_loss_price)
                    
                    if not dry_run_mode
                        active_entry_id := "Short Primed"
                        current_day_trades += 1
                    
                    z.lastEntryBar := bar_index
                    z.active := false
                    z.primed := false
                    last_global_short_entry_bar := bar_index
                    
                    deactivateOverlappingSupplyZones(z.top, z.bottom)
                    
                    if show_entry_labels
                        // Simple clean label - no scores or details
                        string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                        string label_text = "🔴 SHORT " + typeTag
                        label.new(x = bar_index, y = high + (pip_size * 5), text = label_text,
                                  style = label.style_label_down, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.small)
                    
                    break
            else
                // Cancel primed entry - either: no zone touch, conditions invalid, or bullish close
                if debug_full and show_entry_labels
                    bool wick_touches_zone_cancel = high >= z.bottom and high <= z.top
                    string cancelReason = not wick_touches_zone_cancel ? "No Zone Touch" : (not is_bearish_now ? "Bullish Close" : "Invalid")
                    label.new(x = bar_index, y = low, text = "❌ PRIMED CANCELLED\nS-" + str.tostring(z.id) + "\n" + cancelReason,
                              style = label.style_label_up, color = color.new(color.gray, 20),
                              textcolor = color.white, size = size.tiny)
                z.primed := false

// === SHORT ENTRY DETECTION (PRIMING PHASE) ===
// Instead of entering immediately, PRIME the zone for entry on the next candle
if barstate.isconfirmed and array.size(supplyZones) > 0 and allow_short_trades
    current_close = close
    current_open  = open
    current_high  = high
    is_bearish_close = current_close < current_open
    
    for i = 0 to array.size(supplyZones) - 1
        Zone z = array.get(supplyZones, i)
        if z.active and not z.primed  // Don't re-prime already primed zones
            // Unified supply entry validation (shared with flip entries)
            [can_enter, entryReason] = isValidSupplyEntry(i)

            // === PERFORMANCE STATS: ENTRY CHECKS (SUPPLY) ===
            stat_total_entry_checks += 1
            if not can_enter
                if str.contains(entryReason, "timing")
                    stat_entries_blocked_by_timing += 1
                if str.contains(entryReason, "liquidity") or str.contains(entryReason, "Liq ")
                    stat_entries_blocked_by_liquidity += 1

            if can_enter
                // 2. Price Action: Bearish close BELOW the zone
                // Note: isValidSupplyEntry no longer checks this, so we check it here.
                bool bearish_close = close < open
                
                if not bearish_close
                    continue

                bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue

                entry_price = current_close

                float highest_wick_in_zone = na
                for j = 0 to 5
                    if high[j] >= z.bottom and high[j] <= z.top
                        if na(highest_wick_in_zone) or high[j] > highest_wick_in_zone
                            highest_wick_in_zone := high[j]
                
                if na(highest_wick_in_zone)
                    highest_wick_in_zone := current_high

                // SL Calculation: Use the HIGHER of (highest wick, zone top) plus buffer
                stop_loss_price = math.max(highest_wick_in_zone, z.top) + (stop_loss_buffer_pips * pip_size)
                
                // --- SAFETY CLAMP (SHORT) ---
                // Validate and Clamp SL
                [adjusted_sl, v_sl_pips, v_sl_valid] = validate_safety_clamp(false, entry_price, stop_loss_price)
                stop_loss_price := adjusted_sl
                sl_pips = v_sl_pips
                float pip_distance = sl_pips * pip_size
                
                if not v_sl_valid
                    continue
                
                // Calculate Score (REMOVED) - using stub
                score_ok = enableScoreFilterStub ? score_pass_stub() : true
                
                if not score_ok
                    continue
                
                // TP Calculation
                float take_profit_price = na
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false
                
                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    
                    // Override with fixed RR - ONLY for non-5-minute modes
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                        
                    if not na(tp_r)
                        take_profit_price := entry_price - (pip_distance * tp_r)
                        
                    // Store BE settings
                    if move_be
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl
                
                // --- TP DISTANCE VALIDATION ---
                if not validate_tp_distance(entry_price, take_profit_price, min_tp_distance_pips)
                    continue  // Skip this trade
                
                // USDJPY Check
                if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                    [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                    if not usdjpy_success_check
                        if show_entry_labels
                            label.new(x = bar_index, y = low, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                                      style = label.style_label_up, color = color.new(color.orange, 0),
                                      textcolor = color.white, size = size.normal)
                        continue
                
                // Position Sizing
                balance  = account_size_usd
                risk_pct = risk_per_trade_pct
                
                if current_day_trades == 1 and max_trades_per_day == 2
                    risk_pct := risk_pct * 0.5
                
                [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_validation_details, pos_sl_fixed] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, false)
                
                // Use the corrected SL from validation
                stop_loss_price := pos_sl_fixed
                
                last_pos_size_entry := entry_price
                last_pos_size_sl := stop_loss_price
                last_pos_size_balance := balance
                last_pos_size_risk_pct := risk_pct
                last_pos_size_sl_pips := sl_pips
                last_pos_size_valid := pos_is_valid
                last_pos_size_error := pos_error_msg
                last_pos_size_dry_run := dry_run_mode
                
                if pos_is_valid
                    last_pos_size_units := pos_qty_units
                    last_pos_size_lots := pos_qty_lots
                    if str.contains(syminfo.ticker, "JPY")
                        [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                        if usdjpy_track_success_result
                            last_pos_size_usdjpy_rate := usdjpy_track_rate_result
                        else
                            last_pos_size_usdjpy_rate := na
                else
                    last_pos_size_units := na
                    last_pos_size_lots := na
                    last_pos_size_usdjpy_rate := na
                    if show_entry_labels
                        label.new(x = bar_index, y = low, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                                  style = label.style_label_up, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.normal)

                // === PRIMING PHASE: Set zone as primed instead of entering immediately ===
                // Entry will execute on the NEXT candle (5-minute delay for confirmation)
                if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                    // FINAL GUARD: Re-validate entry permission (same as Zone Inspector)
                    [isEntryPermitted, entryPermitReason] = isValidSupplyEntry(i)
                    
                    if not isEntryPermitted
                        continue  // Skip this entry if not permitted
                    
                    // Calculate highest wick for SL storage
                    float highest_wick_for_sl = na
                    for j = 0 to 5
                        if high[j] >= z.bottom and high[j] <= z.top
                            if na(highest_wick_for_sl) or high[j] > highest_wick_for_sl
                                highest_wick_for_sl := high[j]
                    if na(highest_wick_for_sl)
                        highest_wick_for_sl := math.max(current_high, z.top)
                    
                    // SET PRIMED FLAGS - Entry will happen on next candle
                    z.primed := true
                    z.primedBar := bar_index
                    z.primedWickLevel := highest_wick_for_sl
                    
                    // DEBUG: Show priming label
                    if debug_enabled and show_entry_labels
                        string debugMsg = "⏳ PRIMED S-" + str.tostring(z.id) + "\nWaiting for next candle\nWick Level: " + str.tostring(highest_wick_for_sl, format.mintick)
                        label.new(x = bar_index, y = low - (high - low) * 0.5, text = debugMsg,
                                  style = label.style_label_up, color = color.new(color.orange, 20),
                                  textcolor = color.white, size = size.small)

                break

// =============================
// GLOBAL EXIT MANAGEMENT
// =============================
// CRITICAL: This section runs EVERY BAR when in a position to ensure SL/TP orders are always active
// TradingView requires exit orders to be submitted every bar - they do not persist automatically
if strategy.position_size != 0 and not na(active_entry_id) and not na(trade_current_sl) and trade_current_sl > 0
    // Validate SL based on position direction
    bool sl_valid = false
    if strategy.position_size > 0  // Long position
        // For longs: SL must be BELOW entry and POSITIVE
        sl_valid := trade_current_sl > 0 and not na(trade_entry_price) and trade_current_sl < trade_entry_price
    else if strategy.position_size < 0  // Short position
        // For shorts: SL must be ABOVE entry and POSITIVE
        sl_valid := trade_current_sl > 0 and not na(trade_entry_price) and trade_current_sl > trade_entry_price
    
    if sl_valid
        // Submit exit orders for the active entry
        if active_entry_id == "Long"
            if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                strategy.exit("Long Exit", "Long", stop = trade_current_sl, limit = trade_tp1_price)
            else
                strategy.exit("Long Exit", "Long", stop = trade_current_sl)
        else if active_entry_id == "Long Flip"
            if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                strategy.exit("Long Flip Exit", "Long Flip", stop = trade_current_sl, limit = trade_tp1_price)
            else
                strategy.exit("Long Flip Exit", "Long Flip", stop = trade_current_sl)
        else if active_entry_id == "Short"
            if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                strategy.exit("Short Exit", "Short", stop = trade_current_sl, limit = trade_tp1_price)
            else
                strategy.exit("Short Exit", "Short", stop = trade_current_sl)
        else if active_entry_id == "Short Flip"
            if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                strategy.exit("Short Flip Exit", "Short Flip", stop = trade_current_sl, limit = trade_tp1_price)
            else
                strategy.exit("Short Flip Exit", "Short Flip", stop = trade_current_sl)

// === BREAK-EVEN LOGIC (Updated Rules) ===
if strategy.position_size != 0 and not na(trade_entry_price) and not na(trade_original_sl_pips) and not na(active_entry_id) and not trade_be_moved
    // Check if BE rules apply
    if not na(trade_be_trigger_rr) and trade_be_trigger_rr > 0
        float current_profit_pips = 0.0
        float current_profit_rr = 0.0
        
        if strategy.position_size > 0  // Long
            current_profit_pips := (close - trade_entry_price) / pip_size
        else if strategy.position_size < 0  // Short
            current_profit_pips := (trade_entry_price - close) / pip_size
        
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0
        
        // Check if we've reached the BE trigger RR level
        if current_profit_rr >= trade_be_trigger_rr
            float new_be_sl = na
            float profit_lock_pips = 0.0
            
            // Logic: 
            // If trade_be_sl_pips > 0 (The <= 3 pip case), lock in Max(1R, 2 pips)
            // Else (The normal BE case), lock in 0 pips (Entry)
            if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                profit_lock_pips := math.max(trade_original_sl_pips, trade_be_sl_pips)
            else
                profit_lock_pips := 0.0
            
            if strategy.position_size > 0  // Long
                new_be_sl := trade_entry_price + (profit_lock_pips * pip_size)
            else if strategy.position_size < 0  // Short
                new_be_sl := trade_entry_price - (profit_lock_pips * pip_size)
            
            // Update SL to BE
            if not na(new_be_sl) and new_be_sl > 0
                trade_current_sl := new_be_sl
                trade_be_moved := true
                
                // Update exit orders with new BE SL
                if active_entry_id == "Long"
                    if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                        strategy.exit("Long Exit", "Long", stop = new_be_sl, limit = trade_tp1_price)
                    else
                        strategy.exit("Long Exit", "Long", stop = new_be_sl)
                else if active_entry_id == "Long Flip"
                    if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                        strategy.exit("Long Flip Exit", "Long Flip", stop = new_be_sl, limit = trade_tp1_price)
                    else
                        strategy.exit("Long Flip Exit", "Long Flip", stop = new_be_sl)
                else if active_entry_id == "Short"
                    if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                        strategy.exit("Short Exit", "Short", stop = new_be_sl, limit = trade_tp1_price)
                    else
                        strategy.exit("Short Exit", "Short", stop = new_be_sl)
                else if active_entry_id == "Short Flip"
                    if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                        strategy.exit("Short Flip Exit", "Short Flip", stop = new_be_sl, limit = trade_tp1_price)
                    else
                        strategy.exit("Short Flip Exit", "Short Flip", stop = new_be_sl)

// === CHECK IF TP1 IS HIT ===
if strategy.position_size != 0 and not na(trade_tp1_price) and not tp1_hit
    bool tp_hit = false
    if strategy.position_size > 0  // Long
        tp_hit := close >= trade_tp1_price
    else if strategy.position_size < 0  // Short
        tp_hit := close <= trade_tp1_price
    
    if tp_hit
        tp1_hit := true
        
        // Special case: For SL ≥ 11.1 pips, close full at 1:2 (no BE move)
        if false  // jpy_close_at_2r functionality removed
            if active_entry_id == "Long"
                strategy.close("Long", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Long Flip"
                strategy.close("Long Flip", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Short"
                strategy.close("Short", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Short Flip"
                strategy.close("Short Flip", comment = "Close at 1:2 (JPY Rule)")
        else
            // Move to break-even if enabled (standard BE mode)
            if use_break_even and not na(trade_entry_price) and trade_entry_price > 0 and not na(active_entry_id)
                if active_entry_id == "Long"
                    strategy.exit("Long Exit", "Long", stop = trade_entry_price)
                else if active_entry_id == "Long Flip"
                    strategy.exit("Long Flip Exit", "Long Flip", stop = trade_entry_price)
                else if active_entry_id == "Short"
                    strategy.exit("Short Exit", "Short", stop = trade_entry_price)
                else if active_entry_id == "Short Flip"
                    strategy.exit("Short Flip Exit", "Short Flip", stop = trade_entry_price)

// === 2025 TRAILING STOP LOGIC (1-MINUTE TRAILING AFTER TP1) ===
if strategy.position_size != 0 and use_stop_loss and not na(trade_entry_price) and not na(trade_original_sl) and not na(trade_original_sl_pips) and not na(active_entry_id)
    float risk_amount = 0.0
    float current_profit_pips = 0.0
    float current_profit_rr = 0.0
    
    if strategy.position_size > 0  // Long
        risk_amount := trade_entry_price - trade_original_sl
        current_profit_pips := (close - trade_entry_price) / pip_size
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0
    else if strategy.position_size < 0  // Short
        risk_amount := trade_original_sl - trade_entry_price
        current_profit_pips := (trade_entry_price - close) / pip_size
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0

    // Hard close at R=10 - use active_entry_id for correct close
    if current_profit_rr >= 10.0
        if active_entry_id == "Long"
            strategy.close("Long", comment = "Hard Close at 1:10")
        else if active_entry_id == "Long Flip"
            strategy.close("Long Flip", comment = "Hard Close at 1:10")
        else if active_entry_id == "Short"
            strategy.close("Short", comment = "Hard Close at 1:10")
        else if active_entry_id == "Short Flip"
            strategy.close("Short Flip", comment = "Hard Close at 1:10")

    float new_sl = na
    bool should_update_sl = false
    
    // 2025: 1-minute trailing stop after TP1 is hit (only if not JPY close-at-2R rule)
    if tp1_hit and false  // jpy_close_at_2r functionality removed
        // Get 1-minute data for trailing
        [one_min_close, one_min_open, one_min_high, one_min_low] = request.security(syminfo.tickerid, "1", [close, open, high, low], lookahead = barmerge.lookahead_off)
        
        // Declare candidate_sl with type
        float candidate_sl = na
        
        if strategy.position_size > 0  // Long position
            // Trail SL under each bullish 1m candle
            if one_min_close > one_min_open
                // Bullish 1m candle - trail under low
                candidate_sl := one_min_low
            else if one_min_close < one_min_open
                // Bearish 1m candle - for large candles, trail halfway
                candle_size = one_min_high - one_min_low
                large_candle_threshold = math.abs(trade_entry_price - trade_original_sl) * 0.5  // 50% of initial risk
                if candle_size > large_candle_threshold
                    candidate_sl := one_min_low + (candle_size * 0.5)  // Halfway inside
                else
                    candidate_sl := one_min_low
            else
                // Doji or equal open/close - trail under low
                candidate_sl := one_min_low
            
            // Only move SL up, never down (and respect JPY BE minimum SL if set)
            if not na(candidate_sl)
                // For trades with minimum locked profit requirement, ensure we don't go below it
                if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                    min_sl_price = trade_entry_price + (trade_be_sl_pips * pip_size)
                    candidate_sl := math.max(candidate_sl, min_sl_price)
                
                if na(trade_current_sl) or candidate_sl > trade_current_sl
                    new_sl := candidate_sl
                    should_update_sl := true
        else if strategy.position_size < 0  // Short position
            // Trail SL above each bearish 1m candle
            if one_min_close < one_min_open
                // Bearish 1m candle - trail above high
                candidate_sl := one_min_high
            else if one_min_close > one_min_open
                // Bullish 1m candle - for large candles, trail halfway inside
                candle_size = one_min_high - one_min_low
                large_candle_threshold = math.abs(trade_original_sl - trade_entry_price) * 0.5  // 50% of initial risk
                if candle_size > large_candle_threshold
                    candidate_sl := one_min_high - (candle_size * 0.5)  // Halfway inside
                else
                    candidate_sl := one_min_high
            else
                // Doji or equal open/close - trail above high
                candidate_sl := one_min_high
            
            // Only move SL down, never up (and respect JPY BE minimum SL if set)
            if not na(candidate_sl)
                // For trades with minimum locked profit requirement, ensure we don't go above it
                if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                    max_sl_price = trade_entry_price - (trade_be_sl_pips * pip_size)
                    candidate_sl := math.min(candidate_sl, max_sl_price)
                
                if na(trade_current_sl) or candidate_sl < trade_current_sl
                    new_sl := candidate_sl
                    should_update_sl := true
    else
        // No trailing active - check if we need to update SL for other reasons
        if strategy.position_size > 0  // Long: move SL up
            should_update_sl := na(trade_current_sl) or new_sl > trade_current_sl
        else if strategy.position_size < 0  // Short: move SL down
            should_update_sl := na(trade_current_sl) or new_sl < trade_current_sl
    
    if should_update_sl and (tp1_hit or not trade_be_moved)
        if active_entry_id == "Long"
            strategy.exit("Long Exit", "Long", stop = new_sl)
        else if active_entry_id == "Long Flip"
            strategy.exit("Long Flip Exit", "Long Flip", stop = new_sl)
        else if active_entry_id == "Short"
            strategy.exit("Short Exit", "Short", stop = new_sl)
        else if active_entry_id == "Short Flip"
            strategy.exit("Short Flip Exit", "Short Flip", stop = new_sl)
        trade_current_sl := new_sl

// === EVENT-BASED TRADE CLOSURE DETECTION ===
// Detect trade closure reliably using engine state comparison
bool trade_just_closed = strategy.closedtrades > strategy.closedtrades[1]

if trade_just_closed
    // Get the index of the most recently closed trade
    int last_trade_idx = strategy.closedtrades - 1
    
    // Read the result and the comment "Tag" directly from the engine
    bool was_win = strategy.closedtrades.profit(last_trade_idx) > 0
    string entry_comment = strategy.closedtrades.entry_comment(last_trade_idx)
    
    // Check the tag and increment correct bucket
    if str.contains(entry_comment, "[ACC]")
        stat_trades_accuracy_total += 1
        if was_win
            stat_trades_accuracy_wins += 1
        else
            stat_trades_accuracy_losses += 1
    else
        // Assume Normal if it has [NRM] or no tag
        stat_trades_normal_total += 1
        if was_win
            stat_trades_normal_wins += 1
        else
            stat_trades_normal_losses += 1

    // RR tracking by symbol bucket (use last closed trade profit for RR approximation)
    float lastProfit = strategy.closedtrades.profit(last_trade_idx)
    float lastEntry = strategy.closedtrades.entry_price(last_trade_idx)
    float riskPips = trade_original_sl_pips
    float rr = (not na(riskPips) and riskPips != 0 and not na(lastEntry)) ? lastProfit / (riskPips * pip_size * 100) : 0.0
    
    bucket = get_symbol_bucket()
    if bucket == "XAU"
        stat_rr_sum_xau += rr
        stat_rr_count_xau += 1
    else if bucket == "JPY"
        stat_rr_sum_jpy += rr
        stat_rr_count_jpy += 1
    else
        stat_rr_sum_other += rr
        stat_rr_count_other += 1

    // Reset tracking variables after trade closes
    trade_entry_price      := na
    trade_original_sl      := na
    trade_original_sl_pips := na
    trade_current_sl       := na
    labels_created         := false
    tp1_hit                := false
    trade_tp1_price        := na
    active_entry_id        := na
    // Reset BE tracking
    trade_be_trigger_rr      := na
    trade_be_sl_pips         := na
    trade_be_moved := false

// === LIQUIDITY LINES CONTROL ===
// Arrays to track liquidity lines and their active status
var line[] _lowLiqLines = array.new_line()
var bool[] _lowLiqActive = array.new_bool()
var line[] _highLiqLines = array.new_line()
var bool[] _highLiqActive = array.new_bool()

// Extend lines forward while not crossed; when swept, recolor and stop extending
_controlLine(_lines, _activeFlags, __high, __low) =>
    sz = array.size(_lines)
    if sz > 0
        for i = 0 to sz - 1
            lineRef  = array.get(_lines, i)
            bool isActive = i < array.size(_activeFlags) ? array.get(_activeFlags, i) : false
            float y1 = line.get_y1(lineRef)
            float y2 = line.get_y2(lineRef)
            float lvlLow = math.min(y1, y2)
            float lvlHigh = math.max(y1, y2)
            // Add tolerance for sweep detection (0.1 pip tolerance)
            float tolerance = pip_size * 0.1
            bool isCrossed = (__high >= lvlLow - tolerance and __low <= lvlLow + tolerance) or (__high >= lvlHigh - tolerance and __low <= lvlHigh + tolerance)
            // If active and crossed first time → mark as swept & recolor
            if isActive and isCrossed
                line.set_color(lineRef, color.new(color.purple, 0))
                if i < array.size(_activeFlags)
                    array.set(_activeFlags, i, false)
                // SWEPT text label removed - color change to purple is sufficient
            // Extend unswept lines to current bar+1
            if isActive and (not isCrossed) and bar_index >= line.get_x1(lineRef)
                line.set_x2(lineRef, bar_index + 1)

// === VISUAL LIQUIDITY LINES (same style as standalone Liquidity indicator) ===
// Use pivot lows/highs as liquidity bottoms/tops and recolor when swept.

// Pivot LOW → bottom liquidity line (use 3-candle pivot)
if isPvtLow and plotLiq
    int  pBar  = bar_index - 1  // Middle candle of the 3-candle pattern
    float pLow = low[1]
    lowLine = line.new(x1 = pBar, y1 = pLow, x2 = bar_index, y2 = pLow,
                       extend = extend.none, color = pvtBtmColor, style = pvtStyle, xloc = xloc.bar_index)
    if array.size(_lowLiqLines) >= pvtMax
        line.delete(array.shift(_lowLiqLines))
        if array.size(_lowLiqActive) > 0
            array.shift(_lowLiqActive)
    array.push(_lowLiqLines, lowLine)
    array.push(_lowLiqActive, true)

// Pivot HIGH → top liquidity line (use 3-candle pivot)
if isPvtHigh and plotLiq
    int  pBar  = bar_index - 1  // Middle candle of the 3-candle pattern
    float pHigh = high[1]
    highLine = line.new(x1 = pBar, y1 = pHigh, x2 = bar_index, y2 = pHigh,extend = extend.none, color = pvtTopColor, style = pvtStyle, xloc = xloc.bar_index)
    if array.size(_highLiqLines) >= pvtMax
        line.delete(array.shift(_highLiqLines))
        if array.size(_highLiqActive) > 0
            array.shift(_highLiqActive)
    array.push(_highLiqLines, highLine)
    array.push(_highLiqActive, true)

if plotLiq
    _controlLine(_lowLiqLines, _lowLiqActive, high, low)
    _controlLine(_highLiqLines, _highLiqActive, high, low)

// === DEBUG TABLE ===
var table debugTable = na

// Full debug level: show global debug panel, but only on the most recent N bars and confirmed bars
// to avoid heavy calculations on deep history and improve performance.
if debug_full and isRecentBarForDebug() and barstate.isconfirmed
    if na(debugTable)
        debugTable := table.new(position.top_left, 2, 10, 
                                 bgcolor = color.new(color.rgb(30, 35, 40), 5), 
                                 border_width = 1, 
                                 border_color = color.new(color.white, 70), 
                                 frame_width = 1, 
                                 frame_color = color.new(color.white, 70))
    
    if not na(debugTable) and barstate.isconfirmed
        // Find closest active zone
        float closestDemandDist = na
        int closestDemandIdx = na
        float closestSupplyDist = na
        int closestSupplyIdx = na
        float currentPrice = close
        
        // Find closest demand zone
        if array.size(demandZones) > 0
            for i = 0 to array.size(demandZones) - 1
                Zone z = array.get(demandZones, i)
                if z.active
                    dist = math.abs(currentPrice - z.top)
                    if na(closestDemandDist) or dist < closestDemandDist
                        closestDemandDist := dist
                        closestDemandIdx := i
        
        // Find closest supply zone
        if array.size(supplyZones) > 0
            for i = 0 to array.size(supplyZones) - 1
                Zone z = array.get(supplyZones, i)
                if z.active
                    dist = math.abs(currentPrice - z.bottom)
                    if na(closestSupplyDist) or dist < closestSupplyDist
                        closestSupplyDist := dist
                        closestSupplyIdx := i
        
        // Determine closest zone overall
        string closestType = "None"
        int closestIdx = na
        float closestDist = na
        bool isClosestDemand = false
        
        if not na(closestDemandDist) and not na(closestSupplyDist)
            if closestDemandDist < closestSupplyDist
                closestType := "Demand"
                closestIdx := closestDemandIdx
                closestDist := closestDemandDist
                isClosestDemand := true
            else
                closestType := "Supply"
                closestIdx := closestSupplyIdx
                closestDist := closestSupplyDist
                isClosestDemand := false
        else if not na(closestDemandDist)
            closestType := "Demand"
            closestIdx := closestDemandIdx
            closestDist := closestDemandDist
            isClosestDemand := true
        else if not na(closestSupplyDist)
            closestType := "Supply"
            closestIdx := closestSupplyIdx
            closestDist := closestSupplyDist
            isClosestDemand := false
        
        // Get zone details if found
        string zoneState = "N/A"
        string accuracyStatus = "N/A"
        string liqValidStatus = "N/A"
        bool isAccuracy = false
        bool liqValid = false
        bool liqExists = false
        float zoneEntryPrice = na
        float zoneLow = na
        float zoneHigh = na
        bool leftZone = false
        
        if not na(closestIdx)
            if isClosestDemand
                Zone z = array.get(demandZones, closestIdx)
                zoneHigh := z.top
                zoneLow := z.bottom
                zoneEntryPrice := zoneHigh
                leftZone := z.leftZone
                zoneState := leftZone ? "Tapped" : "Untapped"
                
                // Accuracy zone (not stored in UDT)
                accuracyStatus := "N/A"
                
                // Liquidity validation
                liqValid := z.liquidityValid
                liqExists := not na(z.liquidityPrice)
                liqValidStatus := liqExists ? (liqValid ? "Yes" : "No") : "N/A"
            else
                Zone z = array.get(supplyZones, closestIdx)
                zoneHigh := z.top
                zoneLow := z.bottom
                zoneEntryPrice := zoneLow
                leftZone := z.leftZone
                zoneState := leftZone ? "Tapped" : "Untapped"
                
                // Accuracy zone
                accuracyStatus := "N/A"
                
                // Liquidity validation
                liqValid := z.liquidityValid
                liqExists := not na(z.liquidityPrice)
                liqValidStatus := liqExists ? (liqValid ? "Yes" : "No") : "N/A"
                // Liquidity validation
                liqValid := z.liquidityValid
                liqExists := not na(z.liquidityPrice)
                liqValidStatus := liqExists ? (liqValid ? "Yes" : "No") : "N/A"
                
                // Debug Liquidity Linking
                if debug_liq_extra
                    // Row 5: Liquidity Details
                    table.cell(debugTable, 0, 5, "Liq Debug", text_color = color.yellow, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
                    
                    string debugStr = "N/A"
                    if liqExists
                        int liqBar = z.liquidityBarIndex
                        int endBar = z.liquiditySwept ? z.liquiditySweptBarIndex : bar_index
                        int count = z.liquidityCandleCount
                        float lPrice = z.liquidityPrice
                        
                        // Re-calculate range for display
                        float rLow = na
                        float rHigh = na
                        if isClosestDemand
                            rLow := lPrice
                            rHigh := getMaxHighBetween(liqBar, endBar)
                        else
                            rHigh := lPrice
                            rLow := getMinLowBetween(liqBar, endBar)
                        
                        debugStr := str.format("P:{0} B:{1} E:{2} C:{3}\nR:{4}-{5}", str.tostring(lPrice, format.mintick), str.tostring(liqBar), str.tostring(endBar), str.tostring(count), str.tostring(rLow, format.mintick), str.tostring(rHigh, format.mintick))
                    else
                        debugStr := "No Candidate"
                    
                    table.cell(debugTable, 1, 5, debugStr, text_color = color.yellow, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Check entry allowed (timing filters)
        bool entryAllowed = true
        if enable_timing_filters
            time_to_30m = get_time_to_next_30m()
            time_to_1h = get_time_to_next_1h()
            // Note: red news check would go here if implemented
            entryAllowed := (time_to_30m >= 5) and (time_to_1h >= 10)
        
        // Check flip entry available
        bool flipAvailable = false
        if enable_flip_entry and is_new_30m_candle
            flipAvailable := true
        
        // Header row (row 0) - spans both columns visually
        table.cell(debugTable, 0, 0, "🔍 DEBUG PANEL", text_color = color.white, bgcolor = color.rgb(45, 50, 55), text_size = size.small, text_halign = text.align_left)
        table.cell(debugTable, 1, 0, "", bgcolor = color.rgb(45, 50, 55))
        
        // Row 1: Closest Zone Type
        table.cell(debugTable, 0, 1, "Zone Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        typeColor = closestType == "Demand" ? color.green : (closestType == "Supply" ? color.red : color.rgb(200, 200, 200))
        table.cell(debugTable, 1, 1, closestType, text_color = typeColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 2: Zone UZID (permanent unique ID)
        int closestZoneUZID = na
        if not na(closestIdx)
            if isClosestDemand
                Zone z = array.get(demandZones, closestIdx)
                closestZoneUZID := z.id
            else
                Zone z = array.get(supplyZones, closestIdx)
                closestZoneUZID := z.id
        table.cell(debugTable, 0, 2, "Zone UZID", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        uzidStr = not na(closestZoneUZID) ? str.tostring(closestZoneUZID) : "N/A"
        table.cell(debugTable, 1, 2, uzidStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 3: Zone Range
        table.cell(debugTable, 0, 3, "Zone Range", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        zoneRangeStr = (not na(zoneLow) and not na(zoneHigh)) ? str.format("{0} → {1}", str.tostring(zoneLow, format.mintick), str.tostring(zoneHigh, format.mintick)) : "N/A"
        table.cell(debugTable, 1, 3, zoneRangeStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 4: Distance to Price
        table.cell(debugTable, 0, 4, "Distance", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        distPips = not na(closestDist) ? str.tostring(math.round(closestDist / pip_size * 10) / 10, "#.#") + " pips" : "N/A"
        table.cell(debugTable, 1, 4, distPips, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 5: Zone State
        table.cell(debugTable, 0, 5, "Zone State", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        stateColor = getZoneStateColor(zoneState)
        table.cell(debugTable, 1, 5, zoneState, text_color = stateColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 6: Accuracy Zone
        table.cell(debugTable, 0, 6, "Accuracy Zone", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        accColor = getAccuracyColor(accuracyStatus)
        accDisplay = accuracyStatus == "Accuracy Adjusted" ? "Yes" : "No"
        table.cell(debugTable, 1, 6, accDisplay, text_color = accColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 7: Liquidity Valid
        table.cell(debugTable, 0, 7, "Liquidity Valid", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        liqColor = getLiquidityColor(liqValidStatus)
        table.cell(debugTable, 1, 7, liqValidStatus, text_color = liqColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 8: Entry Allowed Now
        table.cell(debugTable, 0, 8, "Entry Allowed", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        entryStr = entryAllowed ? "Yes" : "No"
        entryColor = entryAllowed ? color.new(color.green, 0) : color.new(color.red, 0)
        table.cell(debugTable, 1, 8, entryStr, text_color = entryColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 9: Flip Entry Available
        table.cell(debugTable, 0, 9, "Flip Entry", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        flipStr = flipAvailable ? "Yes" : "No"
        flipColor = flipAvailable ? color.orange : color.rgb(200, 200, 200)
        table.cell(debugTable, 1, 9, flipStr, text_color = flipColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

// === ZONE INSPECTOR TABLE ===
var table zoneInspector = na

// Show Zone Inspector only when debug is enabled (Basic or Full), and only on
// the most recent N bars and confirmed bars according to the debug_last_bars filter for performance.
if showZoneInspector and debug_enabled and isRecentBarForDebug() and barstate.isconfirmed
    if na(zoneInspector)
        zoneInspector := table.new(position.bottom_right, 2, 50, bgcolor = color.new(color.rgb(30, 35, 40), 5), border_width = 1, border_color = color.new(color.white, 70), frame_width = 1, frame_color = color.new(color.white, 70))
    
    if not na(zoneInspector) and barstate.isconfirmed
        // Get additional zone details for inspector
        string zoneInspectorType = "None"
        int zoneInspectorIdx = na
        float zoneInspectorLow = na
        float zoneInspectorHigh = na
        float zoneInspectorSizePips = na
        int barsSinceCreation = na
        string liqRequired = "N/A"
        string liqExistsInspector = "N/A"
        string liqCandlesCountInspector = "N/A"
        string liqSweptInspector = "N/A"
        string targetSweptInspector = "N/A"
        string sweepBarIdx = "N/A"
        string wickInZone = "N/A"
        string notClosedIn = "N/A"
        string bullishBearishClose = "N/A"
        string zoneUsedInspector = "N/A"
        string zoneCausedSweepInspector = "N/A"
        string entryAllowedInspector = "N/A"
        string rejectionReasonInspector = "N/A"
        string liqDistInspector = "N/A"
        bool liqDistExceedsMax = false
        
        // === DEBUG VARIABLES FOR ZONE LOOKUP ===
        string manualParsedIdStr = "N/A"
        string foundInPool = "NOT_FOUND"
        string notFoundReason = "N/A"
        string zoneStatus = "N/A"          // LIVE / INACTIVE
        string zoneInactiveReason = "N/A"  // max_pruned / removed / etc.
        
        // === MANUAL ZONE ID LOOKUP (Enhanced with zoneDB Search) ===
        // Parse string input to extract type hint (S/D) and numeric ID
        string manualInputClean = str.trim(manual_zone_id_input)
        string manualTypeHint = "Any"
        int manualZoneId = na
        
        if str.length(manualInputClean) > 0
            string working = manualInputClean
            string firstChar = str.upper(str.substring(working, 0, 1))
            
            // Check for D- or S- prefix
            if firstChar == "D" or firstChar == "S"
                manualTypeHint := firstChar == "D" ? "Demand" : "Supply"
                dashPos = str.pos(working, "-")
                if dashPos >= 0
                    working := str.substring(working, dashPos + 1, str.length(working))
                else
                    working := str.substring(working, 1, str.length(working))
            
            // Remove any spaces and parse number
            working := str.replace_all(working, " ", "")
            float parsedVal = str.tonumber(working)
            if not na(parsedVal)
                manualZoneId := int(math.round(parsedVal))
                manualParsedIdStr := str.tostring(manualZoneId)
            else
                notFoundReason := "invalid_input"
        
        int inspectIndex = na
        string inspectType = "None"
        ZoneDBEntry dbEntry = na
        bool foundInDB = false
        
        // STEP 1: Determine Target Zone ID (Default to latest active if empty)
        int targetId = na
        if str.length(manualInputClean) == 0
            // Default: Try Demand[0] then Supply[0]
            if array.size(demandZones) > 0
                targetId := array.get(demandZones, 0).id
            else if array.size(supplyZones) > 0
                targetId := array.get(supplyZones, 0).id
        else
            targetId := manualZoneId
            
        // STEP 2: Search zoneDB FIRST (single source of truth)
        if not na(targetId)
            int dbIdx = db_findIndexByUZID(targetId)
            if not na(dbIdx)
                dbEntry := array.get(zoneDB, dbIdx)
                foundInDB := true
                inspectType := dbEntry.zoneType == "DEMAND" ? "Demand" : "Supply"
                foundInPool := "ZONEDB_ONLY"  // Default: found in DB only
                zoneStatus := dbEntry.active ? "LIVE" : "INACTIVE"
                zoneInactiveReason := dbEntry.active ? "N/A" : dbEntry.inactiveReason
                notFoundReason := "N/A"
                
                // STEP 3: ALWAYS try to find in live arrays (even if inactive in DB)
                // This allows showing live liquidity/sweep data if zone still exists in arrays
                if dbEntry.zoneType == "DEMAND"
                    inspectIndex := findDemandZoneIndexByUZID(targetId)
                    if not na(inspectIndex)
                        foundInPool := "DEMAND_LIVE"
                else
                    inspectIndex := findSupplyZoneIndexByUZID(targetId)
                    if not na(inspectIndex)
                        foundInPool := "SUPPLY_LIVE"
            else
                // Not in DB - try live arrays as fallback
                int demandIdxManual = na
                int supplyIdxManual = na
                
                // Optimized fallback search
                demandIdxManual := findDemandZoneIndexByUZID(targetId)
                if not na(demandIdxManual)
                    inspectIndex := demandIdxManual
                    inspectType := "Demand"
                    foundInPool := "DEMAND_LIVE"
                    zoneStatus := "LIVE"
                    notFoundReason := "N/A"
                else
                    supplyIdxManual := findSupplyZoneIndexByUZID(targetId)
                    if not na(supplyIdxManual)
                        inspectIndex := supplyIdxManual
                        inspectType := "Supply"
                        foundInPool := "SUPPLY_LIVE"
                        zoneStatus := "LIVE"
                        notFoundReason := "N/A"
                    else
                        foundInPool := "NOT_FOUND"
                        notFoundReason := "not_in_db_or_arrays"
                

        
        zoneInspectorIdx := inspectIndex
        zoneInspectorType := inspectType
        bool isInspectorDemand = inspectType == "Demand"
        
        // Get UZID for display (store for Zone ID row)
        int zoneInspectorUZID = na
        bool inspectorZoneActive = false
        Zone inspectorZone = na

        // If we have a live index, get the Zone from array
        if not na(zoneInspectorIdx) and zoneInspectorType != "None"
            if isInspectorDemand
                if zoneInspectorIdx < array.size(demandZones)
                    inspectorZone := array.get(demandZones, zoneInspectorIdx)
            else
                if zoneInspectorIdx < array.size(supplyZones)
                    inspectorZone := array.get(supplyZones, zoneInspectorIdx)
            
            if not na(inspectorZone)
                zoneInspectorUZID := inspectorZone.id
                inspectorZoneActive := inspectorZone.active
        else if foundInDB and not na(dbEntry)
            // Zone is in DB but not in live arrays - use DB data for display
            zoneInspectorUZID := dbEntry.uzid
            inspectorZoneActive := false  // Not in live arrays = effectively inactive
        
        bool allowInactiveInspector = true

        // Populate inspector fields if zone found in live arrays
        // === CONSOLIDATED: Common fields calculated once, directional logic uses ternary ===
        if not na(inspectorZone) and (inspectorZoneActive or allowInactiveInspector)
            // === COMMON FIELDS (same for demand and supply) ===
            zoneInspectorHigh := inspectorZone.top
            zoneInspectorLow := inspectorZone.bottom
            
            // Zone Size in pips
            if not na(zoneInspectorLow) and not na(zoneInspectorHigh)
                zoneInspectorSizePips := (zoneInspectorHigh - zoneInspectorLow) / pip_size
            
            // Bars Since Creation
            if not na(inspectorZone.createdBarIndex)
                barsSinceCreation := bar_index - inspectorZone.createdBarIndex
            
            // Liquidity Required
            liqRequired := require_liquidity_sweep ? "Yes" : "No"
            
            // Liquidity Analysis (common calculation)
            int oppCntInspector = inspectorZone.liquidityCandleCount
            int minCandles = useOneCandleLiquidity ? 1 : 2
            bool liqExistsBool = oppCntInspector >= minCandles
            
            // Liquidity Analysis string - simplified to Valid/Invalid only
            // Detailed info is shown in the dedicated Liq Low/High/Source/Band rows below
            liqExistsInspector := liqExistsBool ? "✓ Valid" : "✗ Invalid"
            
            // Liquidity Swept & Sweep Bar (Check current bar high/low for real-time feedback)
            float sweepTol = pip_size * 0.5
            bool currentBarIndSweep = isInspectorDemand ? (low <= inspectorZone.liqLowPrice + sweepTol) : (high >= inspectorZone.liqHighPrice - sweepTol)
            bool currentBarTgtSweep = isInspectorDemand ? (high >= inspectorZone.liqHighPrice - sweepTol) : (low <= inspectorZone.liqLowPrice + sweepTol)

            liqSweptInspector := (inspectorZone.liquiditySwept or currentBarIndSweep) ? "Yes" : "No"
            sweepBarIdx := not na(inspectorZone.liquiditySweptBarIndex) ? str.tostring(inspectorZone.liquiditySweptBarIndex) : (currentBarIndSweep ? str.tostring(bar_index) : "N/A")
            
            // Target Swept (Target HIGH for Demand, Target LOW for Supply)
            targetSweptInspector := (inspectorZone.targetSwept or currentBarTgtSweep) ? "Yes" : "No"
            
            // Liquidity Distance from Zone (in pips)
            // For Supply: zoneBottom - liqHighPrice (zone bottom is closest to inducement high below)
            // For Demand: liqLowPrice - zoneTop (zone top is closest to inducement low above)
            float liqDistCalc = na
            if zoneInspectorType == "Demand" and not na(inspectorZone.liqLowPrice) and not na(inspectorZone.top)
                // Demand: liqLowPrice - zoneTop (inducement low is ABOVE zone)
                liqDistCalc := math.abs(inspectorZone.liqLowPrice - inspectorZone.top) / pip_size
            else if zoneInspectorType == "Supply" and not na(inspectorZone.liqHighPrice) and not na(inspectorZone.bottom)
                // Supply: zoneBottom - liqHighPrice (inducement high is BELOW zone)
                liqDistCalc := math.abs(inspectorZone.bottom - inspectorZone.liqHighPrice) / pip_size
            liqDistInspector := not na(liqDistCalc) ? str.tostring(liqDistCalc, "#.#") + " pips" : "N/A"
            // Only mark as exceeding if limit is not 0 (0 = no limit)
            liqDistExceedsMax := liq_entry_max_dist > 0.0 and not na(liqDistCalc) and liqDistCalc > liq_entry_max_dist
            
            // Zone Caused Sweep
            zoneCausedSweepInspector := inspectorZone.causedSweep ? "Yes" : "No"
            
            // Zone Used
            zoneUsedInspector := not na(inspectorZone.lastEntryBar) ? "Yes" : "No"
            
            // Bullish/Bearish Close (same for both)
            bullishBearishClose := close > open ? "Bullish" : "Bearish"
            
            // Not Closed In (same for both)
            notClosedIn := (close < zoneInspectorLow or close > zoneInspectorHigh) ? "Yes" : "No"
            
            // === DIRECTIONAL LOGIC: Wick In Zone (using ternary) ===
            float wickPrice0 = isInspectorDemand ? low : high
            float wickPrice1 = isInspectorDemand ? low[1] : high[1]
            float wickPrice2 = isInspectorDemand ? low[2] : high[2]
            
            bool wick_in_current = wickPrice0 >= zoneInspectorLow and wickPrice0 <= zoneInspectorHigh
            bool wick_in_prev1 = wickPrice1 >= zoneInspectorLow and wickPrice1 <= zoneInspectorHigh
            bool wick_in_prev2 = wickPrice2 >= zoneInspectorLow and wickPrice2 <= zoneInspectorHigh
            wickInZone := (wick_in_current or wick_in_prev1 or wick_in_prev2) ? "Yes" : "No"
            
            // === UNIFIED ENTRY VALIDATION (using if/else for tuple return) ===
            bool entryAllowedInspectorBool = false
            string validationReason = ""
            if isInspectorDemand
                [canEnterDemand, reasonDemand] = isValidDemandEntry(zoneInspectorIdx)
                entryAllowedInspectorBool := canEnterDemand
                validationReason := reasonDemand
            else
                [canEnterSupply, reasonSupply] = isValidSupplyEntry(zoneInspectorIdx)
                entryAllowedInspectorBool := canEnterSupply
                validationReason := reasonSupply
            
            // Handle supply shorts disabled case
            if not isInspectorDemand and not allow_short_trades
                entryAllowedInspector := "Shorts Disabled"
                rejectionReasonInspector := "Shorts disabled"
            else
                entryAllowedInspector := entryAllowedInspectorBool ? "Yes" : "No"
                rejectionReasonInspector := entryAllowedInspectorBool ? "None" : (str.length(validationReason) > 0 ? validationReason : "Unknown")
        else if na(inspectorZone) and foundInDB and not na(dbEntry)
            // Zone is in DB but not in live arrays - use DB data for basic display
            zoneInspectorHigh := dbEntry.top
            zoneInspectorLow := dbEntry.bottom
            
            // Zone Size in pips
            if not na(zoneInspectorLow) and not na(zoneInspectorHigh)
                zoneInspectorSizePips := (zoneInspectorHigh - zoneInspectorLow) / pip_size
            
            // Bars Since Creation
            if not na(dbEntry.createdBar)
                barsSinceCreation := bar_index - dbEntry.createdBar
            
            // Liquidity Required
            liqRequired := require_liquidity_sweep ? "Yes" : "No"
            
            // Liquidity Exists from DB snapshot
            int dbOppCnt = dbEntry.liquidityCandleCount
            int minCandles = useOneCandleLiquidity ? 1 : 2
            bool liqExistsBool = dbOppCnt >= minCandles
            liqExistsInspector := (liqExistsBool ? "Yes" : "No") + " (" + str.tostring(dbOppCnt) + ") [DB]"
            liqCandlesCountInspector := str.tostring(dbOppCnt) + " [DB]"
            
            // Liquidity Swept from DB
            liqSweptInspector := dbEntry.liquiditySwept ? "Yes [DB]" : "No [DB]"
            
            // Caused Sweep from DB
            zoneCausedSweepInspector := dbEntry.causedSweep ? "Yes [DB]" : "No [DB]"
            
            // Entry not allowed for inactive zones
            entryAllowedInspector := "Zone Inactive"
            rejectionReasonInspector := dbEntry.inactiveReason
        
        // Header row (row 0)
        table.cell(zoneInspector, 0, 0, "🟫 ZONE INSPECTOR", text_color = color.white, bgcolor = color.rgb(45, 50, 55), text_size = size.small, text_halign = text.align_left)
        table.cell(zoneInspector, 1, 0, "", bgcolor = color.rgb(45, 50, 55), text_size = size.small)
        
        // Row 1: Zone ID (UZID - permanent unique ID)
        table.cell(zoneInspector, 0, 1, "Zone ID", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        zoneIdStr = not na(zoneInspectorUZID) ? str.tostring(zoneInspectorUZID) : "N/A"
        table.cell(zoneInspector, 1, 1, zoneIdStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 2: Type
        table.cell(zoneInspector, 0, 2, "Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        typeColorInspector = zoneInspectorType == "Demand" ? color.green : (zoneInspectorType == "Supply" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 2, zoneInspectorType, text_color = typeColorInspector, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 3: Range
        table.cell(zoneInspector, 0, 3, "Range", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        rangeStrInspector = (not na(zoneInspectorLow) and not na(zoneInspectorHigh)) ? str.format("{0} → {1}", str.tostring(zoneInspectorLow, format.mintick), str.tostring(zoneInspectorHigh, format.mintick)) : "N/A"
        table.cell(zoneInspector, 1, 3, rangeStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 4: Zone Size
        table.cell(zoneInspector, 0, 4, "Zone Size", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        sizeStrInspector = not na(zoneInspectorSizePips) ? str.tostring(math.round(zoneInspectorSizePips * 10) / 10, "#.#") + " pips" : "N/A"
        table.cell(zoneInspector, 1, 4, sizeStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 5: Bars Since Creation
        table.cell(zoneInspector, 0, 5, "Bars Since", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        barsStrInspector = not na(barsSinceCreation) ? str.tostring(barsSinceCreation) : "N/A"
        table.cell(zoneInspector, 1, 5, barsStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 6: Liquidity Required
        table.cell(zoneInspector, 0, 6, "Liq Required", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        liqReqColor = liqRequired == "Yes" ? color.yellow : (liqRequired == "No" ? color.gray : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 6, liqRequired, text_color = liqReqColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 7: Liquidity Analysis (MERGED: Liq Exists + Liq Candles)
        table.cell(zoneInspector, 0, 7, "Liquidity", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        liqExistsColor = str.contains(liqExistsInspector, "✓") ? color.green : (str.contains(liqExistsInspector, "✗") ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 7, liqExistsInspector, text_color = liqExistsColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 8: Liquidity Swept (was row 9)
        table.cell(zoneInspector, 0, 8, "Liq Swept", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        liqSweptColor = liqSweptInspector == "Yes" ? color.green : (liqSweptInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 8, liqSweptInspector, text_color = liqSweptColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 9: Target Swept (NEW ROW - Target HIGH for Demand, Target LOW for Supply)
        table.cell(zoneInspector, 0, 9, "Target Swept", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        targetSweptColor = targetSweptInspector == "Yes" ? color.green : (targetSweptInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 9, targetSweptInspector, text_color = targetSweptColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 10: Liq Distance (NEW ROW - distance from zone boundary to inducement)
        table.cell(zoneInspector, 0, 10, "Liq Distance", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        liqDistColor = liqDistExceedsMax ? color.red : (liqDistInspector != "N/A" ? color.green : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 10, liqDistInspector, text_color = liqDistColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 11: Sweep Bar Index (was row 10)
        table.cell(zoneInspector, 0, 11, "Sweep Bar", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        table.cell(zoneInspector, 1, 11, sweepBarIdx, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 12: Zone Caused Sweep (was row 11)
        table.cell(zoneInspector, 0, 12, "Zone Caused Sweep", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        zoneCausedSweepColor = zoneCausedSweepInspector == "Yes" ? color.green : (zoneCausedSweepInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 12, zoneCausedSweepInspector, text_color = zoneCausedSweepColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 13: Wick In Zone (was row 12)
        table.cell(zoneInspector, 0, 13, "Wick In Zone", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        wickColor = wickInZone == "Yes" ? color.green : (wickInZone == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 13, wickInZone, text_color = wickColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 14: Not Closed In (was row 13)
        table.cell(zoneInspector, 0, 14, "Not Closed In", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        notClosedColor = notClosedIn == "Yes" ? color.green : (notClosedIn == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 14, notClosedIn, text_color = notClosedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 15: Bullish/Bearish Close (was row 14)
        table.cell(zoneInspector, 0, 15, "Close Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        closeColor = bullishBearishClose == "Bullish" ? color.green : (bullishBearishClose == "Bearish" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 15, bullishBearishClose, text_color = closeColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 16: Zone Used (was row 15)
        table.cell(zoneInspector, 0, 16, "Zone Used", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        usedColor = zoneUsedInspector == "Yes" ? color.red : (zoneUsedInspector == "No" ? color.green : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 16, zoneUsedInspector, text_color = usedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 17: Entry Allowed (was row 16)
        // Override display if entry was triggered this bar (to prevent "False No")
        string displayEntryAllowed = entryAllowedInspector
        color displayEntryColor = entryAllowedInspector == "Yes" ? color.new(color.green, 0) : (entryAllowedInspector == "No" ? color.new(color.red, 0) : color.rgb(200, 200, 200))
        
        if entryTriggeredThisBar and not na(triggeredZoneId) and not na(inspectorZone) and triggeredZoneId == inspectorZone.id
            displayEntryAllowed := "YES (Executed)"
            displayEntryColor := color.new(color.green, 0)
        
        table.cell(zoneInspector, 0, 17, "Entry Allowed", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        table.cell(zoneInspector, 1, 17, displayEntryAllowed, text_color = displayEntryColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // Row 18: Rejection Reason (was row 17)
        table.cell(zoneInspector, 0, 18, "Reason", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        reasonColor = rejectionReasonInspector == "None" ? color.new(color.green, 0) : (rejectionReasonInspector != "N/A" ? color.new(color.orange, 0) : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 18, rejectionReasonInspector, text_color = reasonColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small)
        
        // === DEBUG ROWS: CONDITIONAL on zone NOT found ===
        // Rows 17-19 only shown when zone lookup failed (foundInPool == "NOT_FOUND")
        bool showDebugLookupRows = foundInPool == "NOT_FOUND" or notFoundReason != "N/A"
        
        // Row 19: Score (Strict A+)
        // Row 19: Score (Strict A+)
        int scoreInsp = 0
        string scoreGrade = "N/A"
        color scoreColor = color.gray
        string scoreBreakdown = ""
        
        if not na(inspectorZone)
            // Score removed
            scoreInsp := 0
            scoreGrade := "N/A"
            scoreColor := color.gray
            scoreBreakdown := "Scoring removed"

        table.cell(zoneInspector, 0, 19, "Score", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = size.small)
        table.cell(zoneInspector, 1, 19, str.tostring(scoreInsp) + " (" + scoreGrade + ")", text_color = scoreColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = size.small, tooltip = scoreBreakdown)

        int nextRow = 20
        
        if showDebugLookupRows
            // Row 17: Manual Parsed ID
            table.cell(zoneInspector, 0, nextRow, "Manual Parsed ID", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
            parsedIdColor = manualParsedIdStr != "N/A" ? color.yellow : color.rgb(150, 150, 150)
            table.cell(zoneInspector, 1, nextRow, manualParsedIdStr, text_color = parsedIdColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
            nextRow += 1
            
            // Row 18: Found In
            table.cell(zoneInspector, 0, nextRow, "Found In", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
            foundInColor = foundInPool == "DEMAND_LIVE" ? color.green : (foundInPool == "SUPPLY_LIVE" ? color.red : (foundInPool == "ZONEDB_ONLY" ? color.yellow : color.rgb(150, 150, 150)))
            table.cell(zoneInspector, 1, nextRow, foundInPool, text_color = foundInColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
            nextRow += 1
            
            // Row 19: Reason If Not Found
            table.cell(zoneInspector, 0, nextRow, "Not Found Reason", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
            notFoundColor = notFoundReason == "N/A" or notFoundReason == "empty_input" ? color.rgb(150, 150, 150) : color.orange
            table.cell(zoneInspector, 1, nextRow, notFoundReason, text_color = notFoundColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
            nextRow += 1
        
        // === LIQUIDITY DEBUG ROWS ===
        // Always show both Liq High and Liq Low values directly
        // For Demand: Low=Inducement (closest), High=Target (farthest)
        // For Supply: High=Inducement (closest), Low=Target (farthest)
        
        // Get raw values from zone or DB
        float displayLiqHigh = na
        int displayLiqHighBar = na
        float displayLiqLow = na
        int displayLiqLowBar = na
        string displayLiqSource = "N/A"
        
        if not na(inspectorZone)
            displayLiqHigh := inspectorZone.liqHighPrice
            displayLiqHighBar := inspectorZone.liqHighBar
            displayLiqLow := inspectorZone.liqLowPrice
            displayLiqLowBar := inspectorZone.liqLowBar
            displayLiqSource := na(inspectorZone.liqSource) ? "N/A" : inspectorZone.liqSource
        else if foundInDB and not na(dbEntry)
            displayLiqHigh := dbEntry.liqHighPrice
            displayLiqHighBar := dbEntry.liqHighBar
            displayLiqLow := dbEntry.liqLowPrice
            displayLiqLowBar := dbEntry.liqLowBar
            displayLiqSource := na(dbEntry.liqSource) ? "N/A" : dbEntry.liqSource
        
        // Inducement Row (closest to zone)
        string inducementLabel = isInspectorDemand ? "Inducement (Low)" : "Inducement (High)"
        string inducementStr = "N/A"
        float inducementPrice = isInspectorDemand ? displayLiqLow : displayLiqHigh
        int inducementBar = isInspectorDemand ? displayLiqLowBar : displayLiqHighBar
        if not na(inducementPrice)
            inducementStr := str.tostring(inducementPrice, format.mintick) + " @ " + str.tostring(inducementBar)
        table.cell(zoneInspector, 0, nextRow, inducementLabel, text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        inducementColor = inducementStr != "N/A" ? color.rgb(100, 200, 255) : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, inducementStr, text_color = inducementColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        // Target Row (farthest from zone - must be swept)
        string targetLabel = isInspectorDemand ? "Target (High)" : "Target (Low)"
        string targetStr = "N/A"
        float targetPrice = isInspectorDemand ? displayLiqHigh : displayLiqLow
        int targetBar = isInspectorDemand ? displayLiqHighBar : displayLiqLowBar
        if not na(targetPrice)
            targetStr := str.tostring(targetPrice, format.mintick) + " @ " + str.tostring(targetBar)
        table.cell(zoneInspector, 0, nextRow, targetLabel, text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        targetColor = targetStr != "N/A" ? color.new(color.purple, 0) : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, targetStr, text_color = targetColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        // Liq Swept (simple yes/no)
        string liqSweptStr = "N/A"
        bool liqSwept = false
        if not na(inspectorZone)
            liqSwept := inspectorZone.liquiditySwept
            liqSweptStr := liqSwept ? "YES" : "NO"
        else if foundInDB and not na(dbEntry)
            liqSwept := dbEntry.liquiditySwept
            liqSweptStr := liqSwept ? "YES" : "NO"
        table.cell(zoneInspector, 0, nextRow, "Liq Swept", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        liqSweptColor := liqSweptStr == "YES" ? color.green : (liqSweptStr == "NO" ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, liqSweptStr, text_color = liqSweptColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        // DEBUG: Inducement & Target Bars
        int d_inducementBar = na
        int d_targetBar = na
        if not na(inspectorZone)
            d_inducementBar := inspectorZone.liquidityBarIndex
            d_targetBar := inspectorZone.structureSweepLevelBar
        else if foundInDB and not na(dbEntry)
            d_inducementBar := dbEntry.liquidityBarIndex
            d_targetBar := dbEntry.structureSweepLevelBar
        
        table.cell(zoneInspector, 0, nextRow, "Inducement Bar", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        table.cell(zoneInspector, 1, nextRow, str.tostring(d_inducementBar), text_color = color.white, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        table.cell(zoneInspector, 0, nextRow, "Target Bar", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        table.cell(zoneInspector, 1, nextRow, str.tostring(d_targetBar), text_color = color.white, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1

        bool d_isBefore = not na(d_inducementBar) and not na(d_targetBar) ? d_targetBar < d_inducementBar : false
        table.cell(zoneInspector, 0, nextRow, "Target < Inducement", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        table.cell(zoneInspector, 1, nextRow, d_isBefore ? "YES" : "NO", text_color = d_isBefore ? color.green : color.red, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        // Leg Candles (bearish for demand, bullish for supply)
        int displayLegCount = 0
        if not na(inspectorZone)
            displayLegCount := inspectorZone.legCandleCount
        else if foundInDB and not na(dbEntry)
            displayLegCount := dbEntry.legCandleCount
        string legLabel = isInspectorDemand ? "Bearish" : "Bullish"
        string legCandleStr = na(displayLegCount) or displayLegCount == 0 ? "N/A" : str.tostring(displayLegCount) + " " + legLabel
        table.cell(zoneInspector, 0, nextRow, "Leg Candles", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        legCandleColor = displayLegCount > 3 ? color.green : (displayLegCount > 0 ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, legCandleStr, text_color = legCandleColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        // Primed Status (waiting for next candle entry)
        bool isPrimed = false
        if not na(inspectorZone)
            isPrimed := inspectorZone.primed
        
        table.cell(zoneInspector, 0, nextRow, "Primed", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        string primedStr = isPrimed ? "YES" : "NO"
        color primedColor = isPrimed ? color.green : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, primedStr, text_color = primedColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        // Liq Source (selection method)
        table.cell(zoneInspector, 0, nextRow, "Liq Source", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        liqSourceColor = displayLiqSource == "ABSOLUTE_SCAN" ? color.green : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, displayLiqSource, text_color = liqSourceColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        // Zone Status (LIVE / INACTIVE)
        table.cell(zoneInspector, 0, nextRow, "Zone Status", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        statusColor = zoneStatus == "LIVE" ? color.green : (zoneStatus == "INACTIVE" ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, zoneStatus, text_color = statusColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
        nextRow += 1
        
        // Inactive Reason (if applicable)
        table.cell(zoneInspector, 0, nextRow, "Inactive Reason", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = size.small)
        inactiveColor = zoneInactiveReason != "N/A" ? color.orange : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, zoneInactiveReason, text_color = inactiveColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = size.small)
else
    // Hide/delete Zone Inspector when flag is disabled
    if not na(zoneInspector)
        table.delete(zoneInspector)
        zoneInspector := na

// === POSITION SIZING TABLE (Enhanced with Validation Details) ===
var table posSizeTable = na

// Show position sizing table when debug is enabled (Full level) or when show_pos_sizing_table is enabled
// Only render on confirmed bars for performance optimization
if show_pos_sizing_table and debug_full and isRecentBarForDebug() and barstate.isconfirmed
    if na(posSizeTable)
        posSizeTable := table.new(position.bottom_left, 2, 12, bgcolor = color.new(color.rgb(30, 35, 40), 5), border_width = 1, border_color = color.new(color.white, 70), frame_width = 1, frame_color = color.new(color.white, 70))
    
    if not na(posSizeTable) and barstate.isconfirmed
        // Use last calculated values if available, otherwise show example values
        bool hasLastValues = not na(last_pos_size_entry) and not na(last_pos_size_sl) and last_pos_size_valid
        
        float display_entry = hasLastValues ? last_pos_size_entry : close[1]
        float display_sl = hasLastValues ? last_pos_size_sl : (close[1] - (11.5 * pip_size))
        float display_balance = hasLastValues and not na(last_pos_size_balance) ? last_pos_size_balance : account_size_usd
        float display_risk_pct = hasLastValues and not na(last_pos_size_risk_pct) ? last_pos_size_risk_pct : risk_per_trade_pct
        int display_units = hasLastValues and not na(last_pos_size_units) ? last_pos_size_units : na
        float display_lots = hasLastValues and not na(last_pos_size_lots) ? last_pos_size_lots : na
        float display_sl_pips = hasLastValues and not na(last_pos_size_sl_pips) ? last_pos_size_sl_pips : 11.5
        float display_usdjpy = hasLastValues and not na(last_pos_size_usdjpy_rate) ? last_pos_size_usdjpy_rate : na
        bool display_valid = hasLastValues ? last_pos_size_valid : true
        string display_error = hasLastValues ? last_pos_size_error : ""
        bool display_dry_run = hasLastValues ? last_pos_size_dry_run : false
        
        // Calculate if not using last values
        if not hasLastValues
            float example_qty_units_raw = calc_pos_size_units(display_entry, display_sl, display_balance, display_risk_pct, false)
            display_units := int(math.round(example_qty_units_raw))
            display_lots := display_units / 100000.0
            
            // Get USDJPY rate
            if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                if str.contains(syminfo.ticker, "VANTAGE")
                    display_usdjpy := request.security("VANTAGE:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
                if na(display_usdjpy)
                    display_usdjpy := request.security("USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
                if na(display_usdjpy)
                    display_usdjpy := 150.0  // Fallback
            else if str.contains(syminfo.ticker, "USDJPY")
                display_usdjpy := display_entry
            else
                display_usdjpy := 1.0
        
        // Also fetch USDJPY rate if we have last values but rate is na
        if hasLastValues and na(display_usdjpy) and str.contains(syminfo.ticker, "JPY")
            if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                if str.contains(syminfo.ticker, "VANTAGE")
                    display_usdjpy := request.security("VANTAGE:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
                if na(display_usdjpy)
                    display_usdjpy := request.security("USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
                if na(display_usdjpy)
                    display_usdjpy := 150.0  // Fallback
            else if str.contains(syminfo.ticker, "USDJPY")
                display_usdjpy := display_entry
            else
                display_usdjpy := 1.0
        
        // Format display values
        float risk_usd = display_balance * (display_risk_pct / 100)
        risk_usd_str = "$" + str.tostring(risk_usd, "#.##")
        qty_lots_str = not na(display_lots) ? str.tostring(display_lots, "#.####") + " lots" : "N/A"
        qty_units_str = not na(display_units) ? str.tostring(display_units, "#,###") + " units" : "N/A"
        sl_pips_str = str.tostring(display_sl_pips, "#.##") + " pips"
        rate_str = not na(display_usdjpy) and str.contains(syminfo.ticker, "JPY") ? str.tostring(display_usdjpy, "#.####") : (str.contains(syminfo.ticker, "JPY") ? "Failed" : "N/A")
        valid_str = display_valid ? "✓ Valid" : "✗ Invalid"
        valid_color = display_valid ? color.green : color.red
        error_str = display_error != "" ? display_error : "None"
        dry_run_str = display_dry_run ? "DRY RUN" : "Live"
        min_max_str = not na(display_units) ? str.tostring(min_position_size_units) + " - " + str.tostring(int(max_position_size_lots * 100000)) + " units" : "N/A"
        
        // Header
        headerText = display_dry_run ? "💰 POSITION SIZING (DRY RUN)" : "💰 POSITION SIZING"
        table.cell(posSizeTable, 0, 0, headerText, text_color = color.white, bgcolor = color.rgb(45, 50, 55), text_size = size.small, text_halign = text.align_left)
        table.cell(posSizeTable, 1, 0, "", bgcolor = color.rgb(45, 50, 55))
        
        // Row 1: Validation Status
        table.cell(posSizeTable, 0, 1, "Validation", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 1, valid_str, text_color = valid_color, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 2: Risk Amount
        table.cell(posSizeTable, 0, 2, "Risk Amount", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 2, risk_usd_str, text_color = color.yellow, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 3: Position Size (Lots)
        table.cell(posSizeTable, 0, 3, "Position Size (Lots)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 3, qty_lots_str, text_color = color.green, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 4: Position Size (Units)
        table.cell(posSizeTable, 0, 4, "Position Size (Units)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 4, qty_units_str, text_color = color.green, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 5: Stop Loss (Pips)
        table.cell(posSizeTable, 0, 5, "Stop Loss", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 5, sl_pips_str, text_color = color.red, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 6: Entry Price
        table.cell(posSizeTable, 0, 6, "Entry Price", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 6, str.tostring(display_entry, format.mintick), text_color = color.blue, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 7: Stop Loss Price
        table.cell(posSizeTable, 0, 7, "Stop Loss Price", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 7, str.tostring(display_sl, format.mintick), text_color = color.red, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 8: USDJPY Rate (if applicable)
        if str.contains(syminfo.ticker, "JPY")
            rate_label = "USDJPY Rate"
            rate_color = not na(display_usdjpy) and display_usdjpy > 0 ? color.blue : color.red
            table.cell(posSizeTable, 0, 8, rate_label, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            table.cell(posSizeTable, 1, 8, rate_str, text_color = rate_color, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 9: Min/Max Limits
        table.cell(posSizeTable, 0, 9, "Size Limits", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 9, min_max_str, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 10: Error Message (if any)
        if not display_valid and display_error != ""
            table.cell(posSizeTable, 0, 10, "Error", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            table.cell(posSizeTable, 1, 10, error_str, text_color = color.red, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 11: Mode
        table.cell(posSizeTable, 0, 11, "Mode", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        mode_color = display_dry_run ? color.orange : color.green
        table.cell(posSizeTable, 1, 11, dry_run_str, text_color = mode_color, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

// === PERFORMANCE TABLE ===
performanceTable := draw_performance_table(performanceTable)

// === DEBUG PLOTS: SL/TP Visualization ===
// These lines show the tester's internal exit levels - compare to visual boxes on chart
plot(strategy.position_size != 0 ? trade_tp1_price : na, "Trade TP Level", color = color.new(color.lime, 50), style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? trade_current_sl : na, "Trade SL Level", color = color.new(color.red, 50), style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? trade_entry_price : na, "Trade Entry", color = color.new(color.blue, 50), style = plot.style_linebr, linewidth = 1)

// === PERFORMANCE PROFILING DISPLAY (OPTIMIZATION) ===
if barstate.islast and debug_full
    var table perfTable = table.new(position = position.bottom_right, columns = 2, rows = 3, bgcolor = color.new(color.black, 50), border_width = 1)
    table.cell(perfTable, 0, 0, "DB Lookups", text_color = color.white)
    table.cell(perfTable, 1, 0, str.tostring(array.get(p_db_lookups, 0)), text_color = color.yellow)
    table.cell(perfTable, 0, 1, "Candle Scans", text_color = color.white)
    table.cell(perfTable, 1, 1, str.tostring(array.get(p_candle_scans, 0)), text_color = color.yellow)
