// === DATA STRUCTURES (Moved to Top) ===
type Zone
    int   id
    box   boxId
    float top
    float bottom
    bool  active
    int   createdBarIndex
    bool  isHistorical
    int   startTime
    
    // Liquidity
    float liquidityPrice
    int   liquidityBarIndex
    bool  liquidityValid
    bool  liquiditySwept
    int   liquiditySweptBarIndex
    bool  causedSweep
    int   liquidityCandleCount
    float structureSweepLevel       // The level that must be swept: HIGH for demand, LOW for supply
    int   structureSweepLevelBar    // Bar index where structure level was found
    float liqHighPrice              // For demand: buy-side HIGH above zone; For supply: stored for band
    int   liqHighBar                // Bar index where liqHigh was found
    float liqLowPrice               // For supply: sell-side LOW below zone; For demand: stored for band
    int   liqLowBar                 // Bar index where liqLow was found
    string liqSource                // Selection method: "PIVOT", "FALLBACK_SCAN", "LOW_FIRST_BACKWARD"
    bool  targetSwept               // True when the Target (HIGH for demand, LOW for supply) is swept AFTER inducement
    int   targetSweptBarIndex        // Bar index when target was swept (must be > liquiditySweptBarIndex)
    int   legCandleCount             // Count of directional candles in the leg (bearish for demand, bullish for supply)
    string inactiveReason           // Reason zone was invalidated (e.g., "Inducement swept before target taken")
    
    // Invalidation State
    bool  touchedPreSweep      // True if zone was touched before liquidity sweep
    bool  eligibleEntry        // True if zone is eligible for entry (swept && !touchedPreSweep)
    int   firstTouchBarIndex   // Bar index of first touch

    
    // Trading
    int   lastEntryBar
    bool  mitigated
    int   mitigationTime
    bool  leftZone
    bool  leftWithBearish
    bool  primed           // True when zone is ready for entry on next valid candle
    int   primedBar        // Bar index when zone became primed
    float primedWickLevel  // Deepest wick of the priming candle (for flip SL)
    bool  isAccuracy      // Zone type: true = Accuracy zone, false = Normal zone
    
    // Visuals
    line  connectorLine
    line  targetLine      // For Supply: separate line to Target (Low)
    line  inducementHLine  // Horizontal line at inducement level
    line  targetHLine      // Horizontal line at target level
    label infoLabel
    label idLabel

// === ZONE ARRAYS ===
// === GLOBAL ARRAYS ===
var Zone[] demandZones = array.new<Zone>()
var Zone[] supplyZones = array.new<Zone>()

// === PERSISTENT ZONE REGISTRY (zoneDB) ===
// Stores ALL zones ever created so Zone Inspector can find them even after removal
type ZoneDBEntry
    int   uzid
    string zoneType          // "DEMAND" or "SUPPLY"
    float top
    float bottom
    int   createdBar
    int   lastUpdateBar
    bool  active
    string inactiveReason    // "max_pruned", "removed", "mitigated", "invalidated"
    // Copy of key liquidity fields for inspector display
    float liqLowPrice
    int   liqLowBar
    float liqHighPrice
    int   liqHighBar
    string liqSource
    bool  liquiditySwept
    int   liquidityCandleCount
    bool  causedSweep
    int   legCandleCount             // Count of directional candles in the leg
    int   liquidityBarIndex          // Inducement Bar
    int   structureSweepLevelBar     // Target Bar

var ZoneDBEntry[] zoneDB = array.new<ZoneDBEntry>()
var int DB_MAX_SIZE = 500  // Keep last 500 zones (increased from 200 for inspection)

// === MOVED HELPERS: SESSION & TIMING & SCORING ===

is_in_session() =>
    if not use_time_window
        true
    else
        h = hour(time, time_window_tz)
        h >= start_hour and h < end_hour

// === TIMING FILTER FUNCTIONS (Moved from below) ===
get_time_to_next_30m() =>
    current_minute = minute(time, "Etc/GMT+5")
    minutes_past_30 = current_minute % 30
    30 - minutes_past_30

get_time_to_next_1h() =>
    current_minute = minute(time, "Etc/GMT+5")
    60 - current_minute

get_time_to_next_15m() =>
    current_minute = minute(time, time_window_tz)
    minutes_past_15 = current_minute % 15
    15 - minutes_past_15

is_in_flip_window() =>
    if not enable_flip_entry
        false
    else
        time_to_1h = get_time_to_next_1h()
        // Allow flip entries in the last 5 minutes of the hour (preparing for new 1H candle)
        time_to_1h <= 5

is_blocked_by_timing() =>
    if not enable_timing_filters
        false
    else
        curr_min = minute(time, time_window_tz)
        // ONLY block the candle starting at :55 (the one closing on the hour)
        is_last_5m_of_hour = (curr_min == 55)
        
        // Standard boundaries (15, 30, 45) - keep these only if you want them blocked
        at_boundary = (curr_min % 15) == 0 and curr_min != 0 
        
        if is_in_flip_window() // This refers to minute 0 (the Flip)
            false
        else
            is_last_5m_of_hour or at_boundary

get_next_flip_time_str() =>
    current_hour = hour(time, time_window_tz)
    current_minute = minute(time, time_window_tz)
    int minutes_past_15 = current_minute % 15
    int next_minute = current_minute + (15 - minutes_past_15)
    int next_hour = current_hour
    if next_minute >= 60
        next_minute := next_minute - 60
        next_hour := (current_hour + 1) % 24
    string hour_str = next_hour < 10 ? "0" + str.tostring(next_hour) : str.tostring(next_hour)
    string min_str = next_minute < 10 ? "0" + str.tostring(next_minute) : str.tostring(next_minute)
    hour_str + ":" + min_str

// === STRICT A+ SCORING HELPERS (DELETED) ===




// === GLOBAL TREND & SESSION TRACKERS (Simplified) ===


var float session_high = na
var float session_low = na
bool sess_active = is_in_session()
if sess_active
    bool new_sess = (bar_index == 0) or not sess_active[1]
    if new_sess
        session_high := high
        session_low := low
    else
        session_high := math.max(nz(session_high, high), high)
        session_low := math.min(nz(session_low, low), low)
else
    session_high := na
    session_low := na





// === UTILS ===

get_pip(x) =>
    x / pip_size

// === OPTIMIZED VALUE CACHING ===
// Cache frequently accessed bar values and conditions at the start of each bar to reduce redundant access
var float cached_close = na
var float cached_open = na
var float cached_high = na
var float cached_low = na
var int cached_bar_index = na
var bool cached_is_jpy_pair = false
var bool cached_is_usdjpy = false
var bool cached_is_confirmed = false

if barstate.isconfirmed
    cached_close := close
    cached_open := open
    cached_high := high
    cached_low := low
    cached_bar_index := bar_index
    cached_is_confirmed := true
    // Cache JPY pair checks (computed once per bar)
    cached_is_jpy_pair := str.contains(syminfo.ticker, "JPY")
    cached_is_usdjpy := str.contains(syminfo.ticker, "USDJPY")
else
    cached_is_confirmed := false

// === HELPER: COUNT OPPOSITE CANDLES (MULTI-MODE) ===
// === HELPER: COUNT OPPOSITE CANDLES (MULTI-MODE) ===
countOppositeCandlesInBand(bool isDemand, int fromBar, int toBar, float top, float bottom, int countThreshold = 999) =>
    int oppCount = 0
    
    // Profiling
    if barstate.islast
        int currentScans = array.get(p_candle_scans, 0)
        array.set(p_candle_scans, 0, currentScans + 1)

    if na(fromBar) or na(toBar) or na(top) or na(bottom) or fromBar > toBar
        oppCount
    else
        // Pre-compute Asset Specifics
        bool isGold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
        float overlapTolerance = isGold ? pip_size * 0.5 : syminfo.mintick / 2.0
        
        // Scan Limit: clamp to current bar_index and max 300 bars back (Safety)
        int safeLimit = math.min(toBar, bar_index)
        int scanEndBar = math.min(safeLimit, fromBar + 300)

        // Scan from fromBar to scanEndBar (inclusive)
        if scanEndBar >= fromBar
            for scanOff = 0 to (scanEndBar - fromBar)
                // Early Exit
                if oppCount >= countThreshold
                    break
                    
                scanBar = fromBar + scanOff
                if scanBar > bar_index
                    break

                // Calculate offset from current bar
                barOffset = bar_index - scanBar
                if barOffset < 0
                    continue

                // Check if candle overlaps with liquidity band
                float c_high_band = high[barOffset]
                float c_low_band  = low[barOffset]
                bool overlapsBand = c_high_band >= (bottom - overlapTolerance) and c_low_band <= (top + overlapTolerance)

                // --- MODE-BASED STRUCTURE DETECTION ---
                bool isStructure = false

                float c_open  = open[barOffset]
                float c_close = close[barOffset]
                float c_high  = high[barOffset]
                float c_low   = low[barOffset]
                float body_size = math.abs(c_close - c_open)
                float total_range = c_high - c_low

                if total_range > syminfo.mintick
                    bool isRed   = c_close < c_open
                    bool isGreen = c_close > c_open

                    // 1. RELAXED (Wicks & Dojis count)
                    if structure_mode_int == MODE_RELAXED
                        bool isDoji = body_size <= (total_range * 0.05)
                        if isDemand
                            float upper_wick = c_high - math.max(c_open, c_close)
                            // XAUUSD FIX: Lower wick threshold from 50% to 30% to catch more bearish structure
                            // Gold's high volatility means even 30% wicks are significant rejection
                            bool meaningfulUpperWick = total_range > 0 ? (upper_wick / total_range) >= 0.30 : false
                            isStructure := isRed or isDoji or meaningfulUpperWick
                        else
                            float lower_wick = math.min(c_open, c_close) - c_low
                            // XAUUSD FIX: Lower wick threshold for supply zones too
                            bool meaningfulLowerWick = total_range > 0 ? (lower_wick / total_range) >= 0.30 : false
                            isStructure := isGreen or isDoji or meaningfulLowerWick

                    // 2. STANDARD (Solid Bodies only)
                    else if structure_mode_int == MODE_STANDARD
                        // Must have some body (>10% range) and be opposite color
                        // Wicks do NOT count here
                        if isDemand
                            isStructure := isRed and (body_size > total_range * 0.10)
                        else
                            isStructure := isGreen and (body_size > total_range * 0.10)

                    // 3. STRICT (Strong Moves only)
                    else 
                        // Must be opposite color and significant body (>30% range)
                        if isDemand
                            isStructure := isRed and (body_size > total_range * 0.30)
                        else
                            isStructure := isGreen and (body_size > total_range * 0.30)

                // Require MEANINGFUL overlap with liquidity band, not just edge touches
                float overlapTop    = math.min(c_high_band, top)
                float overlapBottom = math.max(c_low_band, bottom)
                float overlapRange  = math.max(0.0, overlapTop - overlapBottom)
                // RELAXED: Any overlap with the band counts (no minimum percentage required)
                // This ensures all candles that touch the liquidity band are counted, regardless of candle size
                bool overlapsMeaningfully = overlapsBand and overlapRange > 0

                if overlapsMeaningfully and isStructure
                    // Count only; noisy per-candle debug labels removed to avoid chart spam
                    oppCount += 1
        oppCount

is_strong_body(idx) =>
    body        = math.abs(close[idx] - open[idx])
    total_range = high[idx] - low[idx]
    perc        = total_range > 0 ? body / total_range * 100 : 0
    perc >= min_body_perc

// =============================
// 🔥 UNIVERSAL POSITION SIZE ENGINE (LONG + SHORT)
// =============================
// =============================
// POSITION SIZE CALCULATOR (Myfxbook Formula)
// =============================
// Formula: Position Size (lots) = (Account Size × Risk %) / (Stop Loss in pips × Pip Value)
// Where Pip Value = (Pip Size / Exchange Rate) × Lot Size
// 
// For JPY pairs: Pip Value = (0.01 / USDJPY_rate) × 100,000
// For non-JPY pairs: Pip Value = 0.0001 × 100,000 = $10 per pip per lot
//
// @param entry: Entry price
// @param stop: Stop loss price
// @param balance: Account balance in USD
// @param risk_pct: Risk percentage per trade (e.g., 0.5 for 0.5%)
// @returns: Position size in lots
calc_pos_size(entry, stop, balance, risk_pct) =>
    // Step 1: Calculate risk amount in USD
    risk_usd = balance * (risk_pct / 100)
    
    // Step 2: Determine pip size based on pair type
    pip_sz = pip_size  // Use the auto-detected or manual pip size
    
    // Step 3: Calculate pip distance (absolute value)
    pip_distance = math.abs(stop - entry)
    sl_pips = pip_distance / pip_sz
    sl_pips := math.max(sl_pips, 0.1)  // Minimum 0.1 pips
    
    // Step 4: Standard lot size for forex (100,000 units)
    lot_size = 100000.0
    
    // Step 5: Calculate pip value per lot in USD
    // TradingView formula for pip value:
    // For XXX/USD pairs: pip_value = pip_size * lot_size = $10 per pip per lot
    // For XXX/YYY pairs: pip_value = (pip_size * lot_size) / quote_currency_rate
    float pip_value_per_lot = na
    
    if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
        // For JPY cross pairs (GBPJPY, EURJPY, etc.)
        float usdjpy_rate = na
        if str.contains(syminfo.ticker, "VANTAGE")
            usdjpy_rate := request.security("VANTAGE:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
        if na(usdjpy_rate)
            usdjpy_rate := request.security("USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
        if na(usdjpy_rate)
            usdjpy_rate := 150.0  // Fallback
            pip_value_per_lot := (pip_sz * lot_size) / usdjpy_rate
    else if str.contains(syminfo.ticker, "USDJPY")
        pip_value_per_lot := (pip_sz * lot_size) / entry
    else if str.contains(syminfo.ticker, "USD")
        // Pairs ending in USD (EURUSD, GBPUSD, etc.) - pip value is $10 per lot
        pip_value_per_lot := pip_sz * lot_size
    else
        // Cross pairs not ending in USD (GBPCAD, EURGBP, etc.)
        // Need to convert quote currency to USD
        // For GBPCAD: pip_value = (0.0001 * 100000) / USDCAD rate
        // Approximate: use entry price as a proxy (works for most pairs)
        pip_value_per_lot := (pip_sz * lot_size) / entry
    
    // Step 6: Ensure pip_value_per_lot is valid
    if na(pip_value_per_lot) or pip_value_per_lot <= 0
        pip_value_per_lot := pip_sz * lot_size
    
    // Step 7: Calculate position size in lots
    // Formula: Position Size (lots) = Risk USD / (SL pips × Pip Value per lot)
    qty_lots = risk_usd / (sl_pips * pip_value_per_lot)
    
    // Step 8: Validate and round
    if na(qty_lots) or qty_lots <= 0
        qty_lots := 0.001
    else
        qty_lots := math.max(qty_lots, 0.001)
    
    qty_lots := math.round(qty_lots * 1000) / 1000
    
    if na(qty_lots) or qty_lots <= 0
        qty_lots := 0.001
    
    qty_lots

// =============================
// CALCULATE POSITION SIZE IN UNITS (TradingView-compatible)
// =============================
// This function calculates position size in UNITS
// For USD Quote pairs (XAUUSD, EURUSD): 1 unit moving $1 = $1 P/L, so units = risk / price_distance
// For JPY pairs: Need to convert using USDJPY rate
// For USD Base pairs (USDCAD): Use pip-based calculation
// @param entry: Entry price
// @param stop: Stop loss price
// @param balance: Account balance in USD
// @param risk_pct: Risk percentage per trade
// @param is_short: true for short, false for long
// @returns: Position size in UNITS (not lots)
calc_pos_size_units(entry, stop, balance, risk_pct, is_short) =>
    // Step 1: Calculate risk amount in USD
    float risk_usd = balance * (risk_pct / 100)
    
    // Step 2: Calculate price distance (absolute)
    float price_distance = math.abs(entry - stop)
    
    // CRITICAL SAFETY CLAMP: Enforce minimum 2 pip distance to prevent massive position sizes
    // Without this, a 0.1 pip SL would cause position_units = 50 / 0.01 = 5000 units (on Forex)
    // or on Gold: position_units = 50 / 0.10 = 500 oz = 5 lots (way too big for tight SL)
    float min_distance = 2.0 * pip_size  // Minimum 2 pips
    float effective_distance = math.max(price_distance, min_distance)
    
    // Validate distance is positive
    if effective_distance <= 0
        0.0
    else
        float position_units = na
        ticker = syminfo.ticker
        
        // Detect symbol type
        bool is_gold = str.contains(ticker, "XAU") or str.contains(ticker, "GOLD")
        bool is_silver = str.contains(ticker, "XAG") or str.contains(ticker, "SILVER")
        bool is_crypto = str.contains(ticker, "BTC") or str.contains(ticker, "ETH")
        bool is_jpy_pair = str.contains(ticker, "JPY")
        bool is_usd_base = str.startswith(ticker, "USD") and not str.endswith(ticker, "USD")
        // USD Quote pairs: Contains USD but doesn't start with USD (like EURUSD, GBPUSD)
        // Also includes Gold/Silver/Crypto which are quoted in USD
        bool is_usd_quote = (str.contains(ticker, "USD") and not is_usd_base) or is_gold or is_silver or is_crypto
        
        // Case 1: USD Quote pairs (XAUUSD, EURUSD, GBPUSD, AUDUSD, BTCUSD, etc.)
        // For these pairs: 1 unit moving $1 = $1 profit/loss
        // Formula: units = risk_usd / effective_distance
        // Example XAUUSD: $50 risk / $4.56 distance = 10.96 ≈ 11 units
        if is_usd_quote and not is_jpy_pair
            position_units := risk_usd / effective_distance
        
        // Case 2: JPY pairs (USDJPY, GBPJPY, EURJPY)
        // Need to convert using USDJPY rate
        else if is_jpy_pair
            float usdjpy_rate = na
            if str.contains(ticker, "VANTAGE")
                usdjpy_rate := request.security("VANTAGE:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
            if na(usdjpy_rate)
                usdjpy_rate := request.security("USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
            if na(usdjpy_rate)
                usdjpy_rate := 150.0  // Fallback
            
            // For JPY pairs: (risk_usd * usdjpy_rate) / effective_distance
            position_units := (risk_usd * usdjpy_rate) / effective_distance
        
        // Case 3: USD Base pairs (USDCAD, USDCHF) or other cross pairs
        // For these, we need to convert quote currency to USD
        // Approximate using entry price
        else
            position_units := risk_usd / effective_distance
        
        // Round to whole units
        position_units := math.round(position_units)
        
        // Validate - minimum 1 unit
        if na(position_units) or position_units <= 0
            position_units := 1.0
        
        position_units

// =============================
// TRADE EXECUTION VALIDATION
// =============================
// Validates all parameters before executing a trade to ensure it will execute correctly
// @param entry_price: Entry price
// @param stop_loss_price: Stop loss price  
// @param take_profit_price: Take profit price (can be na)
// @param qty_lots: Position size in lots
// @param contract_size: Contract size (100,000 for forex)
// @param is_long: true for long trades, false for short trades
// @returns: [is_valid, qty_units, error_message]
validate_trade_execution(entry_price, stop_loss_price, qty_lots, contract_size) =>
    bool is_valid = true
    int qty_units = na
    string error_msg = ""
    
    // Validate entry price
    if na(entry_price) or entry_price <= 0
        is_valid := false
        error_msg := "Invalid entry price"
    
    // Validate stop loss price
    if na(stop_loss_price) or stop_loss_price <= 0
        is_valid := false
        error_msg := "Invalid stop loss price"
    
    // For long trades: SL must be strictly below entry
    if is_valid and stop_loss_price >= entry_price
        is_valid := false
        error_msg := "SL must be below entry for longs"
    
    // Validate qty_lots
    if na(qty_lots) or qty_lots <= 0
        is_valid := false
        error_msg := "Invalid position size (lots)"
    
    // Calculate contract units - MUST be positive integer for TradingView
    if is_valid
        float raw_units = qty_lots * contract_size
        raw_units := math.round(raw_units)
        raw_units := math.max(raw_units, 1.0)  // Minimum 1 unit
        
        // Convert to integer explicitly
        qty_units := int(raw_units)
        
        // Final validation of contract units - must be positive integer
        if na(qty_units) or qty_units <= 0
            is_valid := false
            error_msg := "Invalid contract units"
    
    [is_valid, qty_units, error_msg]

// =============================
// FETCH USDJPY RATE WITH ERROR HANDLING
// =============================
// Fetches USDJPY rate for JPY pairs, returns [rate, success, error_message]
// @returns: [usdjpy_rate, is_success, error_message]
fetch_usdjpy_rate() =>
    float rate = na
    bool success = false
    string error_msg = ""
    
    if str.contains(syminfo.ticker, "JPY")
        // Performance optimization: only fetch USDJPY rate when no trade is open
        if strategy.position_size == 0
            // Try multiple sources for USDJPY rate
            if str.contains(syminfo.ticker, "VANTAGE")
                rate := request.security("VANTAGE:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
            if na(rate)
                rate := request.security("USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
            if na(rate)
                rate := request.security("FX_IDC:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
            if na(rate)
                rate := request.security("OANDA:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
        
        // ALWAYS use fallback if all requests fail - never skip trades due to rate fetch
        if na(rate) or rate <= 0
            rate := 150.0  // Approximate USDJPY rate as fallback
            success := true  // Still mark as success so trades are NOT skipped
            error_msg := "Using fallback rate 150.0"
        else
            success := true
    else
        // Not a JPY pair, rate not needed
        success := true
        rate := 1.0
    
    [rate, success, error_msg]

// =============================
// ENHANCED POSITION SIZING VALIDATION
// =============================
// Comprehensive validation of position size with min/max checks and USDJPY validation
// @param entry_price: Entry price
// @param stop_loss_price: Stop loss price
// @param balance: Account balance in USD
// @param risk_pct: Risk percentage per trade
// @param is_short: true for short trades, false for long trades
// @returns: [is_valid, qty_units, qty_lots, error_message, validation_details, sl_fixed]
validate_position_size(entry_price, stop_loss_price, balance, risk_pct, is_short) =>
    bool is_valid = true
    int qty_units = na
    float qty_lots = na
    string error_msg = ""
    string validation_details = ""
    float sl_fixed = stop_loss_price  // Local copy - function arguments are immutable in Pine Script
    
    // Step 1: Validate entry price
    if na(entry_price) or entry_price <= 0
        is_valid := false
        error_msg := "Invalid entry price"
        validation_details := "Entry price: " + (na(entry_price) ? "NA" : str.tostring(entry_price))
    
    // Step 2: Validate stop loss price
    if is_valid and (na(sl_fixed) or sl_fixed <= 0)
        is_valid := false
        error_msg := "Invalid stop loss price"
        validation_details := "Stop loss: " + (na(sl_fixed) ? "NA" : str.tostring(sl_fixed))
    
    // Step 3: Validate and AUTO-CORRECT price relationship (defensive layer)
    // Instead of rejecting, we auto-fix SL to ensure minimum gap
    // Minimum 2.0 pips gap to prevent "zero profit" trades in the strategy tester
    float minGap = math.max(syminfo.mintick * 2, pip_size * 2.0)  // At least 2 pips
    
    if is_valid
        if is_short
            // For shorts: SL must be ABOVE entry
            if sl_fixed <= entry_price + minGap
                sl_fixed := entry_price + minGap  // Auto-correct
        else
            // For longs: SL must be BELOW entry
            if sl_fixed >= entry_price - minGap
                sl_fixed := entry_price - minGap  // Auto-correct
    
    // Step 4: Validate USDJPY rate for JPY pairs
    if is_valid and str.contains(syminfo.ticker, "JPY")
        [val_usdjpy_rate_result, val_usdjpy_success_result, val_usdjpy_error_result] = fetch_usdjpy_rate()
        if not val_usdjpy_success_result
            is_valid := false
            error_msg := val_usdjpy_error_result
            validation_details := "USDJPY rate unavailable for JPY pairs"
    
    // Step 5: Calculate position size
    float qty_units_raw = na
    if is_valid
        qty_units_raw := calc_pos_size_units(entry_price, sl_fixed, balance, risk_pct, is_short)
        
        if na(qty_units_raw) or qty_units_raw <= 0
            is_valid := false
            error_msg := "Position size calculation failed"
            validation_details := "Calculated units: " + (na(qty_units_raw) ? "NA" : str.tostring(qty_units_raw))
        
        // Convert to integer
        if is_valid
            qty_units := int(math.round(qty_units_raw))
            
            // Determine contract size for units-to-lots conversion
            // Gold: 100 oz/lot, Silver: 5000 oz/lot, Crypto: 1 unit/lot, Forex: 100,000 units/lot
            float contract_size = 100000.0
            int effective_min_units = min_position_size_units
            
            if str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
                contract_size := 100.0
                effective_min_units := 1  // Gold: minimum 1 oz (0.01 lots)
            else if str.contains(syminfo.ticker, "XAG") or str.contains(syminfo.ticker, "SILVER")
                contract_size := 5000.0
                effective_min_units := 1  // Silver: minimum 1 oz
            else if str.contains(syminfo.ticker, "BTC") or str.contains(syminfo.ticker, "ETH")
                contract_size := 1.0
                effective_min_units := 1  // Crypto: minimum 1 unit
            
            qty_lots := qty_units / contract_size
            
            // Step 6: Minimum position size check (using asset-appropriate minimum)
            if qty_units < effective_min_units
                is_valid := false
                error_msg := "Position size below minimum"
                validation_details := "Units: " + str.tostring(qty_units) + " (min: " + str.tostring(effective_min_units) + ")"
            
            // Step 7: Maximum position size check
            if is_valid and qty_lots > max_position_size_lots
                is_valid := false
                error_msg := "Position size exceeds maximum"
                validation_details := "Lots: " + str.tostring(qty_lots, "#.####") + " (max: " + str.tostring(max_position_size_lots) + ")"
            
            // Step 8: Final validation - ensure qty_units is positive and not na
            if is_valid and (na(qty_units) or qty_units <= 0)
                is_valid := false
                error_msg := "Invalid quantity units"
                validation_details := "Final units: " + (na(qty_units) ? "NA" : str.tostring(qty_units))
    
    [is_valid, qty_units, qty_lots, error_msg, validation_details, sl_fixed]

// Helper: Check if bar index is already used as zone base
is_base_bar_used(barIdx, baseArray) =>
    if array.size(baseArray) == 0
        false
    else
        found = false
        for j = 0 to array.size(baseArray) - 1
            if array.get(baseArray, j) == barIdx
                found := true
                break
        found

// === ZONE DETECTION TRACKING ===
var array<int> used_demand_base_times = array.new_int()
var array<int> used_supply_base_times = array.new_int()
var bool initial_scan_done = false

// === FRACTALS LOGIC ===
// NOTE: These helpers are written so that ta.highest/ta.lowest are *always* called
// on every bar, which removes "should be called on each calculation" warnings
// without changing the logical conditions.
f_isFractalHigh(_n) =>
    float hh = ta.highest(high, _n * 2 + 1)
    bool enoughBars = _n >= 1 and bar_index >= _n + 1
    bool cond = high[_n] == hh and high[_n] > high[_n + 1] and high[_n] > high[_n - 1]
    enoughBars and cond

f_isFractalLow(_n) =>
    float ll = ta.lowest(low, _n * 2 + 1)
    bool enoughBars = _n >= 1 and bar_index >= _n + 1
    bool cond = low[_n] == ll and low[_n] < low[_n + 1] and low[_n] < low[_n - 1]
    enoughBars and cond

bool isFractalHigh_result = f_isFractalHigh(fractalsPeriod)
bool isFractalLow_result  = f_isFractalLow(fractalsPeriod)

fractalBarIdx  = bar_index - fractalsPeriod
isZoneBaseBar  = (isFractalHigh_result or isFractalLow_result) ? 
                 (is_base_bar_used(fractalBarIdx, used_demand_base_times) or 
                  is_base_bar_used(fractalBarIdx, used_supply_base_times)) : false

fractalHigh = (not isZoneBaseBar and isFractalHigh_result) ? high[fractalsPeriod] : na
fractalLow  = (not isZoneBaseBar and isFractalLow_result) ? low[fractalsPeriod] : na

plotshape(not na(fractalHigh), style = shape.triangleup,   location = location.abovebar, color = color.green, size = size.small, offset = -fractalsPeriod)
plotshape(not na(fractalLow),  style = shape.triangledown, location = location.belowbar, color = color.red,   size = size.small, offset = -fractalsPeriod)

// === PIVOT-BASED LIQUIDITY (SIMPLE 3-CANDLE LIKE MAKUCHAKU) ===
var array<float> liqPvtHighPrices = array.new_float()
var array<int>   liqPvtHighBars   = array.new_int()
var array<float> liqPvtLowPrices  = array.new_float()
var array<int>   liqPvtLowBars    = array.new_int()

// Simple 3-candle pivot detection (like "Liquidity by makuchaku")
// A pivot low forms when: low[2] > low[1] and low[1] < low[0]
// A pivot high forms when: high[2] < high[1] and high[1] > high[0]
bool isPvtLow  = low[2] > low[1] and low[1] < low[0]
bool isPvtHigh = high[2] < high[1] and high[1] > high[0]

if isPvtLow
    // Pivot is at bar_index - 1 (the middle candle)
    array.push(liqPvtLowPrices, low[1])
    array.push(liqPvtLowBars, bar_index - 1)

if isPvtHigh
    // Pivot is at bar_index - 1 (the middle candle)
    array.push(liqPvtHighPrices, high[1])
    array.push(liqPvtHighBars, bar_index - 1)

// Trim to at most pvtMax recent liquidity levels
while array.size(liqPvtHighPrices) > pvtMax
    array.shift(liqPvtHighPrices)
    array.shift(liqPvtHighBars)
while array.size(liqPvtLowPrices) > pvtMax
    array.shift(liqPvtLowPrices)
    array.shift(liqPvtLowBars)



// Find zone in DB by UZID
// Find zone in DB by UZID
db_findIndexByUZID(int targetUZID) =>
    // Profiling
    if barstate.islast
        int currentLookups = array.get(p_db_lookups, 0)
        array.set(p_db_lookups, 0, currentLookups + 1)
        
    // Fast Path: Map Lookup
    int idx = map.get(zoneIndexMap, targetUZID)
    
    // Fallback: Linear Scan (should rarely happen if map is maintained)
    if na(idx)
        if array.size(zoneDB) > 0
            for i = 0 to array.size(zoneDB) - 1
                ZoneDBEntry entry = array.get(zoneDB, i)
                if entry.uzid == targetUZID
                    idx := i
                    // Self-heal map
                    map.put(zoneIndexMap, targetUZID, idx)
                    break
    idx

// Upsert zone into DB (add new or update existing)
db_upsertZone(Zone z, string zoneType) =>
    int idx = db_findIndexByUZID(z.id)
    if na(idx)
        // Create new entry
        ZoneDBEntry entry = ZoneDBEntry.new(
             uzid = z.id,
             zoneType = zoneType,
             top = z.top,
             bottom = z.bottom,
             createdBar = z.createdBarIndex,
             lastUpdateBar = bar_index,
             active = true,
             inactiveReason = "",
             liqLowPrice = z.liqLowPrice,
             liqLowBar = z.liqLowBar,
             liqHighPrice = z.liqHighPrice,
             liqHighBar = z.liqHighBar,
             liqSource = z.liqSource,
             liquiditySwept = z.liquiditySwept,
             liquidityCandleCount = z.liquidityCandleCount,
             causedSweep = z.causedSweep,
             legCandleCount = z.legCandleCount,
             liquidityBarIndex = z.liquidityBarIndex,
             structureSweepLevelBar = z.structureSweepLevelBar)
        array.push(zoneDB, entry)
        // Update Map for new entry
        map.put(zoneIndexMap, z.id, array.size(zoneDB) - 1)
        
        // Trim if too large (remove oldest)
        while array.size(zoneDB) > DB_MAX_SIZE
            // Map Rebuild Trigger: Shifting changes all indices
            array.shift(zoneDB)
            map.clear(zoneIndexMap)
            if array.size(zoneDB) > 0
                for i = 0 to array.size(zoneDB) - 1
                    ZoneDBEntry e = array.get(zoneDB, i)
                    map.put(zoneIndexMap, e.uzid, i)
    else
        // Update existing entry
        ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.top := z.top
        entry.bottom := z.bottom
        entry.lastUpdateBar := bar_index
        entry.active := true
        entry.inactiveReason := ""
        entry.liqLowPrice := z.liqLowPrice
        entry.liqLowBar := z.liqLowBar
        entry.liqHighPrice := z.liqHighPrice
        entry.liqHighBar := z.liqHighBar
        entry.liqSource := z.liqSource
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
        entry.legCandleCount := z.legCandleCount
        entry.liquidityBarIndex := z.liquidityBarIndex
        entry.structureSweepLevelBar := z.structureSweepLevelBar
    true  // Consistent return type

// Mark zone as inactive in DB with reason
db_markInactive(int targetUZID, string reason) =>
    int idx = db_findIndexByUZID(targetUZID)
    if not na(idx)
        ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.active := false
        entry.inactiveReason := reason
        entry.lastUpdateBar := bar_index
    true  // Consistent return type

// Update zone in DB with latest liquidity data (called during zone updates)
db_updateZoneLiquidity(Zone z) =>
    int idx = db_findIndexByUZID(z.id)
    if not na(idx)
        ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.lastUpdateBar := bar_index
        entry.liqLowPrice := z.liqLowPrice
        entry.liqLowBar := z.liqLowBar
        entry.liqHighPrice := z.liqHighPrice
        entry.liqHighBar := z.liqHighBar
        entry.liqSource := z.liqSource
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
        entry.liquidityBarIndex := z.liquidityBarIndex
        entry.structureSweepLevelBar := z.structureSweepLevelBar
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
    true  // Consistent return type

// === UZID COUNTERS (Guaranteed Unique IDs) ===
var int demand_zone_counter = 0  // Persistent counter that increments with each demand zone creation
var int supply_zone_counter = 0  // Persistent counter that increments with each supply zone creation

// === CONSECUTIVE OPPOSITE CANDLE COUNTER ===
// Counts consecutive opposite-direction candles starting from the bar AFTER liqBar (forward in time)
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// Returns count (0 if liqBar is na or no opposite candles found)
// === CONSECUTIVE OPPOSITE CANDLE COUNTER ===
// Counts consecutive opposite-direction candles starting from the bar AFTER liqBar (forward in time)
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// Returns count (0 if liqBar is na or no opposite candles found)
// Helper: Get highest High between two absolute bar indices
getMaxHighBetween(int startBarAbs, int endBarAbs) =>
    float maxH = -1.0e10
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        // Loop safely
        for i = offStart to offEnd
            if high[i] > maxH
                maxH := high[i]
    maxH

// Helper: Get lowest Low between two absolute bar indices
getMinLowBetween(int startBarAbs, int endBarAbs) =>
    float minL = 1.0e10
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        // Loop safely
        for i = offStart to offEnd
            if low[i] < minL
                minL := low[i]
    minL

// Counts opposite candles INSIDE the liquidity range
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// NOTE: rangeLow and rangeHigh parameters are kept for API compatibility but NOT used
// We count ALL opposite candles between the bars, since the liquidity leg concept
// refers to the candles forming the movement, not just candles in a price band
countOppCandlesInLiquidityRange(int startBarAbs, int endBarAbs, bool isDemand, float rangeLow, float rangeHigh) =>
    int count = 0
    // Guards: endBarAbs should be >= startBarAbs (end is same or later in time)
    // CRITICAL: Also guard against bar indices greater than current bar_index (causes negative offsets)
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs and startBarAbs <= bar_index and endBarAbs <= bar_index
        int offStart = bar_index - endBarAbs      // Offset for the end bar (newer, lower offset)
        int offEnd   = bar_index - startBarAbs    // Offset for the start bar (older, higher offset)
        
        // Additional safety: ensure offsets are non-negative
        if offStart >= 0 and offEnd >= 0
            // Cap loop to avoid performance issues
            int max_steps = 200
            int steps = 0
            
            // Iterate from start bar to end bar (older to newer)
            // Higher offset = older bar, lower offset = newer bar
            // We iterate from offEnd (older) down to offStart (newer)
            for i = offEnd to offStart
                if steps > max_steps
                    break
                steps += 1
                
                // Check opposite color
                bool isOpp = isDemand ? (close[i] < open[i]) : (close[i] > open[i])
                
                // Count ALL opposite candles between the bars (no price range filter)
                // The liquidity leg includes all candles forming the movement
                if isOpp
                    count += 1
    count

countConsecutiveOppCandles(int liqBar, bool isDemand) =>
    int count = 0
    if na(liqBar) or liqBar > bar_index
        0  // Return 0 for invalid liqBar or future bar
    else
        int offset = bar_index - liqBar
        if offset >= 1  // Need at least 1 bar after liqBar
            // Start from the bar AFTER liqBar and walk toward current bar
            // Count ALL matching opposite candles (no break on mismatch)
            for i = 1 to liq_candle_count_max
                int idx = offset - i  // Bar index offset from current bar
                if idx < 0  // Reached current bar
                    break
                // Use WICKS (high/low) for range check, not body
                bool isOppCandle = isDemand ? (close[idx] < open[idx]) : (close[idx] > open[idx])
                if isOppCandle
                    count += 1
                // NO BREAK - count all matching candles in the range
        count  // Return actual count (can be 0)

// === LOCAL LIQUIDITY SCAN HELPERS ===
// Fallback scan to find nearest-by-price liquidity within constraints when no pivots are found

// Find closest-by-price LOW within distance
// Returns [price, bar_index] tuple (or [na, na] if none found)
// isInducement: true = look for Low >= zoneTop (Demand Inducement), false = look for Low <= zoneBottom (Standard)
findLocalDemandLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0
    
    // Scan history
    for off = 0 to lookback
        float candidate = low[off]
        // Check side tolerance
        bool isSideValid = isInducement ? (candidate >= refPrice - sideTol) : (candidate <= refPrice + sideTol)
        
        if isSideValid
            float dist = math.abs(candidate - refPrice)
            // Check max distance
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

// Find closest-by-price HIGH within distance
// Returns [price, bar_index] tuple (or [na, na] if none found)
// isInducement: true = look for High <= zoneBottom (Supply Inducement), false = look for High >= zoneTop (Standard)
findLocalSupplyLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0
    
    // Scan history
    for off = 0 to lookback
        float candidate = high[off]
        // Check side tolerance
        bool isSideValid = isInducement ? (candidate <= refPrice + sideTol) : (candidate >= refPrice - sideTol)
        
        if isSideValid
            float dist = math.abs(candidate - refPrice)
            // Check max distance
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

// =============================
// MODULAR LIQUIDITY SCAN FUNCTIONS
// =============================
// These functions encapsulate the liquidity scanning logic to reduce main body size
// and implement chronological search: Inducement first, then Target BEFORE it

// Demand Liquidity: Find Deepest Inducement LOW first, then Highest HIGH before it (Target)
// Modifies zone fields directly via array reference
f_scan_demand_liquidity(int zoneArrayIndex) =>
    Zone z = array.get(demandZones, zoneArrayIndex)
    
    // Skip if zone not eligible
    if na(z.createdBarIndex) or bar_index <= z.createdBarIndex or z.isHistorical
        true  // Return dummy value for Pine Script function requirement
    else
        float maxDistPrice = liq_max_distance_pips * pip_size
        float minDistPrice = 2.0 * pip_size  // Minimum 2 pips from zone
        
        // === STEP A: Find ABSOLUTE LOWEST Inducement LOW ===
        // Scan forward from zone creation to current bar
        float inducementLowPrice = 1.0e10
        int inducementBar = na
        
        int windowStart = z.createdBarIndex + 1
        int windowEnd = bar_index - 1
        
        if windowEnd >= windowStart
            for scanBar = windowStart to windowEnd
                int off = bar_index - scanBar
                if off >= 0 and off <= bar_index
                    float candleLow = low[off]
                    
                    // Must be ABOVE zone top (liquidity sits above demand zone)
                    if candleLow <= z.top
                        continue
                    
                    // Distance checks
                    float distFromZone = candleLow - z.top
                    if maxDistPrice > 0 and distFromZone > maxDistPrice
                        continue
                    if distFromZone < minDistPrice
                        continue
                    
                    // Track ABSOLUTE LOWEST (no pivot requirement)
                    if candleLow < inducementLowPrice
                        inducementLowPrice := candleLow
                        inducementBar := scanBar
        
        // === STEP B: Found Inducement - Now scan BACKWARD from inducement to zone creation ===
        if inducementLowPrice < 1.0e10 and not na(inducementBar)
            
            // Target variables (declared at this scope to be visible in selection logic)
            float targetHighPrice = 0.0
            int targetBar = na
            
            // Priority: Find "Most Recent Swept Pivot"
            // Rule: The pivot must be swept by the "Sweep Candle" (High >= Pivot + Tol)
            float pivotSweepHigh = 0.0
            
            // Determine Sweep Candle info
            bool hasSweep = false
            if z.liquiditySwept and not na(z.liquiditySweptBarIndex)
                hasSweep := true
                pivotSweepHigh := high[bar_index - z.liquiditySweptBarIndex]
            else if low <= inducementLowPrice
                hasSweep := true
                pivotSweepHigh := high
            
            // TRACKERS
            float mostRecentAnyPivotPrice = 0.0
            int mostRecentAnyPivotBar = na
            float mostRecentSweptPivotPrice = 0.0
            int mostRecentSweptPivotBar = na
            
            int backwardStart = z.createdBarIndex
            int backwardEnd = inducementBar - 1
            
            // Optimization
            int maxBackwardScan = 200
            if (backwardEnd - backwardStart) > maxBackwardScan
                backwardStart := backwardEnd - maxBackwardScan
            
            if backwardEnd >= backwardStart
                for scanBar = backwardStart to backwardEnd
                    int off = bar_index - scanBar
                    if off >= 0 and off <= bar_index
                        float candleHigh = high[off]
                        
                        // Track ABSOLUTE HIGHEST (Last Resort Fallback)
                        if candleHigh > targetHighPrice
                            targetHighPrice := candleHigh
                            targetBar := scanBar
                            
                        // PIVOT CHECK
                        if not na(ph_series[off])
                            int actualPivotBar = scanBar - 2
                             // Strict Window Check
                            if actualPivotBar >= z.createdBarIndex and actualPivotBar < inducementBar
                                float pVal = ph_series[off]
                                
                                // Track ANY pivot (Most Recent)
                                mostRecentAnyPivotPrice := pVal
                                mostRecentAnyPivotBar := actualPivotBar
                                
                                // Track SWEPT pivot (Most Recent)
                                if hasSweep
                                    if pivotSweepHigh >= (pVal + tol)
                                        mostRecentSweptPivotPrice := pVal
                                        mostRecentSweptPivotBar := actualPivotBar

            // SELECTION LOGIC
            // 1. Prefer Most Recent SWEPT Pivot
            if not na(mostRecentSweptPivotBar)
                targetHighPrice := mostRecentSweptPivotPrice
                targetBar := mostRecentSweptPivotBar
                z.inactiveReason := na // Valid
                z.liquidityValid := true
                
            // 2. Fallback to Most Recent ANY Pivot (Mark Invalid)
            else if not na(mostRecentAnyPivotBar)
                targetHighPrice := mostRecentAnyPivotPrice
                targetBar := mostRecentAnyPivotBar
                // Only mark invalid if we actually HAVE a sweep but missed the pivot
                // If we don't have a sweep yet, it's just "Pending Sweep" (visually valid, logic pending)
                if hasSweep
                    z.inactiveReason := "NO_SWEPT_PIVOT"
                    z.liquidityValid := false
                else
                    z.inactiveReason := "PENDING_SWEEP"
                    z.liquidityValid := true
                   
            // 3. Fallback to Absolute High (Already set in loop)
            else
                // If we fell back to absolute high, it means NO pivots found
                z.inactiveReason := "NO_PIVOT_FOUND"
                z.liquidityValid := false
            
            // === MANDATORY SEQUENTIAL VALUES ===
            bool validSequence = targetHighPrice > inducementLowPrice and not na(targetBar) and targetBar < inducementBar
            
            // Check minimum 2 candles between target and inducement
            int candleGap = inducementBar - targetBar
            bool validGap = candleGap >= 2
            
            if validSequence and validGap
                // Set sequential values as requested
                z.structureSweepLevel := targetHighPrice  // Target Price
                z.liquidityPrice := inducementLowPrice    // Inducement Price
                z.liquidityValid := true
                z.inactiveReason := na
                
                // Store all values for consistency
                z.liqHighPrice := targetHighPrice
                z.liqHighBar := targetBar
                z.liqLowPrice := inducementLowPrice
                z.liqLowBar := inducementBar
                z.liquidityBarIndex := inducementBar
                z.structureSweepLevelBar := targetBar
                z.legCandleCount := candleGap
                z.liquidityCandleCount := candleGap
                z.liqSource := "ABSOLUTE_SEQUENTIAL"
                
                // Reset targetSwept if new target identified
                if z.targetSwept and (z.liqHighPrice != targetHighPrice or z.liqHighBar != targetBar)
                    z.targetSwept := false
                    z.targetSweptBarIndex := na
            else
                // Invalid sequence or insufficient gap
                z.liquidityValid := false
                z.inactiveReason := not validSequence ? "INVALID_SEQUENCE" : "INSUFFICIENT_GAP"
                z.structureSweepLevel := na
                z.liquidityPrice := na
                z.liqHighPrice := na
                z.liqLowPrice := na
        else
            // No inducement found
            z.liquidityValid := false
            z.inactiveReason := "WAITING_LIQ"
            z.structureSweepLevel := na
            z.liquidityPrice := na
            z.liqHighPrice := na
            z.liqLowPrice := na
        true  // Return dummy value

// Supply Liquidity: Find Highest Inducement HIGH first, then Lowest LOW before it (Target)
// Modifies zone fields directly via array reference
f_scan_supply_liquidity(int zoneArrayIndex) =>
    Zone z = array.get(supplyZones, zoneArrayIndex)
    
    // Skip if zone not eligible
    if na(z.createdBarIndex) or bar_index <= z.createdBarIndex or z.isHistorical
        true  // Return dummy value
    else
        float maxDistPrice = liq_max_distance_pips * pip_size
        float minDistPrice = 2.0 * pip_size  // Minimum 2 pips from zone
        
        // === STEP A: Find ABSOLUTE HIGHEST Inducement HIGH ===
        // Scan forward from zone creation to current bar
        float inducementHighPrice = 0.0
        int inducementBar = na
        
        int windowStart = z.createdBarIndex + 1
        int windowEnd = bar_index - 1
        
        if windowEnd >= windowStart
            for scanBar = windowStart to windowEnd
                int off = bar_index - scanBar
                if off >= 0 and off <= bar_index
                    float candleHigh = high[off]
                    
                    // Must be BELOW zone bottom (liquidity sits below supply zone)
                    if candleHigh >= z.bottom
                        continue
                    
                    // Distance checks
                    float distFromZone = z.bottom - candleHigh
                    if maxDistPrice > 0 and distFromZone > maxDistPrice
                        continue
                    if distFromZone < minDistPrice
                        continue
                    
                    // Track ABSOLUTE HIGHEST (no pivot requirement)
                    if candleHigh > inducementHighPrice
                        inducementHighPrice := candleHigh
                        inducementBar := scanBar
        
        // === STEP B: Found Inducement - Now scan BACKWARD from inducement to zone creation ===
        if inducementHighPrice > 0 and not na(inducementBar)
            
            // Target variables (declared at this scope to be visible in selection logic)
            float targetLowPrice = 1.0e10
            int targetBar = na
            
            // Priority: Find "Most Recent Swept Pivot"
            // Rule: The pivot must be swept by the "Sweep Candle" (Low <= Pivot - Tol)
            float pivotSweepLow = 1.0e10
            
            // Determine Sweep Candle info
            bool hasSweep = false
            if z.liquiditySwept and not na(z.liquiditySweptBarIndex)
                hasSweep := true
                pivotSweepLow := low[bar_index - z.liquiditySweptBarIndex]
            else if high >= inducementHighPrice
                hasSweep := true
                pivotSweepLow := low
            
            // TRACKERS
            float mostRecentAnyPivotPrice = 1.0e10
            int mostRecentAnyPivotBar = na
            float mostRecentSweptPivotPrice = 1.0e10
            int mostRecentSweptPivotBar = na
            
            int backwardStart = z.createdBarIndex
            int backwardEnd = inducementBar - 1
            
            // Optimization
            int maxBackwardScan = 200
            if (backwardEnd - backwardStart) > maxBackwardScan
                backwardStart := backwardEnd - maxBackwardScan
            
            if backwardEnd >= backwardStart
                for scanBar = backwardStart to backwardEnd
                    int off = bar_index - scanBar
                    if off >= 0 and off <= bar_index
                        float candleLow = low[off]
                        
                        // Track ABSOLUTE LOWEST (Last Resort Fallback)
                        if candleLow < targetLowPrice
                            targetLowPrice := candleLow
                            targetBar := scanBar
                        
                        // PIVOT CHECK
                        if not na(pl_series[off])
                            int actualPivotBar = scanBar - 2
                             // Strict Window Check
                            if actualPivotBar >= z.createdBarIndex and actualPivotBar < inducementBar
                                float pVal = pl_series[off]
                                
                                // Track ANY pivot
                                mostRecentAnyPivotPrice := pVal
                                mostRecentAnyPivotBar := actualPivotBar
                                
                                // Track SWEPT pivot
                                if hasSweep
                                    if pivotSweepLow <= (pVal - tol)
                                        mostRecentSweptPivotPrice := pVal
                                        mostRecentSweptPivotBar := actualPivotBar

            // SELECTION LOGIC
            // 1. Prefer Most Recent SWEPT Pivot
            if not na(mostRecentSweptPivotBar)
                targetLowPrice := mostRecentSweptPivotPrice
                targetBar := mostRecentSweptPivotBar
                z.liquidityValid := true
                z.inactiveReason := na
                
            // 2. Fallback to Most Recent ANY Pivot (Mark Invalid)
            else if not na(mostRecentAnyPivotBar)
                targetLowPrice := mostRecentAnyPivotPrice
                targetBar := mostRecentAnyPivotBar
                if hasSweep
                    z.inactiveReason := "NO_SWEPT_PIVOT"
                    z.liquidityValid := false
                else
                    z.inactiveReason := "PENDING_SWEEP"
                    z.liquidityValid := true
                   
            // 3. Fallback to Absolute Low
            else
                z.inactiveReason := "NO_PIVOT_FOUND"
                z.liquidityValid := false
            
            // === MANDATORY SEQUENTIAL VALUES ===
            bool validSequence = targetLowPrice < inducementHighPrice and not na(targetBar) and targetBar < inducementBar
            
            // Check minimum 2 candles between target and inducement
            int candleGap = inducementBar - targetBar
            bool validGap = candleGap >= 2
            
            if validSequence and validGap
                // Set sequential values as requested
                z.structureSweepLevel := targetLowPrice   // Target Price
                z.liquidityPrice := inducementHighPrice   // Inducement Price
                z.liquidityValid := true
                z.inactiveReason := na
                
                // Store all values for consistency
                z.liqLowPrice := targetLowPrice
                z.liqLowBar := targetBar
                z.liqHighPrice := inducementHighPrice
                z.liqHighBar := inducementBar
                z.liquidityBarIndex := inducementBar
                z.structureSweepLevelBar := targetBar
                z.legCandleCount := candleGap
                z.liquidityCandleCount := candleGap
                z.liqSource := "ABSOLUTE_SEQUENTIAL"
                
                // Reset targetSwept if new target identified
                if z.targetSwept and (z.liqLowPrice != targetLowPrice or z.liqLowBar != targetBar)
                    z.targetSwept := false
                    z.targetSweptBarIndex := na
            else
                // Invalid sequence or insufficient gap
                z.liquidityValid := false
                z.inactiveReason := not validSequence ? "INVALID_SEQUENCE" : "INSUFFICIENT_GAP"
                z.structureSweepLevel := na
                z.liquidityPrice := na
                z.liqLowPrice := na
                z.liqHighPrice := na
        else
            // No inducement found
            z.liquidityValid := false
            z.inactiveReason := "WAITING_LIQ"
            z.structureSweepLevel := na
            z.liquidityPrice := na
            z.liqLowPrice := na
            z.liqHighPrice := na
        true  // Return dummy value

// Check inducement and target sweeps for demand zone
f_check_demand_sweeps(int zoneArrayIndex) =>
    Zone z = array.get(demandZones, zoneArrayIndex)
    
    // Inducement sweep check
    if not na(z.liqLowPrice) and not z.liquiditySwept
        float sweepTolerance = pip_size * 0.5
        float sweepLevel = z.liqLowPrice + sweepTolerance
        
        if low <= sweepLevel
            z.liquiditySwept := true
            z.liquiditySweptBarIndex := bar_index
            z.causedSweep := true
            
            // Sweep notifications silenced - Zone Inspector tracks this data
            // if debug_full and show_entry_labels
            //     label.new(x = bar_index, y = low, 
            //              text = "🔴 IND SWEPT\nD-" + str.tostring(z.id), 
            //              style = label.style_label_up, 
            //              color = color.new(color.purple, 0),
            //              textcolor = color.white, 
            //              size = size.tiny)
     
    // Target sweep check - ENFORCE ORDERING: Only sweep target if inducement already swept
    if not na(z.liqHighPrice) and not na(z.liqHighBar) and not z.targetSwept
        // ORDERING CHECK: Target sweep ONLY after inducement sweep
        if z.liquiditySwept and bar_index > z.liquiditySweptBarIndex
            float targetSweepTolerance = pip_size * 0.5
            float targetSweepLevel = z.liqHighPrice - targetSweepTolerance
            
            if high >= targetSweepLevel
                z.targetSwept := true
                z.targetSweptBarIndex := bar_index
                z.causedSweep := true
            
            // Sweep notifications silenced - Zone Inspector tracks this data
            // if debug_full and show_entry_labels
            //     label.new(x = bar_index, y = high, 
            //              text = "🟢 TARGET SWEPT\nD-" + str.tostring(z.id), 
            //              style = label.style_label_down, 
            //              color = color.new(color.green, 0),
            //              textcolor = color.white, 
            //              size = size.tiny)
    true  // Return dummy value

// Check inducement and target sweeps for supply zone
f_check_supply_sweeps(int zoneArrayIndex) =>
    Zone z = array.get(supplyZones, zoneArrayIndex)
    
    // Inducement sweep check
    if not na(z.liqHighPrice) and not z.liquiditySwept
        float sweepTolerance = pip_size * 0.5
        float sweepLevel = z.liqHighPrice - sweepTolerance
        
        if high >= sweepLevel
            z.liquiditySwept := true
            z.liquiditySweptBarIndex := bar_index
            z.causedSweep := true
            
            // Sweep notifications silenced - Zone Inspector tracks this data
            // if debug_full and show_entry_labels
            //     label.new(x = bar_index, y = high, 
            //              text = "🔴 IND SWEPT\nS-" + str.tostring(z.id), 
            //              style = label.style_label_down, 
            //              color = color.new(color.purple, 0),
            //              textcolor = color.white, 
            //              size = size.tiny)
    
    // Target sweep check - ENFORCE ORDERING: Only sweep target if inducement already swept
    if not na(z.liqLowPrice) and not na(z.liqLowBar) and not z.targetSwept
        // ORDERING CHECK: Target sweep ONLY after inducement sweep
        if z.liquiditySwept and bar_index > z.liquiditySweptBarIndex
            float targetSweepTolerance = pip_size * 0.5
            float targetSweepLevel = z.liqLowPrice + targetSweepTolerance
            
            if low <= targetSweepLevel
                z.targetSwept := true
                z.targetSweptBarIndex := bar_index
                z.causedSweep := true
            
            // Sweep notifications silenced - Zone Inspector tracks this data
            // if debug_full and show_entry_labels
            //     label.new(x = bar_index, y = low, 
            //              text = "🟢 TARGET SWEPT\nS-" + str.tostring(z.id), 
            //              style = label.style_label_up, 
            //              color = color.new(color.green, 0),
            //              textcolor = color.white, 
            //              size = size.tiny)
    true  // Return dummy value

// === OPTIMIZED ZONE REMOVAL HELPER ===
// Consolidated function to remove demand zone from all arrays (reduces code duplication)
// === UNIFIED ZONE MANAGEMENT HELPERS ===

// Trim base time arrays to prevent memory bloat
// Trim base time arrays to prevent memory bloat
trimBaseTimeArrays() =>
    maxCount = max_zones * 2
    while array.size(used_demand_base_times) > maxCount
        array.pop(used_demand_base_times)
    while array.size(used_supply_base_times) > maxCount
        array.pop(used_supply_base_times)

// Unified Array Trimming (keeps zone boxes and connector lines cleaned up)
trimZoneArrays(bool isDemand) =>
    maxCount = max_zones
    if isDemand
        while array.size(demandZones) > maxCount
            Zone z = array.pop(demandZones)
            db_markInactive(z.id, "max_pruned")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            if not na(z.idLabel)
                label.delete(z.idLabel)
    else
        while array.size(supplyZones) > maxCount
            Zone z = array.pop(supplyZones)
            db_markInactive(z.id, "max_pruned")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            if not na(z.targetLine)
                line.delete(z.targetLine)
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            if not na(z.idLabel)
                label.delete(z.idLabel)

// Unified Zone Creation
createZone(int baseIdx, bool isDemand, bool isHistorical, int zoneUZID) =>
    baseBarIdx = bar_index - baseIdx
    
    // Check if base bar time is already used
    int baseTime = time[baseIdx]
    bool alreadyUsed = false
    if isDemand
        if array.includes(used_demand_base_times, baseTime)
            alreadyUsed := true
        else
            array.push(used_demand_base_times, baseTime)
            trimBaseTimeArrays()
    else
        if array.includes(used_supply_base_times, baseTime)
            alreadyUsed := true
        else
            array.push(used_supply_base_times, baseTime)
            trimBaseTimeArrays()
            
    if not alreadyUsed
        // Calculate Zone Coordinates
        float baseHigh = high[baseIdx]
        float baseLow  = low[baseIdx]
        float baseOpen = open[baseIdx]
        float baseClose = close[baseIdx]
        
        // Determine if it's an "Accuracy" zone: 
        // STRICT INSTITUTIONAL FILTERS
        bool isAccuracy = false
        bool useShiftedBase = false  // Flag to indicate if we should use the previous candle as the zone base
        
        if isDemand
            // DEMAND ACC: STRICT INSTITUTIONAL FILTERS
            // Requirements:
            // 1. Previous candle MUST be GREEN (bullish), current MUST be RED (bearish)
            // 2. Red candle body >= 1.5x green candle body (engulfment strength)
            // 3. Red LOW < Green LOW, Red HIGH > Green HIGH (full engulfment)
            // 4. Lower wick < 30% of body (strong close)
            // 5. Close in bottom 20% of range (selling pressure)
            
            // Candle references (baseIdx is the "current" = RED, baseIdx+1 is "previous" = GREEN)
            float redOpen = baseOpen
            float redClose = baseClose
            float redHigh = baseHigh
            float redLow = baseLow
            float redBody = redOpen - redClose  // Positive if bearish
            float redRange = redHigh - redLow
            
            float greenOpen = open[baseIdx + 1]
            float greenClose = close[baseIdx + 1]
            float greenHigh = high[baseIdx + 1]
            float greenLow = low[baseIdx + 1]
            float greenBody = greenClose - greenOpen  // Positive if bullish
            
            // Filter 1: Pattern check (Prev=GREEN, Current=RED)
            bool isPrevGreen = greenClose > greenOpen
            bool isCurrRed = redClose < redOpen
            bool patternOk = isPrevGreen and isCurrRed
            
            // Filter 2: Body size ratio (Red body >= 1.5x Green body)
            bool bodySizeOk = redBody >= (greenBody * 1.5)
            
            // Filter 3: Full engulfment (Red range engulfs Green range)
            bool engulfmentOk = redLow < greenLow and redHigh > greenHigh
            
            // Filter 4: Small lower wick (< 30% of body size)
            float lowerWick = redClose - redLow
            bool wickOk = redBody > 0 and (lowerWick / redBody) < 0.30
            
            // Filter 5: Close near low (in bottom 20% of range)
            bool closeNearLow = redRange > 0 and (redClose <= redLow + (redRange * 0.20))
            
            // All filters must pass for Demand ACC
            isAccuracy := patternOk and bodySizeOk and engulfmentOk and wickOk and closeNearLow
        else
            // SUPPLY ACC: STRICT INSTITUTIONAL FILTERS
            // Requirements:
            // 1. Previous candle MUST be RED (bearish), current MUST be GREEN (bullish)
            // 2. Green candle body >= 1.5x red candle body (engulfment strength)
            // 3. Green LOW < Red LOW, Green HIGH > Red HIGH (full engulfment)
            // 4. Upper wick < 30% of body (strong close)
            // 5. Close in top 20% of range (buying pressure)
            
            // Candle references (baseIdx is the "current" = GREEN, baseIdx+1 is "previous" = RED)
            float greenOpen = baseOpen
            float greenClose = baseClose
            float greenHigh = baseHigh
            float greenLow = baseLow
            float greenBody = greenClose - greenOpen  // Positive if bullish
            float greenRange = greenHigh - greenLow
            
            float redOpen = open[baseIdx + 1]
            float redClose = close[baseIdx + 1]
            float redHigh = high[baseIdx + 1]
            float redLow = low[baseIdx + 1]
            float redBody = redOpen - redClose  // Positive if bearish
            
            // Filter 1: Pattern check (Prev=RED, Current=GREEN)
            bool isPrevRed = redClose < redOpen
            bool isCurrGreen = greenClose > greenOpen
            bool patternOk = isPrevRed and isCurrGreen
            
            // Filter 2: Body size ratio (Green body >= 1.5x Red body)
            bool bodySizeOk = greenBody >= (redBody * 1.5)
            
            // Filter 3: Full engulfment (Green range engulfs Red range)
            bool engulfmentOk = greenLow < redLow and greenHigh > redHigh
            
            // Filter 4: Small upper wick (< 30% of body size)
            float upperWick = greenHigh - greenClose
            bool wickOk = greenBody > 0 and (upperWick / greenBody) < 0.30
            
            // Filter 5: Close near high (in top 20% of range)
            bool closeNearHigh = greenRange > 0 and (greenClose >= greenHigh - (greenRange * 0.20))
            
            // All filters must pass for Supply ACC
            isAccuracy := patternOk and bodySizeOk and engulfmentOk and wickOk and closeNearHigh

        float zTop = na
        float zBottom = na
        
        // Updates for Shifted Base (Use Previous Candle Data)
        int effectiveBaseIdx = useShiftedBase ? baseIdx + 1 : baseIdx
        float effHigh = high[effectiveBaseIdx]
        float effLow = low[effectiveBaseIdx]
        float effOpen = open[effectiveBaseIdx]
        float effClose = close[effectiveBaseIdx]
        
        // Update baseBarIdx if shifting (so box starts at previous candle)
        if useShiftedBase
            baseBarIdx := baseBarIdx - 1
        
        bool isBearishBase = effClose < effOpen
        bool isBullishBase = effClose > effOpen
        
        if isAccuracy
            if isDemand
                // Demand Accuracy: ALWAYS use CLOSE as top, LOW as bottom
                // This is where institutions bought - the demand zone starts from LOW
                // Top is the CLOSE (where the selling pressure ended)
                zTop := effClose
                zBottom := effLow
            else
                // Supply Accuracy: ALWAYS use HIGH of supply candle as top
                // This is where institutions actually sold - the true supply level
                // Bottom is the CLOSE (where the selling push ended)
                zTop := effHigh
                zBottom := effClose
        else
            // Normal zones: Full candle range of ORIGINAL base (unless we want to shift normal zones too? No, keep standard)
            // But if we shifted, we use shifted candle logic. If not ACC, uses original.
            // Actually, if shiftedAcc is true, we ARE Accuracy. So this else is for non-ACC.
            // Non-ACC uses original base.
            zTop := baseHigh
            zBottom := baseLow
        
        // Cap zone size to avoid overly large zones
        max_zone_size = 50.0 * pip_size
        if (zTop - zBottom) > max_zone_size
            // Keep current range even if large - no adjustment needed
            true  // No-op, just for syntax

        // Create Visual Box with thicker border and distinct color for Accuracy zones
        int zoneBorderWidth = isAccuracy ? 2 : 1
        color zoneBgColor = na
        if isAccuracy
            // Accuracy zones: Teal/Cyan color to distinguish from normal zones
            zoneBgColor := color.new(#00bcd4, 65)
        else
            // Normal zones: standard colors
            zoneBgColor := isDemand ? col_demand_bg : col_supply_bg
            
        box b = box.new(left = baseBarIdx, top = zTop, right = baseBarIdx + extend_bars, bottom = zBottom,
             border_color = isDemand ? col_demand_border : col_supply_border,
             border_width = zoneBorderWidth,
             bgcolor = zoneBgColor,
             xloc = xloc.bar_index)
             
        // Create ID Label with solid background for visibility
        string accTag = isAccuracy ? "⭐ ACC " : ""
        
        // DEBUG: Add value comparison to label if debug active
        if show_debug_labels and isAccuracy
            string debugInfo = ""
            float vBase = isDemand ? baseLow : baseHigh
            float vPrev = isDemand ? low[baseIdx+1] : high[baseIdx+1]
            float vPrev2 = isDemand ? low[baseIdx+2] : high[baseIdx+2]
             
            if useShiftedBase
                debugInfo := " [SHIFT: " + str.tostring(vPrev, format.mintick) + " > " + str.tostring(vPrev2, format.mintick) + "]"
            else
                debugInfo := " [STD: " + str.tostring(vBase, format.mintick) + " > " + str.tostring(vPrev, format.mintick) + "]"
             
            accTag := accTag + debugInfo

        string id_text = " " + accTag + (isDemand ? "D-" : "S-") + str.tostring(zoneUZID) + " "
        float mid = (zTop + zBottom) / 2.0
        color lbl_bg_color = isDemand ? color.new(#089981, 0) : color.new(#f23645, 0)  // Solid green/red
        label idLbl = label.new(x = baseBarIdx, y = mid, text = id_text,
             style = label.style_label_left, textcolor = color.white, color = lbl_bg_color,
             size = size.tiny,  // Forced tiny size for clean chart
             textalign = text.align_center, xloc = xloc.bar_index)

        // Create Zone Object
        Zone z = Zone.new()
        z.id := zoneUZID
        z.boxId := b
        z.top := zTop
        z.bottom := zBottom
        z.active := true
        z.createdBarIndex := baseBarIdx
        z.isHistorical := isHistorical
        z.startTime := time[baseIdx]
        z.idLabel := idLbl
        z.isAccuracy := isAccuracy  // Tag zone type for trade tracking
        
        // Initialize Inducement and Target levels at zone creation
        // These provide initial values for Zone Inspector display
        if isDemand
            // Demand: Inducement = LOW of demand candle, Target = HIGH of previous candle
            z.liqLowPrice := baseLow                    // Inducement (where institutions bought)
            z.liqLowBar := baseBarIdx                   // Bar index of inducement
            z.liqHighPrice := high[baseIdx + 1]         // Target (previous candle high)
            z.liqHighBar := bar_index - (baseIdx + 1)   // Bar index of target
            z.liquidityPrice := baseLow                 // Primary liquidity price
            z.liquidityBarIndex := baseBarIdx           // Primary liquidity bar
        else
            // Supply: Inducement = HIGH of supply candle, Target = LOW of previous candle
            z.liqHighPrice := baseHigh                  // Inducement (where institutions sold)
            z.liqHighBar := baseBarIdx                  // Bar index of inducement
            z.liqLowPrice := low[baseIdx + 1]           // Target (previous candle low)
            z.liqLowBar := bar_index - (baseIdx + 1)    // Bar index of target
            z.liquidityPrice := baseHigh                // Primary liquidity price
            z.liquidityBarIndex := baseBarIdx           // Primary liquidity bar
        
        // Add to array and register in DB
        if isDemand
            array.unshift(demandZones, z)
            db_upsertZone(z, "DEMAND")
            trimZoneArrays(true)
        else
            array.unshift(supplyZones, z)
            db_upsertZone(z, "SUPPLY")
            trimZoneArrays(false)

// Unified Zone Removal
remove_zone_all_arrays(bool isDemand, int idx) =>
    if isDemand
        if idx >= 0 and idx < array.size(demandZones)
            Zone z = array.get(demandZones, idx)
            db_markInactive(z.id, "removed")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na  // Explicitly free memory
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na  // Explicitly free memory
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na  // Explicitly free memory
            if not na(z.idLabel)
                label.delete(z.idLabel)
                z.idLabel := na  // Explicitly free memory
            array.remove(demandZones, idx)
    else
        if idx >= 0 and idx < array.size(supplyZones)
            Zone z = array.get(supplyZones, idx)
            db_markInactive(z.id, "removed")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na  // Explicitly free memory
            if not na(z.targetLine)
                line.delete(z.targetLine)
                z.targetLine := na  // Explicitly free memory
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na  // Explicitly free memory
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na  // Explicitly free memory
            if not na(z.idLabel)
                label.delete(z.idLabel)
                z.idLabel := na  // Explicitly free memory
            array.remove(supplyZones, idx)

// === LIQUIDITY DISTANCE HELPER FUNCTIONS ===
// Calculate distance from zone edge to liquidity level in pips
// For Supply: zoneBottom - liqHighPrice (zone bottom is closest to the inducement high below)
// For Demand: liqLowPrice - zoneTop (zone top is closest to the inducement low above)
getLiquidityDistance(Zone z, bool isSupply) =>
    float dist = na
    if isSupply
        // Supply: distance from zone BOTTOM to the liquidity HIGH (inducement high)
        // The inducement high is BELOW the zone, so measure from zone bottom
        // Formula: supplyZoneBottom - supplyLiquidityHigh
        if not na(z.liqHighPrice) and not na(z.bottom)
            dist := (z.bottom - z.liqHighPrice) / pip_size
    else
        // Demand: distance from liquidity LOW (inducement low) to zone TOP
        // The inducement low is ABOVE the zone, so measure from zone top
        // Formula: demandLiquidityLow - demandZoneTop
        if not na(z.liqLowPrice) and not na(z.top)
            dist := (z.liqLowPrice - z.top) / pip_size
    // Return absolute value to ensure positive distance
    na(dist) ? na : math.abs(dist)

// Check if liquidity distance is within limit
// Returns true if within limit or if limit is 0 (no limit)
checkLiquidityDistance(Zone z, bool isSupply) =>
    if liq_entry_max_dist == 0.0
        true  // No limit when set to 0
    else
        float dist = getLiquidityDistance(z, isSupply)
        na(dist) or dist <= liq_entry_max_dist



// Unified Entry Validation
// === VALIDATION HELPERS ===
// Deduplicated logic for position safety and validation

// Validates and clamps Stop Loss to ensure minimum distance from Entry
// Returns: [adjusted_sl, sl_pips, is_valid]
validate_safety_clamp(bool isLong, float entry, float sl) =>
    float adjusted_sl = sl
    // Ensure SL is strictly beyond Entry (min 2 pips gap) to prevent position sizing errors
    float minGap = math.max(syminfo.mintick * 2, pip_size * 2.0)
    
    if isLong
        if adjusted_sl >= entry - minGap
            adjusted_sl := entry - minGap
    else
        // Shorts
        if adjusted_sl <= entry + minGap
            adjusted_sl := entry + minGap
            
    // Calculate distance and validity
    float dist = math.abs(entry - adjusted_sl)
    bool valid = dist > 0
    float pips = valid ? (dist / pip_size) : 0.0
    
    [adjusted_sl, pips, valid]

// Validates that Take Profit is far enough from Entry
// Returns: true if valid (or TP is NA), false if too close
validate_tp_distance(float entry, float tp, float min_pips) =>
    bool valid = true
    if not na(tp) and not na(entry)
        float dist_pips = math.abs(tp - entry) / pip_size
        if dist_pips < min_pips
            valid := false
    valid

validate_entry_conditions(bool isDemand, int idx) =>
    bool canEnter = true
    string reason = ""
    Zone z = na

    if isDemand
        if idx < 0 or idx >= array.size(demandZones)
            canEnter := false
            reason := "Invalid demand zone index"
        else
            z := array.get(demandZones, idx)
    else
        if idx < 0 or idx >= array.size(supplyZones)
            canEnter := false
            reason := "Invalid supply zone index"
        else
            z := array.get(supplyZones, idx)

    if canEnter
        if not z.active
            canEnter := false
            reason := isDemand ? "Demand zone inactive" : "Supply zone inactive"
        
        // HARD GATE: Pre-Sweep Invalidation check
        if canEnter and not z.eligibleEntry
            canEnter := false
            reason := "Zone Invalid: Touched Pre-Sweep"

    // TIMING FILTER (Prioritized): Check this EARLY so user sees "Wait for Flip" 
    // instead of generic "Waiting for Sweep" if likely blocked by time
    if canEnter and enable_timing_filters and is_blocked_by_timing()
        canEnter := false
        // Provide specific timing reason based on current minute
        curr_min = minute(time, time_window_tz)
        if curr_min == 55
            reason := "Waiting for Flip (Final 5m)"
        else if (curr_min % 15) == 0 and curr_min != 0
            reason := "Blocked by Timing (Boundary)"
        else
            reason := "Entry Allowed"

    if canEnter
        // Zone must have caused sweep & not be historical
        if not z.causedSweep
            canEnter := false
            reason := isDemand ? "Waiting for Inducement Sweep (Demand)" : "Waiting for Inducement Sweep (Supply)"
        if canEnter and z.isHistorical
            canEnter := false
            reason := isDemand ? "Demand zone created in historical backfill" : "Supply zone created in historical backfill"

        // Liquidity existence (candle-count rule) & sweep timing
        if canEnter and require_liquidity_sweep
            if not z.liquidityValid
                canEnter := false
                reason := isDemand ? "Demand liquidity invalid (candle-count rule failed)" : "Supply liquidity invalid (candle-count rule failed)"
            else if not z.liquiditySwept
                canEnter := false
                reason := isDemand ? "Waiting for Inducement Sweep (Demand)" : "Waiting for Inducement Sweep (Supply)"
            else if not z.targetSwept
                canEnter := false
                reason := isDemand ? "Waiting for Target HIGH Sweep (Demand)" : "Waiting for Target LOW Sweep (Supply)"
            else if na(z.targetSweptBarIndex) or z.targetSweptBarIndex <= z.liquiditySweptBarIndex
                // STRICT ORDERING GATE: Target sweep must happen AFTER inducement sweep
                canEnter := false
                reason := "Target sweep must occur AFTER inducement sweep"
            else if na(z.liquiditySweptBarIndex) or bar_index < z.liquiditySweptBarIndex
                canEnter := false
                reason := isDemand ? "Demand entry before liquidity sweep bar" : "Supply entry before liquidity sweep bar"
            else
                // Check liquidity distance from zone boundary (using helper function)
                // For Supply: liqHighPrice to zone top
                // For Demand: liqLowPrice to zone bottom
                // Skip check if liq_entry_max_dist is 0 (no limit)
                if liq_entry_max_dist > 0.0 and not checkLiquidityDistance(z, not isDemand)
                    float liqDist = getLiquidityDistance(z, not isDemand)
                    canEnter := false
                    reason := "Liq distance too far (" + str.tostring(liqDist, "#.#") + " pips > " + str.tostring(liq_entry_max_dist, "#.#") + ")"
        else if canEnter and not require_liquidity_sweep
            if not z.liquidityValid
                // Liquidity not strictly required, but we still report it for transparency
                reason := "OK (liquidity optional; none/invalid)"

        // LIQUIDITY SWEPT GATE (simplified): Just check if pivot was swept
        // No separate Target vs Inducement check needed with 3-candle logic

        // Wick into zone check - STRICT: The wick must actually enter the zone
        // For Demand: LOW must be inside zone (low >= z.bottom and low <= z.top)
        // For Supply: HIGH must be inside zone (high >= z.bottom and high <= z.top)
        bool wickIntoZone = false
        if canEnter
            for w = 0 to 2
                if bar_index >= w
                    float wLow = low[w]
                    float wHigh = high[w]
                    bool touches = false
                    if isDemand
                        // Demand: require LOW (wick down) to be inside zone
                        touches := wLow <= z.top and wLow >= z.bottom
                    else
                        // Supply: require HIGH (wick up) to be inside zone
                        touches := wHigh >= z.bottom and wHigh <= z.top
                    if touches
                        wickIntoZone := true
                        break
            if not wickIntoZone
                canEnter := false
                reason := isDemand ? "No wick INTO demand zone in last 3 bars" : "No wick INTO supply zone in last 3 bars"

        // Zone not used yet
        bool zone_already_used = not na(z.lastEntryBar)
        if canEnter and zone_already_used
            canEnter := false
            reason := isDemand ? "Demand zone already used for a trade" : "Supply zone already used for a trade"

        // Zone not mitigated
        if canEnter and z.mitigated
            canEnter := false
            reason := isDemand ? "Demand zone mitigated before liquidity sweep" : "Supply zone mitigated before liquidity sweep"

        // 24h freshness
        bool zoneIsFresh = na(z.startTime) or (time - z.startTime) <= (24 * 60 * 60 * 1000)
        if canEnter and not zoneIsFresh
            canEnter := false
            reason := isDemand ? "Demand zone older than 24h" : "Supply zone older than 24h"

        // Minimum bar index for entries
        bool zone_created_after_min_bar = na(z.createdBarIndex) or z.createdBarIndex >= min_bar_index_for_entries
        if canEnter and not zone_created_after_min_bar
            canEnter := false
            reason := "Zone created before min bar index"

    [canEnter, reason, z]

// === TRADE TRACKING VARIABLES ===
var float trade_entry_price      = na
var float trade_original_sl      = na
