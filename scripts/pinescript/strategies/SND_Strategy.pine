var int last_bar_index_for_debug = na
last_bar_index_for_debug := bar_index

isRecentBarForDebug() =>
    if debug_last_bars <= 0 or na(last_bar_index_for_debug)
        true
    else
        bar_index >= (last_bar_index_for_debug - debug_last_bars)


get_symbol_type() =>
    ticker = syminfo.ticker
    if str.contains(ticker, "XAU") or str.contains(ticker, "GOLD")
        "XAUUSD"
    else if str.contains(ticker, "GBPJPY") or str.contains(ticker, "GJ")
        "GJ"
    else
        "OTHER"

current_symbol = get_symbol_type()

// ============================================================================
// PROP FIRM KILL SWITCHES
// ============================================================================

var float pf_day_start_equity  = strategy.equity
var float pf_peak_equity       = strategy.initial_capital
var int   pf_consecutive_losses = 0

if ta.change(time("D")) != 0
    pf_day_start_equity    := strategy.equity
    pf_consecutive_losses  := 0

pf_peak_equity := math.max(pf_peak_equity, strategy.equity)

if strategy.closedtrades > 0 and strategy.closedtrades > nz(strategy.closedtrades[1], 0)
    float _pf_last_pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    pf_consecutive_losses := _pf_last_pnl < 0 ? pf_consecutive_losses + 1 : 0

float pf_current_day_dd_pct   = pf_day_start_equity > 0 ? (pf_day_start_equity - strategy.equity) / pf_day_start_equity * 100 : 0.0
float pf_current_total_dd_pct = strategy.initial_capital > 0 ? (pf_peak_equity - strategy.equity) / strategy.initial_capital * 100 : 0.0

bool pf_daily_kill   = pf_current_day_dd_pct   >= daily_kill_pct
bool pf_total_kill   = pf_current_total_dd_pct >= total_kill_pct
bool pf_session_kill = pf_consecutive_losses   >= consec_loss_kill
bool pf_trading_disabled = pf_daily_kill or pf_total_kill or pf_session_kill

if (pf_daily_kill or pf_total_kill) and strategy.position_size != 0
    strategy.close_all(comment = pf_daily_kill ? "DAILY_KILL" : "TOTAL_KILL")

// ============================================================================
// MIN HOLD ENFORCEMENT
