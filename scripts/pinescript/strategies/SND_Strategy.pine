    targetSweptThisBar := false

var int[] _current_day_trades = array.new_int(1, 0)
var int   last_trade_day      = na
current_day_trades = array.get(_current_day_trades, 0)

var float daily_pnl = 0.0
var float daily_start_equity = 0.0
var int last_pnl_day = na

current_day_ts = time("D")
if (reset_daily_pnl and current_day_ts != last_pnl_day)
    daily_pnl := 0.0
    daily_start_equity := strategy.equity
    last_pnl_day := current_day_ts

if strategy.closedtrades > 0
    daily_pnl := strategy.equity - daily_start_equity

is_daily_loss_limit_hit() =>
    loss_limit = daily_start_equity * (max_daily_loss_pct / 100.0)
    daily_pnl < -loss_limit

is_daily_profit_limit_hit() =>
    profit_limit = daily_start_equity * (max_daily_profit_pct / 100.0)
    daily_pnl > profit_limit

trades_allowed_today() =>
    trade_limit_ok = enable_trade_limit ? array.get(_current_day_trades, 0) < max_trades_per_day : true
    trade_limit_ok and not is_daily_loss_limit_hit() and not is_daily_profit_limit_hit()

is_late_friday() =>
    day_of_week = dayofweek(time, "Etc/GMT+5")
    current_hour = hour(time, "Etc/GMT+5")
    day_of_week == dayofweek.friday and current_hour >= 20

is_htf_candle_open() =>
    int currentMinute = minute(time)
    int posInHTF = currentMinute % 15  // 0=HTF open, 14=last bar before next HTF
    posInHTF == 0 or posInHTF >= 10  // HTF open + last 5 minutes before next HTF (:10-:14, :25-:29, :40-:44, :55-:59)

getDeadZoneStatus() =>
    if not filter_dead_zone
        "Disabled"
    else if is_time_dead_zone()
        "BLOCKED (" + str.tostring(minute(time)) + "m)"
    else
        "OK"

current_day_start = time("D", "Etc/GMT+5")
if na(last_trade_day) or current_day_start != last_trade_day
    current_day_trades := 0
    array.set(_current_day_trades, 0, 0)
    last_trade_day := current_day_start


findZoneIndexByUZID(int targetUZID, Core.Zone[] zones) =>
    int idx = na
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Core.Zone z = array.get(zones, i)
            if z.id == targetUZID
                idx := i
                break
    idx

findDemandZoneIndexByUZID(targetUZID) =>
    findZoneIndexByUZID(targetUZID, demandZones)

findSupplyZoneIndexByUZID(targetUZID) =>
    findZoneIndexByUZID(targetUZID, supplyZones)

f_demand_zone_is_live(int idx) =>
    if idx < 0 or idx >= array.size(demandZones)
        [false, "Zone index invalid"]
    else
        Core.Zone z = array.get(demandZones, idx)
        if not z.active
            [false, "Zone inactive"]
        else if z.mitigated
            [false, "Zone mitigated"]
        else if na(z.id)
            [false, "Zone removed"]
        else if not na(z.inactiveReason) and str.length(z.inactiveReason) > 0 and not str.contains(z.inactiveReason, "Model:")
            [false, "Zone invalid: " + z.inactiveReason]
        else
            [true, ""]

f_supply_zone_is_live(int idx) =>
    if idx < 0 or idx >= array.size(supplyZones)
        [false, "Zone index invalid"]
    else
        Core.Zone z = array.get(supplyZones, idx)
        if not z.active
            [false, "Zone inactive"]
        else if z.mitigated
            [false, "Zone mitigated"]
        else if na(z.id)
            [false, "Zone removed"]
        else if not na(z.inactiveReason) and str.length(z.inactiveReason) > 0 and not str.contains(z.inactiveReason, "Model:")
            [false, "Zone invalid: " + z.inactiveReason]
        else
            [true, ""]

deactivateDemandZone(idx) =>
    remove_zone_all_arrays(true, idx)

deactivateSupplyZone(idx) =>
    remove_zone_all_arrays(false, idx)

deactivateOverlappingSupplyZones(refLow, refHigh) =>
    int sz = array.size(supplyZones)
    if sz > 0
        for k = sz - 1 to 0
            Core.Zone z = array.get(supplyZones, k)
            if z.active
                overlaps = not (z.top < refLow or z.bottom > refHigh)
                if overlaps
                    deactivateSupplyZone(k)

deactivateOverlappingDemandZones(refLow, refHigh) =>
    int sz = array.size(demandZones)
    if sz > 0
        for k = sz - 1 to 0
            Core.Zone z = array.get(demandZones, k)
            if z.active
                overlaps = not (z.top < refLow or z.bottom > refHigh)
                if overlaps
                    deactivateDemandZone(k)


is_gold_continuation_zone(int baseIdx, bool isDemand) =>
    bool result = false
    bool enabled = gold_continuation_zones
    if enabled and baseIdx >= 1 and baseIdx + 1 <= bar_index
        float baseRange = high[baseIdx] - low[baseIdx]
        float baseBody = math.abs(close[baseIdx] - open[baseIdx])
        bool compactBase = baseRange > syminfo.mintick and baseRange <= atr14 * 1.8 and baseBody <= baseRange * 0.65
        bool validBaseSide = isDemand ? close[baseIdx] < open[baseIdx] : close[baseIdx] > open[baseIdx]
        bool continuationApproach = isDemand ? close[baseIdx + 1] > open[baseIdx + 1] : close[baseIdx + 1] < open[baseIdx + 1]
        bool reversalApproach = isDemand ? close[baseIdx + 1] < open[baseIdx + 1] : close[baseIdx + 1] > open[baseIdx + 1]
        bool confirmsAway = false
        for confirmScan = 1 to formation_leg_scan_bars
            int confirmIdx = baseIdx - confirmScan
            if confirmIdx < 0
                break
            bool confirmCandle = isDemand ? close[confirmIdx] > open[confirmIdx] and close[confirmIdx] > high[baseIdx] : close[confirmIdx] < open[confirmIdx] and close[confirmIdx] < low[baseIdx]
            if confirmCandle
                confirmsAway := true
                break
        float priorBodyEdge = isDemand ? math.min(open[baseIdx + 1], close[baseIdx + 1]) : math.max(open[baseIdx + 1], close[baseIdx + 1])
        bool shallowPullback = isDemand ? low[baseIdx] >= priorBodyEdge - atr14 * 0.25 : high[baseIdx] <= priorBodyEdge + atr14 * 0.25
        bool reversalExtreme = isDemand ? low[baseIdx] <= low[baseIdx + 1] + atr14 * 0.25 : high[baseIdx] >= high[baseIdx + 1] - atr14 * 0.25
        bool validApproach = (continuationApproach and shallowPullback) or (reversalApproach and reversalExtreme)
        result := compactBase and validBaseSide and validApproach and confirmsAway
    result

is_preferred_gold_continuation_zone(int baseIdx, bool isDemand) =>
    is_gold_continuation_zone(baseIdx, isDemand)

displacement_leg_confirmed(int displacementIdx, int baseIdx, bool isDemand) =>
    bool confirmed = false
    if not is_index
        confirmed := true
    else if displacementIdx >= 0 and baseIdx >= 0 and displacementIdx <= bar_index and baseIdx <= bar_index
        float baseRange = high[baseIdx] - low[baseIdx]
        float displacementBody = math.abs(close[displacementIdx] - open[displacementIdx])
        float closeExtension = isDemand ? close[displacementIdx] - high[baseIdx] : low[baseIdx] - close[displacementIdx]
        bool closeExtensionOk = closeExtension >= atr14 * 0.25
        bool bodyAtrOk = displacementBody >= atr14 * 0.30
        bool bodyVsBaseOk = baseRange <= 0 ? true : displacementBody >= baseRange * 0.70
        confirmed := closeExtensionOk and bodyAtrOk and bodyVsBaseOk
    confirmed

candidate_zone_bounds(int baseIdx, bool isDemand) =>
    float zTop = high[baseIdx]
    float zBottom = low[baseIdx]
    int reactionIdx = baseIdx - 1
    bool isAccuracyCandidate = false
    if should_use_accuracy_zones and reactionIdx >= 0
        if isDemand
            isAccuracyCandidate := high[baseIdx] > high[reactionIdx]
        else
            isAccuracyCandidate := low[baseIdx] < low[reactionIdx]
    if isAccuracyCandidate
        if isDemand
            zTop := open[baseIdx]
            zBottom := low[baseIdx]
        else
            zTop := high[baseIdx]
            zBottom := open[baseIdx]
    [zTop, zBottom]

formation_leg_retouches_zone_after_leave(int baseIdx, bool isDemand, int startOffset) =>
    [zTop, zBottom] = candidate_zone_bounds(baseIdx, isDemand)
    bool leftZone = false
    bool retouched = false
    int legSpan = baseIdx - startOffset
    if legSpan > 0
        for walk = 0 to legSpan - 1
            int off = baseIdx - 1 - walk
            if off < startOffset
                break
            if retouched
                break

            bool sameSideCandle = isDemand ? Utils.is_bearish(close[off], open[off]) : Utils.is_bullish(close[off], open[off])
            float bodyHigh = math.max(open[off], close[off])
            float bodyLow = math.min(open[off], close[off])
            bool bodyOverlapsZone = bodyHigh >= zBottom and bodyLow <= zTop
            bool closeInsideZone = close[off] <= zTop and close[off] >= zBottom
            if sameSideCandle and closeInsideZone and bodyOverlapsZone
                retouched := true
                break

            if not leftZone
                bool directionalDeparture = isDemand ? Utils.is_bullish(close[off], open[off]) : Utils.is_bearish(close[off], open[off])
                bool movedAwayFromZone = isDemand ? high[off] > zTop : low[off] < zBottom
                leftZone := directionalDeparture and movedAwayFromZone
            else
                bool oppositeCandle = isDemand ? Utils.is_bearish(close[off], open[off]) : Utils.is_bullish(close[off], open[off])
                if oppositeCandle and closeInsideZone and bodyOverlapsZone
                    retouched := true
    retouched

findDisplacementBase(bool isDemand, int startOffset, int maxLegBars) =>
    int baseIdx = na
    int legCount = 0
    int rejectIdx = na
    string rejectReason = ""
    for scan = 1 to maxLegBars
        int candidateBaseIdx = startOffset + scan
        if candidateBaseIdx >= bar_index
            break

        bool baseOk = isDemand ? Utils.is_bearish(close[candidateBaseIdx], open[candidateBaseIdx]) : Utils.is_bullish(close[candidateBaseIdx], open[candidateBaseIdx])
        if baseOk
            int directionalCount = 0
            bool hasConfirmedDisplacement = false
            for legOffset = startOffset to candidateBaseIdx - 1
                bool directionalCandle = isDemand ? Utils.is_bullish(close[legOffset], open[legOffset]) : Utils.is_bearish(close[legOffset], open[legOffset])
                if directionalCandle
                    directionalCount += 1
                    if displacement_leg_confirmed(legOffset, candidateBaseIdx, isDemand)
                        hasConfirmedDisplacement := true

            if directionalCount == 0
                rejectIdx := candidateBaseIdx
                rejectReason := "no displacement candle"
            else if not hasConfirmedDisplacement
                rejectIdx := candidateBaseIdx
                rejectReason := "displacement too weak"
            else if formation_leg_retouches_zone_after_leave(candidateBaseIdx, isDemand, startOffset)
                rejectIdx := candidateBaseIdx
                rejectReason := "formation retouched zone"
            else
                baseIdx := candidateBaseIdx
                legCount := directionalCount
            break
    [baseIdx, legCount, rejectIdx, rejectReason]


if barstate.isconfirmed and bar_index > 10
    [demandBaseIdx, demandLegCandles, demandRejectIdx, demandRejectReason] = findDisplacementBase(true, 0, displacement_base_scan_bars)
    if not na(demandBaseIdx) and not is_base_time_used(demandBaseIdx, used_demand_base_times)
        global_zone_id_counter := global_zone_id_counter + 1
        createZone(demandBaseIdx, true, false, 1, demandLegCandles, global_zone_id_counter)
    else if not na(demandBaseIdx)
        showZoneMiss(demandBaseIdx, true, "base already used", 201)
    else if not na(demandRejectIdx)
        showZoneMiss(demandRejectIdx, true, demandRejectReason, stageARejectCode(demandRejectReason))
    else
        showZoneMiss(0, true, "no base found", 101)

    for contBaseIdx = 1 to formation_leg_scan_bars
        if is_preferred_gold_continuation_zone(contBaseIdx, true)
            if na(demandBaseIdx) or not na(demandRejectIdx)
                recordDiag(106, true, contBaseIdx, "continuation detected after standard reject")
            global_zone_id_counter := global_zone_id_counter + 1
            createZone(contBaseIdx, true, false, 1, 1, global_zone_id_counter, true)

if barstate.isconfirmed and bar_index > 10
    [supplyBaseIdx, supplyLegCandles, supplyRejectIdx, supplyRejectReason] = findDisplacementBase(false, 0, displacement_base_scan_bars)
    if not na(supplyBaseIdx) and not is_base_time_used(supplyBaseIdx, used_supply_base_times)
        global_zone_id_counter := global_zone_id_counter + 1
        createZone(supplyBaseIdx, false, false, 1, supplyLegCandles, global_zone_id_counter)
    else if not na(supplyBaseIdx)
        showZoneMiss(supplyBaseIdx, false, "base already used", 201)
    else if not na(supplyRejectIdx)
        showZoneMiss(supplyRejectIdx, false, supplyRejectReason, stageARejectCode(supplyRejectReason))
    else
        showZoneMiss(0, false, "no base found", 101)

    for contBaseIdx = 1 to formation_leg_scan_bars
        if is_preferred_gold_continuation_zone(contBaseIdx, false)
            if na(supplyBaseIdx) or not na(supplyRejectIdx)
                recordDiag(106, false, contBaseIdx, "continuation detected after standard reject")
            global_zone_id_counter := global_zone_id_counter + 1
            createZone(contBaseIdx, false, false, 1, 1, global_zone_id_counter, true)

if barstate.isconfirmed and not initial_scan_done and bar_index > 50
    initial_scan_done := true
    max_displacement_scan = math.min(300, bar_index)
    for displacementIdx = 0 to max_displacement_scan
        [demandBaseIdx, demandLegCandles, demandRejectIdx, demandRejectReason] = findDisplacementBase(true, displacementIdx, displacement_base_scan_bars)
        if not na(demandBaseIdx) and demandBaseIdx <= max_displacement_scan and not is_base_time_used(demandBaseIdx, used_demand_base_times)
            global_zone_id_counter := global_zone_id_counter + 1
            createZone(demandBaseIdx, true, true, 1, demandLegCandles, global_zone_id_counter)
        else if not na(demandBaseIdx) and demandBaseIdx <= max_displacement_scan
            showZoneMiss(demandBaseIdx, true, "historical base already used", 203)

        [supplyBaseIdx, supplyLegCandles, supplyRejectIdx, supplyRejectReason] = findDisplacementBase(false, displacementIdx, displacement_base_scan_bars)
        if not na(supplyBaseIdx) and supplyBaseIdx <= max_displacement_scan and not is_base_time_used(supplyBaseIdx, used_supply_base_times)
            global_zone_id_counter := global_zone_id_counter + 1
            createZone(supplyBaseIdx, false, true, 1, supplyLegCandles, global_zone_id_counter)
        else if not na(supplyBaseIdx) and supplyBaseIdx <= max_displacement_scan
            showZoneMiss(supplyBaseIdx, false, "historical base already used", 203)

        if displacementIdx >= 2 and is_preferred_gold_continuation_zone(displacementIdx, true)
            global_zone_id_counter := global_zone_id_counter + 1
            createZone(displacementIdx, true, true, 1, 1, global_zone_id_counter, true)

        if displacementIdx >= 2 and is_preferred_gold_continuation_zone(displacementIdx, false)
            global_zone_id_counter := global_zone_id_counter + 1
            createZone(displacementIdx, false, true, 1, 1, global_zone_id_counter, true)

isValidSwingForLiquidity(barOffset, isHigh) =>

    isTwoCandleSwingLow = low[barOffset - 1] < low[barOffset - 2] and low[barOffset - 1] < low[barOffset]
    isTwoCandleSwingHigh = high[barOffset - 1] > high[barOffset - 2] and high[barOffset - 1] > high[barOffset]

    isOneCandleSwingLow = low[barOffset - 1] < low[barOffset]
    isOneCandleSwingHigh = high[barOffset - 1] > high[barOffset]

    if isHigh
        liqHighValid = isTwoCandleSwingHigh or (useOneCandleLiquidity and isOneCandleSwingHigh)
        liqHighValid
    else
        liqLowValid = isTwoCandleSwingLow or (useOneCandleLiquidity and isOneCandleSwingLow)
        liqLowValid

validate_liquidity_formation(liqBarIdx, zoneCreatedBarIdx, liqPrice, isHigh) =>
    if liqBarIdx <= zoneCreatedBarIdx
        false
    else
        liqBarAge = liqBarIdx - zoneCreatedBarIdx
        is_new_fractal = (liqBarAge <= fractalsPeriod + 2)  // New fractal is close to current bar

        is_valid_swing = true  // Default to true for existing liquidity
        if is_new_fractal and fractalsPeriod >= 2  // Only check for new fractals with enough bars
            is_valid_swing := isValidSwingForLiquidity(fractalsPeriod, isHigh)

        if not is_valid_swing
            false  // Not a valid swing, reject
        else
            float prev_swing = na
            bars_to_check = math.min(liqBarIdx - zoneCreatedBarIdx + 10, 30)  // Look back reasonable amount

            for offset = fractalsPeriod to bars_to_check
                if isHigh
                    if isValidSwingForLiquidity(offset, true)
                        float swing_val = high[offset]
                        if na(prev_swing) or swing_val > prev_swing
                            prev_swing := swing_val
                else
                    if isValidSwingForLiquidity(offset, false)
                        float swing_val = low[offset]
                        if na(prev_swing) or swing_val < prev_swing
                            prev_swing := swing_val

            if not na(prev_swing)
                if isHigh
                    liqPrice > prev_swing + (pip_size * 2)
                else
                    liqPrice < prev_swing - (pip_size * 2)
            else
                true  // If no previous swing found, assume valid (first liquidity)

clearDemandLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(demandZones)
        Core.Zone z = array.get(demandZones, idx)
        if not na(z.connectorLine)
            line.delete(z.connectorLine)
            z.connectorLine := na
        if not na(z.inducementHLine)
            line.delete(z.inducementHLine)
            z.inducementHLine := na
        if not na(z.targetHLine)
            line.delete(z.targetHLine)
            z.targetHLine := na
        array.set(demandZones, idx, z)

updateDemandLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(demandZones)
        Core.Zone z = array.get(demandZones, idx)

        if show_liquidity_connectors
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)

            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                color indColor = z.liquiditySwept ? liq_swept_color : liq_active_color
                int lineEnd = z.liquiditySwept and not na(z.liquiditySweptBarIndex) ? z.liquiditySweptBarIndex : bar_index
                z.inducementHLine := line.new(x1 = z.liqLowBar, y1 = z.liqLowPrice,
                                               x2 = lineEnd, y2 = z.liqLowPrice,
                                               xloc = xloc.bar_index, extend = extend.none,
                                               color = indColor, style = line.style_dashed, width = liq_line_width_input)

            if not na(z.targetHLine)
                line.delete(z.targetHLine)

            if not na(z.liqHighPrice) and not na(z.liqHighBar)
                color tgtColor = z.targetSwept ? liq_swept_color : liq_active_color
                int lineEnd = z.targetSwept and not na(z.targetSweptBarIndex) ? z.targetSweptBarIndex : bar_index
                z.targetHLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice,
                                           x2 = lineEnd, y2 = z.liqHighPrice,
                                           xloc = xloc.bar_index, extend = extend.none,
                                           color = tgtColor, style = line.style_dotted, width = liq_line_width_input)
        else
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na

        if na(z.liquidityPrice) or na(z.liquidityBarIndex) or na(z.createdBarIndex) or not show_liquidity_connectors
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na
        else
            float mid = (z.top + z.bottom) / 2.0
            if not na(z.connectorLine)
                line.delete(z.connectorLine)

            lineStyle = z.liquiditySwept ? line.style_solid : line.style_dotted
            lineWidth = z.liquiditySwept ? 2 : 1
            z.connectorLine := line.new(x1 = z.createdBarIndex, y1 = mid, x2 = z.liquidityBarIndex, y2 = z.liquidityPrice,
                                  xloc = xloc.bar_index, extend = extend.none,
                                  color = liq_line_color, style = lineStyle, width = lineWidth)
        array.set(demandZones, idx, z)
        true

clearSupplyLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(supplyZones)
        Core.Zone z = array.get(supplyZones, idx)
        if not na(z.connectorLine)
            line.delete(z.connectorLine)
            z.connectorLine := na
        if not na(z.targetLine)
            line.delete(z.targetLine)
            z.targetLine := na
        if not na(z.inducementHLine)
            line.delete(z.inducementHLine)
            z.inducementHLine := na
        if not na(z.targetHLine)
            line.delete(z.targetHLine)
            z.targetHLine := na
        array.set(supplyZones, idx, z)

updateSupplyLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(supplyZones)
        Core.Zone z = array.get(supplyZones, idx)

        if show_liquidity_connectors
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)

            if not na(z.liqHighPrice) and not na(z.liqHighBar)
                color indColor = z.liquiditySwept ? liq_swept_color : liq_active_color
                int lineEnd = z.liquiditySwept and not na(z.liquiditySweptBarIndex) ? z.liquiditySweptBarIndex : bar_index
                z.inducementHLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice,
                                               x2 = lineEnd, y2 = z.liqHighPrice,
                                               xloc = xloc.bar_index, extend = extend.none,
                                               color = indColor, style = line.style_dashed, width = liq_line_width_input)

            if not na(z.targetHLine)
                line.delete(z.targetHLine)

            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                color tgtColor = z.targetSwept ? liq_swept_color : liq_active_color
                int lineEnd = z.targetSwept and not na(z.targetSweptBarIndex) ? z.targetSweptBarIndex : bar_index
                z.targetHLine := line.new(x1 = z.liqLowBar, y1 = z.liqLowPrice,
                                           x2 = lineEnd, y2 = z.liqLowPrice,
                                           xloc = xloc.bar_index, extend = extend.none,
                                           color = tgtColor, style = line.style_dotted, width = liq_line_width_input)
        else
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na

        if na(z.liqHighPrice) or na(z.liqHighBar) or na(z.createdBarIndex) or not show_liquidity_connectors
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na
            if not na(z.targetLine)
                line.delete(z.targetLine)
                z.targetLine := na
        else
            float zBottom = z.bottom

            if not na(z.connectorLine)
                line.delete(z.connectorLine)

            indStyle = z.liquiditySwept ? line.style_dashed : line.style_dotted
            indWidth = z.liquiditySwept ? 2 : 1
            z.connectorLine := line.new(x1 = z.createdBarIndex, y1 = zBottom, x2 = z.liqHighBar, y2 = z.liqHighPrice,
                                  xloc = xloc.bar_index, extend = extend.none,
                                  color = liq_line_color, style = indStyle, width = indWidth)

            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                if not na(z.targetLine)
                    line.delete(z.targetLine)

                targetColor = color.new(color.gray, 25)
                targetStyle = line.style_solid
                targetWidth = z.targetSwept ? 2 : 1
                z.targetLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice, x2 = z.liqLowBar, y2 = z.liqLowPrice,
                                      xloc = xloc.bar_index, extend = extend.none,
                                      color = targetColor, style = targetStyle, width = targetWidth)
        array.set(supplyZones, idx, z)
        true

isLiquidityValidForEntry(isDemand, idx) =>
    if idx < 0
        false
    else
        float zHigh = na
        float zLow  = na
        int   zCreatedBar = na
        float liqLevel = na
        int   liqBar   = na
        int   oppCount = 0
        bool  zoneCausedSweep = false
        string liqSource = ""

        if isDemand
            if idx >= array.size(demandZones)
                false
            else
                Core.Zone z = array.get(demandZones, idx)
                zHigh := z.top
                zLow  := z.bottom
                zCreatedBar := z.createdBarIndex
                liqLevel := z.liquidityPrice
                liqBar   := z.liquidityBarIndex
                oppCount := z.liquidityCandleCount
                zoneCausedSweep := z.causedSweep
                liqSource := z.liqSource
        else
            if idx >= array.size(supplyZones)
                false
            else
                Core.Zone z = array.get(supplyZones, idx)
                zHigh := z.top
                zLow  := z.bottom
                zCreatedBar := z.createdBarIndex
                liqLevel := z.liquidityPrice
                liqBar   := z.liquidityBarIndex
                oppCount := z.liquidityCandleCount
                zoneCausedSweep := z.causedSweep
                liqSource := z.liqSource

        bool geomOk = false
        float dist_pips = na
        float sideTol = syminfo.mintick * liq_side_tol_ticks

        if liqSource == TOUCH_SWEEP_SOURCE
            float maxDistPrice = effective_liq_max_dist * pip_size
            if isDemand
                geomOk := not na(liqLevel) and liqLevel >= (zLow - sideTol) and liqLevel <= (zHigh + maxDistPrice)
                dist_pips := math.max(0.0, zLow - liqLevel) / pip_size
            else
                geomOk := not na(liqLevel) and liqLevel <= (zHigh + sideTol) and liqLevel >= (zLow - maxDistPrice)
                dist_pips := math.max(0.0, liqLevel - zHigh) / pip_size
        else if isDemand
            if use_inducement_linking
                geomOk := not na(liqLevel) and liqLevel >= (zHigh - sideTol)
                dist_pips := (liqLevel - zHigh) / pip_size
            else
                geomOk := not na(liqLevel) and liqLevel <= (zLow + sideTol)
                dist_pips := (zLow - liqLevel) / pip_size
        else
            if use_inducement_linking
                geomOk := not na(liqLevel) and liqLevel <= (zLow + sideTol)
                dist_pips := (zLow - liqLevel) / pip_size
            else
                geomOk := not na(liqLevel) and liqLevel >= (zHigh - sideTol)
                dist_pips := (liqLevel - zHigh) / pip_size

        if not geomOk
            false
        else
            bool timingOk = not na(zCreatedBar) and not na(liqBar) and liqBar > zCreatedBar
            if not timingOk
                false
            else
                int minCandles = useOneCandleLiquidity ? 1 : 2
                bool candlesOk = oppCount >= minCandles

                if not candlesOk
                    false
                else
                    zoneCausedSweep

isValidEntry(isDemand, idx) =>
    [canEnter, reason, z] = validate_entry_conditions(isDemand, idx)


    if canEnter and enable_grade_filter

        int minGradeVal = Core.get_grade_value(min_entry_grade)
        int zoneGradeVal = Core.get_grade_value(z.grade)

        if zoneGradeVal < minGradeVal
            canEnter := false
            reason := "Grade too low (" + z.grade + " < " + min_entry_grade + ")"

    if canEnter
        float bodySize = math.abs(close - open)
        float candleRange = high - low
        float lowerWick = math.min(open, close) - low
        float upperWick = high - math.max(open, close)

        bool isHammer = lowerWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3

        bool isInvertedHammer = upperWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3

        // Direction check removed from pre-priming validation.
        // The priming system handles this: touch primes the zone, then the NEXT bar(s)
        // must show a directional close (DIR_CLOSE / FLIP / BREAK_CANDLE) to trigger entry.
        // This allows setups where price wicks into zone on a bullish candle (for supply)
        // and then the next candle closes bearish — which is a valid and common pattern.

    if canEnter

        lastEntryBar = isDemand ? array.get(_last_global_long_entry_bar, 0) : array.get(_last_global_short_entry_bar, 0)
        bool noEntryThisBar = na(lastEntryBar) or bar_index > lastEntryBar
        if not noEntryThisBar
            canEnter := false
            reason := isDemand ? "Long entry already taken this bar" : "Short entry already taken this bar"

    if canEnter and strategy.position_size != 0
        canEnter := false
        reason := "Existing position open (no stacking)"

    [canEnter, reason]

isValidDemandEntry(idx) => isValidEntry(true, idx)
isValidSupplyEntry(idx) => isValidEntry(false, idx)

int global_swing_lookback = math.min(liq_link_lookback_bars, liq_fallback_lookback)
float global_swing_low = ta.lowest(low, global_swing_lookback)
int global_swing_low_bar = bar_index - ta.lowestbars(low, global_swing_lookback)
float global_swing_high = ta.highest(high, global_swing_lookback)
int global_swing_high_bar = bar_index - ta.highestbars(high, global_swing_lookback)

if cached_demand_size > 0 and barstate.isconfirmed
    current_close = close
    current_open = open

    for i = 0 to cached_demand_size - 1
        if i >= array.size(demandZones)
            break
        Core.Zone z = array.get(demandZones, i)
        if z.active
            if not na(z.liquidityPrice) and z.liqSource != TOUCH_SWEEP_SOURCE
                float sideTol = syminfo.mintick * liq_side_tol_ticks
                bool isInvalid = false

                if use_inducement_linking
                    if z.liquidityPrice < (z.top - sideTol)
                        isInvalid := true
                else
                    if z.liquidityPrice > (z.bottom + sideTol)
                        isInvalid := true

                if isInvalid
                    z.liquidityPrice := na
                    z.liquidityBarIndex := na
                    z.liquiditySwept := false
                    z.liquiditySweptBarIndex := na
                    z.causedSweep := false
                    z.structureSweepLevel := na
                    z.structureSweepLevelBar := na
                    z.liquidityValid := false
                    z.inactiveReason := "LIQ_WRONG_SIDE"
                    z.liquidityCandleCount := 0
                    clearDemandLiquidityVisual(i)
                    array.set(demandZones, i, z)

            bool isFutureLiqDemand = z.liquidityValid and not na(z.liquidityBarIndex) and z.liquidityBarIndex > bar_index

            if isFutureLiqDemand
                z.liquidityValid := false
                z.liquidityPrice := na
                z.liquidityBarIndex := na
                z.liqLowPrice := na
                z.liqHighPrice := na
                z.structureSweepLevel := na
                z.inactiveReason := "Ghost Data Cleared"
                array.set(demandZones, i, z)

            bool hasTouchSweepLiq = z.liqSource == TOUCH_SWEEP_SOURCE and not na(z.liquidityPrice)
            if not z.liquidityValid and not hasTouchSweepLiq
                f_scan_demand_liquidity(i)

            f_check_demand_sweeps(i)

            updateDemandLiquidityVisual(i)
            z := array.get(demandZones, i)

            if current_close > z.top and not z.leftZone
                recordDiag(301, true, bar_index - z.createdBarIndex, "left zone not marked")
                z.leftZone := true
                z.leftWithBearish := current_close < current_open
                array.set(demandZones, i, z)
                db_updateZoneLiquidity(z)

            if not z.mitigated
                bool is_future_bar = not na(z.createdBarIndex) and bar_index > z.createdBarIndex

                bool closes_inside = close <= z.top and close >= z.bottom

                bool breaches_zone = low < z.bottom

                bool wicks_into_zone = low <= z.top and low >= z.bottom

                bool current_bar_sweeping = not na(z.structureSweepLevel) and high > z.structureSweepLevel

                if is_future_bar and z.leftZone and (closes_inside or wicks_into_zone or breaches_zone)
                    int touchBarNow = bar_index
                    z.lastTouchBar := touchBarNow
                    z.wasTouched := true

                    if use_zone_touch_sweep_liq and z.liqSource != TOUCH_SWEEP_SOURCE and (closes_inside or wicks_into_zone)
                        [touchLiqPrice, touchLiqBar] = findDemandTouchLiquidity(z)
                        if not na(touchLiqPrice) and not na(touchLiqBar)
                            z.liqSource := TOUCH_SWEEP_SOURCE
                            z.liquidityPrice := touchLiqPrice
                            z.liquidityBarIndex := touchLiqBar
                            z.liqLowPrice := touchLiqPrice
                            z.liqLowBar := touchLiqBar
                            int targetBar = getBarOfMaxHigh(z.createdBarIndex, bar_index - 1)
                            int targetOff = bar_index - targetBar
                            z.liqHighBar := targetBar
                            z.liqHighPrice := targetOff >= 0 ? high[targetOff] : na
                            z.structureSweepLevel := touchLiqPrice
                            z.structureSweepLevelBar := touchLiqBar
                            z.liquidityValid := true
                            z.liquiditySwept := true
                            z.liquiditySweptBarIndex := bar_index
                            z.causedSweep := true
                            z.liquidityCandleCount := 1
                            z.legCandleCount := 1
                            z.inactiveReason := na
                            clearDemandLiquidityVisual(i)
                            array.set(demandZones, i, z)
                            db_updateZoneLiquidity(z)

                    // Incremental peak update: just check current bar vs stored peak (O(1) instead of O(N))
                    if na(z.peakPrice) or high > z.peakPrice
                        z.peakPrice := high
                        z.peakBarIndex := bar_index
                        array.set(demandZones, i, z)
                        db_updateZoneLiquidity(z)

                    bool is_liq_bar = false
                    if not na(z.liquidityBarIndex) and touchBarNow == z.liquidityBarIndex
                        is_liq_bar := true
                    else if not na(z.liqLowBar) and touchBarNow == z.liqLowBar
                        is_liq_bar := true
                    else if not na(z.liqHighBar) and touchBarNow == z.liqHighBar
                        is_liq_bar := true

                    int liq_anchor_bar = na
                    if not na(z.liquidityBarIndex)
                        liq_anchor_bar := z.liquidityBarIndex
                    else if not na(z.liqLowBar)
                        liq_anchor_bar := z.liqLowBar
                    else if not na(z.liqHighBar)
                        liq_anchor_bar := z.liqHighBar

                    bool delayed_retouch = not na(liq_anchor_bar) and (touchBarNow - liq_anchor_bar >= 4)

                    if (is_liq_bar or delayed_retouch) and not z.liquiditySwept
                        z.touchedPreSweep := true

                if is_future_bar and z.leftZone and (closes_inside or breaches_zone) and not current_bar_sweeping and not z.liquiditySwept
                    z.mitigated := true
                    z.lastTouchBar := bar_index
                    array.set(demandZones, i, z)
                    db_updateZoneLiquidity(z)

if cached_supply_size > 0 and barstate.isconfirmed
    current_close = close
    current_open = open
    current_low = low

    for i = 0 to cached_supply_size - 1
        if i >= array.size(supplyZones)
            break
        Core.Zone z = array.get(supplyZones, i)
        if z.active
            if not na(z.liquidityPrice) and z.liqSource != TOUCH_SWEEP_SOURCE
                float sideTol = syminfo.mintick * liq_side_tol_ticks
                bool isInvalid = false

                if use_inducement_linking
                    if z.liquidityPrice > (z.bottom + sideTol)
                        isInvalid := true
                else
                    if z.liquidityPrice < (z.top - sideTol)
                        isInvalid := true

                if isInvalid
                    z.liquidityPrice := na
                    z.liquidityBarIndex := na
                    z.liquiditySwept := false
                    z.liquiditySweptBarIndex := na
                    z.causedSweep := false
                    z.structureSweepLevel := na
                    z.structureSweepLevelBar := na
                    z.liquidityCandleCount := 0
                    z.liquidityValid := false
                    z.inactiveReason := "LIQ_WRONG_SIDE"
                    clearSupplyLiquidityVisual(i)
                    array.set(supplyZones, i, z)

            bool isFutureLiqSupply = z.liquidityValid and not na(z.liquidityBarIndex) and z.liquidityBarIndex > bar_index

            if isFutureLiqSupply
                z.liquidityValid := false
                z.liquidityPrice := na
                z.liquidityBarIndex := na
                z.liqLowPrice := na
                z.liqHighPrice := na
                z.structureSweepLevel := na
                z.inactiveReason := "Ghost Data Cleared"
                array.set(supplyZones, i, z)

            bool hasTouchSweepLiq = z.liqSource == TOUCH_SWEEP_SOURCE and not na(z.liquidityPrice)
            if not z.liquidityValid and not hasTouchSweepLiq
                f_scan_supply_liquidity(i)

            f_check_supply_sweeps(i)

            updateSupplyLiquidityVisual(i)
            z := array.get(supplyZones, i)

            if current_close < z.bottom and not z.leftZone
                recordDiag(301, false, bar_index - z.createdBarIndex, "left zone not marked")
                z.leftZone := true
                array.set(supplyZones, i, z)
                db_updateZoneLiquidity(z)

            if not z.mitigated
                bool is_future_bar = not na(z.createdBarIndex) and bar_index > z.createdBarIndex

                bool closes_inside = close >= z.bottom and close <= z.top

                bool breaches_zone = high > z.top

                bool wicks_into_zone = high >= z.bottom and high <= z.top

                bool current_bar_sweeping = not na(z.structureSweepLevel) and low < z.structureSweepLevel

                if is_future_bar and z.leftZone and (closes_inside or wicks_into_zone or breaches_zone)
                    z.lastTouchBar := bar_index
                    z.wasTouched := true
                    if not z.liquiditySwept
                        z.touchedPreSweep := true

                    if use_zone_touch_sweep_liq and z.liqSource != TOUCH_SWEEP_SOURCE and (closes_inside or wicks_into_zone)
                        [touchLiqPrice, touchLiqBar] = findSupplyTouchLiquidity(z)
                        if not na(touchLiqPrice) and not na(touchLiqBar)
                            z.liqSource := TOUCH_SWEEP_SOURCE
                            z.liquidityPrice := touchLiqPrice
                            z.liquidityBarIndex := touchLiqBar
                            z.liqHighPrice := touchLiqPrice
                            z.liqHighBar := touchLiqBar
                            int targetBar = getBarOfMinLow(z.createdBarIndex, bar_index - 1)
                            int targetOff = bar_index - targetBar
                            z.liqLowBar := targetBar
                            z.liqLowPrice := targetOff >= 0 ? low[targetOff] : na
                            z.structureSweepLevel := touchLiqPrice
                            z.structureSweepLevelBar := touchLiqBar
                            z.liquidityValid := true
                            z.liquiditySwept := true
                            z.liquiditySweptBarIndex := bar_index
                            z.causedSweep := true
                            z.liquidityCandleCount := 1
                            z.legCandleCount := 1
                            z.inactiveReason := na
                            clearSupplyLiquidityVisual(i)
                            array.set(supplyZones, i, z)
                            db_updateZoneLiquidity(z)

                    // Incremental peak update: just check current bar vs stored peak (O(1) instead of O(N))
                    if na(z.peakPrice) or low < z.peakPrice
                        z.peakPrice := low
                        z.peakBarIndex := bar_index
                        array.set(supplyZones, i, z)
                        db_updateZoneLiquidity(z)

                if is_future_bar and z.leftZone and (closes_inside or breaches_zone) and not current_bar_sweeping and not z.liquiditySwept
                    z.mitigated := true
                    z.lastTouchBar := bar_index
                    array.set(supplyZones, i, z)
                    db_updateZoneLiquidity(z)

int demandSize = array.size(demandZones)
if demandSize > 0
    current_close = close
    current_open  = open
    current_low   = low
    current_high  = high
    bool is_bearish_c  = current_close < current_open
    pip_buffer    = pip_size * 0.1

    demandSize := array.size(demandZones)
    if demandSize > 0
        for i = demandSize - 1 to 0
            if i >= demandSize
                break
            Core.Zone z = array.get(demandZones, i)
            if z.active
                bool visual_zone_leave = current_close > z.top + zone_departure_buffer_price
                if visual_zone_leave
                    record_visual_leave(z.id, bar_index)
                if visual_zone_leave and not z.leftZone
                    recordDiag(301, true, bar_index - z.createdBarIndex, "left zone not marked")
                    z.leftZone := true
                    z.leftWithBearish := current_close < current_open
                    array.set(demandZones, i, z)
                    db_updateZoneLiquidity(z)

                int visualLeaveBar = visual_leave_bar(z.id)
                bool isTooOld = not na(z.startTime) and (time - z.startTime) > (24 * 60 * 60 * 1000)

                bool close_below_zone = current_close < z.bottom
                bool wick_below_zone  = current_low < z.bottom
                bool close_inside_zone = current_close <= z.top and current_close >= z.bottom
                bool wick_mitigates_zone = z.isHistorical and z.leftZone and not z.mitigated and current_low <= z.top and current_high >= z.bottom
                bool visual_zone_touch = not na(visualLeaveBar) and bar_index > visualLeaveBar and current_low <= z.top and current_high >= z.bottom
                bool touch_sweep_now = z.liqSource == TOUCH_SWEEP_SOURCE and z.liquiditySwept and z.liquiditySweptBarIndex == bar_index
                bool returned_invalid_after_left = not touch_sweep_now and zone_failed_after_leave(z, true)
                bool returned_before_liq_sweep = require_liquidity_sweep and not touch_sweep_now and z.leftZone and (current_low <= z.top or z.mitigated) and (not z.liquidityValid or not z.liquiditySwept or na(z.liquiditySweptBarIndex) or bar_index <= z.liquiditySweptBarIndex)

                if visual_zone_touch
                    record_visual_stop(z.id, bar_index)

                if returned_before_liq_sweep or returned_invalid_after_left or close_below_zone or wick_below_zone or isTooOld
                    if returned_before_liq_sweep or returned_invalid_after_left
                        bool sameBarSweepOrder = not na(z.liquiditySweptBarIndex) and bar_index <= z.liquiditySweptBarIndex
                        recordDiag(sameBarSweepOrder ? 303 : 302, true, bar_index - z.createdBarIndex, sameBarSweepOrder ? "same bar sweep order" : "returned pre sweep")
                    else if close_below_zone
                        recordDiag(305, true, bar_index - z.createdBarIndex, "close invalidated")
                    else if wick_below_zone
                        recordDiag(304, true, bar_index - z.createdBarIndex, "wick invalidated")
                    else if isTooOld
                        recordDiag(306, true, bar_index - z.createdBarIndex, "expired too early")
                    remove_zone_all_arrays(true, i)
                else if wick_mitigates_zone
                    z.mitigated := true
                    z.lastTouchBar := bar_index
                    z.wasTouched := true
                    array.set(demandZones, i, z)
                    db_updateZoneLiquidity(z)

int supplySize = array.size(supplyZones)
if supplySize > 0
    current_close = close
    current_open  = open
    current_high  = high
    current_low   = low

    for i = supplySize - 1 to 0
        if i >= supplySize
            break
        Core.Zone z = array.get(supplyZones, i)
        if z.active
            bool visual_zone_leave = current_close < z.bottom - zone_departure_buffer_price
            if visual_zone_leave
                record_visual_leave(z.id, bar_index)
            if visual_zone_leave and not z.leftZone
                recordDiag(301, false, bar_index - z.createdBarIndex, "left zone not marked")
                z.leftZone := true
                array.set(supplyZones, i, z)
                db_updateZoneLiquidity(z)

            int visualLeaveBar = visual_leave_bar(z.id)
            bool isTooOld = not na(z.startTime) and (time - z.startTime) > (24 * 60 * 60 * 1000)

            bool close_above_zone = current_close > z.top
            bool wick_above_zone  = current_high > z.top
            bool close_inside_zone = current_close >= z.bottom and current_close <= z.top
            bool wick_mitigates_zone = z.isHistorical and z.leftZone and not z.mitigated and current_high >= z.bottom and current_low <= z.top
            bool visual_zone_touch = not na(visualLeaveBar) and bar_index > visualLeaveBar and current_high >= z.bottom and current_low <= z.top
            bool touch_sweep_now = z.liqSource == TOUCH_SWEEP_SOURCE and z.liquiditySwept and z.liquiditySweptBarIndex == bar_index
            bool returned_invalid_after_left = not touch_sweep_now and zone_failed_after_leave(z, false)
            bool returned_before_liq_sweep = require_liquidity_sweep and not touch_sweep_now and z.leftZone and (current_high >= z.bottom or z.mitigated) and (not z.liquidityValid or not z.liquiditySwept or na(z.liquiditySweptBarIndex) or bar_index <= z.liquiditySweptBarIndex)

            if visual_zone_touch
                record_visual_stop(z.id, bar_index)

            if returned_before_liq_sweep or returned_invalid_after_left or close_above_zone or wick_above_zone or isTooOld
                if returned_before_liq_sweep or returned_invalid_after_left
                    bool sameBarSweepOrder = not na(z.liquiditySweptBarIndex) and bar_index <= z.liquiditySweptBarIndex
                    recordDiag(sameBarSweepOrder ? 303 : 302, false, bar_index - z.createdBarIndex, sameBarSweepOrder ? "same bar sweep order" : "returned pre sweep")
                else if close_above_zone
                    recordDiag(305, false, bar_index - z.createdBarIndex, "close invalidated")
                else if wick_above_zone
                    recordDiag(304, false, bar_index - z.createdBarIndex, "wick invalidated")
                else if isTooOld
                    recordDiag(306, false, bar_index - z.createdBarIndex, "expired too early")
                remove_zone_all_arrays(false, i)
            else if wick_mitigates_zone
                z.mitigated := true
                z.lastTouchBar := bar_index
                z.wasTouched := true
                array.set(supplyZones, i, z)
                db_updateZoneLiquidity(z)

if show_zones and show_demand_zones and cached_demand_size > 0
    for i = cached_demand_size - 1 to 0
        if i >= array.size(demandZones)
            break
        Core.Zone z = array.get(demandZones, i)
        if z.active
            // Real-time liquidity lines extension
            updateDemandLiquidityVisual(i)
            if not na(z.createdBarIndex)
                int left_bar_index = z.createdBarIndex
                int right_bar_index = zone_visual_right(z)
                if not na(z.boxId)
                    box.set_right(z.boxId,right_bar_index)
                    if z.isAccuracy
                        box.set_bgcolor(z.boxId,col_acc_demand_bg)  // Blue for demand ACC
                        box.set_border_width(z.boxId,2)
                        box.set_border_color(z.boxId,col_acc_demand_border)
                    else
                        box.set_bgcolor(z.boxId,col_demand_bg)
                        box.set_border_width(z.boxId,1)
                        box.set_border_color(z.boxId,col_demand_border)

                    if not na(z.idLabel)
                        float lbl_mid = (z.top + z.bottom) / 2
                        label.set_x(z.idLabel, right_bar_index)
                        label.set_y(z.idLabel, lbl_mid)
                        string demandAccTag = z.isAccuracy ? "⭐ ACC " : ""
                        string demandCompact = demandAccTag + "D-" + str.tostring(z.id)
                        string demandDetailed = "Demand " + demandCompact
                        string demandMetrics = zone_label_show_metrics ? (" [" + z.grade + "|" + str.tostring(z.score, "#") + "]") : ""
                        string demandText = zone_label_style == "Detailed" ? (demandDetailed + demandMetrics) : demandCompact
                        label.set_text(z.idLabel, " " + demandText + " ")
                        label.set_style(z.idLabel, label.style_label_left)
                        label.set_textcolor(z.idLabel, color.white)
                        label.set_color(z.idLabel, z.isAccuracy ? col_acc_demand_lbl : col_demand_lbl)
                        label.set_size(z.idLabel, size.small)
                        label.set_textalign(z.idLabel, text.align_center)

if show_zones and show_supply_zones and cached_supply_size > 0
    for i = cached_supply_size - 1 to 0
        if i >= array.size(supplyZones)
            break
        Core.Zone z = array.get(supplyZones, i)
        if z.active
            // Real-time liquidity lines extension
            updateSupplyLiquidityVisual(i)
            if not na(z.createdBarIndex)
                int left_bar_index = z.createdBarIndex
                int right_bar_index = zone_visual_right(z)
                if not na(z.boxId)
                    box.set_right(z.boxId,right_bar_index)
                    if z.isAccuracy
                        box.set_bgcolor(z.boxId,col_acc_supply_bg)  // Purple for supply ACC
                        box.set_border_width(z.boxId,2)
                        box.set_border_color(z.boxId,col_acc_supply_border)
                    else
                        box.set_bgcolor(z.boxId,col_supply_bg)
                        box.set_border_width(z.boxId,1)
                        box.set_border_color(z.boxId,col_supply_border)

                    if not na(z.idLabel)
                        float lbl_mid = (z.top + z.bottom) / 2
                        label.set_x(z.idLabel, right_bar_index)
                        label.set_y(z.idLabel, lbl_mid)
                        string supplyAccTag = z.isAccuracy ? "⭐ ACC " : ""
                        string supplyCompact = supplyAccTag + "S-" + str.tostring(z.id)
                        string supplyDetailed = "Supply " + supplyCompact
                        string supplyMetrics = zone_label_show_metrics ? (" [" + z.grade + "|" + str.tostring(z.score, "#") + "]") : ""
                        string supplyText = zone_label_style == "Detailed" ? (supplyDetailed + supplyMetrics) : supplyCompact
                        label.set_text(z.idLabel, " " + supplyText + " ")
                        label.set_style(z.idLabel, label.style_label_left)
                        label.set_textcolor(z.idLabel, color.white)
                        label.set_color(z.idLabel, z.isAccuracy ? col_acc_supply_lbl : col_supply_lbl)
                        label.set_size(z.idLabel, size.small)
                        label.set_textalign(z.idLabel, text.align_center)



process_long_entries() =>
    if barstate.isconfirmed and cached_demand_size > 0 and allow_long_trades
        current_close = close
        current_open  = open
        current_low   = low
        is_bullish_close = current_close > current_open

        for i = 0 to cached_demand_size - 1
            if i >= array.size(demandZones)
                break
            Core.Zone z = array.get(demandZones, i)

            if z.active and not z.primed and not z.mitigated
                float touchTolerance = 0.0
                bool currentTouch = low <= (z.top + touchTolerance)

                if currentTouch
                    bool isContinuous = not na(z.lastTouchBar) and (bar_index - z.lastTouchBar) <= 1
                    if not isContinuous
                        z.touchCount := z.touchCount + 1

                    z.lastTouchBar := bar_index
                    z.wasTouched := true

                    // Incremental peak update (O(1) instead of O(N))
                    if na(z.peakPrice) or high > z.peakPrice
                        z.peakPrice := high
                        z.peakBarIndex := bar_index
                        array.set(demandZones, i, z)
                        db_updateZoneLiquidity(z)

                [can_enter, entryReason] = isValidDemandEntry(i)

                array.set(_stat_total_entry_checks, 0, array.get(_stat_total_entry_checks, 0) + 1)
                if not can_enter
                    if str.contains(entryReason, "timing")
                        array.set(_stat_entries_blocked_by_timing, 0, array.get(_stat_entries_blocked_by_timing, 0) + 1)
                    if str.contains(entryReason, "liquidity") or str.contains(entryReason, "Liq ")
                        array.set(_stat_entries_blocked_by_liquidity, 0, array.get(_stat_entries_blocked_by_liquidity, 0) + 1)

                if not can_enter and show_blocked_trade_labels and debug_level != "None" and isRecentBarForDebug()
                    label.new(bar_index, high + atr14 * 0.3,
                        text = "Blocked: " + entryReason,
                        style = label.style_label_down,
                        color = color.new(color.red, 20),
                        textcolor = color.white,
                        size = size.tiny)

                if can_enter
                    if currentTouch
                        z.primed := true
                        z.primedBar := bar_index
                        z.primedWickLevel := low  // Store wick level for flip SL
                        z.primedRefClose := close
                        z.primedRefHigh := high
                        z.primedRefLow := low
                        z.inactiveReason := "PRIMED - waiting for bullish close"

                        if z.liquiditySwept
                            z.score := z.score + 20  // Full bonus: liquidity was swept
                        else if not na(z.liqLowPrice)
                            z.score := z.score + 10  // Partial bonus: liquidity exists but not swept yet
                        z.score := math.min(z.score, 100)
                        z.grade := Core.get_grade_from_score(z.score)

                        float temp_liq_distance = Core.calculate_liquidity_distance(z.top, z.liqLowPrice, pip_size)
                        float temp_liq_spread = Core.calculate_liquidity_spread(z.liqHighPrice, z.liqLowPrice, pip_size)

                        if enable_v6_v7_features
                            z.liquidityDistance := temp_liq_distance
                            z.liquiditySpread := temp_liq_spread
                        else
                            z.liquidityDistance := 50.0
                            z.liquiditySpread := 50.0

            if z.active and z.primed
                string chosenModel = "NONE"

                bool basic_flip = close > open and close[1] < open[1]
                bool is_flip_time = is_htf_candle_open()
                bool is_flip = false
                if is_flip_time
                    is_flip := basic_flip

                float candleRange = high - low
                float bodySize = math.abs(close - open)
                float lowerWick = math.min(open, close) - low
                bool isHammer = candleRange > 0 ? (lowerWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3) : false

                bool is_dir_close = (close > open) or (isHammer and close > open)

                bool hasValidPrimedRef = not na(z.primedRefClose) and not na(z.primedRefHigh)
                bool is_break = false
                if hasValidPrimedRef and not is_flip
                    is_break := (open > z.primedRefClose or high > z.primedRefHigh) and close > open

                if is_flip
                    chosenModel := "FLIP"
                else if is_break
                    chosenModel := "BREAK_CANDLE"
                else if is_dir_close
                    chosenModel := "DIR_CLOSE"

                if chosenModel == "NONE"
                    continue  // No valid entry pattern yet, keep zone primed

                z.inactiveReason := "Model: " + chosenModel

                float entry_model_code = chosenModel == "FLIP" ? 1 : (chosenModel == "BREAK_CANDLE" ? 3 : 2)

                bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue

                float entry_price = current_close // + spread_adjustment

                float deepest_wick = na
                for j = 0 to 5
                    if high[j] >= z.bottom and low[j] <= z.top
                        if na(deepest_wick) or low[j] < deepest_wick
                            deepest_wick := low[j]

                if na(deepest_wick)
                    deepest_wick := current_low  // Fallback to current low

                float stop_loss_price = deepest_wick - (effective_sl_buffer * pip_size)

                float minGap_long = math.max(syminfo.mintick * 2, pip_size * 2.0)  // At least 2 pips
                if stop_loss_price >= entry_price - minGap_long
                    stop_loss_price := entry_price - minGap_long

                float pip_distance = entry_price - stop_loss_price

                if pip_distance <= 0
                    continue

                float sl_pips = pip_distance / pip_size

                float take_profit_price = na
                array.set(_trade_be_trigger_rr, 0, na)
                array.set(_trade_be_sl_pips, 0, na)
                array.set(_trade_be_moved, 0, false)

                float be_trigger_price_long = na
                float be_sl_price_long = na

                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_tp_ratio(syminfo.ticker, sl_pips)


                    if enable_double_tp
                        tp_r := tp_r * 2.0

                    if not na(tp_r)
                        take_profit_price := entry_price + (pip_distance * tp_r)

                    if move_be
                        array.set(_trade_be_trigger_rr, 0, be_trig)
                        array.set(_trade_be_sl_pips, 0, be_sl)
                        if not na(be_trig) and be_trig > 0
                            be_trigger_price_long := entry_price + (pip_distance * be_trig)
                            float be_sl_offset = (not na(be_sl) and be_sl > 0) ? be_sl * pip_size : 0.0
                            be_sl_price_long := entry_price + be_sl_offset

                float tp_distance_pips = na
                if not na(take_profit_price) and not na(entry_price)
                    tp_distance_pips := math.abs(take_profit_price - entry_price) / pip_size
                    if tp_distance_pips < effective_min_tp_dist
                        continue  // Skip this trade

                if is_jpy_pair and not is_usdjpy
                    [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                    if not usdjpy_success_check
                        if show_entry_labels
                            label.new(x = bar_index, y = high, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                                      style = label.style_label_down, color = color.new(color.orange, 0),
                                      textcolor = color.white, size = size.normal)
                        continue

                float balance  = account_size_usd
                float risk_pct = risk_per_trade_pct

                if use_half_risk_second_trade and array.get(_current_day_trades, 0) == 1 and max_trades_per_day == 2
                    risk_pct := risk_pct * 0.5

                [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_sl_fixed] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, false)

                stop_loss_price := pos_sl_fixed

                array.set(_last_pos_size_entry, 0, entry_price)
                array.set(_last_pos_size_sl, 0, stop_loss_price)
                array.set(_last_pos_size_balance, 0, balance)
                array.set(_last_pos_size_risk_pct, 0, risk_pct)
                array.set(_last_pos_size_sl_pips, 0, sl_pips)
                array.set(_last_pos_size_valid, 0, pos_is_valid)
                array.set(_last_pos_size_error, 0, pos_error_msg)
                array.set(_last_pos_size_dry_run, 0, dry_run_mode)

                if pos_is_valid
                    array.set(_last_pos_size_units, 0, pos_qty_units)
                    array.set(_last_pos_size_lots, 0, pos_qty_lots)
                    if is_jpy_pair
                        [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                        if usdjpy_track_success_result
                            array.set(_last_pos_size_usdjpy_rate, 0, usdjpy_track_rate_result)
                        else
                            array.set(_last_pos_size_usdjpy_rate, 0, na)
                else
                    array.set(_last_pos_size_units, 0, na)
                    array.set(_last_pos_size_lots, 0, na)
                    array.set(_last_pos_size_usdjpy_rate, 0, na)
                    if show_entry_labels
                        label.new(x = bar_index, y = high, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                                  style = label.style_label_down, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.normal)

                if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                    [isEntryPermitted, entryPermitReason] = isValidDemandEntry(i)

                    if not isEntryPermitted
                        continue  // Skip this entry if not permitted

                    array.set(_entryTriggeredThisBar, 0, true)

                    array.set(_plot_id, 0, z.id)
                    array.set(_plot_type, 0, 1) // Demand
                    array.set(_plot_entry_model, 0, entry_model_code) // Actual detected model (1=Flip, 2=DirClose, 3=BoC)
                    array.set(_plot_score, 0, z.score)
                    array.set(_plot_freshness, 0, z.touchCount <= 1 ? 1 : 0)
                    array.set(_plot_session, 0, feature_session)
                    array.set(_plot_atr_ratio, 0, (z.top - z.bottom) / atr14)
                    array.set(_plot_is_accuracy, 0, z.isAccuracy ? 1 : 0)
                    array.set(_plot_trend, 0, feature_trend)
                    array.set(_plot_rsi, 0, feature_rsi)
                    array.set(_plot_htf_trend, 0, feature_htf_trend)
                    array.set(_plot_rvol, 0, feature_rvol)
                    array.set(_plot_adx, 0, feature_adx)
                    array.set(_plot_touch_count, 0, z.touchCount)
                    array.set(_plot_base_quality, 0, z.baseQuality)
                    array.set(_plot_departure_strength, 0, z.departureStrength)
                    array.set(_plot_liquidity_distance, 0, z.liquidityDistance)
                    array.set(_plot_liquidity_spread, 0, z.liquiditySpread)

                    array.set(_triggeredZoneId, 0, z.id)

                    float webhook_lots = Utils.units_to_lots(pos_qty_units, syminfo.ticker)
                    float webhook_tp = na(take_profit_price) ? entry_price + (math.abs(entry_price - stop_loss_price) * 2) : take_profit_price
                    float webhook_rr = math.abs(webhook_tp - entry_price) / math.abs(entry_price - stop_loss_price)
                    float zone_atr_ratio = (z.top - z.bottom) / atr14

                    bool guardian_liq_sweep = Utils.detect_liquidity_sweep(high, low, lookback_high_10, lookback_low_10, true)
                    string guardian_arrival = Utils.assess_arrival_type(avg_body_size_3, atr14)
                    bool guardian_structure_break = Utils.detect_structure_break(close, structure_high_20[1], true)

                    float f_liq_dist_pips = getLiquidityDistance(z, false)
                    float f_liq_spread_pips = na(z.liqHighPrice) or na(z.liqLowPrice) ? na : math.abs(z.liqHighPrice - z.liqLowPrice) / pip_size

                    // Middle zone: another valid demand zone exists below this one
                    bool is_middle_zone_long = false
                    for _mz_i = 0 to array.size(demandZones) - 1
                        Core.Zone _mz_other = array.get(demandZones, _mz_i)
                        if _mz_other.id != z.id and _mz_other.top < z.bottom
                            is_middle_zone_long := true
                            break

                    string webhook_payload = enable_webhook_alerts ? Utils.build_webhook_payload(
                        syminfo.ticker,
                        "buy",
                        entry_price,
                        stop_loss_price,
                        webhook_tp,
                        webhook_lots,
                        z.id,                    // zone_id
                        "demand",                // zone_type
                        z.top,                   // zone_top
                        z.bottom,                // zone_bottom
                        webhook_rr,              // rr_ratio
                        sl_pips,                 // sl_pips
                        chosenModel,             // entry_model
                        z.liquiditySwept,        // liq_swept
                        z.targetSwept,           // target_swept
                        z.causedSweep,           // caused_sweep
                        z.isAccuracy,            // is_accuracy
                        z.score,                 // score
                        z.touchCount,            // freshness
                        feature_session,         // session
                        zone_atr_ratio,          // atr_ratio
                        feature_trend,           // trend
                        feature_rsi,             // rsi
                        feature_htf_trend,       // htf_trend
                        feature_rvol,            // rvol
                        feature_adx,             // adx
                        z.touchCount,            // touch_count
                        z.baseQuality,           // base_quality
                        z.departureStrength,     // departure_strength
                        z.liquidityDistance,     // liquidity_distance
                        z.liquiditySpread,       // liquidity_spread
                        pip_size,
                        webhook_include_zone_id,
                        guardian_liq_sweep,      //流动性_sweep
                        guardian_arrival,        // arrival_type
                        guardian_structure_break, // market_structure_break
                        account_size_usd,         // _account_balance (Corrected)
                        risk_per_trade_pct,       // _risk_percent
                        f_liq_dist_pips,         // liq_distance_pips
                        f_liq_spread_pips,       // liq_spread_pips
                        time_close,              // current_time (bar close = signal fires at bar close)
                        be_trigger_price_long,   // be_trigger_price
                        be_sl_price_long,        // be_sl_price
                        z.legCandleCount,        // leg_candle_count
                        z.liquidityCandleCount,  // liq_candle_count
                        is_middle_zone_long,     // is_middle_zone
                        z.primed,                // primed
                        not na(z.liquiditySweptBarIndex) and not na(z.lastTouchBar) and z.lastTouchBar >= z.liquiditySweptBarIndex ? z.lastTouchBar - z.liquiditySweptBarIndex : na, // sweep_to_touch_bars
                        not na(z.peakBarIndex) and not na(z.lastTouchBar) and z.lastTouchBar >= z.peakBarIndex ? z.lastTouchBar - z.peakBarIndex : na,                             // peak_to_touch_bars
                        z.liqSource,             // liq_source
                        z.grade,                 // zone_grade
                        bar_index - z.createdBarIndex // bars_since_zone
                    ) : ""

                    if dry_run_mode
                        int dummy_var = 0  // Dummy statement to prevent empty block error
                    else
                        string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                        string entryComment = show_entry_labels ? "" : typeTag

                        if enable_webhook_alerts
                            strategy.entry("Long", strategy.long, qty = pos_qty_units, comment = entryComment, alert_message = webhook_payload)
                            alert(webhook_payload, alert.freq_once_per_bar)
                        else
                            strategy.entry("Long", strategy.long, qty = pos_qty_units, comment = entryComment)

                    if not na(take_profit_price) and take_profit_price > 0
                        strategy.exit("Long Exit", "Long", stop = stop_loss_price, limit = take_profit_price, comment_loss = "SL", comment_profit = "TP")
                    else
                        strategy.exit("Long Exit", "Long", stop = stop_loss_price, comment_loss = "SL")

                    if not dry_run_mode
                        array.set(_active_entry_id, 0, "Long")
                        array.set(_trade_entry_price, 0, entry_price)
                        array.set(_trade_original_sl, 0, stop_loss_price)
                        array.set(_trade_entry_grade, 0, z.grade)
                        array.set(_trade_current_sl, 0, stop_loss_price)
                        array.set(_trade_tp1_price, 0, take_profit_price)
                        array.set(_current_day_trades, 0, array.get(_current_day_trades, 0) + 1)

                        array.set(_trade_entry_bar_index, 0, bar_index)
                        array.set(_trade_worst_price, 0, close)  // Initialize with current price
                        array.set(_trade_zone_id, 0, z.id)
                        array.set(_trade_zone_score, 0, z.score)
                        array.set(_trade_zone_freshness, 0, z.touchCount)
                        array.set(_trade_session, 0, feature_session)
                        array.set(_trade_atr_ratio, 0, zone_atr_ratio)
                        array.set(_trade_trend, 0, feature_trend)
                        array.set(_trade_rsi, 0, feature_rsi)
                        array.set(_trade_htf_trend, 0, feature_htf_trend)
                        array.set(_trade_rvol, 0, feature_rvol)
                        array.set(_trade_adx, 0, feature_adx)
                        array.set(_trade_touch_count, 0, z.touchCount)
                        array.set(_trade_base_quality, 0, z.baseQuality)
                        array.set(_trade_departure_str, 0, z.departureStrength)
                        array.set(_trade_liq_distance, 0, z.liquidityDistance)
                        array.set(_trade_liq_spread, 0, z.liquiditySpread)
                        array.set(_trade_liq_swept, 0, z.liquiditySwept)
                        array.set(_trade_target_swept, 0, z.targetSwept)
                        array.set(_trade_caused_sweep, 0, z.causedSweep)
                        array.set(_trade_is_accuracy, 0, z.isAccuracy)
                        array.set(_trade_entry_model, 0, chosenModel)
                        array.set(_trade_zone_type, 0, "demand")

                    z.lastEntryBar := bar_index
                    z.active := false
                    z.primed := false  // Reset just in case
                    array.set(_last_global_long_entry_bar, 0, bar_index)

                    deactivateOverlappingDemandZones(z.top, z.bottom)

                    if show_entry_labels
                        float raw_sl_dist = math.abs(entry_price - stop_loss_price) / pip_size
                        float sl_dist_disp = is_index ? raw_sl_dist * 100 : raw_sl_dist
                        string label_text = "🟢 LONG"
                        label_text := label_text + "\nE: " + str.tostring(entry_price, format.mintick)
                        label_text := label_text + "\nSL: " + str.tostring(stop_loss_price, format.mintick) + " (" + str.tostring(sl_dist_disp, "#.#") + " pips)"

                        if not na(take_profit_price)
                            label_text := label_text + "\nTP: " + str.tostring(take_profit_price, format.mintick)
                        else
                            label_text := label_text + "\nTP: OPEN"

                        float y_long = low - (atr14 * long_label_offset_atr) - (syminfo.mintick * long_label_offset_ticks)
                        label.new(x = bar_index, y = y_long, text = label_text,
                                  style = label.style_label_up, color = color.new(color.green, 0),
                                  textcolor = color.white, size = size.small)

                break

process_long_entries()

process_short_entries() =>
    if barstate.isconfirmed and cached_supply_size > 0 and allow_short_trades
        current_close = close
        current_open  = open
        current_high  = high
        is_bearish_close = current_close < current_open

        for i = 0 to cached_supply_size - 1
            if i >= array.size(supplyZones)
                break
            Core.Zone z = array.get(supplyZones, i)

            if z.active and not z.primed and not z.mitigated
                float touchTolerance = 0.0
                bool currentTouch = high >= (z.bottom - touchTolerance)

                if currentTouch
                    bool isContinuous = not na(z.lastTouchBar) and (bar_index - z.lastTouchBar) <= 1
                    if not isContinuous
                        z.touchCount := z.touchCount + 1

                    z.lastTouchBar := bar_index
                    z.wasTouched := true

                    // Incremental peak update (O(1) instead of O(N))
                    if na(z.peakPrice) or low < z.peakPrice
                        z.peakPrice := low
                        z.peakBarIndex := bar_index
                        array.set(supplyZones, i, z)
                        db_updateZoneLiquidity(z)

                [can_enter, entryReason] = isValidSupplyEntry(i)

                array.set(_stat_total_entry_checks, 0, array.get(_stat_total_entry_checks, 0) + 1)
                if not can_enter
                    if str.contains(entryReason, "timing")
                        array.set(_stat_entries_blocked_by_timing, 0, array.get(_stat_entries_blocked_by_timing, 0) + 1)
                    if str.contains(entryReason, "liquidity") or str.contains(entryReason, "Liq ")
                        array.set(_stat_entries_blocked_by_liquidity, 0, array.get(_stat_entries_blocked_by_liquidity, 0) + 1)

                if not can_enter and show_blocked_trade_labels and debug_level != "None" and isRecentBarForDebug()
                    label.new(bar_index, low - atr14 * 0.3,
                        text = "Blocked: " + entryReason,
                        style = label.style_label_up,
                        color = color.new(color.red, 20),
                        textcolor = color.white,
                        size = size.tiny)

                if can_enter
                    if currentTouch
                        z.primed := true
                        z.primedBar := bar_index
                        z.primedWickLevel := high  // Store wick level for flip SL
                        z.primedRefClose := close
                        z.primedRefHigh := high
                        z.primedRefLow := low

                        if z.liquiditySwept
                            z.score := z.score + 20  // Full bonus: liquidity was swept
                        else if not na(z.liqHighPrice)
                            z.score := z.score + 10  // Partial bonus: liquidity exists but not swept yet
                        z.score := math.min(z.score, 100)
                        z.grade := Core.get_grade_from_score(z.score)
                        z.inactiveReason := "PRIMED - waiting for bearish close"

                        float temp_liq_distance = Core.calculate_liquidity_distance(z.bottom, z.liqHighPrice, pip_size)
                        float temp_liq_spread = Core.calculate_liquidity_spread(z.liqLowPrice, z.liqHighPrice, pip_size)

                        if enable_v6_v7_features
                            z.liquidityDistance := temp_liq_distance
                            z.liquiditySpread := temp_liq_spread
                        else
                            z.liquidityDistance := 50.0
                            z.liquiditySpread := 50.0

            if z.active and z.primed
                string chosenModel = "NONE"

                bool basic_flip = close < open and close[1] > open[1]
                bool is_flip_time = is_htf_candle_open()
                bool is_flip = false
                if is_flip_time
                    is_flip := basic_flip

                float candleRange = high - low
                float bodySize = math.abs(close - open)
                float upperWick = high - math.max(open, close)
                bool isInvertedHammer = candleRange > 0 ? (upperWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3) : false

                bool is_dir_close = (close < open) or (isInvertedHammer and close < open)

                bool hasValidPrimedRef = not na(z.primedRefClose) and not na(z.primedRefLow)
                bool is_break = false
                if hasValidPrimedRef and not is_flip
                    is_break := (open < z.primedRefClose or low < z.primedRefLow) and close < open

                if is_flip
                    chosenModel := "FLIP"
                else if is_break
                    chosenModel := "BREAK_CANDLE"
                else if is_dir_close
                    chosenModel := "DIR_CLOSE"

                if chosenModel == "NONE"
                    continue  // No valid entry pattern yet, keep zone primed

                z.inactiveReason := "Model: " + chosenModel

                float entry_model_code = chosenModel == "FLIP" ? 1 : (chosenModel == "BREAK_CANDLE" ? 3 : 2)

                bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue

                float entry_price = current_close // - spread_adjustment

                float highest_wick = na
                for j = 0 to 5
                    if low[j] <= z.top and high[j] >= z.bottom
                        if na(highest_wick) or high[j] > highest_wick
                            highest_wick := high[j]

                if na(highest_wick)
                    highest_wick := current_high  // Fallback to current high

                float stop_loss_price = highest_wick + (effective_sl_buffer * pip_size)

                float minGap_short = math.max(syminfo.mintick * 2, pip_size * 2.0)  // At least 2 pips
                if stop_loss_price <= entry_price + minGap_short
                    stop_loss_price := entry_price + minGap_short

                float pip_distance = stop_loss_price - entry_price

                if pip_distance <= 0
                    continue

                float sl_pips = pip_distance / pip_size

                float take_profit_price = na
                array.set(_trade_be_trigger_rr, 0, na)
                array.set(_trade_be_sl_pips, 0, na)
                array.set(_trade_be_moved, 0, false)

                float be_trigger_price_short = na
                float be_sl_price_short = na

                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_tp_ratio(syminfo.ticker, sl_pips)


                    if enable_double_tp
                        tp_r := tp_r * 2.0

                    if not na(tp_r)
                        take_profit_price := entry_price - (pip_distance * tp_r)

                    if move_be
                        array.set(_trade_be_trigger_rr, 0, be_trig)
                        array.set(_trade_be_sl_pips, 0, be_sl)
                        if not na(be_trig) and be_trig > 0
                            be_trigger_price_short := entry_price - (pip_distance * be_trig)
                            float be_sl_offset_s = (not na(be_sl) and be_sl > 0) ? be_sl * pip_size : 0.0
                            be_sl_price_short := entry_price - be_sl_offset_s

                float tp_distance_pips = na
                if not na(take_profit_price) and not na(entry_price)
                    tp_distance_pips := math.abs(take_profit_price - entry_price) / pip_size
                    if tp_distance_pips < effective_min_tp_dist
                        continue  // Skip this trade

                if is_jpy_pair and not is_usdjpy
                    [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                    if not usdjpy_success_check
                        if show_entry_labels
                            label.new(x = bar_index, y = low, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                                      style = label.style_label_up, color = color.new(color.orange, 0),
                                      textcolor = color.white, size = size.normal)
                        continue

                float balance  = account_size_usd
                float risk_pct = risk_per_trade_pct

                if use_half_risk_second_trade and array.get(_current_day_trades, 0) == 1 and max_trades_per_day == 2
                    risk_pct := risk_pct * 0.5

                [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_sl_fixed] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, true)

                stop_loss_price := pos_sl_fixed

                array.set(_last_pos_size_entry, 0, entry_price)
                array.set(_last_pos_size_sl, 0, stop_loss_price)
                array.set(_last_pos_size_balance, 0, balance)
                array.set(_last_pos_size_risk_pct, 0, risk_pct)
                array.set(_last_pos_size_sl_pips, 0, sl_pips)
                array.set(_last_pos_size_valid, 0, pos_is_valid)
                array.set(_last_pos_size_error, 0, pos_error_msg)
                array.set(_last_pos_size_dry_run, 0, dry_run_mode)

                if pos_is_valid
                    array.set(_last_pos_size_units, 0, pos_qty_units)
                    array.set(_last_pos_size_lots, 0, pos_qty_lots)
                    if is_jpy_pair
                        [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                        if usdjpy_track_success_result
                            array.set(_last_pos_size_usdjpy_rate, 0, usdjpy_track_rate_result)
                        else
                            array.set(_last_pos_size_usdjpy_rate, 0, na)
                else
                    array.set(_last_pos_size_units, 0, na)
                    array.set(_last_pos_size_lots, 0, na)
                    array.set(_last_pos_size_usdjpy_rate, 0, na)
                    if show_entry_labels
                        label.new(x = bar_index, y = low, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                                  style = label.style_label_up, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.normal)

                if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                    [isEntryPermitted, entryPermitReason] = isValidSupplyEntry(i)

                    if not isEntryPermitted
                        continue  // Skip this entry if not permitted

                    array.set(_entryTriggeredThisBar, 0, true)

                    array.set(_plot_id, 0, z.id)
                    array.set(_plot_type, 0, -1) // Supply
                    array.set(_plot_entry_model, 0, entry_model_code) // Actual detected model (1=Flip, 2=DirClose, 3=BoC)
                    array.set(_plot_score, 0, z.score)
                    array.set(_plot_freshness, 0, z.touchCount <= 1 ? 1 : 0)
                    array.set(_plot_session, 0, feature_session)
                    array.set(_plot_atr_ratio, 0, (z.top - z.bottom) / atr14)
                    array.set(_plot_is_accuracy, 0, z.isAccuracy ? 1 : 0)
                    array.set(_plot_trend, 0, feature_trend)
                    array.set(_plot_rsi, 0, feature_rsi)
                    array.set(_plot_htf_trend, 0, feature_htf_trend)
                    array.set(_plot_rvol, 0, feature_rvol)
                    array.set(_plot_adx, 0, feature_adx)
                    array.set(_plot_touch_count, 0, z.touchCount)
                    array.set(_plot_base_quality, 0, z.baseQuality)
                    array.set(_plot_departure_strength, 0, z.departureStrength)
                    array.set(_plot_liquidity_distance, 0, z.liquidityDistance)
                    array.set(_plot_liquidity_spread, 0, z.liquiditySpread)

                    array.set(_triggeredZoneId, 0, z.id)

                    float webhook_lots_short = Utils.units_to_lots(pos_qty_units, syminfo.ticker)
                    float webhook_tp_short = na(take_profit_price) ? entry_price - (math.abs(stop_loss_price - entry_price) * 2) : take_profit_price
                    float webhook_rr_short = math.abs(entry_price - webhook_tp_short) / math.abs(stop_loss_price - entry_price)
                    float zone_atr_ratio_short = (z.top - z.bottom) / atr14

                    bool guardian_liq_sweep_short = Utils.detect_liquidity_sweep(high, low, lookback_high_10, lookback_low_10, false)
                    string guardian_arrival_short = Utils.assess_arrival_type(avg_body_size_3, atr14)
                    bool guardian_structure_break_short = Utils.detect_structure_break(close, structure_low_20[1], false)

                    float f_liq_dist_pips_short = getLiquidityDistance(z, true)
                    float f_liq_spread_pips_short = na(z.liqLowPrice) or na(z.liqHighPrice) ? na : math.abs(z.liqLowPrice - z.liqHighPrice) / pip_size

                    // Middle zone: another valid supply zone exists above this one
                    bool is_middle_zone_short = false
                    for _mz_i = 0 to array.size(supplyZones) - 1
                        Core.Zone _mz_other = array.get(supplyZones, _mz_i)
                        if _mz_other.id != z.id and _mz_other.bottom > z.top
                            is_middle_zone_short := true
                            break

                    string webhook_payload_short = enable_webhook_alerts ? Utils.build_webhook_payload(
                        syminfo.ticker,
                        "sell",
                        entry_price,
                        stop_loss_price,
                        webhook_tp_short,
                        webhook_lots_short,
                        z.id,                    // zone_id
                        "supply",                // zone_type
                        z.top,                   // zone_top
                        z.bottom,                // zone_bottom
                        webhook_rr_short,        // rr_ratio
                        sl_pips,                 // sl_pips
                        chosenModel,             // entry_model
                        z.liquiditySwept,        // liq_swept
                        z.targetSwept,           // target_swept
                        z.causedSweep,           // caused_sweep
                        z.isAccuracy,            // is_accuracy
                        z.score,                 // score
                        z.touchCount,            // freshness
                        feature_session,         // session
                        zone_atr_ratio_short,    // atr_ratio
                        feature_trend,           // trend
                        feature_rsi,             // rsi
                        feature_htf_trend,       // htf_trend
                        feature_rvol,            // rvol
                        feature_adx,             // adx
                        z.touchCount,            // touch_count
                        z.baseQuality,           // base_quality
                        z.departureStrength,     // departure_strength
                        z.liquidityDistance,     // liquidity_distance
                        z.liquiditySpread,       // liquidity_spread
                        pip_size,
                        webhook_include_zone_id,
                        guardian_liq_sweep_short,      // liquidity_sweep
                        guardian_arrival_short,        // arrival_type
                        guardian_structure_break_short, // market_structure_break
                        account_size_usd,               // _account_balance (Corrected)
                        risk_per_trade_pct,             // _risk_percent
                        f_liq_dist_pips_short,         // liq_distance_pips
                        f_liq_spread_pips_short,       // liq_spread_pips
                        time_close,                    // current_time (bar close = signal fires at bar close)
                        be_trigger_price_short,        // be_trigger_price
                        be_sl_price_short,             // be_sl_price
                        z.legCandleCount,              // leg_candle_count
                        z.liquidityCandleCount,        // liq_candle_count
                        is_middle_zone_short,          // is_middle_zone
                        z.primed,                      // primed
                        not na(z.liquiditySweptBarIndex) and not na(z.lastTouchBar) and z.lastTouchBar >= z.liquiditySweptBarIndex ? z.lastTouchBar - z.liquiditySweptBarIndex : na, // sweep_to_touch_bars
                        not na(z.peakBarIndex) and not na(z.lastTouchBar) and z.lastTouchBar >= z.peakBarIndex ? z.lastTouchBar - z.peakBarIndex : na,                             // peak_to_touch_bars
                        z.liqSource,                   // liq_source
                        z.grade,                       // zone_grade
                        bar_index - z.createdBarIndex  // bars_since_zone
                    ) : ""

                    if dry_run_mode
                        int dummy_var = 0  // Dummy statement to prevent empty block error
                    else
                        string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                        string entryComment = show_entry_labels ? "" : typeTag

                        if enable_webhook_alerts
                            strategy.entry("Short", strategy.short, qty = pos_qty_units, comment = entryComment, alert_message = webhook_payload_short)
                            alert(webhook_payload_short, alert.freq_once_per_bar)
                        else
                            strategy.entry("Short", strategy.short, qty = pos_qty_units, comment = entryComment)

                    if not na(take_profit_price) and take_profit_price > 0
                        strategy.exit("Short Exit", "Short", stop = stop_loss_price, limit = take_profit_price, comment_loss = "SL", comment_profit = "TP")
                    else
                        strategy.exit("Short Exit", "Short", stop = stop_loss_price, comment_loss = "SL")

                    if not dry_run_mode
                        array.set(_active_entry_id, 0, "Short")
                        array.set(_trade_entry_price, 0, entry_price)
                        array.set(_trade_original_sl, 0, stop_loss_price)
                        array.set(_trade_entry_grade, 0, z.grade)
                        array.set(_trade_current_sl, 0, stop_loss_price)
                        array.set(_trade_tp1_price, 0, take_profit_price)
                        array.set(_current_day_trades, 0, array.get(_current_day_trades, 0) + 1)

                        array.set(_trade_entry_bar_index, 0, bar_index)
                        array.set(_trade_worst_price, 0, close)  // Initialize with current price
                        array.set(_trade_zone_id, 0, z.id)
                        array.set(_trade_zone_score, 0, z.score)
                        array.set(_trade_zone_freshness, 0, z.touchCount)
                        array.set(_trade_session, 0, feature_session)
                        array.set(_trade_atr_ratio, 0, zone_atr_ratio_short)
                        array.set(_trade_trend, 0, feature_trend)
                        array.set(_trade_rsi, 0, feature_rsi)
                        array.set(_trade_htf_trend, 0, feature_htf_trend)
                        array.set(_trade_rvol, 0, feature_rvol)
                        array.set(_trade_adx, 0, feature_adx)
                        array.set(_trade_touch_count, 0, z.touchCount)
                        array.set(_trade_base_quality, 0, z.baseQuality)
                        array.set(_trade_departure_str, 0, z.departureStrength)
                        array.set(_trade_liq_distance, 0, z.liquidityDistance)
                        array.set(_trade_liq_spread, 0, z.liquiditySpread)
                        array.set(_trade_liq_swept, 0, z.liquiditySwept)
                        array.set(_trade_target_swept, 0, z.targetSwept)
                        array.set(_trade_caused_sweep, 0, z.causedSweep)
                        array.set(_trade_is_accuracy, 0, z.isAccuracy)
                        array.set(_trade_entry_model, 0, chosenModel)
                        array.set(_trade_zone_type, 0, "supply")  // SUPPLY for shorts

                    z.lastEntryBar := bar_index
                    z.active := false
                    z.primed := false  // Reset just in case
                    array.set(_last_global_short_entry_bar, 0, bar_index)

                    deactivateOverlappingSupplyZones(z.top, z.bottom)

                    if show_entry_labels
                        float raw_sl_dist = math.abs(stop_loss_price - entry_price) / pip_size
                        float sl_dist_disp = is_index ? raw_sl_dist * 100 : raw_sl_dist
                        string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                        string label_text = "🔴 SHORT " + typeTag
                        label_text := label_text + "\nE: " + str.tostring(entry_price, format.mintick)
                        label_text := label_text + "\nSL: " + str.tostring(stop_loss_price, format.mintick) + " (" + str.tostring(sl_dist_disp, "#.#") + " pips)"

                        if not na(take_profit_price)
                            label_text := label_text + "\nTP: " + str.tostring(take_profit_price, format.mintick)
                        else
                            label_text := label_text + "\nTP: OPEN"

                        label.new(x = bar_index, y = high + (pip_size * 5), text = label_text,
                                  style = label.style_label_down, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.small)

                break

process_short_entries()

active_entry_id        := array.get(_active_entry_id, 0)
trade_entry_price      := array.get(_trade_entry_price, 0)
trade_original_sl      := array.get(_trade_original_sl, 0)
trade_current_sl       := array.get(_trade_current_sl, 0)
trade_tp1_price        := array.get(_trade_tp1_price, 0)
tp1_hit                := array.get(_tp1_hit, 0)
trade_be_trigger_rr    := array.get(_trade_be_trigger_rr, 0)
trade_be_sl_pips       := array.get(_trade_be_sl_pips, 0)
trade_be_moved         := array.get(_trade_be_moved, 0)
trade_entry_grade      := array.get(_trade_entry_grade, 0)
current_day_trades     := array.get(_current_day_trades, 0)
last_global_long_entry_bar  := array.get(_last_global_long_entry_bar, 0)
last_global_short_entry_bar := array.get(_last_global_short_entry_bar, 0)
entryTriggeredThisBar  := array.get(_entryTriggeredThisBar, 0)
triggeredZoneId        := array.get(_triggeredZoneId, 0)
plot_id               := array.get(_plot_id, 0)
plot_type             := array.get(_plot_type, 0)
plot_entry_model      := array.get(_plot_entry_model, 0)
plot_score            := array.get(_plot_score, 0)
plot_freshness        := array.get(_plot_freshness, 0)
plot_session          := array.get(_plot_session, 0)
plot_atr_ratio        := array.get(_plot_atr_ratio, 0)
plot_is_accuracy      := array.get(_plot_is_accuracy, 0)
plot_trend            := array.get(_plot_trend, 0)
plot_rsi              := array.get(_plot_rsi, 0)
plot_htf_trend        := array.get(_plot_htf_trend, 0)
plot_rvol             := array.get(_plot_rvol, 0)
plot_adx              := array.get(_plot_adx, 0)
plot_touch_count      := array.get(_plot_touch_count, 0)
plot_base_quality     := array.get(_plot_base_quality, 0)
plot_departure_strength := array.get(_plot_departure_strength, 0)
plot_liquidity_distance := array.get(_plot_liquidity_distance, 0)
plot_liquidity_spread := array.get(_plot_liquidity_spread, 0)
last_pos_size_units   := array.get(_last_pos_size_units, 0)
last_pos_size_lots    := array.get(_last_pos_size_lots, 0)
last_pos_size_entry   := array.get(_last_pos_size_entry, 0)
last_pos_size_sl      := array.get(_last_pos_size_sl, 0)
last_pos_size_balance := array.get(_last_pos_size_balance, 0)
last_pos_size_risk_pct := array.get(_last_pos_size_risk_pct, 0)
last_pos_size_sl_pips := array.get(_last_pos_size_sl_pips, 0)
last_pos_size_usdjpy_rate := array.get(_last_pos_size_usdjpy_rate, 0)
last_pos_size_valid   := array.get(_last_pos_size_valid, 0)
last_pos_size_error   := array.get(_last_pos_size_error, 0)
last_pos_size_dry_run := array.get(_last_pos_size_dry_run, 0)
stat_total_entry_checks           := array.get(_stat_total_entry_checks, 0)
stat_entries_blocked_by_timing    := array.get(_stat_entries_blocked_by_timing, 0)
stat_entries_blocked_by_liquidity := array.get(_stat_entries_blocked_by_liquidity, 0)
trade_entry_bar_index := array.get(_trade_entry_bar_index, 0)
trade_worst_price     := array.get(_trade_worst_price, 0)
trade_zone_id         := array.get(_trade_zone_id, 0)
trade_zone_score      := array.get(_trade_zone_score, 0)
trade_zone_freshness  := array.get(_trade_zone_freshness, 0)
trade_session         := array.get(_trade_session, 0)
trade_atr_ratio       := array.get(_trade_atr_ratio, 0)
trade_trend           := array.get(_trade_trend, 0)
trade_rsi             := array.get(_trade_rsi, 0)
trade_htf_trend       := array.get(_trade_htf_trend, 0)
trade_rvol            := array.get(_trade_rvol, 0)
trade_adx             := array.get(_trade_adx, 0)
trade_touch_count     := array.get(_trade_touch_count, 0)
trade_base_quality    := array.get(_trade_base_quality, 0)
trade_departure_str   := array.get(_trade_departure_str, 0)
trade_liq_distance    := array.get(_trade_liq_distance, 0)
trade_liq_spread      := array.get(_trade_liq_spread, 0)
trade_liq_swept       := array.get(_trade_liq_swept, 0)
trade_target_swept    := array.get(_trade_target_swept, 0)
trade_caused_sweep    := array.get(_trade_caused_sweep, 0)
trade_is_accuracy     := array.get(_trade_is_accuracy, 0)
trade_entry_model     := array.get(_trade_entry_model, 0)
trade_zone_type       := array.get(_trade_zone_type, 0)

if strategy.position_size != 0 and not na(active_entry_id) and not na(trade_current_sl) and trade_current_sl > 0
    bool sl_valid = false
    if strategy.position_size > 0  // Long position
        sl_valid := trade_current_sl > 0 and not na(trade_entry_price) and trade_current_sl < trade_entry_price
    else if strategy.position_size < 0  // Short position
        sl_valid := trade_current_sl > 0 and not na(trade_entry_price) and trade_current_sl > trade_entry_price

    if sl_valid
        if active_entry_id == "Long"
            if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                strategy.exit("Long Exit", "Long", stop = trade_current_sl, limit = trade_tp1_price, comment_loss = "SL", comment_profit = "TP")
            else
                strategy.exit("Long Exit", "Long", stop = trade_current_sl, comment_loss = "SL")
        else if active_entry_id == "Long Flip"
            if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                strategy.exit("Long Flip Exit", "Long Flip", stop = trade_current_sl, limit = trade_tp1_price, comment_loss = "SL", comment_profit = "TP")
            else
                strategy.exit("Long Flip Exit", "Long Flip", stop = trade_current_sl, comment_loss = "SL")
        else if active_entry_id == "Short"
            if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                strategy.exit("Short Exit", "Short", stop = trade_current_sl, limit = trade_tp1_price, comment_loss = "SL", comment_profit = "TP")
            else
                strategy.exit("Short Exit", "Short", stop = trade_current_sl, comment_loss = "SL")
        else if active_entry_id == "Short Flip"
            if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                strategy.exit("Short Flip Exit", "Short Flip", stop = trade_current_sl, limit = trade_tp1_price, comment_loss = "SL", comment_profit = "TP")
            else
                strategy.exit("Short Flip Exit", "Short Flip", stop = trade_current_sl, comment_loss = "SL")

if strategy.position_size != 0 and not na(trade_entry_price) and not na(trade_original_sl_pips) and not na(active_entry_id) and not trade_be_moved
    if not na(trade_be_trigger_rr) and trade_be_trigger_rr > 0
        float current_profit_pips = 0.0
        float current_profit_rr = 0.0

        if strategy.position_size > 0  // Long
            current_profit_pips := (close - trade_entry_price) / pip_size
        else if strategy.position_size < 0  // Short
            current_profit_pips := (trade_entry_price - close) / pip_size

        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0

        if current_profit_rr >= trade_be_trigger_rr
            float new_be_sl = na
            float profit_lock_pips = 0.0

            if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                profit_lock_pips := math.max(trade_original_sl_pips, trade_be_sl_pips)
            else
                profit_lock_pips := 0.0

            if strategy.position_size > 0  // Long
                new_be_sl := trade_entry_price + (profit_lock_pips * pip_size)
            else if strategy.position_size < 0  // Short
                new_be_sl := trade_entry_price - (profit_lock_pips * pip_size)

            if not na(new_be_sl) and new_be_sl > 0
                trade_current_sl := new_be_sl
                array.set(_trade_current_sl, 0, new_be_sl)
                trade_be_moved := true
                array.set(_trade_be_moved, 0, true)

                if active_entry_id == "Long"
                    if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                        strategy.exit("Long Exit", "Long", stop = new_be_sl, limit = trade_tp1_price, comment_loss = "BE", comment_profit = "TP")
                    else
                        strategy.exit("Long Exit", "Long", stop = new_be_sl, comment_loss = "BE")
                else if active_entry_id == "Long Flip"
                    if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                        strategy.exit("Long Flip Exit", "Long Flip", stop = new_be_sl, limit = trade_tp1_price, comment_loss = "BE", comment_profit = "TP")
                    else
                        strategy.exit("Long Flip Exit", "Long Flip", stop = new_be_sl, comment_loss = "BE")
                else if active_entry_id == "Short"
                    if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                        strategy.exit("Short Exit", "Short", stop = new_be_sl, limit = trade_tp1_price, comment_loss = "BE", comment_profit = "TP")
                    else
                        strategy.exit("Short Exit", "Short", stop = new_be_sl, comment_loss = "BE")
                else if active_entry_id == "Short Flip"
                    if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                        strategy.exit("Short Flip Exit", "Short Flip", stop = new_be_sl, limit = trade_tp1_price, comment_loss = "BE", comment_profit = "TP")
                    else
                        strategy.exit("Short Flip Exit", "Short Flip", stop = new_be_sl, comment_loss = "BE")

if strategy.position_size != 0 and not na(trade_tp1_price) and not tp1_hit
    bool tp_hit = false
    if strategy.position_size > 0  // Long
        tp_hit := close >= trade_tp1_price
    else if strategy.position_size < 0  // Short
        tp_hit := close <= trade_tp1_price

    if tp_hit
        tp1_hit := true
        array.set(_tp1_hit, 0, true)

        if false  // jpy_close_at_2r functionality removed
            if active_entry_id == "Long"
                strategy.close("Long", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Long Flip"
                strategy.close("Long Flip", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Short"
                strategy.close("Short", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Short Flip"
                strategy.close("Short Flip", comment = "Close at 1:2 (JPY Rule)")
        else
            if use_break_even and not na(trade_entry_price) and trade_entry_price > 0 and not na(active_entry_id)
                if active_entry_id == "Long"
                    strategy.exit("Long Exit", "Long", stop = trade_entry_price, comment_loss = "BE")
                else if active_entry_id == "Long Flip"
                    strategy.exit("Long Flip Exit", "Long Flip", stop = trade_entry_price, comment_loss = "BE")
                else if active_entry_id == "Short"
                    strategy.exit("Short Exit", "Short", stop = trade_entry_price, comment_loss = "BE")
                else if active_entry_id == "Short Flip"
                    strategy.exit("Short Flip Exit", "Short Flip", stop = trade_entry_price, comment_loss = "BE")

if strategy.position_size != 0 and use_stop_loss and not na(trade_entry_price) and not na(trade_original_sl) and not na(trade_original_sl_pips) and not na(active_entry_id)
    float risk_amount = 0.0
    float current_profit_pips = 0.0
    float current_profit_rr = 0.0

    if strategy.position_size > 0  // Long
        risk_amount := trade_entry_price - trade_original_sl
        current_profit_pips := (close - trade_entry_price) / pip_size
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0
    else if strategy.position_size < 0  // Short
        risk_amount := trade_original_sl - trade_entry_price
        current_profit_pips := (trade_entry_price - close) / pip_size
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0

    if current_profit_rr >= 10.0
        if active_entry_id == "Long"
            strategy.close("Long", comment = "Hard Close at 1:10")
        else if active_entry_id == "Long Flip"
            strategy.close("Long Flip", comment = "Hard Close at 1:10")
        else if active_entry_id == "Short"
            strategy.close("Short", comment = "Hard Close at 1:10")
        else if active_entry_id == "Short Flip"
            strategy.close("Short Flip", comment = "Hard Close at 1:10")

    float new_sl = na
    bool should_update_sl = false

    // 1-min request.security block removed (was dead code behind `and false`) — saves one security call per bar
    if strategy.position_size > 0  // Long: move SL up
        should_update_sl := na(trade_current_sl) or new_sl > trade_current_sl
    else if strategy.position_size < 0  // Short: move SL down
        should_update_sl := na(trade_current_sl) or new_sl < trade_current_sl

    if should_update_sl and (tp1_hit or not trade_be_moved)
        if active_entry_id == "Long"
            strategy.exit("Long Exit", "Long", stop = new_sl, comment_loss = "SL")
        else if active_entry_id == "Long Flip"
            strategy.exit("Long Flip Exit", "Long Flip", stop = new_sl, comment_loss = "SL")
        else if active_entry_id == "Short"
            strategy.exit("Short Exit", "Short", stop = new_sl, comment_loss = "SL")
        else if active_entry_id == "Short Flip"
            strategy.exit("Short Flip Exit", "Short Flip", stop = new_sl, comment_loss = "SL")
        trade_current_sl := new_sl
        array.set(_trade_current_sl, 0, new_sl)

if strategy.opentrades > 0
    int last_entry_bar = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)

    if (bar_index - last_entry_bar) >= max_bars_held
        strategy.close_all(comment = "Time Stop (Bars)")

        trade_entry_price      := na
        array.set(_trade_entry_price, 0, na)
        trade_original_sl      := na
        array.set(_trade_original_sl, 0, na)
        trade_original_sl_pips := na
        trade_current_sl       := na
        array.set(_trade_current_sl, 0, na)
        labels_created         := false
        tp1_hit                := false
        array.set(_tp1_hit, 0, false)
        trade_tp1_price        := na
        array.set(_trade_tp1_price, 0, na)
        active_entry_id        := na
        array.set(_active_entry_id, 0, na)
        trade_be_trigger_rr    := na
        array.set(_trade_be_trigger_rr, 0, na)
        trade_be_sl_pips       := na
        array.set(_trade_be_sl_pips, 0, na)
        trade_be_moved         := false
        array.set(_trade_be_moved, 0, false)

if strategy.position_size != 0 and not na(trade_entry_bar_index)
    if strategy.position_size > 0
        if na(trade_worst_price) or low < trade_worst_price
            trade_worst_price := low
            array.set(_trade_worst_price, 0, low)
    else
        if na(trade_worst_price) or high > trade_worst_price
            trade_worst_price := high
            array.set(_trade_worst_price, 0, high)

bool trade_just_closed = strategy.closedtrades > strategy.closedtrades[1]

if trade_just_closed
    int last_trade_idx = strategy.closedtrades - 1

    bool was_win = strategy.closedtrades.profit(last_trade_idx) > 0
    string entry_comment = strategy.closedtrades.entry_comment(last_trade_idx)
    string exit_comment = strategy.closedtrades.exit_comment(last_trade_idx)

    int bars_held = not na(trade_entry_bar_index) ? (bar_index - trade_entry_bar_index) : 0

    float mae_pips = 0.0
    if not na(trade_worst_price) and not na(trade_entry_price)
        if strategy.position_size[1] > 0  // Was long
            mae_pips := (trade_entry_price - trade_worst_price) / pip_size
        else  // Was short
            mae_pips := (trade_worst_price - trade_entry_price) / pip_size

    string exit_type = "unknown"
    if str.contains(exit_comment, "TP")
        exit_type := "tp_hit"
    else if str.contains(exit_comment, "SL")
        exit_type := "sl_hit"
    else if str.contains(exit_comment, "BE")
        exit_type := "break_even"
    else if str.contains(exit_comment, "TimeStop")
        exit_type := "time_stop"
    else if str.contains(exit_comment, "EarlyClose")
        exit_type := "early_close"
    else if bars_held >= max_bars_held
        exit_type := "time_stop"

    float lastProfit = strategy.closedtrades.profit(last_trade_idx)  // account currency P&L (can be negative)
    float lastEntry = strategy.closedtrades.entry_price(last_trade_idx)
    float riskPips = trade_original_sl_pips
    float pnl_r = (not na(riskPips) and riskPips != 0 and not na(lastEntry)) ? lastProfit / (riskPips * pip_size * 100) : 0.0

    if enable_webhook_alerts and not na(trade_zone_id)
        string exit_side = str.contains(active_entry_id, "Long") ? "buy" : "sell"

        string exit_payload = Utils.build_exit_webhook_payload(
            trade_zone_id,              // zone_id
            syminfo.ticker,             // symbol — required for broker close routing
            exit_side,                  // side — required for broker close routing
            "LIVE",                     // run_mode — tells backend to fire broker close
            was_win ? "win" : "loss",   // outcome
            bars_held,                  // bars_held
            close,                      // close_price
            pnl_r,                      // pnl_r
            lastProfit,                 // pnl_usd (account currency, negative on loss)
            exit_type,                  // exit_type
            mae_pips,                   // mae_pips
            timenow                     // current_time
        )

        alert(exit_payload, alert.freq_once_per_bar)

    if str.contains(entry_comment, "[ACC]")
        stat_trades_accuracy_total += 1
        if was_win
            stat_trades_accuracy_wins += 1
        else
            stat_trades_accuracy_losses += 1
    else
        stat_trades_normal_total += 1
        if was_win
            stat_trades_normal_wins += 1
        else
            stat_trades_normal_losses += 1

    if str.contains(trade_entry_grade, "A")
        stat_grade_A_total += 1
        if was_win
            stat_grade_A_wins += 1
    else if str.contains(trade_entry_grade, "B")
        stat_grade_B_total += 1
        if was_win
            stat_grade_B_wins += 1
    else
        stat_grade_C_total += 1
        if was_win
            stat_grade_C_wins += 1


    bucket = Utils.get_symbol_bucket(syminfo.ticker)
    if bucket == "XAU"
        stat_rr_sum_xau += pnl_r
        stat_rr_count_xau += 1
    else if bucket == "JPY"
        stat_rr_sum_jpy += pnl_r
        stat_rr_count_jpy += 1
    else
        stat_rr_sum_other += pnl_r
        stat_rr_count_other += 1

    trade_entry_price := na
    array.set(_trade_entry_price, 0, na)
    trade_original_sl := na
    array.set(_trade_original_sl, 0, na)
    trade_original_sl_pips := na
    trade_current_sl := na
    array.set(_trade_current_sl, 0, na)
    labels_created := false
    tp1_hit := false
    array.set(_tp1_hit, 0, false)
    trade_tp1_price := na
    array.set(_trade_tp1_price, 0, na)
    active_entry_id := na
    array.set(_active_entry_id, 0, na)
    trade_be_trigger_rr := na
    array.set(_trade_be_trigger_rr, 0, na)
    trade_be_sl_pips := na
    array.set(_trade_be_sl_pips, 0, na)
    trade_be_moved := false
    array.set(_trade_be_moved, 0, false)
    trade_entry_grade := "C"
    array.set(_trade_entry_grade, 0, "C")

    trade_entry_bar_index := na
    array.set(_trade_entry_bar_index, 0, na)
    trade_worst_price := na
    array.set(_trade_worst_price, 0, na)
    trade_zone_id := na
    array.set(_trade_zone_id, 0, na)

var line[] _lowLiqLines = array.new_line()
var bool[] _lowLiqActive = array.new_bool()
var line[] _highLiqLines = array.new_line()
var bool[] _highLiqActive = array.new_bool()

_controlLine(_lines, _activeFlags, __high, __low) =>
    sz = array.size(_lines)

    if sz <= 0
        true  // Return dummy value for function signature
    else
        int startIdx = math.max(0, sz - 50)

        for i = startIdx to sz - 1
            lineRef  = array.get(_lines, i)
            bool isActive = i < array.size(_activeFlags) ? array.get(_activeFlags, i) : false

            if not isActive
                continue

            float y1 = line.get_y1(lineRef)
            float y2 = line.get_y2(lineRef)
            float lvlLow = math.min(y1, y2)
            float lvlHigh = math.max(y1, y2)
            float tolerance = pip_size * 0.1
            bool isCrossed = (__high >= lvlLow - tolerance and __low <= lvlLow + tolerance) or (__high >= lvlHigh - tolerance and __low <= lvlHigh + tolerance)
            if isActive and isCrossed
                line.set_color(lineRef, color.new(color.purple, 0))
                if i < array.size(_activeFlags)
                    array.set(_activeFlags, i, false)
            else if isActive and (not isCrossed) and bar_index >= line.get_x1(lineRef)
                line.set_x2(lineRef, bar_index + 1)
        true  // Return value


if isPvtLow and plotLiq
    int  pBar  = bar_index - 1  // Middle candle of the 3-candle pattern
    float pLow = low[1]
    lowLine = line.new(x1 = pBar, y1 = pLow, x2 = bar_index, y2 = pLow,
                       extend = extend.none, color = pvtBtmColor, style = pvtStyle, xloc = xloc.bar_index)
    if array.size(_lowLiqLines) >= pvtMax
        line.delete(array.shift(_lowLiqLines))
        if array.size(_lowLiqActive) > 0
            array.shift(_lowLiqActive)
    array.push(_lowLiqLines, lowLine)
    array.push(_lowLiqActive, true)

if isPvtHigh and plotLiq
    int  pBar  = bar_index - 1  // Middle candle of the 3-candle pattern
    float pHigh = high[1]
    highLine = line.new(x1 = pBar, y1 = pHigh, x2 = bar_index, y2 = pHigh,extend = extend.none, color = pvtTopColor, style = pvtStyle, xloc = xloc.bar_index)
    if array.size(_highLiqLines) >= pvtMax
        line.delete(array.shift(_highLiqLines))
        if array.size(_highLiqActive) > 0
            array.shift(_highLiqActive)
    array.push(_highLiqLines, highLine)
    array.push(_highLiqActive, true)

if plotLiq and barstate.isconfirmed
    _controlLine(_lowLiqLines, _lowLiqActive, high, low)
    _controlLine(_highLiqLines, _highLiqActive, high, low)

var table zoneInspector = na
var label inspectorIndLabel = na
var label inspectorTgtLabel = na

if showZoneInspector and debug_enabled and isRecentBarForDebug()
    if na(zoneInspector)
        zoneInspector := table.new(position.bottom_right, 2, 40,
             bgcolor = color.new(color.rgb(20, 25, 30), 10),
             frame_color = color.new(color.rgb(100, 110, 120), 80), frame_width = 1,
             border_color = color.new(color.rgb(60, 70, 80), 50), border_width = 1)
    if barstate.isconfirmed and not na(zoneInspector)
        string zoneInspectorType = "None"
        int zoneInspectorIdx = na
        float zoneInspectorLow = na
        float zoneInspectorHigh = na
        float zoneInspectorSizePips = na
        int barsSinceCreation = na
        string liqRequired = "N/A"
        string liqExistsInspector = "N/A"
        string liqCandlesCountInspector = "N/A"
        string liqSweptInspector = "N/A"
        string targetSweptInspector = "N/A"
        string sweepBarIdx = "N/A"
        string wickInZone = "N/A"
        string notClosedIn = "N/A"
        string bullishBearishClose = "N/A"
        string zoneUsedInspector = "N/A"
        string zoneCausedSweepInspector = "N/A"
        string entryAllowedInspector = "N/A"
        string rejectionReasonInspector = "N/A"
        string liqDistInspector = "N/A"
        bool liqDistExceedsMax = false

        string manualParsedIdStr = "N/A"
        string foundInPool = "NOT_FOUND"
        string notFoundReason = "N/A"
        string zoneStatus = "N/A"          // LIVE / INACTIVE
        string zoneInactiveReason = "N/A"  // max_pruned / removed / etc.

        string manualInputClean = str.trim(manual_zone_id_input)
        string manualTypeHint = "Any"
        int manualZoneId = na

        if str.length(manualInputClean) > 0
            string working = manualInputClean
            string firstChar = str.upper(str.substring(working, 0, 1))

            if firstChar == "D" or firstChar == "S"
                manualTypeHint := firstChar == "D" ? "Demand" : "Supply"
                dashPos = str.pos(working, "-")
                if dashPos >= 0
                    working := str.substring(working, dashPos + 1, str.length(working))
                else
                    working := str.substring(working, 1, str.length(working))

            working := str.replace_all(working, " ", "")
            float parsedVal = str.tonumber(working)
            if not na(parsedVal)
                manualZoneId := int(math.round(parsedVal))
                manualParsedIdStr := str.tostring(manualZoneId)
            else
                notFoundReason := "invalid_input"

        int inspectIndex = na
        string inspectType = "None"
        Core.ZoneDBEntry dbEntry = na
        bool foundInDB = false

        int targetId = na
        if str.length(manualInputClean) == 0
            if array.size(demandZones) > 0
                targetId := array.get(demandZones, 0).id
            else if array.size(supplyZones) > 0
                targetId := array.get(supplyZones, 0).id
        else
            targetId := manualZoneId

        if not na(targetId)
            int dbIdx = db_findIndexByUZID(targetId)
            if not na(dbIdx)
                dbEntry := array.get(zoneDB, dbIdx)
                foundInDB := true
                inspectType := dbEntry.zoneType == "DEMAND" ? "Demand" : "Supply"
                foundInPool := "ZONEDB_ONLY"  // Default: found in DB only
                zoneStatus := dbEntry.active ? "LIVE" : "INACTIVE"
                zoneInactiveReason := dbEntry.active ? "N/A" : dbEntry.inactiveReason
                notFoundReason := "N/A"

                if dbEntry.zoneType == "DEMAND"
                    inspectIndex := findDemandZoneIndexByUZID(targetId)
                    if not na(inspectIndex)
                        foundInPool := "DEMAND_LIVE"
                else
                    inspectIndex := findSupplyZoneIndexByUZID(targetId)
                    if not na(inspectIndex)
                        foundInPool := "SUPPLY_LIVE"
            else
                int demandIdxManual = na
                int supplyIdxManual = na

                demandIdxManual := findDemandZoneIndexByUZID(targetId)
                if not na(demandIdxManual)
                    inspectIndex := demandIdxManual
                    inspectType := "Demand"
                    foundInPool := "DEMAND_LIVE"
                    zoneStatus := "LIVE"
                    notFoundReason := "N/A"
                else
                    supplyIdxManual := findSupplyZoneIndexByUZID(targetId)
                    if not na(supplyIdxManual)
                        inspectIndex := supplyIdxManual
                        inspectType := "Supply"
                        foundInPool := "SUPPLY_LIVE"
                        zoneStatus := "LIVE"
                        notFoundReason := "N/A"
                    else
                        foundInPool := "NOT_FOUND"
                        notFoundReason := "not_in_db_or_arrays"

        zoneInspectorIdx := inspectIndex
        zoneInspectorType := inspectType
        bool isInspectorDemand = inspectType == "Demand"

        int zoneInspectorUZID = na
        bool inspectorZoneActive = false
        Core.Zone inspectorZone = na

        if not na(zoneInspectorIdx) and zoneInspectorType != "None"
            if isInspectorDemand
                if zoneInspectorIdx < array.size(demandZones)
                    inspectorZone := array.get(demandZones, zoneInspectorIdx)
            else
                if zoneInspectorIdx < array.size(supplyZones)
                    inspectorZone := array.get(supplyZones, zoneInspectorIdx)

            if not na(inspectorZone)
                zoneInspectorUZID := inspectorZone.id
                inspectorZoneActive := inspectorZone.active
        else if foundInDB and not na(dbEntry)
            zoneInspectorUZID := dbEntry.uzid
            inspectorZoneActive := false  // Not in live arrays = effectively inactive

        bool allowInactiveInspector = true

        if not na(inspectorZone) and (inspectorZoneActive or allowInactiveInspector)
            zoneInspectorHigh := inspectorZone.top
            zoneInspectorLow := inspectorZone.bottom

            if not na(zoneInspectorLow) and not na(zoneInspectorHigh)
                zoneInspectorSizePips := (zoneInspectorHigh - zoneInspectorLow) / pip_size

            if not na(inspectorZone.createdBarIndex)
                barsSinceCreation := bar_index - inspectorZone.createdBarIndex

            liqRequired := require_liquidity_sweep ? "Yes" : "No"

            int oppCntInspector = inspectorZone.liquidityCandleCount
            int minCandles = useOneCandleLiquidity ? 1 : 2
            bool liqExistsBool = oppCntInspector >= minCandles

            liqExistsInspector := liqExistsBool ? "✓ Valid" : "✗ Invalid"

            float sweepTol = syminfo.mintick * 20
            bool currentBarIndSweep = isInspectorDemand ? (low <= inspectorZone.liqLowPrice + sweepTol) : (high >= inspectorZone.liqHighPrice - sweepTol)
            bool currentBarTgtSweep = isInspectorDemand ? (high >= inspectorZone.liqHighPrice - sweepTol) : (low <= inspectorZone.liqLowPrice + sweepTol)

            liqSweptInspector := (inspectorZone.liquiditySwept or currentBarIndSweep) ? "Yes" : "No"
            sweepBarIdx := not na(inspectorZone.liquiditySweptBarIndex) ? str.tostring(inspectorZone.liquiditySweptBarIndex) : (currentBarIndSweep ? str.tostring(bar_index) : "N/A")

            targetSweptInspector := (inspectorZone.targetSwept or currentBarTgtSweep) ? "Yes" : "No"

            float liqDistCalc = na
            if zoneInspectorType == "Demand" and not na(inspectorZone.liqLowPrice) and not na(inspectorZone.top)
                liqDistCalc := math.abs(inspectorZone.liqLowPrice - inspectorZone.top) / pip_size
            else if zoneInspectorType == "Supply" and not na(inspectorZone.liqHighPrice) and not na(inspectorZone.bottom)
                liqDistCalc := math.abs(inspectorZone.bottom - inspectorZone.liqHighPrice) / pip_size
            liqDistInspector := not na(liqDistCalc) ? str.tostring(liqDistCalc, "#.#") + " pips (max:" + str.tostring(effective_liq_entry_max_dist, "#.#") + " rv:" + str.tostring(rvol_scale, "#.#") + "x)" : "N/A"
            liqDistExceedsMax := effective_liq_entry_max_dist > 0.0 and not na(liqDistCalc) and liqDistCalc > effective_liq_entry_max_dist

            zoneCausedSweepInspector := inspectorZone.causedSweep ? "Yes" : "No"

            zoneUsedInspector := not na(inspectorZone.lastEntryBar) ? "Yes" : "No"

            bullishBearishClose := close > open ? "Bullish" : "Bearish"

            notClosedIn := (close < zoneInspectorLow or close > zoneInspectorHigh) ? "Yes" : "No"

            bool zoneTouched = not na(inspectorZone) and inspectorZone.wasTouched
            wickInZone := zoneTouched ? "Yes (Touched)" : "No"

            bool entryAllowedInspectorBool = false
            string validationReason = ""
            if isInspectorDemand
                [canEnterDemand, reasonDemand] = isValidDemandEntry(zoneInspectorIdx)
                entryAllowedInspectorBool := canEnterDemand
                validationReason := reasonDemand
            else
                [canEnterSupply, reasonSupply] = isValidSupplyEntry(zoneInspectorIdx)
                entryAllowedInspectorBool := canEnterSupply
                validationReason := reasonSupply

            if not isInspectorDemand and not allow_short_trades
                entryAllowedInspector := "Shorts Disabled"
                rejectionReasonInspector := "Shorts disabled"
            else
                entryAllowedInspector := entryAllowedInspectorBool ? "Yes" : "No"
                rejectionReasonInspector := entryAllowedInspectorBool ? "None" : (str.length(validationReason) > 0 ? validationReason : "Unknown")
        else if na(inspectorZone) and foundInDB and not na(dbEntry)
            zoneInspectorHigh := dbEntry.top
            zoneInspectorLow := dbEntry.bottom

            if not na(zoneInspectorLow) and not na(zoneInspectorHigh)
                zoneInspectorSizePips := (zoneInspectorHigh - zoneInspectorLow) / pip_size

            if not na(dbEntry.createdBar)
                barsSinceCreation := bar_index - dbEntry.createdBar

            liqRequired := require_liquidity_sweep ? "Yes" : "No"

            int dbOppCnt = dbEntry.liquidityCandleCount
            int minCandles = useOneCandleLiquidity ? 1 : 2
            bool liqExistsBool = dbOppCnt >= minCandles
            liqExistsInspector := (liqExistsBool ? "Yes" : "No") + " (" + str.tostring(dbOppCnt) + ") [DB]"
            liqCandlesCountInspector := str.tostring(dbOppCnt) + " [DB]"

            liqSweptInspector := dbEntry.liquiditySwept ? "Yes [DB]" : "No [DB]"

            zoneCausedSweepInspector := dbEntry.causedSweep ? "Yes [DB]" : "No [DB]"

            entryAllowedInspector := "Zone Inactive"
            rejectionReasonInspector := dbEntry.inactiveReason

        color typeColor = isInspectorDemand ? color.new(color.green, 20) : color.new(color.red, 20)
        table.cell(zoneInspector, 0, 0, "Zone #" + str.tostring(zoneInspectorUZID), bgcolor=typeColor, text_color=color.white, text_size = tbl_sz, text_halign = text.align_left)
        table.cell(zoneInspector, 1, 0, zoneInspectorType, bgcolor=typeColor, text_color=color.white, text_size = tbl_sz, text_halign = text.align_left)

        string gradeStr = (not na(inspectorZone) and not na(inspectorZone.grade)) ? inspectorZone.grade : "N/A"
        float scoreVal = (not na(inspectorZone) and not na(inspectorZone.score)) ? inspectorZone.score : 0.0
        color gradeColor = scoreVal >= 80 ? color.lime : (scoreVal >= 60 ? color.yellow : color.red)

        table.cell(zoneInspector, 0, 1, "Grade", text_color = color.rgb(200, 200, 200), bgcolor=color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        table.cell(zoneInspector, 1, 1, gradeStr + " (" + str.tostring(scoreVal, "#") + ")", text_color=gradeColor, bgcolor=color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 2, "Zone ID", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        zoneIdStr = not na(zoneInspectorUZID) ? str.tostring(zoneInspectorUZID) : "N/A"
        table.cell(zoneInspector, 1, 2, zoneIdStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 3, "Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        typeColorInspector = zoneInspectorType == "Demand" ? color.green : (zoneInspectorType == "Supply" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 3, zoneInspectorType, text_color = typeColorInspector, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 4, "Range", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        rangeStrInspector = (not na(zoneInspectorLow) and not na(zoneInspectorHigh)) ? str.format("{0} → {1}", str.tostring(zoneInspectorLow, format.mintick), str.tostring(zoneInspectorHigh, format.mintick)) : "N/A"
        table.cell(zoneInspector, 1, 4, rangeStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 5, "Zone Size", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        sizeStrInspector = not na(zoneInspectorSizePips) ? str.tostring(math.round(zoneInspectorSizePips * 10) / 10, "#.#") + " pips" : "N/A"
        table.cell(zoneInspector, 1, 5, sizeStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 6, "Bars Since", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        barsStrInspector = not na(barsSinceCreation) ? str.tostring(barsSinceCreation) : "N/A"
        table.cell(zoneInspector, 1, 6, barsStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 7, "Liq Required", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        liqReqColor = liqRequired == "Yes" ? color.yellow : (liqRequired == "No" ? color.gray : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 7, liqRequired, text_color = liqReqColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 8, "Liquidity", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        liqExistsColor = str.contains(liqExistsInspector, "✓") ? color.green : (str.contains(liqExistsInspector, "✗") ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 8, liqExistsInspector, text_color = liqExistsColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 9, "Liq Swept", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        liqSweptColor = liqSweptInspector == "Yes" ? color.green : (liqSweptInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 9, liqSweptInspector, text_color = liqSweptColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 10, "Target Swept", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        targetSweptColor = targetSweptInspector == "Yes" ? color.green : (targetSweptInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 10, targetSweptInspector, text_color = targetSweptColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 11, "Liq Distance", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        liqDistColor = liqDistExceedsMax ? color.red : (liqDistInspector != "N/A" ? color.green : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 11, liqDistInspector, text_color = liqDistColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 12, "Sweep Bar", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        table.cell(zoneInspector, 1, 12, sweepBarIdx, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 13, "Zone Caused Sweep", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        zoneCausedSweepColor = zoneCausedSweepInspector == "Yes" ? color.green : (zoneCausedSweepInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 13, zoneCausedSweepInspector, text_color = zoneCausedSweepColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 14, "Wick In Zone", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        wickColor = wickInZone == "Yes" ? color.green : (wickInZone == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 14, wickInZone, text_color = wickColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 15, "Not Closed In", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        notClosedColor = notClosedIn == "Yes" ? color.green : (notClosedIn == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 15, notClosedIn, text_color = notClosedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 16, "Close Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        closeColor = bullishBearishClose == "Bullish" ? color.green : (bullishBearishClose == "Bearish" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 16, bullishBearishClose, text_color = closeColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        table.cell(zoneInspector, 0, 17, "Zone Used", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        usedColor = zoneUsedInspector == "Yes" ? color.red : (zoneUsedInspector == "No" ? color.green : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 17, zoneUsedInspector, text_color = usedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        string displayEntryAllowed = entryAllowedInspector
        color displayEntryColor = entryAllowedInspector == "Yes" ? color.new(color.green, 0) : (entryAllowedInspector == "No" ? color.new(color.red, 0) : color.rgb(200, 200, 200))

        if entryTriggeredThisBar and not na(triggeredZoneId) and not na(inspectorZone) and triggeredZoneId == inspectorZone.id
            displayEntryAllowed := "YES (Executed)"
            displayEntryColor := color.new(color.green, 0)

        table.cell(zoneInspector, 0, 18, "Entry Allowed", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        table.cell(zoneInspector, 1, 18, displayEntryAllowed, text_color = displayEntryColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        string inspectorReasonText = rejectionReasonInspector
        string inspectorTooltip = ""
        if str.contains(rejectionReasonInspector, "[")
            string[] parts = str.split(rejectionReasonInspector, "[")
            if array.size(parts) > 1
                inspectorReasonText := array.get(parts, 0)
                string rawBreakdown = array.get(parts, 1)
                inspectorTooltip := str.replace(rawBreakdown, "]", "")

        table.cell(zoneInspector, 0, 19, "Reason", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        reasonColor = rejectionReasonInspector == "None" ? color.new(color.green, 0) : (rejectionReasonInspector != "N/A" ? color.new(color.orange, 0) : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 19, inspectorReasonText, tooltip = inspectorTooltip, text_color = reasonColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        int diagA = array.get(_diag_a_code, 0)
        int diagB = array.get(_diag_b_code, 0)
        int diagC = array.get(_diag_c_code, 0)
        int diagLast = array.get(_diag_last_code, 0)
        string diagSummary = "A:" + diagMini(diagA) + " B:" + diagMini(diagB) + " C:" + diagMini(diagC)
        string diagTooltip = "Latest: " + diagMini(diagLast) + " " + diagName(diagLast) + " side=" + array.get(_diag_last_side, 0) + " base=" + diagMini(array.get(_diag_last_base, 0)) + " bar=" + diagMini(array.get(_diag_last_bar, 0)) + " note=" + array.get(_diag_last_note, 0)
        table.cell(zoneInspector, 0, 20, "Diag A-C", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = tbl_sz)
        table.cell(zoneInspector, 1, 20, diagSummary, tooltip = diagTooltip, text_color = color.rgb(120, 190, 255), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = tbl_sz)

        bool showDebugLookupRows = foundInPool == "NOT_FOUND" or notFoundReason != "N/A"

        if not na(inspectorZone)
            float sl_est_insp = (inspectorZone.top - inspectorZone.bottom) / pip_size

        int nextRow = 21

        if showDebugLookupRows
            table.cell(zoneInspector, 0, nextRow, "Manual Parsed ID", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
            parsedIdColor = manualParsedIdStr != "N/A" ? color.yellow : color.rgb(150, 150, 150)
            table.cell(zoneInspector, 1, nextRow, manualParsedIdStr, text_color = parsedIdColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
            nextRow += 1

            table.cell(zoneInspector, 0, nextRow, "Found In", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
            foundInColor = foundInPool == "DEMAND_LIVE" ? color.green : (foundInPool == "SUPPLY_LIVE" ? color.red : (foundInPool == "ZONEDB_ONLY" ? color.yellow : color.rgb(150, 150, 150)))
            table.cell(zoneInspector, 1, nextRow, foundInPool, text_color = foundInColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
            nextRow += 1

            table.cell(zoneInspector, 0, nextRow, "Not Found Reason", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
            notFoundColor = notFoundReason == "N/A" or notFoundReason == "empty_input" ? color.rgb(150, 150, 150) : color.orange
            table.cell(zoneInspector, 1, nextRow, notFoundReason, text_color = notFoundColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
            nextRow += 1


        float displayLiqHigh = na
        int displayLiqHighBar = na
        float displayLiqLow = na
        int displayLiqLowBar = na
        string displayLiqSource = "N/A"

        if not na(inspectorZone)
            displayLiqHigh := inspectorZone.liqHighPrice
            displayLiqHighBar := inspectorZone.liqHighBar
            displayLiqLow := inspectorZone.liqLowPrice
            displayLiqLowBar := inspectorZone.liqLowBar
            displayLiqSource := na(inspectorZone.liqSource) ? "N/A" : inspectorZone.liqSource
        else if foundInDB and not na(dbEntry)
            displayLiqHigh := dbEntry.liqHighPrice
            displayLiqHighBar := dbEntry.liqHighBar
            displayLiqLow := dbEntry.liqLowPrice
            displayLiqLowBar := dbEntry.liqLowBar
            displayLiqSource := na(dbEntry.liqSource) ? "N/A" : dbEntry.liqSource

        string inducementLabel = isInspectorDemand ? "Inducement (Low)" : "Inducement (High)"
        string inducementStr = "N/A"
        float inducementPrice = isInspectorDemand ? displayLiqLow : displayLiqHigh
        int inducementBar = isInspectorDemand ? displayLiqLowBar : displayLiqHighBar
        if not na(inducementPrice)
            inducementStr := str.tostring(inducementPrice, format.mintick) + " @ " + str.tostring(inducementBar)
        table.cell(zoneInspector, 0, nextRow, inducementLabel, text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
        inducementColor = inducementStr != "N/A" ? color.rgb(100, 200, 255) : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, inducementStr, text_color = inducementColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
        nextRow += 1

        string targetLabel = isInspectorDemand ? "Target (High)" : "Target (Low)"
        string targetStr = "N/A"
        float targetPrice = isInspectorDemand ? displayLiqHigh : displayLiqLow
        int targetBar = isInspectorDemand ? displayLiqHighBar : displayLiqLowBar
        if not na(targetPrice)
            targetStr := str.tostring(targetPrice, format.mintick) + " @ " + str.tostring(targetBar)
        table.cell(zoneInspector, 0, nextRow, targetLabel, text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
        targetColor = targetStr != "N/A" ? color.new(color.purple, 0) : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, targetStr, text_color = targetColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
        nextRow += 1

        if isInspectorDemand and not na(inspectorZone)
            int pushBar = inspectorZone.pushHighBar
            float pushPrice = inspectorZone.pushHighPrice
            float indLowPrice = inspectorZone.liqLowPrice
            int indBar = inspectorZone.liqLowBar

            string pushStr = na(pushBar) or na(pushPrice) ? "N/A" : str.tostring(pushPrice, format.mintick) + "@" + str.tostring(pushBar)
            string indStr = na(indBar) or na(indLowPrice) ? "N/A" : str.tostring(indLowPrice, format.mintick) + "@" + str.tostring(indBar)
            bool seqOK = not na(pushBar) and not na(indBar) and indBar > pushBar
            string seqStatus = seqOK ? " ✓" : (na(pushBar) or na(indBar) ? "" : " ✗")
            string seqStr = "Push:" + pushStr + " → Ind:" + indStr + seqStatus

            table.cell(zoneInspector, 0, nextRow, "Push→Ind", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
            seqColor = seqOK ? color.green : (na(pushBar) or na(indBar) ? color.rgb(150, 150, 150) : color.orange)
            table.cell(zoneInspector, 1, nextRow, seqStr, text_color = seqColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
            nextRow += 1

        string liqSweptStr = "N/A"
        bool liqSwept = false
        if not na(inspectorZone)
            liqSwept := inspectorZone.liquiditySwept

            if not liqSwept
                float sweepTolerance = syminfo.mintick * 20
                if isInspectorDemand and not na(inspectorZone.liqLowPrice)
                    if low <= inspectorZone.liqLowPrice + sweepTolerance
                        liqSwept := true
                else if not isInspectorDemand and not na(inspectorZone.liqHighPrice)
                    if high >= inspectorZone.liqHighPrice - sweepTolerance
                        liqSwept := true

            liqSweptStr := liqSwept ? "YES" : "NO"
        else if foundInDB and not na(dbEntry)
            liqSwept := dbEntry.liquiditySwept
            liqSweptStr := liqSwept ? "YES (DB)" : "NO (DB)"

        table.cell(zoneInspector, 0, nextRow, "Liq Swept", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
        liqSweptColor := liqSweptStr == "YES" ? color.green : (liqSweptStr == "NO" ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, liqSweptStr, text_color = liqSweptColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
        nextRow += 1

        int displayLegCount = 0
        if not na(inspectorZone)
            displayLegCount := inspectorZone.legCandleCount
        else if foundInDB and not na(dbEntry)
            displayLegCount := dbEntry.legCandleCount
        string legLabel = isInspectorDemand ? "Bearish" : "Bullish"
        string legCandleStr = na(displayLegCount) or displayLegCount == 0 ? "N/A" : str.tostring(displayLegCount) + " " + legLabel

        int sweep_to_touch_bars = (not na(inspectorZone) and not na(inspectorZone.liquiditySweptBarIndex) and not na(inspectorZone.lastTouchBar) and inspectorZone.lastTouchBar >= inspectorZone.liquiditySweptBarIndex) ? (inspectorZone.lastTouchBar - inspectorZone.liquiditySweptBarIndex) : na
        string sweepTouchStr = na(sweep_to_touch_bars) ? "N/A" : (str.tostring(sweep_to_touch_bars) + " bars")
        color sweepTouchColor = na(sweep_to_touch_bars) ? color.gray : (sweep_to_touch_bars <= max_sweep_to_touch_bars ? color.rgb(0, 200, 100) : (sweep_to_touch_bars <= max_sweep_to_touch_bars * 2 ? color.rgb(255, 180, 0) : color.rgb(255, 80, 80)))
        table.cell(zoneInspector, 0, nextRow, "Sweep->Touch", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.black, 100), text_size = tbl_sz)
        table.cell(zoneInspector, 1, nextRow, sweepTouchStr, text_color = sweepTouchColor, bgcolor = color.new(color.black, 100), text_size = tbl_sz)
        nextRow += 1

        int peak_to_touch_bars = (not na(inspectorZone) and not na(inspectorZone.peakBarIndex) and not na(inspectorZone.lastTouchBar) and inspectorZone.lastTouchBar >= inspectorZone.peakBarIndex) ? (inspectorZone.lastTouchBar - inspectorZone.peakBarIndex) : na
        string peakTouchStr = na(peak_to_touch_bars) ? "N/A" : (str.tostring(peak_to_touch_bars) + " bars")
        color peakTouchColor = na(peak_to_touch_bars) ? color.gray : (peak_to_touch_bars <= max_peak_to_touch_bars ? color.rgb(0, 200, 100) : (peak_to_touch_bars <= max_peak_to_touch_bars * 2 ? color.rgb(255, 180, 0) : color.rgb(255, 80, 80)))
        table.cell(zoneInspector, 0, nextRow, "Peak->Touch", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.black, 100), text_size = tbl_sz)
        table.cell(zoneInspector, 1, nextRow, peakTouchStr, text_color = peakTouchColor, bgcolor = color.new(color.black, 100), text_size = tbl_sz)
        nextRow += 1

        table.cell(zoneInspector, 0, nextRow, "Leg Candles", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
        legCandleColor = displayLegCount > 3 ? color.green : (displayLegCount > 0 ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, legCandleStr, text_color = legCandleColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
        nextRow += 1

        bool isPrimed = false
        if not na(inspectorZone)
            isPrimed := inspectorZone.primed

        table.cell(zoneInspector, 0, nextRow, "Primed", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
        string primedStr = isPrimed ? "YES" : "NO"
        color primedColor = isPrimed ? color.green : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, primedStr, text_color = primedColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
        nextRow += 1

        table.cell(zoneInspector, 0, nextRow, "Liq Source", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
        liqSourceColor = displayLiqSource == "ABSOLUTE_SCAN" ? color.green : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, displayLiqSource, text_color = liqSourceColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
        nextRow += 1

        table.cell(zoneInspector, 0, nextRow, "Zone Status", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
        statusColor = zoneStatus == "LIVE" ? color.green : (zoneStatus == "INACTIVE" ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, zoneStatus, text_color = statusColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)
        nextRow += 1

        table.cell(zoneInspector, 0, nextRow, "Inactive Reason", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = tbl_sz)
        inactiveColor = zoneInactiveReason != "N/A" ? color.orange : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, zoneInactiveReason, text_color = inactiveColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = tbl_sz)

        if barstate.islastconfirmedhistory and not na(inspectorZone)
            int indTime = isInspectorDemand ? inspectorZone.liqLowTime : inspectorZone.liqHighTime
            int targetTime = isInspectorDemand ? inspectorZone.liqHighTime : inspectorZone.liqLowTime

            if not na(indTime) and not na(inducementPrice)
                string indFormat = (isInspectorDemand ? "📍 IND (L): " : "📍 IND (H): ") + str.tostring(inducementPrice, format.mintick) + " @ " + str.tostring(inducementBar)
                if na(inspectorIndLabel)
                    inspectorIndLabel := label.new(indTime, inducementPrice, indFormat, xloc=xloc.bar_time, style=label.style_label_up, color=color.new(color.orange, 20), textcolor=color.white, size=size.small)
                else
                    label.set_xy(inspectorIndLabel, indTime, inducementPrice)
                    label.set_text(inspectorIndLabel, indFormat)
            else
                label.delete(inspectorIndLabel)
                inspectorIndLabel := na

            if not na(targetTime) and not na(targetPrice)
                string tgtFormat = (isInspectorDemand ? "🎯 TARGET (H): " : "🎯 TARGET (L): ") + str.tostring(targetPrice, format.mintick) + " @ " + str.tostring(targetBar)
                if na(inspectorTgtLabel)
                    inspectorTgtLabel := label.new(targetTime, targetPrice, tgtFormat, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.purple, 20), textcolor=color.white, size=size.small)
                else
                    label.set_xy(inspectorTgtLabel, targetTime, targetPrice)
                    label.set_text(inspectorTgtLabel, tgtFormat)
            else
                label.delete(inspectorTgtLabel)
                inspectorTgtLabel := na
        else
            label.delete(inspectorIndLabel)
            label.delete(inspectorTgtLabel)
            inspectorIndLabel := na
            inspectorTgtLabel := na
else
    if not na(zoneInspector)
        table.delete(zoneInspector)
        zoneInspector := na

performanceTable := draw_performance_table(performanceTable)

var table profileStatusTable = na

if showDebugPanels and showActiveProfile
    if na(profileStatusTable)
        profileStatusTable := table.new(position.bottom_center, 2, 8,
             bgcolor = color.new(color.rgb(20, 25, 30), 10),
             frame_color = color.new(color.rgb(100, 110, 120), 80), frame_width = 1,
             border_color = color.new(color.rgb(60, 70, 80), 50), border_width = 1)
    table.cell(profileStatusTable, 0, 0, "⚡ ACTIVE PROFILE",
        text_color = color.white,
        bgcolor = color.new(color.rgb(0, 120, 215), 20),
        text_size = size.normal,
        text_halign = text.align_center)
    table.cell(profileStatusTable, 1, 0, config_profile,
        text_color = use_profile_defaults ? color.yellow : color.white,
        bgcolor = color.new(color.rgb(0, 120, 215), 20),
        text_size = size.normal,
        text_halign = text.align_left)

    table.cell(profileStatusTable, 0, 1, "pvtMax", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 1, str.tostring(pvtMax), text_color = color.white, text_halign = text.align_left)

    table.cell(profileStatusTable, 0, 2, "RR Ratio", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    string rr_label = use_custom_rr ? "1:" + str.tostring(risk_reward_ratio, "#.#") : (is_aggressive and use_profile_defaults ? "SL-based" : "1:" + str.tostring(risk_reward_ratio, "#.#"))
    table.cell(profileStatusTable, 1, 2, rr_label, text_color = color.white, text_halign = text.align_left)

    table.cell(profileStatusTable, 0, 3, "RR Mode", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    string rr_mode = ""
    color rr_mode_color = color.white
    if use_custom_rr
        rr_mode := "OVERRIDDEN: Fixed 1:" + str.tostring(risk_reward_ratio, "#.#")
        rr_mode_color := color.orange
    else if is_aggressive and use_profile_defaults
        rr_mode := "✓ YOUR RULES (Aggressive)"
        rr_mode_color := color.lime
    else if use_profile_defaults and (config_profile == "Conservative (Live Trading)" or config_profile == "Balanced (Recommended)")
        rr_mode := "SL-based (Profile)"
        rr_mode_color := color.white
    else
        rr_mode := "SL-based (Default)"
        rr_mode_color := color.gray
    table.cell(profileStatusTable, 1, 3, rr_mode, text_color = rr_mode_color, text_halign = text.align_left)

    table.cell(profileStatusTable, 0, 4, "Max Trades/Day", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 4, str.tostring(max_trades_per_day), text_color = color.white, text_halign = text.align_left)

    table.cell(profileStatusTable, 0, 5, "Structure Mode", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 5, structure_mode, text_color = color.white, text_halign = text.align_left)

    table.cell(profileStatusTable, 0, 6, "Grade Filter", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 6, enable_grade_filter ? min_entry_grade + "+" : "OFF",
        text_color = enable_grade_filter ? color.green : color.gray,
        text_halign = text.align_left)

    table.cell(profileStatusTable, 0, 7, "Time Filters", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    time_filter_status = (filter_dead_zone ? "✓" : "✗") + " Dead Zone | " + (filter_trading_hours ? "✓" : "✗") + " Hours"
    table.cell(profileStatusTable, 1, 7, time_filter_status,
        text_color = (filter_dead_zone and filter_trading_hours) ? color.green : color.orange,
        text_halign = text.align_left)
else
    if not na(profileStatusTable)
        table.delete(profileStatusTable)
        profileStatusTable := na

plot(strategy.position_size != 0 ? trade_tp1_price : na, "Trade TP Level", color = color.new(color.lime, 50), style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? trade_current_sl : na, "Trade SL Level", color = color.new(color.red, 50), style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? trade_entry_price : na, "Trade Entry", color = color.new(color.blue, 50), style = plot.style_linebr, linewidth = 1)

plot(plot_id, "W0: Zone ID", display = display.none)
plot(plot_type, "W1: Zone Type", display = display.none)
plot(plot_entry_model, "W2: Entry Model", display = display.none)
plot(plot_score, "W3: Score", display = display.none)
plot(plot_freshness, "W4: Freshness", display = display.none)
plot(plot_session, "W5: Session", display = display.none)
plot(plot_atr_ratio, "W6: ATR Ratio", display = display.none)
