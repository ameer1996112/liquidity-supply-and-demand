// === JPY PAIRS SL/TP RULES ===
// Returns: [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]
// Rules for JPY pairs (USDJPY, EURJPY, GBPJPY, etc.):
// - SL <= 3 pips: Min RR 1:4.5. Move SL to 1:1 (min 2 pips) when 1:4 hits.
// - SL 3.1-7 pips: Min RR 1:3. Move SL to BE when 1:2 hits.
// - SL 7.1-11 pips: Close full at 1:2.5. Move SL to BE at 1:1.2.
// - SL 11.1+ pips: Close full at 1:2.
get_jpy_tp_rules(sl_pips) =>
    float tp_ratio = 2.0
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 3.0
        tp_ratio := 4.5
        be_trigger_rr := 4.0
        be_sl_pips_min := 2.0  // Move to 1:1 but min 2 pips
        move_to_be := true
    else if sl_pips <= 7.0
        tp_ratio := 3.0
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0  // Move to BE (entry)
        move_to_be := true
    else if sl_pips <= 11.0
        tp_ratio := 2.5
        be_trigger_rr := 1.2
        be_sl_pips_min := 0.0  // Move to BE (entry)
        move_to_be := true
    else
        tp_ratio := 2.0
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]

// === GENERIC FOREX TP RULES (Non-JPY pairs) ===
// Now uses the same SL-based rules as JPY pairs (unified Forex rules)
get_forex_tp_rules(sl_pips) =>
    // Use JPY rules for all Forex pairs (SL-based dynamic RR)
    get_jpy_tp_rules(sl_pips)

// Backward compatibility wrapper
get_updated_sl_tp_rules(sl_pips) =>
    get_jpy_tp_rules(sl_pips)

get_rd_forex_tp_ratio(sl_pips) =>
    [tp, _, _, _] = get_jpy_tp_rules(sl_pips)
    tp

// === DOUBLE TP MODE (OPTIONAL) ===
// When enabled: 1:2 becomes 1:4, 1:3 becomes 1:6, etc.
get_double_tp_ratio(base_ratio) =>
    base_ratio * 2.0

// === GOLD TP RULES (XAUUSD) ===
// Specific rules provided by user:
// - SL <= 50 pips: Min RR 1:4.5
// - SL 50-100 pips: Min RR 1:3, BE at 1:2.75
// - SL 100-150 pips: Close full at 1:2.5, BE at 1:2
// - SL 150-200 pips: Close full at 1:2, BE at 1:1.75
// - SL > 200 pips: Close full at 1:1.5
get_gold_tp_rules(sl_pips) =>
    float tp_ratio = 1.5
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 50.0
        tp_ratio := 4.5
        be_trigger_rr := 4.0   // Move to BE generally
        be_sl_pips_min := 5.0  // Min 5 pips profit
        move_to_be := true
    else if sl_pips <= 100.0
        tp_ratio := 3.0
        be_trigger_rr := 2.75
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else if sl_pips <= USDJPY_FALLBACK
        tp_ratio := 2.5
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else if sl_pips <= 200.0
        tp_ratio := 2.0
        be_trigger_rr := 1.75
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else
        tp_ratio := 1.5
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]

// === AGGRESSIVE PROFILE: JPY & FOREX SL-BASED RULES ===
// - SL ≤ 3 pips: min 1:4.5, move SL to 1:1 (min 2 pips) when 1:4 hits
// - SL 3.1–7: min 1:3, BE when 1:2 hits
// - SL 7.1–11: min 1:2.5, BE when 1:1.2 hits
// - SL 11.1+: close full at 1:2
get_jpy_tp_rules_aggressive(sl_pips) =>
    float tp_ratio = 2.0
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 3.0
        tp_ratio := 4.5
        be_trigger_rr := 4.0
        be_sl_pips_min := 2.0
        move_to_be := true
    else if sl_pips <= 7.0
        tp_ratio := 3.0
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0
        move_to_be := true
    else if sl_pips <= 11.0
        tp_ratio := 2.5
        be_trigger_rr := 1.2
        be_sl_pips_min := 0.0
        move_to_be := true
    else
        tp_ratio := 2.0
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]

// === AGGRESSIVE PROFILE: GOLD SL-BASED RULES ===
