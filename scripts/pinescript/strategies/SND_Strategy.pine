var int[] _diag_a_code = array.new_int(1, na)
var int[] _diag_b_code = array.new_int(1, na)
var int[] _diag_c_code = array.new_int(1, na)
var int[] _diag_last_code = array.new_int(1, na)
var int[] _diag_last_bar = array.new_int(1, na)
var int[] _diag_last_base = array.new_int(1, na)
var string[] _diag_last_side = array.new_string(1, "N/A")
var string[] _diag_last_note = array.new_string(1, "N/A")

diagName(int code) =>
    switch code
        101 => "NO_BASE_FOUND"
        102 => "NO_DISPLACEMENT_CANDLE"
        103 => "DISPLACEMENT_TOO_WEAK"
        104 => "FORMATION_RETOUCHED_ZONE"
        105 => "WRONG_ORIGIN_CANDLE"
        106 => "CONTINUATION_DETECTED_BUT_STANDARD_REJECTED"
        201 => "BASE_ALREADY_USED"
        202 => "CONTINUATION_BASE_ALREADY_USED"
        203 => "HISTORICAL_BASE_ALREADY_USED"
        204 => "DUPLICATE_SAME_LEG"
        205 => "DUPLICATE_OVERLAP_TOO_STRICT"
        206 => "MAX_ZONES_TRIMMED"
        207 => "BOUNDS_NA"
        208 => "ZONE_CREATED"
        301 => "LEFT_ZONE_NOT_MARKED"
        302 => "RETURNED_PRE_SWEEP"
        303 => "SAME_BAR_SWEEP_ORDER_BUG"
        304 => "WICK_INVALIDATED"
        305 => "CLOSE_INVALIDATED"
        306 => "EXPIRED_TOO_EARLY"
        307 => "ACTIVE_AFTER_CREATION"
        => "N/A"

diagMini(int code) =>
    na(code) ? "-" : str.tostring(code)

recordDiag(int code, bool isDemand, int baseIdx, string note) =>
    if not na(code)
        if code >= 300
            array.set(_diag_c_code, 0, code)
        else if code >= 200
            array.set(_diag_b_code, 0, code)
        else if code >= 100
            array.set(_diag_a_code, 0, code)
        array.set(_diag_last_code, 0, code)
        array.set(_diag_last_bar, 0, bar_index)
        array.set(_diag_last_base, 0, baseIdx)
        array.set(_diag_last_side, 0, isDemand ? "D" : "S")
        array.set(_diag_last_note, 0, note)
    true

stageARejectCode(string reason) =>
    reason == "no displacement candle" ? 102 : (reason == "displacement too weak" ? 103 : (reason == "formation retouched zone" ? 104 : na))

isRecentBarForDebug() =>
    if debug_last_bars <= 0 or na(last_bar_index_for_debug)
        true
    else
        bar_index >= (last_bar_index_for_debug - debug_last_bars)

showZoneMiss(int baseIdx, bool isDemand, string reason, int code = na) =>
    recordDiag(code, isDemand, baseIdx, reason)
    if show_zone_miss_inspector and debug_enabled and isRecentBarForDebug() and baseIdx >= 0 and baseIdx <= bar_index
        string codeText = na(code) ? "" : " #" + str.tostring(code)
        label.new(
             x = bar_index - baseIdx,
             y = isDemand ? low[baseIdx] : high[baseIdx],
             text = (isDemand ? "D miss: " : "S miss: ") + reason + codeText,
             style = isDemand ? label.style_label_up : label.style_label_down,
             textcolor = color.white,
             color = color.new(color.orange, 0),
             size = size.tiny,
             xloc = xloc.bar_index)


