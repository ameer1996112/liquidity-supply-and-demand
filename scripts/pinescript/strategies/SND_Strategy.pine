countOppositeCandlesInBand(bool isDemand, int fromBar, int toBar, float top, float bottom) =>
    int oppCount = 0
    if na(fromBar) or na(toBar) or na(top) or na(bottom) or fromBar > toBar
        oppCount
    else
        float overlapTolerance = pip_size * 0.5
        scanEndBar = math.min(toBar, bar_index)

        if scanEndBar >= fromBar
            for scanOff = 0 to (scanEndBar - fromBar)
                scanBar = fromBar + scanOff
                if scanBar > bar_index
                    break

                barOffset = bar_index - scanBar
                if barOffset < 0
                    continue

                float c_high_band = high[barOffset]
                float c_low_band  = low[barOffset]
                bool overlapsBand = c_high_band >= (bottom - overlapTolerance) and c_low_band <= (top + overlapTolerance)

                bool isStructure = false

                float c_open  = open[barOffset]
                float c_close = close[barOffset]
                float c_high  = high[barOffset]
                float c_low   = low[barOffset]
                float body_size = math.abs(c_close - c_open)
                float total_range = c_high - c_low

                if total_range > syminfo.mintick
                    bool isRed   = c_close < c_open
                    bool isGreen = c_close > c_open

                    if structure_mode == "Relaxed (Wicks)"
                        bool isDoji = body_size <= (total_range * 0.05)
                        if isDemand
                            float upper_wick = c_high - math.max(c_open, c_close)
                            bool meaningfulUpperWick = total_range > 0 ? (upper_wick / total_range) >= 0.30 : false
                            isStructure := isRed or isDoji or meaningfulUpperWick
                        else
                            float lower_wick = math.min(c_open, c_close) - c_low
                            bool meaningfulLowerWick = total_range > 0 ? (lower_wick / total_range) >= 0.30 : false
                            isStructure := isGreen or isDoji or meaningfulLowerWick

                    else if structure_mode == "Standard (Bodies)"
                        if isDemand
                            isStructure := isRed and (body_size > total_range * 0.10)
                        else
                            isStructure := isGreen and (body_size > total_range * 0.10)

                    else // Strict (Major Moves)
                        if isDemand
                            isStructure := isRed and (body_size > total_range * 0.30)
                        else
                            isStructure := isGreen and (body_size > total_range * 0.30)

                float overlapTop    = math.min(c_high_band, top)
                float overlapBottom = math.max(c_low_band, bottom)
                float overlapRange  = math.max(0.0, overlapTop - overlapBottom)
                bool overlapsMeaningfully = overlapsBand and overlapRange > 0

                if overlapsMeaningfully and isStructure
                    oppCount += 1
        oppCount

is_strong_body(idx) =>
    body        = math.abs(close[idx] - open[idx])
    total_range = high[idx] - low[idx]
    perc        = total_range > 0 ? body / total_range * 100 : 0
    perc >= min_body_perc

calc_pos_size(entry, stop, balance, risk_pct) =>
    risk_usd = balance * (risk_pct / 100)

    pip_sz = pip_size  // Use the auto-detected or manual pip size

    pip_distance = math.abs(stop - entry)
    sl_pips = pip_distance / pip_sz
    sl_pips := math.max(sl_pips, 0.1)  // Minimum 0.1 pips

    lot_size = FOREX_LOT_SIZE

    float pip_value_per_lot = na

    if is_jpy_pair and not is_usdjpy
        float usdjpy_rate = get_cached_usdjpy_rate()
        pip_value_per_lot := (pip_sz * lot_size) / usdjpy_rate
    else if is_usdjpy
        pip_value_per_lot := (pip_sz * lot_size) / entry
    else if is_usd_quote
        pip_value_per_lot := pip_sz * lot_size
    else
        pip_value_per_lot := (pip_sz * lot_size) / entry

    if na(pip_value_per_lot) or pip_value_per_lot <= 0
        pip_value_per_lot := pip_sz * lot_size

    qty_lots = risk_usd / (sl_pips * pip_value_per_lot)

    if na(qty_lots) or qty_lots <= 0
        qty_lots := 0.001
    else
        qty_lots := math.max(qty_lots, 0.001)

    qty_lots := math.round(qty_lots * 1000) / 1000

    if na(qty_lots) or qty_lots <= 0
        qty_lots := 0.001

    qty_lots

calc_pos_size_units(entry, stop, risk_usd, is_short) =>
    float price_distance = math.abs(entry - stop)

    float min_distance = 2.0 * pip_size  // Minimum 2 pips
    float effective_distance = math.max(price_distance, min_distance)

    if effective_distance <= 0
        0.0
    else
        float position_units = na

        if is_usd_quote and not is_jpy_pair
            position_units := risk_usd / effective_distance

        else if is_jpy_pair
            float usdjpy_rate = get_cached_usdjpy_rate()

            position_units := (risk_usd * usdjpy_rate) / effective_distance

        else
            float quote_usd_rate = Utils.get_quote_to_usd_rate(syminfo.currency, rate_usdcad, rate_usdchf, rate_gbpusd, rate_audusd, rate_nzdusd, rate_eurusd, usdjpy_rate_cache)

            position_units := risk_usd / (effective_distance * quote_usd_rate)

        position_units := math.round(position_units)

        if na(position_units) or position_units <= 0
            position_units := 1.0

        position_units



fetch_usdjpy_rate() =>
    float rate = get_cached_usdjpy_rate()
    bool success = true
    string error_msg = rate == USDJPY_FALLBACK ? "Using fallback rate" : ""
    [rate, success, error_msg]

validate_position_size(entry_price, stop_loss_price, balance, risk_pct, is_short) =>
    bool is_valid = true
    int qty_units = na
    float qty_lots = na
    string error_msg = ""
    float sl_fixed = stop_loss_price  // Local copy - function arguments are immutable in Pine Script

    if na(entry_price) or entry_price <= 0
        is_valid := false
        error_msg := "Invalid entry price"

    if is_valid and (na(sl_fixed) or sl_fixed <= 0)
        is_valid := false
        error_msg := "Invalid stop loss price"

    float minGap = math.max(syminfo.mintick * 2, pip_size * 2.0)  // At least 2 pips

    if is_valid
        if is_short
            if sl_fixed <= entry_price + minGap
                sl_fixed := entry_price + minGap  // Auto-correct
        else
            if sl_fixed >= entry_price - minGap
                sl_fixed := entry_price - minGap  // Auto-correct

    float qty_units_raw = na
    if is_valid
        float target_risk_usd = balance * (risk_pct / 100.0)

        float effective_risk_usd = (max_usd_risk_cap > 0) ? math.min(target_risk_usd, max_usd_risk_cap) : target_risk_usd

        qty_units_raw := calc_pos_size_units(entry_price, sl_fixed, effective_risk_usd, is_short)

        if na(qty_units_raw) or qty_units_raw <= 0
            is_valid := false
            error_msg := "Size calc failed"

        if is_valid
            qty_units := int(math.round(qty_units_raw))

            float contract_size = FOREX_LOT_SIZE
            int effective_min_units = min_position_size_units

            if is_gold or is_xpt
                contract_size := 100.0
                effective_min_units := 1
            else if is_silver
                contract_size := 5000.0
                effective_min_units := 1
            else if is_crypto
                contract_size := 1.0
                effective_min_units := 1
            else if is_index  // Indices: NAS100, SPX, etc.
                contract_size := 1.0
                effective_min_units := 1  // Index: minimum 1 contract

            qty_lots := qty_units / contract_size

            if qty_units < effective_min_units
                is_valid := false
                error_msg := "Size below min"

            float dynamic_max_lots = (balance / 10000.0) * max_lots_per_10k

            if is_valid and qty_lots > max_position_size_lots
                is_valid := false
                error_msg := "Exceeds max size"

            if is_valid and qty_lots > dynamic_max_lots
                is_valid := false
                error_msg := "Exceeds leverage limit"

            if is_valid and (na(qty_units) or qty_units <= 0)
                is_valid := false
                error_msg := "Invalid units"

    [is_valid, qty_units, qty_lots, error_msg, sl_fixed]

is_base_bar_used(barIdx, baseArray) =>
    if array.size(baseArray) == 0
        false
    else
        found = false
        for j = 0 to array.size(baseArray) - 1
            if array.get(baseArray, j) == barIdx
                found := true
                break
        found

is_base_time_used(int baseIdx, array<int> baseArray) =>
    baseIdx >= 0 and baseIdx <= bar_index and array.includes(baseArray, time[baseIdx])

var array<int> used_demand_base_times = array.new_int()
var array<int> used_supply_base_times = array.new_int()
var bool initial_scan_done = false

f_isFractalHigh(_n) =>
    float hh = ta.highest(high, _n * 2 + 1)
    bool enoughBars = _n >= 1 and bar_index >= _n + 1
    bool cond = high[_n] == hh and high[_n] > high[_n + 1] and high[_n] > high[_n - 1]
    enoughBars and cond

f_isFractalLow(_n) =>
    float ll = ta.lowest(low, _n * 2 + 1)
    bool enoughBars = _n >= 1 and bar_index >= _n + 1
    bool cond = low[_n] == ll and low[_n] < low[_n + 1] and low[_n] < low[_n - 1]
    enoughBars and cond

bool isFractalHigh_result = f_isFractalHigh(fractalsPeriod)
bool isFractalLow_result  = f_isFractalLow(fractalsPeriod)

fractalBarIdx  = bar_index - fractalsPeriod
isZoneBaseBar  = (isFractalHigh_result or isFractalLow_result) ?
                 (array.includes(used_demand_base_times, time[fractalsPeriod]) or
                  array.includes(used_supply_base_times, time[fractalsPeriod])) : false

fractalHigh = (not isZoneBaseBar and isFractalHigh_result) ? high[fractalsPeriod] : na
fractalLow  = (not isZoneBaseBar and isFractalLow_result) ? low[fractalsPeriod] : na

plotshape(show_fractals and not na(fractalHigh), style = shape.triangleup,   location = location.abovebar, color = color.green, size = size.small, offset = -fractalsPeriod)
plotshape(show_fractals and not na(fractalLow),  style = shape.triangledown, location = location.belowbar, color = color.red,   size = size.small, offset = -fractalsPeriod)

var array<float> liqPvtHighPrices = array.new_float()
var array<int>   liqPvtHighBars   = array.new_int()
var array<float> liqPvtLowPrices  = array.new_float()
var array<int>   liqPvtLowBars    = array.new_int()

bool isPvtLow  = low[2] > low[1] and low[1] < low[0]
bool isPvtHigh = high[2] < high[1] and high[1] > high[0]

if isPvtLow
    array.push(liqPvtLowPrices, low[1])
    array.push(liqPvtLowBars, bar_index - 1)

if isPvtHigh
    array.push(liqPvtHighPrices, high[1])
    array.push(liqPvtHighBars, bar_index - 1)

while array.size(liqPvtHighPrices) > pvtMax
    array.shift(liqPvtHighPrices)
    array.shift(liqPvtHighBars)
while array.size(liqPvtLowPrices) > pvtMax
    array.shift(liqPvtLowPrices)
    array.shift(liqPvtLowBars)

db_findIndexByUZID(int targetUZID) =>
    int result = na
    if array.size(zoneDB) > 0
        for i = 0 to array.size(zoneDB) - 1
            Core.ZoneDBEntry entry = array.get(zoneDB, i)
            if entry.uzid == targetUZID
                result := i
                break
    result

db_upsertZone(Core.Zone z, string zoneType) =>
    int idx = db_findIndexByUZID(z.id)
    if na(idx)
        Core.ZoneDBEntry entry = Core.ZoneDBEntry.new(
             uzid = z.id,
             zoneType = zoneType,
             top = z.top,
             bottom = z.bottom,
             createdBar = z.createdBarIndex,
             lastUpdateBar = bar_index,
             active = true,
             inactiveReason = "",
             liqLowPrice = z.liqLowPrice,
             liqLowBar = z.liqLowBar,
             liqHighPrice = z.liqHighPrice,
             liqHighBar = z.liqHighBar,
             liqSource = z.liqSource,
             liquiditySwept = z.liquiditySwept,
             liquidityCandleCount = z.liquidityCandleCount,
             causedSweep = z.causedSweep,
             legCandleCount = z.legCandleCount)
        array.push(zoneDB, entry)
        while array.size(zoneDB) > DB_MAX_SIZE
            array.shift(zoneDB)
    else
        Core.ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.top := z.top
        entry.bottom := z.bottom
        entry.lastUpdateBar := bar_index
        entry.active := true
        entry.inactiveReason := ""
        entry.liqLowPrice := z.liqLowPrice
        entry.liqLowBar := z.liqLowBar
        entry.liqHighPrice := z.liqHighPrice
        entry.liqHighBar := z.liqHighBar
        entry.liqSource := z.liqSource
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
        entry.legCandleCount := z.legCandleCount
    true  // Consistent return type

db_markInactive(int targetUZID, string reason) =>
    int idx = db_findIndexByUZID(targetUZID)
    if not na(idx)
        Core.ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.active := false
        entry.inactiveReason := reason
        entry.lastUpdateBar := bar_index
    true  // Consistent return type

db_updateZoneLiquidity(Core.Zone z) =>
    int idx = db_findIndexByUZID(z.id)
    if not na(idx)
        Core.ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.lastUpdateBar := bar_index
        entry.liqLowPrice := z.liqLowPrice
        entry.liqLowBar := z.liqLowBar
        entry.liqHighPrice := z.liqHighPrice
        entry.liqHighBar := z.liqHighBar
        entry.liqSource := z.liqSource
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
    true  // Consistent return type

var int global_zone_id_counter = 0  // Single Global counter for ALL zones (Demand + Supply)

getMaxHighBetween(int startBarAbs, int endBarAbs) =>
    float maxH = -1.0e10
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        for i = offStart to offEnd
            if high[i] > maxH
                maxH := high[i]
    maxH

getMinLowBetween(int startBarAbs, int endBarAbs) =>
    float minL = 1.0e10
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        for i = offStart to offEnd
            if low[i] < minL
                minL := low[i]
    minL

getBarOfMaxHigh(int startBarAbs, int endBarAbs) =>
    float maxH = -1.0e10
    int bestBar = startBarAbs
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        if offStart >= 0 and offEnd >= 0
            for i = offStart to offEnd
                if high[i] >= maxH
                    maxH := high[i]
                    bestBar := bar_index - i
    bestBar

getBarOfMinLow(int startBarAbs, int endBarAbs) =>
    float minL = 1.0e10
    int bestBar = startBarAbs
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        if offStart >= 0 and offEnd >= 0
            for i = offStart to offEnd
                if low[i] <= minL
                    minL := low[i]
                    bestBar := bar_index - i
    bestBar

countOppCandlesInLiquidityRange(int startBarAbs, int endBarAbs, bool isDemand, float rangeLow, float rangeHigh) =>
    int count = 0
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs and startBarAbs <= bar_index and endBarAbs <= bar_index
        int offStart = bar_index - endBarAbs      // Offset for the end bar (newer, lower offset)
        int offEnd   = bar_index - startBarAbs    // Offset for the start bar (older, higher offset)

        if offStart >= 0 and offEnd >= 0
            int max_steps = 200  // Full scan range — matches good-marking reference
            int steps = 0

            for i = offEnd to offStart
                if steps > max_steps
                    break
                steps += 1

                bool isOpp = isDemand ? (close[i] < open[i]) : (close[i] > open[i])

                if isOpp
                    count += 1
    count

countConsecutiveOppCandles(int liqBar, bool isDemand) =>
    int count = 0
    if na(liqBar) or liqBar > bar_index
        0  // Return 0 for invalid liqBar or future bar
    else
        int offset = bar_index - liqBar
        if offset >= 1  // Need at least 1 bar after liqBar
            for i = 1 to liq_candle_count_max
                int idx = offset - i  // Bar index offset from current bar
                if idx < 0  // Reached current bar
                    break
                bool isOppCandle = isDemand ? (close[idx] < open[idx]) : (close[idx] > open[idx])
                if isOppCandle
                    count += 1
        count  // Return actual count (can be 0)


findLocalDemandLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0

    for off = 0 to lookback
        float candidate = low[off]
        bool isSideValid = isInducement ? (candidate >= refPrice - sideTol) : (candidate <= refPrice + sideTol)

        if isSideValid
            float dist = math.abs(candidate - refPrice)
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

findLocalSupplyLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0

    for off = 0 to lookback
        float candidate = high[off]
        bool isSideValid = isInducement ? (candidate <= refPrice + sideTol) : (candidate >= refPrice - sideTol)

        if isSideValid
            float dist = math.abs(candidate - refPrice)
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

const string TOUCH_SWEEP_SOURCE = "ZONE_TOUCH_SWEEP"

findDemandTouchLiquidity(Core.Zone z) =>
    float bestPrice = na
    int bestBar = na
    float tolPrice = syminfo.mintick * liq_side_tol_ticks
    float maxDistPrice = effective_liq_max_dist * pip_size
    int maxOff = math.min(liq_candle_count_max, math.max(1, bar_index - z.createdBarIndex))
    if maxOff >= 1
        for off = 1 to maxOff
            int candidateBar = bar_index - off
            float candidateLow = low[off]
            bool afterZone = candidateBar > z.createdBarIndex
            bool nearZone = candidateLow >= z.bottom - tolPrice and candidateLow <= z.top + maxDistPrice
            bool sweptNow = low <= candidateLow + tolPrice
            if afterZone and nearZone and sweptNow
                bestPrice := candidateLow
                bestBar := candidateBar
                break
    [bestPrice, bestBar]

findSupplyTouchLiquidity(Core.Zone z) =>
    float bestPrice = na
    int bestBar = na
    float tolPrice = syminfo.mintick * liq_side_tol_ticks
    float maxDistPrice = effective_liq_max_dist * pip_size
    int maxOff = math.min(liq_candle_count_max, math.max(1, bar_index - z.createdBarIndex))
    if maxOff >= 1
        for off = 1 to maxOff
            int candidateBar = bar_index - off
            float candidateHigh = high[off]
            bool afterZone = candidateBar > z.createdBarIndex
            bool nearZone = candidateHigh <= z.top + tolPrice and candidateHigh >= z.bottom - maxDistPrice
            bool sweptNow = high >= candidateHigh - tolPrice
            if afterZone and nearZone and sweptNow
                bestPrice := candidateHigh
                bestBar := candidateBar
                break
    [bestPrice, bestBar]

f_scan_demand_liquidity(int zoneArrayIndex) =>
    Core.Zone z = array.get(demandZones, zoneArrayIndex)

    if z.liqSource == TOUCH_SWEEP_SOURCE and not na(z.liquidityPrice)
        true
    else if na(z.createdBarIndex) or bar_index <= z.createdBarIndex
        true
    else
        float bestLiqPrice = 1.0e10
        int bestLiqBar = na
        float bestDist = 1.0e10
        bool bestLiqNearEdge = false
        float zoneHeight = math.abs(z.top - z.bottom)
        int liquidityScanStartBar = math.max(0, z.createdBarIndex - displacement_base_scan_bars - formation_leg_scan_bars)

        int maxOff = math.min(MAX_LIQ_SCAN_BARS, bar_index - liquidityScanStartBar - liq_pivot_len)

        if maxOff >= 0
            for off = 0 to maxOff
                float pLow = pLowSeries[off]
                if not na(pLow)
                    int pBar = bar_index - off - liq_pivot_len

                    if pBar >= liquidityScanStartBar
                        bool isValidLocation = false
                        float distFromZone = 0.0

                        if use_inducement_linking
                            isValidLocation := pLow >= z.top - (syminfo.mintick * liq_side_tol_ticks)
                            distFromZone := math.max(0.0, pLow - z.top)
                        else
                            isValidLocation := pLow < z.bottom
                            distFromZone := z.bottom - pLow

                        if isValidLocation
                            float maxDistPrice = effective_liq_max_dist * pip_size
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice

                            if distOK
                                bool isCloser = distFromZone < bestDist
                                bool isSameDistance = distFromZone == bestDist
                                bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                                bool preferAwayFromEdge = use_inducement_linking and zoneHeight >= pip_size * 5.0
                                bool isNearEdge = preferAwayFromEdge and distFromZone < pip_size * 2.0
                                bool improvesEdgeQuality = bestLiqNearEdge and not isNearEdge
                                bool sameEdgeQuality = bestLiqNearEdge == isNearEdge

                                if na(bestLiqBar) or improvesEdgeQuality or (sameEdgeQuality and (isCloser or (isSameDistance and isMoreRecent)))
                                    bestDist := distFromZone
                                    bestLiqPrice := pLow
                                    bestLiqBar := pBar
                                    bestLiqNearEdge := isNearEdge

        if na(bestLiqBar) and useOneCandleLiquidity
            int localPivotCount = array.size(liqPvtLowPrices)
            if localPivotCount > 0
                for pivotIdx = 0 to localPivotCount - 1
                    float pLow = array.get(liqPvtLowPrices, pivotIdx)
                    int pBar = array.get(liqPvtLowBars, pivotIdx)

                    if not na(pLow) and not na(pBar) and pBar >= liquidityScanStartBar and pBar <= bar_index
                        bool isValidLocation = false
                        float distFromZone = 0.0

                        if use_inducement_linking
                            isValidLocation := pLow >= z.top - (syminfo.mintick * liq_side_tol_ticks)
                            distFromZone := math.max(0.0, pLow - z.top)
                        else
                            isValidLocation := pLow < z.bottom
                            distFromZone := z.bottom - pLow

                        if isValidLocation
                            float maxDistPrice = effective_liq_max_dist * pip_size
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice

                            if distOK
                                bool isCloser = distFromZone < bestDist
                                bool isSameDistance = distFromZone == bestDist
                                bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                                bool preferAwayFromEdge = use_inducement_linking and zoneHeight >= pip_size * 5.0
                                bool isNearEdge = preferAwayFromEdge and distFromZone < pip_size * 2.0
                                bool improvesEdgeQuality = bestLiqNearEdge and not isNearEdge
                                bool sameEdgeQuality = bestLiqNearEdge == isNearEdge

                                if na(bestLiqBar) or improvesEdgeQuality or (sameEdgeQuality and (isCloser or (isSameDistance and isMoreRecent)))
                                    bestDist := distFromZone
                                    bestLiqPrice := pLow
                                    bestLiqBar := pBar
                                    bestLiqNearEdge := isNearEdge

        if not na(bestLiqBar) and bestLiqPrice < 1.0e10
            bool inductionChanged = na(z.liqLowPrice) or z.liqLowPrice != bestLiqPrice or na(z.liqLowBar) or z.liqLowBar != bestLiqBar

            z.liquidityPrice := bestLiqPrice
            z.liquidityBarIndex := bestLiqBar
            z.liqLowPrice := bestLiqPrice
            z.liqLowBar := bestLiqBar

            if inductionChanged
                z.liquiditySwept := false
                z.liquiditySweptBarIndex := na


            // === TARGET: Absolute highest point AFTER zone formation, BEFORE inducement ===
            // Find the ABSOLUTE HIGHEST high in the strict range:
            // [Zone Creation Bar ... Inducement Bar - 1]
            // This ensures the target comes after the zone was formed, not just within base candles.
            int rangeStart = z.createdBarIndex
            int rangeEnd = bestLiqBar - 1  // STRICTLY before inducement

            float bestTargetPrice = na
            int bestTargetBar = na

            if rangeEnd >= rangeStart and rangeEnd <= bar_index and rangeStart >= 0
                bestTargetBar := getBarOfMaxHigh(rangeStart, rangeEnd)

                if not na(bestTargetBar) and bestTargetBar >= rangeStart and bestTargetBar <= rangeEnd
                    int targetOffset = bar_index - bestTargetBar
                    if targetOffset >= 0 and targetOffset < 5000  // Safety bounds
                        bestTargetPrice := high[targetOffset]

            bool targetChanged = na(z.liqHighPrice) or z.liqHighPrice != bestTargetPrice or na(z.liqHighBar) or z.liqHighBar != bestTargetBar

            z.liqHighBar := bestTargetBar
            z.liqHighPrice := bestTargetPrice

            if targetChanged
                z.targetSwept := false
                z.targetSweptBarIndex := na

            int demandLegStart = na
            int demandLegEnd   = na
            int demandLegCount = 0

            if not na(z.liqLowBar) and not na(z.liqHighBar)
                demandLegStart := math.min(z.liqLowBar, z.liqHighBar)
                demandLegEnd   := math.max(z.liqLowBar, z.liqHighBar)
                demandLegCount := countOppCandlesInLiquidityRange(
                     demandLegStart, demandLegEnd, true, z.liqLowPrice, z.liqHighPrice)

            z.liquidityCandleCount := demandLegCount
            z.legCandleCount := demandLegCount

            int minLegCandles = useOneCandleLiquidity ? 1 : 2
            bool hasStrongLeg = demandLegCount >= minLegCandles
            z.liquidityValid := hasStrongLeg
            z.inactiveReason := hasStrongLeg ? na : "WAITING_STRONG_LIQUIDITY"

            z.liqSource := "MAKUCHAKU_PIVOT"

            z.structureSweepLevel := z.liqHighPrice
            z.structureSweepLevelBar := z.liqHighBar

            int indOff = bar_index - bestLiqBar
            int tgtOff = na(z.liqHighBar) ? na : (bar_index - z.liqHighBar)
            z.liqLowTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            z.liqHighTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na

            array.set(demandZones, zoneArrayIndex, z)
            db_updateZoneLiquidity(z)
        else
            z.liquidityValid := false
            z.inactiveReason := "WAITING_PIVOT"
            array.set(demandZones, zoneArrayIndex, z)

        true

f_scan_supply_liquidity(int zoneArrayIndex) =>
    Core.Zone z = array.get(supplyZones, zoneArrayIndex)

    if z.liqSource == TOUCH_SWEEP_SOURCE and not na(z.liquidityPrice)
        true
    else if na(z.createdBarIndex) or bar_index <= z.createdBarIndex
        true
    else
        float bestLiqPrice = 0.0
        int bestLiqBar = na
        float bestDist = 1.0e10
        int liquidityScanStartBar = math.max(0, z.createdBarIndex - displacement_base_scan_bars - formation_leg_scan_bars)

        int maxOff = math.min(MAX_LIQ_SCAN_BARS, bar_index - liquidityScanStartBar - liq_pivot_len)

        if maxOff >= 0
            for off = 0 to maxOff
                float pHigh = pHighSeries[off]
                if not na(pHigh)
                    int pBar = bar_index - off - liq_pivot_len

                    if pBar >= liquidityScanStartBar
                        bool isValidLocation = false
                        float distFromZone = 0.0

                        if use_inducement_linking
                            isValidLocation := pHigh <= z.bottom + (syminfo.mintick * liq_side_tol_ticks)
                            distFromZone := math.max(0.0, z.bottom - pHigh)
                        else
                            isValidLocation := pHigh > z.top
                            distFromZone := pHigh - z.top

                        if isValidLocation
                            float distFromZoneCheck = distFromZone
                            float maxDistPrice = effective_liq_max_dist * pip_size
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZoneCheck <= maxDistPrice

                            if distOK
                                bool isCloser = distFromZoneCheck < bestDist
                                bool isSameDistance = distFromZoneCheck == bestDist
                                bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar

                                if isCloser or (isSameDistance and isMoreRecent)
                                    bestDist := distFromZoneCheck
                                    bestLiqPrice := pHigh
                                    bestLiqBar := pBar

        if na(bestLiqBar) and useOneCandleLiquidity
            int localPivotCount = array.size(liqPvtHighPrices)
            if localPivotCount > 0
                for pivotIdx = 0 to localPivotCount - 1
                    float pHigh = array.get(liqPvtHighPrices, pivotIdx)
                    int pBar = array.get(liqPvtHighBars, pivotIdx)

                    if not na(pHigh) and not na(pBar) and pBar >= liquidityScanStartBar and pBar <= bar_index
                        bool isValidLocation = false
                        float distFromZone = 0.0

                        if use_inducement_linking
                            isValidLocation := pHigh <= z.bottom + (syminfo.mintick * liq_side_tol_ticks)
                            distFromZone := math.max(0.0, z.bottom - pHigh)
                        else
                            isValidLocation := pHigh > z.top
                            distFromZone := pHigh - z.top

                        if isValidLocation
                            float maxDistPrice = effective_liq_max_dist * pip_size
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice

                            if distOK
                                float distFromZoneCheck = distFromZone
                                bool isCloser = distFromZoneCheck < bestDist
                                bool isSameDistance = distFromZoneCheck == bestDist
                                bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar

                                if isCloser or (isSameDistance and isMoreRecent)
                                    bestDist := distFromZoneCheck
                                    bestLiqPrice := pHigh
                                    bestLiqBar := pBar

        if not na(bestLiqBar) and bestLiqPrice > 0.0
            bool inductionChanged = na(z.liqHighPrice) or z.liqHighPrice != bestLiqPrice or na(z.liqHighBar) or z.liqHighBar != bestLiqBar

            z.liquidityPrice := bestLiqPrice
            z.liquidityBarIndex := bestLiqBar
            z.liqHighPrice := bestLiqPrice
            z.liqHighBar := bestLiqBar

            if inductionChanged
                z.liquiditySwept := false
                z.liquiditySweptBarIndex := na


            // === TARGET: Absolute lowest point AFTER zone formation, BEFORE inducement ===
            // Find the ABSOLUTE LOWEST low in the strict range:
            // [Zone Creation Bar ... Inducement Bar - 1]
            // This ensures the target comes after the zone was formed, not just within base candles.
            int rangeStart = z.createdBarIndex
            int rangeEnd = bestLiqBar - 1  // STRICTLY before inducement

            float bestTargetPrice = na
            int bestTargetBar = na

            if rangeEnd >= rangeStart and rangeEnd <= bar_index and rangeStart >= 0
                bestTargetBar := getBarOfMinLow(rangeStart, rangeEnd)

                if not na(bestTargetBar) and bestTargetBar >= rangeStart and bestTargetBar <= rangeEnd
                    int targetOffset = bar_index - bestTargetBar
                    if targetOffset >= 0 and targetOffset < 5000  // Safety bounds
                        bestTargetPrice := low[targetOffset]

            bool targetChanged = na(z.liqLowPrice) or z.liqLowPrice != bestTargetPrice or na(z.liqLowBar) or z.liqLowBar != bestTargetBar

            z.liqLowBar := bestTargetBar
            z.liqLowPrice := bestTargetPrice

            if targetChanged
                z.targetSwept := false
                z.targetSweptBarIndex := na

            int supplyLegStart = na
            int supplyLegEnd   = na
            int supplyLegCount = 0

            if not na(z.liqLowBar) and not na(z.liqHighBar)
                supplyLegStart := math.min(z.liqLowBar, z.liqHighBar)
                supplyLegEnd   := math.max(z.liqLowBar, z.liqHighBar)
                supplyLegCount := countOppCandlesInLiquidityRange(
                     supplyLegStart, supplyLegEnd, false, z.liqLowPrice, z.liqHighPrice)

            z.liquidityCandleCount := supplyLegCount
            z.legCandleCount := supplyLegCount

            int minLegCandles = useOneCandleLiquidity ? 1 : 2
            bool hasStrongLeg = supplyLegCount >= minLegCandles
            z.liquidityValid := hasStrongLeg
            z.inactiveReason := hasStrongLeg ? na : "WAITING_STRONG_LIQUIDITY"

            z.liqSource := "MAKUCHAKU_PIVOT"

            z.structureSweepLevel := z.liqLowPrice
            z.structureSweepLevelBar := z.liqLowBar

            int indOff = bar_index - bestLiqBar
            int tgtOff = na(z.liqLowBar) ? na : (bar_index - z.liqLowBar)
            z.liqHighTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            z.liqLowTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na

            array.set(supplyZones, zoneArrayIndex, z)
            db_updateZoneLiquidity(z)
        else
            z.liquidityValid := false
            z.inactiveReason := "WAITING_PIVOT"
            array.set(supplyZones, zoneArrayIndex, z)

        true

f_check_demand_sweeps(int zoneArrayIndex) =>
    Core.Zone z = array.get(demandZones, zoneArrayIndex)
    bool needsPersist = false

    if not na(z.liqLowPrice) and not na(z.liqLowBar) and not z.liquiditySwept and bar_index > z.liqLowBar
        float sweepTolerance = syminfo.mintick * liq_side_tol_ticks
        float sweepLevel = z.liqLowPrice + sweepTolerance
        bool is_sweeping_now = low <= sweepLevel

        if is_sweeping_now
            z.liquiditySwept := true
            z.liquiditySweptBarIndex := bar_index
            z.causedSweep := true
            needsPersist := true

    if z.liquidityValid and not na(z.liqHighPrice) and not na(z.liqHighBar) and not z.targetSwept and bar_index > z.liqHighBar
        float targetSweepTolerance = 0.0
        float targetSweepLevel = z.liqHighPrice - targetSweepTolerance
        bool is_tgt_sweeping_now = high >= targetSweepLevel

        if is_tgt_sweeping_now
            z.targetSwept := true
            z.targetSweptBarIndex := bar_index
            if not z.causedSweep
                z.causedSweep := true
            needsPersist := true

    if needsPersist
        array.set(demandZones, zoneArrayIndex, z)
        db_updateZoneLiquidity(z)
    true  // Return dummy value

f_check_supply_sweeps(int zoneArrayIndex) =>
    Core.Zone z = array.get(supplyZones, zoneArrayIndex)
    bool needsPersist = false

    if not na(z.liqHighPrice) and not na(z.liqHighBar) and not z.liquiditySwept and bar_index > z.liqHighBar
        float sweepTolerance = syminfo.mintick * liq_side_tol_ticks
        float sweepLevel = z.liqHighPrice - sweepTolerance
        bool is_sweeping_now = high >= sweepLevel

        if is_sweeping_now
            z.liquiditySwept := true
            z.liquiditySweptBarIndex := bar_index
            z.causedSweep := true
            needsPersist := true

    if z.liquidityValid and not na(z.liqLowPrice) and not na(z.liqLowBar) and not z.targetSwept and bar_index > z.liqLowBar
        float targetSweepTolerance = 0.0
        float targetSweepLevel = z.liqLowPrice + targetSweepTolerance
        bool is_tgt_sweeping_now = low <= targetSweepLevel

        if is_tgt_sweeping_now
            z.targetSwept := true
            z.targetSweptBarIndex := bar_index
            if not z.causedSweep
                z.causedSweep := true
            needsPersist := true

    if needsPersist
        array.set(supplyZones, zoneArrayIndex, z)
        db_updateZoneLiquidity(z)
    true  // Return dummy value


trimBaseTimeArrays() =>
    maxCount = max_zones * 2
    while array.size(used_demand_base_times) > maxCount
        array.pop(used_demand_base_times)
    while array.size(used_supply_base_times) > maxCount
        array.pop(used_supply_base_times)

trimZoneArrays(bool isDemand) =>
    maxCount = max_zones
    if isDemand
        while array.size(demandZones) > maxCount
            Core.Zone z = array.pop(demandZones)
            recordDiag(206, true, bar_index - z.createdBarIndex, "max zones trimmed")
            db_markInactive(z.id, "max_pruned")  // Mark as inactive before removal
            clear_visual_lifecycle(z.id)
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            if not na(z.idLabel)
                label.delete(z.idLabel)
    else
        while array.size(supplyZones) > maxCount
            Core.Zone z = array.pop(supplyZones)
            recordDiag(206, false, bar_index - z.createdBarIndex, "max zones trimmed")
            db_markInactive(z.id, "max_pruned")  // Mark as inactive before removal
            clear_visual_lifecycle(z.id)
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            if not na(z.targetLine)
                line.delete(z.targetLine)
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            if not na(z.idLabel)
                label.delete(z.idLabel)

zone_overlap_pct(float topA, float bottomA, float topB, float bottomB) =>
    float overlapTop = math.min(topA, topB)
    float overlapBottom = math.max(bottomA, bottomB)
    float overlap = math.max(0.0, overlapTop - overlapBottom)
    float smaller = math.min(topA - bottomA, topB - bottomB)
    smaller <= 0.0 ? 0.0 : overlap / smaller * 100.0

zone_duplicate_candidate(Core.Zone z) =>
    z.active and not z.mitigated and na(z.lastEntryBar)

should_skip_duplicate_zone(float zTop, float zBottom, bool isDemand, int baseBarIdx, bool exactOnly) =>
    bool skip = false
    int sameFormationWindow = displacement_base_scan_bars + formation_leg_scan_bars
    if prevent_duplicate_zones
        if isDemand
            int demandSz = array.size(demandZones)
            if demandSz > 0
                for i = 0 to demandSz - 1
                    Core.Zone z = array.get(demandZones, i)
                    bool overlapsEnough = zone_overlap_pct(zTop, zBottom, z.top, z.bottom) >= duplicate_zone_overlap_pct
                    bool sameFormation = not na(z.createdBarIndex) and math.abs(z.createdBarIndex - baseBarIdx) <= sameFormationWindow
                    bool sameBase = not na(z.createdBarIndex) and z.createdBarIndex == baseBarIdx
                    bool sameBounds = math.abs(z.top - zTop) <= syminfo.mintick * 0.5 and math.abs(z.bottom - zBottom) <= syminfo.mintick * 0.5
                    bool shouldSkip = exactOnly ? (sameBase and sameBounds) : (sameFormation and overlapsEnough and z.bottom <= zBottom)
                    if (exactOnly and shouldSkip) or (not exactOnly and zone_duplicate_candidate(z) and shouldSkip)
                        skip := true
                        break
        else
            int supplySz = array.size(supplyZones)
            if supplySz > 0
                for i = 0 to supplySz - 1
                    Core.Zone z = array.get(supplyZones, i)
                    bool overlapsEnough = zone_overlap_pct(zTop, zBottom, z.top, z.bottom) >= duplicate_zone_overlap_pct
                    bool sameFormation = not na(z.createdBarIndex) and math.abs(z.createdBarIndex - baseBarIdx) <= sameFormationWindow
                    bool sameBase = not na(z.createdBarIndex) and z.createdBarIndex == baseBarIdx
                    bool sameBounds = math.abs(z.top - zTop) <= syminfo.mintick * 0.5 and math.abs(z.bottom - zBottom) <= syminfo.mintick * 0.5
                    bool shouldSkip = exactOnly ? (sameBase and sameBounds) : (sameFormation and overlapsEnough and z.top >= zTop)
                    if (exactOnly and shouldSkip) or (not exactOnly and zone_duplicate_candidate(z) and shouldSkip)
                        skip := true
                        break
    skip

createZone(int baseIdx, bool isDemand, bool isHistorical, int candlesInBase, int legCandles, int zoneUZID, bool allowUsedBase = false) =>
    baseBarIdx = bar_index - baseIdx

    int baseTime = time[baseIdx]
    bool alreadyUsed = false
    bool validOriginCandle = isDemand ? Utils.is_bearish(close[baseIdx], open[baseIdx]) : Utils.is_bullish(close[baseIdx], open[baseIdx])
    if isDemand
        if array.includes(used_demand_base_times, baseTime)
            alreadyUsed := true
    else
        if array.includes(used_supply_base_times, baseTime)
            alreadyUsed := true

    if alreadyUsed and allowUsedBase
        recordDiag(202, isDemand, baseIdx, "continuation base already used")
    if alreadyUsed and not allowUsedBase
        showZoneMiss(baseIdx, isDemand, "base already used", isHistorical ? 203 : 201)
    else if not validOriginCandle
        showZoneMiss(baseIdx, isDemand, "origin candle color invalid", 105)

    if (not alreadyUsed or allowUsedBase) and validOriginCandle
        float baseHigh = high[baseIdx]
        float baseLow  = low[baseIdx]
        float baseOpen = open[baseIdx]
        float baseClose = close[baseIdx]

        // ── v3.2: Body/wick split zone detection (Mangoe methodology) ──────
        // Tracks both body range and wick range separately:
        //   - Proximal line (entry side) = candle BODIES → tighter entries
        //   - Distal line (far side)     = candle WICKS  → captures liquidity grabs
        // Demand: top=bodyHigh, bottom=wickLow | Supply: top=wickHigh, bottom=bodyLow
        float clusterBodyHigh = math.max(baseOpen, baseClose)
        float clusterBodyLow  = math.min(baseOpen, baseClose)
        float clusterWickHigh = baseHigh
        float clusterWickLow  = baseLow
        // Legacy clusterHigh/clusterLow still used downstream (full wick range)
        float clusterHigh = baseHigh
        float clusterLow  = baseLow
        int   actualCandlesInBase = 1
        int   max_base_lookback = 15  // Safety cap: ~1 hour of 5min candles

        for j = 1 to max_base_lookback
            int scanIdx = baseIdx + j
            if scanIdx >= bar_index or scanIdx >= 10000
                break

            float scan_high  = high[scanIdx]
            float scan_low   = low[scanIdx]
            float scan_open  = open[scanIdx]
            float scan_close = close[scanIdx]
            float scan_range = scan_high - scan_low
            float scan_body  = math.abs(scan_close - scan_open)

            // Rule 1 (Range): candle range must be <= ATR(14)
            // Gold/indices: allow up to 1.5x ATR since base candles can be wider on volatile instruments
            float atr_cap = (is_index or is_gold or is_xpt) ? atr14 * 1.5 : atr14
            if scan_range > atr_cap
                break

            // Rule 2 (Body): body must be < threshold of candle range (indecision)
            // Gold/indices base candles have larger body-to-range ratios due to lower wick noise,
            // so use 85% to capture the full consolidation cluster (was 65%, too aggressive).
            float body_threshold = (is_index or is_gold or is_xpt) ? 0.85 : 0.50
            if scan_range > 0 and scan_body >= body_threshold * scan_range
                break

            // Rule 3 (Sideways): candle must not close entirely outside adjacent candle's range
            // Add tolerance for gold/indices where $1-2 overextension is normal in a base.
            float adj_high = high[scanIdx - 1]
            float adj_low  = low[scanIdx - 1]
            float adj_tolerance = (is_index or is_gold or is_xpt) ? atr14 * 0.25 : 0.0
            if scan_close > adj_high + adj_tolerance or scan_close < adj_low - adj_tolerance
                break

            // Candle qualifies — expand cluster (track body and wick separately)
            float scanBodyHigh = math.max(scan_open, scan_close)
            float scanBodyLow  = math.min(scan_open, scan_close)
            if scanBodyHigh > clusterBodyHigh
                clusterBodyHigh := scanBodyHigh
            if scanBodyLow < clusterBodyLow
                clusterBodyLow := scanBodyLow
            if scan_high > clusterWickHigh
                clusterWickHigh := scan_high
            if scan_low < clusterWickLow
                clusterWickLow := scan_low
            if scan_high > clusterHigh
                clusterHigh := scan_high
            if scan_low < clusterLow
                clusterLow := scan_low
            actualCandlesInBase += 1
        // ── End consolidation detection ───────────────────────────────────────

        float base_width = clusterHigh - clusterLow

        bool hasFVG = false
        if use_fvg_confirmation and (baseIdx - 2) >= 0
            if isDemand
                if low[baseIdx - 2] > high[baseIdx]
                    hasFVG := true
            else
                if high[baseIdx - 2] < low[baseIdx]
                    hasFVG := true

            if not hasFVG
                na

        bool proceed_creation = not use_fvg_confirmation or hasFVG
        if not proceed_creation
            showZoneMiss(baseIdx, isDemand, "FVG filter")

        bool isAccuracy = false

        if proceed_creation

            int reactionIdx = baseIdx - 1

            if should_use_accuracy_zones and reactionIdx >= 0
                if isDemand
                    // Demand accuracy: Zone candle high > Reaction candle high
                    if high[baseIdx] > high[reactionIdx]
                        isAccuracy := true
                else
                    // Supply accuracy: Zone candle low < Reaction candle low
                    if low[baseIdx] < low[reactionIdx]
                        isAccuracy := true

        float zTop = na
        float zBottom = na

        if proceed_creation
            // Zone boundary logic (matches good-marking reference):
            //   Accuracy zones: proximal = baseOpen, distal = wick extreme
            //   Normal zones: full base candle range (baseHigh to baseLow)
            if isAccuracy
                if isDemand
                    // Demand Accuracy: Top = OPEN (body top), Bottom = LOW (extreme)
                    zTop := baseOpen
                    zBottom := baseLow
                else
                    // Supply Accuracy: Top = HIGH (extreme), Bottom = OPEN (body bottom)
                    zTop := baseHigh
                    zBottom := baseOpen
            else
                // Normal zones: full candle range
                zTop := baseHigh
                zBottom := baseLow

        int zoneBorderWidth = 1
        color zoneBgColor = na
        color zoneBorderColorFinal = na
        bool duplicateSkipped = false

        if not na(zTop) and not na(zBottom) and should_skip_duplicate_zone(zTop, zBottom, isDemand, baseBarIdx, allowUsedBase)
            duplicateSkipped := true
            showZoneMiss(baseIdx, isDemand, allowUsedBase ? "continuation exact duplicate" : "duplicate same leg", allowUsedBase ? 204 : 205)
            zTop := na
            zBottom := na

        if proceed_creation and not duplicateSkipped and (na(zTop) or na(zBottom))
            recordDiag(207, isDemand, baseIdx, "bounds na")

        if not na(zTop) and not na(zBottom)
            zoneBorderWidth := isAccuracy ? 2 : 1  // Slightly thicker border for accuracy zones

            if isAccuracy
                if isDemand
                    zoneBgColor := col_acc_demand_bg
                    zoneBorderColorFinal := col_acc_demand_border
                else
                    zoneBgColor := col_acc_supply_bg
                    zoneBorderColorFinal := col_acc_supply_border
            else
                zoneBgColor := isDemand ? col_demand_bg : col_supply_bg
                zoneBorderColorFinal := isDemand ? col_demand_border : col_supply_border

            box b = box.new(left = baseBarIdx, top = zTop, right = baseBarIdx + zone_projection_bars, bottom = zBottom,
                 border_color = zoneBorderColorFinal,
                 border_width = zoneBorderWidth,
                 bgcolor = zoneBgColor,
                 xloc = xloc.bar_index)

            string accTag = isAccuracy ? "⭐ ACC " : ""

            if show_debug_labels and isAccuracy
                string debugInfo = ""
                if isDemand
                    float zoneHigh = high[baseIdx]
                    float reactionHigh = high[baseIdx - 1]
                    debugInfo := " [Z:" + str.tostring(zoneHigh, format.mintick) + " > R:" + str.tostring(reactionHigh, format.mintick) + "]"
                else
                    float zoneLow = low[baseIdx]
                    float reactionLow = low[baseIdx - 1]
                    debugInfo := " [Z:" + str.tostring(zoneLow, format.mintick) + " < R:" + str.tostring(reactionLow, format.mintick) + "]"

                accTag := accTag + debugInfo

            string sideTag = isDemand ? "D-" : "S-"
            string compactText = sideTag + str.tostring(zoneUZID)
            string detailedText = (isDemand ? "Demand " : "Supply ") + compactText
            string id_text = " " + (zone_label_style == "Detailed" ? detailedText : compactText) + " "
            float mid = (zTop + zBottom) / 2.0
            color lbl_bg_color = na
            if isAccuracy
                lbl_bg_color := isDemand ? col_acc_demand_lbl : col_acc_supply_lbl
            else
                lbl_bg_color := isDemand ? col_demand_lbl : col_supply_lbl
            label idLbl = show_zone_labels ? label.new(x = baseBarIdx + zone_projection_bars, y = mid, text = id_text,
                 style = label.style_label_left, textcolor = color.white, color = lbl_bg_color,
                 size = size.tiny,  // Forced tiny size for clean chart
                 textalign = text.align_center, xloc = xloc.bar_index) : na

            Core.Zone z = Core.Zone.new()
            z.id := zoneUZID
            z.boxId := b
            z.top := zTop
            z.bottom := zBottom
            z.active := true
            z.leftZone := true
            z.createdBarIndex := baseBarIdx
            z.isHistorical := isHistorical
            z.startTime := time[baseIdx]
            z.idLabel := idLbl
            z.touchCount := 0
            z.isAccuracy := isAccuracy  // Tag zone type for trade tracking
            z.peakBarIndex := na
            z.peakPrice := na

            z.score := Core.calculate_zone_score(isDemand, zTop, zBottom, baseIdx, legCandles, false, false, actualCandlesInBase, isAccuracy, is_uptrend, is_downtrend, time[baseIdx])
            z.grade := Core.get_grade_from_score(z.score)

            int baseEndAbsolute = baseBarIdx + actualCandlesInBase - 1
            z.baseEndBarIndex := baseEndAbsolute
            z.departureEndBarIndex := bar_index
            z.firstInvalidBarIndex := bar_index + 1
            z.structureBreakBarIndex := na
            z.stateReason := "CONFIRMED_WAIT_RUNTIME_DEPARTURE"
            float temp_base_quality = Core.calculate_base_quality(baseEndAbsolute, baseBarIdx, bar_index, high, low, open, close)
            float temp_departure_strength = Core.calculate_departure_strength(baseIdx, isDemand, high, low, open, close, atr14, base_width, actualCandlesInBase)

            if enable_v6_v7_features
                z.baseQuality := temp_base_quality
                z.departureStrength := temp_departure_strength
            else
                z.baseQuality := 50.0
                z.departureStrength := 50.0

            if show_grade_on_zone and zone_label_style == "Compact"
                string gradeStr = "[" + z.grade + "] "
                label.set_text(idLbl, gradeStr + id_text)

            if isDemand
                array.unshift(demandZones, z)
                db_upsertZone(z, "DEMAND")
                recordDiag(208, true, baseIdx, "zone created")
                if not array.includes(used_demand_base_times, baseTime)
                    array.push(used_demand_base_times, baseTime)
                trimBaseTimeArrays()
                trimZoneArrays(true)
                recordDiag(307, true, baseIdx, "active after creation")
            else
                array.unshift(supplyZones, z)
                db_upsertZone(z, "SUPPLY")
                recordDiag(208, false, baseIdx, "zone created")
                if not array.includes(used_supply_base_times, baseTime)
                    array.push(used_supply_base_times, baseTime)
                trimBaseTimeArrays()
                trimZoneArrays(false)
                recordDiag(307, false, baseIdx, "active after creation")

remove_zone_all_arrays(bool isDemand, int idx) =>
    if isDemand
        if idx >= 0 and idx < array.size(demandZones)
            Core.Zone z = array.get(demandZones, idx)
            db_markInactive(z.id, "removed")  // Mark as inactive before removal
            clear_visual_lifecycle(z.id)
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na  // Explicitly free memory
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na  // Explicitly free memory
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na  // Explicitly free memory
            if not na(z.idLabel)
                label.delete(z.idLabel)
                z.idLabel := na  // Explicitly free memory
            array.remove(demandZones, idx)
    else
        if idx >= 0 and idx < array.size(supplyZones)
            Core.Zone z = array.get(supplyZones, idx)
            db_markInactive(z.id, "removed")  // Mark as inactive before removal
            clear_visual_lifecycle(z.id)
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na  // Explicitly free memory
            if not na(z.targetLine)
                line.delete(z.targetLine)
                z.targetLine := na  // Explicitly free memory
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na  // Explicitly free memory
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na  // Explicitly free memory
            if not na(z.idLabel)
                label.delete(z.idLabel)
                z.idLabel := na  // Explicitly free memory
            array.remove(supplyZones, idx)

getLiquidityDistance(Core.Zone z, bool isSupply) =>
    if z.liqSource == TOUCH_SWEEP_SOURCE
        0.0
    else
        float dist = na
        if isSupply
            if not na(z.liqHighPrice) and not na(z.bottom)
                dist := (z.bottom - z.liqHighPrice) / pip_size
        else
            if not na(z.liqLowPrice) and not na(z.top)
                dist := (z.liqLowPrice - z.top) / pip_size
        na(dist) ? na : math.abs(dist)

checkLiquidityDistance(Core.Zone z, bool isSupply) =>
    if liq_entry_max_dist == 0.0
        true  // No limit when set to 0
    else
        float dist = getLiquidityDistance(z, isSupply)
        na(dist) or dist <= liq_entry_max_dist

// RD lifecycle catch-up invalidation.
// After a zone leaves, a return that closes back inside/through the proximal side
// fails the setup. This is checked historically too, so replay/reload paths match live.
zone_failed_after_leave(Core.Zone z, bool isDemand) =>
    bool failed = false
    bool hasLeft = false
    int maxOff = na(z.createdBarIndex) ? 0 : math.min(bar_index - z.createdBarIndex - 1, 300)
    if maxOff > 0
        for offsetWalk = 0 to maxOff
            int off = maxOff - offsetWalk
            if failed
                break
            if isDemand
                if low[off] < z.bottom or close[off] < z.bottom
                    failed := true
                else if not hasLeft
                    if close[off] > z.top
                        hasLeft := true
                else
                    bool sweepPrior = z.liquiditySwept and not na(z.liquiditySweptBarIndex) and z.liquiditySweptBarIndex < (bar_index - off)
                    if not sweepPrior and close[off] <= z.top
                        failed := true
            else
                if high[off] > z.top or close[off] > z.top
                    failed := true
                else if not hasLeft
                    if close[off] < z.bottom
                        hasLeft := true
                else
                    bool sweepPrior = z.liquiditySwept and not na(z.liquiditySweptBarIndex) and z.liquiditySweptBarIndex < (bar_index - off)
                    if not sweepPrior and (high[off] >= z.bottom or close[off] >= z.bottom)
                        failed := true
    failed

is_time_dead_zone() =>
    if not filter_dead_zone
        false
    else
        int currentMinute = minute(time)
        currentMinute >= 50

is_outside_trading_hours() =>
    if not filter_trading_hours
        false
    else
        int israelHour = hour(time, "Asia/Jerusalem")
        israelHour < trading_start_hour or israelHour >= trading_end_hour

validate_entry_conditions(bool isDemand, int idx) =>
    bool canEnter = true
    string reason = ""
    Core.Zone z = na

    if isDemand
        if idx < 0 or idx >= array.size(demandZones)
            canEnter := false
            reason := "Invalid demand zone index"
        else
            z := array.get(demandZones, idx)
    else
        if idx < 0 or idx >= array.size(supplyZones)
            canEnter := false
            reason := "Invalid supply zone index"
        else
            z := array.get(supplyZones, idx)

    if canEnter
        if not z.active
            canEnter := false
            reason := isDemand ? "Demand zone inactive" : "Supply zone inactive"

    if canEnter and is_time_dead_zone()
        canEnter := false
        reason := "Dead Zone: Blocked at " + str.tostring(minute(time)) + "m (avoid xx:50-xx:00)"

    if canEnter and is_outside_trading_hours()
        canEnter := false
        int israelHour = hour(time, "Asia/Jerusalem")
        reason := "Outside Trading Hours: " + str.tostring(israelHour) + ":00 (allowed: " + str.tostring(trading_start_hour) + ":00-" + str.tostring(trading_end_hour) + ":00)"

    if canEnter
        if canEnter and not z.causedSweep
            canEnter := false
            reason := isDemand ? "Waiting for Inducement Sweep (Demand)" : "Waiting for Inducement Sweep (Supply)"
        if canEnter and z.isHistorical
            canEnter := false
            reason := isDemand ? "Demand zone created in historical backfill" : "Supply zone created in historical backfill"

        if canEnter and require_liquidity_sweep
            if not z.liquidityValid
                canEnter := false
                reason := isDemand ? "Demand liquidity invalid (candle-count rule failed)" : "Supply liquidity invalid (candle-count rule failed)"
            else if not z.liquiditySwept
                canEnter := false
                reason := isDemand ? "Waiting for Inducement Sweep (Demand)" : "Waiting for Inducement Sweep (Supply)"
            else if not z.targetSwept
                canEnter := false
                reason := isDemand ? "Waiting for Target HIGH Sweep (Demand)" : "Waiting for Target LOW Sweep (Supply)"
            else if na(z.liquiditySweptBarIndex) or bar_index < z.liquiditySweptBarIndex
                canEnter := false
                reason := isDemand ? "Demand entry before liquidity sweep bar" : "Supply entry before liquidity sweep bar"
            else if na(z.targetSweptBarIndex)
                canEnter := false
                reason := "Target sweep bar index not set"
            else
                // Liq distance check: scan distance already constrains pivot selection
                // Gold/indices: no additional entry gate (scan distance = 150/500 pips is sufficient)
                // Forex: use profile-based liq_entry_max_dist (8-15 pips)
                if not (is_gold or is_index or is_xpt) and liq_entry_max_dist > 0.0
                    if not checkLiquidityDistance(z, not isDemand)
                        float liqDist = getLiquidityDistance(z, not isDemand)
                        canEnter := false
                        reason := "Liq distance too far (" + str.tostring(liqDist, "#.#") + " pips > " + str.tostring(liq_entry_max_dist, "#.#") + ")"
        else if canEnter and not require_liquidity_sweep
            if not z.liquidityValid
                reason := "OK (liquidity optional; none/invalid)"


        float touchTolerance = 0.0  // Strict touch required
        bool wickIntoZone = false

        if canEnter
            bool currentTouch = false
            if isDemand
                currentTouch := low <= (z.top + touchTolerance) and low >= (z.bottom - touchTolerance)
            else
                currentTouch := high >= (z.bottom - touchTolerance) and high <= (z.top + touchTolerance)

            if currentTouch
                z.wasTouched := true

            bool prevTouch = isDemand ? (low[1] <= z.top + touchTolerance) : (high[1] >= z.bottom - touchTolerance)

            wickIntoZone := currentTouch or prevTouch

            if not wickIntoZone
                canEnter := false
                reason := isDemand ? "No wick INTO demand zone" : "No wick INTO supply zone"

        bool zone_already_used = not na(z.lastEntryBar)
        if canEnter and zone_already_used
            canEnter := false
            reason := isDemand ? "Demand zone already used for a trade" : "Supply zone already used for a trade"

        if canEnter and z.mitigated
            canEnter := false
            reason := isDemand ? "Demand zone mitigated before liquidity sweep" : "Supply zone mitigated before liquidity sweep"

        bool zoneIsFresh = na(z.startTime) or (time - z.startTime) <= (24 * 60 * 60 * 1000)
        if canEnter and not zoneIsFresh
            canEnter := false
            reason := isDemand ? "Demand zone older than 24h" : "Supply zone older than 24h"

        bool zone_created_after_min_bar = na(z.createdBarIndex) or z.createdBarIndex >= min_bar_index_for_entries
        if canEnter and not zone_created_after_min_bar
            canEnter := false
            reason := "Zone created before min bar index"

    [canEnter, reason, z]

