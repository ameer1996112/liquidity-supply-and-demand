// === INDEX AND OIL TP RULES ===
// Fixed 1:3 ratio for index and oil trades
get_index_tp_rules(sl_pips) =>
    float tp_ratio = 3.0           // Fixed 1:3
    float be_trigger_rr = na       // No BE
    float be_sl_pips_min = na      // No BE
    bool move_to_be = false
    
    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]

// === 2025 TP LOOKUP DICTIONARIES ===
get_tp_ratio(symbol_type, sl_pips) =>
    // Default variables
    float base_ratio = 2.0
    float be_trig = na
    float be_sl = na
    bool move_be = false

    // CHECK: If custom RR override is enabled, use fixed ratio for everything except indices
    if use_custom_rr and not is_index
        base_ratio := risk_reward_ratio
        be_trig := na
        be_sl := na
        move_be := false
    // 1. Check for Indices (NAS100, SPX, etc.) & Oil - Fixed 1:3
    else if is_index or syminfo.ticker == "USOIL" or syminfo.ticker == "USOIL.cash" or syminfo.ticker == "CL" or syminfo.ticker == "CL1!"
        [i_tp, i_bet, i_bes, i_mbe] = get_index_tp_rules(sl_pips)
        base_ratio := i_tp
        be_trig := i_bet
        be_sl := i_bes
        move_be := i_mbe
    // 1b. Check for Gold - Fixed 1:4
    else if is_gold
        base_ratio := 4.0
        be_trig := na
        be_sl := na
        move_be := false
    // 2. Aggressive profile: Gold / JPY&Forex SL-based rules; 1:4 for other (e.g. silver, crypto)
    else if is_aggressive and use_profile_defaults
        if is_gold
            [g_tp, g_bet, g_bes, g_mbe] = get_gold_tp_rules_aggressive(sl_pips)
            base_ratio := g_tp
            be_trig := g_bet
            be_sl := g_bes
            move_be := g_mbe
        else if is_jpy_pair or (not is_silver and not is_crypto)
            // JPY and Forex: same aggressive SL-based rules
            [f_tp, f_bet, f_bes, f_mbe] = get_jpy_tp_rules_aggressive(sl_pips)
            base_ratio := f_tp
            be_trig := f_bet
            be_sl := f_bes
            move_be := f_mbe
        else
            // Other (silver, crypto, etc.): 1:4
            base_ratio := 4.0
            be_trig := na
            be_sl := na
            move_be := false
    // 3. Conservative/Balanced/Custom: existing rules
    else if is_gold
        [g_tp, g_bet, g_bes, g_mbe] = get_gold_tp_rules(sl_pips)
        base_ratio := g_tp
        be_trig := g_bet
        be_sl := g_bes
        move_be := g_mbe
    else
        [f_tp, f_bet, f_bes, f_mbe] = get_forex_tp_rules(sl_pips)
        base_ratio := f_tp
        be_trig := f_bet
        be_sl := f_bes
        move_be := f_mbe

    // Apply double TP mode if enabled (only affects TP ratio, not BE rules)
    if enable_double_tp
        base_ratio := get_double_tp_ratio(base_ratio)

    [base_ratio, be_trig, be_sl, move_be]

// === AI FEATURE ENGINEERING ===
// Calculate indicators globally for training data collection
float feature_rsi = ta.rsi(close, 14)
float feature_ema200 = ta.ema(close, 200)
int feature_trend = close > feature_ema200 ? 1 : 0
// Added ADX Volatility Strength
[diplus, diminus, feature_adx] = ta.dmi(14, 14)
// Removed Volume (tick volume irrelevant for Forex structure) - added placeholder
int feature_hour = hour(time)

// Session ID for AI: 0=Asian, 1=London, 2=NY, 3=Off-hours
// Using UTC times: Asian=0-7, London=7-12, NY=12-21, Off=21-24
f_get_session_id() =>
    int h = hour(time, "UTC")
    if h >= 0 and h < 7
        0  // Asian
    else if h >= 7 and h < 12
        1  // London
    else if h >= 12 and h < 21
        2  // NY
    else
        3  // Off-hours

int feature_session = f_get_session_id()

// === V3 FEATURES: HTF Trend & RVOL ===
// 1. HTF Trend (1 Hour EMA 200)
// Get 60m data. If we are on > 60m chart, specific logic applies, but assuming < 60m execution:
float htf_ema200 = request.security(syminfo.tickerid, "60", ta.ema(close, 200))
float htf_close = request.security(syminfo.tickerid, "60", close)
int feature_htf_trend = htf_close > htf_ema200 ? 1 : 0

// 2. Relative Volume (RVOL)
// Volume relative to 20-period average volume
float vol_avg = ta.sma(volume, 20)
float feature_rvol = vol_avg > 0 ? volume / vol_avg : 0.0

