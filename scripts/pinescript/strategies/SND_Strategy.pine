max_sweep_to_touch_bars = input.int(30, "Max Sweep to Touch Bars", minval = 1, maxval = 500, group = "⚙️ Advanced / Manual Tweaks", tooltip = "Maximum allowed bars between the liquidity sweep and the zone touch. Blocks setups where price consolidates too long after sweeping.")
max_peak_to_touch_bars = input.int(15, "Max Peak to Touch Bars", minval = 1, maxval = 500, group = "⚙️ Advanced / Manual Tweaks", tooltip = "Maximum allowed bars from the structural extreme (peak) after sweep to the zone touch. Ensures the return drop/rally is fast.")

