        liq_max_distance_pips_gold := 100.0
        liq_entry_max_dist := 8.0
        min_entry_grade := "B+"
        if not use_custom_rr
            risk_reward_ratio := 3.0
        max_trades_per_day := 1
        min_tp_distance_pips := 15.0
    else if is_balanced
        pvtMax := 5
        liq_pivot_len := 5
        liq_max_distance_pips_forex := 20.0
        liq_max_distance_pips_gold := 150.0
        liq_entry_max_dist := 10.0
        min_entry_grade := "C+"
        if not use_custom_rr
            risk_reward_ratio := 2.0
        max_trades_per_day := 2
        min_tp_distance_pips := 10.0
    else  // Aggressive
        pvtMax := 10
        liq_pivot_len := 3
        liq_max_distance_pips_forex := 20.0
        liq_max_distance_pips_gold := 200.0
        liq_entry_max_dist := 15.0
        min_entry_grade := "C"
        if not use_custom_rr
            risk_reward_ratio := 1.5
        max_trades_per_day := 2
        min_tp_distance_pips := 5.0


    if is_aggressive and not (is_gold or is_index or is_xpt)
        liq_max_distance_pips_forex := 12.0  // ← Reduced from 20 (split between Aggressive 20 and Balanced 15)
        liq_entry_max_dist := 12.0           // ← Entry gate tighter than scan (12 pips scan, 12 pips gate = same quality)

        min_entry_grade := "C+"              // ← Improved from "C" (better zone quality)


        min_tp_distance_pips := 8.0          // ← Up from 5 (prevents spread eating profits)

    require_major_liquidity := is_conservative or is_balanced
    structure_mode := is_conservative ? "Standard (Bodies)" : "Relaxed (Wicks)"
    // Grade filter and HTF flip: only for forex (good-marking doesn't use these)
    enable_grade_filter := (is_conservative or is_balanced) and not (is_gold or is_index or is_xpt)
    require_htf_flip := (is_conservative or is_balanced) and not (is_gold or is_index or is_xpt)
    stop_loss_buffer_pips := 1.0

debug_enabled   = debug_level != "None"
debug_full      = (debug_level == "Full") or (debug_level != "None" and debug_mode)
debug_basic     = debug_level == "Basic"
showDebugPanels = (debug_level != "None")

