liq_pivot_len       = input.int(5, "Pivot Strength", minval = 1, group = "⚙️ Advanced / Manual Tweaks", tooltip = "How many candles on each side to confirm a swing high/low. Higher = Fewer but stronger pivots. Lower = More pivots but weaker.")
