var bool is_xpt = str.contains(syminfo.ticker, "XPTUSD") or str.contains(syminfo.ticker, "PLATINUM") or str.contains(syminfo.ticker, "XPT")
var bool is_usd_base = str.startswith(syminfo.ticker, "USD") and not str.endswith(syminfo.ticker, "USD")
var bool is_usd_quote = (str.contains(syminfo.ticker, "USD") and not is_usd_base) or is_gold or is_silver or is_crypto or is_xpt


var float usdjpy_rate_cache = na
var int usdjpy_cache_bar = na

get_cached_usdjpy_rate() =>
    if is_jpy_pair and not na(usdjpy_cache_bar) and bar_index == usdjpy_cache_bar
        usdjpy_rate_cache
    else if is_jpy_pair
        USDJPY_FALLBACK  // Will be updated by cache update logic below
    else
        1.0

if is_jpy_pair and (na(usdjpy_cache_bar) or bar_index != usdjpy_cache_bar)
    float rate = na

    if str.contains(syminfo.ticker, "VANTAGE")
        rate := request.security("VANTAGE:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
    if na(rate)
        rate := request.security("USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
    if na(rate)
        rate := request.security("FX_IDC:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
    if na(rate)
        rate := request.security("OANDA:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)

    usdjpy_rate_cache := na(rate) or rate <= 0 ? USDJPY_FALLBACK : rate
    usdjpy_cache_bar := bar_index


var float rate_usdcad = na
var float rate_usdchf = na
var float rate_gbpusd = na
var float rate_audusd = na
var float rate_nzdusd = na
var float rate_eurusd = na
var int currency_cache_bar = na

if bar_index != currency_cache_bar
    rate_usdcad := request.security("USDCAD", timeframe.period, close, lookahead = barmerge.lookahead_off)
    rate_usdchf := request.security("USDCHF", timeframe.period, close, lookahead = barmerge.lookahead_off)
    rate_gbpusd := request.security("GBPUSD", timeframe.period, close, lookahead = barmerge.lookahead_off)
    rate_audusd := request.security("AUDUSD", timeframe.period, close, lookahead = barmerge.lookahead_off)
    rate_nzdusd := request.security("NZDUSD", timeframe.period, close, lookahead = barmerge.lookahead_off)
    rate_eurusd := request.security("EURUSD", timeframe.period, close, lookahead = barmerge.lookahead_off)
    currency_cache_bar := bar_index

atr14 = ta.atr(14)

vol_sma_20 = ta.sma(volume, 20)

const int LIQ_SWEEP_LOOKBACK = 10
float lookback_high_10 = ta.highest(high, LIQ_SWEEP_LOOKBACK)
float lookback_low_10 = ta.lowest(low, LIQ_SWEEP_LOOKBACK)

float body_size_0 = math.abs(close - open)
float body_size_1 = math.abs(close[1] - open[1])
float body_size_2 = math.abs(close[2] - open[2])
float avg_body_size_3 = (body_size_0 + body_size_1 + body_size_2) / 3.0

float structure_high_20 = ta.highest(high, 20)
float structure_low_20 = ta.lowest(low, 20)


