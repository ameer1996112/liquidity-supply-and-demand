f_is_fractal_low_custom(len) =>
    bool enoughBars = len >= 1 and bar_index >= len * 2
    bool cond = true
    if enoughBars
        float centerLow = low[len]
        if low[len - 1] <= centerLow or low[len + 1] <= centerLow
            cond := false
        else
            for i = 0 to len * 2
                if low[i] < centerLow
                    cond := false
                    break
    enoughBars and cond

f_is_fractal_high_custom(len) =>
    bool enoughBars = len >= 1 and bar_index >= len * 2
    bool cond = true
    if enoughBars
        float centerHigh = high[len]
        if high[len - 1] >= centerHigh or high[len + 1] >= centerHigh
            cond := false
        else
            for i = 0 to len * 2
                if high[i] > centerHigh
                    cond := false
                    break
    enoughBars and cond

is_fractal_low_custom = f_is_fractal_low_custom(liq_pivot_len)
is_fractal_high_custom = f_is_fractal_high_custom(liq_pivot_len)

pLowSeries = is_fractal_low_custom ? low[liq_pivot_len] : na
pHighSeries = is_fractal_high_custom ? high[liq_pivot_len] : na

