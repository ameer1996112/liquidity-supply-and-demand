float tol = pip_size * 1.0

// Forex TP/BE rules — apply to ALL forex pairs (JPY, GBP, EUR, etc.)
// SL ≤ 3 pips  → 1:4.5 TP, move SL to +2 pips at 1:4
// SL 3.1-7     → 1:3 TP,   move SL to entry at 1:2
// SL 7.1-11    → 1:2.5 TP, move SL to entry at 1:1.2
// SL > 11      → 1:2 TP,   no BE move
get_forex_tp_rules(sl_pips) =>
    float tp_ratio = 2.0
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 3.0
        tp_ratio := 4.5
        be_trigger_rr := 4.0
        be_sl_pips_min := 2.0  // Move to +2 pips profit
        move_to_be := true
    else if sl_pips <= 7.0
        tp_ratio := 3.0
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0  // Move to entry (BE)
        move_to_be := true
    else if sl_pips <= 11.0
        tp_ratio := 2.5
        be_trigger_rr := 1.2
        be_sl_pips_min := 0.0  // Move to entry (BE)
        move_to_be := true
    else
        tp_ratio := 2.0
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]



get_gold_tp_rules(sl_pips) =>
    float tp_ratio = 1.5
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 50.0
        tp_ratio := 4.5
        be_trigger_rr := 4.0   // Move to BE generally
        be_sl_pips_min := 5.0  // Min 5 pips profit
        move_to_be := true
    else if sl_pips <= 100.0
        tp_ratio := 3.0
        be_trigger_rr := 2.75
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else if sl_pips <= USDJPY_FALLBACK
        tp_ratio := 2.5
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else if sl_pips <= 200.0
        tp_ratio := 2.0
        be_trigger_rr := 1.75
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else
        tp_ratio := 1.5
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]


get_gold_tp_rules_aggressive(sl_pips) =>
    float tp_ratio = 1.5
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 50.0
        tp_ratio := 4.5
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false
    else if sl_pips <= 100.0
        tp_ratio := 3.0
        be_trigger_rr := 2.75
        be_sl_pips_min := 0.0
        move_to_be := true
    else if sl_pips <= 150.0
        tp_ratio := 2.5
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0
        move_to_be := true
    else if sl_pips <= 200.0
        tp_ratio := 2.0
        be_trigger_rr := 1.75
        be_sl_pips_min := 0.0
        move_to_be := true
    else
        tp_ratio := 1.5
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]


get_tp_ratio(symbol_type, sl_pips) =>
    float base_ratio = 2.0
    float be_trig = na
    float be_sl = na
    bool move_be = false

    if use_custom_rr and not is_index
        base_ratio := risk_reward_ratio
        be_trig := na
        be_sl := na
        move_be := false
    else if is_index or syminfo.ticker == "USOIL" or syminfo.ticker == "USOIL.cash" or syminfo.ticker == "CL" or syminfo.ticker == "CL1!"
        base_ratio := 3.0
        be_trig := na
        be_sl := na
        move_be := false
    else if is_gold or is_xpt
        base_ratio := 4.0
        be_trig := na
        be_sl := na
        move_be := false
    else if is_aggressive and use_profile_defaults
        if is_gold or is_xpt
            [g_tp, g_bet, g_bes, g_mbe] = get_gold_tp_rules_aggressive(sl_pips)
            base_ratio := g_tp
            be_trig := g_bet
            be_sl := g_bes
            move_be := g_mbe
        else if is_jpy_pair or (not is_silver and not is_crypto)
            [f_tp, f_bet, f_bes, f_mbe] = get_forex_tp_rules(sl_pips)
            base_ratio := f_tp
            be_trig := f_bet
            be_sl := f_bes
            move_be := f_mbe
        else
            base_ratio := 4.0
            be_trig := na
            be_sl := na
            move_be := false
    else if is_gold or is_xpt
        [g_tp, g_bet, g_bes, g_mbe] = get_gold_tp_rules(sl_pips)
        base_ratio := g_tp
        be_trig := g_bet
        be_sl := g_bes
        move_be := g_mbe
    else
        [f_tp, f_bet, f_bes, f_mbe] = get_forex_tp_rules(sl_pips)
        base_ratio := f_tp
        be_trig := f_bet
        be_sl := f_bes
        move_be := f_mbe

    if enable_double_tp
        base_ratio := base_ratio * 2.0

    [base_ratio, be_trig, be_sl, move_be]

