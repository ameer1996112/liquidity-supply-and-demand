// Dynamic liq distance threshold: scale up with RVOL so high-volume bars allow further liquidity
// RVOL 1.0 (normal) → 1.0x base | RVOL 1.5 → 1.5x | RVOL 2.0+ → 2.0x (capped)
float rvol_scale = math.max(1.0, math.min(feature_rvol, 2.0))
