// Zone Detection
invalidate_on_wick   = input.bool(true, "Invalidate on Wick Touch", group = "⚙️ Advanced / Manual Tweaks", tooltip = "ON: Zone becomes invalid if ANY wick penetrates it. OFF: Only body closes invalidate zones.")
max_zones            = input.int(20, "Max Zones Displayed", minval = 1, maxval = 50, group = "⚙️ Advanced / Manual Tweaks", tooltip = "Maximum number of zones to show on chart. More = cluttered but complete history.")
min_body_perc        = input.float(50.0, "Min Body %", minval = 0, maxval = 100, group = "⚙️ Advanced / Manual Tweaks", tooltip = "Minimum candle body percentage for strong impulse detection. 50% = body must be at least half of candle range.")

