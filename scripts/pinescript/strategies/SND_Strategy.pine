// - SL ≤ 100: min 1:3, BE at 1:2.75
// - SL 100–150: close full 1:2.5, BE at 1:2
// - SL 150–200: close full 1:2, BE at 1:1.75
// - SL 200+: close full 1:1.5
get_gold_tp_rules_aggressive(sl_pips) =>
    float tp_ratio = 1.5
