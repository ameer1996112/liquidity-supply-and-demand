account_size_usd      = input.float(50000, "💰 Account Size ($)", minval = 100, step = 1000, group = "🎯 Quick Setup", tooltip = "⚠️ MUST MATCH YOUR LIVE ACCOUNT BALANCE!\n\nThis is used to calculate position sizes:\n• Position Size = Account × Risk% / SL Distance\n• Sent to backend for validation\n\nExamples:\n• Prop firm challenge: $50,000\n• Personal account: $10,000\n• Demo/Paper: $10,000\n\nIf mismatch with live balance, backend will reject trades!")
risk_per_trade_pct    = input.float(0.5, "Risk Per Trade (%)", minval = 0.1, maxval = 10, step = 0.1, group = "🎯 Quick Setup", tooltip = "Percentage of account to risk per trade.\n\n0.5% (Balanced - Recommended):\n• $50k account = $250 max risk/trade\n• Survives 200 consecutive losses\n\n1.0% (Aggressive):\n• $50k account = $500 max risk/trade\n• Survives 100 consecutive losses")
