max_bars_held = input.int(36, "Time-Based Exit (Bars)", minval=1, group = "⚙️ Advanced / Manual Tweaks", tooltip="Close trade after X bars regardless of P/L. 36 bars on M5 = 3 hours max hold time.")
enable_double_tp = input.bool(false, "Double TP Mode", group = "⚙️ Advanced / Manual Tweaks", tooltip = "ON: Double all TP targets. Example: 1:2 becomes 1:4. For trending markets.")
use_fvg_confirmation = input.bool(false, "Require FVG (Imbalance)", group = "⚙️ Advanced / Manual Tweaks", tooltip = "ON: Only create zones that have a Fair Value Gap. Reduces zones but improves quality.")
enable_accuracy_zones = input.bool(true, "Accuracy Zones", group = "⚙️ Advanced / Manual Tweaks", tooltip = "ON: Detect high-precision zones. Auto-disabled for Gold/Indices/Futures/Platinum.")
