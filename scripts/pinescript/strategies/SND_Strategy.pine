// === HELPER: COUNT OPPOSITE CANDLES (MULTI-MODE) ===
countOppositeCandlesInBand(bool isDemand, int fromBar, int toBar, float top, float bottom) =>
    int oppCount = 0
    if na(fromBar) or na(toBar) or na(top) or na(bottom) or fromBar > toBar
        oppCount
    else
        // XAUUSD FIX: Asset-specific overlap tolerance
        // Gold needs looser tolerance due to large pip size (0.1) and high volatility
        float overlapTolerance = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD") ? pip_size * 0.5 : syminfo.mintick / 2.0
        // Determine scan end: clamp to current bar_index
        scanEndBar = math.min(toBar, bar_index)

        // Scan from fromBar to scanEndBar (inclusive)
        if scanEndBar >= fromBar
            for scanOff = 0 to (scanEndBar - fromBar)
                scanBar = fromBar + scanOff
                if scanBar > bar_index
                    break

                // Calculate offset from current bar
                barOffset = bar_index - scanBar
                if barOffset < 0
                    continue

                // Check if candle overlaps with liquidity band
                float c_high_band = high[barOffset]
                float c_low_band  = low[barOffset]
                bool overlapsBand = c_high_band >= (bottom - overlapTolerance) and c_low_band <= (top + overlapTolerance)

                // --- MODE-BASED STRUCTURE DETECTION ---
                bool isStructure = false

                float c_open  = open[barOffset]
                float c_close = close[barOffset]
                float c_high  = high[barOffset]
                float c_low   = low[barOffset]
                float body_size = math.abs(c_close - c_open)
                float total_range = c_high - c_low

                if total_range > syminfo.mintick
                    bool isRed   = c_close < c_open
                    bool isGreen = c_close > c_open

                    // 1. RELAXED (Wicks & Dojis count)
                    if structure_mode == "Relaxed (Wicks)"
                        bool isDoji = body_size <= (total_range * 0.05)
                        if isDemand
                            float upper_wick = c_high - math.max(c_open, c_close)
                            // XAUUSD FIX: Lower wick threshold from 50% to 30% to catch more bearish structure
                            // Gold's high volatility means even 30% wicks are significant rejection
                            bool meaningfulUpperWick = total_range > 0 ? (upper_wick / total_range) >= 0.30 : false
                            isStructure := isRed or isDoji or meaningfulUpperWick
                        else
                            float lower_wick = math.min(c_open, c_close) - c_low
                            // XAUUSD FIX: Lower wick threshold for supply zones too
                            bool meaningfulLowerWick = total_range > 0 ? (lower_wick / total_range) >= 0.30 : false
                            isStructure := isGreen or isDoji or meaningfulLowerWick

                    // 2. STANDARD (Solid Bodies only)
                    else if structure_mode == "Standard (Bodies)"
                        // Must have some body (>10% range) and be opposite color
                        // Wicks do NOT count here
                        if isDemand
                            isStructure := isRed and (body_size > total_range * 0.10)
                        else
                            isStructure := isGreen and (body_size > total_range * 0.10)

                    // 3. STRICT (Strong Moves only)
                    else // Strict (Major Moves)
                        // Must be opposite color and significant body (>30% range)
                        if isDemand
                            isStructure := isRed and (body_size > total_range * 0.30)
                        else
                            isStructure := isGreen and (body_size > total_range * 0.30)

                // Require MEANINGFUL overlap with liquidity band, not just edge touches
                float overlapTop    = math.min(c_high_band, top)
                float overlapBottom = math.max(c_low_band, bottom)
                float overlapRange  = math.max(0.0, overlapTop - overlapBottom)
                // RELAXED: Any overlap with the band counts (no minimum percentage required)
                // This ensures all candles that touch the liquidity band are counted, regardless of candle size
                bool overlapsMeaningfully = overlapsBand and overlapRange > 0

                if overlapsMeaningfully and isStructure
                    // Count only; noisy per-candle debug labels removed to avoid chart spam
                    oppCount += 1
        oppCount

is_strong_body(idx) =>
    body        = math.abs(close[idx] - open[idx])
    total_range = high[idx] - low[idx]
    perc        = total_range > 0 ? body / total_range * 100 : 0
    perc >= min_body_perc

// =============================
// =============================
// =============================
// POSITION SIZE CALCULATOR (Myfxbook Formula)
// =============================
// Formula: Position Size (lots) = (Account Size × Risk %) / (Stop Loss in pips × Pip Value)
// Where Pip Value = (Pip Size / Exchange Rate) × Lot Size
// 
// For JPY pairs: Pip Value = (0.01 / USDJPY_rate) × 100,000
// For non-JPY pairs: Pip Value = 0.0001 × 100,000 = $10 per pip per lot
//
// @param entry: Entry price
// @param stop: Stop loss price
// @param balance: Account balance in USD
// @param risk_pct: Risk percentage per trade (e.g., 0.5 for 0.5%)
// @returns: Position size in lots
calc_pos_size(entry, stop, balance, risk_pct) =>
    // Step 1: Calculate risk amount in USD
    risk_usd = balance * (risk_pct / 100)
    
    // Step 2: Determine pip size based on pair type
    pip_sz = pip_size  // Use the auto-detected or manual pip size
    
    // Step 3: Calculate pip distance (absolute value)
    pip_distance = math.abs(stop - entry)
    sl_pips = pip_distance / pip_sz
    sl_pips := math.max(sl_pips, 0.1)  // Minimum 0.1 pips
    
    // Step 4: Standard lot size for forex (100,000 units)
    lot_size = FOREX_LOT_SIZE
    
    // Step 5: Calculate pip value per lot in USD
    // TradingView formula for pip value:
    // For XXX/USD pairs: pip_value = pip_size * lot_size = $10 per pip per lot
    // For XXX/YYY pairs: pip_value = (pip_size * lot_size) / quote_currency_rate
    float pip_value_per_lot = na
    
    if is_jpy_pair and not is_usdjpy
        // For JPY cross pairs (GBPJPY, EURJPY, etc.) - OPTIMIZED
        float usdjpy_rate = get_cached_usdjpy_rate()
        pip_value_per_lot := (pip_sz * lot_size) / usdjpy_rate
    else if str.contains(syminfo.ticker, "USDJPY")
        pip_value_per_lot := (pip_sz * lot_size) / entry
    else if str.contains(syminfo.ticker, "USD")
        // Pairs ending in USD (EURUSD, GBPUSD, etc.) - pip value is $10 per lot
        pip_value_per_lot := pip_sz * lot_size
    else
        // Cross pairs not ending in USD (GBPCAD, EURGBP, etc.)
        // Need to convert quote currency to USD
        // For GBPCAD: pip_value = (0.0001 * 100000) / USDCAD rate
        // Approximate: use entry price as a proxy (works for most pairs)
        pip_value_per_lot := (pip_sz * lot_size) / entry
    
    // Step 6: Ensure pip_value_per_lot is valid
    if na(pip_value_per_lot) or pip_value_per_lot <= 0
        pip_value_per_lot := pip_sz * lot_size
    
    // Step 7: Calculate position size in lots
    // Formula: Position Size (lots) = Risk USD / (SL pips × Pip Value per lot)
    qty_lots = risk_usd / (sl_pips * pip_value_per_lot)
    
    // Step 8: Validate and round
    if na(qty_lots) or qty_lots <= 0
        qty_lots := 0.001
    else
        qty_lots := math.max(qty_lots, 0.001)
    
    qty_lots := math.round(qty_lots * 1000) / 1000
    
    if na(qty_lots) or qty_lots <= 0
        qty_lots := 0.001
    
    qty_lots

// =============================
// CALCULATE POSITION SIZE IN UNITS (TradingView-compatible)
// =============================
// This function calculates position size in UNITS
// For USD Quote pairs (XAUUSD, EURUSD): 1 unit moving $1 = $1 P/L, so units = risk / price_distance
// For JPY pairs: Need to convert using USDJPY rate
// For USD Base pairs (USDCAD): Use pip-based calculation
// @param entry: Entry price
// @param stop: Stop loss price
// @param risk_usd: Total USD amount to risk on this trade
// @param is_short: true for short, false for long
// @returns: Position size in UNITS (not lots)
calc_pos_size_units(entry, stop, risk_usd, is_short) =>
    // Step 2: Calculate price distance (absolute)
    float price_distance = math.abs(entry - stop)
    
    // CRITICAL SAFETY CLAMP: Enforce minimum 2 pip distance to prevent massive position sizes
    // Without this, a 0.1 pip SL would cause position_units = 50 / 0.01 = 5000 units (on Forex)
    // or on Gold: position_units = 50 / 0.10 = 500 oz = 5 lots (way too big for tight SL)
    float min_distance = 2.0 * pip_size  // Minimum 2 pips
    float effective_distance = math.max(price_distance, min_distance)
    
    // Validate distance is positive
    if effective_distance <= 0
        0.0
    else
        float position_units = na
        ticker = syminfo.ticker

        // Detect symbol type (use local variables with different names to avoid shadowing)
        bool local_is_gold = str.contains(ticker, "XAU") or str.contains(ticker, "GOLD")
        bool local_is_silver = str.contains(ticker, "XAG") or str.contains(ticker, "SILVER")
        bool local_is_crypto = str.contains(ticker, "BTC") or str.contains(ticker, "ETH")
        bool local_is_jpy_pair = str.contains(ticker, "JPY")
        bool local_is_usd_base = str.startswith(ticker, "USD") and not str.endswith(ticker, "USD")
        // USD Quote pairs: Contains USD but doesn't start with USD (like EURUSD, GBPUSD)
        // Also includes Gold/Silver/Crypto which are quoted in USD
        bool local_is_usd_quote = (str.contains(ticker, "USD") and not local_is_usd_base) or local_is_gold or local_is_silver or local_is_crypto
        
        // Case 1: USD Quote pairs (XAUUSD, EURUSD, GBPUSD, AUDUSD, BTCUSD, etc.)
        // For these pairs: 1 unit moving $1 = $1 profit/loss
        // Formula: units = risk_usd / effective_distance
        // Example XAUUSD: $50 risk / $4.56 distance = 10.96 ≈ 11 units
        if local_is_usd_quote and not local_is_jpy_pair
            position_units := risk_usd / effective_distance

        // Case 2: JPY pairs (USDJPY, GBPJPY, EURJPY) - OPTIMIZED
        // Need to convert using USDJPY rate
        else if local_is_jpy_pair
            float usdjpy_rate = get_cached_usdjpy_rate()

            // For JPY pairs: (risk_usd * usdjpy_rate) / effective_distance
            position_units := (risk_usd * usdjpy_rate) / effective_distance
        
        // Case 3: Proper Cross-Pair Handling (Universal)
        else
            // Convert Quote Currency Value to USD
            // e.g. for GBPCAD (Quote CAD), we need value of 1 CAD in USD
            float quote_usd_rate = Utils.get_quote_to_usd_rate(syminfo.currency, rate_usdcad, rate_usdchf, rate_gbpusd, rate_audusd, rate_nzdusd, rate_eurusd, usdjpy_rate_cache)
            
            // position_units = Risk_USD / (Stop Distance * Value_of_1_Unit_in_USD)
            // Value_of_1_Unit_in_USD = 1.0 * quote_usd_rate
            position_units := risk_usd / (effective_distance * quote_usd_rate)
        
        // Round to whole units
        position_units := math.round(position_units)
        
        // Validate - minimum 1 unit
        if na(position_units) or position_units <= 0
            position_units := 1.0
        
        position_units

// =============================
// TRADE EXECUTION VALIDATION
// =============================
// Validates all parameters before executing a trade to ensure it will execute correctly
// @param entry_price: Entry price
// @param stop_loss_price: Stop loss price  
// @param take_profit_price: Take profit price (can be na)
// @param qty_lots: Position size in lots
// @param contract_size: Contract size (100,000 for forex)
// @param is_long: true for long trades, false for short trades
// @returns: [is_valid, qty_units, error_message]
validate_trade_execution(entry_price, stop_loss_price, qty_lots, contract_size) =>
    bool is_valid = true
    int qty_units = na
    string error_msg = ""
    
    // Validate entry price
    if na(entry_price) or entry_price <= 0
        is_valid := false
        error_msg := "Invalid entry price"
    
    // Validate stop loss price
    if na(stop_loss_price) or stop_loss_price <= 0
        is_valid := false
        error_msg := "Invalid stop loss price"
    
    // For long trades: SL must be strictly below entry
    if is_valid and stop_loss_price >= entry_price
        is_valid := false
        error_msg := "SL must be below entry for longs"
    
    // Validate qty_lots
    if na(qty_lots) or qty_lots <= 0
        is_valid := false
        error_msg := "Invalid position size (lots)"
    
    // Calculate contract units - MUST be positive integer for TradingView
    if is_valid
        float raw_units = qty_lots * contract_size
        raw_units := math.round(raw_units)
        raw_units := math.max(raw_units, 1.0)  // Minimum 1 unit
        
        // Convert to integer explicitly
        qty_units := int(raw_units)
        
        // Final validation of contract units - must be positive integer
        if na(qty_units) or qty_units <= 0
            is_valid := false
            error_msg := "Invalid contract units"
    
    [is_valid, qty_units, error_msg]

// =============================
// FETCH USDJPY RATE WITH ERROR HANDLING
// =============================
// Fetches USDJPY rate for JPY pairs, returns [rate, success, error_message]
// @returns: [usdjpy_rate, is_success, error_message]
fetch_usdjpy_rate() =>
    // OPTIMIZED: Use cached rate instead of multiple security calls
    float rate = get_cached_usdjpy_rate()
    bool success = true
    string error_msg = rate == USDJPY_FALLBACK ? "Using fallback rate" : ""

    [rate, success, error_msg]

// =============================
// ENHANCED POSITION SIZING VALIDATION
// =============================
// Comprehensive validation of position size with min/max checks and USDJPY validation
// @param entry_price: Entry price
// @param stop_loss_price: Stop loss price
// @param balance: Account balance in USD
// @param risk_pct: Risk percentage per trade
// @param is_short: true for short trades, false for long trades
// @returns: [is_valid, qty_units, qty_lots, error_message, validation_details, sl_fixed]
validate_position_size(entry_price, stop_loss_price, balance, risk_pct, is_short) =>
    bool is_valid = true
    int qty_units = na
    float qty_lots = na
    string error_msg = ""
    string validation_details = ""
    float sl_fixed = stop_loss_price  // Local copy - function arguments are immutable in Pine Script
    
    // Step 1: Validate entry price
    if na(entry_price) or entry_price <= 0
        is_valid := false
        error_msg := "Invalid entry price"
        validation_details := "Entry price: " + (na(entry_price) ? "NA" : str.tostring(entry_price))
    
    // Step 2: Validate stop loss price
    if is_valid and (na(sl_fixed) or sl_fixed <= 0)
        is_valid := false
        error_msg := "Invalid stop loss price"
        validation_details := "Stop loss: " + (na(sl_fixed) ? "NA" : str.tostring(sl_fixed))
    
    // Step 3: Validate and AUTO-CORRECT price relationship (defensive layer)
    // Instead of rejecting, we auto-fix SL to ensure minimum gap
    // Minimum 2.0 pips gap to prevent "zero profit" trades in the strategy tester
    float minGap = math.max(syminfo.mintick * 2, pip_size * 2.0)  // At least 2 pips
    
    if is_valid
        if is_short
            // For shorts: SL must be ABOVE entry
            if sl_fixed <= entry_price + minGap
                sl_fixed := entry_price + minGap  // Auto-correct
        else
            // For longs: SL must be BELOW entry
            if sl_fixed >= entry_price - minGap
                sl_fixed := entry_price - minGap  // Auto-correct
    
    // Step 4: Validate USDJPY rate for JPY pairs
    if is_valid and str.contains(syminfo.ticker, "JPY")
        [val_usdjpy_rate_result, val_usdjpy_success_result, val_usdjpy_error_result] = fetch_usdjpy_rate()
        if not val_usdjpy_success_result
            is_valid := false
            error_msg := val_usdjpy_error_result
            validation_details := "USDJPY rate unavailable for JPY pairs"
    
    // Step 5: Calculate position size with USD CAP logic
    float qty_units_raw = na
    if is_valid
        // Calculate Target Risk
        float target_risk_usd = balance * (risk_pct / 100.0)
        
        // Apply USD Risk Cap if enabled (max_usd_risk_cap > 0)
        float effective_risk_usd = (max_usd_risk_cap > 0) ? math.min(target_risk_usd, max_usd_risk_cap) : target_risk_usd
        
        qty_units_raw := calc_pos_size_units(entry_price, sl_fixed, effective_risk_usd, is_short)
        
        if na(qty_units_raw) or qty_units_raw <= 0
            is_valid := false
            error_msg := "Position size calculation failed"
            validation_details := "Calculated units: " + (na(qty_units_raw) ? "NA" : str.tostring(qty_units_raw))
        
        // Convert to integer
        if is_valid
            qty_units := int(math.round(qty_units_raw))
            
            // Determine contract size for units-to-lots conversion
            // Gold: 100 oz/lot, Silver: 5000 oz/lot, Crypto: 1 unit/lot, Forex: 100,000 units/lot
            float contract_size = FOREX_LOT_SIZE
            int effective_min_units = min_position_size_units
            
            if str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
                contract_size := 100.0
                effective_min_units := 1  // Gold: minimum 1 oz (0.01 lots)
            else if str.contains(syminfo.ticker, "XAG") or str.contains(syminfo.ticker, "SILVER")
                contract_size := 5000.0
                effective_min_units := 1  // Silver: minimum 1 oz
            else if str.contains(syminfo.ticker, "BTC") or str.contains(syminfo.ticker, "ETH")
                contract_size := 1.0
                effective_min_units := 1  // Crypto: minimum 1 unit
            else if is_index  // Indices: NAS100, SPX, etc.
                contract_size := 1.0
                effective_min_units := 1  // Index: minimum 1 contract
            
            qty_lots := qty_units / contract_size
            
            // Step 6: Minimum position size check (using asset-appropriate minimum)
            if qty_units < effective_min_units
                is_valid := false
                error_msg := "Position size below minimum"
                validation_details := "Units: " + str.tostring(qty_units) + " (min: " + str.tostring(effective_min_units) + ")"
            
            // Step 7: Maximum position size checks (Static + Dynamic)
            // A) Calculate Dynamic Limit (Lots per $10k)
            float dynamic_max_lots = (balance / 10000.0) * max_lots_per_10k
            
            // B) Absolute Hard Limit Check
            if is_valid and qty_lots > max_position_size_lots
                is_valid := false
                error_msg := "Position size exceeds absolute maximum"
                validation_details := "Lots: " + str.tostring(qty_lots, "#.####") + " (hard max: " + str.tostring(max_position_size_lots) + ")"
            
            // C) Relative Dynamic Limit Check
            if is_valid and qty_lots > dynamic_max_lots
                is_valid := false
                error_msg := "Position size exceeds relative leverage limit"
                validation_details := "Lots: " + str.tostring(qty_lots, "#.####") + " (dynamic max: " + str.tostring(dynamic_max_lots, "#.####") + " @ " + str.tostring(max_lots_per_10k) + " lots/$10k)"
            
            // Step 8: Final validation - ensure qty_units is positive and not na
            if is_valid and (na(qty_units) or qty_units <= 0)
                is_valid := false
                error_msg := "Invalid quantity units"
                validation_details := "Final units: " + (na(qty_units) ? "NA" : str.tostring(qty_units))
    
    [is_valid, qty_units, qty_lots, error_msg, validation_details, sl_fixed]

// Helper: Check if bar index is already used as zone base
is_base_bar_used(barIdx, baseArray) =>
    if array.size(baseArray) == 0
        false
    else
        found = false
        for j = 0 to array.size(baseArray) - 1
            if array.get(baseArray, j) == barIdx
                found := true
                break
        found

// === ZONE DETECTION TRACKING ===
var array<int> used_demand_base_times = array.new_int()
var array<int> used_supply_base_times = array.new_int()
var bool initial_scan_done = false

// === FRACTALS LOGIC ===
// NOTE: These helpers are written so that ta.highest/ta.lowest are *always* called
// on every bar, which removes "should be called on each calculation" warnings
// without changing the logical conditions.
f_isFractalHigh(_n) =>
    float hh = ta.highest(high, _n * 2 + 1)
    bool enoughBars = _n >= 1 and bar_index >= _n + 1
    bool cond = high[_n] == hh and high[_n] > high[_n + 1] and high[_n] > high[_n - 1]
    enoughBars and cond

f_isFractalLow(_n) =>
    float ll = ta.lowest(low, _n * 2 + 1)
    bool enoughBars = _n >= 1 and bar_index >= _n + 1
    bool cond = low[_n] == ll and low[_n] < low[_n + 1] and low[_n] < low[_n - 1]
    enoughBars and cond

bool isFractalHigh_result = f_isFractalHigh(fractalsPeriod)
bool isFractalLow_result  = f_isFractalLow(fractalsPeriod)

fractalBarIdx  = bar_index - fractalsPeriod
isZoneBaseBar  = (isFractalHigh_result or isFractalLow_result) ? 
                 (is_base_bar_used(fractalBarIdx, used_demand_base_times) or 
                  is_base_bar_used(fractalBarIdx, used_supply_base_times)) : false

fractalHigh = (not isZoneBaseBar and isFractalHigh_result) ? high[fractalsPeriod] : na
fractalLow  = (not isZoneBaseBar and isFractalLow_result) ? low[fractalsPeriod] : na

plotshape(not na(fractalHigh), style = shape.triangleup,   location = location.abovebar, color = color.green, size = size.small, offset = -fractalsPeriod)
plotshape(not na(fractalLow),  style = shape.triangledown, location = location.belowbar, color = color.red,   size = size.small, offset = -fractalsPeriod)

// === PIVOT-BASED LIQUIDITY (SIMPLE 3-CANDLE LIKE MAKUCHAKU) ===
var array<float> liqPvtHighPrices = array.new_float()
var array<int>   liqPvtHighBars   = array.new_int()
var array<float> liqPvtLowPrices  = array.new_float()
var array<int>   liqPvtLowBars    = array.new_int()

// Simple 3-candle pivot detection (like "Liquidity by makuchaku")
// A pivot low forms when: low[2] > low[1] and low[1] < low[0]
// A pivot high forms when: high[2] < high[1] and high[1] > high[0]
bool isPvtLow  = low[2] > low[1] and low[1] < low[0]
bool isPvtHigh = high[2] < high[1] and high[1] > high[0]

if isPvtLow
    // Pivot is at bar_index - 1 (the middle candle)
    array.push(liqPvtLowPrices, low[1])
    array.push(liqPvtLowBars, bar_index - 1)

if isPvtHigh
    // Pivot is at bar_index - 1 (the middle candle)
    array.push(liqPvtHighPrices, high[1])
    array.push(liqPvtHighBars, bar_index - 1)

// Trim to at most pvtMax recent liquidity levels
while array.size(liqPvtHighPrices) > pvtMax
    array.shift(liqPvtHighPrices)
    array.shift(liqPvtHighBars)
while array.size(liqPvtLowPrices) > pvtMax
    array.shift(liqPvtLowPrices)
    array.shift(liqPvtLowBars)



// Find zone in DB by UZID
db_findIndexByUZID(int targetUZID) =>
    int result = na
    if array.size(zoneDB) > 0
        for i = 0 to array.size(zoneDB) - 1
            Core.ZoneDBEntry entry = array.get(zoneDB, i)
            if entry.uzid == targetUZID
                result := i
                break
    result

// Upsert zone into DB (add new or update existing)
db_upsertZone(Core.Zone z, string zoneType) =>
    int idx = db_findIndexByUZID(z.id)
    if na(idx)
        // Create new entry
        Core.ZoneDBEntry entry = Core.ZoneDBEntry.new(
             uzid = z.id,
             zoneType = zoneType,
             top = z.top,
             bottom = z.bottom,
             createdBar = z.createdBarIndex,
             lastUpdateBar = bar_index,
             active = true,
             inactiveReason = "",
             liqLowPrice = z.liqLowPrice,
             liqLowBar = z.liqLowBar,
             liqHighPrice = z.liqHighPrice,
             liqHighBar = z.liqHighBar,
             liqSource = z.liqSource,
             liquiditySwept = z.liquiditySwept,
             liquidityCandleCount = z.liquidityCandleCount,
             causedSweep = z.causedSweep,
             legCandleCount = z.legCandleCount)
        array.push(zoneDB, entry)
        // Trim if too large (remove oldest)
        while array.size(zoneDB) > DB_MAX_SIZE
            array.shift(zoneDB)
    else
        // Update existing entry
        Core.ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.top := z.top
        entry.bottom := z.bottom
        entry.lastUpdateBar := bar_index
        entry.active := true
        entry.inactiveReason := ""
        entry.liqLowPrice := z.liqLowPrice
        entry.liqLowBar := z.liqLowBar
        entry.liqHighPrice := z.liqHighPrice
        entry.liqHighBar := z.liqHighBar
        entry.liqSource := z.liqSource
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
        entry.legCandleCount := z.legCandleCount
    true  // Consistent return type

// Mark zone as inactive in DB with reason
db_markInactive(int targetUZID, string reason) =>
    int idx = db_findIndexByUZID(targetUZID)
    if not na(idx)
        Core.ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.active := false
        entry.inactiveReason := reason
        entry.lastUpdateBar := bar_index
    true  // Consistent return type

// Update zone in DB with latest liquidity data (called during zone updates)
db_updateZoneLiquidity(Core.Zone z) =>
    int idx = db_findIndexByUZID(z.id)
    if not na(idx)
        Core.ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.lastUpdateBar := bar_index
        entry.liqLowPrice := z.liqLowPrice
        entry.liqLowBar := z.liqLowBar
        entry.liqHighPrice := z.liqHighPrice
        entry.liqHighBar := z.liqHighBar
        entry.liqSource := z.liqSource
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
    true  // Consistent return type

// === UZID COUNTERS (Guaranteed Unique IDs) ===
var int global_zone_id_counter = 0  // Single Global counter for ALL zones (Demand + Supply)

// === CONSECUTIVE OPPOSITE CANDLE COUNTER ===
// Counts consecutive opposite-direction candles starting from the bar AFTER liqBar (forward in time)
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// Returns count (0 if liqBar is na or no opposite candles found)
// === CONSECUTIVE OPPOSITE CANDLE COUNTER ===
// Counts consecutive opposite-direction candles starting from the bar AFTER liqBar (forward in time)
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// Returns count (0 if liqBar is na or no opposite candles found)
// Helper: Get highest High between two absolute bar indices
getMaxHighBetween(int startBarAbs, int endBarAbs) =>
    float maxH = -1.0e10
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        // Loop safely
        for i = offStart to offEnd
            if high[i] > maxH
                maxH := high[i]
    maxH

// Helper: Get lowest Low between two absolute bar indices
getMinLowBetween(int startBarAbs, int endBarAbs) =>
    float minL = 1.0e10
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        // Loop safely
        for i = offStart to offEnd
            if low[i] < minL
                minL := low[i]
    minL

// === PRECISE TARGET FINDERS (Return Bar Index, Not Price) ===
// Find the Bar Index of the Highest High between two bars (Inclusive)
// startBarAbs and endBarAbs are absolute bar indices
// Returns the bar_index of the candle with the highest high in that range
getBarOfMaxHigh(int startBarAbs, int endBarAbs) =>
    float maxH = -1.0e10
    int bestBar = startBarAbs
    // Ensure valid range
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        if offStart >= 0 and offEnd >= 0
            for i = offStart to offEnd
                if high[i] >= maxH
                    maxH := high[i]
                    bestBar := bar_index - i
    bestBar

// Find the Bar Index of the Lowest Low between two bars (Inclusive)
// startBarAbs and endBarAbs are absolute bar indices
// Returns the bar_index of the candle with the lowest low in that range
getBarOfMinLow(int startBarAbs, int endBarAbs) =>
    float minL = 1.0e10
    int bestBar = startBarAbs
    // Ensure valid range
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        if offStart >= 0 and offEnd >= 0
            for i = offStart to offEnd
                if low[i] <= minL
                    minL := low[i]
                    bestBar := bar_index - i
    bestBar

// Counts opposite candles INSIDE the liquidity range
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// NOTE: rangeLow and rangeHigh parameters are kept for API compatibility but NOT used
// We count ALL opposite candles between the bars, since the liquidity leg concept
// refers to the candles forming the movement, not just candles in a price band
countOppCandlesInLiquidityRange(int startBarAbs, int endBarAbs, bool isDemand, float rangeLow, float rangeHigh) =>
    int count = 0
    // Guards: endBarAbs should be >= startBarAbs (end is same or later in time)
    // CRITICAL: Also guard against bar indices greater than current bar_index (causes negative offsets)
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs and startBarAbs <= bar_index and endBarAbs <= bar_index
        int offStart = bar_index - endBarAbs      // Offset for the end bar (newer, lower offset)
        int offEnd   = bar_index - startBarAbs    // Offset for the start bar (older, higher offset)
        
        // Additional safety: ensure offsets are non-negative
        if offStart >= 0 and offEnd >= 0
            // Cap loop to avoid performance issues
            int max_steps = 200
            int steps = 0
            
            // Iterate from start bar to end bar (older to newer)
            // Higher offset = older bar, lower offset = newer bar
            // We iterate from offEnd (older) down to offStart (newer)
            for i = offEnd to offStart
                if steps > max_steps
                    break
                steps += 1
                
                // Check opposite color
                bool isOpp = isDemand ? (close[i] < open[i]) : (close[i] > open[i])
                
                // Count ALL opposite candles between the bars (no price range filter)
                // The liquidity leg includes all candles forming the movement
                if isOpp
                    count += 1
    count

countConsecutiveOppCandles(int liqBar, bool isDemand) =>
    int count = 0
    if na(liqBar) or liqBar > bar_index
        0  // Return 0 for invalid liqBar or future bar
    else
        int offset = bar_index - liqBar
        if offset >= 1  // Need at least 1 bar after liqBar
            // Start from the bar AFTER liqBar and walk toward current bar
            // Count ALL matching opposite candles (no break on mismatch)
            for i = 1 to liq_candle_count_max
                int idx = offset - i  // Bar index offset from current bar
                if idx < 0  // Reached current bar
                    break
                // Use WICKS (high/low) for range check, not body
                bool isOppCandle = isDemand ? (close[idx] < open[idx]) : (close[idx] > open[idx])
                if isOppCandle
                    count += 1
                // NO BREAK - count all matching candles in the range
        count  // Return actual count (can be 0)

// === LOCAL LIQUIDITY SCAN HELPERS ===
// Fallback scan to find nearest-by-price liquidity within constraints when no pivots are found

// Find closest-by-price LOW within distance
// Returns [price, bar_index] tuple (or [na, na] if none found)
// isInducement: true = look for Low >= zoneTop (Demand Inducement), false = look for Low <= zoneBottom (Standard)
findLocalDemandLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0
    
    // Scan history
    for off = 0 to lookback
        float candidate = low[off]
        // Check side tolerance
        bool isSideValid = isInducement ? (candidate >= refPrice - sideTol) : (candidate <= refPrice + sideTol)
        
        if isSideValid
            float dist = math.abs(candidate - refPrice)
            // Check max distance
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

// Find closest-by-price HIGH within distance
// Returns [price, bar_index] tuple (or [na, na] if none found)
// isInducement: true = look for High <= zoneBottom (Supply Inducement), false = look for High >= zoneTop (Standard)
findLocalSupplyLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0
    
    // Scan history
    for off = 0 to lookback
        float candidate = high[off]
        // Check side tolerance
        bool isSideValid = isInducement ? (candidate <= refPrice + sideTol) : (candidate >= refPrice - sideTol)
        
        if isSideValid
            float dist = math.abs(candidate - refPrice)
            // Check max distance
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

// =============================
// MODULAR LIQUIDITY SCAN FUNCTIONS
// =============================
// These functions encapsulate the liquidity scanning logic to reduce main body size
// and implement chronological search: Inducement first, then Target BEFORE it

// === 3-CANDLE PIVOT HELPERS (Makuchaku Style) ===
// Objective pivot detection: checks if candle at [idx+1] is a structural turning point
// Looking at three consecutive candles: [idx], [idx+1], [idx+2]
// These are the building blocks of our liquidity detection
// NEW: Simple 3-Candle Pivot Scan for Demand Liquidity
// Finds the lowest valid pivot that sits above the zone (Inducement liquidity)
// FIXED: Now enforces absolute maximum high for Target (not just pivot highs)
f_scan_demand_liquidity(int zoneArrayIndex) =>
    Core.Zone z = array.get(demandZones, zoneArrayIndex)

    // Skip if zone not eligible
    if na(z.createdBarIndex) or bar_index <= z.createdBarIndex or z.isHistorical
        true
    else
        // === STEP A: INDUCEMENT SCAN (LOWEST valid pivot low above zone) ===
        float bestLiqPrice = 1.0e10  // Start high, look for lowest valid pivot
        int bestLiqBar = na

        // Scan from zone creation forward to current bar
        // Maximum offset: we need at least 2 bars history for the pivot check
        int maxOff = bar_index - z.createdBarIndex - 2

        if maxOff >= 0
            for off = 0 to maxOff
                // Check if candle at [off+1] is a 3-candle pivot low
                // Condition: low[off+1] < low[off] AND low[off+1] < low[off+2]
                if Core.is_makuchaku_pvt_low(low, off)
                    float pLow = low[off+1]
                    int pBar = bar_index - (off + 1)

                    // Pivot must be AFTER zone creation
                    if pBar > z.createdBarIndex
                        // === CRITICAL VIDEO RULE: LIQUIDITY VALIDATION ===
                        // Video rule (timestamp 3:44-4:05):
                        // "When we have a level of liquidity like that, we want to see that low take out its previous internal high"
                        // This swing low is ONLY valid if it broke a previous swing high
                        int pivot_offset = off + 1  // The actual pivot is at off+1
                        int validation_lookback = 100  // Scan up to 100 bars back
                        bool isValidLiquidity = Core.validate_demand_liquidity(low, high, pivot_offset, validation_lookback)

                        // Skip this pivot if it didn't break a previous internal high
                        if isValidLiquidity
                            // VALIDATION: Check pivot location based on model selected
                            bool isValidLocation = false
                            float distFromZone = 0.0

                            if use_inducement_linking
                                // MODEL B (Inducement): Inducement must be ABOVE zone top
                                isValidLocation := pLow > z.top
                                distFromZone := pLow - z.top
                            else
                                // MODEL A (Standard): Inducement must be BELOW zone bottom
                                isValidLocation := pLow < z.bottom
                                distFromZone := z.bottom - pLow

                            if isValidLocation
                                // Check distance constraints if set
                                float maxDistPrice = effective_liq_max_dist * pip_size
                                bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice

                                if distOK
                                    // We want the LOWEST valid pivot (closest to zone = inducement)
                                    if pLow < bestLiqPrice
                                        bestLiqPrice := pLow
                                        bestLiqBar := pBar
                                    // Continue scanning - DO NOT BREAK

        // If we found a valid inducement pivot, configure the zone
        if not na(bestLiqBar) and bestLiqPrice < 1.0e10
            // === CHECK IF INDUCEMENT (LIQ LOW) CHANGED ===
            // If the inducement price has changed, reset the inducement sweep flag
            bool inductionChanged = na(z.liqLowPrice) or z.liqLowPrice != bestLiqPrice or na(z.liqLowBar) or z.liqLowBar != bestLiqBar

            z.liquidityPrice := bestLiqPrice
            z.liquidityBarIndex := bestLiqBar
            z.liqLowPrice := bestLiqPrice
            z.liqLowBar := bestLiqBar

            // Reset inducement sweep if it changed (force re-validation)
            if inductionChanged
                z.liquiditySwept := false
                z.liquiditySweptBarIndex := na

            // === STEP B: STRICT TARGET SCAN (ABSOLUTE HIGHEST price BEFORE inducement) ===
            // CRITICAL FIX: Find the ABSOLUTE HIGHEST high in the strict range:
            // [Zone Creation Bar ... Inducement Bar - 1]
            // This is NOT limited to 3-candle pivots - we need the true maximum!
            // NOTE: Target scan ALWAYS runs (not gated by targetSwept) to ensure proper data storage

            // Define the strict search range: must end STRICTLY BEFORE inducement bar
            int rangeStart = z.createdBarIndex
            int rangeEnd = bestLiqBar - 1  // STRICTLY before inducement

            // Initialize target values
            float bestTargetPrice = na
            int bestTargetBar = na

            // Validate range exists and is logical
            if rangeEnd >= rangeStart and rangeEnd <= bar_index and rangeStart >= 0
                // Use getBarOfMaxHigh to find the ABSOLUTE maximum high in the range
                // This includes ALL candles, not just 3-candle pivots
                // Returns the bar_index of the candle with highest high in [rangeStart, rangeEnd]
                bestTargetBar := getBarOfMaxHigh(rangeStart, rangeEnd)

                // If target bar found, retrieve the high price at that bar
                if not na(bestTargetBar) and bestTargetBar >= rangeStart and bestTargetBar <= rangeEnd
                    int targetOffset = bar_index - bestTargetBar
                    if targetOffset >= 0 and targetOffset < 5000  // Safety bounds
                        bestTargetPrice := high[targetOffset]

            // === CHECK IF TARGET (LIQ HIGH) CHANGED ===
            // If the target price has changed, reset the target sweep flag
            bool targetChanged = na(z.liqHighPrice) or z.liqHighPrice != bestTargetPrice or na(z.liqHighBar) or z.liqHighBar != bestTargetBar

            // Assign target values (even if na, this ensures explicit storage)
            z.liqHighBar := bestTargetBar
            z.liqHighPrice := bestTargetPrice

            // Reset target sweep if it changed (force re-validation)
            if targetChanged
                z.targetSwept := false
                z.targetSweptBarIndex := na

            // ── Liquidity / Leg Candles (Demand) ───────────────────────────────
            // Definition: number of BEARISH candles between the liquidity LOW
            // and the target HIGH. This matches the visual "leg" between the
            // Liq band and the Target label in the Zone Inspector.
            int demandLegStart = na
            int demandLegEnd   = na
            int demandLegCount = 0

            if not na(z.liqLowBar) and not na(z.liqHighBar)
                demandLegStart := math.min(z.liqLowBar, z.liqHighBar)
                demandLegEnd   := math.max(z.liqLowBar, z.liqHighBar)
                // For demand, count BEARISH candles (close < open)
                demandLegCount := countOppCandlesInLiquidityRange(
                     demandLegStart, demandLegEnd, true, z.liqLowPrice, z.liqHighPrice)

            z.liquidityCandleCount := demandLegCount
            z.legCandleCount := demandLegCount
            
            // Enforce candle-count rule for liquidity validity
            int minLegCandles = useOneCandleLiquidity ? 1 : 2
            bool hasStrongLeg = demandLegCount >= minLegCandles
            z.liquidityValid := hasStrongLeg
            z.inactiveReason := hasStrongLeg ? na : "WAITING_STRONG_LIQUIDITY"

            z.liqSource := "MAKUCHAKU_PIVOT"

            // Set structure sweep level (the target that must be swept)
            z.structureSweepLevel := z.liqHighPrice
            z.structureSweepLevelBar := z.liqHighBar

            // Store time values for multi-TF alignment (used for replay/multi-TF consistency)
            int indOff = bar_index - bestLiqBar
            int tgtOff = na(z.liqHighBar) ? na : (bar_index - z.liqHighBar)
            z.liqLowTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            z.liqHighTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na

            // === CRITICAL FIX: SAVE DATA TO DATABASE ===
            // Without this, data is lost when zone is pruned from live arrays!
            db_updateZoneLiquidity(z)
        else
            // No valid pivot found yet
            z.liquidityValid := false
            z.inactiveReason := "WAITING_PIVOT"

        true

// NEW: Simple 3-Candle Pivot Scan for Supply Liquidity
// Finds the highest valid pivot that sits below the zone (Inducement liquidity)
// FIXED: Now enforces absolute minimum low for Target (not just pivot lows)
f_scan_supply_liquidity(int zoneArrayIndex) =>
    Core.Zone z = array.get(supplyZones, zoneArrayIndex)

    // Skip if zone not eligible
    if na(z.createdBarIndex) or bar_index <= z.createdBarIndex or z.isHistorical
        true
    else
        // === STEP A: INDUCEMENT SCAN (HIGHEST valid pivot high below zone) ===
        float bestLiqPrice = 0.0  // Start low, look for highest valid pivot
        int bestLiqBar = na

        // Scan from zone creation forward to current bar
        // Maximum offset: we need at least 2 bars history for the pivot check
        int maxOff = bar_index - z.createdBarIndex - 2

        if maxOff >= 0
            for off = 0 to maxOff
                // Check if candle at [off+1] is a 3-candle pivot high
                // Condition: high[off+1] > high[off] AND high[off+1] > high[off+2]
                if Core.is_makuchaku_pvt_high(high, off)
                    float pHigh = high[off+1]
                    int pBar = bar_index - (off + 1)

                    // Pivot must be AFTER zone creation
                    if pBar > z.createdBarIndex
                        // === CRITICAL VIDEO RULE: LIQUIDITY VALIDATION ===
                        // Video rule (inverse for supply):
                        // A swing high is ONLY valid if it broke a previous swing low
                        int pivot_offset = off + 1  // The actual pivot is at off+1
                        int validation_lookback = 100  // Scan up to 100 bars back
                        bool isValidLiquidity = Core.validate_supply_liquidity(high, low, pivot_offset, validation_lookback)

                        // Skip this pivot if it didn't break a previous internal low
                        if isValidLiquidity
                            // VALIDATION: Check pivot location based on model selected
                            bool isValidLocation = false
                            float distFromZone = 0.0

                            if use_inducement_linking
                                // MODEL B (Inducement): Inducement must be BELOW zone bottom
                                isValidLocation := pHigh < z.bottom
                                distFromZone := z.bottom - pHigh
                            else
                                // MODEL A (Standard): Inducement must be ABOVE zone top
                                isValidLocation := pHigh > z.top
                                distFromZone := pHigh - z.top

                            if isValidLocation
                                // Check distance constraints if set
                                float distFromZoneCheck = distFromZone
                                float maxDistPrice = effective_liq_max_dist * pip_size
                                bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZoneCheck <= maxDistPrice

                                if distOK
                                    // We want the HIGHEST valid pivot (closest to zone = inducement)
                                    if pHigh > bestLiqPrice
                                        bestLiqPrice := pHigh
                                        bestLiqBar := pBar
                                    // Continue scanning - DO NOT BREAK

        // If we found a valid inducement pivot, configure the zone
        if not na(bestLiqBar) and bestLiqPrice > 0.0
            // === CHECK IF INDUCEMENT (LIQ HIGH) CHANGED ===
            // If the inducement price has changed, reset the inducement sweep flag
            bool inductionChanged = na(z.liqHighPrice) or z.liqHighPrice != bestLiqPrice or na(z.liqHighBar) or z.liqHighBar != bestLiqBar

            z.liquidityPrice := bestLiqPrice
            z.liquidityBarIndex := bestLiqBar
            z.liqHighPrice := bestLiqPrice
            z.liqHighBar := bestLiqBar

            // Reset inducement sweep if it changed (force re-validation)
            if inductionChanged
                z.liquiditySwept := false
                z.liquiditySweptBarIndex := na

            // === STEP B: STRICT TARGET SCAN (ABSOLUTE LOWEST price BEFORE inducement) ===
            // CRITICAL FIX: Find the ABSOLUTE LOWEST low in the strict range:
            // [Zone Creation Bar ... Inducement Bar - 1]
            // This is NOT limited to 3-candle pivots - we need the true minimum!
            // NOTE: Target scan ALWAYS runs (not gated by targetSwept) to ensure proper data storage

            // Define the strict search range: must end STRICTLY BEFORE inducement bar
            int rangeStart = z.createdBarIndex
            int rangeEnd = bestLiqBar - 1  // STRICTLY before inducement

            // Initialize target values
            float bestTargetPrice = na
            int bestTargetBar = na

            // Validate range exists and is logical
            if rangeEnd >= rangeStart and rangeEnd <= bar_index and rangeStart >= 0
                // Use getBarOfMinLow to find the ABSOLUTE minimum low in the range
                // This includes ALL candles, not just 3-candle pivots
                // Returns the bar_index of the candle with lowest low in [rangeStart, rangeEnd]
                bestTargetBar := getBarOfMinLow(rangeStart, rangeEnd)

                // If target bar found, retrieve the low price at that bar
                if not na(bestTargetBar) and bestTargetBar >= rangeStart and bestTargetBar <= rangeEnd
                    int targetOffset = bar_index - bestTargetBar
                    if targetOffset >= 0 and targetOffset < 5000  // Safety bounds
                        bestTargetPrice := low[targetOffset]

            // === CHECK IF TARGET (LIQ LOW) CHANGED ===
            // If the target price has changed, reset the target sweep flag
            bool targetChanged = na(z.liqLowPrice) or z.liqLowPrice != bestTargetPrice or na(z.liqLowBar) or z.liqLowBar != bestTargetBar

            // Assign target values (even if na, this ensures explicit storage)
            z.liqLowBar := bestTargetBar
            z.liqLowPrice := bestTargetPrice

            // Reset target sweep if it changed (force re-validation)
            if targetChanged
                z.targetSwept := false
                z.targetSweptBarIndex := na

            // ── Liquidity / Leg Candles (Supply) ───────────────────────────────
            // Definition: number of BULLISH candles between the liquidity HIGH
            // and the target LOW. This matches the visual "leg" between the
            // Liq band and the Target label in the Zone Inspector.
            int supplyLegStart = na
            int supplyLegEnd   = na
            int supplyLegCount = 0

            if not na(z.liqLowBar) and not na(z.liqHighBar)
                supplyLegStart := math.min(z.liqLowBar, z.liqHighBar)
                supplyLegEnd   := math.max(z.liqLowBar, z.liqHighBar)
                // For supply, count BULLISH candles (close > open)
                supplyLegCount := countOppCandlesInLiquidityRange(
                     supplyLegStart, supplyLegEnd, false, z.liqLowPrice, z.liqHighPrice)

            z.liquidityCandleCount := supplyLegCount
            z.legCandleCount := supplyLegCount
            
            // Enforce candle-count rule for liquidity validity
            int minLegCandles = useOneCandleLiquidity ? 1 : 2
            bool hasStrongLeg = supplyLegCount >= minLegCandles
            z.liquidityValid := hasStrongLeg
            z.inactiveReason := hasStrongLeg ? na : "WAITING_STRONG_LIQUIDITY"

            z.liqSource := "MAKUCHAKU_PIVOT"

            // Set structure sweep level (the target that must be swept)
            z.structureSweepLevel := z.liqLowPrice
            z.structureSweepLevelBar := z.liqLowBar

            // Store time values for multi-TF alignment (used for replay/multi-TF consistency)
            int indOff = bar_index - bestLiqBar
            int tgtOff = na(z.liqLowBar) ? na : (bar_index - z.liqLowBar)
            z.liqHighTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            z.liqLowTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na

            // === CRITICAL FIX: SAVE DATA TO DATABASE ===
            // Without this, data is lost when zone is pruned from live arrays!
            db_updateZoneLiquidity(z)
        else
            // No valid pivot found yet
            z.liquidityValid := false
            z.inactiveReason := "WAITING_PIVOT"

        true

// Check inducement and target sweeps for demand zone
// Target Sweep detection requires liquidityValid (proper pivot scan completed)
// This ensures the Target High is correctly calculated before checking for sweep
f_check_demand_sweeps(int zoneArrayIndex) =>
    Core.Zone z = array.get(demandZones, zoneArrayIndex)
    bool needsPersist = false
    
    // === INDUCEMENT SWEEP CHECK ===
    // Inducement Low for Demand: price drops to/below liqLowPrice
    if bar_index > z.liquidityBarIndex and not na(z.liqLowPrice)
        bool is_sweeping_now = low <= z.liqLowPrice  // STRICT: no tolerance
        
        if is_sweeping_now
            z.liquiditySwept := true
            z.liquiditySweptBarIndex := bar_index  // Updates to LATEST sweep
            z.peakBarIndex := bar_index
            z.causedSweep := true
            needsPersist := true
    
    // === STRUCTURAL EXTREME (PEAK) TRACKING ===
    // After sweep, track the highest high (the peak of the pullback BEFORE touching zone)
    if z.liquiditySwept and not na(z.peakBarIndex)
        // Check if current high is higher than the high at the recorded peakBarIndex
        int offset = bar_index - z.peakBarIndex
        if offset >= 0 and high > high[offset]
            z.peakBarIndex := bar_index
            needsPersist := true

    // === TARGET SWEEP CHECK ===
    // Target High for Demand: price must strictly tag or exceed liqHighPrice
    // CRITICAL: Only check AFTER liquidityValid is true (proper pivot scan completed)
    // This ensures liqHighPrice is correctly set before we check for sweep
    if z.liquidityValid and not na(z.liqHighPrice) and not na(z.liqHighBar) and not z.targetSwept
        float targetSweepTolerance = 0.0
        float targetSweepLevel = z.liqHighPrice - targetSweepTolerance
        bool is_tgt_sweeping_now = high >= targetSweepLevel
        
        if is_tgt_sweeping_now
            z.targetSwept := true
            z.targetSweptBarIndex := bar_index
            // Only set causedSweep if not already set by inducement
            if not z.causedSweep
                z.causedSweep := true
            needsPersist := true
    
    // === PERSIST CHANGES ONCE ===
    if needsPersist
        array.set(demandZones, zoneArrayIndex, z)
        db_updateZoneLiquidity(z)
    true  // Return dummy value

// Check inducement and target sweeps for supply zone
// Target Sweep detection requires liquidityValid (proper pivot scan completed)
// This ensures the Target Low is correctly calculated before checking for sweep
f_check_supply_sweeps(int zoneArrayIndex) =>
    Core.Zone z = array.get(supplyZones, zoneArrayIndex)
    bool needsPersist = false
    
    // === INDUCEMENT SWEEP CHECK ===
    // Inducement High for Supply: price rises to/above liqHighPrice
    if bar_index > z.liquidityBarIndex and not na(z.liqHighPrice)
        bool is_sweeping_now = high >= z.liqHighPrice  // STRICT: no tolerance
        
        if is_sweeping_now
            z.liquiditySwept := true
            z.liquiditySweptBarIndex := bar_index  // Updates to LATEST sweep
            z.peakBarIndex := bar_index
            z.causedSweep := true
            needsPersist := true
    
    // === STRUCTURAL EXTREME (PEAK) TRACKING ===
    // After sweep, track the lowest low (the peak of the pullback BEFORE touching zone)
    if z.liquiditySwept and not na(z.peakBarIndex)
        // Check if current low is lower than the low at the recorded peakBarIndex
        int offset = bar_index - z.peakBarIndex
        if offset >= 0 and low < low[offset]
            z.peakBarIndex := bar_index
            needsPersist := true

    // === TARGET SWEEP CHECK ===
    // Target Low for Supply: price must strictly tag or break below liqLowPrice
    // CRITICAL: Only check AFTER liquidityValid is true (proper pivot scan completed)
    // This ensures liqLowPrice is correctly set before we check for sweep
    if z.liquidityValid and not na(z.liqLowPrice) and not na(z.liqLowBar) and not z.targetSwept
        float targetSweepTolerance = 0.0
        float targetSweepLevel = z.liqLowPrice + targetSweepTolerance
        bool is_tgt_sweeping_now = low <= targetSweepLevel
        
        if is_tgt_sweeping_now
            z.targetSwept := true
            z.targetSweptBarIndex := bar_index
            // Only set causedSweep if not already set by inducement
            if not z.causedSweep
                z.causedSweep := true
            needsPersist := true
    
    // === PERSIST CHANGES ONCE ===
    if needsPersist
        array.set(supplyZones, zoneArrayIndex, z)
        db_updateZoneLiquidity(z)
    true  // Return dummy value

// === OPTIMIZED ZONE REMOVAL HELPER ===
// Consolidated function to remove demand zone from all arrays (reduces code duplication)
// === UNIFIED ZONE MANAGEMENT HELPERS ===

// Trim base time arrays to prevent memory bloat
// Trim base time arrays to prevent memory bloat
trimBaseTimeArrays() =>
    maxCount = max_zones * 2
    while array.size(used_demand_base_times) > maxCount
        array.pop(used_demand_base_times)
    while array.size(used_supply_base_times) > maxCount
        array.pop(used_supply_base_times)

// Unified Array Trimming (keeps zone boxes and connector lines cleaned up)
trimZoneArrays(bool isDemand) =>
    maxCount = max_zones
    if isDemand
        while array.size(demandZones) > maxCount
            Core.Zone z = array.pop(demandZones)
            db_markInactive(z.id, "max_pruned")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            if not na(z.idLabel)
                label.delete(z.idLabel)
    else
        while array.size(supplyZones) > maxCount
            Core.Zone z = array.pop(supplyZones)
            db_markInactive(z.id, "max_pruned")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            if not na(z.targetLine)
                line.delete(z.targetLine)
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            if not na(z.idLabel)
                label.delete(z.idLabel)

// === MAIN ZONE CREATION FUNCTION ===
createZone(int baseIdx, bool isDemand, bool isHistorical, int candlesInBase, int legCandles, int zoneUZID) =>
    // Determine Base Candle (relative to current bar)
    // baseIdx is offset (e.g. 1 means bar_index - 1)
    baseBarIdx = bar_index - baseIdx
    
    // Check if base bar time is already used
    int baseTime = time[baseIdx]
    bool alreadyUsed = false
    if isDemand
        if array.includes(used_demand_base_times, baseTime)
            alreadyUsed := true
        else
            array.push(used_demand_base_times, baseTime)
            trimBaseTimeArrays()
    else
        if array.includes(used_supply_base_times, baseTime)
            alreadyUsed := true
        else
            array.push(used_supply_base_times, baseTime)
            trimBaseTimeArrays()
            
    if not alreadyUsed
        // Calculate Zone Coordinates
        float baseHigh = high[baseIdx]
        float baseLow  = low[baseIdx]
        float baseOpen = open[baseIdx]
        float baseClose = close[baseIdx]
        
        // === FVG / IMBALANCE CHECK ===
        // If FVG Confluence is enabled, only create zone if displacement left an FVG/Imbalance
        // Imbalance is between the BASE candle and the 2nd candle after it (Candle C)
        // Base = baseIdx
        // Reaction/Explosion = baseIdx - 1
        // Follow-through/Validation = baseIdx - 2
        bool hasFVG = false
        // Ensure we have enough history (need candle at baseIdx - 2)
        if use_fvg_confirmation and (baseIdx - 2) >= 0
            if isDemand
                // Demand FVG: Low of (baseIdx - 2) > High of (baseIdx)
                // Gap exists above the zone candle
                if low[baseIdx - 2] > high[baseIdx]
                    hasFVG := true
            else
                // Supply FVG: High of (baseIdx - 2) < Low of (baseIdx)
                // Gap exists below the zone candle
                if high[baseIdx - 2] < low[baseIdx]
                    hasFVG := true
            
            // If FVG required but not present, ABORT zone creation
            if not hasFVG
                // Return dummy void result (Pine Script functions are weird with void returns)
                // We'll just set zTop/zBottom to na and exit logic block if we could
                // But since we are in a function, we can't 'return' easily in middle
                // We will wrap the rest of the logic in a check
                na
        
        // Proceed only if FVG check passed (or disabled)
        bool proceed_creation = not use_fvg_confirmation or hasFVG
        
        // Define variable first
        bool isAccuracy = false

        if proceed_creation
            // Determine if it's an "Accuracy" zone:
            // Rule: Compare Zone Candle (baseIdx) to Reaction Candle (baseIdx - 1)
            // The reaction candle is the one that started the move AFTER the zone candle
    
            // Define the Reaction candle (The candle that started the move)
            // Since baseIdx is the offset from current bar, the candle "after" it in time is at (baseIdx - 1)
            int reactionIdx = baseIdx - 1
    
            // Only check for accuracy zones if enabled (disabled for XAUUSD, NAS100, etc.)
            if should_use_accuracy_zones and reactionIdx >= 0
                if isDemand
                    // DEMAND ACCURACY RULE:
                    // If the Zone Candle (Red) goes HIGHER than the Reaction Candle (Green)
                    // We use the Body (Open) as the Top.
                    // Condition: Zone High > Reaction High
                    if high[baseIdx] > high[reactionIdx]
                        isAccuracy := true
                else
                    // SUPPLY ACCURACY RULE:
                    // If the Zone Candle (Green) goes LOWER than the Reaction Candle (Red)
                    // We use the Body (Open) as the Bottom.
                    // Condition: Zone Low < Reaction Low
                    if low[baseIdx] < low[reactionIdx]
                        isAccuracy := true
    
        float zTop = na
        float zBottom = na

        // Only calculate coordinates if proceeding
        if proceed_creation
            if isAccuracy
                if isDemand
                    // Demand Accuracy: Ignore Top Wick
                    // Top = OPEN (Body Top)
                    // Bottom = LOW (Extreme)
                    zTop := baseOpen
                    zBottom := baseLow
                else
                    // Supply Accuracy: Ignore Bottom Wick
                    // Top = HIGH (Extreme)
                    // Bottom = OPEN (Body Bottom)
                    zTop := baseHigh
                    zBottom := baseOpen
            else
                // Normal zones: Full candle range
                zTop := baseHigh
                zBottom := baseLow
        
            // Cap zone size to avoid overly large zones
            max_zone_size = 50.0 * pip_size
            if (zTop - zBottom) > max_zone_size
                // Keep current range even if large - no adjustment needed
                true  // No-op, just for syntax

        // Initialize zone creation variables to defaults to ensure scope validity
        int zoneBorderWidth = 1
        color zoneBgColor = na
        color zoneBorderColorFinal = na
        
        // Only proceed with object creation if coordinates are valid (FVG check passed)
        if not na(zTop) and not na(zBottom)
            // Create Visual Box with thicker border and distinct color for Accuracy zones
            zoneBorderWidth := isAccuracy ? 2 : 1  // Slightly thicker border for accuracy zones
            
            if isAccuracy
                // Accuracy zones: Blue for demand, Purple for supply - more visible
                if isDemand
                    zoneBgColor := col_acc_demand_bg
                    zoneBorderColorFinal := col_acc_demand_border
                else
                    zoneBgColor := col_acc_supply_bg
                    zoneBorderColorFinal := col_acc_supply_border
            else
                // Normal zones: subtle colors
                zoneBgColor := isDemand ? col_demand_bg : col_supply_bg
                zoneBorderColorFinal := isDemand ? col_demand_border : col_supply_border

            box b = box.new(left = baseBarIdx, top = zTop, right = baseBarIdx + extend_bars, bottom = zBottom,
                 border_color = zoneBorderColorFinal,
                 border_width = zoneBorderWidth,
                 bgcolor = zoneBgColor,
                 xloc = xloc.bar_index)

            // Create ID Label with solid background for visibility
            string accTag = isAccuracy ? "⭐ ACC " : ""

            // DEBUG: Add comparison info to label if debug active
            if show_debug_labels and isAccuracy
                string debugInfo = ""
                if isDemand
                    float zoneHigh = high[baseIdx]
                    float reactionHigh = high[baseIdx - 1]
                    debugInfo := " [Z:" + str.tostring(zoneHigh, format.mintick) + " > R:" + str.tostring(reactionHigh, format.mintick) + "]"
                else
                    float zoneLow = low[baseIdx]
                    float reactionLow = low[baseIdx - 1]
                    debugInfo := " [Z:" + str.tostring(zoneLow, format.mintick) + " < R:" + str.tostring(reactionLow, format.mintick) + "]"

                accTag := accTag + debugInfo

            string sideTag = isDemand ? "D-" : "S-"
            string compactText = sideTag + str.tostring(zoneUZID)
            string detailedText = (isDemand ? "Demand " : "Supply ") + compactText
            string id_text = " " + (zone_label_style == "Detailed" ? detailedText : compactText) + " "
            float mid = (zTop + zBottom) / 2.0
            // Label colors match zone colors - accuracy zones use blue/purple
            color lbl_bg_color = na
            if isAccuracy
                lbl_bg_color := isDemand ? color.new(#2196F3, 0) : color.new(#AB47BC, 0)  // Blue for demand ACC, Purple for supply ACC
            else
                lbl_bg_color := isDemand ? color.new(#26a69a, 0) : color.new(#ef5350, 0)  // Teal for demand, Coral for supply
            label idLbl = label.new(x = baseBarIdx, y = mid, text = id_text,
                 style = label.style_label_left, textcolor = color.white, color = lbl_bg_color,
                 size = size.tiny,  // Forced tiny size for clean chart
                 textalign = text.align_center, xloc = xloc.bar_index)

            // Create Zone Object
            Core.Zone z = Core.Zone.new()
            z.id := zoneUZID
            z.boxId := b
            z.top := zTop
            z.bottom := zBottom
            z.active := true
            z.createdBarIndex := baseBarIdx
            z.isHistorical := isHistorical
            z.startTime := time[baseIdx]
            z.idLabel := idLbl
            z.touchCount := 0  // Initialize touch count for V5 AI tracking
            z.isAccuracy := isAccuracy  // Tag zone type for trade tracking
            // Initialize peak tracking for new bar-count filters
            z.peakBarIndex := na
            z.peakPrice := na

            // === SCORING SYSTEM INTEGRATION ===
            // Calculate Score (0-100)
            z.score := Core.calculate_zone_score(isDemand, zTop, zBottom, baseIdx, legCandles, false, false, candlesInBase, isAccuracy, is_uptrend, is_downtrend, time[baseIdx])
            z.grade := Core.get_grade_from_score(z.score)
            
            // === V6 AI FEATURES (CONDITIONAL - Only if enabled) ===
            // IMPORTANT: Call functions unconditionally for Pine Script series consistency
            // Both params must be absolute bar indices.
            // base spans from baseBarIdx to baseBarIdx + (candlesInBase - 1)
            // base_start_idx must be >= base_end_idx for the function to work
            int baseEndAbsolute = baseBarIdx + candlesInBase - 1
            float temp_base_quality = Core.calculate_base_quality(baseEndAbsolute, baseBarIdx, bar_index, high, low, open, close)
            float temp_departure_strength = Core.calculate_departure_strength(baseIdx, isDemand, high, low, open, close, volume, vol_sma_20)
            
            if enable_v6_v7_features
                z.baseQuality := temp_base_quality
                z.departureStrength := temp_departure_strength
            else
                // Default values when disabled (neutral 50)
                z.baseQuality := 50.0
                z.departureStrength := 50.0
            
            // Update Label with Grade if enabled
            if show_grade_on_zone and zone_label_style == "Compact"
                // Compact mode keeps grade prefix behavior
                string gradeStr = "[" + z.grade + "] "
                label.set_text(idLbl, gradeStr + id_text)
                 
            // Add to array and register in DB
            if isDemand
                array.unshift(demandZones, z)
                db_upsertZone(z, "DEMAND")
                trimZoneArrays(true)
            else
                array.unshift(supplyZones, z)
                db_upsertZone(z, "SUPPLY")
                trimZoneArrays(false)

// Unified Zone Removal
remove_zone_all_arrays(bool isDemand, int idx) =>
    if isDemand
        if idx >= 0 and idx < array.size(demandZones)
            Core.Zone z = array.get(demandZones, idx)
            db_markInactive(z.id, "removed")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na  // Explicitly free memory
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na  // Explicitly free memory
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na  // Explicitly free memory
            if not na(z.idLabel)
                label.delete(z.idLabel)
                z.idLabel := na  // Explicitly free memory
            array.remove(demandZones, idx)
    else
        if idx >= 0 and idx < array.size(supplyZones)
            Core.Zone z = array.get(supplyZones, idx)
            db_markInactive(z.id, "removed")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na  // Explicitly free memory
            if not na(z.targetLine)
                line.delete(z.targetLine)
                z.targetLine := na  // Explicitly free memory
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na  // Explicitly free memory
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na  // Explicitly free memory
            if not na(z.idLabel)
                label.delete(z.idLabel)
                z.idLabel := na  // Explicitly free memory
            array.remove(supplyZones, idx)

// === LIQUIDITY DISTANCE HELPER FUNCTIONS ===
// Calculate distance from zone edge to liquidity level in pips
// For Supply: zoneBottom - liqHighPrice (zone bottom is closest to the inducement high below)
// For Demand: liqLowPrice - zoneTop (zone top is closest to the inducement low above)
getLiquidityDistance(Core.Zone z, bool isSupply) =>
    float dist = na
    if isSupply
        // Supply: distance from zone BOTTOM to the liquidity HIGH (inducement high)
        // The inducement high is BELOW the zone, so measure from zone bottom
        // Formula: supplyZoneBottom - supplyLiquidityHigh
        if not na(z.liqHighPrice) and not na(z.bottom)
            dist := (z.bottom - z.liqHighPrice) / pip_size
    else
        // Demand: distance from liquidity LOW (inducement low) to zone TOP
        // The inducement low is ABOVE the zone, so measure from zone top
        // Formula: demandLiquidityLow - demandZoneTop
        if not na(z.liqLowPrice) and not na(z.top)
            dist := (z.liqLowPrice - z.top) / pip_size
    // Return absolute value to ensure positive distance
    na(dist) ? na : math.abs(dist)

// Check if liquidity distance is within limit
// Returns true if within limit or if limit is 0 (no limit)
checkLiquidityDistance(Core.Zone z, bool isSupply) =>
    if effective_liq_entry_max_dist == 0.0
        true  // No limit when set to 0
    else
        float dist = getLiquidityDistance(z, isSupply)
        na(dist) or dist <= effective_liq_entry_max_dist



// === TIME DEAD ZONE FILTER (Arger FX Rule) ===
// Block entries in the last 10 minutes of each hour (xx:50 - xx:00)
// This avoids volatility spikes at 1H candle closes
is_time_dead_zone() =>
    if not filter_dead_zone
        false
    else
        int currentMinute = minute(time)
        currentMinute >= 50

// === TRADING HOURS FILTER (Israel Time) ===
// Block entries outside of 07:00-22:00 Israel time (GMT+2/GMT+3 depending on DST)
is_outside_trading_hours() =>
    if not filter_trading_hours
        false
    else
        int israelHour = hour(time, "Asia/Jerusalem")
        israelHour < trading_start_hour or israelHour >= trading_end_hour

// Unified Entry Validation
validate_entry_conditions(bool isDemand, int idx) =>
    bool canEnter = true
    string reason = ""
    Core.Zone z = na

    if isDemand
        if idx < 0 or idx >= array.size(demandZones)
            canEnter := false
            reason := "Invalid demand zone index"
        else
            z := array.get(demandZones, idx)
    else
        if idx < 0 or idx >= array.size(supplyZones)
            canEnter := false
            reason := "Invalid supply zone index"
        else
            z := array.get(supplyZones, idx)

    if canEnter
        if not z.active
            canEnter := false
            reason := isDemand ? "Demand zone inactive" : "Supply zone inactive"

    // === TIME DEAD ZONE FILTER (Arger FX Rule) ===
    // Block entries in the last 10 minutes of each hour (xx:50 - xx:00)
    // Check this EARLY so user sees clear timing message
    if canEnter and is_time_dead_zone()
        canEnter := false
        reason := "Dead Zone: Blocked at " + str.tostring(minute(time)) + "m (avoid xx:50-xx:00)"

    // === TRADING HOURS FILTER (Israel Time) ===
    // Block entries outside allowed trading window (default: 07:00-22:00)
    if canEnter and is_outside_trading_hours()
        canEnter := false
        int israelHour = hour(time, "Asia/Jerusalem")
        reason := "Outside Trading Hours: " + str.tostring(israelHour) + ":00 (allowed: " + str.tostring(trading_start_hour) + ":00-" + str.tostring(trading_end_hour) + ":00)"

    if canEnter
        // Zone must not have been touched BEFORE liquidity/target sweeps.
        // STRICT: Any pre‑sweep mitigation (wick or close into the zone) permanently disqualifies the zone.
        if z.touchedPreSweep
            canEnter := false
            reason := "Start Freshness Failed (Zone touched before liquidity sweep)"
            
        // Zone must have caused sweep & not be historical
        if canEnter and not z.causedSweep
            canEnter := false
            reason := isDemand ? "Waiting for Inducement Sweep (Demand)" : "Waiting for Inducement Sweep (Supply)"
        if canEnter and z.isHistorical
            canEnter := false
            reason := isDemand ? "Demand zone created in historical backfill" : "Supply zone created in historical backfill"

        // Liquidity existence (candle-count rule) & sweep timing
        if canEnter and require_liquidity_sweep
            if not z.liquidityValid
                canEnter := false
                reason := isDemand ? "Demand liquidity invalid (candle-count rule failed)" : "Supply liquidity invalid (candle-count rule failed)"
            else if not z.liquiditySwept
                canEnter := false
                reason := isDemand ? "Waiting for Inducement Sweep (Demand)" : "Waiting for Inducement Sweep (Supply)"
            else if not z.targetSwept
                canEnter := false
                reason := isDemand ? "Waiting for Target HIGH Sweep (Demand)" : "Waiting for Target LOW Sweep (Supply)"
            else if na(z.liquiditySweptBarIndex) or bar_index < z.liquiditySweptBarIndex
                canEnter := false
                reason := isDemand ? "Demand entry before liquidity sweep bar" : "Supply entry before liquidity sweep bar"
            // DOUBLE SWEEP GATE: Both Target and Inducement must be swept
            // NOTE: Target can be swept BEFORE Inducement in the "Double Sweep" model
            // (The rally that creates the Inducement Low often sweeps the Target High first)
            // Only require that both bar indices are set (both sweeps occurred)
            else if na(z.targetSweptBarIndex)
                canEnter := false
                reason := "Target sweep bar index not set"
            else
                // Check liquidity distance from zone boundary (using helper function)
                // For Supply: liqHighPrice to zone top
                // For Demand: liqLowPrice to zone bottom
                // Skip check if effective_liq_entry_max_dist is 0 (no limit)
                // SKIP FOR INDICES: NAS100 liquidity works differently, distance check not applicable
                if not is_index and effective_liq_entry_max_dist > 0.0 and not checkLiquidityDistance(z, not isDemand)
                    float liqDist = not na(z.liquidityDistance) ? z.liquidityDistance : 999.0
                    // Only reject if strictly worse (allow small tolerance)
                    canEnter := false
                    reason := "Liq distance too far (" + str.tostring(liqDist, "#.#") + " pips > " + str.tostring(effective_liq_entry_max_dist, "#.#") + ")"
        else if canEnter and not require_liquidity_sweep
            if not z.liquidityValid
                // Liquidity not strictly required, but we still report it for transparency
                reason := "OK (liquidity optional; none/invalid)"

        // LIQUIDITY SWEPT GATE (simplified): Just check if pivot was swept
        // No separate Target vs Inducement check needed with 3-candle logic

        // STRICT TOUCH CHECK - No tolerance buffer
        // For Demand: LOW must be inside zone (exact touch)
        // For Supply: HIGH must be inside zone (exact touch)
        float touchTolerance = 0.0  // Strict touch required
        bool wickIntoZone = false
        
        if canEnter
            // Check current bar for new touch
            bool currentTouch = false
            if isDemand
                // Demand: require LOW (wick down) to enter zone
                currentTouch := low <= (z.top + touchTolerance) and low >= (z.bottom - touchTolerance)
            else
                // Supply: require HIGH (wick up) to enter zone
                currentTouch := high >= (z.bottom - touchTolerance) and high <= (z.top + touchTolerance)
            
            // If current bar touches, mark zone as touched (persistent)
            if currentTouch
                z.wasTouched := true
            
            // STRICT VALIDATION: Ignore persistent history.
            // Require the touch to happen on the current trigger candle OR the setup candle (bar index - 1).
            bool prevTouch = isDemand ? (low[1] <= z.top + touchTolerance) : (high[1] >= z.bottom - touchTolerance)
            
            // Entry is valid only if we are touching NOW or just touched on the PREVIOUS bar
            wickIntoZone := currentTouch or prevTouch
            
            // STRICT CHECK: The zone MUST be touched. No exceptions.
            if not wickIntoZone
                canEnter := false
                reason := isDemand ? "No wick INTO demand zone" : "No wick INTO supply zone"

        // Zone not used yet
        bool zone_already_used = not na(z.lastEntryBar)
        if canEnter and zone_already_used
            canEnter := false
            reason := isDemand ? "Demand zone already used for a trade" : "Supply zone already used for a trade"

        // Zone not mitigated
        if canEnter and z.mitigated
            canEnter := false
            reason := isDemand ? "Demand zone mitigated before liquidity sweep" : "Supply zone mitigated before liquidity sweep"

        // 24h freshness
        bool zoneIsFresh = na(z.startTime) or (time - z.startTime) <= (24 * 60 * 60 * 1000)
        if canEnter and not zoneIsFresh
            canEnter := false
            reason := isDemand ? "Demand zone older than 24h" : "Supply zone older than 24h"

        // Minimum bar index for entries
        bool zone_created_after_min_bar = na(z.createdBarIndex) or z.createdBarIndex >= min_bar_index_for_entries
        if canEnter and not zone_created_after_min_bar
            canEnter := false
            reason := "Zone created before min bar index"

        // === AI QUALITY FILTER [optimization/ai-overhaul] ===
        // Apply AI-based quality scoring to filter low-probability setups.
        //
        // Effective threshold logic:
        //   • Shadow Mode ON  → never blocks (logs what would have been rejected)
        //   • Lite Mode ON    → threshold = 30  (only obvious failures)
        //   • Normal          → threshold = ai_quality_threshold (default 60)
        //
        // The RVOL floor fix in SND_Core raises typical Forex score by ~5–8 pts,
        // so the effective pass-rate at threshold=60 will increase meaningfully.
        int effective_ai_threshold = enable_ai_lite_mode ? 30 : ai_quality_threshold

        if canEnter and enable_ai_quality_filter
            [ai_score, ai_breakdown] = Core.calculate_ai_quality_score(z, isDemand, feature_rvol, feature_session, feature_trend, feature_adx, feature_htf_trend, feature_rsi, (z.top - z.bottom) / atr14)
            bool ai_would_block = ai_score < effective_ai_threshold
            if ai_would_block
                string ai_reason = "AI Quality: " + str.tostring(ai_score, "#.0") + " < " + str.tostring(effective_ai_threshold) + " [" + ai_breakdown + "]"
                if enable_ai_shadow_mode
                    // Shadow mode: log but do NOT block — trade proceeds
                    reason := "[SHADOW] " + ai_reason
                else
                    canEnter := false
                    reason := ai_reason

    // === RETURN SPEED VALIDATION (Bar-Count Filters) ===
    // Use FIRST touch after sweep (structural) rather than the current bar,
    // so same-bar sweep+touch correctly counts as 0 and later entry bars don't inflate it.
    if canEnter
        int sweep_bars = na
        int peak_bars  = na

        // Sweep -> Touch: bars between liquidity sweep and the first zone touch
        if z.liquiditySwept and not na(z.liquiditySweptBarIndex) and not na(z.lastTouchBar) and z.lastTouchBar >= z.liquiditySweptBarIndex
            sweep_bars := z.lastTouchBar - z.liquiditySweptBarIndex

        // Peak -> Touch: bars between structural extreme and the first zone touch
        if not na(z.peakBarIndex) and not na(z.lastTouchBar) and z.lastTouchBar >= z.peakBarIndex
            peak_bars := z.lastTouchBar - z.peakBarIndex

        if not na(sweep_bars) and sweep_bars > max_sweep_to_touch_bars
            canEnter := false
            reason := "Too slow after sweep"
        else if not na(peak_bars) and peak_bars > max_peak_to_touch_bars
            canEnter := false
            reason := "Return drop/rally too slow"

    [canEnter, reason, z]

// === TRADE TRACKING VARIABLES ===
var float trade_entry_price      = na
var float trade_original_sl      = na
var float trade_original_sl_pips = na
var float trade_current_sl       = na
var bool  labels_created         = false
var float trade_tp1_price        = na
var bool  tp1_hit                = false
var string active_entry_id       = na  // Tracks which entry is active: "Long" or "Long Flip"
var float trade_be_trigger_rr      = na  // RR level when to move SL to BE
var float trade_be_sl_pips         = na  // Minimum SL in pips when moving to BE
var bool  trade_be_moved           = false  // Track if BE move has been executed

// === EXIT TELEMETRY TRACKING ===
var int   trade_entry_bar_index = na      // Bar index when trade was entered
var float trade_worst_price     = na      // Worst price during trade (for MAE)
var int   trade_zone_id         = na      // Zone ID that triggered entry
var float trade_zone_score      = na      // Zone score at entry
var int   trade_zone_freshness  = na      // Zone freshness (touch count) at entry
var int   trade_session         = na      // Session at entry
var float trade_atr_ratio       = na      // ATR ratio at entry
var int   trade_trend           = na      // Trend at entry
var float trade_rsi             = na      // RSI at entry
var int   trade_htf_trend       = na      // HTF trend at entry
var float trade_rvol            = na      // RVOL at entry
var float trade_adx             = na      // ADX at entry
var int   trade_touch_count     = na      // Touch count at entry
var float trade_base_quality    = na      // Base quality at entry
var float trade_departure_str   = na      // Departure strength at entry
var float trade_liq_distance    = na      // Liquidity distance at entry
var float trade_liq_spread      = na      // Liquidity spread at entry
var bool  trade_liq_swept       = false   // Liquidity swept at entry
var bool  trade_target_swept    = false   // Target swept at entry
var bool  trade_caused_sweep    = false   // Caused sweep at entry
var bool  trade_is_accuracy     = false   // Is accuracy zone
var string trade_entry_model    = na      // Entry model used
var string trade_zone_type      = na      // Zone type (demand/supply)

// Track whether current trade originated from an accuracy zone
var bool  trade_is_accuracy_zone = false

// === PERFORMANCE STATISTICS ===
// Entry evaluation stats
var int stat_total_entry_checks            = 0
var int stat_entries_blocked_by_timing     = 0
var int stat_entries_blocked_by_liquidity  = 0

// Win rate by zone type (Accuracy vs Normal)
var int stat_trades_accuracy_total  = 0
var int stat_trades_accuracy_wins   = 0
var int stat_trades_accuracy_losses = 0

var int stat_trades_normal_total  = 0
var int stat_trades_normal_wins   = 0
var int stat_trades_normal_losses = 0

// Average RR by symbol type
var float stat_rr_sum_xau   = 0.0
var int   stat_rr_count_xau = 0

var float stat_rr_sum_jpy   = 0.0
var int   stat_rr_count_jpy = 0

var float stat_rr_sum_other   = 0.0

var int   stat_rr_count_other = 0


// Grade Stats
var int stat_grade_A_total = 0
var int stat_grade_A_wins  = 0
var int stat_grade_B_total = 0
var int stat_grade_B_wins  = 0
var int stat_grade_C_total = 0
var int stat_grade_C_wins  = 0

// Track whether current trade originated from an accuracy zone (Already declared above)
var string trade_entry_grade      = "C"  // Track grade of current trade

// === PERFORMANCE TABLE (Top Right - The Scoreboard) ===
var table performanceTable = na

draw_performance_table(tbl) =>
    table result = tbl

    if show_performance_table and showResults and barstate.islastconfirmedhistory
        if na(result)
            // 3. Performance Table (Top Right)
            result := table.new(position.top_right, 2, 9, 
                 bgcolor = color.new(color.rgb(30, 35, 40), 5), 
                 border_width = 1, border_color = color.new(color.white, 70), 
                 frame_width = 1, frame_color = color.new(color.white, 70))

        if not na(result)
            // === BUILT-IN STRATEGY METRICS ===
            float net_profit = strategy.netprofit
            int total_closed = strategy.closedtrades
            int total_open = strategy.opentrades
            int total_trades = total_closed + total_open
            float gross_profit = strategy.grossprofit
            float gross_loss = math.abs(strategy.grossloss)
            float max_dd = strategy.max_drawdown
            int win_trades = strategy.wintrades
            
            // Calculate derived metrics with divide-by-zero protection
            float win_rate = total_closed > 0 ? (float(win_trades) / float(total_closed)) * 100 : 0.0
            float profit_factor = gross_loss > 0 ? gross_profit / gross_loss : (gross_profit > 0 ? 999.99 : 0.0)
            
            // Color for Net Profit (green if positive, red if negative)
            color profit_color = net_profit >= 0 ? color.rgb(0, 200, 100) : color.rgb(255, 80, 80)
            
            // === HEADER ===
            
            // Get date of the first closed trade to show data range
            int first_trade_time = strategy.closedtrades > 0 ? strategy.closedtrades.entry_time(0) : na
            string date_str = not na(first_trade_time) ? str.format("{0,date,short}", first_trade_time) : "N/A"
            
            table.cell(result, 0, 0, "📊 RESULTS", text_color = color.white, bgcolor = color.rgb(40, 40, 40), text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)), text_halign = text.align_left)
            table.cell(result, 1, 0, "Since " + date_str, text_color = color.gray, bgcolor = color.rgb(40, 40, 40), text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)), text_halign = text.align_right)
            
            // === 1. NET PROFIT ===
            table.cell(result, 0, 1, "Net Profit", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            string profit_str = (net_profit >= 0 ? "$" : "-$") + str.tostring(math.abs(net_profit), "#,##0.00")
            table.cell(result, 1, 1, profit_str, text_color = profit_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            
            // === 2. TOTAL TRADES ===
            table.cell(result, 0, 2, "Total Trades", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            table.cell(result, 1, 2, str.tostring(total_trades), text_color = color.rgb(200, 200, 200), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            
            // === 3. WIN RATE ===
            table.cell(result, 0, 3, "Win Rate", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            string wr_str = str.tostring(win_rate, "#.00") + "% (" + str.tostring(win_trades) + "/" + str.tostring(total_closed) + ")"
            color wr_color = win_rate >= 50 ? color.rgb(0, 200, 100) : color.rgb(255, 180, 80)
            table.cell(result, 1, 3, wr_str, text_color = wr_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            
            // === 4. PROFIT FACTOR ===
            table.cell(result, 0, 4, "Profit Factor", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            string pf_str = gross_loss > 0 ? str.tostring(profit_factor, "#.00") : (gross_profit > 0 ? "∞" : "N/A")
            color pf_color = profit_factor >= 1.5 ? color.rgb(0, 200, 100) : (profit_factor >= 1.0 ? color.rgb(255, 180, 80) : color.rgb(255, 80, 80))
            table.cell(result, 1, 4, pf_str, text_color = pf_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            
            // === 5. MAX DRAWDOWN ===
            table.cell(result, 0, 5, "Max Drawdown", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            string dd_str = "-$" + str.tostring(math.abs(max_dd), "#,##0.00")
            table.cell(result, 1, 5, dd_str, text_color = color.rgb(255, 100, 100), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))

            // === 6. GRADE STATS ===
            table.cell(result, 0, 6, "A-Grade WR", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            string a_wr_str = str.tostring(Utils.safe_percent(stat_grade_A_wins, stat_grade_A_total), "#.0") + "% (" + str.tostring(stat_grade_A_total) + ")"
            table.cell(result, 1, 6, a_wr_str, text_color = color.white, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))

            table.cell(result, 0, 7, "B-Grade WR", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            string b_wr_str = str.tostring(Utils.safe_percent(stat_grade_B_wins, stat_grade_B_total), "#.0") + "% (" + str.tostring(stat_grade_B_total) + ")"
            table.cell(result, 1, 7, b_wr_str, text_color = color.white, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))

            // === 8. AI FILTER STATUS ===
            table.cell(result, 0, 8, "AI Filter", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            string ai_filter_str = enable_ai_quality_filter ? ("ON (≥" + str.tostring(ai_quality_threshold) + ")") : "OFF"
            color ai_color = enable_ai_quality_filter ? color.rgb(0, 200, 100) : color.rgb(150, 150, 150)
            table.cell(result, 1, 8, ai_filter_str, text_color = ai_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))

    // When disabled, clear existing table so stale data doesn't remain on chart.
    if (not show_performance_table or not showResults) and not na(result)
        // Overwrite all cells instead of using table.clear for Pine v6 compatibility
        for r = 0 to 8
            table.cell(result, 0, r, "", bgcolor = color.new(color.black, 100))
            table.cell(result, 1, r, "", bgcolor = color.new(color.black, 100))

    result

// === POSITION SIZING TRACKING (for debug table) ===
var int   last_pos_size_units    = na  // Last calculated position size in units
var float last_pos_size_lots     = na  // Last calculated position size in lots
var float last_pos_size_entry    = na  // Last entry price used for position sizing
var float last_pos_size_sl       = na  // Last stop loss used for position sizing
var float last_pos_size_balance  = na  // Last account balance used
var float last_pos_size_risk_pct = na  // Last risk percentage used
var float last_pos_size_sl_pips  = na  // Last SL in pips
var float last_pos_size_usdjpy_rate = na  // Last USDJPY rate (if applicable)
var bool  last_pos_size_valid    = false  // Whether last position size was valid
var string last_pos_size_error   = ""  // Last position size error message
var bool  last_pos_size_dry_run  = false  // Whether last sizing was in dry run mode

// Pending long entry (for next-bar execution, non-repainting)
var bool  long_signal_pending    = false
var float long_pending_sl_price  = na
var float long_pending_tp_price  = na
var float long_pending_sl_pips   = na
var string long_pending_entry_type = na  // Entry type: "DIR LONG", "BOC LONG", "FLIP LONG"

// Pending short entry (for next-bar execution, non-repainting)
var bool  short_signal_pending   = false
var float short_pending_sl_price = na
var float short_pending_tp_price = na
var float short_pending_sl_pips  = na

// One global guard: only one long entry per bar
// One global guard: only one long/short entry per bar
var int last_global_long_entry_bar = na
var int last_global_short_entry_bar = na

// === ENTRY TRIGGER SYNC FLAG (for Zone Inspector synchronization) ===
// This flag is set to true when an entry is triggered, BEFORE the zone is marked inactive
// Reset at the start of each bar to ensure accurate display
var bool entryTriggeredThisBar = false
var int triggeredZoneId = na

// Reset at start of each bar
if barstate.isconfirmed[1] or barstate.isfirst
    entryTriggeredThisBar := false
    triggeredZoneId := na

// === TARGET SWEPT DEBUG TRACKING ===
// Track when targetSwept becomes true for visual debugging
var bool targetSweptThisBar = false
if barstate.isconfirmed[1] or barstate.isfirst
    targetSweptThisBar := false

// === TRADE PER DAY TRACKING ===
var int current_day_trades = 0
var int last_trade_day = na

// === DAILY PNL TRACKING ===
var float daily_pnl = 0.0
var float daily_start_equity = 0.0
var int last_pnl_day = na

// Reset daily PnL at start of day
current_day_ts = time("D")
if (reset_daily_pnl and current_day_ts != last_pnl_day)
    daily_pnl := 0.0
    daily_start_equity := strategy.equity
    last_pnl_day := current_day_ts

// Update PnL from closed trades
if strategy.closedtrades > 0
    daily_pnl := strategy.equity - daily_start_equity

// Check Daily Limits
is_daily_loss_limit_hit() =>
    loss_limit = daily_start_equity * (max_daily_loss_pct / 100.0)
    daily_pnl < -loss_limit

is_daily_profit_limit_hit() =>
    profit_limit = daily_start_equity * (max_daily_profit_pct / 100.0)
    daily_pnl > profit_limit

// Update trades_allowed_today to include PnL limits
trades_allowed_today() =>
    // Check trade limit only if enabled
    trade_limit_ok = enable_trade_limit ? current_day_trades < max_trades_per_day : true
    trade_limit_ok and not is_daily_loss_limit_hit() and not is_daily_profit_limit_hit()


is_late_friday() =>
    day_of_week = dayofweek(time, "Etc/GMT+5")
    current_hour = hour(time, "Etc/GMT+5")
    day_of_week == dayofweek.friday and current_hour >= 20

// === HTF CONTEXT CHECK (For Flip Entry) ===
// Check if current bar is on a 15-minute boundary (xx:00, xx:15, xx:30, xx:45)
// Flip entries only valid on these exact candle opens
is_htf_candle_open() =>
    int currentMinute = minute(time)
    currentMinute % 15 == 0

// Helper function to get readable dead zone status for debugging
getDeadZoneStatus() =>
    if not filter_dead_zone
        "Disabled"
    else if is_time_dead_zone()
        "BLOCKED (" + str.tostring(minute(time)) + "m)"
    else
        "OK"

// === TRADE PER DAY TRACKING (INLINE) ===
// Reset trade count if new day
current_day_start = time("D", "Etc/GMT+5")
if na(last_trade_day) or current_day_start != last_trade_day
    current_day_trades := 0
    last_trade_day := current_day_start

// Helper to check if trades allowed
// Helper logic already replaced above
// trades_allowed_today() =>
//     current_day_trades < max_trades_per_day

// === Helper: Bull/Bear ===
// Unified zone finder - consolidates demand/supply zone lookups
findZoneIndexByUZID(int targetUZID, Core.Zone[] zones) =>
    int idx = na
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Core.Zone z = array.get(zones, i)
            if z.id == targetUZID
                idx := i
                break
    idx

// Convenience wrappers for backward compatibility
findDemandZoneIndexByUZID(targetUZID) =>
    findZoneIndexByUZID(targetUZID, demandZones)

findSupplyZoneIndexByUZID(targetUZID) =>
    findZoneIndexByUZID(targetUZID, supplyZones)

// === ZONE LIVE VALIDATION HELPERS ===
// Strict re-validation function used immediately before strategy.entry
// Returns [isLive, cancelReason] - zone must be active, not mitigated, not removed
f_demand_zone_is_live(int idx) =>
    if idx < 0 or idx >= array.size(demandZones)
        [false, "Zone index invalid"]
    else
        Core.Zone z = array.get(demandZones, idx)
        if not z.active
            [false, "Zone inactive"]
        else if z.mitigated
            [false, "Zone mitigated"]
        else if na(z.id)
            [false, "Zone removed"]
        else if not na(z.inactiveReason) and str.length(z.inactiveReason) > 0 and not str.contains(z.inactiveReason, "Model:")
            [false, "Zone invalid: " + z.inactiveReason]
        else
            [true, ""]

f_supply_zone_is_live(int idx) =>
    if idx < 0 or idx >= array.size(supplyZones)
        [false, "Zone index invalid"]
    else
        Core.Zone z = array.get(supplyZones, idx)
        if not z.active
            [false, "Zone inactive"]
        else if z.mitigated
            [false, "Zone mitigated"]
        else if na(z.id)
            [false, "Zone removed"]
        else if not na(z.inactiveReason) and str.length(z.inactiveReason) > 0 and not str.contains(z.inactiveReason, "Model:")
            [false, "Zone invalid: " + z.inactiveReason]
        else
            [true, ""]

// === Helper: deactivate demand zones after a trade ===
// === Helper: deactivate demand zones after a trade ===
deactivateDemandZone(idx) =>
    if idx >= 0 and idx < array.size(demandZones)
        Core.Zone z = array.get(demandZones, idx)
        z.active := false
        // Optional: Change visual style to indicate inactive/used
        // For now, we keep the same style or maybe dim it?
        // Original code just reset colors which might be redundant if they are already set.
        // But let's keep it consistent.
        box.set_bgcolor(z.boxId,col_demand_bg)
        box.set_border_color(z.boxId,col_demand_border)

// === Helper: deactivate supply zones after a trade ===
deactivateSupplyZone(idx) =>
    if idx >= 0 and idx < array.size(supplyZones)
        Core.Zone z = array.get(supplyZones, idx)
        z.active := false
        box.set_bgcolor(z.boxId,col_supply_bg)
        box.set_border_color(z.boxId,col_supply_border)

deactivateOverlappingSupplyZones(refLow, refHigh) =>
    for k = 0 to array.size(supplyZones) - 1
        Core.Zone z = array.get(supplyZones, k)
        if z.active
            overlaps = not (z.top < refLow or z.bottom > refHigh)
            if overlaps
                deactivateSupplyZone(k)

deactivateOverlappingDemandZones(refLow, refHigh) =>
    for k = 0 to array.size(demandZones) - 1
        Core.Zone z = array.get(demandZones, k)
        if z.active
            overlaps = not (z.top < refLow or z.bottom > refHigh)
            if overlaps
                deactivateDemandZone(k)

// === DEMAND ZONE CREATION ===
// isHistorical = true  -> created during initial backfill scan
// isHistorical = false -> created in live processing (recent bars)

// --- 1. DEMAND ZONE DETECTION (recent bars) ---
// Pattern: BULLISH candle(s) followed by BEARISH candle
if barstate.isconfirmed and bar_index > 10
    if Utils.is_bullish(close, open) and Utils.is_bullish(close[1], open[1]) and Utils.is_bullish(close[2], open[2]) and Utils.is_bearish(close[3], open[3])
        baseBarIdx = bar_index - 3
        if not is_base_bar_used(baseBarIdx, used_demand_base_times)
            global_zone_id_counter += 1
            createZone(3, true, false, 1, 3, global_zone_id_counter)
    else if Utils.is_bullish(close, open) and Utils.is_bullish(close[1], open[1]) and Utils.is_bearish(close[2], open[2])
        baseBarIdx = bar_index - 2
        if not is_base_bar_used(baseBarIdx, used_demand_base_times)
            global_zone_id_counter += 1
            createZone(2, true, false, 1, 2, global_zone_id_counter)
    else if Utils.is_bullish(close, open) and Utils.is_bearish(close[1], open[1])
        baseBarIdx = bar_index - 1
        if not is_base_bar_used(baseBarIdx, used_demand_base_times)
            global_zone_id_counter += 1
            createZone(1, true, false, 1, 1, global_zone_id_counter)

// --- 2. SUPPLY ZONE DETECTION (recent bars) ---
if barstate.isconfirmed and bar_index > 10
    if Utils.is_bearish(close, open) and Utils.is_bearish(close[1], open[1]) and Utils.is_bearish(close[2], open[2]) and Utils.is_bullish(close[3], open[3])
        baseBarIdx = bar_index - 3
        if not is_base_bar_used(baseBarIdx, used_supply_base_times)
            global_zone_id_counter += 1
            createZone(3, false, false, 1, 3, global_zone_id_counter)
    else if Utils.is_bearish(close, open) and Utils.is_bearish(close[1], open[1]) and Utils.is_bullish(close[2], open[2])
        baseBarIdx = bar_index - 2
        if not is_base_bar_used(baseBarIdx, used_supply_base_times)
            global_zone_id_counter += 1
            createZone(2, false, false, 1, 2, global_zone_id_counter)
    else if Utils.is_bearish(close, open) and Utils.is_bullish(close[1], open[1])
        baseBarIdx = bar_index - 1
        if not is_base_bar_used(baseBarIdx, used_supply_base_times)
            global_zone_id_counter += 1
            createZone(1, false, false, 1, 1, global_zone_id_counter)

// --- 3. HISTORICAL ZONE SCAN (once) ---
if barstate.isconfirmed and not initial_scan_done and bar_index > 50
    initial_scan_done := true
    max_scan = math.min(100, bar_index)
    for i = 2 to max_scan
        baseBarIdxDemand = bar_index - i
        if i >= 3 and Utils.is_bearish(close[i], open[i]) and Utils.is_bullish(close[i - 1], open[i - 1]) and Utils.is_bullish(close[i - 2], open[i - 2]) and Utils.is_bullish(close[i - 3], open[i - 3])
            if not is_base_bar_used(baseBarIdxDemand, used_demand_base_times)
                global_zone_id_counter += 1
                createZone(i, true, true, 1, 3, global_zone_id_counter)
        else if Utils.is_bearish(close[i], open[i]) and Utils.is_bullish(close[i - 1], open[i - 1]) and Utils.is_bullish(close[i - 2], open[i - 2])
            if not is_base_bar_used(baseBarIdxDemand, used_demand_base_times)
                global_zone_id_counter += 1
                createZone(i, true, true, 1, 2, global_zone_id_counter)
        else if Utils.is_bearish(close[i], open[i]) and Utils.is_bullish(close[i - 1], open[i - 1])
            if not is_base_bar_used(baseBarIdxDemand, used_demand_base_times)
                global_zone_id_counter += 1
                createZone(i, true, true, 1, 1, global_zone_id_counter)
        baseBarIdxSupply = bar_index - i
        if i >= 3 and Utils.is_bullish(close[i], open[i]) and Utils.is_bearish(close[i - 1], open[i - 1]) and Utils.is_bearish(close[i - 2], open[i - 2]) and Utils.is_bearish(close[i - 3], open[i - 3])
            if not is_base_bar_used(baseBarIdxSupply, used_supply_base_times)
                global_zone_id_counter += 1
                createZone(i, false, true, 1, 3, global_zone_id_counter)
        else if Utils.is_bullish(close[i], open[i]) and Utils.is_bearish(close[i - 1], open[i - 1]) and Utils.is_bearish(close[i - 2], open[i - 2])
            if not is_base_bar_used(baseBarIdxSupply, used_supply_base_times)
                global_zone_id_counter += 1
                createZone(i, false, true, 1, 2, global_zone_id_counter)
        else if Utils.is_bullish(close[i], open[i]) and Utils.is_bearish(close[i - 1], open[i - 1])
            if not is_base_bar_used(baseBarIdxSupply, used_supply_base_times)
                global_zone_id_counter += 1
                createZone(i, false, true, 1, 1, global_zone_id_counter)

// === LIQUIDITY VALIDATION FUNCTIONS ===
// Validate liquidity: must break previous structure by at least a few pips
// === SWING DETECTION FOR LIQUIDITY ===
// Check if a bar is a valid swing for liquidity detection
// barOffset is the offset from current bar_index where the liquidity/fractal occurred
// For example, if fractal is at bar_index - fractalsPeriod, then barOffset = fractalsPeriod
isValidSwingForLiquidity(barOffset, isHigh) =>
    // Check if the bar at barOffset is a valid swing
    // For 2-candle swing: bar[barOffset-1] must be lower/higher than both bar[barOffset-2] and bar[barOffset]
    // For 1-candle swing: bar[barOffset-1] must be lower/higher than bar[barOffset]
    
    // 2-candle swing detection (Williams Fractal pattern)
    isTwoCandleSwingLow = low[barOffset - 1] < low[barOffset - 2] and low[barOffset - 1] < low[barOffset]
    isTwoCandleSwingHigh = high[barOffset - 1] > high[barOffset - 2] and high[barOffset - 1] > high[barOffset]
    
    // 1-candle swing detection (simpler pattern)
    isOneCandleSwingLow = low[barOffset - 1] < low[barOffset]
    isOneCandleSwingHigh = high[barOffset - 1] > high[barOffset]
    
    // Combined validation
    if isHigh
        // For high liquidity: check if it's a valid swing high
        liqHighValid = isTwoCandleSwingHigh or (useOneCandleLiquidity and isOneCandleSwingHigh)
        liqHighValid
    else
        // For low liquidity: check if it's a valid swing low
        liqLowValid = isTwoCandleSwingLow or (useOneCandleLiquidity and isOneCandleSwingLow)
        liqLowValid

// Simplified validation - check if liquidity breaks previous swing
validate_liquidity_formation(liqBarIdx, zoneCreatedBarIdx, liqPrice, isHigh) =>
    if liqBarIdx <= zoneCreatedBarIdx
        false
    else
        // First, check if the liquidity bar itself is a valid swing
        // For new fractals being validated: fractalBar = bar_index - fractalsPeriod
        // So the offset from current bar_index to the fractal bar is fractalsPeriod
        // We check if the bar at offset fractalsPeriod is a valid swing
        // For existing liquidity, we can't reliably check historical swings, so we skip the check
        liqBarAge = liqBarIdx - zoneCreatedBarIdx
        is_new_fractal = (liqBarAge <= fractalsPeriod + 2)  // New fractal is close to current bar
        
        is_valid_swing = true  // Default to true for existing liquidity
        if is_new_fractal and fractalsPeriod >= 2  // Only check for new fractals with enough bars
            is_valid_swing := isValidSwingForLiquidity(fractalsPeriod, isHigh)
        
        if not is_valid_swing
            false  // Not a valid swing, reject
        else
            // Find previous swing high/low before liquidity formation
            float prev_swing = na
            bars_to_check = math.min(liqBarIdx - zoneCreatedBarIdx + 10, 30)  // Look back reasonable amount
            
            // Look back to find previous significant swing using the same swing logic,
            // without relying on additional fractal helper calls.
            for offset = fractalsPeriod to bars_to_check
                if isHigh
                    // Check if this offset forms a valid swing high
                    if isValidSwingForLiquidity(offset, true)
                        float swing_val = high[offset]
                        if na(prev_swing) or swing_val > prev_swing
                            prev_swing := swing_val
                else
                    // Check if this offset forms a valid swing low
                    if isValidSwingForLiquidity(offset, false)
                        float swing_val = low[offset]
                        if na(prev_swing) or swing_val < prev_swing
                            prev_swing := swing_val
            
            // Must break previous structure by at least 2 pips
            if not na(prev_swing)
                if isHigh
                    liqPrice > prev_swing + (pip_size * 2)
                else
                    liqPrice < prev_swing - (pip_size * 2)
            else
                true  // If no previous swing found, assume valid (first liquidity)

// === LIQUIDITY VISUAL HELPERS (CONNECTORS, LABELS, COLOR ON SWEEP) ===
// === LIQUIDITY VISUAL HELPERS (CONNECTORS ONLY - Info labels removed, use Zone Inspector) ===
clearDemandLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(demandZones)
        Core.Zone z = array.get(demandZones, idx)
        if not na(z.connectorLine)
            line.delete(z.connectorLine)
            z.connectorLine := na
        if not na(z.inducementHLine)
            line.delete(z.inducementHLine)
            z.inducementHLine := na
        if not na(z.targetHLine)
            line.delete(z.targetHLine)
            z.targetHLine := na

updateDemandLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(demandZones)
        Core.Zone z = array.get(demandZones, idx)

        // === ALWAYS draw inducement/target horizontal lines if they're set, regardless of liquidityPrice ===
        // These are pivot-based levels, independent of the original liquidity connector
        if show_liquidity_connectors
            // === HORIZONTAL LINE FOR INDUCEMENT (dashed orange, at liqLowPrice) ===
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)

            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                color indColor = z.liquiditySwept ? color.new(color.orange, 0) : color.new(color.orange, 50)
                int lineEnd = bar_index + 20
                z.inducementHLine := line.new(x1 = z.liqLowBar, y1 = z.liqLowPrice,
                                               x2 = lineEnd, y2 = z.liqLowPrice,
                                               xloc = xloc.bar_index, extend = extend.none,
                                               color = indColor, style = line.style_dashed, width = 1))

            // === HORIZONTAL LINE FOR TARGET (solid lime, at liqHighPrice) ===
            if not na(z.targetHLine)
                line.delete(z.targetHLine)

            if not na(z.liqHighPrice) and not na(z.liqHighBar)
                color tgtColor = z.targetSwept ? color.new(color.lime, 0) : color.new(color.lime, 50)
                int lineEnd = bar_index + 20
                z.targetHLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice,
                                           x2 = lineEnd, y2 = z.liqHighPrice,
                                           xloc = xloc.bar_index, extend = extend.none,
                                           color = tgtColor, style = line.style_solid, width = 1))
        else
            // Clear horizontal lines if toggle is disabled
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na

        // === ZONE-TO-LIQUIDITY CONNECTOR LINE (only if original liquidity price set) ===
        if na(z.liquidityPrice) or na(z.liquidityBarIndex) or na(z.createdBarIndex) or not show_liquidity_connectors
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na
        else
            float mid = (z.top + z.bottom) / 2.0
            if not na(z.connectorLine)
                line.delete(z.connectorLine)

            lineStyle = z.liquiditySwept ? line.style_solid : line.style_dotted
            lineWidth = z.liquiditySwept ? 2 : 1
            z.connectorLine := line.new(x1 = z.createdBarIndex, y1 = mid, x2 = z.liquidityBarIndex, y2 = z.liquidityPrice,
                                  xloc = xloc.bar_index, extend = extend.none,
                                  color = liq_line_color, style = lineStyle, width = lineWidth))
        true


clearSupplyLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(supplyZones)
        Core.Zone z = array.get(supplyZones, idx)
        if not na(z.connectorLine)
            line.delete(z.connectorLine)
            z.connectorLine := na
        if not na(z.targetLine)
            line.delete(z.targetLine)
            z.targetLine := na
        if not na(z.inducementHLine)
            line.delete(z.inducementHLine)
            z.inducementHLine := na
        if not na(z.targetHLine)
            line.delete(z.targetHLine)
            z.targetHLine := na

updateSupplyLiquidityVisual(idx) =>
    if idx >= 0 and idx < array.size(supplyZones)
        Core.Zone z = array.get(supplyZones, idx)

        // === ALWAYS draw inducement/target horizontal lines if they're set, regardless of liqHighPrice status ===
        // These are pivot-based levels, independent of the original liquidity connector
        if show_liquidity_connectors
            // === HORIZONTAL LINE FOR INDUCEMENT (dashed orange, at liqHighPrice) ===
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)

            if not na(z.liqHighPrice) and not na(z.liqHighBar)
                color indColor = z.liquiditySwept ? color.new(color.orange, 0) : color.new(color.orange, 50)
                int lineEnd = bar_index + 20
                z.inducementHLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice,
                                               x2 = lineEnd, y2 = z.liqHighPrice,
                                               xloc = xloc.bar_index, extend = extend.none,
                                               color = indColor, style = line.style_dashed, width = 1))

            // === HORIZONTAL LINE FOR TARGET (solid lime, at liqLowPrice) ===
            if not na(z.targetHLine)
                line.delete(z.targetHLine)

            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                color tgtColor = z.targetSwept ? color.new(color.lime, 0) : color.new(color.lime, 50)
                int lineEnd = bar_index + 20
                z.targetHLine := line.new(x1 = z.liqLowBar, y1 = z.liqLowPrice,
                                           x2 = lineEnd, y2 = z.liqLowPrice,
                                           xloc = xloc.bar_index, extend = extend.none,
                                           color = tgtColor, style = line.style_solid, width = 1))
        else
            // Clear horizontal lines if toggle is disabled
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na

        // === CONNECTOR LINES (only if liqHighPrice set) ===
        if na(z.liqHighPrice) or na(z.liqHighBar) or na(z.createdBarIndex) or not show_liquidity_connectors
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na
            if not na(z.targetLine)
                line.delete(z.targetLine)
                z.targetLine := na
        else
            float zBottom = z.bottom

            // === LINE 1: Zone to Inducement HIGH (gray, dashed) ===
            if not na(z.connectorLine)
                line.delete(z.connectorLine)

            indStyle = z.liquiditySwept ? line.style_dashed : line.style_dotted
            indWidth = z.liquiditySwept ? 2 : 1
            z.connectorLine := line.new(x1 = z.createdBarIndex, y1 = zBottom, x2 = z.liqHighBar, y2 = z.liqHighPrice,
                                  xloc = xloc.bar_index, extend = extend.none,
                                  color = liq_line_color, style = indStyle, width = indWidth))

            // === LINE 2: Inducement HIGH to Target LOW (gray, solid) ===
            if not na(z.liqLowPrice) and not na(z.liqLowBar)
                if not na(z.targetLine)
                    line.delete(z.targetLine)

                // Gray solid line for Target - distinct from Inducement dotted line
                targetColor = color.new(color.gray, 25)
                targetStyle = line.style_solid
                targetWidth = z.targetSwept ? 2 : 1
                z.targetLine := line.new(x1 = z.liqHighBar, y1 = z.liqHighPrice, x2 = z.liqLowBar, y2 = z.liqLowPrice,
                                      xloc = xloc.bar_index, extend = extend.none,
                                      color = targetColor, style = targetStyle, width = targetWidth))
        true


// === LIQUIDITY VALIDATION: SINGLE SOURCE OF TRUTH ===
// This helper is the ONLY place that decides whether a detected liquidity level
// is structurally valid for entries, for both demand and supply zones.
// It enforces:
//  1) Geometric relationship (liq above demand zone / below supply zone)
//  2) Opposite-candle count in the band using `countOppositeCandlesInBand` data
//  3) 1‑candle vs 2‑candle rule (useOneCandleLiquidity)
//  4) Zone impulse must have caused a liquidity sweep at creation (zoneCausedSweep)
isLiquidityValidForEntry(isDemand, idx) =>
    if idx < 0
        false
    else
        float zHigh = na
        float zLow  = na
        int   zCreatedBar = na
        float liqLevel = na
        int   liqBar   = na
        int   oppCount = 0
        bool  zoneCausedSweep = false

        if isDemand
            if idx >= array.size(demandZones)
                false
            else
                Core.Zone z = array.get(demandZones, idx)
                zHigh := z.top
                zLow  := z.bottom
                zCreatedBar := z.createdBarIndex
                liqLevel := z.liquidityPrice
                liqBar   := z.liquidityBarIndex
                oppCount := z.liquidityCandleCount
                zoneCausedSweep := z.causedSweep
        else
            if idx >= array.size(supplyZones)
                false
            else
                Core.Zone z = array.get(supplyZones, idx)
                zHigh := z.top
                zLow  := z.bottom
                zCreatedBar := z.createdBarIndex
                liqLevel := z.liquidityPrice
                liqBar   := z.liquidityBarIndex
                oppCount := z.liquidityCandleCount
                zoneCausedSweep := z.causedSweep

        // 1) Geometric check: liquidity must be on the correct side of zone
        // Respects use_inducement_linking toggle
        bool geomOk = false
        float dist_pips = na
        float sideTol = syminfo.mintick * liq_side_tol_ticks
        
        if isDemand
            if use_inducement_linking
                // MODEL B (Inducement): For demand, liquidity LOW must be ABOVE zoneHigh
                geomOk := not na(liqLevel) and liqLevel >= (zHigh - sideTol)
                dist_pips := (liqLevel - zHigh) / pip_size
            else
                // MODEL A (Standard): For demand, liquidity LOW must be BELOW zoneLow
                geomOk := not na(liqLevel) and liqLevel <= (zLow + sideTol)
                dist_pips := (zLow - liqLevel) / pip_size
        else
            if use_inducement_linking
                // MODEL B (Inducement): For supply, liquidity HIGH must be BELOW zoneLow
                geomOk := not na(liqLevel) and liqLevel <= (zLow + sideTol)
                dist_pips := (zLow - liqLevel) / pip_size
            else
                // MODEL A (Standard): For supply, liquidity HIGH must be ABOVE zoneHigh
                geomOk := not na(liqLevel) and liqLevel >= (zHigh - sideTol)
                dist_pips := (liqLevel - zHigh) / pip_size

        if not geomOk
            false
        else
            // 2) Liquidity must form after zone creation
            bool timingOk = not na(zCreatedBar) and not na(liqBar) and liqBar > zCreatedBar
            if not timingOk
                false
            else
                // 3) Opposite candle count rule - STRICT (no proximity exception)
                // Liquidity MUST have at least minCandles opposite candles forming the leg
                int minCandles = useOneCandleLiquidity ? 1 : 2
                bool candlesOk = oppCount >= minCandles
                
                if not candlesOk
                    false
                else
                    // 4) Zone impulse must have caused a sweep at creation
                    zoneCausedSweep



isValidEntry(isDemand, idx) =>
    [canEnter, reason, z] = validate_entry_conditions(isDemand, idx)

    // Note: Timing filter is now checked INSIDE validate_entry_conditions 
    // to prioritize the "Blocked by Timing" reason string.

    // SCORING FILTER
    if canEnter and enable_grade_filter
        // Since 'z' is returned from validate_entry_conditions (assuming I updated it to return z?), I need to check validation function signature.
        // Wait, validate_entry_conditions signature: [bool, string, Zone]
        // Let's check line 2896 in source: `[canEnter, reason, z]`. Yes.
        
        // Convert grades to value for comparison
        int minGradeVal = Core.get_grade_value(min_entry_grade)
        int zoneGradeVal = Core.get_grade_value(z.grade)
        
        if zoneGradeVal < minGradeVal
            canEnter := false
            reason := "Grade too low (" + z.grade + " < " + min_entry_grade + ")"




    if canEnter
        // Directional candle check with hammer/inverted hammer support
        float bodySize = math.abs(close - open)
        float candleRange = high - low
        float lowerWick = math.min(open, close) - low
        float upperWick = high - math.max(open, close)
        
        // Hammer detection: Long lower wick (>= 60% of range), small body
        bool isHammer = lowerWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3
        
        // Inverted hammer: Long upper wick (>= 60% of range), small body
        bool isInvertedHammer = upperWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3
        
        bool correct_direction = false
        if isDemand
            // For demand: Standard bullish OR hammer (even if slightly bearish)
            correct_direction := (close > open) or isHammer
        else
            // For supply: Standard bearish OR inverted hammer
            correct_direction := (close < open) or isInvertedHammer
        
        if not correct_direction
            canEnter := false
            reason := isDemand ? "Waiting for Bullish Close or Hammer" : "Waiting for Bearish Close or Inv. Hammer"

    if canEnter

        lastEntryBar = isDemand ? last_global_long_entry_bar : last_global_short_entry_bar
        bool noEntryThisBar = na(lastEntryBar) or bar_index > lastEntryBar
        if not noEntryThisBar
            canEnter := false
            reason := isDemand ? "Long entry already taken this bar" : "Short entry already taken this bar"

    if canEnter and strategy.position_size != 0
        canEnter := false
        reason := "Existing position open (no stacking)"

    [canEnter, reason]

// Wrapper functions for backward compatibility
isValidDemandEntry(idx) => isValidEntry(true, idx)
isValidSupplyEntry(idx) => isValidEntry(false, idx)

// === GLOBAL SWING CALCULATIONS ===
// Calculate these once per bar to avoid "ta.* should be called on each calculation" warnings
int global_swing_lookback = math.min(liq_link_lookback_bars, liq_fallback_lookback)
float global_swing_low = ta.lowest(low, global_swing_lookback)
int global_swing_low_bar = bar_index - ta.lowestbars(low, global_swing_lookback)
float global_swing_high = ta.highest(high, global_swing_lookback)
int global_swing_high_bar = bar_index - ta.highestbars(high, global_swing_lookback)

// === TRACK LIQUIDITY AND ZONE STATUS (DEMAND) ===
// CRITICAL: Only validate liquidity sweeps for LIVE zones (not historical backfill)
// OPTIMIZATION: Use cached array size
if cached_demand_size > 0 and barstate.isconfirmed
    current_close = close
    current_open = open

    for i = 0 to cached_demand_size - 1
        if i >= array.size(demandZones)
            break
        Core.Zone z = array.get(demandZones, i)
        if z.active
            // Skip historical zones - we don't validate sweeps for them
            if z.isHistorical
                continue  // Skip all liquidity validation for historical zones
            
            // === VALIDATE EXISTING LIQUIDITY ===
            // Clear invalid liquidity that doesn't match the selected mode
            if not na(z.liquidityPrice)
                float sideTol = syminfo.mintick * liq_side_tol_ticks
                bool isInvalid = false
                
                if use_inducement_linking
                    // MODEL B (Inducement): Liquidity LOW must be ABOVE zone (z.top)
                    // Invalid if it's BELOW zone top (minus tolerance)
                    if z.liquidityPrice < (z.top - sideTol)
                        isInvalid := true
                else
                    // MODEL A (Standard): Liquidity LOW must be BELOW zone (z.bottom)
                    // Invalid if it's ABOVE zone bottom (plus tolerance)
                    if z.liquidityPrice > (z.bottom + sideTol)
                        isInvalid := true
                
                if isInvalid
                    // Invalid liquidity - clear it
                    z.liquidityPrice := na
                    z.liquidityBarIndex := na
                    z.liquiditySwept := false
                    z.liquiditySweptBarIndex := na
                    z.causedSweep := false
                    z.structureSweepLevel := na
                    z.structureSweepLevelBar := na
                    // Reset per-zone liquidity validity / count
                    z.liquidityValid := false
                    z.inactiveReason := "LIQ_WRONG_SIDE"
                    z.liquidityCandleCount := 0
                    // Clear any visual connector/label for this zone's liquidity
                    clearDemandLiquidityVisual(i)
            
            // === DEMAND LIQUIDITY SELECTION (Throttled for Performance) ===
            // SANITY CHECK: If liquidity is stored but its bar is in the future (Replay issue), invalidate it to force re-scan
            bool isFutureLiqDemand = z.liquidityValid and not na(z.liquidityBarIndex) and z.liquidityBarIndex > bar_index

            // If ghost data detected, WIPE IT immediately before scanning
            if isFutureLiqDemand
                z.liquidityValid := false
                z.liquidityPrice := na
                z.liquidityBarIndex := na
                z.liqLowPrice := na
                z.liqHighPrice := na
                z.structureSweepLevel := na
                z.inactiveReason := "Ghost Data Cleared"

            // Scan if invalid, cleared, or not yet used for entry (allows finding better inducements until entry)
            if not z.liquidityValid or na(z.lastEntryBar)
                f_scan_demand_liquidity(i)
            
            // === DEMAND SWEEP DETECTION (via modular function) ===
            f_check_demand_sweeps(i)


            // Update demand liquidity visuals (connector + label)
            updateDemandLiquidityVisual(i)
            
            if current_close > z.top and not z.leftZone
                z.leftZone := true
                z.leftWithBearish := current_close < current_open

            // === STRICT MITIGATION CHECK (DEMAND) ===
            // Zone is killed on ANY wick touch BEFORE liquidity sweep to enforce "Fresh Zone Only"
            // Conditions for mitigation:
            // 1) Price CLOSES inside the zone, OR
            // 2) Price wicks THROUGH the entire zone (breach - low goes below zone bottom), OR
            // 3) Price wicks INTO zone (fresh touch before setup ready) - STRICT RULE
            if not z.mitigated
                bool is_future_bar = not na(z.createdBarIndex) and bar_index > z.createdBarIndex

                // Close inside zone (bearish invalidation)
                bool closes_inside = close <= z.top and close >= z.bottom

                // Breach - price wicks through entire zone (wick below zone bottom)
                bool breaches_zone = low < z.bottom

                // Wick INTO zone (touch) - STRICT RULE: Kill zone before setup is ready
                bool wicks_into_zone = low <= z.top and low >= z.bottom

                // SIMULTANEOUS SWEEP: If current bar sweeps target, allow entry (exception to strict rule)
                bool current_bar_sweeping = not na(z.structureSweepLevel) and high > z.structureSweepLevel

                // UPDATED: Separate Touch from Mitigation
                // Preserve old working behavior for touchedPreSweep (strict), and add delayed re-touch invalidation.
                if is_future_bar and z.leftZone and not z.liquiditySwept and (closes_inside or wicks_into_zone or breaches_zone)
                    int touchBarNow = bar_index
                    z.lastTouchBar := touchBarNow
                    z.wasTouched := true

                    // 1) Old strict behavior: flag pre-sweep touch only when liquidity anchor bar itself touches.
                    bool is_liq_bar = false
                    if not na(z.liquidityBarIndex) and touchBarNow == z.liquidityBarIndex
                        is_liq_bar := true
                    else if not na(z.liqLowBar) and touchBarNow == z.liqLowBar
                        is_liq_bar := true
                    else if not na(z.liqHighBar) and touchBarNow == z.liqHighBar
                        is_liq_bar := true

                    // 2) New delayed re-touch rule: if touch happens well after liquidity anchor, mark stale.
                    // This blocks late returns (zone 17422-type) without blocking immediate valid setups (zone 17398-type).
                    int liq_anchor_bar = na
                    if not na(z.liquidityBarIndex)
                        liq_anchor_bar := z.liquidityBarIndex
                    else if not na(z.liqLowBar)
                        liq_anchor_bar := z.liqLowBar
                    else if not na(z.liqHighBar)
                        liq_anchor_bar := z.liqHighBar

                    // Strict delayed re-touch rule: block if touch happens 4+ bars after liquidity anchor
                    bool delayed_retouch = not na(liq_anchor_bar) and (touchBarNow - liq_anchor_bar >= 4)

                    if is_liq_bar or delayed_retouch
                        z.touchedPreSweep := true

                // MITIGATION (VANISH): Kill zone if CLOSED INSIDE or FULLY BREACHED
                // This restores strict strategy behavior. Wick touches still survive (recording touchedPreSweep).
                if is_future_bar and z.leftZone and not z.liquiditySwept and (closes_inside or breaches_zone) and not current_bar_sweeping
                    remove_zone_all_arrays(true, i)
                    continue // Skip to next zone since this one is gone

// === TRACK LIQUIDITY AND ZONE STATUS (SUPPLY) ===
// CRITICAL: Only validate liquidity sweeps for LIVE zones (not historical backfill)
// For supply zones, liquidity is BELOW the zone - must be a proper swing LOW
// OPTIMIZATION: Use cached array size
if cached_supply_size > 0 and barstate.isconfirmed
    current_close = close
    current_open = open
    current_low = low

    for i = 0 to cached_supply_size - 1
        if i >= array.size(supplyZones)
            break
        Core.Zone z = array.get(supplyZones, i)
        if z.active
            // Skip historical zones - we don't validate sweeps for them
            if z.isHistorical
                continue  // Skip all liquidity validation for historical zones
            
            // === VALIDATE EXISTING LIQUIDITY ===
            // Clear invalid liquidity that doesn't match the selected mode
            if not na(z.liquidityPrice)
                float sideTol = syminfo.mintick * liq_side_tol_ticks
                bool isInvalid = false
                
                if use_inducement_linking
                    // MODEL B (Inducement): Liquidity HIGH must be BELOW zone (z.bottom)
                    // Invalid if it's ABOVE zone bottom (plus tolerance)
                    if z.liquidityPrice > (z.bottom + sideTol)
                        isInvalid := true
                else
                    // MODEL A (Standard): Liquidity HIGH must be ABOVE zone (z.top)
                    // Invalid if it's BELOW zone top (minus tolerance)
                    if z.liquidityPrice < (z.top - sideTol)
                        isInvalid := true
                
                if isInvalid
                    // Invalid liquidity - clear it completely
                    z.liquidityPrice := na
                    z.liquidityBarIndex := na
                    z.liquiditySwept := false
                    z.liquiditySweptBarIndex := na
                    z.causedSweep := false
                    z.structureSweepLevel := na
                    z.structureSweepLevelBar := na
                    // Reset candle count when liquidity is cleared
                    z.liquidityCandleCount := 0
                    z.liquidityValid := false
                    z.inactiveReason := "LIQ_WRONG_SIDE"
                    // Clear any visual connector/label for this zone's liquidity
                    clearSupplyLiquidityVisual(i)

            // === SUPPLY LIQUIDITY SELECTION (Throttled for Performance) ===
            // SANITY CHECK: If liquidity is stored but its bar is in the future (Replay issue), invalidate it to force re-scan
            bool isFutureLiqSupply = z.liquidityValid and not na(z.liquidityBarIndex) and z.liquidityBarIndex > bar_index

            // If ghost data detected, WIPE IT immediately before scanning
            if isFutureLiqSupply
                z.liquidityValid := false
                z.liquidityPrice := na
                z.liquidityBarIndex := na
                z.liqLowPrice := na
                z.liqHighPrice := na
                z.structureSweepLevel := na
                z.inactiveReason := "Ghost Data Cleared"

            // Scan if invalid, cleared, or not yet used for entry (allows finding better inducements until entry)
            if not z.liquidityValid or na(z.lastEntryBar)
                f_scan_supply_liquidity(i)
            
            // === SUPPLY SWEEP DETECTION (via modular function) ===
            f_check_supply_sweeps(i)

            // Update supply liquidity visuals
            updateSupplyLiquidityVisual(i)

            if current_close < z.bottom and not z.leftZone
                z.leftZone := true


            
            // === STRICT MITIGATION CHECK (SUPPLY) ===
            // Zone is killed on ANY wick touch BEFORE liquidity sweep to enforce "Fresh Zone Only"
            // Conditions for mitigation:
            // 1) Price CLOSES inside the zone, OR
            // 2) Price wicks THROUGH the entire zone (breach - high goes above zone top), OR
            // 3) Price wicks INTO zone (fresh touch before setup ready) - STRICT RULE
            if not z.mitigated
                bool is_future_bar = not na(z.createdBarIndex) and bar_index > z.createdBarIndex

                // Close inside zone (bullish invalidation)
                bool closes_inside = close >= z.bottom and close <= z.top

                // Breach - price wicks through entire zone (wick above zone top)
                bool breaches_zone = high > z.top

                // Wick INTO zone (touch) - STRICT RULE: Kill zone before setup is ready
                bool wicks_into_zone = high >= z.bottom and high <= z.top

                // SIMULTANEOUS SWEEP: If current bar sweeps target, allow entry (exception to strict rule)
                bool current_bar_sweeping = not na(z.structureSweepLevel) and low < z.structureSweepLevel

                // UPDATED: Separate Touch from Mitigation
                // Preserve Touch Data: Update flags but don't kill the zone yet
                if is_future_bar and z.leftZone and not z.liquiditySwept and (closes_inside or wicks_into_zone or breaches_zone)
                    z.lastTouchBar := bar_index
                    z.wasTouched := true
                    z.touchedPreSweep := true

                // MITIGATION (VANISH): Kill zone if CLOSED INSIDE or FULLY BREACHED
                // This restores strict strategy behavior. Wick touches still survive (recording touchedPreSweep).
                if is_future_bar and z.leftZone and not z.liquiditySwept and (closes_inside or breaches_zone) and not current_bar_sweeping
                    remove_zone_all_arrays(false, i)
                    continue // Skip to next zone since this one is gone


// === ZONE INVALIDATION (DEMAND) ===
// OPTIMIZATION: Use local variable for array size
int demandSize = array.size(demandZones)
if demandSize > 0
    current_close = close
    current_open  = open
    current_low   = low
    // Keep candle color for wick-based invalidation after leaving the zone
    bool is_bearish_c  = current_close < current_open
    pip_buffer    = pip_size * 0.1

    // Use live array size for the check to handle early bars correctly
    demandSize := array.size(demandZones)
    if demandSize > 0
        for i = demandSize - 1 to 0
            if i >= demandSize
                break
            Core.Zone z = array.get(demandZones, i)
            if z.active
                // Check if price has left the zone
                if current_close > z.top and not z.leftZone
                    z.leftZone := true
                    z.leftWithBearish := current_close < current_open

                // Time Check
                bool isTooOld = not na(z.startTime) and (time - z.startTime) > (24 * 60 * 60 * 1000)

                // Invalidation Conditions:
                // 1. Close inside (bearish)
                bool bearish_close_inside = current_close <= z.top and current_close >= z.bottom
                // 2. Close below (Standard invalidation)
                bool close_below_zone     = current_close < z.bottom
                // 3. Mitigation (Bearish wick after leaving) - RELAXED: Removed strict invalidation
                // 4. Wick below zone (optional via input)
                bool wick_below_zone = current_low < z.bottom

                if bearish_close_inside or close_below_zone or isTooOld or (invalidate_on_wick and wick_below_zone)
                    remove_zone_all_arrays(true, i)

// === ZONE INVALIDATION (SUPPLY) ===
// OPTIMIZATION: Use live array size to avoid stale cached size after removals
int supplySize = array.size(supplyZones)
if supplySize > 0
    current_close = close
    current_open  = open
    current_high  = high

    // OPTIMIZATION: Use supplySize variable
    for i = supplySize - 1 to 0
        if i >= supplySize
            break
        Core.Zone z = array.get(supplyZones, i)
        if z.active
            // Time Check
            bool isTooOld = not na(z.startTime) and (time - z.startTime) > (24 * 60 * 60 * 1000)
            
            // Invalidation Conditions:
            // 1. Close inside (bullish)
            bool bullish_close_inside = current_close >= z.bottom and current_close <= z.top
            // 2. Close above (Standard invalidation)
            bool close_above_zone     = current_close > z.top
            // 3. Wick above zone (optional via input)
            bool wick_above_zone = current_high > z.top

            if bullish_close_inside or close_above_zone or isTooOld or (invalidate_on_wick and wick_above_zone)
                remove_zone_all_arrays(false, i)

// === UPDATE ZONE BOXES AND LABELS (Dynamic Extension + UZID) ===
// Update demand zone boxes to extend to exact bar count and update labels with UZID
// OPTIMIZATION: Use cached array size
if show_zones and show_demand_zones and cached_demand_size > 0 and barstate.isconfirmed
    for i = 0 to cached_demand_size - 1
        if i >= array.size(demandZones)
            break
        Core.Zone z = array.get(demandZones, i)
        if z.active
            // Get creation bar index and update box right edge to extend exactly 'extend_bars' bars
            if not na(z.createdBarIndex)
                int left_bar_index = z.createdBarIndex
                int right_bar_index = left_bar_index + extend_bars
                if not na(z.boxId)
                    // Update box right edge for exact extension
                    box.set_right(z.boxId,right_bar_index)
                    // Update colors based on Accuracy status
                    if z.isAccuracy
                        box.set_bgcolor(z.boxId,col_acc_demand_bg)  // Blue for demand ACC
                        box.set_border_width(z.boxId,2)
                        box.set_border_color(z.boxId,col_acc_demand_border)
                    else
                        box.set_bgcolor(z.boxId,col_demand_bg)
                        box.set_border_width(z.boxId,1)
                        box.set_border_color(z.boxId,col_demand_border)

                    if not na(z.idLabel)
                        float lbl_mid = (z.top + z.bottom) / 2
                        label.set_x(z.idLabel, bar_index)
                        label.set_y(z.idLabel, lbl_mid)
                        string demandAccTag = z.isAccuracy ? "⭐ ACC " : ""
                        string demandCompact = demandAccTag + "D-" + str.tostring(z.id)
                        string demandDetailed = "Demand " + demandCompact
                        string demandMetrics = zone_label_show_metrics ? (" [" + z.grade + "|" + str.tostring(z.score, "#") + "]") : ""
                        string demandText = zone_label_style == "Detailed" ? (demandDetailed + demandMetrics) : demandCompact
                        label.set_text(z.idLabel, " " + demandText + " ")
                        label.set_style(z.idLabel, label.style_label_left)
                        label.set_textcolor(z.idLabel, color.white)
                        label.set_color(z.idLabel, z.isAccuracy ? color.new(#2196F3, 0) : color.new(#26a69a, 0))  // Blue for ACC, teal for normal
                        label.set_size(z.idLabel, size.normal)
                        label.set_textalign(z.idLabel, text.align_center)

// Update supply zone boxes to extend to exact bar count and update labels with UZID
// OPTIMIZATION: Use cached array size
if show_zones and show_supply_zones and cached_supply_size > 0 and barstate.isconfirmed
    for i = 0 to cached_supply_size - 1
        if i >= array.size(supplyZones)
            break
        Core.Zone z = array.get(supplyZones, i)
        if z.active
            // Get creation bar index and update box right edge to extend exactly 'extend_bars' bars
            if not na(z.createdBarIndex)
                int left_bar_index = z.createdBarIndex
                int right_bar_index = left_bar_index + extend_bars
                if not na(z.boxId)
                    // Update box right edge for exact extension
                    box.set_right(z.boxId,right_bar_index)
                    // Update colors based on Accuracy status
                    if z.isAccuracy
                        box.set_bgcolor(z.boxId,col_acc_supply_bg)  // Purple for supply ACC
                        box.set_border_width(z.boxId,2)
                        box.set_border_color(z.boxId,col_acc_supply_border)
                    else
                        box.set_bgcolor(z.boxId,col_supply_bg)
                        box.set_border_width(z.boxId,1)
                        box.set_border_color(z.boxId,col_supply_border)

                    if not na(z.idLabel)
                        float lbl_mid = (z.top + z.bottom) / 2
                        label.set_x(z.idLabel, bar_index)
                        label.set_y(z.idLabel, lbl_mid)
                        string supplyAccTag = z.isAccuracy ? "⭐ ACC " : ""
                        string supplyCompact = supplyAccTag + "S-" + str.tostring(z.id)
                        string supplyDetailed = "Supply " + supplyCompact
                        string supplyMetrics = zone_label_show_metrics ? (" [" + z.grade + "|" + str.tostring(z.score, "#") + "]") : ""
                        string supplyText = zone_label_style == "Detailed" ? (supplyDetailed + supplyMetrics) : supplyCompact
                        label.set_text(z.idLabel, " " + supplyText + " ")
                        label.set_style(z.idLabel, label.style_label_left)
                        label.set_textcolor(z.idLabel, color.white)
                        label.set_color(z.idLabel, z.isAccuracy ? color.new(#AB47BC, 0) : color.new(#ef5350, 0))  // Purple for ACC, coral for normal
                        label.set_size(z.idLabel, size.normal)
                        label.set_textalign(z.idLabel, text.align_center)
            
            // Zone ID is now displayed using plottext() in the main plotting section

// Zone IDs are created with labels when zones are created - see createDemandZone() and createSupplyZone()
// Labels are positioned at the left edge (creation bar) and remain anchored there



            

// === LONG ENTRY DETECTION (2-STEP: PRIME THEN ENTER) ===
// Step 1: When zone is touched with valid setup → PRIME the zone
// Step 2: On next bar with bullish close → ENTER
// OPTIMIZATION: Use cached array size
if barstate.isconfirmed and cached_demand_size > 0 and allow_long_trades
    current_close = close
    current_open  = open
    current_low   = low
    is_bullish_close = current_close > current_open

    // OPTIMIZATION: Use cached array size
    for i = 0 to cached_demand_size - 1
        if i >= array.size(demandZones)
            break
        Core.Zone z = array.get(demandZones, i)

        // === STEP 1: PRIME ZONE (when touched with valid setup) ===
        if z.active and not z.primed
            // === TRACK TOUCHES INDEPENDENTLY OF VALIDITY ===
            // Ensure first touch is recorded even if entry is blocked (e.g. Dead Zone)
            float touchTolerance = 0.0
            bool currentTouch = low <= (z.top + touchTolerance)
            
            if currentTouch
                bool isContinuous = not na(z.lastTouchBar) and (bar_index - z.lastTouchBar) <= 1
                if not isContinuous
                    z.touchCount := z.touchCount + 1
                
                z.lastTouchBar := bar_index
                z.wasTouched := true
                
            // Unified demand entry validation (shared with flip entries)
            [can_enter, entryReason] = isValidDemandEntry(i)

            // === PERFORMANCE STATS: ENTRY CHECKS (DEMAND) ===
            stat_total_entry_checks += 1
            if not can_enter
                if str.contains(entryReason, "timing")
                    stat_entries_blocked_by_timing += 1
                if str.contains(entryReason, "liquidity") or str.contains(entryReason, "Liq ")
                    stat_entries_blocked_by_liquidity += 1

            // [optimization/ai-overhaul] DEBUG LABEL: Show exactly why this demand zone was blocked
            // Visible whenever Debug Level != None (and for Shadow Mode skips too)
            if not can_enter and show_blocked_trade_labels and debug_level != "None" and isRecentBarForDebug()
                bool isAiBlock = str.contains(entryReason, "AI Quality") or str.contains(entryReason, "[SHADOW]")
                color blockCol = isAiBlock ? color.orange : color.new(color.red, 20)
                string blockTag = isAiBlock ? "🤖 " : "🚫 "
                label.new(bar_index, high + atr14 * 0.3,
                    text = blockTag + "Blocked: " + entryReason,
                    style = label.style_label_down,
                    color = blockCol,
                    textcolor = color.white,
                    size = size.tiny)

            if can_enter
                if currentTouch
                    // LIQUIDITY FRESHNESS CHECK: Allow retests, but skip if liquidity is stale
                    // Video strategy: Skip only if liquidity ALREADY SWEPT in distant past (not just zone touched)
                    // This allows valid retests while blocking stale setups
                    bool liquidityIsStale = z.liquiditySwept and not na(z.liquiditySweptBarIndex) and (bar_index - z.liquiditySweptBarIndex) > 50
                    if liquidityIsStale
                        z.inactiveReason := "BLOCKED - Liquidity already swept (stale, " + str.tostring(bar_index - z.liquiditySweptBarIndex) + " bars ago)"
                        continue  // Skip to next zone
                    
                    // PRIME the zone - store reference candle data for Break of Candle model
                    z.primed := true
                    z.primedBar := bar_index
                    z.primedWickLevel := low  // Store wick level for flip SL
                    z.primedRefClose := close
                    z.primedRefHigh := high
                    z.primedRefLow := low
                    z.inactiveReason := "PRIMED - waiting for bullish close"
                    
                    // Add liquidity bonus to zone score (was 0 at creation since liq wasn't known yet)
                    if z.liquiditySwept
                        z.score := z.score + 20  // Full bonus: liquidity was swept
                    else if not na(z.liqLowPrice)
                        z.score := z.score + 10  // Partial bonus: liquidity exists but not swept yet
                    z.score := math.min(z.score, 100)
                    z.grade := Core.get_grade_from_score(z.score)
                    
                    // === V7.1 AI FEATURES (CONDITIONAL - Only if enabled) ===
                    // IMPORTANT: Call functions unconditionally for Pine Script series consistency
                    float temp_liq_distance = Core.calculate_liquidity_distance(z.top, z.liqLowPrice, pip_size)
                    float temp_liq_spread = Core.calculate_liquidity_spread(z.liqHighPrice, z.liqLowPrice, pip_size)
                    // Hybrid return strength: time-based + distance bonus
                    // Hybrid return strength: NA-safe & zero-safe
                    
                    if enable_v6_v7_features
                        z.liquidityDistance := temp_liq_distance
                        z.liquiditySpread := temp_liq_spread
                    else
                        // Default values when disabled (neutral 50)
                        z.liquidityDistance := 50.0
                        z.liquiditySpread := 50.0

        // === STEP 2: ENTER ON BULLISH CLOSE (if zone is primed) ===
        if z.active and z.primed
            // 2. ENTRY MODEL SELECTION (STRICT Priority: Time Gate -> Flip -> BoC -> Dir Close)
            string chosenModel = "NONE"

            // (a) FLIP: Bearish to Bullish reversal (Engulfing-like behavior)
            // STRICT TIME GATE: Flip can ONLY be evaluated on 15m boundaries (xx:00/:15/:30/:45)
            bool basic_flip = close > open and close[1] < open[1]
            bool is_flip_time = is_htf_candle_open()
            bool is_flip = false
            if is_flip_time
                is_flip := basic_flip

            // (b) DIRECTIONAL CLOSE: Bullish close (no zone touch required - already primed)
            // Requires: close > open OR Bullish Hammer (Strict: Must be Green)
            float candleRange = high - low
            float bodySize = math.abs(close - open)
            float lowerWick = math.min(open, close) - low
            bool isHammer = candleRange > 0 ? (lowerWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3) : false

            bool is_dir_close = (close > open) or (isHammer and close > open)

            // (c) BREAK OF CANDLE: Gap or Break High relative to PRIMED CANDLE + Bullish Close
            // Definition: (open > primedRefClose OR high > primedRefHigh) AND close > open
            // AND is NOT a flip pattern (flip = reversal, break = continuation)
            bool hasValidPrimedRef = not na(z.primedRefClose) and not na(z.primedRefHigh)
            bool is_break = false
            if hasValidPrimedRef and not is_flip
                is_break := (open > z.primedRefClose or high > z.primedRefHigh) and close > open

            // Priority:
            // 1) If on 15m boundary and Flip pattern exists -> FLIP
            // 2) Otherwise -> fallback immediately to BoC, then Dir Close
            if is_flip
                chosenModel := "FLIP"
            else if is_break
                chosenModel := "BREAK_CANDLE"
            else if is_dir_close
                chosenModel := "DIR_CLOSE"

            if chosenModel == "NONE"
                continue  // No valid entry pattern yet, keep zone primed

            // Store model for Inspector/Debug
            z.inactiveReason := "Model: " + chosenModel

            // Convert chosen model to numeric code for webhook/backend
            float entry_model_code = chosenModel == "FLIP" ? 1 : (chosenModel == "BREAK_CANDLE" ? 3 : 2)

            bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
            if not in_date_range
                continue

            // === SPREAD ADJUSTMENT FOR ENTRY ===
            // removed as per user request
            // float spread_adjustment = 2.0 * pip_size 
            entry_price = current_close // + spread_adjustment

            // Find deepest wick from bars that INTERACTED with zone (even if breached below)
            float deepest_wick = na
            for j = 0 to 5
                // Bar interacted with zone if: high >= zone.bottom AND low <= zone.top
                // We DO NOT restrict low >= z.bottom, because we want the wick even if it breached
                if high[j] >= z.bottom and low[j] <= z.top
                    if na(deepest_wick) or low[j] < deepest_wick
                        deepest_wick := low[j]
            
            if na(deepest_wick)
                deepest_wick := current_low  // Fallback to current low

            // SL Calculation: Use deepest wick (even if below zone) minus buffer
            stop_loss_price = deepest_wick - (effective_sl_buffer * pip_size)
            
            // --- SAFETY CLAMP (LONG) ---
            // Ensure SL is strictly below Entry (min 2 pips gap) to prevent position sizing errors
            float minGap_long = math.max(syminfo.mintick * 2, pip_size * 2.0)  // At least 2 pips
            if stop_loss_price >= entry_price - minGap_long
                stop_loss_price := entry_price - minGap_long
            
            float pip_distance = entry_price - stop_loss_price
            
            if pip_distance <= 0
                continue
            
            float sl_pips = pip_distance / pip_size
            
            // TP Calculation
            float take_profit_price = na
            trade_be_trigger_rr := na
            trade_be_sl_pips := na
            trade_be_moved := false
            
            if use_take_profit and sl_pips > 0
                // Use symbol-aware TP rules (Gold vs Forex)
                [tp_r, be_trig, be_sl, move_be] = get_tp_ratio(syminfo.ticker, sl_pips)
                
                // Override with fixed RR - ONLY for non-5-minute modes

                    
                if enable_double_tp
                    tp_r := tp_r * 2.0
                    
                if not na(tp_r)
                    take_profit_price := entry_price + (pip_distance * tp_r)
                    
                // Store BE settings - ALWAYS for 5-minute mode, otherwise check use_fixed_rr
                if move_be
                    trade_be_trigger_rr := be_trig
                    trade_be_sl_pips := be_sl
            
            // --- TP DISTANCE VALIDATION ---
            // Ensure TP is at least min_tp_distance_pips from entry to prevent zero-profit trades
            float tp_distance_pips = na
            if not na(take_profit_price) and not na(entry_price)
                tp_distance_pips := math.abs(take_profit_price - entry_price) / pip_size
                if tp_distance_pips < effective_min_tp_dist
                    // Skip trade if TP is too close to entry
                    // Warning labels removed for clean chart
                    continue  // Skip this trade
            
            // USDJPY Check
            if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                if not usdjpy_success_check
                    if show_entry_labels
                        label.new(x = bar_index, y = high, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                                  style = label.style_label_down, color = color.new(color.orange, 0),
                                  textcolor = color.white, size = size.normal)
                    continue
            
            // Position Sizing
            balance  = account_size_usd
            risk_pct = risk_per_trade_pct
            
            if current_day_trades == 1 and max_trades_per_day == 2
                risk_pct := risk_pct * 0.5
            
            [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_validation_details, pos_sl_fixed] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, false)
            
            // Use the corrected SL from validation
            stop_loss_price := pos_sl_fixed
            
            last_pos_size_entry := entry_price
            last_pos_size_sl := stop_loss_price
            last_pos_size_balance := balance
            last_pos_size_risk_pct := risk_pct
            last_pos_size_sl_pips := sl_pips
            last_pos_size_valid := pos_is_valid
            last_pos_size_error := pos_error_msg
            last_pos_size_dry_run := dry_run_mode
            
            if pos_is_valid
                last_pos_size_units := pos_qty_units
                last_pos_size_lots := pos_qty_lots
                if str.contains(syminfo.ticker, "JPY")
                    [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                    if usdjpy_track_success_result
                        last_pos_size_usdjpy_rate := usdjpy_track_rate_result
                    else
                        last_pos_size_usdjpy_rate := na
            else
                last_pos_size_units := na
                last_pos_size_lots := na
                last_pos_size_usdjpy_rate := na
                if show_entry_labels
                    label.new(x = bar_index, y = high, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                              style = label.style_label_down, color = color.new(color.red, 0),
                              textcolor = color.white, size = size.normal)

            // === IMMEDIATE LONG ENTRY EXECUTION ===
            // Entry will execute immediately on this bar (no delay)
            if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                // FINAL GUARD: Re-validate entry permission (same as Zone Inspector)
                [isEntryPermitted, entryPermitReason] = isValidDemandEntry(i)
                
                if not isEntryPermitted
                    continue  // Skip this entry if not permitted
                
                // Execute immediately
                entryTriggeredThisBar := true
                
                // Populate global plot variables for Webhook
                plot_id               := z.id
                plot_type             := 1 // Demand
                plot_entry_model      := entry_model_code // Actual detected model (1=Flip, 2=DirClose, 3=BoC)
                plot_score            := z.score
                plot_freshness        := z.touchCount <= 1 ? 1 : 0
                plot_session          := feature_session
                plot_atr_ratio        := (z.top - z.bottom) / atr14
                plot_is_accuracy      := z.isAccuracy ? 1 : 0
                plot_trend            := feature_trend
                plot_rsi              := feature_rsi
                plot_htf_trend        := feature_htf_trend
                plot_rvol             := feature_rvol
                plot_adx              := feature_adx
                plot_touch_count      := z.touchCount
                plot_base_quality     := z.baseQuality
                plot_departure_strength := z.departureStrength
                plot_liquidity_distance := z.liquidityDistance
                plot_liquidity_spread := z.liquiditySpread

                triggeredZoneId := z.id

                // Build webhook payload for Discord-MT5 bridge with ALL AI features
                float webhook_lots = Utils.units_to_lots(pos_qty_units, syminfo.ticker)
                float webhook_tp = na(take_profit_price) ? entry_price + (math.abs(entry_price - stop_loss_price) * 2) : take_profit_price
                float webhook_rr = math.abs(webhook_tp - entry_price) / math.abs(entry_price - stop_loss_price)
                float zone_atr_ratio = (z.top - z.bottom) / atr14

                // === AI GUARDIAN METRICS ===
                // Liquidity sweep detection: Did price sweep lows before tapping the demand zone?
                bool guardian_liq_sweep = Utils.detect_liquidity_sweep(high, low, lookback_high_10, lookback_low_10, true)
                // Arrival type: How aggressively did price arrive at the zone?
                string guardian_arrival = Utils.assess_arrival_type(avg_body_size_3, atr14)
                // Structure break: Did price break above recent structure high? (bullish confirmation)
                bool guardian_structure_break = Utils.detect_structure_break(close, structure_high_20[1], true)

                // Human-readable pip metrics for payload & debug
                float f_liq_dist_pips = getLiquidityDistance(z, false)
                float f_liq_spread_pips = na(z.liqHighPrice) or na(z.liqLowPrice) ? na : math.abs(z.liqHighPrice - z.liqLowPrice) / pip_size
                
                string webhook_payload = enable_webhook_alerts ? Utils.build_webhook_payload(
                    syminfo.ticker,
                    "buy",
                    entry_price,
                    stop_loss_price,
                    webhook_tp,
                    webhook_lots,
                    z.id,                    // zone_id
                    "demand",                // zone_type
                    z.top,                   // zone_top
                    z.bottom,                // zone_bottom
                    webhook_rr,              // rr_ratio
                    sl_pips,                 // sl_pips
                    chosenModel,             // entry_model
                    z.liquiditySwept,        // liq_swept
                    z.targetSwept,           // target_swept
                    z.causedSweep,           // caused_sweep
                    z.isAccuracy,            // is_accuracy
                    // === AI FEATURES (NEW) ===
                    z.score,                 // score
                    z.touchCount,            // freshness
                    feature_session,         // session
                    zone_atr_ratio,          // atr_ratio
                    feature_trend,           // trend
                    feature_rsi,             // rsi
                    feature_htf_trend,       // htf_trend
                    feature_rvol,            // rvol
                    feature_adx,             // adx
                    z.touchCount,            // touch_count
                    z.baseQuality,           // base_quality
                    z.departureStrength,     // departure_strength
                    z.liquidityDistance,     // liquidity_distance
                    z.liquiditySpread,       // liquidity_spread
                    pip_size,
                    webhook_include_zone_id,
                    // === AI GUARDIAN METRICSxq ===
                    guardian_liq_sweep,      //流动性_sweep
                    guardian_arrival,        // arrival_type
                    guardian_structure_break, // market_structure_break
                    account_size_usd,         // _account_balance (Corrected)
                    f_liq_dist_pips,         // liq_distance_pips
                    f_liq_spread_pips,       // liq_spread_pips
                    time                     // current_time
                ) : ""

                if dry_run_mode
                    int dummy_var = 0  // Dummy statement to prevent empty block error
                else
                    string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                    // AI Data Packet V5.1: Key-Value format for train_ai_guardian.py (F:key=value)
                    int f_fresh = bar_index - z.createdBarIndex
                    float zone_range = z.top - z.bottom
                    float f_atr_ratio = atr14 > 0 ? zone_range / atr14 : 0.0
                    int f_zone_type = 0  // 0 = Demand
                    int f_is_accuracy = z.isAccuracy ? 1 : 0
                    // Build debug string in steps (Pine v6-safe)
                    string ai_features = " | F:score=" + str.tostring(z.score, "#.##")
                    ai_features += " | F:fresh=" + str.tostring(f_fresh)
                    ai_features += " | F:session=" + str.tostring(feature_session)
                    ai_features += " | F:zone_type=" + str.tostring(f_zone_type)
                    ai_features += " | F:atr_ratio=" + str.tostring(f_atr_ratio, "#.##")
                    ai_features += " | F:is_accuracy=" + str.tostring(f_is_accuracy)
                    ai_features += " | F:trend=" + str.tostring(feature_trend)
                    ai_features += " | F:rsi=" + str.tostring(feature_rsi, "#.##")
                    ai_features += " | F:htf_trend=" + str.tostring(feature_htf_trend)
                    ai_features += " | F:rvol=" + str.tostring(feature_rvol, "#.##")
                    ai_features += " | F:adx=" + str.tostring(feature_adx, "#.##")
                    ai_features += " | F:touch_count=" + str.tostring(z.touchCount)
                    ai_features += " | F:base_quality=" + str.tostring(z.baseQuality, "#.##")
                    ai_features += " | F:departure_strength=" + str.tostring(z.departureStrength, "#.##")
                    // Show *pips* for liquidity metrics (what you expect visually)
                    ai_features += " | F:liquidity_distance=" + (not na(f_liq_dist_pips) ? str.tostring(f_liq_dist_pips, "#.#") : "N/A")
                    ai_features += " | F:liquidity_spread=" + (not na(f_liq_spread_pips) ? str.tostring(f_liq_spread_pips, "#.#") : "N/A")
                    // Keep scores available explicitly if needed for AI training
                    ai_features += " | F:liquidity_distance_score=" + str.tostring(z.liquidityDistance, "#.##")
                    ai_features += " | F:liquidity_spread_score=" + str.tostring(z.liquiditySpread, "#.##")
                    // === AI DATA HARVESTER (compact DNA for Strategy Tester export) ===
                    // Maps user pseudocode variables to real Pine names:
                    //   rvol_value        → feature_rvol
                    //   chosenModel       → chosenModel string (FLIP/BOC/DIR)
                    //   liquidityType     → z.liqSource (PIVOT/FALLBACK_SCAN/...)
                    //   heightPips        → zone height in pips
                    //   arrival_type      → guardian_arrival (aggressive/compressed/unknown)
                    //   session_name      → mapped from feature_session int (0-3)
                    //   trend_aligned     → feature_trend == 1 for demand
                    //   htf_trend_aligned → feature_htf_trend == 1 for demand
                    float zone_height_pips = pip_size > 0 ? (z.top - z.bottom) / pip_size : 0.0
                    string dna_session = feature_session == 0 ? "As" : (feature_session == 1 ? "Ld" : (feature_session == 2 ? "NY" : "Of"))
                    string dna_model   = chosenModel == "FLIP" ? "Flp" : (chosenModel == "BOC" ? "BoC" : "Dir")
                    string dna_liq     = str.contains(z.liqSource, "PIVOT") ? "Pv" : "Fb"
                    string dna_arrival = guardian_arrival == "aggressive" ? "Imp" : (guardian_arrival == "compressed" ? "Cor" : "Unk")
                    string ai_dna = "S:"  + str.tostring(z.score, "#")
                                  + "|V:" + str.tostring(feature_rvol, "#.1")
                                  + "|M:" + dna_model
                                  + "|L:" + dna_liq
                                  + "|W:" + str.tostring(zone_height_pips, "#.0")
                                  + "|A:" + str.tostring(bar_index - z.createdBarIndex, "#")
                                  + "|Ar:" + dna_arrival
                                  + "|Sn:" + dna_session
                                  + "|T:"  + (feature_trend == 1 ? "1" : "0")
                                  + "|H:"  + (feature_htf_trend == 1 ? "1" : "0")
                    string entryComment = (show_entry_labels ? "" : typeTag) + ai_dna + (show_ai_debug_comment ? ai_features : "")

                    // Include webhook alert_message for TradingView webhook integration
                    if enable_webhook_alerts
                        strategy.entry("Long", strategy.long, qty = pos_qty_units, comment = entryComment, alert_message = webhook_payload)
                        alert(webhook_payload, alert.freq_once_per_bar)
                    else
                        strategy.entry("Long", strategy.long, qty = pos_qty_units, comment = entryComment)

                if not na(take_profit_price) and take_profit_price > 0
                    strategy.exit("Long Exit", "Long", stop = stop_loss_price, limit = take_profit_price, comment_loss = "SL", comment_profit = "TP")
                else
                    strategy.exit("Long Exit", "Long", stop = stop_loss_price, comment_loss = "SL")

                if not dry_run_mode
                    // Capture entry state
                    active_entry_id := "Long"
                    trade_entry_price := entry_price
                    trade_original_sl := stop_loss_price
                    trade_entry_grade := z.grade
                    trade_current_sl := stop_loss_price
                    trade_tp1_price := take_profit_price
                    current_day_trades += 1

                    // === EXIT TELEMETRY: Capture entry context ===
                    trade_entry_bar_index := bar_index
                    trade_worst_price := close  // Initialize with current price
                    trade_zone_id := z.id
                    trade_zone_score := z.score
                    trade_zone_freshness := z.touchCount
                    trade_session := feature_session
                    trade_atr_ratio := zone_atr_ratio
                    trade_trend := feature_trend
                    trade_rsi := feature_rsi
                    trade_htf_trend := feature_htf_trend
                    trade_rvol := feature_rvol
                    trade_adx := feature_adx
                    trade_touch_count := z.touchCount
                    trade_base_quality := z.baseQuality
                    trade_departure_str := z.departureStrength
                    trade_liq_distance := z.liquidityDistance
                    trade_liq_spread := z.liquiditySpread
                    trade_liq_swept := z.liquiditySwept
                    trade_target_swept := z.targetSwept
                    trade_caused_sweep := z.causedSweep
                    trade_is_accuracy := z.isAccuracy
                    trade_entry_model := chosenModel
                    trade_zone_type := "demand"

                z.lastEntryBar := bar_index
                z.active := false
                z.primed := false  // Reset just in case
                last_global_long_entry_bar := bar_index

                deactivateOverlappingDemandZones(z.top, z.bottom)

                // --- DETAILED ENTRY LABEL ---
                if show_entry_labels
                    float raw_sl_dist = math.abs(entry_price - stop_loss_price) / pip_size
                    float sl_dist_disp = is_index ? raw_sl_dist * 100 : raw_sl_dist
                    string label_text = "🟢 LONG"
                    label_text := label_text + "\nE: " + str.tostring(entry_price, format.mintick)
                    label_text := label_text + "\nSL: " + str.tostring(stop_loss_price, format.mintick) + " (" + str.tostring(sl_dist_disp, "#.#") + " pips)"
                    
                    if not na(take_profit_price)
                        label_text := label_text + "\nTP: " + str.tostring(take_profit_price, format.mintick)
                    else
                        label_text := label_text + "\nTP: OPEN"
                        
                    float y_long = low - (atr14 * long_label_offset_atr) - (syminfo.mintick * long_label_offset_ticks)
                    label.new(x = bar_index, y = y_long, text = label_text,
                              style = label.style_label_up, color = color.new(color.green, 0),
                              textcolor = color.white, size = size.small)

            break


// === SHORT ENTRY DETECTION (2-STEP: PRIME THEN ENTER) ===
// Step 1: When zone is touched with valid setup → PRIME the zone
// Step 2: On next bar with bearish close → ENTER
// OPTIMIZATION: Use cached array size
if barstate.isconfirmed and cached_supply_size > 0 and allow_short_trades
    current_close = close
    current_open  = open
    current_high  = high
    is_bearish_close = current_close < current_open

    // OPTIMIZATION: Use cached array size
    for i = 0 to cached_supply_size - 1
        if i >= array.size(supplyZones)
            break
        Core.Zone z = array.get(supplyZones, i)

        // === STEP 1: PRIME ZONE (when touched with valid setup) ===
        if z.active and not z.primed
            // === TRACK TOUCHES INDEPENDENTLY OF VALIDITY ===
            // Ensure first touch is recorded even if entry is blocked (e.g. Dead Zone)
            float touchTolerance = 0.0
            bool currentTouch = high >= (z.bottom - touchTolerance)
            
            if currentTouch
                bool isContinuous = not na(z.lastTouchBar) and (bar_index - z.lastTouchBar) <= 1
                if not isContinuous
                    z.touchCount := z.touchCount + 1
                
                z.lastTouchBar := bar_index
                z.wasTouched := true

            // Unified supply entry validation (shared with flip entries)
            [can_enter, entryReason] = isValidSupplyEntry(i)

            // === PERFORMANCE STATS: ENTRY CHECKS (SUPPLY) ===
            stat_total_entry_checks += 1
            if not can_enter
                if str.contains(entryReason, "timing")
                    stat_entries_blocked_by_timing += 1
                if str.contains(entryReason, "liquidity") or str.contains(entryReason, "Liq ")
                    stat_entries_blocked_by_liquidity += 1

            // [optimization/ai-overhaul] DEBUG LABEL: Show exactly why this supply zone was blocked
            if not can_enter and show_blocked_trade_labels and debug_level != "None" and isRecentBarForDebug()
                bool isAiBlock = str.contains(entryReason, "AI Quality") or str.contains(entryReason, "[SHADOW]")
                color blockCol = isAiBlock ? color.orange : color.new(color.red, 20)
                string blockTag = isAiBlock ? "🤖 " : "🚫 "
                label.new(bar_index, low - atr14 * 0.3,
                    text = blockTag + "Blocked: " + entryReason,
                    style = label.style_label_up,
                    color = blockCol,
                    textcolor = color.white,
                    size = size.tiny)

            if can_enter
                if currentTouch
                    // LIQUIDITY FRESHNESS CHECK: Allow retests, but skip if liquidity is stale
                    // Video strategy: Skip only if liquidity ALREADY SWEPT in distant past (not just zone touched)
                    // This allows valid retests while blocking stale setups
                    bool liquidityIsStale = z.liquiditySwept and not na(z.liquiditySweptBarIndex) and (bar_index - z.liquiditySweptBarIndex) > 50
                    if liquidityIsStale
                        z.inactiveReason := "BLOCKED - Liquidity already swept (stale, " + str.tostring(bar_index - z.liquiditySweptBarIndex) + " bars ago)"
                        continue  // Skip to next zone
                    
                    // PRIME the zone - store reference candle data for Break of Candle model
                    z.primed := true
                    z.primedBar := bar_index
                    z.primedWickLevel := high  // Store wick level for flip SL
                    z.primedRefClose := close
                    z.primedRefHigh := high
                    z.primedRefLow := low
                    
                    // Add liquidity bonus to zone score (was 0 at creation since liq wasn't known yet)
                    if z.liquiditySwept
                        z.score := z.score + 20  // Full bonus: liquidity was swept
                    else if not na(z.liqHighPrice)
                        z.score := z.score + 10  // Partial bonus: liquidity exists but not swept yet
                    z.score := math.min(z.score, 100)
                    z.grade := Core.get_grade_from_score(z.score)
                    z.inactiveReason := "PRIMED - waiting for bearish close"
                    
                    // === V7.1 AI FEATURES (CONDITIONAL - Only if enabled) ===
                    // IMPORTANT: Call functions unconditionally for Pine Script series consistency
                    float temp_liq_distance = Core.calculate_liquidity_distance(z.bottom, z.liqHighPrice, pip_size)
                    float temp_liq_spread = Core.calculate_liquidity_spread(z.liqLowPrice, z.liqHighPrice, pip_size)
                    // Hybrid return strength: time-based + distance bonus
                    // Hybrid return strength: NA-safe & zero-safe

                    if enable_v6_v7_features
                        z.liquidityDistance := temp_liq_distance
                        z.liquiditySpread := temp_liq_spread
                    else
                        // Default values when disabled (neutral 50)
                        z.liquidityDistance := 50.0
                        z.liquiditySpread := 50.0

        // === STEP 2: ENTER ON BEARISH CLOSE (if zone is primed) ===
        if z.active and z.primed
            // 2. ENTRY MODEL SELECTION (STRICT Priority: Time Gate -> Flip -> BoC -> Dir Close)
            string chosenModel = "NONE"

            // (a) FLIP: Bullish to Bearish reversal
            // STRICT TIME GATE: Flip can ONLY be evaluated on 15m boundaries (xx:00/:15/:30/:45)
            bool basic_flip = close < open and close[1] > open[1]
            bool is_flip_time = is_htf_candle_open()
            bool is_flip = false
            if is_flip_time
                is_flip := basic_flip

            // (b) DIRECTIONAL CLOSE: Bearish close (no zone touch required - already primed)
            // Requires: close < open OR Bearish Inverted Hammer (Strict: Must be Red)
            float candleRange = high - low
            float bodySize = math.abs(close - open)
            float upperWick = high - math.max(open, close)
            bool isInvertedHammer = candleRange > 0 ? (upperWick >= candleRange * 0.6 and bodySize <= candleRange * 0.3) : false

            bool is_dir_close = (close < open) or (isInvertedHammer and close < open)

            // (c) BREAK OF CANDLE: Gap or Break Low relative to PRIMED CANDLE + Bearish Close
            // Definition: (open < primedRefClose OR low < primedRefLow) AND close < open
            // AND is NOT a flip pattern (flip = reversal, break = continuation)
            bool hasValidPrimedRef = not na(z.primedRefClose) and not na(z.primedRefLow)
            bool is_break = false
            if hasValidPrimedRef and not is_flip
                is_break := (open < z.primedRefClose or low < z.primedRefLow) and close < open

            // Priority:
            // 1) If on 15m boundary and Flip pattern exists -> FLIP
            // 2) Otherwise -> fallback immediately to BoC, then Dir Close
            if is_flip
                chosenModel := "FLIP"
            else if is_break
                chosenModel := "BREAK_CANDLE"
            else if is_dir_close
                chosenModel := "DIR_CLOSE"

            if chosenModel == "NONE"
                continue  // No valid entry pattern yet, keep zone primed

            // Store model for Inspector/Debug
            z.inactiveReason := "Model: " + chosenModel

            // Convert chosen model to numeric code for webhook/backend
            float entry_model_code = chosenModel == "FLIP" ? 1 : (chosenModel == "BREAK_CANDLE" ? 3 : 2)

            bool in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
            if not in_date_range
                continue

            // === SPREAD ADJUSTMENT FOR ENTRY ===
            // removed as per user request
            // float spread_adjustment = 2.0 * pip_size 
            entry_price = current_close // - spread_adjustment

            // Find highest wick from bars that INTERACTED with zone (even if breached above)
            float highest_wick = na
            for j = 0 to 5
                // Bar interacted with zone if: low <= zone.top AND high >= zone.bottom
                // We DO NOT restrict high <= z.top, because we want the wick even if it breached
                if low[j] <= z.top and high[j] >= z.bottom
                    if na(highest_wick) or high[j] > highest_wick
                        highest_wick := high[j]
            
            if na(highest_wick)
                highest_wick := current_high  // Fallback to current high

            // SL Calculation: Use highest wick (even if above zone) plus buffer
            stop_loss_price = highest_wick + (effective_sl_buffer * pip_size)

            // --- SAFETY CLAMP (SHORT) ---
            // Ensure SL is strictly above Entry (min 2 pips gap) to prevent position sizing errors
            float minGap_short = math.max(syminfo.mintick * 2, pip_size * 2.0)  // At least 2 pips
            if stop_loss_price <= entry_price + minGap_short
                stop_loss_price := entry_price + minGap_short

            float pip_distance = stop_loss_price - entry_price

            if pip_distance <= 0
                continue

            float sl_pips = pip_distance / pip_size

            // TP Calculation
            float take_profit_price = na
            trade_be_trigger_rr := na
            trade_be_sl_pips := na
            trade_be_moved := false

            if use_take_profit and sl_pips > 0
                // Use symbol-aware TP rules (Gold vs Forex)
                [tp_r, be_trig, be_sl, move_be] = get_tp_ratio(syminfo.ticker, sl_pips)

                // Override with fixed RR - ONLY for non-5-minute modes


                if enable_double_tp
                    tp_r := tp_r * 2.0

                if not na(tp_r)
                    take_profit_price := entry_price - (pip_distance * tp_r)

                // Store BE settings - ALWAYS for 5-minute mode, otherwise check use_fixed_rr
                if move_be
                    trade_be_trigger_rr := be_trig
                    trade_be_sl_pips := be_sl

            // --- TP DISTANCE VALIDATION ---
            // Ensure TP is at least min_tp_distance_pips from entry to prevent zero-profit trades
            float tp_distance_pips = na
            if not na(take_profit_price) and not na(entry_price)
                tp_distance_pips := math.abs(take_profit_price - entry_price) / pip_size
                if tp_distance_pips < effective_min_tp_dist
                    // Skip trade if TP is too close to entry
                    // Warning labels removed for clean chart
                    continue  // Skip this trade

            // USDJPY Check
            if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                if not usdjpy_success_check
                    if show_entry_labels
                        label.new(x = bar_index, y = low, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                                  style = label.style_label_up, color = color.new(color.orange, 0),
                                  textcolor = color.white, size = size.normal)
                    continue

            // Position Sizing
            balance  = account_size_usd
            risk_pct = risk_per_trade_pct

            if current_day_trades == 1 and max_trades_per_day == 2
                risk_pct := risk_pct * 0.5

            [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_validation_details, pos_sl_fixed] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, true)
            
            // Use the corrected SL from validation
            stop_loss_price := pos_sl_fixed
            
            last_pos_size_entry := entry_price
            last_pos_size_sl := stop_loss_price
            last_pos_size_balance := balance
            last_pos_size_risk_pct := risk_pct
            last_pos_size_sl_pips := sl_pips
            last_pos_size_valid := pos_is_valid
            last_pos_size_error := pos_error_msg
            last_pos_size_dry_run := dry_run_mode
            
            if pos_is_valid
                last_pos_size_units := pos_qty_units
                last_pos_size_lots := pos_qty_lots
                if str.contains(syminfo.ticker, "JPY")
                    [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                    if usdjpy_track_success_result
                        last_pos_size_usdjpy_rate := usdjpy_track_rate_result
                    else
                        last_pos_size_usdjpy_rate := na
            else
                last_pos_size_units := na
                last_pos_size_lots := na
                last_pos_size_usdjpy_rate := na
                if show_entry_labels
                    label.new(x = bar_index, y = low, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                              style = label.style_label_up, color = color.new(color.red, 0),
                              textcolor = color.white, size = size.normal)

            // === IMMEDIATE SHORT ENTRY EXECUTION ===
            // Entry will execute immediately on this bar (no delay)
            if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                // FINAL GUARD: Re-validate entry permission (same as Zone Inspector)
                [isEntryPermitted, entryPermitReason] = isValidSupplyEntry(i)
                
                if not isEntryPermitted
                    continue  // Skip this entry if not permitted
                
                // Execute immediately
                entryTriggeredThisBar := true
                
                // Populate global plot variables for Webhook
                plot_id               := z.id
                plot_type             := -1 // Supply
                plot_entry_model      := entry_model_code // Actual detected model (1=Flip, 2=DirClose, 3=BoC)
                plot_score            := z.score
                plot_freshness        := z.touchCount <= 1 ? 1 : 0
                plot_session          := feature_session
                plot_atr_ratio        := (z.top - z.bottom) / atr14
                plot_is_accuracy      := z.isAccuracy ? 1 : 0
                plot_trend            := feature_trend
                plot_rsi              := feature_rsi
                plot_htf_trend        := feature_htf_trend
                plot_rvol             := feature_rvol
                plot_adx              := feature_adx
                plot_touch_count      := z.touchCount
                plot_base_quality     := z.baseQuality
                plot_departure_strength := z.departureStrength
                plot_liquidity_distance := z.liquidityDistance
                plot_liquidity_spread := z.liquiditySpread

                triggeredZoneId := z.id

                // Build webhook payload for Discord-MT5 bridge with ALL AI features
                float webhook_lots_short = Utils.units_to_lots(pos_qty_units, syminfo.ticker)
                float webhook_tp_short = na(take_profit_price) ? entry_price - (math.abs(stop_loss_price - entry_price) * 2) : take_profit_price
                float webhook_rr_short = math.abs(entry_price - webhook_tp_short) / math.abs(stop_loss_price - entry_price)
                float zone_atr_ratio_short = (z.top - z.bottom) / atr14

                // === AI GUARDIAN METRICS ===
                // Liquidity sweep detection: Did price sweep highs before tapping the supply zone?
                bool guardian_liq_sweep_short = Utils.detect_liquidity_sweep(high, low, lookback_high_10, lookback_low_10, false)
                // Arrival type: How aggressively did price arrive at the zone?
                string guardian_arrival_short = Utils.assess_arrival_type(avg_body_size_3, atr14)
                // Structure break: Did price break below recent structure low? (bearish confirmation)
                bool guardian_structure_break_short = Utils.detect_structure_break(close, structure_low_20[1], false)

                // Human-readable pip metrics for payload & debug
                float f_liq_dist_pips_short = getLiquidityDistance(z, true)
                float f_liq_spread_pips_short = na(z.liqLowPrice) or na(z.liqHighPrice) ? na : math.abs(z.liqLowPrice - z.liqHighPrice) / pip_size

                string webhook_payload_short = enable_webhook_alerts ? Utils.build_webhook_payload(
                    syminfo.ticker,
                    "sell",
                    entry_price,
                    stop_loss_price,
                    webhook_tp_short,
                    webhook_lots_short,
                    z.id,                    // zone_id
                    "supply",                // zone_type
                    z.top,                   // zone_top
                    z.bottom,                // zone_bottom
                    webhook_rr_short,        // rr_ratio
                    sl_pips,                 // sl_pips
                    chosenModel,             // entry_model
                    z.liquiditySwept,        // liq_swept
                    z.targetSwept,           // target_swept
                    z.causedSweep,           // caused_sweep
                    z.isAccuracy,            // is_accuracy
                    // === AI FEATURES (NEW) ===
                    z.score,                 // score
                    z.touchCount,            // freshness
                    feature_session,         // session
                    zone_atr_ratio_short,    // atr_ratio
                    feature_trend,           // trend
                    feature_rsi,             // rsi
                    feature_htf_trend,       // htf_trend
                    feature_rvol,            // rvol
                    feature_adx,             // adx
                    z.touchCount,            // touch_count
                    z.baseQuality,           // base_quality
                    z.departureStrength,     // departure_strength
                    z.liquidityDistance,     // liquidity_distance
                    z.liquiditySpread,       // liquidity_spread
                    pip_size,
                    webhook_include_zone_id,
                    // === AI GUARDIAN METRICS ===
                    guardian_liq_sweep_short,      // liquidity_sweep
                    guardian_arrival_short,        // arrival_type
                    guardian_structure_break_short, // market_structure_break
                    account_size_usd,               // _account_balance (Corrected)
                    f_liq_dist_pips_short,         // liq_distance_pips
                    f_liq_spread_pips_short,       // liq_spread_pips
                    time                           // current_time
                ) : ""

                if dry_run_mode
                    int dummy_var = 0  // Dummy statement to prevent empty block error
                else
                    string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                    // AI Data Packet V5.1: Key-Value format for train_ai_guardian.py (F:key=value)
                    int f_fresh = bar_index - z.createdBarIndex
                    float zone_range = z.top - z.bottom
                    float f_atr_ratio = atr14 > 0 ? zone_range / atr14 : 0.0
                    int f_zone_type = 1  // 1 = Supply
                    int f_is_accuracy = z.isAccuracy ? 1 : 0
                    // Build debug string in steps (Pine v6-safe)
                    string ai_features = " | F:score=" + str.tostring(z.score, "#.##")
                    ai_features += " | F:fresh=" + str.tostring(f_fresh)
                    ai_features += " | F:session=" + str.tostring(feature_session)
                    ai_features += " | F:zone_type=" + str.tostring(f_zone_type)
                    ai_features += " | F:atr_ratio=" + str.tostring(f_atr_ratio, "#.##")
                    ai_features += " | F:is_accuracy=" + str.tostring(f_is_accuracy)
                    ai_features += " | F:trend=" + str.tostring(feature_trend)
                    ai_features += " | F:rsi=" + str.tostring(feature_rsi, "#.##")
                    ai_features += " | F:htf_trend=" + str.tostring(feature_htf_trend)
                    ai_features += " | F:rvol=" + str.tostring(feature_rvol, "#.##")
                    ai_features += " | F:adx=" + str.tostring(feature_adx, "#.##")
                    ai_features += " | F:touch_count=" + str.tostring(z.touchCount)
                    ai_features += " | F:base_quality=" + str.tostring(z.baseQuality, "#.##")
                    ai_features += " | F:departure_strength=" + str.tostring(z.departureStrength, "#.##")
                    // Show *pips* for liquidity metrics (what you expect visually)
                    ai_features += " | F:liquidity_distance=" + (not na(f_liq_dist_pips_short) ? str.tostring(f_liq_dist_pips_short, "#.#") : "N/A")
                    ai_features += " | F:liquidity_spread=" + (not na(f_liq_spread_pips_short) ? str.tostring(f_liq_spread_pips_short, "#.#") : "N/A")
                    // Keep scores available explicitly if needed for AI training
                    ai_features += " | F:liquidity_distance_score=" + str.tostring(z.liquidityDistance, "#.##")
                    ai_features += " | F:liquidity_spread_score=" + str.tostring(z.liquiditySpread, "#.##")
                    // === AI DATA HARVESTER (compact DNA for Strategy Tester export) ===
                    float zone_height_pips = pip_size > 0 ? (z.top - z.bottom) / pip_size : 0.0
                    string dna_session = feature_session == 0 ? "As" : (feature_session == 1 ? "Ld" : (feature_session == 2 ? "NY" : "Of"))
                    string dna_model   = chosenModel == "FLIP" ? "Flp" : (chosenModel == "BOC" ? "BoC" : "Dir")
                    string dna_liq     = str.contains(z.liqSource, "PIVOT") ? "Pv" : "Fb"
                    string dna_arrival = guardian_arrival_short == "aggressive" ? "Imp" : (guardian_arrival_short == "compressed" ? "Cor" : "Unk")
                    string ai_dna = "S:"  + str.tostring(z.score, "#")
                                  + "|V:" + str.tostring(feature_rvol, "#.1")
                                  + "|M:" + dna_model
                                  + "|L:" + dna_liq
                                  + "|W:" + str.tostring(zone_height_pips, "#.0")
                                  + "|A:" + str.tostring(bar_index - z.createdBarIndex, "#")
                                  + "|Ar:" + dna_arrival
                                  + "|Sn:" + dna_session
                                  + "|T:"  + (feature_trend == 1 ? "1" : "0")
                                  + "|H:"  + (feature_htf_trend == 1 ? "1" : "0")
                    string entryComment = (show_entry_labels ? "" : typeTag) + ai_dna + (show_ai_debug_comment ? ai_features : "")

                    // Include webhook alert_message for TradingView webhook integration
                    if enable_webhook_alerts
                        strategy.entry("Short", strategy.short, qty = pos_qty_units, comment = entryComment, alert_message = webhook_payload_short)
                        alert(webhook_payload_short, alert.freq_once_per_bar)
                    else
                        strategy.entry("Short", strategy.short, qty = pos_qty_units, comment = entryComment)

                if not na(take_profit_price) and take_profit_price > 0
                    strategy.exit("Short Exit", "Short", stop = stop_loss_price, limit = take_profit_price, comment_loss = "SL", comment_profit = "TP")
                else
                    strategy.exit("Short Exit", "Short", stop = stop_loss_price, comment_loss = "SL")

                if not dry_run_mode
                    // Capture entry state
                    active_entry_id := "Short"
                    trade_entry_price := entry_price
                    trade_original_sl := stop_loss_price
                    trade_entry_grade := z.grade
                    trade_current_sl := stop_loss_price
                    trade_tp1_price := take_profit_price
                    current_day_trades += 1

                    // === EXIT TELEMETRY: Capture entry context (SAME AS LONG) ===
                    trade_entry_bar_index := bar_index
                    trade_worst_price := close  // Initialize with current price
                    trade_zone_id := z.id
                    trade_zone_score := z.score
                    trade_zone_freshness := z.touchCount
                    trade_session := feature_session
                    trade_atr_ratio := zone_atr_ratio_short
                    trade_trend := feature_trend
                    trade_rsi := feature_rsi
                    trade_htf_trend := feature_htf_trend
                    trade_rvol := feature_rvol
                    trade_adx := feature_adx
                    trade_touch_count := z.touchCount
                    trade_base_quality := z.baseQuality
                    trade_departure_str := z.departureStrength
                    trade_liq_distance := z.liquidityDistance
                    trade_liq_spread := z.liquiditySpread
                    trade_liq_swept := z.liquiditySwept
                    trade_target_swept := z.targetSwept
                    trade_caused_sweep := z.causedSweep
                    trade_is_accuracy := z.isAccuracy
                    trade_entry_model := chosenModel
                    trade_zone_type := "supply"  // SUPPLY for shorts

                z.lastEntryBar := bar_index
                z.active := false
                z.primed := false  // Reset just in case
                last_global_short_entry_bar := bar_index

                deactivateOverlappingSupplyZones(z.top, z.bottom)

                // --- DETAILED ENTRY LABEL ---
                if show_entry_labels
                    float raw_sl_dist = math.abs(stop_loss_price - entry_price) / pip_size
                    float sl_dist_disp = is_index ? raw_sl_dist * 100 : raw_sl_dist
                    string typeTag = z.isAccuracy ? "⭐ACC" : "[NRM]"
                    string label_text = "🔴 SHORT " + typeTag
                    label_text := label_text + "\nE: " + str.tostring(entry_price, format.mintick)
                    label_text := label_text + "\nSL: " + str.tostring(stop_loss_price, format.mintick) + " (" + str.tostring(sl_dist_disp, "#.#") + " pips)"
                    
                    if not na(take_profit_price)
                        label_text := label_text + "\nTP: " + str.tostring(take_profit_price, format.mintick)
                    else
                        label_text := label_text + "\nTP: OPEN"
                        
                    label.new(x = bar_index, y = high + (pip_size * 5), text = label_text,
                              style = label.style_label_down, color = color.new(color.red, 0),
                              textcolor = color.white, size = size.small)

            break

// =============================
// GLOBAL EXIT MANAGEMENT
// =============================
// CRITICAL: This section runs EVERY BAR when in a position to ensure SL/TP orders are always active
// TradingView requires exit orders to be submitted every bar - they do not persist automatically
if strategy.position_size != 0 and not na(active_entry_id) and not na(trade_current_sl) and trade_current_sl > 0
    // Validate SL based on position direction
    bool sl_valid = false
    if strategy.position_size > 0  // Long position
        // For longs: SL must be BELOW entry and POSITIVE
        sl_valid := trade_current_sl > 0 and not na(trade_entry_price) and trade_current_sl < trade_entry_price
    else if strategy.position_size < 0  // Short position
        // For shorts: SL must be ABOVE entry and POSITIVE
        sl_valid := trade_current_sl > 0 and not na(trade_entry_price) and trade_current_sl > trade_entry_price
    
    if sl_valid
        // Submit exit orders for the active entry
        if active_entry_id == "Long"
            if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                strategy.exit("Long Exit", "Long", stop = trade_current_sl, limit = trade_tp1_price, comment_loss = "SL", comment_profit = "TP")
            else
                strategy.exit("Long Exit", "Long", stop = trade_current_sl, comment_loss = "SL")
        else if active_entry_id == "Long Flip"
            if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                strategy.exit("Long Flip Exit", "Long Flip", stop = trade_current_sl, limit = trade_tp1_price, comment_loss = "SL", comment_profit = "TP")
            else
                strategy.exit("Long Flip Exit", "Long Flip", stop = trade_current_sl, comment_loss = "SL")
        else if active_entry_id == "Short"
            if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                strategy.exit("Short Exit", "Short", stop = trade_current_sl, limit = trade_tp1_price, comment_loss = "SL", comment_profit = "TP")
            else
                strategy.exit("Short Exit", "Short", stop = trade_current_sl, comment_loss = "SL")
        else if active_entry_id == "Short Flip"
            if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                strategy.exit("Short Flip Exit", "Short Flip", stop = trade_current_sl, limit = trade_tp1_price, comment_loss = "SL", comment_profit = "TP")
            else
                strategy.exit("Short Flip Exit", "Short Flip", stop = trade_current_sl, comment_loss = "SL")

// === BREAK-EVEN LOGIC (Updated Rules) ===
if strategy.position_size != 0 and not na(trade_entry_price) and not na(trade_original_sl_pips) and not na(active_entry_id) and not trade_be_moved
    // Check if BE rules apply
    if not na(trade_be_trigger_rr) and trade_be_trigger_rr > 0
        float current_profit_pips = 0.0
        float current_profit_rr = 0.0
        
        if strategy.position_size > 0  // Long
            current_profit_pips := (close - trade_entry_price) / pip_size
        else if strategy.position_size < 0  // Short
            current_profit_pips := (trade_entry_price - close) / pip_size
        
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0
        
        // Check if we've reached the BE trigger RR level
        if current_profit_rr >= trade_be_trigger_rr
            float new_be_sl = na
            float profit_lock_pips = 0.0
            
            // Logic: 
            // If trade_be_sl_pips > 0 (The <= 3 pip case), lock in Max(1R, 2 pips)
            // Else (The normal BE case), lock in 0 pips (Entry)
            if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                profit_lock_pips := math.max(trade_original_sl_pips, trade_be_sl_pips)
            else
                profit_lock_pips := 0.0
            
            if strategy.position_size > 0  // Long
                new_be_sl := trade_entry_price + (profit_lock_pips * pip_size)
            else if strategy.position_size < 0  // Short
                new_be_sl := trade_entry_price - (profit_lock_pips * pip_size)
            
            // Update SL to BE
            if not na(new_be_sl) and new_be_sl > 0
                trade_current_sl := new_be_sl
                trade_be_moved := true
                
                // Update exit orders with new BE SL
                if active_entry_id == "Long"
                    if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                        strategy.exit("Long Exit", "Long", stop = new_be_sl, limit = trade_tp1_price, comment_loss = "BE", comment_profit = "TP")
                    else
                        strategy.exit("Long Exit", "Long", stop = new_be_sl, comment_loss = "BE")
                else if active_entry_id == "Long Flip"
                    if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                        strategy.exit("Long Flip Exit", "Long Flip", stop = new_be_sl, limit = trade_tp1_price, comment_loss = "BE", comment_profit = "TP")
                    else
                        strategy.exit("Long Flip Exit", "Long Flip", stop = new_be_sl, comment_loss = "BE")
                else if active_entry_id == "Short"
                    if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                        strategy.exit("Short Exit", "Short", stop = new_be_sl, limit = trade_tp1_price, comment_loss = "BE", comment_profit = "TP")
                    else
                        strategy.exit("Short Exit", "Short", stop = new_be_sl, comment_loss = "BE")
                else if active_entry_id == "Short Flip"
                    if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                        strategy.exit("Short Flip Exit", "Short Flip", stop = new_be_sl, limit = trade_tp1_price, comment_loss = "BE", comment_profit = "TP")
                    else
                        strategy.exit("Short Flip Exit", "Short Flip", stop = new_be_sl, comment_loss = "BE")

// === CHECK IF TP1 IS HIT ===
if strategy.position_size != 0 and not na(trade_tp1_price) and not tp1_hit
    bool tp_hit = false
    if strategy.position_size > 0  // Long
        tp_hit := close >= trade_tp1_price
    else if strategy.position_size < 0  // Short
        tp_hit := close <= trade_tp1_price
    
    if tp_hit
        tp1_hit := true
        
        // Special case: For SL ≥ 11.1 pips, close full at 1:2 (no BE move)
        if false  // jpy_close_at_2r functionality removed
            if active_entry_id == "Long"
                strategy.close("Long", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Long Flip"
                strategy.close("Long Flip", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Short"
                strategy.close("Short", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Short Flip"
                strategy.close("Short Flip", comment = "Close at 1:2 (JPY Rule)")
        else
            // Move to break-even if enabled (standard BE mode)
            if use_break_even and not na(trade_entry_price) and trade_entry_price > 0 and not na(active_entry_id)
                if active_entry_id == "Long"
                    strategy.exit("Long Exit", "Long", stop = trade_entry_price, comment_loss = "BE")
                else if active_entry_id == "Long Flip"
                    strategy.exit("Long Flip Exit", "Long Flip", stop = trade_entry_price, comment_loss = "BE")
                else if active_entry_id == "Short"
                    strategy.exit("Short Exit", "Short", stop = trade_entry_price, comment_loss = "BE")
                else if active_entry_id == "Short Flip"
                    strategy.exit("Short Flip Exit", "Short Flip", stop = trade_entry_price, comment_loss = "BE")

// === 2025 TRAILING STOP LOGIC (1-MINUTE TRAILING AFTER TP1) ===
if strategy.position_size != 0 and use_stop_loss and not na(trade_entry_price) and not na(trade_original_sl) and not na(trade_original_sl_pips) and not na(active_entry_id)
    float risk_amount = 0.0
    float current_profit_pips = 0.0
    float current_profit_rr = 0.0
    
    if strategy.position_size > 0  // Long
        risk_amount := trade_entry_price - trade_original_sl
        current_profit_pips := (close - trade_entry_price) / pip_size
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0
    else if strategy.position_size < 0  // Short
        risk_amount := trade_original_sl - trade_entry_price
        current_profit_pips := (trade_entry_price - close) / pip_size
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0

    // Hard close at R=10 - use active_entry_id for correct close
    if current_profit_rr >= 10.0
        if active_entry_id == "Long"
            strategy.close("Long", comment = "Hard Close at 1:10")
        else if active_entry_id == "Long Flip"
            strategy.close("Long Flip", comment = "Hard Close at 1:10")
        else if active_entry_id == "Short"
            strategy.close("Short", comment = "Hard Close at 1:10")
        else if active_entry_id == "Short Flip"
            strategy.close("Short Flip", comment = "Hard Close at 1:10")

    float new_sl = na
    bool should_update_sl = false
    
    // 2025: 1-minute trailing stop after TP1 is hit (only if not JPY close-at-2R rule)
    if tp1_hit and false  // jpy_close_at_2r functionality removed
        // Get 1-minute data for trailing
        [one_min_close, one_min_open, one_min_high, one_min_low] = request.security(syminfo.tickerid, "1", [close, open, high, low], lookahead = barmerge.lookahead_off)
        
        // Declare candidate_sl with type
        float candidate_sl = na
        
        if strategy.position_size > 0  // Long position
            // Trail SL under each bullish 1m candle
            if one_min_close > one_min_open
                // Bullish 1m candle - trail under low
                candidate_sl := one_min_low
            else if one_min_close < one_min_open
                // Bearish 1m candle - for large candles, trail halfway
                candle_size = one_min_high - one_min_low
                large_candle_threshold = math.abs(trade_entry_price - trade_original_sl) * 0.5  // 50% of initial risk
                if candle_size > large_candle_threshold
                    candidate_sl := one_min_low + (candle_size * 0.5)  // Halfway inside
                else
                    candidate_sl := one_min_low
            else
                // Doji or equal open/close - trail under low
                candidate_sl := one_min_low
            
            // Only move SL up, never down (and respect JPY BE minimum SL if set)
            if not na(candidate_sl)
                // For trades with minimum locked profit requirement, ensure we don't go below it
                if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                    min_sl_price = trade_entry_price + (trade_be_sl_pips * pip_size)
                    candidate_sl := math.max(candidate_sl, min_sl_price)
                
                if na(trade_current_sl) or candidate_sl > trade_current_sl
                    new_sl := candidate_sl
                    should_update_sl := true
        else if strategy.position_size < 0  // Short position
            // Trail SL above each bearish 1m candle
            if one_min_close < one_min_open
                // Bearish 1m candle - trail above high
                candidate_sl := one_min_high
            else if one_min_close > one_min_open
                // Bullish 1m candle - for large candles, trail halfway inside
                candle_size = one_min_high - one_min_low
                large_candle_threshold = math.abs(trade_original_sl - trade_entry_price) * 0.5  // 50% of initial risk
                if candle_size > large_candle_threshold
                    candidate_sl := one_min_high - (candle_size * 0.5)  // Halfway inside
                else
                    candidate_sl := one_min_high
            else
                // Doji or equal open/close - trail above high
                candidate_sl := one_min_high
            
            // Only move SL down, never up (and respect JPY BE minimum SL if set)
            if not na(candidate_sl)
                // For trades with minimum locked profit requirement, ensure we don't go above it
                if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                    max_sl_price = trade_entry_price - (trade_be_sl_pips * pip_size)
                    candidate_sl := math.min(candidate_sl, max_sl_price)
                
                if na(trade_current_sl) or candidate_sl < trade_current_sl
                    new_sl := candidate_sl
                    should_update_sl := true
    else
        // No trailing active - check if we need to update SL for other reasons
        if strategy.position_size > 0  // Long: move SL up
            should_update_sl := na(trade_current_sl) or new_sl > trade_current_sl
        else if strategy.position_size < 0  // Short: move SL down
            should_update_sl := na(trade_current_sl) or new_sl < trade_current_sl
    
    if should_update_sl and (tp1_hit or not trade_be_moved)
        if active_entry_id == "Long"
            strategy.exit("Long Exit", "Long", stop = new_sl, comment_loss = "SL")
        else if active_entry_id == "Long Flip"
            strategy.exit("Long Flip Exit", "Long Flip", stop = new_sl, comment_loss = "SL")
        else if active_entry_id == "Short"
            strategy.exit("Short Exit", "Short", stop = new_sl, comment_loss = "SL")
        else if active_entry_id == "Short Flip"
            strategy.exit("Short Flip Exit", "Short Flip", stop = new_sl, comment_loss = "SL")
        trade_current_sl := new_sl

// === MAX HOLDING TIME CHECK (BARS) ===
if strategy.opentrades > 0
    // Get the bar index of the last entry
    int last_entry_bar = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)

    // Check if the current bar is 'max_bars_held' past the entry
    if (bar_index - last_entry_bar) >= max_bars_held
        strategy.close_all(comment = "Time Stop (Bars)")

        // Reset persistent RR/SL state variables immediately
        trade_entry_price      := na
        trade_original_sl      := na
        trade_original_sl_pips := na
        trade_current_sl       := na
        labels_created         := false
        tp1_hit                := false
        trade_tp1_price        := na
        active_entry_id        := na
        trade_be_trigger_rr    := na
        trade_be_sl_pips       := na
        trade_be_moved         := false

// === UPDATE MAE (Maximum Adverse Excursion) WHILE TRADE IS OPEN ===
if strategy.position_size != 0 and not na(trade_entry_bar_index)
    if strategy.position_size > 0
        // Long position: MAE is the lowest low since entry
        if na(trade_worst_price) or low < trade_worst_price
            trade_worst_price := low
    else
        // Short position: MAE is the highest high since entry
        if na(trade_worst_price) or high > trade_worst_price
            trade_worst_price := high

// === EVENT-BASED TRADE CLOSURE DETECTION ===
// Detect trade closure reliably using engine state comparison
bool trade_just_closed = strategy.closedtrades > strategy.closedtrades[1]

if trade_just_closed
    // Get the index of the most recently closed trade
    int last_trade_idx = strategy.closedtrades - 1

    // Read the result and the comment "Tag" directly from the engine
    bool was_win = strategy.closedtrades.profit(last_trade_idx) > 0
    string entry_comment = strategy.closedtrades.entry_comment(last_trade_idx)
    string exit_comment = strategy.closedtrades.exit_comment(last_trade_idx)

    // === CALCULATE EXIT TELEMETRY ===
    int bars_held = not na(trade_entry_bar_index) ? (bar_index - trade_entry_bar_index) : 0

    // Calculate MAE in pips
    float mae_pips = 0.0
    if not na(trade_worst_price) and not na(trade_entry_price)
        if strategy.position_size[1] > 0  // Was long
            mae_pips := (trade_entry_price - trade_worst_price) / pip_size
        else  // Was short
            mae_pips := (trade_worst_price - trade_entry_price) / pip_size

    // Determine exit type from exit comment
    // NOTE: comment_loss/comment_profit are set on all strategy.exit() calls below so these match reliably.
    string exit_type = "unknown"
    if str.contains(exit_comment, "TP")
        exit_type := "tp_hit"
    else if str.contains(exit_comment, "SL")
        exit_type := "sl_hit"
    else if str.contains(exit_comment, "BE")
        exit_type := "break_even"
    else if str.contains(exit_comment, "TimeStop")
        exit_type := "time_stop"
    else if str.contains(exit_comment, "EarlyClose")
        exit_type := "early_close"
    // Fallback: if bars_held >= max_bars_held, it was a time-based exit
    else if bars_held >= max_bars_held
        exit_type := "time_stop"

    // Calculate P&L in R (risk units) and USD
    float lastProfit = strategy.closedtrades.profit(last_trade_idx)  // account currency P&L (can be negative)
    float lastEntry = strategy.closedtrades.entry_price(last_trade_idx)
    float riskPips = trade_original_sl_pips
    float pnl_r = (not na(riskPips) and riskPips != 0 and not na(lastEntry)) ? lastProfit / (riskPips * pip_size * 100) : 0.0

    // === SEND EXIT WEBHOOK ===
    if enable_webhook_alerts and not na(trade_zone_id)
        // Derive side from the active entry id (set at entry time)
        string exit_side = str.contains(active_entry_id, "Long") ? "buy" : "sell"

        string exit_payload = Utils.build_exit_webhook_payload(
            trade_zone_id,              // zone_id
            syminfo.ticker,             // symbol — required for broker close routing
            exit_side,                  // side — required for broker close routing
            "LIVE",                     // run_mode — tells backend to fire broker close
            was_win ? "win" : "loss",   // outcome
            bars_held,                  // bars_held
            close,                      // close_price
            pnl_r,                      // pnl_r
            lastProfit,                 // pnl_usd (account currency, negative on loss)
            exit_type,                  // exit_type
            mae_pips,                   // mae_pips
            timenow                     // current_time
        )

        // Send exit alert (TradingView will POST to webhook)
        alert(exit_payload, alert.freq_once_per_bar)

    // === UPDATE STATISTICS ===
    // Check the tag and increment correct bucket
    if str.contains(entry_comment, "[ACC]")
        stat_trades_accuracy_total += 1
        if was_win
            stat_trades_accuracy_wins += 1
        else
            stat_trades_accuracy_losses += 1
    else
        // Assume Normal if it has [NRM] or no tag
        stat_trades_normal_total += 1
        if was_win
            stat_trades_normal_wins += 1
        else
            stat_trades_normal_losses += 1

    // Update Grade Stats (WIN/TOTAL)
    if str.contains(trade_entry_grade, "A")
        stat_grade_A_total += 1
        if was_win
            stat_grade_A_wins += 1
    else if str.contains(trade_entry_grade, "B")
        stat_grade_B_total += 1
        if was_win
            stat_grade_B_wins += 1
    else
        stat_grade_C_total += 1
        if was_win
            stat_grade_C_wins += 1

    // Reset Grade Tracker
    trade_entry_grade := "C"

    // RR tracking by symbol bucket (pnl_r already calculated above)
    bucket = Utils.get_symbol_bucket(syminfo.ticker)
    if bucket == "XAU"
        stat_rr_sum_xau += pnl_r
        stat_rr_count_xau += 1
    else if bucket == "JPY"
        stat_rr_sum_jpy += pnl_r
        stat_rr_count_jpy += 1
    else
        stat_rr_sum_other += pnl_r
        stat_rr_count_other += 1

    // === RESET TRACKING VARIABLES ===
    trade_entry_price := na
    trade_original_sl := na
    trade_original_sl_pips := na
    trade_current_sl := na
    labels_created := false
    tp1_hit := false
    trade_tp1_price := na
    active_entry_id := na
    trade_be_trigger_rr := na
    trade_be_sl_pips := na
    trade_be_moved := false

    // Reset exit telemetry vars
    trade_entry_bar_index := na
    trade_worst_price := na
    trade_zone_id := na

// === LIQUIDITY LINES CONTROL ===
// Arrays to track liquidity lines and their active status
var line[] _lowLiqLines = array.new_line()
var bool[] _lowLiqActive = array.new_bool()
var line[] _highLiqLines = array.new_line()
var bool[] _highLiqActive = array.new_bool()

// Extend lines forward while not crossed; when swept, recolor and stop extending
_controlLine(_lines, _activeFlags, __high, __low) =>
    sz = array.size(_lines)
    
    // Early exit if no lines (performance optimization)
    if sz <= 0
        true  // Return dummy value for function signature
    else
        // PERFORMANCE FIX: Limit processing to most recent 50 lines
        // This prevents timeout errors when array grows to 500 lines
        int startIdx = math.max(0, sz - 50)
        
        for i = startIdx to sz - 1
            lineRef  = array.get(_lines, i)
            bool isActive = i < array.size(_activeFlags) ? array.get(_activeFlags, i) : false
            
            // Skip inactive lines early (performance optimization)
            if not isActive
                continue
                
            float y1 = line.get_y1(lineRef)
            float y2 = line.get_y2(lineRef)
            float lvlLow = math.min(y1, y2)
            float lvlHigh = math.max(y1, y2)
            // Add tolerance for sweep detection (0.1 pip tolerance)
            float tolerance = pip_size * 0.1
            bool isCrossed = (__high >= lvlLow - tolerance and __low <= lvlLow + tolerance) or (__high >= lvlHigh - tolerance and __low <= lvlHigh + tolerance)
            // If active and crossed first time → mark as swept & recolor
            if isActive and isCrossed
                line.set_color(lineRef, color.new(color.purple, 0))
                if i < array.size(_activeFlags)
                    array.set(_activeFlags, i, false)
                // SWEPT text label removed - color change to purple is sufficient
            // Extend unswept lines to current bar+1
            else if isActive and (not isCrossed) and bar_index >= line.get_x1(lineRef)
                line.set_x2(lineRef, bar_index + 1)
        true  // Return value

// === VISUAL LIQUIDITY LINES (same style as standalone Liquidity indicator) ===
// Use pivot lows/highs as liquidity bottoms/tops and recolor when swept.

// Pivot LOW → bottom liquidity line (use 3-candle pivot)
if isPvtLow and plotLiq
    int  pBar  = bar_index - 1  // Middle candle of the 3-candle pattern
    float pLow = low[1]
    lowLine = line.new(x1 = pBar, y1 = pLow, x2 = bar_index, y2 = pLow,
                       extend = extend.none, color = pvtBtmColor, style = pvtStyle, xloc = xloc.bar_index)
    if array.size(_lowLiqLines) >= pvtMax
        line.delete(array.shift(_lowLiqLines))
        if array.size(_lowLiqActive) > 0
            array.shift(_lowLiqActive)
    array.push(_lowLiqLines, lowLine)
    array.push(_lowLiqActive, true)

// Pivot HIGH → top liquidity line (use 3-candle pivot)
if isPvtHigh and plotLiq
    int  pBar  = bar_index - 1  // Middle candle of the 3-candle pattern
    float pHigh = high[1]
    highLine = line.new(x1 = pBar, y1 = pHigh, x2 = bar_index, y2 = pHigh,extend = extend.none, color = pvtTopColor, style = pvtStyle, xloc = xloc.bar_index)
    if array.size(_highLiqLines) >= pvtMax
        line.delete(array.shift(_highLiqLines))
        if array.size(_highLiqActive) > 0
            array.shift(_highLiqActive)
    array.push(_highLiqLines, highLine)
    array.push(_highLiqActive, true)

// PERFORMANCE FIX: Only process liquidity lines on confirmed bars (90% speed boost)
if plotLiq and barstate.isconfirmed
    _controlLine(_lowLiqLines, _lowLiqActive, high, low)
    _controlLine(_highLiqLines, _highLiqActive, high, low)

// 2. Zone Inspector (Bottom Right) — lazy init, delete when disabled to avoid leftover artifacts
var table zoneInspector = na
var label inspectorIndLabel = na
var label inspectorTgtLabel = na

if showZoneInspector and debug_enabled and isRecentBarForDebug()
    if na(zoneInspector)
        zoneInspector := table.new(position.bottom_right, 2, 35, 
             bgcolor = color.new(color.rgb(20, 25, 30), 10), 
             frame_color = color.new(color.rgb(100, 110, 120), 80), frame_width = 1, 
             border_color = color.new(color.rgb(60, 70, 80), 50), border_width = 1)
    if barstate.isconfirmed and not na(zoneInspector)
        // Get additional zone details for inspector
        string zoneInspectorType = "None"
        int zoneInspectorIdx = na
        float zoneInspectorLow = na
        float zoneInspectorHigh = na
        float zoneInspectorSizePips = na
        int barsSinceCreation = na
        string liqRequired = "N/A"
        string liqExistsInspector = "N/A"
        string liqCandlesCountInspector = "N/A"
        string liqSweptInspector = "N/A"
        string targetSweptInspector = "N/A"
        string sweepBarIdx = "N/A"
        string wickInZone = "N/A"
        string notClosedIn = "N/A"
        string bullishBearishClose = "N/A"
        string zoneUsedInspector = "N/A"
        string zoneCausedSweepInspector = "N/A"
        string entryAllowedInspector = "N/A"
        string rejectionReasonInspector = "N/A"
        string liqDistInspector = "N/A"
        bool liqDistExceedsMax = false
        
        // === DEBUG VARIABLES FOR ZONE LOOKUP ===
        string manualParsedIdStr = "N/A"
        string foundInPool = "NOT_FOUND"
        string notFoundReason = "N/A"
        string zoneStatus = "N/A"          // LIVE / INACTIVE
        string zoneInactiveReason = "N/A"  // max_pruned / removed / etc.
        
        // === MANUAL ZONE ID LOOKUP (Enhanced with zoneDB Search) ===
        // Parse string input to extract type hint (S/D) and numeric ID
        string manualInputClean = str.trim(manual_zone_id_input)
        string manualTypeHint = "Any"
        int manualZoneId = na
        
        if str.length(manualInputClean) > 0
            string working = manualInputClean
            string firstChar = str.upper(str.substring(working, 0, 1))
            
            // Check for D- or S- prefix
            if firstChar == "D" or firstChar == "S"
                manualTypeHint := firstChar == "D" ? "Demand" : "Supply"
                dashPos = str.pos(working, "-")
                if dashPos >= 0
                    working := str.substring(working, dashPos + 1, str.length(working))
                else
                    working := str.substring(working, 1, str.length(working))
            
            // Remove any spaces and parse number
            working := str.replace_all(working, " ", "")
            float parsedVal = str.tonumber(working)
            if not na(parsedVal)
                manualZoneId := int(math.round(parsedVal))
                manualParsedIdStr := str.tostring(manualZoneId)
            else
                notFoundReason := "invalid_input"
        
        int inspectIndex = na
        string inspectType = "None"
        Core.ZoneDBEntry dbEntry = na
        bool foundInDB = false
        
        // STEP 1: Determine Target Zone ID (Default to latest active if empty)
        int targetId = na
        if str.length(manualInputClean) == 0
            // Default: Try Demand[0] then Supply[0]
            if array.size(demandZones) > 0
                targetId := array.get(demandZones, 0).id
            else if array.size(supplyZones) > 0
                targetId := array.get(supplyZones, 0).id
        else
            targetId := manualZoneId
            
        // STEP 2: Search zoneDB FIRST (single source of truth)
        if not na(targetId)
            int dbIdx = db_findIndexByUZID(targetId)
            if not na(dbIdx)
                dbEntry := array.get(zoneDB, dbIdx)
                foundInDB := true
                inspectType := dbEntry.zoneType == "DEMAND" ? "Demand" : "Supply"
                foundInPool := "ZONEDB_ONLY"  // Default: found in DB only
                zoneStatus := dbEntry.active ? "LIVE" : "INACTIVE"
                zoneInactiveReason := dbEntry.active ? "N/A" : dbEntry.inactiveReason
                notFoundReason := "N/A"
                
                // STEP 3: ALWAYS try to find in live arrays (even if inactive in DB)
                // This allows showing live liquidity/sweep data if zone still exists in arrays
                if dbEntry.zoneType == "DEMAND"
                    inspectIndex := findDemandZoneIndexByUZID(targetId)
                    if not na(inspectIndex)
                        foundInPool := "DEMAND_LIVE"
                else
                    inspectIndex := findSupplyZoneIndexByUZID(targetId)
                    if not na(inspectIndex)
                        foundInPool := "SUPPLY_LIVE"
            else
                // Not in DB - try live arrays as fallback
                int demandIdxManual = na
                int supplyIdxManual = na
                
                // Optimized fallback search
                demandIdxManual := findDemandZoneIndexByUZID(targetId)
                if not na(demandIdxManual)
                    inspectIndex := demandIdxManual
                    inspectType := "Demand"
                    foundInPool := "DEMAND_LIVE"
                    zoneStatus := "LIVE"
                    notFoundReason := "N/A"
                else
                    supplyIdxManual := findSupplyZoneIndexByUZID(targetId)
                    if not na(supplyIdxManual)
                        inspectIndex := supplyIdxManual
                        inspectType := "Supply"
                        foundInPool := "SUPPLY_LIVE"
                        zoneStatus := "LIVE"
                        notFoundReason := "N/A"
                    else
                        foundInPool := "NOT_FOUND"
                        notFoundReason := "not_in_db_or_arrays"
                

        
        zoneInspectorIdx := inspectIndex
        zoneInspectorType := inspectType
        bool isInspectorDemand = inspectType == "Demand"
        
        // Get UZID for display (store for Zone ID row)
        int zoneInspectorUZID = na
        bool inspectorZoneActive = false
        Core.Zone inspectorZone = na

        // If we have a live index, get the Zone from array
        if not na(zoneInspectorIdx) and zoneInspectorType != "None"
            if isInspectorDemand
                if zoneInspectorIdx < array.size(demandZones)
                    inspectorZone := array.get(demandZones, zoneInspectorIdx)
            else
                if zoneInspectorIdx < array.size(supplyZones)
                    inspectorZone := array.get(supplyZones, zoneInspectorIdx)
            
            if not na(inspectorZone)
                zoneInspectorUZID := inspectorZone.id
                inspectorZoneActive := inspectorZone.active
        else if foundInDB and not na(dbEntry)
            // Zone is in DB but not in live arrays - use DB data for display
            zoneInspectorUZID := dbEntry.uzid
            inspectorZoneActive := false  // Not in live arrays = effectively inactive
        
        bool allowInactiveInspector = true

        // Populate inspector fields if zone found in live arrays
        // === CONSOLIDATED: Common fields calculated once, directional logic uses ternary ===
        if not na(inspectorZone) and (inspectorZoneActive or allowInactiveInspector)
            // === COMMON FIELDS (same for demand and supply) ===
            zoneInspectorHigh := inspectorZone.top
            zoneInspectorLow := inspectorZone.bottom
            
            // Zone Size in pips
            if not na(zoneInspectorLow) and not na(zoneInspectorHigh)
                zoneInspectorSizePips := (zoneInspectorHigh - zoneInspectorLow) / pip_size
            
            // Bars Since Creation
            if not na(inspectorZone.createdBarIndex)
                barsSinceCreation := bar_index - inspectorZone.createdBarIndex
            
            // Liquidity Required
            liqRequired := require_liquidity_sweep ? "Yes" : "No"
            
            // Liquidity Analysis (common calculation)
            int oppCntInspector = inspectorZone.liquidityCandleCount
            int minCandles = useOneCandleLiquidity ? 1 : 2
            bool liqExistsBool = oppCntInspector >= minCandles
            
            // Liquidity Analysis string - simplified to Valid/Invalid only
            // Detailed info is shown in the dedicated Liq Low/High/Source/Band rows below
            liqExistsInspector := liqExistsBool ? "✓ Valid" : "✗ Invalid"
            
            // Liquidity Swept & Sweep Bar (Check current bar high/low for real-time feedback)
            float sweepTol = syminfo.mintick * 20
            bool currentBarIndSweep = isInspectorDemand ? (low <= inspectorZone.liqLowPrice + sweepTol) : (high >= inspectorZone.liqHighPrice - sweepTol)
            bool currentBarTgtSweep = isInspectorDemand ? (high >= inspectorZone.liqHighPrice - sweepTol) : (low <= inspectorZone.liqLowPrice + sweepTol)

            liqSweptInspector := (inspectorZone.liquiditySwept or currentBarIndSweep) ? "Yes" : "No"
            sweepBarIdx := not na(inspectorZone.liquiditySweptBarIndex) ? str.tostring(inspectorZone.liquiditySweptBarIndex) : (currentBarIndSweep ? str.tostring(bar_index) : "N/A")
            
            // Target Swept (Target HIGH for Demand, Target LOW for Supply)
            targetSweptInspector := (inspectorZone.targetSwept or currentBarTgtSweep) ? "Yes" : "No"
            
            // Liquidity Distance from Zone (in pips)
            // For Supply: zoneBottom - liqHighPrice (zone bottom is closest to inducement high below)
            // For Demand: liqLowPrice - zoneTop (inducement low is ABOVE zone)
            float liqDistCalc = na
            if zoneInspectorType == "Demand" and not na(inspectorZone.liqLowPrice) and not na(inspectorZone.top)
                // Demand: liqLowPrice - zoneTop (inducement low is ABOVE zone)
                liqDistCalc := math.abs(inspectorZone.liqLowPrice - inspectorZone.top) / pip_size
            else if zoneInspectorType == "Supply" and not na(inspectorZone.liqHighPrice) and not na(inspectorZone.bottom)
                // Supply: zoneBottom - liqHighPrice (inducement high is BELOW zone)
                liqDistCalc := math.abs(inspectorZone.bottom - inspectorZone.liqHighPrice) / pip_size
            liqDistInspector := not na(liqDistCalc) ? str.tostring(liqDistCalc, "#.#") + " pips" : "N/A"
            // Only mark as exceeding if limit is not 0 (0 = no limit)
            liqDistExceedsMax := effective_liq_entry_max_dist > 0.0 and not na(liqDistCalc) and liqDistCalc > effective_liq_entry_max_dist
            
            // Zone Caused Sweep
            zoneCausedSweepInspector := inspectorZone.causedSweep ? "Yes" : "No"
            
            // Zone Used
            zoneUsedInspector := not na(inspectorZone.lastEntryBar) ? "Yes" : "No"
            
            // Bullish/Bearish Close (same for both)
            bullishBearishClose := close > open ? "Bullish" : "Bearish"
            
            // Not Closed In (same for both)
            notClosedIn := (close < zoneInspectorLow or close > zoneInspectorHigh) ? "Yes" : "No"
            
            // === DIRECTIONAL LOGIC: Wick In Zone (using persistent wasTouched) ===
            // Check if zone was ever touched (persists until entry/mitigation)
            bool zoneTouched = not na(inspectorZone) and inspectorZone.wasTouched
            wickInZone := zoneTouched ? "Yes (Touched)" : "No"
            
            // === UNIFIED ENTRY VALIDATION (using if/else for tuple return) ===
            bool entryAllowedInspectorBool = false
            string validationReason = ""
            if isInspectorDemand
                [canEnterDemand, reasonDemand] = isValidDemandEntry(zoneInspectorIdx)
                entryAllowedInspectorBool := canEnterDemand
                validationReason := reasonDemand
            else
                [canEnterSupply, reasonSupply] = isValidSupplyEntry(zoneInspectorIdx)
                entryAllowedInspectorBool := canEnterSupply
                validationReason := reasonSupply
            
            // Handle supply shorts disabled case
            if not isInspectorDemand and not allow_short_trades
                entryAllowedInspector := "Shorts Disabled"
                rejectionReasonInspector := "Shorts disabled"
            else
                entryAllowedInspector := entryAllowedInspectorBool ? "Yes" : "No"
                rejectionReasonInspector := entryAllowedInspectorBool ? "None" : (str.length(validationReason) > 0 ? validationReason : "Unknown")
        else if na(inspectorZone) and foundInDB and not na(dbEntry)
            // Zone is in DB but not in live arrays - use DB data for basic display
            zoneInspectorHigh := dbEntry.top
            zoneInspectorLow := dbEntry.bottom
            
            // Zone Size in pips
            if not na(zoneInspectorLow) and not na(zoneInspectorHigh)
                zoneInspectorSizePips := (zoneInspectorHigh - zoneInspectorLow) / pip_size
            
            // Bars Since Creation
            if not na(dbEntry.createdBar)
                barsSinceCreation := bar_index - dbEntry.createdBar
            
            // Liquidity Required
            liqRequired := require_liquidity_sweep ? "Yes" : "No"
            
            // Liquidity Exists from DB snapshot
            int dbOppCnt = dbEntry.liquidityCandleCount
            int minCandles = useOneCandleLiquidity ? 1 : 2
            bool liqExistsBool = dbOppCnt >= minCandles
            liqExistsInspector := (liqExistsBool ? "Yes" : "No") + " (" + str.tostring(dbOppCnt) + ") [DB]"
            liqCandlesCountInspector := str.tostring(dbOppCnt) + " [DB]"
            
            // Liquidity Swept from DB
            liqSweptInspector := dbEntry.liquiditySwept ? "Yes [DB]" : "No [DB]"
            
            // Caused Sweep from DB
            zoneCausedSweepInspector := dbEntry.causedSweep ? "Yes [DB]" : "No [DB]"
            
            // Entry not allowed for inactive zones
            entryAllowedInspector := "Zone Inactive"
            rejectionReasonInspector := dbEntry.inactiveReason
        
        // Header row (row 0)
        color typeColor = isInspectorDemand ? color.new(color.green, 20) : color.new(color.red, 20)
        table.cell(zoneInspector, 0, 0, "Zone #" + str.tostring(zoneInspectorUZID), bgcolor=typeColor, text_color=color.white, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)), text_halign = text.align_left)
        table.cell(zoneInspector, 1, 0, zoneInspectorType, bgcolor=typeColor, text_color=color.white, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)), text_halign = text.align_left)
        
        // Grade Row [NEW]
        // Grade Row [NEW]
        string gradeStr = (not na(inspectorZone) and not na(inspectorZone.grade)) ? inspectorZone.grade : "N/A"
        float scoreVal = (not na(inspectorZone) and not na(inspectorZone.score)) ? inspectorZone.score : 0.0
        color gradeColor = scoreVal >= 80 ? color.lime : (scoreVal >= 60 ? color.yellow : color.red)
        
        table.cell(zoneInspector, 0, 1, "Grade", text_color = color.rgb(200, 200, 200), bgcolor=color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        table.cell(zoneInspector, 1, 1, gradeStr + " (" + str.tostring(scoreVal, "#") + ")", text_color=gradeColor, bgcolor=color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 1: Zone ID (UZID - permanent unique ID) - shifted to row 2
        table.cell(zoneInspector, 0, 2, "Zone ID", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        zoneIdStr = not na(zoneInspectorUZID) ? str.tostring(zoneInspectorUZID) : "N/A"
        table.cell(zoneInspector, 1, 2, zoneIdStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 2: Type - shifted to row 3
        table.cell(zoneInspector, 0, 3, "Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        typeColorInspector = zoneInspectorType == "Demand" ? color.green : (zoneInspectorType == "Supply" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 3, zoneInspectorType, text_color = typeColorInspector, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 3: Range - shifted to row 4
        table.cell(zoneInspector, 0, 4, "Range", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        rangeStrInspector = (not na(zoneInspectorLow) and not na(zoneInspectorHigh)) ? str.format("{0} → {1}", str.tostring(zoneInspectorLow, format.mintick), str.tostring(zoneInspectorHigh, format.mintick)) : "N/A"
        table.cell(zoneInspector, 1, 4, rangeStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 4: Zone Size - shifted to row 5
        table.cell(zoneInspector, 0, 5, "Zone Size", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        sizeStrInspector = not na(zoneInspectorSizePips) ? str.tostring(math.round(zoneInspectorSizePips * 10) / 10, "#.#") + " pips" : "N/A"
        table.cell(zoneInspector, 1, 5, sizeStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 5: Bars Since Creation - shifted to row 6
        table.cell(zoneInspector, 0, 6, "Bars Since", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        barsStrInspector = not na(barsSinceCreation) ? str.tostring(barsSinceCreation) : "N/A"
        table.cell(zoneInspector, 1, 6, barsStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 6: Liquidity Required - shifted to row 7
        table.cell(zoneInspector, 0, 7, "Liq Required", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        liqReqColor = liqRequired == "Yes" ? color.yellow : (liqRequired == "No" ? color.gray : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 7, liqRequired, text_color = liqReqColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 7: Liquidity Analysis (MERGED: Liq Exists + Liq Candles) - shifted to row 8
        table.cell(zoneInspector, 0, 8, "Liquidity", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        liqExistsColor = str.contains(liqExistsInspector, "✓") ? color.green : (str.contains(liqExistsInspector, "✗") ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 8, liqExistsInspector, text_color = liqExistsColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 8: Liquidity Swept (was row 9) - shifted to row 9
        table.cell(zoneInspector, 0, 9, "Liq Swept", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        liqSweptColor = liqSweptInspector == "Yes" ? color.green : (liqSweptInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 9, liqSweptInspector, text_color = liqSweptColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 9: Target Swept (NEW ROW - Target HIGH for Demand, Target LOW for Supply) - shifted to row 10
        table.cell(zoneInspector, 0, 10, "Target Swept", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        targetSweptColor = targetSweptInspector == "Yes" ? color.green : (targetSweptInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 10, targetSweptInspector, text_color = targetSweptColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 10: Liq Distance (NEW ROW - distance from zone boundary to inducement) - shifted to row 11
        table.cell(zoneInspector, 0, 11, "Liq Distance", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        liqDistColor = liqDistExceedsMax ? color.red : (liqDistInspector != "N/A" ? color.green : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 11, liqDistInspector, text_color = liqDistColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 11: Sweep Bar Index (was row 10) - shifted to row 12
        table.cell(zoneInspector, 0, 12, "Sweep Bar", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        table.cell(zoneInspector, 1, 12, sweepBarIdx, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 12: Zone Caused Sweep (was row 11) - shifted to row 13
        table.cell(zoneInspector, 0, 13, "Zone Caused Sweep", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        zoneCausedSweepColor = zoneCausedSweepInspector == "Yes" ? color.green : (zoneCausedSweepInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 13, zoneCausedSweepInspector, text_color = zoneCausedSweepColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 13: Wick In Zone (was row 12) - shifted to row 14
        table.cell(zoneInspector, 0, 14, "Wick In Zone", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        wickColor = wickInZone == "Yes" ? color.green : (wickInZone == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 14, wickInZone, text_color = wickColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 14: Not Closed In (was row 13) - shifted to row 15
        table.cell(zoneInspector, 0, 15, "Not Closed In", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        notClosedColor = notClosedIn == "Yes" ? color.green : (notClosedIn == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 15, notClosedIn, text_color = notClosedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 15: Bullish/Bearish Close (was row 14) - shifted to row 16
        table.cell(zoneInspector, 0, 16, "Close Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        closeColor = bullishBearishClose == "Bullish" ? color.green : (bullishBearishClose == "Bearish" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 16, bullishBearishClose, text_color = closeColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 16: Zone Used (was row 15) - shifted to row 17
        table.cell(zoneInspector, 0, 17, "Zone Used", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        usedColor = zoneUsedInspector == "Yes" ? color.red : (zoneUsedInspector == "No" ? color.green : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 17, zoneUsedInspector, text_color = usedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 17: Entry Allowed (was row 16) - shifted to row 18
        // Override display if entry was triggered this bar (to prevent "False No")
        string displayEntryAllowed = entryAllowedInspector
        color displayEntryColor = entryAllowedInspector == "Yes" ? color.new(color.green, 0) : (entryAllowedInspector == "No" ? color.new(color.red, 0) : color.rgb(200, 200, 200))
        
        if entryTriggeredThisBar and not na(triggeredZoneId) and not na(inspectorZone) and triggeredZoneId == inspectorZone.id
            displayEntryAllowed := "YES (Executed)"
            displayEntryColor := color.new(color.green, 0)
        
        table.cell(zoneInspector, 0, 18, "Entry Allowed", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        table.cell(zoneInspector, 1, 18, displayEntryAllowed, text_color = displayEntryColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // Row 18: Rejection Reason (was row 17) - shifted to row 19
        // Parse AI Breakdown from Reason if present (bracketed content) to show as tooltip
        string inspectorReasonText = rejectionReasonInspector
        string inspectorTooltip = ""
        if str.contains(rejectionReasonInspector, "[")
            string[] parts = str.split(rejectionReasonInspector, "[")
            if array.size(parts) > 1
                inspectorReasonText := array.get(parts, 0)
                string rawBreakdown = array.get(parts, 1)
                inspectorTooltip := str.replace(rawBreakdown, "]", "")

        table.cell(zoneInspector, 0, 19, "Reason", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        reasonColor = rejectionReasonInspector == "None" ? color.new(color.green, 0) : (rejectionReasonInspector != "N/A" ? color.new(color.orange, 0) : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 19, inspectorReasonText, tooltip = inspectorTooltip, text_color = reasonColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // === DEBUG ROWS: CONDITIONAL on zone NOT found ===
        // Rows 17-19 only shown when zone lookup failed (foundInPool == "NOT_FOUND")
        bool showDebugLookupRows = foundInPool == "NOT_FOUND" or notFoundReason != "N/A"
        
        
        if not na(inspectorZone)
            float sl_est_insp = (inspectorZone.top - inspectorZone.bottom) / pip_size


        int nextRow = 20
        
        if showDebugLookupRows
            // Row 17: Manual Parsed ID
            table.cell(zoneInspector, 0, nextRow, "Manual Parsed ID", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            parsedIdColor = manualParsedIdStr != "N/A" ? color.yellow : color.rgb(150, 150, 150)
            table.cell(zoneInspector, 1, nextRow, manualParsedIdStr, text_color = parsedIdColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            nextRow += 1
            
            // Row 18: Found In
            table.cell(zoneInspector, 0, nextRow, "Found In", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            foundInColor = foundInPool == "DEMAND_LIVE" ? color.green : (foundInPool == "SUPPLY_LIVE" ? color.red : (foundInPool == "ZONEDB_ONLY" ? color.yellow : color.rgb(150, 150, 150)))
            table.cell(zoneInspector, 1, nextRow, foundInPool, text_color = foundInColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            nextRow += 1
            
            // Row 19: Reason If Not Found
            table.cell(zoneInspector, 0, nextRow, "Not Found Reason", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            notFoundColor = notFoundReason == "N/A" or notFoundReason == "empty_input" ? color.rgb(150, 150, 150) : color.orange
            table.cell(zoneInspector, 1, nextRow, notFoundReason, text_color = notFoundColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            nextRow += 1
        
        // === LIQUIDITY DEBUG ROWS ===
        // Always show both Liq High and Liq Low values directly
        // For Demand: Low=Inducement (closest), High=Target (farthest)
        // For Supply: High=Inducement (closest), Low=Target (farthest)
        
        // Get raw values from zone or DB
        float displayLiqHigh = na
        int displayLiqHighBar = na
        float displayLiqLow = na
        int displayLiqLowBar = na
        string displayLiqSource = "N/A"
        
        if not na(inspectorZone)
            displayLiqHigh := inspectorZone.liqHighPrice
            displayLiqHighBar := inspectorZone.liqHighBar
            displayLiqLow := inspectorZone.liqLowPrice
            displayLiqLowBar := inspectorZone.liqLowBar
            displayLiqSource := na(inspectorZone.liqSource) ? "N/A" : inspectorZone.liqSource
        else if foundInDB and not na(dbEntry)
            displayLiqHigh := dbEntry.liqHighPrice
            displayLiqHighBar := dbEntry.liqHighBar
            displayLiqLow := dbEntry.liqLowPrice
            displayLiqLowBar := dbEntry.liqLowBar
            displayLiqSource := na(dbEntry.liqSource) ? "N/A" : dbEntry.liqSource
        
        // Inducement Row (closest to zone)
        string inducementLabel = isInspectorDemand ? "Inducement (Low)" : "Inducement (High)"
        string inducementStr = "N/A"
        float inducementPrice = isInspectorDemand ? displayLiqLow : displayLiqHigh
        int inducementBar = isInspectorDemand ? displayLiqLowBar : displayLiqHighBar
        if not na(inducementPrice)
            inducementStr := str.tostring(inducementPrice, format.mintick) + " @ " + str.tostring(inducementBar)
        table.cell(zoneInspector, 0, nextRow, inducementLabel, text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        inducementColor = inducementStr != "N/A" ? color.rgb(100, 200, 255) : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, inducementStr, text_color = inducementColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1
        
        // Target Row (farthest from zone - must be swept)
        string targetLabel = isInspectorDemand ? "Target (High)" : "Target (Low)"
        string targetStr = "N/A"
        float targetPrice = isInspectorDemand ? displayLiqHigh : displayLiqLow
        int targetBar = isInspectorDemand ? displayLiqHighBar : displayLiqLowBar
        if not na(targetPrice)
            targetStr := str.tostring(targetPrice, format.mintick) + " @ " + str.tostring(targetBar)
        table.cell(zoneInspector, 0, nextRow, targetLabel, text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        targetColor = targetStr != "N/A" ? color.new(color.purple, 0) : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, targetStr, text_color = targetColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1
        
        // Push/Inducement Sequence Row (for Demand zones - shows pushHigh → inducement)
        if isInspectorDemand and not na(inspectorZone)
            int pushBar = inspectorZone.pushHighBar
            float pushPrice = inspectorZone.pushHighPrice
            float indLowPrice = inspectorZone.liqLowPrice
            int indBar = inspectorZone.liqLowBar
            
            // Push High price@bar → Inducement price@bar with sequence check
            string pushStr = na(pushBar) or na(pushPrice) ? "N/A" : str.tostring(pushPrice, format.mintick) + "@" + str.tostring(pushBar)
            string indStr = na(indBar) or na(indLowPrice) ? "N/A" : str.tostring(indLowPrice, format.mintick) + "@" + str.tostring(indBar)
            bool seqOK = not na(pushBar) and not na(indBar) and indBar > pushBar
            string seqStatus = seqOK ? " ✓" : (na(pushBar) or na(indBar) ? "" : " ✗")
            string seqStr = "Push:" + pushStr + " → Ind:" + indStr + seqStatus
            
            table.cell(zoneInspector, 0, nextRow, "Push→Ind", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            seqColor = seqOK ? color.green : (na(pushBar) or na(indBar) ? color.rgb(150, 150, 150) : color.orange)
            table.cell(zoneInspector, 1, nextRow, seqStr, text_color = seqColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
            nextRow += 1
        
        // Liq Swept (simple yes/no)
        string liqSweptStr = "N/A"
        bool liqSwept = false
        if not na(inspectorZone)
            liqSwept := inspectorZone.liquiditySwept
            
            // --- LIVE SWEEP CHECK (for active unconfirmed candles) ---
            if not liqSwept
                float sweepTolerance = syminfo.mintick * 20
                if isInspectorDemand and not na(inspectorZone.liqLowPrice)
                    if low <= inspectorZone.liqLowPrice + sweepTolerance
                        liqSwept := true
                else if not isInspectorDemand and not na(inspectorZone.liqHighPrice)
                    if high >= inspectorZone.liqHighPrice - sweepTolerance
                        liqSwept := true
                        
            liqSweptStr := liqSwept ? "YES" : "NO"
        else if foundInDB and not na(dbEntry)
            liqSwept := dbEntry.liquiditySwept
            liqSweptStr := liqSwept ? "YES (DB)" : "NO (DB)"
            
        table.cell(zoneInspector, 0, nextRow, "Liq Swept", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        liqSweptColor := liqSweptStr == "YES" ? color.green : (liqSweptStr == "NO" ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, liqSweptStr, text_color = liqSweptColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1
        
        // Leg Candles (bearish for demand, bullish for supply)
        int displayLegCount = 0
        if not na(inspectorZone)
            displayLegCount := inspectorZone.legCandleCount
        else if foundInDB and not na(dbEntry)
            displayLegCount := dbEntry.legCandleCount
        string legLabel = isInspectorDemand ? "Bearish" : "Bullish"
        string legCandleStr = na(displayLegCount) or displayLegCount == 0 ? "N/A" : str.tostring(displayLegCount) + " " + legLabel

        // Sweep->Touch bar count (bars from liquidity sweep to zone touch)
        int sweep_to_touch_bars = (not na(inspectorZone) and not na(inspectorZone.liquiditySweptBarIndex) and not na(inspectorZone.lastTouchBar) and inspectorZone.lastTouchBar >= inspectorZone.liquiditySweptBarIndex) ? (inspectorZone.lastTouchBar - inspectorZone.liquiditySweptBarIndex) : na
        string sweepTouchStr = na(sweep_to_touch_bars) ? "N/A" : (str.tostring(sweep_to_touch_bars) + " bars")
        color sweepTouchColor = na(sweep_to_touch_bars) ? color.gray : (sweep_to_touch_bars <= max_sweep_to_touch_bars ? color.rgb(0, 200, 100) : (sweep_to_touch_bars <= max_sweep_to_touch_bars * 2 ? color.rgb(255, 180, 0) : color.rgb(255, 80, 80)))
        table.cell(zoneInspector, 0, nextRow, "Sweep->Touch", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.black, 100), text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        table.cell(zoneInspector, 1, nextRow, sweepTouchStr, text_color = sweepTouchColor, bgcolor = color.new(color.black, 100), text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1

        // Peak->Touch bar count (bars from structural extreme to zone touch)
        int peak_to_touch_bars = (not na(inspectorZone) and not na(inspectorZone.peakBarIndex) and not na(inspectorZone.lastTouchBar) and inspectorZone.lastTouchBar >= inspectorZone.peakBarIndex) ? (inspectorZone.lastTouchBar - inspectorZone.peakBarIndex) : na
        string peakTouchStr = na(peak_to_touch_bars) ? "N/A" : (str.tostring(peak_to_touch_bars) + " bars")
        color peakTouchColor = na(peak_to_touch_bars) ? color.gray : (peak_to_touch_bars <= max_peak_to_touch_bars ? color.rgb(0, 200, 100) : (peak_to_touch_bars <= max_peak_to_touch_bars * 2 ? color.rgb(255, 180, 0) : color.rgb(255, 80, 80)))
        table.cell(zoneInspector, 0, nextRow, "Peak->Touch", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.black, 100), text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        table.cell(zoneInspector, 1, nextRow, peakTouchStr, text_color = peakTouchColor, bgcolor = color.new(color.black, 100), text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1

        table.cell(zoneInspector, 0, nextRow, "Leg Candles", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        legCandleColor = displayLegCount > 3 ? color.green : (displayLegCount > 0 ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, legCandleStr, text_color = legCandleColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1
        
        // Primed Status (waiting for next candle entry)
        bool isPrimed = false
        if not na(inspectorZone)
            isPrimed := inspectorZone.primed
        
        table.cell(zoneInspector, 0, nextRow, "Primed", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        string primedStr = isPrimed ? "YES" : "NO"
        color primedColor = isPrimed ? color.green : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, primedStr, text_color = primedColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1
        
        // Liq Source (selection method)
        table.cell(zoneInspector, 0, nextRow, "Liq Source", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        liqSourceColor = displayLiqSource == "ABSOLUTE_SCAN" ? color.green : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, displayLiqSource, text_color = liqSourceColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1
        
        // Zone Status (LIVE / INACTIVE)
        table.cell(zoneInspector, 0, nextRow, "Zone Status", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        statusColor = zoneStatus == "LIVE" ? color.green : (zoneStatus == "INACTIVE" ? color.orange : color.rgb(150, 150, 150))
        table.cell(zoneInspector, 1, nextRow, zoneStatus, text_color = statusColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        nextRow += 1
        
        // Inactive Reason (if applicable)
        table.cell(zoneInspector, 0, nextRow, "Inactive Reason", text_color = color.rgb(150, 150, 150), bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_right, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        inactiveColor = zoneInactiveReason != "N/A" ? color.orange : color.rgb(150, 150, 150)
        table.cell(zoneInspector, 1, nextRow, zoneInactiveReason, text_color = inactiveColor, bgcolor = color.new(color.rgb(25, 30, 35), 5), text_halign = text.align_left, text_size = (table_text_size == "Tiny" ? size.tiny : (table_text_size == "Small" ? size.small : size.normal)))
        
        // === DEBUG LABEL: Visualize Target/Inducement position using TIME for multi-TF alignment ===
        // We use persistent labels (var label) updated on the last bar
        if barstate.islastconfirmedhistory and not na(inspectorZone)
            int indTime = isInspectorDemand ? inspectorZone.liqLowTime : inspectorZone.liqHighTime
            int targetTime = isInspectorDemand ? inspectorZone.liqHighTime : inspectorZone.liqLowTime
            
            if not na(indTime) and not na(inducementPrice)
                string indFormat = (isInspectorDemand ? "📍 IND (L): " : "📍 IND (H): ") + str.tostring(inducementPrice, format.mintick) + " @ " + str.tostring(inducementBar)
                if na(inspectorIndLabel)
                    inspectorIndLabel := label.new(indTime, inducementPrice, indFormat, xloc=xloc.bar_time, style=label.style_label_up, color=color.new(color.orange, 20), textcolor=color.white, size=size.small)
                else
                    label.set_xy(inspectorIndLabel, indTime, inducementPrice)
                    label.set_text(inspectorIndLabel, indFormat)
            else
                label.delete(inspectorIndLabel)
                inspectorIndLabel := na

            if not na(targetTime) and not na(targetPrice)
                string tgtFormat = (isInspectorDemand ? "🎯 TARGET (H): " : "🎯 TARGET (L): ") + str.tostring(targetPrice, format.mintick) + " @ " + str.tostring(targetBar)
                if na(inspectorTgtLabel)
                    inspectorTgtLabel := label.new(targetTime, targetPrice, tgtFormat, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.purple, 20), textcolor=color.white, size=size.small)
                else
                    label.set_xy(inspectorTgtLabel, targetTime, targetPrice)
                    label.set_text(inspectorTgtLabel, tgtFormat)
            else
                label.delete(inspectorTgtLabel)
                inspectorTgtLabel := na
        else
            // Delete labels if not inspecting or not on last bar
            label.delete(inspectorIndLabel)
            label.delete(inspectorTgtLabel)
            inspectorIndLabel := na
            inspectorTgtLabel := na
else
    if not na(zoneInspector)
        table.delete(zoneInspector)
        zoneInspector := na

// === PERFORMANCE TABLE ===
performanceTable := draw_performance_table(performanceTable)

// 1. Profile Status (Bottom Center) — lazy init, delete when disabled to avoid leftover artifacts
var table profileStatusTable = na

if showDebugPanels and showActiveProfile
    if na(profileStatusTable)
        profileStatusTable := table.new(position.bottom_center, 2, 9, 
             bgcolor = color.new(color.rgb(20, 25, 30), 10), 
             frame_color = color.new(color.rgb(100, 110, 120), 80), frame_width = 1, 
             border_color = color.new(color.rgb(60, 70, 80), 50), border_width = 1)
    // Header
    table.cell(profileStatusTable, 0, 0, "⚡ ACTIVE PROFILE", 
        text_color = color.white, 
        bgcolor = color.new(color.rgb(0, 120, 215), 20),
        text_size = size.normal,
        text_halign = text.align_center)
    table.cell(profileStatusTable, 1, 0, config_profile, 
        text_color = use_profile_defaults ? color.yellow : color.white, 
        bgcolor = color.new(color.rgb(0, 120, 215), 20),
        text_size = size.normal,
        text_halign = text.align_left)
    
    // Key Settings
    table.cell(profileStatusTable, 0, 1, "pvtMax", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 1, str.tostring(pvtMax), text_color = color.white, text_halign = text.align_left)
    
    table.cell(profileStatusTable, 0, 2, "AI Threshold", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 2, str.tostring(ai_quality_threshold), text_color = color.white, text_halign = text.align_left)
    
    table.cell(profileStatusTable, 0, 3, "RR Ratio", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    string rr_label = use_custom_rr ? "1:" + str.tostring(risk_reward_ratio, "#.#") : (is_aggressive and use_profile_defaults ? "SL-based" : "1:" + str.tostring(risk_reward_ratio, "#.#"))
    table.cell(profileStatusTable, 1, 3, rr_label, text_color = color.white, text_halign = text.align_left)
    
    // RR Mode: explicit indicator when YOUR rules (Aggressive) vs overridden vs profile/default
    table.cell(profileStatusTable, 0, 4, "RR Mode", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    string rr_mode = ""
    color rr_mode_color = color.white
    if use_custom_rr
        rr_mode := "OVERRIDDEN: Fixed 1:" + str.tostring(risk_reward_ratio, "#.#")
        rr_mode_color := color.orange
    else if is_aggressive and use_profile_defaults
        rr_mode := "✓ YOUR RULES (Aggressive)"
        rr_mode_color := color.lime
    else if use_profile_defaults and (config_profile == "Conservative (Live Trading)" or config_profile == "Balanced (Recommended)")
        rr_mode := "SL-based (Profile)"
        rr_mode_color := color.white
    else
        rr_mode := "SL-based (Default)"
        rr_mode_color := color.gray
    table.cell(profileStatusTable, 1, 4, rr_mode, text_color = rr_mode_color, text_halign = text.align_left)
    
    table.cell(profileStatusTable, 0, 5, "Max Trades/Day", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 5, str.tostring(max_trades_per_day), text_color = color.white, text_halign = text.align_left)
    
    table.cell(profileStatusTable, 0, 6, "Structure Mode", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 6, structure_mode, text_color = color.white, text_halign = text.align_left)
    
    table.cell(profileStatusTable, 0, 7, "Grade Filter", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(profileStatusTable, 1, 7, enable_grade_filter ? min_entry_grade + "+" : "OFF", 
        text_color = enable_grade_filter ? color.green : color.gray, 
        text_halign = text.align_left)
    
    table.cell(profileStatusTable, 0, 8, "Time Filters", text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    time_filter_status = (filter_dead_zone ? "✓" : "✗") + " Dead Zone | " + (filter_trading_hours ? "✓" : "✗") + " Hours"
    table.cell(profileStatusTable, 1, 8, time_filter_status, 
        text_color = (filter_dead_zone and filter_trading_hours) ? color.green : color.orange, 
        text_halign = text.align_left)
else
    if not na(profileStatusTable)
        table.delete(profileStatusTable)
        profileStatusTable := na

// === DEBUG PLOTS: SL/TP Visualization ===
