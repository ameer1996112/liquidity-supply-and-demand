ema_context_slope_lookback = input.int(10, "ema_context_slope_lookback", minval = 1, maxval = 100, group = grpEMAContext, tooltip = "Bars used to measure EMA slope in pips for alert learning context.")
ema_context_neutral_atr_mult = input.float(0.10, "ema_context_neutral_atr_mult", minval = 0.0, maxval = 2.0, step = 0.05, group = grpEMAContext, tooltip = "Zone midpoint distance inside this ATR multiple is marked neutral.")
show_ema_context_line = input.bool(true, "show_ema_context_line", group = grpEMAContext, tooltip = "Plot the EMA used for alert learning context.")


