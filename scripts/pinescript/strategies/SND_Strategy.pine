grpRisk = "Prop Firm Risk Management"

risk_pct          = input.float(0.4,  "risk_pct",     minval=0.1, maxval=2.0, step=0.1, group=grpRisk, tooltip="Percent of current equity risked per trade. 0.4% on a $50k account = $200 per trade.")
daily_kill_pct    = input.float(4.0,  "daily_kill_pct",      minval=1.0, maxval=5.0, step=0.5, group=grpRisk, tooltip="Stop trading for the day after this drawdown from day-start equity. Keep below the prop firm daily DD limit (5% on ACG/FTMO).")
total_kill_pct    = input.float(8.0,  "total_kill_pct",      minval=4.0, maxval=10.0, step=0.5, group=grpRisk, tooltip="Stop trading entirely after this drawdown from peak equity. Keep below the prop firm max DD limit (10% on ACG/FTMO).")
consec_loss_kill  = input.int(2,      "consec_loss_kill",  minval=1, maxval=5, group=grpRisk, tooltip="Stop trading for the day after this many consecutive losing trades.")
min_hold_minutes  = input.int(2,      "min_hold_minutes", minval=0, maxval=60, group=grpRisk, tooltip="Block exits before this many minutes after entry. ACG Pro requires 2 min minimum.")
news_blackout_enabled = input.bool(false, "news_blackout_enabled", group=grpRisk, tooltip="Manual news event filter. Edit the news_times array in code to update.")

