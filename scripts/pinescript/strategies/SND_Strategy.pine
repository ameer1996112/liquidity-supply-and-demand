// AI & Quality Filters
enable_ai_quality_filter = input.bool(true, "AI Quality Filter", group = "⚙️ Advanced / Manual Tweaks", tooltip = "ON: Block low-quality setups using AI scoring. Improves win rate.")
ai_quality_threshold = input.int(60, "   └─ Min Score (0-100)", minval = 0, maxval = 100, group = "⚙️ Advanced / Manual Tweaks", tooltip = "Minimum quality score to take trade. 60 = ~60% expected win rate. Higher = fewer but better trades.")
// [optimization/ai-overhaul] AI Lite Mode: only blocks obviously bad trades (Score < 30)
// Use this when the normal threshold is too aggressive and reducing trade frequency to near zero.
// Score < 30 means ALL of: wrong trend, bad session, choppy base, no liquidity, stale zone.
enable_ai_lite_mode = input.bool(false, "   └─ Lite Mode (Block Only Score<30)", group = "⚙️ Advanced / Manual Tweaks", tooltip = "ON: Ignores the Min Score threshold above and only blocks trades with Score < 30 (obviously bad setups). Use when normal filter is too strict.")
// [optimization/ai-overhaul] AI Shadow Mode: logs what the filter WOULD have done without blocking
// Enable this to collect calibration data without losing trades.
enable_ai_shadow_mode = input.bool(false, "   └─ Shadow Mode (Never Blocks)", group = "⚙️ Advanced / Manual Tweaks", tooltip = "ON: AI filter runs but NEVER blocks trades. Blocked reason is shown in debug labels only. Use to measure how often the filter would reject without losing real trades.")
enable_grade_filter = input.bool(false, "Grade Filter", group = "⚙️ Advanced / Manual Tweaks", tooltip = "ON: Filter by zone grade (A+, A, B+, etc). OFF: Use score filter instead.")
