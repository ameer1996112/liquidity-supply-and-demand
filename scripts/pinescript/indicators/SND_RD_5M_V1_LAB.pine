//@version=6
indicator("SND RD 5M V1 LAB", overlay = true, max_boxes_count = 300, max_labels_count = 300)

// Canonical, non-executable raw-zone detector. Decisions occur on closed 5m bars.

const string DIRECTION_DEMAND = "DEMAND"
const string DIRECTION_SUPPLY = "SUPPLY"
const string FORMATION_REVERSAL = "REVERSAL"
const string FORMATION_CONTINUATION = "CONTINUATION"
const string GEOMETRY_STANDARD = "STANDARD"
const string GEOMETRY_ACCURACY = "ACCURACY"
const string STATE_FRESH = "CONFIRMED_FRESH"
const string STATE_TAPPED = "TAPPED"
const string STATE_INVALIDATED = "INVALIDATED"
const string ELIGIBILITY_WAITING = "WAITING_FOR_LIQUIDITY"
const string ELIGIBILITY_ELIGIBLE = "ELIGIBLE"
const string ELIGIBILITY_EXPIRED = "EXPIRED"
const string SETUP_WAITING = "WAITING_FOR_ELIGIBILITY"
const string SETUP_ARMED = "ARMED"
const string SETUP_TRIGGERED = "TRIGGERED"
const string SETUP_REJECTED = "REJECTED"
const string DISPLAY_CLEAN = "Clean"
const string DISPLAY_RAW_AUDIT = "Raw audit"

const string CONFIRM_CLOSE_BEYOND_ORIGIN = "CONFIRM_CLOSE_BEYOND_ORIGIN"
const string REJECT_FORMATION_INTERRUPTED = "REJECT_FORMATION_INTERRUPTED"
const string REJECT_UNKNOWN_APPROACH = "REJECT_UNKNOWN_APPROACH"
const string TAP_POST_CONFIRM_OVERLAP = "TAP_POST_CONFIRM_OVERLAP"
const string INVALIDATE_CLOSE_BEYOND_DISTAL = "INVALIDATE_CLOSE_BEYOND_DISTAL"
const string WAIT_MINIMUM_LIQUIDITY_CANDLES = "WAIT_MINIMUM_LIQUIDITY_CANDLES"
const string REJECT_ONE_CANDLE_LIQUIDITY = "REJECT_ONE_CANDLE_LIQUIDITY"
const string WAIT_LIQUIDITY_OWN_EXTREME = "WAIT_LIQUIDITY_OWN_EXTREME"
const string LIQUIDITY_OWN_EXTREME_TAKEN = "LIQUIDITY_OWN_EXTREME_TAKEN"
const string EXPIRE_ZONE_NOT_FRESH = "EXPIRE_ZONE_NOT_FRESH"
const string EXPIRE_OPPOSITE_ZONE_RETRACE = "EXPIRE_OPPOSITE_ZONE_RETRACE"
const string WAIT_SETUP_ELIGIBILITY = "WAIT_SETUP_ELIGIBILITY"
const string ARM_SETUP_AFTER_LIQUIDITY = "ARM_SETUP_AFTER_LIQUIDITY"
const string TRIGGER_FIRST_FRESH_TAP_AFTER_LIQUIDITY = "TRIGGER_FIRST_FRESH_TAP_AFTER_LIQUIDITY"
const string REJECT_TARGET_TAP_WITHOUT_ELIGIBILITY = "REJECT_TARGET_TAP_WITHOUT_ELIGIBILITY"
const string REJECT_TARGET_INVALIDATED_ON_RETURN = "REJECT_TARGET_INVALIDATED_ON_RETURN"
const string REJECT_AMBIGUOUS_SAME_BAR_ROUTE = "REJECT_AMBIGUOUS_SAME_BAR_ROUTE"

maxZones = input.int(120, "Maximum zones", minval = 10, maxval = 200, group = "Display")
projectionBars = input.int(120, "Fresh-zone projection bars", minval = 1, maxval = 500, group = "Display")
displayMode = input.string(DISPLAY_CLEAN, "View", options = [DISPLAY_CLEAN, DISPLAY_RAW_AUDIT], group = "Display")
cleanZonesPerSide = input.int(3, "Clean zones per side", minval = 1, maxval = 10, group = "Display")
showFresh = input.bool(true, "Show fresh zones", group = "Display")
showTapped = input.bool(false, "Show tapped zones", group = "Display")
showInvalidated = input.bool(false, "Show invalidated zones", group = "Display")
showLabels = input.bool(false, "Show diagnostic labels", group = "Diagnostics")
emitDiagnostics = input.bool(false, "Emit non-executable diagnostic alerts", group = "Diagnostics")

demandColor = input.color(color.new(color.teal, 72), "Demand", group = "Colors")
supplyColor = input.color(color.new(color.red, 76), "Supply", group = "Colors")
accuracyDemandColor = input.color(color.new(color.blue, 72), "Accuracy demand", group = "Colors")
accuracySupplyColor = input.color(color.new(color.orange, 70), "Accuracy supply", group = "Colors")
tappedColor = input.color(color.new(color.gray, 82), "Tapped", group = "Colors")
invalidatedColor = input.color(color.new(color.black, 88), "Invalidated", group = "Colors")

type Candidate
    bool isActive
    bool isForming
    int originBar
    int originTime
    float originOpen
    float originHigh
    float originLow
    float originClose
    int approachDirection
    int firstDepartureBar
    float firstDepartureHigh
    float firstDepartureLow
    float distal

type RawZone
    int id
    bool demand
    string formation
    string geometry
    int originBar
    int originTime
    int confirmationBar
    int confirmationTime
    float top
    float bottom
    string state
    int stateBar
    int stateTime
    string reason
    bool departureActive
    string eligibilityState
    int eligibilityBar
    int eligibilityTime
    string eligibilityReason
    float liquidityAnchor
    float liquidityExtreme
    int liquidityPrimaryIndex
    int liquidityRunCount
    float liquidityRunAnchor
    float liquidityRunNearExtreme
    array<float> liquidityAnchors
    array<float> liquidityExtremes
    array<bool> liquidityTaken
    int routeBlockerId
    string setupState
    int setupBar
    int setupTime
    string setupReason
    box zoneBox
    label debugLabel

method reset(Candidate this) =>
    this.isActive := false
    this.isForming := false
    this.originBar := na
    this.originTime := na
    this.originOpen := na
    this.originHigh := na
    this.originLow := na
    this.originClose := na
    this.approachDirection := 0
    this.firstDepartureBar := na
    this.firstDepartureHigh := na
    this.firstDepartureLow := na
    this.distal := na

candleDirection(int offset) =>
    close[offset] > open[offset] ? 1 : close[offset] < open[offset] ? -1 : 0

method begin(Candidate this) =>
    this.isActive := true
    this.isForming := false
    this.originBar := bar_index
    this.originTime := time
    this.originOpen := open
    this.originHigh := high
    this.originLow := low
    this.originClose := close
    this.approachDirection := bar_index > 0 ? candleDirection(1) : 0
    this.firstDepartureBar := na
    this.firstDepartureHigh := na
    this.firstDepartureLow := na
    this.distal := na

method rebaseInsideFormation(Candidate this) =>
    bool rebased = false
    if this.isActive and this.isForming
        rebased := high <= this.originHigh and low >= this.originLow
        if rebased
            this.isForming := false
            this.originBar := bar_index
            this.originTime := time
            this.originOpen := open
            this.originHigh := high
            this.originLow := low
            this.originClose := close
            this.approachDirection := bar_index > 0 ? candleDirection(1) : 0
            this.firstDepartureBar := na
            this.firstDepartureHigh := na
            this.firstDepartureLow := na
    rebased

method advance(Candidate this, bool demand) =>
    if not this.isForming
        this.isForming := true
        this.firstDepartureBar := bar_index
        this.firstDepartureHigh := high
        this.firstDepartureLow := low
        this.distal := demand ? (na(this.distal) ? low : math.min(this.distal, low)) : (na(this.distal) ? high : math.max(this.distal, high))
    else
        this.distal := demand ? math.min(this.distal, low) : math.max(this.distal, high)
    demand ? close > this.originHigh : close < this.originLow

candidateFormation(Candidate candidate, bool demand) =>
    string result = ""
    if candidate.approachDirection != 0
        bool continuation = demand ? candidate.approachDirection == 1 : candidate.approachDirection == -1
        result := continuation ? FORMATION_CONTINUATION : FORMATION_REVERSAL
    result

buildConfirmedZone(Candidate candidate, bool demand, int zoneId, string formation) =>
    bool accuracy = demand ? candidate.originHigh > candidate.firstDepartureHigh : candidate.originLow < candidate.firstDepartureLow
    string geometry = accuracy ? GEOMETRY_ACCURACY : GEOMETRY_STANDARD
    float bodyHigh = math.max(candidate.originOpen, candidate.originClose)
    float bodyLow = math.min(candidate.originOpen, candidate.originClose)
    float frozenTop = accuracy ? bodyHigh : candidate.originHigh
    float frozenBottom = accuracy ? bodyLow : candidate.originLow
    if demand
        frozenBottom := math.min(frozenBottom, candidate.distal)
    else
        frozenTop := math.max(frozenTop, candidate.distal)

    RawZone zone = RawZone.new()
    zone.id := zoneId
    zone.demand := demand
    zone.formation := formation
    zone.geometry := geometry
    zone.originBar := candidate.originBar
    zone.originTime := candidate.originTime
    zone.confirmationBar := bar_index
    zone.confirmationTime := time_close
    zone.top := frozenTop
    zone.bottom := frozenBottom
    zone.state := STATE_FRESH
    zone.stateBar := na
    zone.stateTime := na
    zone.reason := CONFIRM_CLOSE_BEYOND_ORIGIN
    zone.departureActive := true
    zone.eligibilityState := ELIGIBILITY_WAITING
    zone.eligibilityBar := na
    zone.eligibilityTime := na
    zone.eligibilityReason := WAIT_MINIMUM_LIQUIDITY_CANDLES
    zone.liquidityAnchor := na
    zone.liquidityExtreme := na
    zone.liquidityPrimaryIndex := na
    zone.liquidityRunCount := 0
    zone.liquidityRunAnchor := na
    zone.liquidityRunNearExtreme := na
    zone.liquidityAnchors := array.new<float>()
    zone.liquidityExtremes := array.new<float>()
    zone.liquidityTaken := array.new<bool>()
    zone.routeBlockerId := na
    zone.setupState := SETUP_WAITING
    zone.setupBar := na
    zone.setupTime := na
    zone.setupReason := WAIT_SETUP_ELIGIBILITY
    zone.zoneBox := na
    zone.debugLabel := na
    zone

zoneDistanceFromPrice(RawZone zone) =>
    close < zone.bottom ? zone.bottom - close : close > zone.top ? close - zone.top : 0.0

zoneSelectedForCleanView(RawZone target, array<RawZone> allZones) =>
    int closerCount = 0
    float targetDistance = zoneDistanceFromPrice(target)
    int candidateCount = array.size(allZones)
    if candidateCount > 0
        for candidateIndex = 0 to candidateCount - 1
            RawZone candidate = array.get(allZones, candidateIndex)
            bool comparable = candidate.id != target.id and candidate.demand == target.demand and candidate.state == STATE_FRESH
            if comparable
                float candidateDistance = zoneDistanceFromPrice(candidate)
                bool ranksAhead = candidateDistance < targetDistance or (candidateDistance == targetDistance and candidate.id > target.id)
                if ranksAhead
                    closerCount += 1
    closerCount < cleanZonesPerSide

zoneVisible(RawZone zone, array<RawZone> allZones) =>
    bool lifecycleVisible = zone.state == STATE_FRESH ? showFresh : zone.state == STATE_TAPPED ? showTapped : showInvalidated
    displayMode == DISPLAY_RAW_AUDIT ? lifecycleVisible : zone.state == STATE_FRESH and showFresh and zoneSelectedForCleanView(zone, allZones)

zoneColor(RawZone zone) =>
    color result = zone.state == STATE_TAPPED ? tappedColor : zone.state == STATE_INVALIDATED ? invalidatedColor : zone.geometry == GEOMETRY_ACCURACY ? (zone.demand ? accuracyDemandColor : accuracySupplyColor) : (zone.demand ? demandColor : supplyColor)
    result

zoneBorderColor(RawZone zone) =>
    zone.demand ? color.teal : color.red

zoneRightBar(RawZone zone) =>
    zone.state == STATE_FRESH ? bar_index + projectionBars : zone.stateBar

zoneText(RawZone zone) =>
    string side = zone.demand ? "D" : "S"
    "Z" + str.tostring(zone.id) + " " + side + " " + zone.formation + " " + zone.geometry + "\n" + zone.state + " " + zone.reason + "\n" + zone.eligibilityState + " " + zone.eligibilityReason + "\n" + zone.setupState + " " + zone.setupReason

updateZoneDrawing(RawZone zone, array<RawZone> allZones) =>
    bool visible = zoneVisible(zone, allZones)
    if visible
        int rightBar = zoneRightBar(zone)
        if na(zone.zoneBox)
            zone.zoneBox := box.new(zone.originBar, zone.top, rightBar, zone.bottom, xloc = xloc.bar_index, bgcolor = zoneColor(zone), border_color = zoneBorderColor(zone), border_width = zone.geometry == GEOMETRY_ACCURACY ? 2 : 1)
        else
            box.set_right(zone.zoneBox, rightBar)
            box.set_top(zone.zoneBox, zone.top)
            box.set_bottom(zone.zoneBox, zone.bottom)
            box.set_bgcolor(zone.zoneBox, zoneColor(zone))
            box.set_border_color(zone.zoneBox, zoneBorderColor(zone))
        if showLabels
            if na(zone.debugLabel)
                zone.debugLabel := label.new(zone.originBar, zone.demand ? zone.bottom : zone.top, zoneText(zone), xloc = xloc.bar_index, style = zone.demand ? label.style_label_up : label.style_label_down, color = color.new(color.black, 15), textcolor = color.white, size = size.tiny)
            else
                label.set_text(zone.debugLabel, zoneText(zone))
        else if not na(zone.debugLabel)
            label.delete(zone.debugLabel)
            zone.debugLabel := na
    else
        if not na(zone.zoneBox)
            box.delete(zone.zoneBox)
            zone.zoneBox := na
        if not na(zone.debugLabel)
            label.delete(zone.debugLabel)
            zone.debugLabel := na
    true

diagnosticPayload(string eventName, RawZone zone) =>
    "{" +
     "\"event\":\"" + eventName + "\"," +
     "\"strategy_id\":\"snd_rd_5m_v1_lab\"," +
     "\"executable\":false," +
     "\"symbol\":\"" + syminfo.tickerid + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"zone_id\":" + str.tostring(zone.id) + "," +
     "\"direction\":\"" + (zone.demand ? DIRECTION_DEMAND : DIRECTION_SUPPLY) + "\"," +
     "\"formation\":\"" + zone.formation + "\"," +
     "\"geometry\":\"" + zone.geometry + "\"," +
     "\"origin_time\":" + str.tostring(zone.originTime) + "," +
     "\"confirmation_time\":" + str.tostring(zone.confirmationTime) + "," +
     "\"top\":" + str.tostring(zone.top, format.mintick) + "," +
     "\"bottom\":" + str.tostring(zone.bottom, format.mintick) + "," +
     "\"state\":\"" + zone.state + "\"," +
     "\"reason\":\"" + zone.reason + "\"," +
     "\"eligibility_state\":\"" + zone.eligibilityState + "\"," +
     "\"eligibility_reason\":\"" + zone.eligibilityReason + "\"," +
     "\"liquidity_anchor\":" + (na(zone.liquidityAnchor) ? "null" : str.tostring(zone.liquidityAnchor, format.mintick)) + "," +
     "\"liquidity_extreme\":" + (na(zone.liquidityExtreme) ? "null" : str.tostring(zone.liquidityExtreme, format.mintick)) + "," +
     "\"liquidity_primary_index\":" + (na(zone.liquidityPrimaryIndex) ? "null" : str.tostring(zone.liquidityPrimaryIndex)) + "," +
     "\"route_blocker_zone_id\":" + (na(zone.routeBlockerId) ? "null" : str.tostring(zone.routeBlockerId)) + "," +
     "\"setup_state\":\"" + zone.setupState + "\"," +
     "\"setup_reason\":\"" + zone.setupReason + "\"," +
     "\"setup_time\":" + (na(zone.setupTime) ? "null" : str.tostring(zone.setupTime)) + "}"

extendLiquidityRun(RawZone zone) =>
    if zone.liquidityRunCount == 0
        zone.liquidityRunAnchor := zone.demand ? math.max(high[1], high) : math.min(low[1], low)
        zone.liquidityRunNearExtreme := zone.demand ? low : high
    else
        zone.liquidityRunAnchor := zone.demand ? math.max(zone.liquidityRunAnchor, high) : math.min(zone.liquidityRunAnchor, low)
        zone.liquidityRunNearExtreme := zone.demand ? math.min(zone.liquidityRunNearExtreme, low) : math.max(zone.liquidityRunNearExtreme, high)
    zone.liquidityRunCount += 1
    if zone.eligibilityState != ELIGIBILITY_ELIGIBLE
        zone.eligibilityReason := WAIT_MINIMUM_LIQUIDITY_CANDLES

completeLiquidityRun(RawZone zone) =>
    if zone.liquidityRunCount >= 2
        float nearExtreme = zone.demand ? math.min(zone.liquidityRunNearExtreme, low) : math.max(zone.liquidityRunNearExtreme, high)
        array.push(zone.liquidityAnchors, zone.liquidityRunAnchor)
        array.push(zone.liquidityExtremes, nearExtreme)
        array.push(zone.liquidityTaken, false)
        zone.eligibilityReason := WAIT_LIQUIDITY_OWN_EXTREME
    else if zone.liquidityRunCount == 1
        zone.eligibilityReason := REJECT_ONE_CANDLE_LIQUIDITY
    zone.liquidityRunCount := 0
    zone.liquidityRunAnchor := na
    zone.liquidityRunNearExtreme := na

updateZoneEligibility(RawZone zone) =>
    bool becameEligible = false
    if zone.eligibilityState == ELIGIBILITY_EXPIRED
        becameEligible := false
    else if zone.state != STATE_FRESH
        if zone.eligibilityState != ELIGIBILITY_ELIGIBLE
            zone.eligibilityState := ELIGIBILITY_EXPIRED
            zone.eligibilityBar := bar_index
            zone.eligibilityTime := time_close
            zone.eligibilityReason := EXPIRE_ZONE_NOT_FRESH
    else if bar_index > zone.confirmationBar
        bool requiredCandle = zone.demand ? close < open : close > open
        if requiredCandle
            extendLiquidityRun(zone)
        else
            completeLiquidityRun(zone)

        int primaryIndex = na
        float primaryExtreme = na
        int candidateCount = array.size(zone.liquidityAnchors)
        if candidateCount > 0
            for candidateIndex = 0 to candidateCount - 1
                float candidateAnchor = array.get(zone.liquidityAnchors, candidateIndex)
                float candidateExtreme = array.get(zone.liquidityExtremes, candidateIndex)
                bool taken = array.get(zone.liquidityTaken, candidateIndex)
                if not taken
                    taken := zone.demand ? high > candidateAnchor : low < candidateAnchor
                    if taken
                        array.set(zone.liquidityTaken, candidateIndex, true)
                bool closer = na(primaryIndex) or (zone.demand ? candidateExtreme <= primaryExtreme : candidateExtreme >= primaryExtreme)
                if closer
                    primaryIndex := candidateIndex
                    primaryExtreme := candidateExtreme

        if not na(primaryIndex)
            string previousEligibility = zone.eligibilityState
            int previousPrimaryIndex = zone.liquidityPrimaryIndex
            bool primaryTaken = array.get(zone.liquidityTaken, primaryIndex)
            string nextEligibility = primaryTaken ? ELIGIBILITY_ELIGIBLE : ELIGIBILITY_WAITING
            bool primaryChanged = na(previousPrimaryIndex) or previousPrimaryIndex != primaryIndex
            bool stateChanged = previousEligibility != nextEligibility
            zone.liquidityAnchor := array.get(zone.liquidityAnchors, primaryIndex)
            zone.liquidityExtreme := array.get(zone.liquidityExtremes, primaryIndex)
            zone.liquidityPrimaryIndex := primaryIndex
            if primaryChanged or stateChanged
                zone.eligibilityBar := bar_index
                zone.eligibilityTime := time_close
            if primaryTaken
                zone.eligibilityState := nextEligibility
                zone.eligibilityReason := LIQUIDITY_OWN_EXTREME_TAKEN
                becameEligible := previousEligibility != ELIGIBILITY_ELIGIBLE
            else
                zone.eligibilityState := nextEligibility
                zone.eligibilityReason := WAIT_LIQUIDITY_OWN_EXTREME
    becameEligible

routeBlockerId(RawZone target, array<RawZone> allZones) =>
    int blockerId = na
    float blockerDistance = na
    bool routeIsArmed = target.state == STATE_FRESH and target.eligibilityState == ELIGIBILITY_ELIGIBLE and not na(target.eligibilityBar) and bar_index > target.eligibilityBar
    int candidateCount = array.size(allZones)
    if routeIsArmed and candidateCount > 0
        for candidateIndex = 0 to candidateCount - 1
            RawZone candidate = array.get(allZones, candidateIndex)
            bool oppositeDirection = candidate.demand != target.demand
            bool tappedNow = candidate.state == STATE_TAPPED and candidate.stateBar == bar_index
            bool inFront = target.demand ? candidate.bottom > target.top : candidate.top < target.bottom
            if oppositeDirection and tappedNow and inFront
                float distance = target.demand ? candidate.bottom - target.top : target.bottom - candidate.top
                if na(blockerId) or distance < blockerDistance
                    blockerId := candidate.id
                    blockerDistance := distance
    blockerId

sameBarRouteBlockerId(RawZone target, array<RawZone> allZones) =>
    int blockerId = na
    float blockerDistance = na
    bool targetTappedNow = target.state == STATE_TAPPED and target.stateBar == bar_index
    bool routeWasArmed = target.eligibilityState == ELIGIBILITY_ELIGIBLE and not na(target.eligibilityBar) and bar_index > target.eligibilityBar
    int candidateCount = array.size(allZones)
    if targetTappedNow and routeWasArmed and candidateCount > 0
        for candidateIndex = 0 to candidateCount - 1
            RawZone candidate = array.get(allZones, candidateIndex)
            bool oppositeDirection = candidate.demand != target.demand
            bool tappedNow = candidate.state == STATE_TAPPED and candidate.stateBar == bar_index
            bool inFront = target.demand ? candidate.bottom > target.top : candidate.top < target.bottom
            if oppositeDirection and tappedNow and inFront
                float distance = target.demand ? candidate.bottom - target.top : target.bottom - candidate.top
                if na(blockerId) or distance < blockerDistance
                    blockerId := candidate.id
                    blockerDistance := distance
    blockerId

transitionSetup(RawZone zone, string nextState, string nextReason) =>
    zone.setupState := nextState
    zone.setupBar := bar_index
    zone.setupTime := time_close
    zone.setupReason := nextReason

updateSetupState(RawZone zone, array<RawZone> allZones) =>
    string eventName = ""
    bool terminal = zone.setupState == SETUP_TRIGGERED or zone.setupState == SETUP_REJECTED
    if not terminal
        if zone.state == STATE_INVALIDATED
            transitionSetup(zone, SETUP_REJECTED, REJECT_TARGET_INVALIDATED_ON_RETURN)
            eventName := "SETUP_REJECTED_NON_EXECUTABLE"
        else if zone.state == STATE_TAPPED
            int blockerId = sameBarRouteBlockerId(zone, allZones)
            if not na(blockerId)
                zone.eligibilityState := ELIGIBILITY_EXPIRED
                zone.eligibilityBar := bar_index
                zone.eligibilityTime := time_close
                zone.eligibilityReason := EXPIRE_OPPOSITE_ZONE_RETRACE
                zone.routeBlockerId := blockerId
                transitionSetup(zone, SETUP_REJECTED, REJECT_AMBIGUOUS_SAME_BAR_ROUTE)
                eventName := "SETUP_REJECTED_NON_EXECUTABLE"
            else if zone.eligibilityState == ELIGIBILITY_ELIGIBLE
                transitionSetup(zone, SETUP_TRIGGERED, TRIGGER_FIRST_FRESH_TAP_AFTER_LIQUIDITY)
                eventName := "SETUP_TRIGGERED_NON_EXECUTABLE"
            else
                transitionSetup(zone, SETUP_REJECTED, REJECT_TARGET_TAP_WITHOUT_ELIGIBILITY)
                eventName := "SETUP_REJECTED_NON_EXECUTABLE"
        else if zone.eligibilityState == ELIGIBILITY_EXPIRED
            transitionSetup(zone, SETUP_REJECTED, zone.eligibilityReason)
            eventName := "SETUP_REJECTED_NON_EXECUTABLE"
        else if zone.eligibilityState == ELIGIBILITY_ELIGIBLE
            if zone.setupState != SETUP_ARMED
                transitionSetup(zone, SETUP_ARMED, ARM_SETUP_AFTER_LIQUIDITY)
                eventName := "SETUP_ARMED_NON_EXECUTABLE"
        else if zone.setupState == SETUP_ARMED
            transitionSetup(zone, SETUP_WAITING, WAIT_SETUP_ELIGIBILITY)
            eventName := "SETUP_WAITING_NON_EXECUTABLE"
    eventName

deleteZone(RawZone zone) =>
    if not na(zone.zoneBox)
        box.delete(zone.zoneBox)
    if not na(zone.debugLabel)
        label.delete(zone.debugLabel)

var Candidate demandCandidate = Candidate.new()
var Candidate supplyCandidate = Candidate.new()
var RawZone[] zones = array.new<RawZone>()
var int nextZoneId = 1
var string lastDecision = "WAITING_FOR_CLOSED_5M_BAR"

if barstate.isfirst
    demandCandidate.reset()
    supplyCandidate.reset()

bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool confirmedEvent = false
RawZone eventZone = na

if barstate.isconfirmed and isFiveMinute
    int zoneCount = array.size(zones)
    if zoneCount > 0
        for index = 0 to zoneCount - 1
            RawZone zone = array.get(zones, index)
            if zone.state == STATE_FRESH and bar_index > zone.confirmationBar
                bool sameDirectionDeparture = zone.demand ? close > open : close < open
                if not (zone.departureActive and sameDirectionDeparture)
                    zone.departureActive := false
                    bool overlaps = high >= zone.bottom and low <= zone.top
                    if overlaps
                        bool invalidated = zone.demand ? close < zone.bottom : close > zone.top
                        zone.state := invalidated ? STATE_INVALIDATED : STATE_TAPPED
                        zone.stateBar := bar_index
                        zone.stateTime := time_close
                        zone.reason := invalidated ? INVALIDATE_CLOSE_BEYOND_DISTAL : TAP_POST_CONFIRM_OVERLAP
                        lastDecision := zone.reason
                        if emitDiagnostics
                            alert(diagnosticPayload(invalidated ? "ZONE_INVALIDATED_NON_EXECUTABLE" : "ZONE_TAPPED_NON_EXECUTABLE", zone), alert.freq_once_per_bar_close)
            array.set(zones, index, zone)

        for index = 0 to zoneCount - 1
            RawZone zone = array.get(zones, index)
            int blockerId = routeBlockerId(zone, zones)
            if not na(blockerId)
                zone.eligibilityState := ELIGIBILITY_EXPIRED
                zone.eligibilityBar := bar_index
                zone.eligibilityTime := time_close
                zone.eligibilityReason := EXPIRE_OPPOSITE_ZONE_RETRACE
                zone.routeBlockerId := blockerId
                lastDecision := EXPIRE_OPPOSITE_ZONE_RETRACE
                if emitDiagnostics
                    alert(diagnosticPayload("ZONE_ROUTE_EXPIRED_NON_EXECUTABLE", zone), alert.freq_once_per_bar_close)
            else
                bool becameEligible = updateZoneEligibility(zone)
                if becameEligible
                    lastDecision := LIQUIDITY_OWN_EXTREME_TAKEN
                    if emitDiagnostics
                        alert(diagnosticPayload("ZONE_ELIGIBLE_NON_EXECUTABLE", zone), alert.freq_once_per_bar_close)
            array.set(zones, index, zone)

        for index = 0 to zoneCount - 1
            RawZone zone = array.get(zones, index)
            string setupEvent = updateSetupState(zone, zones)
            if str.length(setupEvent) > 0
                lastDecision := zone.setupReason
                if emitDiagnostics
                    alert(diagnosticPayload(setupEvent, zone), alert.freq_once_per_bar_close)
            array.set(zones, index, zone)

    int direction = candleDirection(0)
    if direction == 1
        if demandCandidate.isActive
            bool confirmed = demandCandidate.advance(true)
            if confirmed
                string formation = candidateFormation(demandCandidate, true)
                if str.length(formation) == 0
                    lastDecision := REJECT_UNKNOWN_APPROACH
                else
                    RawZone zone = buildConfirmedZone(demandCandidate, true, nextZoneId, formation)
                    array.unshift(zones, zone)
                    nextZoneId += 1
                    confirmedEvent := true
                    eventZone := zone
                    lastDecision := CONFIRM_CLOSE_BEYOND_ORIGIN
                demandCandidate.reset()
        bool rebasedSupply = supplyCandidate.rebaseInsideFormation()
        if not rebasedSupply
            if supplyCandidate.isActive and supplyCandidate.isForming
                lastDecision := REJECT_FORMATION_INTERRUPTED
            supplyCandidate.reset()
            supplyCandidate.begin()
    else if direction == -1
        if supplyCandidate.isActive
            bool confirmed = supplyCandidate.advance(false)
            if confirmed
                string formation = candidateFormation(supplyCandidate, false)
                if str.length(formation) == 0
                    lastDecision := REJECT_UNKNOWN_APPROACH
                else
                    RawZone zone = buildConfirmedZone(supplyCandidate, false, nextZoneId, formation)
                    array.unshift(zones, zone)
                    nextZoneId += 1
                    confirmedEvent := true
                    eventZone := zone
                    lastDecision := CONFIRM_CLOSE_BEYOND_ORIGIN
                supplyCandidate.reset()
        bool rebasedDemand = demandCandidate.rebaseInsideFormation()
        if not rebasedDemand
            if demandCandidate.isActive and demandCandidate.isForming
                lastDecision := REJECT_FORMATION_INTERRUPTED
            demandCandidate.reset()
            demandCandidate.begin()
    else
        if demandCandidate.isActive and demandCandidate.isForming
            lastDecision := REJECT_FORMATION_INTERRUPTED
        if supplyCandidate.isActive and supplyCandidate.isForming
            lastDecision := REJECT_FORMATION_INTERRUPTED
        demandCandidate.reset()
        supplyCandidate.reset()

    while array.size(zones) > maxZones
        RawZone oldest = array.pop(zones)
        deleteZone(oldest)

    if confirmedEvent and emitDiagnostics and not na(eventZone)
        alert(diagnosticPayload("ZONE_CONFIRMED_NON_EXECUTABLE", eventZone), alert.freq_once_per_bar_close)

int drawCount = array.size(zones)
if drawCount > 0
    for index = 0 to drawCount - 1
        RawZone zone = array.get(zones, index)
        updateZoneDrawing(zone, zones)
        array.set(zones, index, zone)

var table statusTable = table.new(position.top_right, 1, 2, border_width = 1)
if barstate.islast
    table.cell(statusTable, 0, 0, isFiveMinute ? "SND RD 5M V1 LAB - " + str.upper(displayMode) : "5m chart required", text_color = color.white, bgcolor = isFiveMinute ? color.new(color.teal, 25) : color.new(color.red, 15))
    table.cell(statusTable, 0, 1, lastDecision, text_color = color.white, bgcolor = color.new(color.black, 15), text_size = size.tiny)
