    bool demand
    int originBar
    int originTime
    int createdBar
    int confirmationBar
    int invalidationStartBar
    int eventId
    string model
    int legCandles
    float top
    float bottom
    bool active
    bool leftZone
    bool runtimeLeftZoneAfterConfirmation
    bool liquidityLinked
    bool liquiditySwept
    bool targetSwept
    bool targetFromOneCandle
    bool touched
    string inactiveReason
    string lastInvalidationCheckReason
    float liqLowPrice
    int liqLowBar
    float liqHighPrice
    int liqHighBar
    float liquidityPrice
    int liquidityBarIndex
    int liquiditySweepBar
    int targetSweepBar
    int liquidityLineSweepBar
    int zoneMitigationBar
    int zoneDisplayStopBar
    box zoneBox
    line liquidityLine
    line targetLine
    bool liquidityValid
    int liquidityCandleCount
    float structureSweepLevel
    int structureSweepLevelBar
