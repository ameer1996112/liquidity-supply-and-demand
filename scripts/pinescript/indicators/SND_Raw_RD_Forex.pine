indicator("SND Raw RD Forex", shorttitle = "SND RD FX", overlay = true, max_bars_back = 1000, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 300)

// Raw RD Forex S/D detector only. Backend owns post-processing and execution.
// Fixed runtime profile: preserves prior input defaults without exposing settings.

