    string liquidityDecisionReason
    string liquidityRejectedReason
    int liquidityRejectedBar
    float liquidityRejectedPrice
    label liquidityCompareLabel

var RawZone[] zones = array.new<RawZone>()
var int nextZoneId = 1

const int MAX_LIQ_SCAN_BARS = liquiditySearchBars
liq_candle_count_max = 10
use_inducement_linking = true

// === CUSTOM PIVOTS & LOCAL PIVOT ARRAYS FOR STRATEGY PORTED LIQUIDITY ===
f_is_fractal_low_custom(len) =>
    bool enoughBars = len >= 1 and bar_index >= len * 2
    bool cond = true
    if enoughBars
        float centerLow = low[len]
        if low[len - 1] <= centerLow or low[len + 1] <= centerLow
            cond := false
        else
            for i = 0 to len * 2
                if low[i] < centerLow
                    cond := false
                    break
    enoughBars and cond

f_is_fractal_high_custom(len) =>
    bool enoughBars = len >= 1 and bar_index >= len * 2
    bool cond = true
    if enoughBars
        float centerHigh = high[len]
        if high[len - 1] >= centerHigh or high[len + 1] >= centerHigh
            cond := false
        else
            for i = 0 to len * 2
                if high[i] > centerHigh
                    cond := false
                    break
    enoughBars and cond

is_fractal_low_custom = f_is_fractal_low_custom(pivotLen)
is_fractal_high_custom = f_is_fractal_high_custom(pivotLen)

pLowSeries = is_fractal_low_custom ? low[pivotLen] : na
pHighSeries = is_fractal_high_custom ? high[pivotLen] : na

var array<float> liqPvtHighPrices = array.new_float()
var array<int>   liqPvtHighBars   = array.new_int()
var array<float> liqPvtLowPrices  = array.new_float()
var array<int>   liqPvtLowBars    = array.new_int()
var array<line> referenceLiquidityLines = array.new<line>()
var array<float> referenceLiquidityPrices = array.new_float()
var array<int> referenceLiquidityBars = array.new_int()
var array<bool> referenceLiquidityDemand = array.new_bool()
var array<bool> referenceLiquiditySwept = array.new_bool()
var table liquidityDebugTable = na

bool isPvtLow  = low[2] > low[1] and low[1] < low[0]
bool isPvtHigh = high[2] < high[1] and high[1] > high[0]

if isPvtLow
    array.push(liqPvtLowPrices, low[1])
    array.push(liqPvtLowBars, bar_index - 1)

if isPvtHigh
    array.push(liqPvtHighPrices, high[1])
    array.push(liqPvtHighBars, bar_index - 1)

while array.size(liqPvtHighPrices) > pvtMax
    array.shift(liqPvtHighPrices)
    array.shift(liqPvtHighBars)
while array.size(liqPvtLowPrices) > pvtMax
    array.shift(liqPvtLowPrices)
    array.shift(liqPvtLowBars)

firstZoneLifecycleStopBar(RawZone z) =>
    int result = na
    int startBar = z.originBar
    int startOffset = bar_index - startBar
    if not na(startBar) and startOffset > 0
        int leftSeenBar = na
        for span = 0 to startOffset
            int offset = startOffset - span
            int candidateBar = bar_index - offset
            bool leaves = z.demand ? high[offset] > z.top : low[offset] < z.bottom
            bool overlaps = high[offset] >= z.bottom and low[offset] <= z.top
            bool breaksZone = z.demand ? low[offset] < z.bottom : high[offset] > z.top
            if na(leftSeenBar) and leaves
                leftSeenBar := candidateBar
            if not na(leftSeenBar) and candidateBar > leftSeenBar and (overlaps or breaksZone)
                result := candidateBar
                break
    result

zoneRightBar(RawZone z) =>
    not na(z.zoneMitigationBar) ? z.zoneMitigationBar : not na(z.zoneDisplayStopBar) ? z.zoneDisplayStopBar : projectedRightBar()

liquidityLineRightBar(RawZone z) =>
    not na(z.liquidityLineSweepBar) ? z.liquidityLineSweepBar + 1 : projectedRightBar()

sweptTargetLineRightBar(RawZone z) =>
    z.targetSwept and not na(z.targetSweepBar) ? z.targetSweepBar + 1 : projectedRightBar()

accSuppressedSymbol() =>
    string tickerUpper = str.upper(syminfo.ticker)
    str.contains(tickerUpper, "XAU") or str.contains(tickerUpper, "XAG") or str.contains(tickerUpper, "XPT") or str.contains(tickerUpper, "XPD")

accuracyBoundsAllowed() =>
    useAccuracyBounds and not accSuppressedSymbol()

formationRetouchRejectAllowed() =>
    rejectFormationRetouch and not accSuppressedSymbol()

isBullish(int offset) =>
    close[offset] >= open[offset]

isBearish(int offset) =>
    close[offset] <= open[offset]

baseNestedInsidePriorSameSide(int offset, bool demand) =>
    bool nested = false
    int priorOffset = offset + 1
    if priorOffset <= bar_index
        bool priorSameSide = demand ? isBearish(priorOffset) : isBullish(priorOffset)
        bool insidePriorRange = high[offset] <= high[priorOffset] + syminfo.mintick * 0.5 and low[offset] >= low[priorOffset] - syminfo.mintick * 0.5
        nested := priorSameSide and insidePriorRange
    nested

isValidBase(int offset, bool demand) =>
    bool baseSide = demand ? isBearish(offset) : isBullish(offset)
    baseSide

is1605DebugCandidate(int offset) =>
    offset >= 0 and offset <= bar_index and hour(time[offset], "GMT+3") == 16 and minute(time[offset], "GMT+3") == 5

drawZoneCandidateDebug(int candidateBaseIdx, bool demand, bool validBase, bool candidateValid, string rejectReason, int confirmationIdx, string source) =>
    if showZoneDebug and not demand and is1605DebugCandidate(candidateBaseIdx)
        float bodySize = math.abs(close[candidateBaseIdx] - open[candidateBaseIdx])
        float upperWick = high[candidateBaseIdx] - math.max(open[candidateBaseIdx], close[candidateBaseIdx])
        float lowerWick = math.min(open[candidateBaseIdx], close[candidateBaseIdx]) - low[candidateBaseIdx]
        string resultText = candidateValid ? "ACCEPTED" : "REJECTED " + rejectReason
        string debugText = "16:05 S " + source + "\n" + resultText + "\nbar " + str.tostring(bar_index - candidateBaseIdx) + " off " + str.tostring(candidateBaseIdx) + "\no " + str.tostring(open[candidateBaseIdx]) + " h " + str.tostring(high[candidateBaseIdx]) + " l " + str.tostring(low[candidateBaseIdx]) + " c " + str.tostring(close[candidateBaseIdx]) + "\nbody " + str.tostring(bodySize) + " uw " + str.tostring(upperWick) + " lw " + str.tostring(lowerWick) + "\nbase " + str.tostring(validBase) + " confirm " + str.tostring(confirmationIdx)
        label.new(bar_index - candidateBaseIdx, high[candidateBaseIdx], debugText, xloc = xloc.bar_index, style = label.style_label_down, color = candidateValid ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)

nestedBaseHasConfirmationWickExpansion(int baseIdx, bool demand, int confirmationIdx) =>
    bool expanded = false
    if baseIdx >= 0 and confirmationIdx >= 0 and baseIdx <= bar_index and confirmationIdx <= bar_index
        expanded := demand ? low[confirmationIdx] < low[baseIdx] - syminfo.mintick * 0.5 : high[confirmationIdx] > high[baseIdx] + syminfo.mintick * 0.5
    expanded

standardZoneBounds(int baseIdx, bool demand) =>
    float top = high[baseIdx]
    float bottom = low[baseIdx]
    [top, bottom]

accBoundsWithDepartureWick(int baseIdx, bool demand, int legCandles) =>
    float bodyHigh = math.max(open[baseIdx], close[baseIdx])
    float bodyLow = math.min(open[baseIdx], close[baseIdx])
    float top = demand ? high[baseIdx] : bodyLow
    float bottom = demand ? bodyHigh : low[baseIdx]
    [top, bottom]

accPrecisionBounds(int baseIdx, bool demand) =>
    float bodyHigh = math.max(open[baseIdx], close[baseIdx])
    float bodyLow = math.min(open[baseIdx], close[baseIdx])
    float top = demand ? high[baseIdx] : bodyLow
    float bottom = demand ? bodyHigh : low[baseIdx]
    [top, bottom]

isValidAccModel(int baseIdx, bool demand, int legCandles) =>
    bool valid = false
    int departureIdx = baseIdx - 1
    if accuracyBoundsAllowed() and departureIdx >= 0
        bool validOrigin = demand ? isBearish(baseIdx) : isBullish(baseIdx)
        float stdTop = high[baseIdx]
        float stdBottom = low[baseIdx]
        float stdSize = stdTop - stdBottom
        bool rightDeparture = demand ? isBullish(departureIdx) : isBearish(departureIdx)
        bool accPrecision = rightDeparture and (demand ? high[baseIdx] > high[departureIdx] + syminfo.mintick * 0.5 : low[baseIdx] < low[departureIdx] - syminfo.mintick * 0.5)
        [accTop, accBottom] = accPrecisionBounds(baseIdx, demand)
        float accSize = accTop - accBottom
        bool accIsSmaller = stdSize > 0 and accSize > 0 and accSize < stdSize - syminfo.mintick * 0.5
        valid := validOrigin and rightDeparture and accPrecision and accIsSmaller
    valid

isAccModel(int baseIdx, bool demand, int legCandles) =>
    isValidAccModel(baseIdx, demand, legCandles)

accZoneBounds(int baseIdx, bool demand, int legCandles) =>
    [top, bottom] = accBoundsWithDepartureWick(baseIdx, demand, legCandles)
    [top, bottom]

isAccZoneModel(string model) =>
    model == MODEL_ACC or model == MODEL_ACC_STANDARD or model == MODEL_ACC_CONTINUATION

isContinuationZoneModel(string model) =>
    model == MODEL_CONTINUATION or model == MODEL_ACC_CONTINUATION

sameModelFamily(string modelA, string modelB) =>
    bool standardFamilyA = modelA == MODEL_STANDARD or modelA == MODEL_ACC_STANDARD or modelA == MODEL_ACC
    bool standardFamilyB = modelB == MODEL_STANDARD or modelB == MODEL_ACC_STANDARD or modelB == MODEL_ACC
    bool continuationFamilyA = modelA == MODEL_CONTINUATION or modelA == MODEL_ACC_CONTINUATION
    bool continuationFamilyB = modelB == MODEL_CONTINUATION or modelB == MODEL_ACC_CONTINUATION
    (standardFamilyA and standardFamilyB) or (continuationFamilyA and continuationFamilyB)

resolveFinalModel(int baseIdx, bool demand, string requestedModel, int legCandles) =>
    string resolvedModel = requestedModel
    bool validAcc = accuracyBoundsAllowed() and isValidAccModel(baseIdx, demand, legCandles)
    bool continuationRequest = requestedModel == MODEL_CONTINUATION or requestedModel == MODEL_ACC_CONTINUATION
    if not accuracyBoundsAllowed() and isAccZoneModel(requestedModel)
        resolvedModel := continuationRequest ? MODEL_CONTINUATION : MODEL_STANDARD
    else if validAcc
        resolvedModel := continuationRequest ? MODEL_ACC_CONTINUATION : MODEL_ACC_STANDARD
    else if requestedModel == MODEL_ACC_CONTINUATION
        resolvedModel := MODEL_CONTINUATION
    else if requestedModel == MODEL_ACC_STANDARD or requestedModel == MODEL_ACC
        resolvedModel := MODEL_STANDARD
    resolvedModel

extendFormationWickBounds(int baseIdx, bool demand, int legCandles, bool includeFormationWicks, float top, float bottom) =>
    float extendedTop = top
    float extendedBottom = bottom
    if includeFormationWicks and legCandles > 0
        int scanCount = math.min(legCandles, formationLegScanBars)
        scanCount := math.min(scanCount, baseIdx)
        if scanCount > 0
            for scan = 1 to scanCount
                int off = baseIdx - scan
                if off < 0
                    break
                if demand
                    extendedBottom := math.min(extendedBottom, low[off])
                else
                    extendedTop := math.max(extendedTop, high[off])
    [extendedTop, extendedBottom]

zoneBoundsForModel(int baseIdx, bool demand, int legCandles, string model) =>
    float top = na
    float bottom = na
    if isAccZoneModel(model)
        [accTop, accBottom] = accZoneBounds(baseIdx, demand, legCandles)
        top := accTop
        bottom := accBottom
    else
        [standardTop, standardBottom] = standardZoneBounds(baseIdx, demand)
        top := standardTop
        bottom := standardBottom
    [top, bottom]

zoneBoundsForFinalModel(int baseIdx, bool demand, int legCandles, string model) =>
    float finalTop = na
    float finalBottom = na
    if isAccZoneModel(model)
        [accTop, accBottom] = accZoneBounds(baseIdx, demand, legCandles)
        [extendedAccTop, extendedAccBottom] = extendFormationWickBounds(baseIdx, demand, legCandles, true, accTop, accBottom)
        finalTop := extendedAccTop
        finalBottom := extendedAccBottom
    else
        [top, bottom] = zoneBoundsForModel(baseIdx, demand, legCandles, model)
        bool suppressSupplyFormationWicks = not demand and accSuppressedSymbol()
        if suppressSupplyFormationWicks
            int departureIdx = baseIdx - 1
            bool departureBearishWickAboveOrigin = departureIdx >= 0 and isBearish(departureIdx) and high[departureIdx] > top
            finalTop := departureBearishWickAboveOrigin ? high[departureIdx] : top
            finalBottom := bottom
        else
            [extendedTop, extendedBottom] = extendFormationWickBounds(baseIdx, demand, legCandles, true, top, bottom)
            finalTop := extendedTop
            finalBottom := extendedBottom
    [finalTop, finalBottom]

zoneBounds(int baseIdx, bool demand, int legCandles, bool includeFormationWicks) =>
    [top, bottom] = standardZoneBounds(baseIdx, demand)
    [extendedTop, extendedBottom] = extendFormationWickBounds(baseIdx, demand, legCandles, includeFormationWicks, top, bottom)
    [extendedTop, extendedBottom]

num(float value) =>
    na(value) ? "null" : str.tostring(value, format.mintick)

intNum(int value) =>
    na(value) ? "null" : str.tostring(value)

boolText(bool value) =>
    value ? "true" : "false"

liquiditySourceDisplay(string liqSource) =>
    liqSource == "ZONE_TOUCH_SWEEP" ? "TOUCH_SWEEP" : (liqSource == "LOCAL" ? "LOCAL" : "PIVOT")

liquidityDistanceFromZoneValue(RawZone z, float price) =>
    na(price) ? na : (z.demand ? math.max(0.0, price - z.top) : math.max(0.0, z.top - price))

clearLiquidityDebugState(RawZone z) =>
    RawZone out = z
    out.liquidityDistanceFromZone := na
    out.liquidityDecisionReason := ""
    out.liquidityRejectedReason := ""
    out.liquidityRejectedBar := na
    out.liquidityRejectedPrice := na
    out

recordRejectedLiquidityCandidate(RawZone z, int candidateBar, float candidatePrice, string reason) =>
    RawZone out = z
    out.liquidityRejectedReason := reason
    out.liquidityRejectedBar := candidateBar
    out.liquidityRejectedPrice := candidatePrice
    out

originHighValue(RawZone z) =>
    int originOffset = bar_index - z.originBar
    originOffset >= 0 and originOffset <= bar_index ? high[originOffset] : na

originLowValue(RawZone z) =>
    int originOffset = bar_index - z.originBar
    originOffset >= 0 and originOffset <= bar_index ? low[originOffset] : na

referenceLiquidityCanSeedZone(RawZone z, int candidateBar, bool swept) =>
    bool inOriginFormationWindow = not na(candidateBar) and not na(z.originBar) and not na(z.createdBar) and candidateBar >= z.originBar - formationLegScanBars and candidateBar <= z.createdBar
    not swept or inOriginFormationWindow

demandOriginHighReferenceLiquidity(RawZone z) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 1.0e10
    float originHigh = originHighValue(z)
    float tol = syminfo.mintick * equalLiquidityToleranceTicks
    float maxDistPrice = na
    int count = array.size(referenceLiquidityPrices)
    if z.active and z.demand and not na(originHigh) and count > 0
        for refIdx = 0 to count - 1
            float refPrice = array.get(referenceLiquidityPrices, refIdx)
            int refBar = array.get(referenceLiquidityBars, refIdx)
            bool refIsDemand = array.get(referenceLiquidityDemand, refIdx)
            bool refSwept = array.get(referenceLiquiditySwept, refIdx)
            bool inOriginWindow = not na(refBar) and refBar >= z.originBar - formationLegScanBars and refBar <= z.createdBar
            bool refCanSeed = referenceLiquidityCanSeedZone(z, refBar, refSwept)
            bool priceAboveOrigin = not na(refPrice) and refPrice >= originHigh - tol
            if not refIsDemand and refCanSeed and inOriginWindow and priceAboveOrigin
                float dist = math.max(0.0, refPrice - originHigh)
                bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or dist <= maxDistPrice
                bool isCloser = dist < bestDist
                bool isSameDistance = dist == bestDist
                bool isMoreRecent = na(bestBar) or refBar > bestBar
                if distOK and (na(bestBar) or isCloser or (isSameDistance and isMoreRecent))
                    bestDist := dist
                    bestPrice := refPrice
                    bestBar := refBar
    [bestPrice, bestBar, bestDist]

demandOwnOriginLiquidity(RawZone z) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 0.0
    float tol = syminfo.mintick * math.max(equalLiquidityToleranceTicks, 1)
    int referenceCount = array.size(referenceLiquidityPrices)
    if z.active and z.demand
        if referenceCount > 0
            for refIdx = 0 to referenceCount - 1
                float refPrice = array.get(referenceLiquidityPrices, refIdx)
                int refBar = array.get(referenceLiquidityBars, refIdx)
                bool refIsDemand = array.get(referenceLiquidityDemand, refIdx)
                bool refSwept = array.get(referenceLiquiditySwept, refIdx)
                bool refCanSeed = referenceLiquidityCanSeedZone(z, refBar, refSwept)
                bool ownOriginRef = not na(z.originBar) and refBar == z.originBar and not na(refPrice) and math.abs(refPrice - z.bottom) <= tol
                if refIsDemand and refCanSeed and ownOriginRef
                    bestPrice := refPrice
                    bestBar := refBar
        int localPivotCount = array.size(liqPvtLowPrices)
        if localPivotCount > 0
            for pivotIdx = 0 to localPivotCount - 1
                float pLow = array.get(liqPvtLowPrices, pivotIdx)
                int pBar = array.get(liqPvtLowBars, pivotIdx)
                bool ownOriginLocal = not na(z.originBar) and pBar == z.originBar and not na(pLow) and math.abs(pLow - z.bottom) <= tol
                if ownOriginLocal
                    bestPrice := pLow
                    bestBar := pBar
    [bestPrice, bestBar, bestDist]

supplyOwnOriginLiquidity(RawZone z) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 0.0
    float originHigh = originHighValue(z)
    float tol = syminfo.mintick * math.max(equalLiquidityToleranceTicks, 1)
    int referenceCount = array.size(referenceLiquidityPrices)
    if z.active and not z.demand
        if not na(z.originBar) and not na(originHigh) and originHigh <= z.top + tol and originHigh >= z.bottom - tol
            bestPrice := originHigh
            bestBar := z.originBar
        if referenceCount > 0
            for refIdx = 0 to referenceCount - 1
                float refPrice = array.get(referenceLiquidityPrices, refIdx)
                int refBar = array.get(referenceLiquidityBars, refIdx)
                bool refIsDemand = array.get(referenceLiquidityDemand, refIdx)
                bool refSwept = array.get(referenceLiquiditySwept, refIdx)
                bool refCanSeed = referenceLiquidityCanSeedZone(z, refBar, refSwept)
                bool ownOriginRef = not na(z.originBar) and refBar == z.originBar and not na(refPrice) and math.abs(refPrice - z.top) <= tol
                if not refIsDemand and refCanSeed and ownOriginRef
                    bestPrice := refPrice
                    bestBar := refBar
        int localPivotCount = array.size(liqPvtHighPrices)
        if localPivotCount > 0
            for pivotIdx = 0 to localPivotCount - 1
                float pHigh = array.get(liqPvtHighPrices, pivotIdx)
                int pBar = array.get(liqPvtHighBars, pivotIdx)
                bool ownOriginLocal = not na(z.originBar) and pBar == z.originBar and not na(pHigh) and math.abs(pHigh - z.top) <= tol
                if ownOriginLocal
                    bestPrice := pHigh
                    bestBar := pBar
    [bestPrice, bestBar, bestDist]

liquidityCompareText(RawZone z) =>
    string distanceText = na(z.liquidityDistanceFromZone) ? "na" : str.tostring(z.liquidityDistanceFromZone / pip_size, "#.##")
    string selectedReason = str.length(z.liquidityDecisionReason) > 0 ? z.liquidityDecisionReason : "WAITING"
    string rejectedText = (showRejectedLiquidityCandidates or showLiqDebug) and str.length(z.liquidityRejectedReason) > 0 ? "\nrej " + z.liquidityRejectedReason + " @" + num(z.liquidityRejectedPrice) + " b" + intNum(z.liquidityRejectedBar) : ""
    string debugText = showLiqDebug ? "\norigin t" + intNum(z.originTime) + " b" + intNum(z.originBar) + " h" + num(originHighValue(z)) + " l" + num(originLowValue(z)) + "\nzoneTop " + num(z.top) + " line " + num(z.liquidityPrice) + " x1 " + intNum(z.liquidityBarIndex) + " x2 " + intNum(liquidityLineRightBar(z)) : ""
    "Z" + str.tostring(z.id) + " " + (z.demand ? "D" : "S") + " " + liquiditySourceDisplay(z.liqSource) +
     "\nliq " + num(z.liquidityPrice) + " b" + intNum(z.liquidityBarIndex) +
     "\ndist " + distanceText + "p " + selectedReason +
     "\nsweep " + intNum(z.liquiditySweepBar) + " tgt " + intNum(z.targetSweepBar) + rejectedText + debugText

updateLiquidityCompareLabel(RawZone z) =>
    bool showLabel = (showLiquidityCompareLabels or showLiqDebug or showInactiveZoneDebug) and (z.active or showInactiveZoneDebug) and (showLiqDebug or showInactiveZoneDebug or (not na(z.liquidityPrice) and not na(z.liquidityBarIndex)))
    if not showLabel
        if not na(z.liquidityCompareLabel)
            label.delete(z.liquidityCompareLabel)
            z.liquidityCompareLabel := na
    else
        int linkedBar = z.demand ? z.liqLowBar : z.liqHighBar
        float linkedPrice = z.demand ? z.liqLowPrice : z.liqHighPrice
        int labelBar = not na(linkedBar) ? linkedBar : z.liquidityBarIndex
        float labelPrice = not na(linkedPrice) ? linkedPrice : z.liquidityPrice
        if not na(labelBar) and not na(labelPrice)
            labelStyle = z.demand ? label.style_label_up : label.style_label_down
            if na(z.liquidityCompareLabel)
                z.liquidityCompareLabel := label.new(labelBar, labelPrice, liquidityCompareText(z), xloc = xloc.bar_index, style = labelStyle, textcolor = color.white, color = color.new(color.black, 20), size = size.tiny)
            else
                label.set_x(z.liquidityCompareLabel, labelBar)
                label.set_y(z.liquidityCompareLabel, labelPrice)
                label.set_text(z.liquidityCompareLabel, liquidityCompareText(z))
                label.set_style(z.liquidityCompareLabel, labelStyle)
                label.set_color(z.liquidityCompareLabel, color.new(color.black, 20))
                label.set_textcolor(z.liquidityCompareLabel, color.white)
    true

updateLiquidityDebugTable(table tbl) =>
    table result = tbl
    int tableRows = 7
    if showLiquidityDebugTable
        if na(result)
            result := table.new(position.bottom_right, 2, tableRows, bgcolor = color.new(color.black, 10), border_width = 1, border_color = color.new(color.white, 70))
        table.cell(result, 0, 0, "Zone", text_color = color.white, bgcolor = color.new(color.gray, 70), text_size = size.tiny)
        table.cell(result, 1, 0, "Liquidity Debug", text_color = color.white, bgcolor = color.new(color.gray, 70), text_size = size.tiny)
        int row = 1
        int zoneCount = array.size(zones)
        if zoneCount > 0
            for i = 0 to zoneCount - 1
                if row >= tableRows
                    break
                RawZone z = array.get(zones, i)
                bool showRow = z.active or not na(z.liquidityPrice) or str.length(z.liquidityRejectedReason) > 0
                if showRow
                    table.cell(result, 0, row, str.tostring(z.id), text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)
                    table.cell(result, 1, row, liquidityCompareText(z), text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)
                    row += 1
        while row < tableRows
            table.cell(result, 0, row, "", bgcolor = color.new(color.black, 0))
            table.cell(result, 1, row, "", bgcolor = color.new(color.black, 0))
            row += 1
    else if not na(result)
        for row = 0 to tableRows - 1
            table.cell(result, 0, row, "", bgcolor = color.new(color.black, 100))
            table.cell(result, 1, row, "", bgcolor = color.new(color.black, 100))
    result

isContinuationZone(int baseIdx, bool demand) =>
    bool result = false
    if enableContinuationZones and baseIdx >= 1 and baseIdx + 1 <= bar_index
        float baseRange = high[baseIdx] - low[baseIdx]
        float baseBody = math.abs(close[baseIdx] - open[baseIdx])
        bool compactBase = baseRange > syminfo.mintick and baseRange <= atr14 * 1.8 and baseBody <= baseRange * 0.65
        bool validBaseSide = demand ? isBearish(baseIdx) : isBullish(baseIdx)
        bool continuationApproach = demand ? isBullish(baseIdx + 1) : isBearish(baseIdx + 1)
        bool reversalApproach = demand ? isBearish(baseIdx + 1) : isBullish(baseIdx + 1)
        bool confirmsAway = false
        for confirmScan = 1 to formationLegScanBars
            int confirmIdx = baseIdx - confirmScan
            if confirmIdx < 0
                break
            bool confirmCandle = demand ? isBullish(confirmIdx) and close[confirmIdx] > high[baseIdx] : isBearish(confirmIdx) and close[confirmIdx] < low[baseIdx]
            if confirmCandle
                confirmsAway := true
                break
        float priorBodyEdge = demand ? math.min(open[baseIdx + 1], close[baseIdx + 1]) : math.max(open[baseIdx + 1], close[baseIdx + 1])
        bool shallowPullback = demand ? low[baseIdx] >= priorBodyEdge - atr14 * 0.25 : high[baseIdx] <= priorBodyEdge + atr14 * 0.25
        bool reversalExtreme = demand ? low[baseIdx] <= low[baseIdx + 1] + atr14 * 0.25 : high[baseIdx] >= high[baseIdx + 1] - atr14 * 0.25
        bool validApproach = (continuationApproach and shallowPullback) or (reversalApproach and reversalExtreme)
        float confirmBaseRange = high[baseIdx] - low[baseIdx]
        float displacementBody = math.abs(close - open)
        bool currentDirectional = demand ? isBullish(0) : isBearish(0)
        bool currentBreaksOrigin = demand ? (close > high[baseIdx] or high > high[baseIdx]) : (close < low[baseIdx] or low < low[baseIdx])
        float closeExtension = demand ? close - high[baseIdx] : low[baseIdx] - close
        float wickExtension = demand ? high - high[baseIdx] : low[baseIdx] - low
        bool extensionOk = closeExtension >= atr14 * 0.10 or wickExtension >= atr14 * 0.20
        bool bodyAtrOk = displacementBody >= atr14 * 0.20
        bool bodyVsBaseOk = confirmBaseRange <= 0 ? true : displacementBody >= confirmBaseRange * 0.50
        bool currentConfirmsAway = currentDirectional and currentBreaksOrigin and extensionOk and bodyAtrOk and bodyVsBaseOk
        result := compactBase and validBaseSide and validApproach and confirmsAway and currentConfirmsAway
    result

displacement_leg_confirmed(int displacementIdx, int baseIdx, bool demand) =>
    bool confirmed = false
    if displacementIdx >= 0 and baseIdx >= 0 and displacementIdx <= bar_index and baseIdx <= bar_index
        float baseBody = math.abs(close[baseIdx] - open[baseIdx])
        float displacementBody = math.abs(close[displacementIdx] - open[displacementIdx])
        bool directionalCandle = demand ? isBullish(displacementIdx) : isBearish(displacementIdx)
        bool breaksOrigin = demand ? (close[displacementIdx] > high[baseIdx] or high[displacementIdx] > high[baseIdx]) : (close[displacementIdx] < low[baseIdx] or low[displacementIdx] < low[baseIdx])
        float closeExtension = demand ? close[displacementIdx] - high[baseIdx] : low[baseIdx] - close[displacementIdx]
        float wickExtension = demand ? high[displacementIdx] - high[baseIdx] : low[baseIdx] - low[displacementIdx]
        bool extensionOk = closeExtension >= atr14 * 0.10 or wickExtension >= atr14 * 0.20
        bool bodyAtrOk = displacementBody >= atr14 * 0.20
        bool bodyVsBaseOk = baseBody <= syminfo.mintick ? true : displacementBody >= baseBody * 0.50
        confirmed := directionalCandle and breaksOrigin and extensionOk and bodyAtrOk and bodyVsBaseOk
    confirmed

acc_displacement_leg_confirmed(int displacementIdx, int baseIdx, bool demand, int legCandles) =>
    bool confirmed = false
    if displacementIdx >= 0 and baseIdx >= 0 and displacementIdx <= bar_index and baseIdx <= bar_index and isValidAccModel(baseIdx, demand, legCandles)
        [accTop, accBottom] = accPrecisionBounds(baseIdx, demand)
        float baseBody = math.abs(close[baseIdx] - open[baseIdx])
        float displacementBody = math.abs(close[displacementIdx] - open[displacementIdx])
        bool directionalCandle = demand ? isBullish(displacementIdx) : isBearish(displacementIdx)
        bool closesBeyondAccBody = demand ? close[displacementIdx] > accTop : close[displacementIdx] < accBottom
        float closeExtension = demand ? close[displacementIdx] - accTop : accBottom - close[displacementIdx]
        bool extensionOk = closeExtension >= syminfo.mintick * 0.5
        bool bodyAtrOk = displacementBody >= atr14 * 0.20
        bool bodyVsBaseOk = baseBody <= syminfo.mintick ? true : displacementBody >= baseBody * 0.50
        confirmed := directionalCandle and closesBeyondAccBody and extensionOk and bodyAtrOk and bodyVsBaseOk
    confirmed

formation_leg_retouches_zone_after_leave(int baseIdx, bool demand, int startOffset) =>
    [top, bottom] = zoneBounds(baseIdx, demand, 0, false)
    bool leftZone = false
    bool retouched = false
    int legSpan = baseIdx - startOffset
    if legSpan > 0
        for walk = 0 to legSpan - 1
            int off = baseIdx - 1 - walk
            if off < startOffset
                break
            if retouched
                break

            bool sameSideCandle = demand ? isBearish(off) : isBullish(off)
            float bodyHigh = math.max(open[off], close[off])
            float bodyLow = math.min(open[off], close[off])
            bool bodyOverlapsZone = bodyHigh >= bottom and bodyLow <= top
            bool closeInsideZone = close[off] <= top and close[off] >= bottom
            if sameSideCandle and closeInsideZone and bodyOverlapsZone
                retouched := true
                break

            if not leftZone
                bool directionalDeparture = demand ? isBullish(off) : isBearish(off)
                bool movedAwayFromZone = demand ? high[off] > top : low[off] < bottom
                leftZone := directionalDeparture and movedAwayFromZone
            else
                bool oppositeCandle = demand ? isBearish(off) : isBullish(off)
                if oppositeCandle and closeInsideZone and bodyOverlapsZone
                    retouched := true
    retouched

findDisplacementBase(bool demand, int startOffset, int maxLegBars) =>
    int baseIdx = na
    int legCount = 0
    int rejectIdx = na
    string rejectReason = ""
    bool displacementEvent = demand ? isBullish(startOffset) : isBearish(startOffset)
    if displacementEvent
        for scan = 1 to maxLegBars
            int candidateBaseIdx = startOffset + scan
            if candidateBaseIdx >= bar_index
                break

            if isValidBase(candidateBaseIdx, demand)
                int directionalCount = 0
                for legOffset = startOffset to candidateBaseIdx - 1
                    bool directionalCandle = demand ? isBullish(legOffset) : isBearish(legOffset)
                    if directionalCandle
                        directionalCount += 1

                bool hasConfirmedDisplacement = displacement_leg_confirmed(startOffset, candidateBaseIdx, demand)
                if directionalCount == 0
                    if na(rejectIdx)
                        rejectIdx := candidateBaseIdx
                        rejectReason := REJECT_NO_DISPLACEMENT
                else if not hasConfirmedDisplacement
                    if na(rejectIdx)
                        rejectIdx := candidateBaseIdx
                        rejectReason := REJECT_WEAK_DISPLACEMENT
                else if formationRetouchRejectAllowed() and formation_leg_retouches_zone_after_leave(candidateBaseIdx, demand, startOffset)
                    if na(rejectIdx)
                        rejectIdx := candidateBaseIdx
                        rejectReason := REJECT_FORMATION_RETOUCHED
                else
                    baseIdx := candidateBaseIdx
                    legCount := directionalCount
                    break
    [baseIdx, legCount, rejectIdx, rejectReason]

payload(string eventName, RawZone z) =>
    "{" +
     "\"event\":\"" + eventName + "\"," +
     "\"symbol\":\"" + syminfo.ticker + "\"," +
     "\"time\":" + str.tostring(time_close) + "," +
     "\"bar_index\":" + str.tostring(bar_index) + "," +
     "\"zone_id\":" + str.tostring(z.id) + "," +
     "\"zone_type\":\"" + (z.demand ? "demand" : "supply") + "\"," +
     "\"origin_bar\":" + str.tostring(z.originBar) + "," +
     "\"origin_time\":" + str.tostring(z.originTime) + "," +
     "\"top\":" + num(z.top) + "," +
     "\"bottom\":" + num(z.bottom) + "," +
     "\"liquidity_price\":" + num(z.liquidityPrice) + "," +
     "\"liquidity_bar_index\":" + intNum(z.liquidityBarIndex) + "," +
     "\"liq_low_price\":" + num(z.liqLowPrice) + "," +
     "\"liq_low_bar\":" + intNum(z.liqLowBar) + "," +
     "\"liq_high_price\":" + num(z.liqHighPrice) + "," +
     "\"liq_high_bar\":" + intNum(z.liqHighBar) + "," +
     "\"liq_source\":\"" + liquiditySourceDisplay(z.liqSource) + "\"," +
     "\"liq_distance\":" + num(z.liquidityDistanceFromZone) + "," +
     "\"liq_reason\":\"" + z.liquidityDecisionReason + "\"," +
     "\"liquidity_sweep_bar\":" + intNum(z.liquiditySweepBar) + "," +
     "\"target_sweep_bar\":" + intNum(z.targetSweepBar) + "," +
     "\"liquidity_swept\":" + boolText(z.liquiditySwept) + "," +
     "\"target_swept\":" + boolText(z.targetSwept) + "," +
     "\"active\":" + boolText(z.active) +
     "}"

sendEvent(string eventName, RawZone z) =>
    alert(payload(eventName, z), alert.freq_once_per_bar_close)

sameBounds(float topA, float bottomA, float topB, float bottomB) =>
    math.abs(topA - topB) <= syminfo.mintick * 0.5 and math.abs(bottomA - bottomB) <= syminfo.mintick * 0.5

zoneSize(float top, float bottom) =>
    math.max(math.abs(top - bottom), syminfo.mintick)

zoneContained(float innerTop, float innerBottom, float outerTop, float outerBottom) =>
    float innerHigh = math.max(innerTop, innerBottom)
    float innerLow = math.min(innerTop, innerBottom)
    float outerHigh = math.max(outerTop, outerBottom)
    float outerLow = math.min(outerTop, outerBottom)
    innerHigh <= outerHigh + syminfo.mintick * 0.5 and innerLow >= outerLow - syminfo.mintick * 0.5

zoneOverlapPct(float topA, float bottomA, float topB, float bottomB) =>
    float highA = math.max(topA, bottomA)
    float lowA = math.min(topA, bottomA)
    float highB = math.max(topB, bottomB)
    float lowB = math.min(topB, bottomB)
    float overlap = math.max(0.0, math.min(highA, highB) - math.max(lowA, lowB))
    float baseSize = math.min(zoneSize(topA, bottomA), zoneSize(topB, bottomB))
    baseSize > 0 ? overlap / baseSize : 0.0

hasActiveSimilarDemandZone(float top, float bottom) =>
    bool conflict = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            RawZone z = array.get(zones, i)
            if z.active and z.demand
                bool containedEitherWay = zoneContained(top, bottom, z.top, z.bottom) or zoneContained(z.top, z.bottom, top, bottom)
                bool heavyOverlap = zoneOverlapPct(top, bottom, z.top, z.bottom) >= 0.65
                if containedEitherWay or heavyOverlap
                    conflict := true
                    break
    conflict

hasActiveSimilarSupplyZone(float top, float bottom) =>
    bool conflict = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            RawZone z = array.get(zones, i)
            if z.active and not z.demand
                bool containedEitherWay = zoneContained(top, bottom, z.top, z.bottom) or zoneContained(z.top, z.bottom, top, bottom)
                bool heavyOverlap = zoneOverlapPct(top, bottom, z.top, z.bottom) >= 0.65
                if containedEitherWay or heavyOverlap
                    conflict := true
                    break
    conflict

modelPriority(string model) =>
    model == MODEL_STANDARD ? 4 : isAccZoneModel(model) ? 3 : model == MODEL_CONTINUATION ? 2 : 1

preferFirstZone(RawZone first, RawZone other) =>
    bool keepFirst = true
    if first.active != other.active
        keepFirst := first.active
    else
        float firstSize = zoneSize(first.top, first.bottom)
        float otherSize = zoneSize(other.top, other.bottom)
        bool firstAcc = isAccZoneModel(first.model)
        bool otherAcc = isAccZoneModel(other.model)
        bool sameFamily = sameModelFamily(first.model, other.model)
        if sameFamily and firstAcc != otherAcc
            keepFirst := firstAcc
        else if first.originBar != other.originBar
            keepFirst := first.originBar > other.originBar
        else if math.abs(firstSize - otherSize) > syminfo.mintick * 0.5
            keepFirst := firstSize > otherSize
        else
            int firstModelPriority = modelPriority(first.model)
            int otherModelPriority = modelPriority(other.model)
            if firstModelPriority != otherModelPriority
                keepFirst := firstModelPriority > otherModelPriority
            else
                keepFirst := first.id <= other.id
    keepFirst

duplicateRejectReason(float top, float bottom, bool demand, int originBar, string model, int confirmationBar) =>
    string reason = ""
    int sz = array.size(zones)
    if sz > 0
        for i = 0 to sz - 1
            RawZone z = array.get(zones, i)
            if z.active and z.demand == demand
                bool newAcc = isAccZoneModel(model)
                bool oldAcc = isAccZoneModel(z.model)
                bool sameOrigin = z.originBar == originBar
                bool sameFamily = sameModelFamily(z.model, model)
                bool exactDuplicate = sameOrigin and sameBounds(top, bottom, z.top, z.bottom)
                bool accAlreadyExists = sameOrigin and sameFamily and oldAcc and not newAcc
                if exactDuplicate
                    reason := REJECT_EXACT_DUPLICATE
                    break
                if accAlreadyExists
                    reason := REJECT_EXACT_DUPLICATE
                    break
    reason

shouldSkipDuplicate(float top, float bottom, bool demand, int originBar, string model, int confirmationBar) =>
    str.length(duplicateRejectReason(top, bottom, demand, originBar, model, confirmationBar)) > 0

confirmationCloseLeavesZone(int confirmationBar, bool demand, float top, float bottom) =>
    bool leavesZone = true
    int confirmationIdx = bar_index - confirmationBar
    if not na(confirmationBar) and confirmationIdx >= 0 and confirmationIdx <= bar_index
        leavesZone := demand ? close[confirmationIdx] > top : close[confirmationIdx] < bottom
    leavesZone

deleteZoneDrawings(RawZone z) =>
    if not na(z.zoneBox)
        box.delete(z.zoneBox)
    if not na(z.liquidityLine)
        line.delete(z.liquidityLine)
    if not na(z.targetLine)
        line.delete(z.targetLine)
    if not na(z.liquidityCompareLabel)
        label.delete(z.liquidityCompareLabel)
    true

cleanupRemovalReason(RawZone z) =>
    isAccZoneModel(z.model) ? NESTED_REMOVED_ACC : NESTED_REMOVED_STANDARD

deactivateNestedZone(RawZone z, string cleanupReason) =>
    z.active := false
    z.inactiveReason := cleanupReason
    if showInactiveZones
        if not na(z.zoneBox)
            box.set_bgcolor(z.zoneBox, inactiveColor)
            box.set_border_color(z.zoneBox, color.new(color.gray, 35))
        if not na(z.liquidityLine)
            line.delete(z.liquidityLine)
            z.liquidityLine := na
        if not na(z.targetLine)
            line.delete(z.targetLine)
            z.targetLine := na
    else
        deleteZoneDrawings(z)
        z.zoneBox := na
        z.liquidityLine := na
        z.targetLine := na
    z

replaceNormalZoneForAcc(int originBar, bool demand, string effectiveModel) =>
    bool replaced = false
    if isAccZoneModel(effectiveModel)
        int sz = array.size(zones)
        if sz > 0
            for i = 0 to sz - 1
                RawZone z = array.get(zones, i)
                bool sameOriginNormal = z.active and z.demand == demand and z.originBar == originBar and sameModelFamily(z.model, effectiveModel) and not isAccZoneModel(z.model)
                if sameOriginNormal
                    z := deactivateNestedZone(z, NESTED_REMOVED_STANDARD)
                    z.inactiveReason := "ACC_REPLACED_NORMAL"
                    array.set(zones, i, z)
                    replaced := true
    replaced

cleanupNestedSameSideZones(int newIndexOrZoneId) =>
    int sz = array.size(zones)
    int newIndex = na
    if sz > 0
        if newIndexOrZoneId >= 0 and newIndexOrZoneId < sz
            newIndex := newIndexOrZoneId
        else
            for findIdx = 0 to sz - 1
                RawZone findZone = array.get(zones, findIdx)
                if findZone.id == newIndexOrZoneId
                    newIndex := findIdx
                    break

        if not na(newIndex)
            RawZone newZone = array.get(zones, newIndex)
            for i = 0 to sz - 1
                if i != newIndex
                    RawZone otherZone = array.get(zones, i)
                    if otherZone.demand == newZone.demand
                        bool newInsideOther = zoneContained(newZone.top, newZone.bottom, otherZone.top, otherZone.bottom)
                        bool otherInsideNew = zoneContained(otherZone.top, otherZone.bottom, newZone.top, newZone.bottom)
                        bool nearbySameLeg = math.abs(newZone.originBar - otherZone.originBar) <= formationLegScanBars
                        bool nestedConflict = (newInsideOther or otherInsideNew) and sameModelFamily(newZone.model, otherZone.model)
                        bool heavyOverlap = nearbySameLeg and zoneOverlapPct(newZone.top, newZone.bottom, otherZone.top, otherZone.bottom) >= 0.65
                        if nestedConflict or heavyOverlap
                            bool keepNew = nestedConflict ? zoneSize(newZone.top, newZone.bottom) < zoneSize(otherZone.top, otherZone.bottom) : preferFirstZone(newZone, otherZone)
                            if keepNew
                                otherZone := deactivateNestedZone(otherZone, cleanupRemovalReason(otherZone))
                                array.set(zones, i, otherZone)
                            else
                                newZone := deactivateNestedZone(newZone, cleanupRemovalReason(newZone))
                                array.set(zones, newIndex, newZone)
                                break
    true

trimZones() =>
    while array.size(zones) > maxZones
        RawZone oldZone = array.pop(zones)
        deleteZoneDrawings(oldZone)
    true

formationHasLeftZone(int baseIdx, bool demand, float top, float bottom) =>
    bool left = false
    if baseIdx > 0
        for walk = 0 to baseIdx - 1
            int off = baseIdx - 1 - walk
            bool directionalDeparture = demand ? isBullish(off) : isBearish(off)
            bool movedAwayFromZone = demand ? high[off] > top or close[off] > top : low[off] < bottom or close[off] < bottom
            if directionalDeparture and movedAwayFromZone
                left := true
                break
    left

currentEventConfirmationBar(bool demand) =>
    int eventOffset = 0
    for scan = 1 to displacementScanBars
        if scan > bar_index
            break
        bool sameDirectionalLeg = demand ? isBullish(scan) : isBearish(scan)
        if sameDirectionalLeg
            eventOffset := scan
        else
            break
    bar_index - eventOffset

modelForStandardOrigin(int baseIdx, bool demand) =>
    MODEL_STANDARD

candidateBeatsOrigin(int candidateIdx, int selectedIdx, bool demand) =>
    bool beats = na(selectedIdx)
    beats

immediateBaseClusterOrigin(int candidateIdx, bool demand) =>
    int originIdx = candidateIdx
    if candidateIdx >= 0
        for walk = 1 to formationLegScanBars
            int olderIdx = candidateIdx + walk
            if olderIdx >= bar_index
                break
            if isValidBase(olderIdx, demand)
                originIdx := olderIdx
            else
                break
    originIdx

standardConfirmationCloseLeavesZone(int displacementIdx, int baseIdx, bool demand) =>
    bool leaves = false
    if displacementIdx >= 0 and baseIdx >= 0 and displacementIdx <= bar_index and baseIdx <= bar_index
        [top, bottom] = standardZoneBounds(baseIdx, demand)
        leaves := demand ? close[displacementIdx] > top : close[displacementIdx] < bottom
    leaves

firstConfirmedDisplacementIdx(int eventStartIdx, int baseIdx, bool demand) =>
    int confirmedIdx = na
    if eventStartIdx >= 0
        for walk = 0 to eventStartIdx
            int checkIdx = eventStartIdx - walk
            if displacement_leg_confirmed(checkIdx, baseIdx, demand) and standardConfirmationCloseLeavesZone(checkIdx, baseIdx, demand)
                confirmedIdx := checkIdx
                break
    confirmedIdx

firstConfirmedAccDisplacementIdx(int eventStartIdx, int baseIdx, bool demand, int legCandles) =>
    int confirmedIdx = na
    if eventStartIdx >= 0
        for walk = 0 to eventStartIdx
            int checkIdx = eventStartIdx - walk
            if acc_displacement_leg_confirmed(checkIdx, baseIdx, demand, legCandles)
                confirmedIdx := checkIdx
                break
    confirmedIdx

resolveStandardZoneCandidateAt(int eventStartIdx, int candidateBaseIdx, bool demand, int startOffset) =>
    bool candidateValid = false
    string candidateRejectReason = ""
    int candidateConfirmationIdx = eventStartIdx
    int candidateLegCandles = math.min(math.max(candidateBaseIdx - eventStartIdx, 1), formationLegScanBars)
    bool candidateBaseValid = candidateBaseIdx > eventStartIdx and isValidBase(candidateBaseIdx, demand)
    int directionalCount = 0
    if candidateBaseIdx > eventStartIdx
        for legOffset = eventStartIdx to candidateBaseIdx - 1
            bool directionalCandle = demand ? isBullish(legOffset) : isBearish(legOffset)
            if directionalCandle
                directionalCount += 1

    candidateConfirmationIdx := firstConfirmedDisplacementIdx(eventStartIdx, candidateBaseIdx, demand)
    if na(candidateConfirmationIdx)
        candidateConfirmationIdx := firstConfirmedAccDisplacementIdx(eventStartIdx, candidateBaseIdx, demand, candidateLegCandles)
    bool hasConfirmedDisplacement = not na(candidateConfirmationIdx)
    if directionalCount == 0
        candidateRejectReason := REJECT_NO_DISPLACEMENT
    else if not hasConfirmedDisplacement
        candidateRejectReason := REJECT_WEAK_DISPLACEMENT
    else if formationRetouchRejectAllowed() and formation_leg_retouches_zone_after_leave(candidateBaseIdx, demand, startOffset)
        candidateRejectReason := REJECT_FORMATION_RETOUCHED
    else
        candidateLegCandles := math.min(math.max(candidateBaseIdx - candidateConfirmationIdx, 1), formationLegScanBars)
        candidateValid := true
    drawZoneCandidateDebug(candidateBaseIdx, demand, candidateBaseValid, candidateValid, candidateRejectReason, candidateConfirmationIdx, "STANDARD")
    [candidateValid, candidateConfirmationIdx, candidateLegCandles, candidateRejectReason]

resolveHistoricalSuppressedStandardDemandCandidateAt(int candidateBaseIdx) =>
    bool candidateValid = false
    int candidateConfirmationIdx = na
    int candidateLegCandles = 0
    string candidateRejectReason = ""
    if candidateBaseIdx > 0 and isValidBase(candidateBaseIdx, true)
        [top, bottom] = standardZoneBounds(candidateBaseIdx, true)
        int firstDepartureConfirmationIdx = na
        for departureWalk = 0 to candidateBaseIdx - 1
            int departureIdx = candidateBaseIdx - 1 - departureWalk
            if displacement_leg_confirmed(departureIdx, candidateBaseIdx, true) and standardConfirmationCloseLeavesZone(departureIdx, candidateBaseIdx, true)
                firstDepartureConfirmationIdx := departureIdx
                break
        bool currentConfirmsDeparture = firstDepartureConfirmationIdx == 0
        if currentConfirmsDeparture
            bool closedBelowBeforeConfirmation = false
            if candidateBaseIdx > 1
                for historicalWalk = 1 to candidateBaseIdx - 1
                    int historicalOffset = candidateBaseIdx - historicalWalk
                    if close[historicalOffset] < bottom
                        closedBelowBeforeConfirmation := true
                        break
            if closedBelowBeforeConfirmation
                candidateRejectReason := REJECT_CONFIRMATION_CLOSE_INSIDE
            else
                candidateValid := true
                candidateConfirmationIdx := 0
                candidateLegCandles := math.min(math.max(candidateBaseIdx, 1), formationLegScanBars)
        else
            candidateRejectReason := REJECT_WEAK_DISPLACEMENT
    else
        candidateRejectReason := REJECT_NO_DISPLACEMENT
    [candidateValid, candidateConfirmationIdx, candidateLegCandles, candidateRejectReason]

resolveHistoricalSuppressedStandardSupplyCandidateAt(int candidateBaseIdx) =>
    bool candidateValid = false
    int candidateConfirmationIdx = na
    int candidateLegCandles = 0
    string candidateRejectReason = ""
    bool candidateBaseValid = candidateBaseIdx > 0 and isValidBase(candidateBaseIdx, false)
    if candidateBaseValid
        [top, bottom] = standardZoneBounds(candidateBaseIdx, false)
        int firstDepartureConfirmationIdx = na
        for departureWalk = 0 to candidateBaseIdx - 1
            int departureIdx = candidateBaseIdx - 1 - departureWalk
            if displacement_leg_confirmed(departureIdx, candidateBaseIdx, false) and standardConfirmationCloseLeavesZone(departureIdx, candidateBaseIdx, false)
                firstDepartureConfirmationIdx := departureIdx
                break
        bool hasDepartureConfirmation = not na(firstDepartureConfirmationIdx)
        if hasDepartureConfirmation
            bool closedAboveBeforeConfirmation = false
            if candidateBaseIdx > firstDepartureConfirmationIdx + 1
                for historicalWalk = 1 to candidateBaseIdx - 1
                    int historicalOffset = candidateBaseIdx - historicalWalk
                    if historicalOffset <= firstDepartureConfirmationIdx
                        break
                    if close[historicalOffset] > top
                        closedAboveBeforeConfirmation := true
                        break
            if closedAboveBeforeConfirmation
                candidateRejectReason := REJECT_CONFIRMATION_CLOSE_INSIDE
            else
                candidateValid := true
                candidateConfirmationIdx := firstDepartureConfirmationIdx
                candidateLegCandles := math.min(math.max(candidateBaseIdx - candidateConfirmationIdx, 1), formationLegScanBars)
        else
            candidateRejectReason := REJECT_WEAK_DISPLACEMENT
    else
        candidateRejectReason := REJECT_NO_DISPLACEMENT
    drawZoneCandidateDebug(candidateBaseIdx, false, candidateBaseValid, candidateValid, candidateRejectReason, candidateConfirmationIdx, "HIST_SUPPLY")
    [candidateValid, candidateConfirmationIdx, candidateLegCandles, candidateRejectReason]

resolveZoneCandidate(bool demand, bool continuationMode) =>
    bool valid = false
    int baseIdx = na
    int confirmationIdx = na
    int originBar = na
    int legCandles = 0
    string model = continuationMode ? MODEL_CONTINUATION : MODEL_STANDARD
    float top = na
    float bottom = na
    string rejectReason = ""

    int eventStartBar = currentEventConfirmationBar(demand)
    int eventStartIdx = bar_index - eventStartBar
    confirmationIdx := eventStartIdx
    bool eventDirectional = demand ? isBullish(0) : isBearish(0)
    bool modelAllowed = not continuationMode or enableContinuationZones

    if not modelAllowed
        rejectReason := REJECT_MODEL_NOT_ALLOWED
    else if not eventDirectional
        rejectReason := REJECT_NO_DISPLACEMENT
    else
        int maxScan = formationLegScanBars
        int scanStart = math.max(eventStartIdx, 0)
        bool foundOriginCluster = false
        if maxScan > 0
            for scan = 1 to maxScan
                int candidateBaseIdx = scanStart + scan
                if candidateBaseIdx >= bar_index
                    break

                if isValidBase(candidateBaseIdx, demand)
                    foundOriginCluster := true
                    int candidateLegCandles = math.min(math.max(candidateBaseIdx - eventStartIdx, 1), formationLegScanBars)
                    bool candidateValid = false
                    string candidateRejectReason = ""
                    int candidateConfirmationIdx = eventStartIdx

                    if continuationMode
                        candidateValid := isContinuationZone(candidateBaseIdx, demand)
                        candidateRejectReason := candidateValid ? "" : REJECT_WEAK_DISPLACEMENT
                    else
                        [resolvedCandidateValid, resolvedCandidateConfirmationIdx, resolvedCandidateLegCandles, resolvedCandidateRejectReason] = resolveStandardZoneCandidateAt(eventStartIdx, candidateBaseIdx, demand, 0)
                        candidateValid := resolvedCandidateValid
                        candidateConfirmationIdx := resolvedCandidateConfirmationIdx
                        candidateLegCandles := resolvedCandidateLegCandles
                        candidateRejectReason := resolvedCandidateRejectReason

                    if candidateValid
                        if candidateBeatsOrigin(candidateBaseIdx, baseIdx, demand)
                            baseIdx := candidateBaseIdx
                            confirmationIdx := candidateConfirmationIdx
                            legCandles := candidateLegCandles
                    else if str.length(rejectReason) == 0
                        rejectReason := candidateRejectReason
                else if foundOriginCluster
                    bool olderDirectionalBoundary = demand ? isBullish(candidateBaseIdx) : isBearish(candidateBaseIdx)
                    if olderDirectionalBoundary
                        break

    if not na(baseIdx)
        model := resolveFinalModel(baseIdx, demand, model, legCandles)
        [candidateTop, candidateBottom] = zoneBoundsForFinalModel(baseIdx, demand, legCandles, model)
        top := candidateTop
        bottom := candidateBottom
        originBar := bar_index - baseIdx
        valid := true
        rejectReason := ""
    else if str.length(rejectReason) == 0
        rejectReason := REJECT_NO_DISPLACEMENT

    [valid, baseIdx, confirmationIdx, originBar, legCandles, model, top, bottom, rejectReason]

createZone(int baseIdx, bool demand, int zoneId, int legCandles, string model, int confirmationBar) =>
    bool created = false
    bool duplicateSkipped = false
    int originBar = bar_index - baseIdx
    string effectiveModel = resolveFinalModel(baseIdx, demand, model, legCandles)
    bool modelAllowed = effectiveModel == MODEL_STANDARD or (effectiveModel == MODEL_CONTINUATION and enableContinuationZones) or (effectiveModel == MODEL_ACC_STANDARD and accuracyBoundsAllowed()) or (effectiveModel == MODEL_ACC_CONTINUATION and accuracyBoundsAllowed() and enableContinuationZones) or (effectiveModel == MODEL_ACC and accuracyBoundsAllowed())
    if modelAllowed and isValidBase(baseIdx, demand)
        [top, bottom] = zoneBoundsForFinalModel(baseIdx, demand, legCandles, effectiveModel)
        bool boundsValid = not na(top) and not na(bottom) and top > bottom
        if not boundsValid
            duplicateSkipped := true
        else if not confirmationCloseLeavesZone(confirmationBar, demand, top, bottom)
            duplicateSkipped := true
        else
            replaceNormalZoneForAcc(originBar, demand, effectiveModel)
            string duplicateReason = duplicateRejectReason(top, bottom, demand, originBar, effectiveModel, confirmationBar)
            if str.length(duplicateReason) > 0
                duplicateSkipped := true
            else
                RawZone z = RawZone.new()
                z.id := zoneId
                z.demand := demand
                z.originBar := originBar
                z.originTime := time[baseIdx]
                z.createdBar := bar_index
                z.confirmationBar := confirmationBar
                z.invalidationStartBar := not na(confirmationBar) ? confirmationBar + 1 : bar_index + 1
                z.eventId := confirmationBar
                z.model := effectiveModel
                z.legCandles := legCandles
                z.top := top
                z.bottom := bottom
                z.active := true
                z.leftZone := formationHasLeftZone(baseIdx, demand, top, bottom)
                z.runtimeLeftZoneAfterConfirmation := true
                z.liquidityLinked := false
                z.liquiditySwept := false
                z.targetSwept := false
                z.targetFromOneCandle := false
                z.touched := false
                z.inactiveReason := ""
                z.lastInvalidationCheckReason := ""
                z.liqLowPrice := na
                z.liqLowBar := na
                z.liqHighPrice := na
                z.liqHighBar := na
                z.liquidityPrice := na
                z.liquidityBarIndex := na
                z.liquiditySweepBar := na
                z.targetSweepBar := na
                z.liquidityLineSweepBar := na
                z.zoneMitigationBar := na
                z.zoneDisplayStopBar := na
                z.zoneBox := na
                z.liquidityLine := na
                z.targetLine := na
                z.liquidityValid := false
                z.liquidityCandleCount := 0
                z.structureSweepLevel := na
                z.structureSweepLevelBar := na
                z.liqLowTime := na
                z.liqHighTime := na
                z.liqSource := ""
                z.liquidityDistanceFromZone := na
                z.liquidityDecisionReason := ""
                z.liquidityRejectedReason := ""
                z.liquidityRejectedBar := na
                z.liquidityRejectedPrice := na
                z.liquidityCompareLabel := na
                array.unshift(zones, z)
                trimZones()
                sendEvent("ZONE_CREATED", z)
                cleanupNestedSameSideZones(0)
                created := true
    [created, duplicateSkipped]

hideInactiveZone(RawZone z) =>
    if showInactiveZones
        if not na(z.zoneBox)
            box.set_bgcolor(z.zoneBox, inactiveColor)
            box.set_border_color(z.zoneBox, color.new(color.gray, 35))
    else
        deleteZoneDrawings(z)
        z.zoneBox := na
        z.liquidityLine := na
        z.targetLine := na
    true

createLinkedLine(int x1, float price, color lineColor) =>
    plotLiq and not na(x1) and not na(price) ? line.new(x1, price, projectedRightBar(), price, xloc = xloc.bar_index, extend = extend.none, color = lineColor, style = line.style_dashed, width = 2) : na

linkedLiquidityPrice(RawZone z) =>
    z.demand ? z.liqLowPrice : z.liqHighPrice

linkedLiquidityBar(RawZone z) =>
    z.demand ? z.liqLowBar : z.liqHighBar

linkedTargetPrice(RawZone z) =>
    z.demand ? z.liqHighPrice : z.liqLowPrice

linkedTargetBar(RawZone z) =>
    z.demand ? z.liqHighBar : z.liqLowBar

liquidityLineSweptOnThisBar(RawZone z) =>
    float price = linkedLiquidityPrice(z)
    int lineBar = linkedLiquidityBar(z)
    float sweepTolerance = syminfo.mintick * equalLiquidityToleranceTicks
    not z.liquiditySwept and z.liquidityValid and not na(price) and not na(lineBar) and bar_index > lineBar and (z.demand ? low <= price + sweepTolerance : high >= price - sweepTolerance)

liquidityProofReady(RawZone z) =>
    z.liquidityValid and z.liquiditySwept and z.targetSwept

targetLineSweptOnThisBar(RawZone z) =>
    float price = linkedTargetPrice(z)
    int lineBar = linkedTargetBar(z)
    not z.targetSwept and z.liquidityValid and z.liquiditySwept and not na(price) and not na(lineBar) and bar_index > lineBar and (z.demand ? high >= price : low <= price)

zoneShowsLinkedLiquidity(RawZone z) =>
    z.active and z.liquidityLinked

zoneShowsDetectedLiquidity(RawZone z) =>
    z.active and not na(z.liquidityPrice) and not na(z.liquidityBarIndex) and (not showOnlyStrategyValidLiquidity or z.liquidityValid)

zoneBgColorFor(RawZone z) =>
    bool accVisual = isAccZoneModel(z.model)
    accVisual ? (z.demand ? accDemandColor : accSupplyColor) : (z.demand ? demandColor : supplyColor)

zoneBorderColorFor(RawZone z) =>
    bool accVisual = isAccZoneModel(z.model)
    accVisual ? (z.demand ? accDemandBorder : accSupplyBorder) : (z.demand ? demandBorder : supplyBorder)

updateZoneBox(RawZone z) =>
    bool showZone = z.active or showInactiveZoneDebug
    if showZone
        if na(z.zoneBox)
            z.zoneBox := box.new(z.originBar, z.top, zoneRightBar(z), z.bottom, xloc = xloc.bar_index, bgcolor = zoneBgColorFor(z), border_color = zoneBorderColorFor(z), border_width = isAccZoneModel(z.model) ? 2 : 1)
        else
            box.set_right(z.zoneBox, zoneRightBar(z))
            box.set_bgcolor(z.zoneBox, zoneBgColorFor(z))
            box.set_border_color(z.zoneBox, zoneBorderColorFor(z))
        if not z.active and showInactiveZoneDebug
            box.set_bgcolor(z.zoneBox, inactiveColor)
            box.set_border_color(z.zoneBox, color.new(color.gray, 35))
    else
        if not na(z.zoneBox)
            box.delete(z.zoneBox)
            z.zoneBox := na
    true

updateZoneLines(RawZone z) =>
    bool showLiquidityLine = plotLiq and (zoneShowsDetectedLiquidity(z) or zoneShowsLinkedLiquidity(z))
    bool showTargetLine = plotLiq and zoneShowsLinkedLiquidity(z)
    if not showLiquidityLine
        if not na(z.liquidityLine)
            line.delete(z.liquidityLine)
            z.liquidityLine := na
    else
        int x1 = linkedLiquidityBar(z)
        x1 := na(x1) ? z.originBar : x1
        float y = linkedLiquidityPrice(z)
        y := na(y) ? z.liquidityPrice : y
        if not na(y)
            if na(z.liquidityLine)
                z.liquidityLine := createLinkedLine(x1, y, liqColor)
            else
                line.set_x1(z.liquidityLine, x1)
                line.set_x2(z.liquidityLine, liquidityLineRightBar(z))
                line.set_y1(z.liquidityLine, y)
                line.set_y2(z.liquidityLine, y)
                line.set_extend(z.liquidityLine, extend.none)
                line.set_color(z.liquidityLine, liqColor)
                line.set_style(z.liquidityLine, line.style_dashed)
                line.set_width(z.liquidityLine, 2)
    if not showTargetLine
        if not na(z.targetLine)
            line.delete(z.targetLine)
            z.targetLine := na
    else
        int tx1 = linkedTargetBar(z)
        tx1 := na(tx1) ? z.originBar : tx1
        float ty = linkedTargetPrice(z)
        if not na(ty)
            if na(z.targetLine)
                z.targetLine := createLinkedLine(tx1, ty, targetColor)
            else
                line.set_x1(z.targetLine, tx1)
                line.set_x2(z.targetLine, sweptTargetLineRightBar(z))
                line.set_y1(z.targetLine, ty)
                line.set_y2(z.targetLine, ty)
                line.set_extend(z.targetLine, extend.none)
                line.set_color(z.targetLine, targetColor)
                line.set_style(z.targetLine, line.style_dashed)
                line.set_width(z.targetLine, 2)
    updateLiquidityCompareLabel(z)
    true

liqTolerance() =>
    syminfo.mintick * equalLiquidityToleranceTicks

historicalPivotHighAt(int offset) =>
    bool valid = offset - pivotLen >= 0 and offset + pivotLen <= bar_index
    if valid
        float candidate = high[offset]
        for step = 1 to pivotLen
            if candidate < high[offset - step] or candidate < high[offset + step]
                valid := false
                break
    valid

historicalPivotLowAt(int offset) =>
    bool valid = offset - pivotLen >= 0 and offset + pivotLen <= bar_index
    if valid
        float candidate = low[offset]
        for step = 1 to pivotLen
            if candidate > low[offset - step] or candidate > low[offset + step]
                valid := false
                break
    valid

historicalLocalHighAt(int offset) =>
    offset >= 1 and offset + 1 <= bar_index and high[offset] >= high[offset - 1] and high[offset] >= high[offset + 1]

historicalLocalLowAt(int offset) =>
    offset >= 1 and offset + 1 <= bar_index and low[offset] <= low[offset - 1] and low[offset] <= low[offset + 1]

normalLiquidityHasTwoOppositeCandles(int pivotBar, bool demand) =>
    int pivotOffset = bar_index - pivotBar
    bool valid = false
    if pivotOffset >= 0 and pivotOffset + 1 <= bar_index
        bool pivotOpposite = demand ? isBearish(pivotOffset) : isBullish(pivotOffset)
        bool previousOpposite = demand ? isBearish(pivotOffset + 1) : isBullish(pivotOffset + 1)
        valid := pivotOpposite and previousOpposite
    valid

referenceLiquidityDedupPrice() =>
    float tickFallback = syminfo.mintick * math.max(equalLiquidityToleranceTicks, 1)
    float atrCluster = not na(atr14) and atr14 > 0 ? atr14 * referenceLiquidityClusterAtrMultiplier : na
    math.max(tickFallback, not na(atrCluster) ? atrCluster : tickFallback)

referenceLiquidityEqualPrice() =>
    float tickFallback = syminfo.mintick * math.max(equalLiquidityToleranceTicks, 1)
    float atrEqual = not na(atr14) and atr14 > 0 ? atr14 * referenceLiquidityEqualAtrMultiplier : na
    math.max(tickFallback, not na(atrEqual) ? atrEqual : tickFallback)

referenceLiquidityLineExists(float price, bool demand) =>
    bool exists = false
    float tolPrice = referenceLiquidityDedupPrice()
    int count = array.size(referenceLiquidityPrices)
    if count > 0
        for i = 0 to count - 1
            bool sameSide = array.get(referenceLiquidityDemand, i) == demand
            float existingPrice = array.get(referenceLiquidityPrices, i)
            if sameSide and math.abs(existingPrice - price) <= tolPrice
                exists := true
                break
    exists

trimReferenceLiquidityLines() =>
    while array.size(referenceLiquidityLines) > referenceLiquidityMaxLines
        line oldestLine = array.shift(referenceLiquidityLines)
        if not na(oldestLine)
            line.delete(oldestLine)
        array.shift(referenceLiquidityPrices)
        array.shift(referenceLiquidityBars)
        array.shift(referenceLiquidityDemand)
        array.shift(referenceLiquiditySwept)
    true

recordReferenceLiquidityLine(float price, int x1, bool demand) =>
    bool recorded = false
    if not na(price) and not na(x1) and not referenceLiquidityLineExists(price, demand)
        array.push(referenceLiquidityLines, na)
        array.push(referenceLiquidityPrices, price)
        array.push(referenceLiquidityBars, x1)
        array.push(referenceLiquidityDemand, demand)
        array.push(referenceLiquiditySwept, false)
        trimReferenceLiquidityLines()
        recorded := true
    recorded

updateReferenceLiquidityLines() =>
    float tolPrice = syminfo.mintick * math.max(equalLiquidityToleranceTicks, 1)
    int count = array.size(referenceLiquidityLines)
    if count > 0
        for i = 0 to count - 1
            line liqLine = array.get(referenceLiquidityLines, i)
            float price = array.get(referenceLiquidityPrices, i)
            int originBar = array.get(referenceLiquidityBars, i)
            bool demand = array.get(referenceLiquidityDemand, i)
            bool swept = array.get(referenceLiquiditySwept, i)
            if not swept and bar_index > originBar
                bool sweptNow = demand ? low <= price + tolPrice : high >= price - tolPrice
                if sweptNow
                    if not na(liqLine)
                        line.set_x2(liqLine, bar_index)
                    array.set(referenceLiquiditySwept, i, true)
                else
                    if not na(liqLine)
                        line.set_x2(liqLine, projectedRightBar())
    true

oneCandleLiquidityHasFakeout(int pivotBar, bool demand) =>
    int pivotOffset = bar_index - pivotBar
    bool valid = false
    if enableOneCandleLiquidity and pivotOffset >= 2 and pivotOffset + 1 <= bar_index
        bool pivotOpposite = demand ? isBearish(pivotOffset) : isBullish(pivotOffset)
        bool previousOpposite = demand ? isBearish(pivotOffset + 1) : isBullish(pivotOffset + 1)
        float previousBodyHigh = math.max(open[pivotOffset + 1], close[pivotOffset + 1])
        float previousBodyLow = math.min(open[pivotOffset + 1], close[pivotOffset + 1])
        bool fakeout = demand ? low[pivotOffset] < low[pivotOffset + 1] and close[pivotOffset] > previousBodyLow : high[pivotOffset] > high[pivotOffset + 1] and close[pivotOffset] < previousBodyHigh
        bool immediateLoss = demand ? isBullish(pivotOffset - 1) and close[pivotOffset - 1] > high[pivotOffset + 1] : isBearish(pivotOffset - 1) and close[pivotOffset - 1] < low[pivotOffset + 1]
        bool clearDirection = demand ? isBullish(pivotOffset - 2) and close[pivotOffset - 2] > close[pivotOffset - 1] : isBearish(pivotOffset - 2) and close[pivotOffset - 2] < close[pivotOffset - 1]
        valid := pivotOpposite and not previousOpposite and fakeout and immediateLoss and clearDirection
    valid

oneCandleRetracementLiquidityAt(int offset, bool demand) =>
    bool valid = false
    if enableOneCandleLiquidity and offset >= 1 and offset + 1 <= bar_index
        bool pivotOpposite = demand ? isBearish(offset) : isBullish(offset)
        bool olderContinuation = demand ? isBullish(offset + 1) : isBearish(offset + 1)
        bool newerContinuation = demand ? isBullish(offset - 1) : isBearish(offset - 1)
        float pivotBodyHigh = math.max(open[offset], close[offset])
        float pivotBodyLow = math.min(open[offset], close[offset])
        bool continuationBreak = demand ? close[offset - 1] > pivotBodyHigh : close[offset - 1] < pivotBodyLow
        bool localExtreme = demand ? low[offset] <= low[offset + 1] and low[offset] <= low[offset - 1] : high[offset] >= high[offset + 1] and high[offset] >= high[offset - 1]
        valid := pivotOpposite and olderContinuation and newerContinuation and continuationBreak and localExtreme
    valid

supplyOneCandleRetracementLiquidityAt(int offset) =>
    bool valid = false
    if enableOneCandleLiquidity and offset >= 1 and offset + 1 <= bar_index
        bool pivotBullish = isBullish(offset)
        bool olderBearish = isBearish(offset + 1)
        bool newerBearish = isBearish(offset - 1)
        float pivotBodyLow = math.min(open[offset], close[offset])
        bool continuationBreak = close[offset - 1] < pivotBodyLow
        bool newerHighRejected = high[offset] >= high[offset - 1]
        valid := pivotBullish and olderBearish and newerBearish and continuationBreak and newerHighRejected
    valid

equalLowLiquidityAt(int offset) =>
    bool valid = false
    if offset >= 0 and offset <= bar_index
        float candidate = low[offset]
        float tol = liqTolerance()
        for step = 1 to equalLiquidityScanBars
            bool olderEqual = offset + step <= bar_index and math.abs(candidate - low[offset + step]) <= tol
            bool newerEqual = offset - step >= 0 and math.abs(candidate - low[offset - step]) <= tol
            if olderEqual or newerEqual
                valid := true
                break
    valid

equalHighLiquidityAt(int offset) =>
    bool valid = false
    if offset >= 0 and offset <= bar_index
        float candidate = high[offset]
        float tol = liqTolerance()
        for step = 1 to equalLiquidityScanBars
            bool olderEqual = offset + step <= bar_index and math.abs(candidate - high[offset + step]) <= tol
            bool newerEqual = offset - step >= 0 and math.abs(candidate - high[offset - step]) <= tol
            if olderEqual or newerEqual
                valid := true
                break
    valid

rdLowLiquidityAt(int offset) =>
    int pivotBar = bar_index - offset
    bool oneCandleLiquidity = oneCandleLiquidityHasFakeout(pivotBar, true) or oneCandleRetracementLiquidityAt(offset, true)
    bool swingLow = historicalPivotLowAt(offset) or historicalLocalLowAt(offset) or oneCandleLiquidity
    bool rdType = normalLiquidityHasTwoOppositeCandles(pivotBar, true) or oneCandleLiquidity or equalLowLiquidityAt(offset)
    swingLow and (strictRdLiquidity ? rdType : true)

rdHighLiquidityAt(int offset) =>
    int pivotBar = bar_index - offset
    bool oneCandleLiquidity = oneCandleLiquidityHasFakeout(pivotBar, false) or oneCandleRetracementLiquidityAt(offset, false)
    bool swingHigh = historicalPivotHighAt(offset) or historicalLocalHighAt(offset) or oneCandleLiquidity
    bool rdType = normalLiquidityHasTwoOppositeCandles(pivotBar, false) or oneCandleLiquidity or equalHighLiquidityAt(offset)
    swingHigh and (strictRdLiquidity ? rdType : true)

referenceEqualLowLiquidityAt(int offset) =>
    bool valid = false
    if offset >= 0 and offset <= bar_index
        float candidate = low[offset]
        float tol = referenceLiquidityEqualPrice()
        for step = 1 to equalLiquidityScanBars
            bool olderEqual = offset + step <= bar_index and math.abs(candidate - low[offset + step]) <= tol
            bool newerEqual = offset - step >= 0 and math.abs(candidate - low[offset - step]) <= tol
            if olderEqual or newerEqual
                valid := true
                break
    valid

referenceEqualHighLiquidityAt(int offset) =>
    bool valid = false
    if offset >= 0 and offset <= bar_index
        float candidate = high[offset]
        float tol = referenceLiquidityEqualPrice()
        for step = 1 to equalLiquidityScanBars
            bool olderEqual = offset + step <= bar_index and math.abs(candidate - high[offset + step]) <= tol
            bool newerEqual = offset - step >= 0 and math.abs(candidate - high[offset - step]) <= tol
            if olderEqual or newerEqual
                valid := true
                break
    valid

referenceLowLiquidityAt(int offset) =>
    rdLowLiquidityAt(offset) or (historicalLocalLowAt(offset) and referenceEqualLowLiquidityAt(offset))

referenceHighLiquidityAt(int offset) =>
    rdHighLiquidityAt(offset) or (historicalLocalHighAt(offset) and referenceEqualHighLiquidityAt(offset))

if bar_index >= last_bar_index - runtimeLookbackBars and barstate.isconfirmed and isPrimaryFiveMinute
    int referenceLiquidityPivotBar = bar_index - referenceLiquidityPivotLen
    if referenceLowLiquidityAt(referenceLiquidityPivotLen)
        recordReferenceLiquidityLine(low[referenceLiquidityPivotLen], referenceLiquidityPivotBar, true)
    if referenceHighLiquidityAt(referenceLiquidityPivotLen)
        recordReferenceLiquidityLine(high[referenceLiquidityPivotLen], referenceLiquidityPivotBar, false)
    updateReferenceLiquidityLines()

liquidityHasValidStructure(int pivotBar, bool demand) =>
    int pivotOffset = bar_index - pivotBar
    demand ? rdLowLiquidityAt(pivotOffset) : rdHighLiquidityAt(pivotOffset)

candidateLiquidityIsCloser(float candidatePrice, float storedPrice, bool demand) =>
    na(storedPrice) or (demand ? candidatePrice < storedPrice : candidatePrice > storedPrice)

candidateMainLiquidityIsCloser(float candidatePrice, float storedPrice, bool demand) =>
    na(storedPrice) or (demand ? candidatePrice < storedPrice : candidatePrice > storedPrice)

liquidityInsideNewerSameSideZone(RawZone sourceZone, int pivotBar, float candidatePrice) =>
    bool inside = false
    if not na(candidatePrice) and not na(pivotBar)
        int sz = array.size(zones)
        if sz > 0
            for i = 0 to sz - 1
                RawZone otherZone = array.get(zones, i)
                if otherZone.id != sourceZone.id and otherZone.active and otherZone.demand == sourceZone.demand and otherZone.originBar > sourceZone.originBar
                    float boundaryBuffer = syminfo.mintick * 0.5
                    if candidatePrice < otherZone.top - boundaryBuffer and candidatePrice > otherZone.bottom + boundaryBuffer
                        inside := true
                        break
    inside

clearStaleLiquidityInsideNewerZone(RawZone z) =>
    if z.active and not z.liquidityLinked and not z.targetSwept
        bool staleDemandLiquidity = z.demand and not na(z.liqLowPrice) and liquidityInsideNewerSameSideZone(z, z.liqLowBar, z.liqLowPrice)
        bool staleSupplyLiquidity = not z.demand and not na(z.liqHighPrice) and liquidityInsideNewerSameSideZone(z, z.liqHighBar, z.liqHighPrice)
        if staleDemandLiquidity or staleSupplyLiquidity
            z.liqLowPrice := na
            z.liqLowBar := na
            z.liqHighPrice := na
            z.liqHighBar := na
            z.targetFromOneCandle := false
            z.liquidityPrice := na
            z.liquidityBarIndex := na
            z.liquidityLineSweepBar := na
            if not na(z.liquidityLine)
                line.delete(z.liquidityLine)
                z.liquidityLine := na
            if not na(z.targetLine)
                line.delete(z.targetLine)
                z.targetLine := na
    z

initialLiquidityScanBars() =>
    liquiditySearchBars

validCandidateBar(int candidateBar) =>
    not na(candidateBar) and candidateBar >= 0 and bar_index - candidateBar >= 0 and bar_index - candidateBar <= bar_index

removeTargetLine(RawZone z) =>
    if not na(z.targetLine)
        line.delete(z.targetLine)
        z.targetLine := na
    z

removeLiquidityLine(RawZone z) =>
    if not na(z.liquidityLine)
        line.delete(z.liquidityLine)
        z.liquidityLine := na
    z

setOrMoveTargetLine(RawZone z) =>
    if plotLiq and na(z.targetLine)
        int targetBar = linkedTargetBar(z)
        float targetPrice = linkedTargetPrice(z)
        if not na(targetBar) and not na(targetPrice)
            z.targetLine := createLinkedLine(targetBar, targetPrice, targetColor)
    z

countOppCandlesInLiquidityRange(int startBarAbs, int endBarAbs, bool isDemand, float rangeLow, float rangeHigh) =>
    int count = 0
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs and startBarAbs <= bar_index and endBarAbs <= bar_index
        int offStart = bar_index - endBarAbs      // Offset for the end bar (newer, lower offset)
        int offEnd   = bar_index - startBarAbs    // Offset for the start bar (older, higher offset)

        if offStart >= 0 and offEnd >= 0
            int max_steps = 200  // Full scan range — matches good-marking reference
            int steps = 0

            for i = offStart to offEnd
                if steps > max_steps
                    break
                steps += 1

                bool isOpp = isDemand ? (close[i] < open[i]) : (close[i] > open[i])

                if isOpp
                    count += 1
    count

countConsecutiveOppCandles(int liqBar, bool isDemand) =>
    int count = 0
    if na(liqBar) or liqBar > bar_index
        0
    else
        int offset = bar_index - liqBar
        if offset >= 1
            for i = 1 to liq_candle_count_max
                int idx = offset - i
                if idx < 0
                    break
                bool isOppCandle = isDemand ? (close[idx] < open[idx]) : (close[idx] > open[idx])
                if isOppCandle
                    count += 1
        count

findLocalDemandLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0

    for off = 0 to lookback
        float candidate = low[off]
        bool isSideValid = isInducement ? (candidate >= refPrice - sideTol) : (candidate <= refPrice + sideTol)

        if isSideValid
            float dist = math.abs(candidate - refPrice)
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

findLocalSupplyLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0

    for off = 0 to lookback
        float candidate = high[off]
        bool isSideValid = isInducement ? (candidate <= refPrice + sideTol) : (candidate >= refPrice - sideTol)

        if isSideValid
            float dist = math.abs(candidate - refPrice)
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

const string TOUCH_SWEEP_SOURCE = "ZONE_TOUCH_SWEEP"

liquidityMaxDistancePrice() =>
    float tickFallback = syminfo.mintick * math.max(equalLiquidityToleranceTicks, 1)
    float pipCap = effective_liq_max_dist * pip_size
    float atrCap = not na(atr14) and atr14 > 0 ? atr14 * liq_atr_distance_multiplier : na
    not na(atrCap) ? math.max(tickFallback, math.min(pipCap, atrCap)) : math.max(tickFallback, pipCap)

liquidityScanStartBar(RawZone z) =>
    int anchorBar = not na(z.createdBar) ? z.createdBar : bar_index
    math.max(0, anchorBar - displacementScanBars - formationLegScanBars)

liquidityCandidateIsOwnOrigin(RawZone z, int candidateBar, float candidatePrice) =>
    float tol = syminfo.mintick * math.max(equalLiquidityToleranceTicks, 1)
    bool sameOriginBar = not na(z.originBar) and not na(candidateBar) and candidateBar == z.originBar
    bool ownOriginEdge = not na(candidatePrice) and (z.demand ? math.abs(candidatePrice - z.bottom) <= tol : candidatePrice <= z.top + tol and candidatePrice >= z.bottom - tol)
    sameOriginBar and ownOriginEdge

findDemandTouchLiquidity(RawZone z) =>
    float bestPrice = na
    int bestBar = na
    float tolPrice = syminfo.mintick * equalLiquidityToleranceTicks
    float maxDistPrice = liquidityMaxDistancePrice()
    int maxOff = math.min(liq_candle_count_max, math.max(1, bar_index - z.createdBar))
    if maxOff >= 1
        for off = 1 to maxOff
            int candidateBar = bar_index - off
            float candidateLow = low[off]
            bool afterZone = candidateBar > z.createdBar
            bool nearZone = candidateLow >= z.bottom - tolPrice and candidateLow <= z.top + maxDistPrice
            bool sweptNow = low <= candidateLow + tolPrice
            if afterZone and nearZone and sweptNow
                bestPrice := candidateLow
                bestBar := candidateBar
                break
    [bestPrice, bestBar]

findSupplyTouchLiquidity(RawZone z) =>
    float bestPrice = na
    int bestBar = na
    float tolPrice = syminfo.mintick * equalLiquidityToleranceTicks
    float maxDistPrice = liquidityMaxDistancePrice()
    int maxOff = math.min(liq_candle_count_max, math.max(1, bar_index - z.createdBar))
    if maxOff >= 1
        for off = 1 to maxOff
            int candidateBar = bar_index - off
            float candidateHigh = high[off]
            bool afterZone = candidateBar > z.createdBar
            bool nearZone = candidateHigh <= z.top + tolPrice and candidateHigh >= z.bottom - maxDistPrice
            bool sweptNow = high >= candidateHigh - tolPrice
            if afterZone and nearZone and sweptNow
                bestPrice := candidateHigh
                bestBar := candidateBar
                break
    [bestPrice, bestBar]

getBarOfMaxHigh(int startBarAbs, int endBarAbs) =>
    float maxH = -1.0e10
    int bestBar = startBarAbs
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        if offStart >= 0 and offEnd >= 0
            for i = offStart to offEnd
                if high[i] >= maxH
                    maxH := high[i]
                    bestBar := bar_index - i
    bestBar

getBarOfMinLow(int startBarAbs, int endBarAbs) =>
    float minL = 1.0e10
    int bestBar = startBarAbs
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        if offStart >= 0 and offEnd >= 0
            for i = offStart to offEnd
                if low[i] <= minL
                    minL := low[i]
                    bestBar := bar_index - i
    bestBar

majorLiquidityTarget(int targetBar, bool demand) =>
    int targetOffset = bar_index - targetBar
    not na(targetBar) and targetOffset >= 0 and (demand ? historicalPivotHighAt(targetOffset) : historicalPivotLowAt(targetOffset))

countLevelBreaksAfter(float level, int afterBar, bool demand) =>
    int breakCount = 0
    if not na(level) and not na(afterBar) and bar_index > afterBar
        float tol = liqTolerance()
        int maxOff = math.min(MAX_LIQ_SCAN_BARS, bar_index - afterBar - 1)
        if maxOff >= 0
            for off = maxOff to 0
                int candidateBar = bar_index - off
                bool afterLevel = candidateBar > afterBar
                bool breaksLevel = demand ? high[off] >= level - tol : low[off] <= level + tol
                bool previousBreak = off + 1 <= bar_index ? (demand ? high[off + 1] >= level - tol : low[off + 1] <= level + tol) : false
                if afterLevel and breaksLevel and not previousBreak
                    breakCount += 1
    breakCount

secondLevelBreakBarAfter(float level, int afterBar, bool demand) =>
    int secondBreakBar = na
    int breakCount = 0
    if not na(level) and not na(afterBar) and bar_index > afterBar
        float tol = liqTolerance()
        int maxOff = math.min(MAX_LIQ_SCAN_BARS, bar_index - afterBar - 1)
        if maxOff >= 0
            for off = maxOff to 0
                int candidateBar = bar_index - off
                bool afterLevel = candidateBar > afterBar
                bool breaksLevel = demand ? high[off] >= level - tol : low[off] <= level + tol
                bool previousBreak = off + 1 <= bar_index ? (demand ? high[off + 1] >= level - tol : low[off + 1] <= level + tol) : false
                if afterLevel and breaksLevel and not previousBreak
                    breakCount += 1
                    if breakCount >= 2
                        secondBreakBar := candidateBar
                        break
    secondBreakBar

returnedToZoneAfterLevelBreak(RawZone z, bool demand) =>
    int secondBreakBar = secondLevelBreakBarAfter(z.structureSweepLevel, z.structureSweepLevelBar, demand)
    bool returned = false
    if not na(secondBreakBar) and bar_index > secondBreakBar
        int maxOff = math.min(MAX_LIQ_SCAN_BARS, bar_index - secondBreakBar - 1)
        if maxOff >= 0
            for off = 0 to maxOff
                int candidateBar = bar_index - off
                bool afterSecondBreak = candidateBar > secondBreakBar
                bool overlapsZone = high[off] >= z.bottom and low[off] <= z.top
                if afterSecondBreak and overlapsZone
                    returned := true
                    break
    returned

internalLiquidityProofReady(RawZone z, bool demand) =>
    bool isMajorTarget = majorLiquidityTarget(z.structureSweepLevelBar, demand)
    isMajorTarget or (countLevelBreaksAfter(z.structureSweepLevel, z.structureSweepLevelBar, demand) >= 2 and returnedToZoneAfterLevelBreak(z, demand))

f_scan_demand_liquidity(RawZone z) =>
    RawZone out = z
    if not out.active or not out.demand or out.liquidityValid or out.liquiditySwept or out.targetSwept
        out
    else if out.liqSource == TOUCH_SWEEP_SOURCE and not na(out.liquidityPrice)
        out
    else if na(out.createdBar) or bar_index <= out.createdBar
        out
    else
        out := clearLiquidityDebugState(out)
        float bestLiqPrice = 1.0e10
        int bestLiqBar = na
        float bestDist = 1.0e10
        bool bestLiqNearEdge = false
        float zoneHeight = math.abs(out.top - out.bottom)
        string bestSource = ""
        float maxDistPrice = na
        int scanStartBar = liquidityScanStartBar(out)
        int maxOff = math.min(MAX_LIQ_SCAN_BARS, bar_index - scanStartBar - pivotLen)
        int referenceCount = array.size(referenceLiquidityPrices)

        if referenceCount > 0
            for refIdx = 0 to referenceCount - 1
                float pLow = array.get(referenceLiquidityPrices, refIdx)
                int pBar = array.get(referenceLiquidityBars, refIdx)
                bool isDemandReference = array.get(referenceLiquidityDemand, refIdx)
                bool isSweptReference = array.get(referenceLiquiditySwept, refIdx)
                bool referenceCanSeed = referenceLiquidityCanSeedZone(out, pBar, isSweptReference)
                if isDemandReference and referenceCanSeed and not na(pLow) and not na(pBar) and pBar >= scanStartBar and pBar <= bar_index
                    bool isValidLocation = false
                    float distFromZone = 0.0
                    if use_inducement_linking
                        isValidLocation := pLow >= out.top - (syminfo.mintick * equalLiquidityToleranceTicks)
                        distFromZone := math.max(0.0, pLow - out.top)
                    else
                        isValidLocation := pLow < out.bottom
                        distFromZone := out.bottom - pLow
                    if isValidLocation
                        bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice
                        if distOK
                            bool isCloser = distFromZone < bestDist
                            bool isSameDistance = distFromZone == bestDist
                            bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                            bool preferAwayFromEdge = use_inducement_linking and zoneHeight >= pip_size * 5.0
                            bool isNearEdge = preferAwayFromEdge and distFromZone < pip_size * 2.0
                            bool improvesEdgeQuality = bestLiqNearEdge and not isNearEdge
                            bool sameEdgeQuality = bestLiqNearEdge == isNearEdge
                            if na(bestLiqBar) or improvesEdgeQuality or (sameEdgeQuality and (isCloser or (isSameDistance and isMoreRecent)))
                                bestDist := distFromZone
                                bestLiqPrice := pLow
                                bestLiqBar := pBar
                                bestLiqNearEdge := isNearEdge
                                bestSource := "REFERENCE"
                            else
                                out := recordRejectedLiquidityCandidate(out, pBar, pLow, "REFERENCE_NOT_CLOSEST")
                        else
                            out := recordRejectedLiquidityCandidate(out, pBar, pLow, "REFERENCE_TOO_FAR")
                    else
                        out := recordRejectedLiquidityCandidate(out, pBar, pLow, "REFERENCE_WRONG_SIDE")
                else if isDemandReference and isSweptReference and not referenceCanSeed
                    out := recordRejectedLiquidityCandidate(out, pBar, pLow, "REFERENCE_ALREADY_SWEPT")

        if maxOff >= 0
            for off = 0 to maxOff
                float pLow = pLowSeries[off]
                if not na(pLow)
                    int pBar = bar_index - off - pivotLen
                    if pBar >= scanStartBar
                        bool isValidLocation = false
                        float distFromZone = 0.0
                        if use_inducement_linking
                            isValidLocation := pLow >= out.top - (syminfo.mintick * equalLiquidityToleranceTicks)
                            distFromZone := math.max(0.0, pLow - out.top)
                        else
                            isValidLocation := pLow < out.bottom
                            distFromZone := out.bottom - pLow
                        if isValidLocation
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice
                            if distOK
                                bool isCloser = distFromZone < bestDist
                                bool isSameDistance = distFromZone == bestDist
                                bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                                bool preferAwayFromEdge = use_inducement_linking and zoneHeight >= pip_size * 5.0
                                bool isNearEdge = preferAwayFromEdge and distFromZone < pip_size * 2.0
                                bool improvesEdgeQuality = bestLiqNearEdge and not isNearEdge
                                bool sameEdgeQuality = bestLiqNearEdge == isNearEdge
                                if na(bestLiqBar) or improvesEdgeQuality or (sameEdgeQuality and (isCloser or (isSameDistance and isMoreRecent)))
                                    bestDist := distFromZone
                                    bestLiqPrice := pLow
                                    bestLiqBar := pBar
                                    bestLiqNearEdge := isNearEdge
                                    bestSource := "PIVOT"
                                else
                                    out := recordRejectedLiquidityCandidate(out, pBar, pLow, "NOT_CLOSEST")
                            else
                                out := recordRejectedLiquidityCandidate(out, pBar, pLow, "TOO_FAR")
                        else
                            out := recordRejectedLiquidityCandidate(out, pBar, pLow, "WRONG_SIDE")

        if enableOneCandleLiquidity
            int localPivotCount = array.size(liqPvtLowPrices)
            if localPivotCount > 0
                for pivotIdx = 0 to localPivotCount - 1
                    float pLow = array.get(liqPvtLowPrices, pivotIdx)
                    int pBar = array.get(liqPvtLowBars, pivotIdx)
                    if not na(pLow) and not na(pBar) and pBar >= scanStartBar and pBar <= bar_index
                        bool isValidLocation = false
                        float distFromZone = 0.0
                        if use_inducement_linking
                            isValidLocation := pLow >= out.top - (syminfo.mintick * equalLiquidityToleranceTicks)
                            distFromZone := math.max(0.0, pLow - out.top)
                        else
                            isValidLocation := pLow < out.bottom
                            distFromZone := out.bottom - pLow
                        if isValidLocation
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice
                            if distOK
                                bool isCloser = distFromZone < bestDist
                                bool isSameDistance = distFromZone == bestDist
                                bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                                bool preferAwayFromEdge = use_inducement_linking and zoneHeight >= pip_size * 5.0
                                bool isNearEdge = preferAwayFromEdge and distFromZone < pip_size * 2.0
                                bool improvesEdgeQuality = bestLiqNearEdge and not isNearEdge
                                bool sameEdgeQuality = bestLiqNearEdge == isNearEdge
                                if na(bestLiqBar) or improvesEdgeQuality or (sameEdgeQuality and (isCloser or (isSameDistance and isMoreRecent)))
                                    bestDist := distFromZone
                                    bestLiqPrice := pLow
                                    bestLiqBar := pBar
                                    bestLiqNearEdge := isNearEdge
                                    bestSource := "LOCAL"
                                else
                                    out := recordRejectedLiquidityCandidate(out, pBar, pLow, "LOCAL_NOT_CLOSEST")
                            else
                                out := recordRejectedLiquidityCandidate(out, pBar, pLow, "LOCAL_TOO_FAR")
                        else
                            out := recordRejectedLiquidityCandidate(out, pBar, pLow, "LOCAL_WRONG_SIDE")

        if na(bestLiqBar)
            [originHighRefPrice, originHighRefBar, originHighRefDist] = demandOriginHighReferenceLiquidity(out)
            if not na(originHighRefPrice) and not na(originHighRefBar)
                bestDist := originHighRefDist
                bestLiqPrice := originHighRefPrice
                bestLiqBar := originHighRefBar
                bestSource := "ORIGIN_HIGH_REFERENCE"
        if na(bestLiqBar)
            [ownOriginPrice, ownOriginBar, ownOriginDist] = demandOwnOriginLiquidity(out)
            if not na(ownOriginPrice) and not na(ownOriginBar)
                bestDist := ownOriginDist
                bestLiqPrice := ownOriginPrice
                bestLiqBar := ownOriginBar
                bestSource := "OWN_ORIGIN"

        if not na(bestLiqBar) and bestLiqPrice < 1.0e10
            bool inductionChanged = na(out.liqLowPrice) or out.liqLowPrice != bestLiqPrice or na(out.liqLowBar) or out.liqLowBar != bestLiqBar
            out.liquidityPrice := bestLiqPrice
            out.liquidityBarIndex := bestLiqBar
            out.liqLowPrice := bestLiqPrice
            out.liqLowBar := bestLiqBar
            if inductionChanged
                out.liquiditySwept := false
                out.liquiditySweepBar := na
                out.liquidityLineSweepBar := na

            int rangeStart = out.createdBar
            int rangeEnd = bestLiqBar - 1
            float bestTargetPrice = na
            int bestTargetBar = na
            if rangeEnd >= rangeStart and rangeEnd <= bar_index and rangeStart >= 0
                bestTargetBar := getBarOfMaxHigh(rangeStart, rangeEnd)
                if not na(bestTargetBar) and bestTargetBar >= rangeStart and bestTargetBar <= rangeEnd
                    int targetOffset = bar_index - bestTargetBar
                    if targetOffset >= 0 and targetOffset < 5000
                        bestTargetPrice := high[targetOffset]

            bool targetChanged = na(out.liqHighPrice) or out.liqHighPrice != bestTargetPrice or na(out.liqHighBar) or out.liqHighBar != bestTargetBar
            out.liqHighBar := bestTargetBar
            out.liqHighPrice := bestTargetPrice
            if targetChanged
                out.targetSwept := false
                out.targetSweepBar := na
            out.structureSweepLevel := out.liqHighPrice
            out.structureSweepLevelBar := out.liqHighBar

            int demandLegStart = na
            int demandLegEnd = na
            int demandLegCount = 0
            if not na(out.liqLowBar) and not na(out.liqHighBar)
                demandLegStart := math.min(out.liqLowBar, out.liqHighBar)
                demandLegEnd := math.max(out.liqLowBar, out.liqHighBar)
                demandLegCount := countOppCandlesInLiquidityRange(demandLegStart, demandLegEnd, true, out.liqLowPrice, out.liqHighPrice)
            out.liquidityCandleCount := demandLegCount
            out.legCandles := demandLegCount
            int minLegCandles = enableOneCandleLiquidity ? 1 : 2
            bool hasStrongLeg = bestSource == "ORIGIN_HIGH_REFERENCE" or bestSource == "OWN_ORIGIN" ? true : demandLegCount >= minLegCandles
            out.liquidityValid := hasStrongLeg
            out.inactiveReason := hasStrongLeg ? na : "WAITING_STRONG_LIQUIDITY"
            out.liqSource := str.length(bestSource) > 0 ? bestSource : "PIVOT"
            out.liquidityDistanceFromZone := bestDist
            out.liquidityDecisionReason := bestSource == "REFERENCE" ? "SELECTED_REFERENCE_CLOSEST" : bestSource == "LOCAL" ? "SELECTED_LOCAL_FALLBACK" : bestSource == "ORIGIN_HIGH_REFERENCE" ? "SELECTED_ORIGIN_HIGH_REFERENCE" : bestSource == "OWN_ORIGIN" ? "SELECTED_OWN_ORIGIN" : "SELECTED_PIVOT_CLOSEST"
            int indOff = bar_index - bestLiqBar
            int tgtOff = na(out.liqHighBar) ? na : (bar_index - out.liqHighBar)
            out.liqLowTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            out.liqHighTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na
        else
            out.liquidityValid := false
            out.inactiveReason := "WAITING_PIVOT"
            out.liquidityDecisionReason := "WAITING_PIVOT"
        out

f_scan_supply_liquidity(RawZone z) =>
    RawZone out = z
    bool retracementRescanAllowed = use_inducement_linking and enableOneCandleLiquidity and out.liqSource != "RETRACEMENT" and not out.liquiditySwept
    if not out.active or out.demand or ((out.liquidityValid or out.targetSwept) and not retracementRescanAllowed) or out.liquiditySwept
        out
    else if out.liqSource == TOUCH_SWEEP_SOURCE and not na(out.liquidityPrice)
        out
    else if na(out.createdBar) or bar_index <= out.createdBar
        out
    else
        out := clearLiquidityDebugState(out)
        float bestLiqPrice = 0.0
        int bestLiqBar = na
        float bestDist = 1.0e10
        string bestSource = ""
        bool bestLiqBelowTop = false
        float maxDistPrice = na
        int scanStartBar = liquidityScanStartBar(out)
        int maxOff = math.min(MAX_LIQ_SCAN_BARS, bar_index - scanStartBar - pivotLen)
        int referenceCount = array.size(referenceLiquidityPrices)

        if referenceCount > 0
            for refIdx = 0 to referenceCount - 1
                float pHigh = array.get(referenceLiquidityPrices, refIdx)
                int pBar = array.get(referenceLiquidityBars, refIdx)
                bool isDemandReference = array.get(referenceLiquidityDemand, refIdx)
                bool isSweptReference = array.get(referenceLiquiditySwept, refIdx)
                bool referenceCanSeed = referenceLiquidityCanSeedZone(out, pBar, isSweptReference)
                if not isDemandReference and referenceCanSeed and not na(pHigh) and not na(pBar) and pBar >= scanStartBar and pBar <= bar_index
                    bool isValidLocation = false
                    float distFromZone = 0.0
                    bool candidateBelowTop = false
                    if use_inducement_linking
                        candidateBelowTop := pHigh <= out.top + (syminfo.mintick * equalLiquidityToleranceTicks)
                        isValidLocation := true
                        distFromZone := candidateBelowTop ? math.max(0.0, out.top - pHigh) : pHigh - out.top
                    else
                        isValidLocation := pHigh > out.top
                        distFromZone := pHigh - out.top
                    if isValidLocation
                        bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice
                        if distOK
                            float distFromZoneCheck = distFromZone
                            bool isCloser = distFromZoneCheck < bestDist
                            bool isSameDistance = distFromZoneCheck == bestDist
                            bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                            bool improvesSide = use_inducement_linking and candidateBelowTop and not bestLiqBelowTop
                            bool sameSide = not use_inducement_linking or candidateBelowTop == bestLiqBelowTop
                            if na(bestLiqBar) or improvesSide or (sameSide and (isCloser or (isSameDistance and isMoreRecent)))
                                bestDist := distFromZoneCheck
                                bestLiqPrice := pHigh
                                bestLiqBar := pBar
                                bestLiqBelowTop := candidateBelowTop
                                bestSource := "REFERENCE"
                            else
                                out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "REFERENCE_NOT_CLOSEST")
                        else
                            out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "REFERENCE_TOO_FAR")
                    else
                        out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "REFERENCE_WRONG_SIDE")
                else if not isDemandReference and isSweptReference and not referenceCanSeed
                    out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "REFERENCE_ALREADY_SWEPT")

        if maxOff >= 0
            for off = 0 to maxOff
                float pHigh = pHighSeries[off]
                if not na(pHigh)
                    int pBar = bar_index - off - pivotLen
                    if pBar >= scanStartBar
                        bool isValidLocation = false
                        float distFromZone = 0.0
                        bool candidateBelowTop = false
                        if use_inducement_linking
                            candidateBelowTop := pHigh <= out.top + (syminfo.mintick * equalLiquidityToleranceTicks)
                            isValidLocation := true
                            distFromZone := candidateBelowTop ? math.max(0.0, out.top - pHigh) : pHigh - out.top
                        else
                            isValidLocation := pHigh > out.top
                            distFromZone := pHigh - out.top
                        if isValidLocation
                            float distFromZoneCheck = distFromZone
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZoneCheck <= maxDistPrice
                            if distOK
                                bool isCloser = distFromZoneCheck < bestDist
                                bool isSameDistance = distFromZoneCheck == bestDist
                                bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                                bool improvesSide = use_inducement_linking and candidateBelowTop and not bestLiqBelowTop
                                bool sameSide = not use_inducement_linking or candidateBelowTop == bestLiqBelowTop
                                if na(bestLiqBar) or improvesSide or (sameSide and (isCloser or (isSameDistance and isMoreRecent)))
                                    bestDist := distFromZoneCheck
                                    bestLiqPrice := pHigh
                                    bestLiqBar := pBar
                                    bestLiqBelowTop := candidateBelowTop
                                    bestSource := "PIVOT"
                                else
                                    out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "NOT_CLOSEST")
                            else
                                out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "TOO_FAR")
                        else
                            out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "WRONG_SIDE")

        if enableOneCandleLiquidity
            int localPivotCount = array.size(liqPvtHighPrices)
            if localPivotCount > 0
                for pivotIdx = 0 to localPivotCount - 1
                    float pHigh = array.get(liqPvtHighPrices, pivotIdx)
                    int pBar = array.get(liqPvtHighBars, pivotIdx)
                    if not na(pHigh) and not na(pBar) and pBar >= scanStartBar and pBar <= bar_index
                        bool isValidLocation = false
                        float distFromZone = 0.0
                        bool candidateBelowTop = false
                        if use_inducement_linking
                            candidateBelowTop := pHigh <= out.top + (syminfo.mintick * equalLiquidityToleranceTicks)
                            isValidLocation := true
                            distFromZone := candidateBelowTop ? math.max(0.0, out.top - pHigh) : pHigh - out.top
                        else
                            isValidLocation := pHigh > out.top
                            distFromZone := pHigh - out.top
                        if isValidLocation
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice
                            if distOK
                                float distFromZoneCheck = distFromZone
                                bool isCloser = distFromZoneCheck < bestDist
                                bool isSameDistance = distFromZoneCheck == bestDist
                                bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                                bool improvesSide = use_inducement_linking and candidateBelowTop and not bestLiqBelowTop
                                bool sameSide = not use_inducement_linking or candidateBelowTop == bestLiqBelowTop
                                if na(bestLiqBar) or improvesSide or (sameSide and (isCloser or (isSameDistance and isMoreRecent)))
                                    bestDist := distFromZoneCheck
                                    bestLiqPrice := pHigh
                                    bestLiqBar := pBar
                                    bestLiqBelowTop := candidateBelowTop
                                    bestSource := "LOCAL"
                                else
                                    out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "LOCAL_NOT_CLOSEST")
                            else
                                out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "LOCAL_TOO_FAR")
                        else
                            out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "LOCAL_WRONG_SIDE")

        if use_inducement_linking and enableOneCandleLiquidity
            int maxRetracementOff = math.min(MAX_LIQ_SCAN_BARS, bar_index - scanStartBar)
            if maxRetracementOff >= 1
                for off = 1 to maxRetracementOff
                    if supplyOneCandleRetracementLiquidityAt(off)
                        float pHigh = high[off]
                        int pBar = bar_index - off
                        if not na(pHigh) and pBar >= scanStartBar
                            bool candidateBelowTop = pHigh <= out.top + (syminfo.mintick * equalLiquidityToleranceTicks)
                            float distFromZone = candidateBelowTop ? math.max(0.0, out.top - pHigh) : pHigh - out.top
                            bool bestIsRetracement = bestSource == "RETRACEMENT"
                            bool isCloser = distFromZone < bestDist
                            bool isSameDistance = distFromZone == bestDist
                            bool isMoreRecent = na(bestLiqBar) or pBar > bestLiqBar
                            bool improvesSide = candidateBelowTop and not bestLiqBelowTop
                            bool sameSide = candidateBelowTop == bestLiqBelowTop
                            if na(bestLiqBar) or improvesSide or (sameSide and (not bestIsRetracement or isCloser or (isSameDistance and isMoreRecent)))
                                bestDist := distFromZone
                                bestLiqPrice := pHigh
                                bestLiqBar := pBar
                                bestLiqBelowTop := candidateBelowTop
                                bestSource := "RETRACEMENT"
                            else
                                out := recordRejectedLiquidityCandidate(out, pBar, pHigh, "RETRACEMENT_NOT_CLOSEST")

        [ownOriginPrice, ownOriginBar, ownOriginDist] = supplyOwnOriginLiquidity(out)
        if not na(ownOriginPrice) and not na(ownOriginBar) and na(bestLiqBar)
            bestDist := ownOriginDist
            bestLiqPrice := ownOriginPrice
            bestLiqBar := ownOriginBar
            bestSource := "OWN_ORIGIN"

        if not na(bestLiqBar) and bestLiqPrice > 0.0
            bool inductionChanged = na(out.liqHighPrice) or out.liqHighPrice != bestLiqPrice or na(out.liqHighBar) or out.liqHighBar != bestLiqBar
            out.liquidityPrice := bestLiqPrice
            out.liquidityBarIndex := bestLiqBar
            out.liqHighPrice := bestLiqPrice
            out.liqHighBar := bestLiqBar
            if inductionChanged
                out.liquiditySwept := false
                out.liquiditySweepBar := na
                out.liquidityLineSweepBar := na

            int rangeStart = out.createdBar
            int rangeEnd = bestLiqBar - 1
            float bestTargetPrice = na
            int bestTargetBar = na
            if rangeEnd >= rangeStart and rangeEnd <= bar_index and rangeStart >= 0
                bestTargetBar := getBarOfMinLow(rangeStart, rangeEnd)
                if not na(bestTargetBar) and bestTargetBar >= rangeStart and bestTargetBar <= rangeEnd
                    int targetOffset = bar_index - bestTargetBar
                    if targetOffset >= 0 and targetOffset < 5000
                        bestTargetPrice := low[targetOffset]

            bool targetChanged = na(out.liqLowPrice) or out.liqLowPrice != bestTargetPrice or na(out.liqLowBar) or out.liqLowBar != bestTargetBar
            out.liqLowBar := bestTargetBar
            out.liqLowPrice := bestTargetPrice
            if targetChanged
                out.targetSwept := false
                out.targetSweepBar := na
            out.structureSweepLevel := out.liqLowPrice
            out.structureSweepLevelBar := out.liqLowBar

            int supplyLegStart = na
            int supplyLegEnd = na
            int supplyLegCount = 0
            if not na(out.liqLowBar) and not na(out.liqHighBar)
                supplyLegStart := math.min(out.liqLowBar, out.liqHighBar)
                supplyLegEnd := math.max(out.liqLowBar, out.liqHighBar)
                supplyLegCount := countOppCandlesInLiquidityRange(supplyLegStart, supplyLegEnd, false, out.liqLowPrice, out.liqHighPrice)
            out.liquidityCandleCount := supplyLegCount
            out.legCandles := supplyLegCount
            int minLegCandles = enableOneCandleLiquidity ? 1 : 2
            bool hasStrongLeg = bestSource == "OWN_ORIGIN" ? true : supplyLegCount >= minLegCandles
            out.liquidityValid := hasStrongLeg
            out.inactiveReason := hasStrongLeg ? na : "WAITING_STRONG_LIQUIDITY"
            out.liqSource := str.length(bestSource) > 0 ? bestSource : "PIVOT"
            out.liquidityDistanceFromZone := bestDist
            out.liquidityDecisionReason := bestSource == "REFERENCE" ? "SELECTED_REFERENCE_CLOSEST" : bestSource == "LOCAL" ? "SELECTED_LOCAL_FALLBACK" : bestSource == "OWN_ORIGIN" ? "SELECTED_OWN_ORIGIN" : "SELECTED_PIVOT_CLOSEST"
            int indOff = bar_index - bestLiqBar
            int tgtOff = na(out.liqLowBar) ? na : (bar_index - out.liqLowBar)
            out.liqHighTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            out.liqLowTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na
        else
            out.liquidityValid := false
            out.inactiveReason := "WAITING_PIVOT"
            out.liquidityDecisionReason := "WAITING_PIVOT"
        out

clearStrategyLiquidityState(RawZone z, string reason) =>
    RawZone out = z
    out.liquidityPrice := na
    out.liquidityBarIndex := na
    out.liqLowPrice := na
    out.liqLowBar := na
    out.liqHighPrice := na
    out.liqHighBar := na
    out.liquiditySwept := false
    out.targetSwept := false
    out.targetFromOneCandle := false
    out.liquiditySweepBar := na
    out.targetSweepBar := na
    out.liquidityLineSweepBar := na
    out.structureSweepLevel := na
    out.structureSweepLevelBar := na
    out.liquidityValid := false
    out.liquidityLinked := false
    out.liquidityCandleCount := 0
    out.liqLowTime := na
    out.liqHighTime := na
    out.liqSource := na
    out := clearLiquidityDebugState(out)
    if not na(out.liquidityCompareLabel)
        label.delete(out.liquidityCompareLabel)
        out.liquidityCompareLabel := na
    out.inactiveReason := reason
    out := removeLiquidityLine(out)
    out := removeTargetLine(out)
    out

strategyLiquidityWrongSide(RawZone z) =>
    bool isInvalid = false
    if not na(z.liquidityPrice) and z.liqSource != TOUCH_SWEEP_SOURCE
        float sideTol = syminfo.mintick * equalLiquidityToleranceTicks
        bool ownOriginLiquidity = liquidityCandidateIsOwnOrigin(z, z.liquidityBarIndex, z.liquidityPrice)
        if z.demand
            isInvalid := not ownOriginLiquidity and (use_inducement_linking ? z.liquidityPrice < z.top - sideTol : z.liquidityPrice > z.bottom + sideTol)
        else
            isInvalid := not ownOriginLiquidity and (use_inducement_linking ? false : z.liquidityPrice < z.top - sideTol)
    isInvalid

strategyLiquidityGhostData(RawZone z) =>
    not na(z.liquidityBarIndex) and z.liquidityBarIndex > bar_index

applyDemandTouchSweepLiquidity(RawZone z) =>
    RawZone out = z
    bool sweptNow = false
    if use_zone_touch_sweep_liq and out.active and out.liqSource != TOUCH_SWEEP_SOURCE and not out.liquiditySwept
        [touchLiqPrice, touchLiqBar] = findDemandTouchLiquidity(out)
        if not na(touchLiqPrice) and not na(touchLiqBar)
            out := removeLiquidityLine(out)
            out := removeTargetLine(out)
            out.liqSource := TOUCH_SWEEP_SOURCE
            out.liquidityPrice := touchLiqPrice
            out.liquidityBarIndex := touchLiqBar
            out.liqLowPrice := touchLiqPrice
            out.liqLowBar := touchLiqBar
            int targetBar = getBarOfMaxHigh(out.createdBar, bar_index - 1)
            int targetOff = bar_index - targetBar
            out.liqHighBar := targetBar
            out.liqHighPrice := targetOff >= 0 and targetOff <= bar_index ? high[targetOff] : na
            out.structureSweepLevel := touchLiqPrice
            out.structureSweepLevelBar := touchLiqBar
            out.liquidityValid := true
            out.liquiditySwept := true
            out.liquiditySweepBar := bar_index
            out.liquidityLineSweepBar := bar_index
            out.liquidityCandleCount := 1
            out.legCandles := 1
            out.inactiveReason := na
            out.liquidityLinked := liquidityProofReady(out)
            out.liquidityDistanceFromZone := liquidityDistanceFromZoneValue(out, touchLiqPrice)
            out.liquidityDecisionReason := "SELECTED_TOUCH_SWEEP"
            int indOff = bar_index - touchLiqBar
            int tgtOff = na(out.liqHighBar) ? na : (bar_index - out.liqHighBar)
            out.liqLowTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            out.liqHighTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na
            sweptNow := true
    [out, sweptNow]

applySupplyTouchSweepLiquidity(RawZone z) =>
    RawZone out = z
    bool sweptNow = false
    if use_zone_touch_sweep_liq and out.active and out.liqSource != TOUCH_SWEEP_SOURCE and not out.liquiditySwept
        [touchLiqPrice, touchLiqBar] = findSupplyTouchLiquidity(out)
        if not na(touchLiqPrice) and not na(touchLiqBar)
            out := removeLiquidityLine(out)
            out := removeTargetLine(out)
            out.liqSource := TOUCH_SWEEP_SOURCE
            out.liquidityPrice := touchLiqPrice
            out.liquidityBarIndex := touchLiqBar
            out.liqHighPrice := touchLiqPrice
            out.liqHighBar := touchLiqBar
            int targetBar = getBarOfMinLow(out.createdBar, bar_index - 1)
            int targetOff = bar_index - targetBar
            out.liqLowBar := targetBar
            out.liqLowPrice := targetOff >= 0 and targetOff <= bar_index ? low[targetOff] : na
            out.structureSweepLevel := touchLiqPrice
            out.structureSweepLevelBar := touchLiqBar
            out.liquidityValid := true
            out.liquiditySwept := true
            out.liquiditySweepBar := bar_index
            out.liquidityLineSweepBar := bar_index
            out.liquidityCandleCount := 1
            out.legCandles := 1
            out.inactiveReason := na
            out.liquidityLinked := liquidityProofReady(out)
            out.liquidityDistanceFromZone := liquidityDistanceFromZoneValue(out, touchLiqPrice)
            out.liquidityDecisionReason := "SELECTED_TOUCH_SWEEP"
            int indOff = bar_index - touchLiqBar
            int tgtOff = na(out.liqLowBar) ? na : (bar_index - out.liqLowBar)
            out.liqHighTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            out.liqLowTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na
            sweptNow := true
    [out, sweptNow]

linkLiquidityAndTargets(RawZone z, float pivotLow, int pivotLowBar, float pivotHigh, int pivotHighBar, float targetPivotHigh, int targetPivotHighBar, float targetPivotLow, int targetPivotLowBar) =>
    RawZone out = z
    bool wasLinked = z.liquidityLinked
    bool linkedNow = false
    out := clearStaleLiquidityInsideNewerZone(out)
    if out.active
        if strategyLiquidityWrongSide(out)
            out := clearStrategyLiquidityState(out, "LIQ_WRONG_SIDE")
        if strategyLiquidityGhostData(out)
            out := clearStrategyLiquidityState(out, "GHOST_LIQUIDITY_CLEARED")

        RawZone demandScan = f_scan_demand_liquidity(out)
        RawZone supplyScan = f_scan_supply_liquidity(out)
        bool hasTouchSweepLiq = out.liqSource == TOUCH_SWEEP_SOURCE and not na(out.liquidityPrice)
        if not out.liquidityValid and not hasTouchSweepLiq
            out := out.demand ? demandScan : supplyScan

        out.liquidityLinked := liquidityProofReady(out)

        linkedNow := out.liquidityLinked and not wasLinked
    [out, linkedNow]

processZone(RawZone z) =>
    RawZone out = z
    bool invalidateNow = false
    bool touchedNow = false
    bool liquiditySweptNow = false
    bool targetSweptNow = false

    if out.active
        if not na(out.zoneBox)
            box.set_right(out.zoneBox, zoneRightBar(out))

        bool afterCreated = not na(out.createdBar) and bar_index > out.createdBar
        int effectiveInvalidationStartBar = not na(out.invalidationStartBar) ? out.invalidationStartBar : (not na(out.confirmationBar) ? out.confirmationBar + 1 : out.createdBar + 1)
        bool afterConfirmation = not na(effectiveInvalidationStartBar) and bar_index >= effectiveInvalidationStartBar
        bool overlapsZone = high >= out.bottom and low <= out.top
        bool closeInsideZone = afterCreated and close <= out.top and close >= out.bottom
        bool expiredByAge = afterCreated and bar_index - out.createdBar > maxZoneAgeBars
        bool mitigationTouch = afterCreated and overlapsZone

        if out.demand
            if not out.leftZone and high > out.top
                out.leftZone := true
            if afterConfirmation and not out.runtimeLeftZoneAfterConfirmation and high > out.top
                out.runtimeLeftZoneAfterConfirmation := true
            bool canJudgeInvalidation = afterConfirmation and out.runtimeLeftZoneAfterConfirmation
            bool wicksIntoZone = low <= out.top and low >= out.bottom
            if canJudgeInvalidation and afterCreated and (closeInsideZone or wicksIntoZone) and not out.liquiditySwept
                [touchOut, touchSweepNow] = applyDemandTouchSweepLiquidity(out)
                out := touchOut
                if touchSweepNow
                    liquiditySweptNow := true

            if liquidityLineSweptOnThisBar(out)
                out.liquiditySwept := true
                out.liquiditySweepBar := bar_index
                out.liquidityLineSweepBar := bar_index
                liquiditySweptNow := true

            if targetLineSweptOnThisBar(out)
                out.targetSwept := true
                out.targetSweepBar := bar_index
                targetSweptNow := true

            bool proofReadyOnOrBeforeThisBar = liquidityProofReady(out) and not na(out.targetSweepBar) and out.targetSweepBar <= bar_index
            bool closeInsideZoneInvalidates = canJudgeInvalidation and closeInsideZone and not proofReadyOnOrBeforeThisBar
            bool returnedBeforeSweep = canJudgeInvalidation and overlapsZone and not proofReadyOnOrBeforeThisBar
            bool closeBreakInvalidates = canJudgeInvalidation and close < out.bottom and not proofReadyOnOrBeforeThisBar
            bool wickBreak = canJudgeInvalidation and invalidateOnWick and low < out.bottom and not proofReadyOnOrBeforeThisBar
            bool mitigatedAfterValidSweep = proofReadyOnOrBeforeThisBar and mitigationTouch
            invalidateNow := closeInsideZoneInvalidates or closeBreakInvalidates or (not mitigatedAfterValidSweep and (expiredByAge or returnedBeforeSweep or wickBreak))

        else
            if not out.leftZone and low < out.bottom
                out.leftZone := true
            if afterConfirmation and not out.runtimeLeftZoneAfterConfirmation and low < out.bottom
                out.runtimeLeftZoneAfterConfirmation := true
            bool canJudgeInvalidation = afterConfirmation and out.runtimeLeftZoneAfterConfirmation
            bool wicksIntoZone = high >= out.bottom and high <= out.top
            bool bullishWickTouchesSupplyFromBelow = canJudgeInvalidation and isBullish(0) and close < out.bottom and high >= out.bottom
            bool bullishWickTouchBeforeSweep = bullishWickTouchesSupplyFromBelow and not closeInsideZone
            if canJudgeInvalidation and afterCreated and (closeInsideZone or wicksIntoZone) and not out.liquiditySwept and not bullishWickTouchBeforeSweep
                [touchOut, touchSweepNow] = applySupplyTouchSweepLiquidity(out)
                out := touchOut
                if touchSweepNow
                    liquiditySweptNow := true

            if liquidityLineSweptOnThisBar(out)
                out.liquiditySwept := true
                out.liquiditySweepBar := bar_index
                out.liquidityLineSweepBar := bar_index
                liquiditySweptNow := true

            if targetLineSweptOnThisBar(out)
                out.targetSwept := true
                out.targetSweepBar := bar_index
                targetSweptNow := true

            bool proofReadyOnOrBeforeThisBar = liquidityProofReady(out) and not na(out.targetSweepBar) and out.targetSweepBar <= bar_index
            bool touchSweepProofReady = proofReadyOnOrBeforeThisBar and out.liqSource == TOUCH_SWEEP_SOURCE
            bool closeInsideZoneInvalidates = canJudgeInvalidation and closeInsideZone and not proofReadyOnOrBeforeThisBar
            bool returnedBeforeSweep = canJudgeInvalidation and overlapsZone and not proofReadyOnOrBeforeThisBar
            bool supplyWickTouchInvalidates = bullishWickTouchBeforeSweep and (not proofReadyOnOrBeforeThisBar or touchSweepProofReady)
            bool closeBreakInvalidates = canJudgeInvalidation and close > out.top and not proofReadyOnOrBeforeThisBar
            bool wickBreak = canJudgeInvalidation and invalidateOnWick and high > out.top and not proofReadyOnOrBeforeThisBar
            bool mitigatedAfterValidSweep = proofReadyOnOrBeforeThisBar and mitigationTouch
            bool returnedInvalidates = returnedBeforeSweep and not is_gold
            invalidateNow := closeInsideZoneInvalidates or closeBreakInvalidates or supplyWickTouchInvalidates or (not mitigatedAfterValidSweep and (expiredByAge or returnedInvalidates or wickBreak))

        if not invalidateNow
            string noInvalidationReason = INVALIDATION_VALID_STILL_ACTIVE
            if not afterCreated
                noInvalidationReason := INVALIDATION_NOT_AFTER_CREATED
            else if not out.runtimeLeftZoneAfterConfirmation
                noInvalidationReason := INVALIDATION_NOT_LEFT_ZONE
            else if not overlapsZone
                noInvalidationReason := INVALIDATION_NO_ZONE_OVERLAP
            else if out.liquiditySwept
                noInvalidationReason := INVALIDATION_LIQUIDITY_ALREADY_SWEPT
            out.lastInvalidationCheckReason := noInvalidationReason

        if not out.touched and overlapsZone and bar_index > out.originBar
            out.touched := true
            touchedNow := true

        bool finalProofReadyOnOrBeforeThisBar = liquidityProofReady(out) and not na(out.targetSweepBar) and out.targetSweepBar <= bar_index
        bool finalMitigatedAfterValidSweep = finalProofReadyOnOrBeforeThisBar and mitigationTouch
        if not invalidateNow and finalMitigatedAfterValidSweep
            out.active := false
            out.inactiveReason := "MITIGATED_AFTER_SWEEP"
            out.lastInvalidationCheckReason := out.inactiveReason
            out.zoneMitigationBar := bar_index
            if not na(out.zoneBox)
                box.set_right(out.zoneBox, zoneRightBar(out))

        if invalidateNow
            out.active := false
            out.inactiveReason := expiredByAge ? "MAX_AGE" : "RETURNED_OR_BROKE_BEFORE_SWEEP"
            out.lastInvalidationCheckReason := out.inactiveReason
            out.zoneDisplayStopBar := bar_index
            if not na(out.zoneBox)
                box.set_right(out.zoneBox, zoneRightBar(out))
            if not showInactiveZoneDebug
                deleteZoneDrawings(out)
                out.zoneBox := na
                out.liquidityLine := na
                out.targetLine := na

    updateZoneBox(out)
    updateZoneLines(out)
    [out, liquiditySweptNow, targetSweptNow, touchedNow, invalidateNow]

processExistingZones(bool canProcess, float pivotLowValue, int pivotLowBarValue, float pivotHighValue, int pivotHighBarValue, float targetPivotHighValue, int targetPivotHighBarValue, float targetPivotLowValue, int targetPivotLowBarValue) =>
    if canProcess
        int zoneCount = array.size(zones)
        if zoneCount > 0
            for i = zoneCount - 1 to 0
                RawZone z = array.get(zones, i)
                [linkedZone, linkedNow] = linkLiquidityAndTargets(z, pivotLowValue, pivotLowBarValue, pivotHighValue, pivotHighBarValue, targetPivotHighValue, targetPivotHighBarValue, targetPivotLowValue, targetPivotLowBarValue)
                if linkedNow
                    sendEvent("LIQUIDITY_LINKED", linkedZone)

                [processedZone, liquiditySweptNow, targetSweptNow, touchedNow, invalidatedNow] = processZone(linkedZone)
                if liquiditySweptNow
                    sendEvent("LIQUIDITY_SWEPT", processedZone)
                if targetSweptNow
                    sendEvent("TARGET_SWEPT", processedZone)
                if touchedNow
                    sendEvent("ZONE_TOUCHED", processedZone)
                if invalidatedNow
                    sendEvent("ZONE_INVALIDATED", processedZone)
                array.set(zones, i, processedZone)
    true

pivotLow = ta.pivotlow(low, pivotLen, pivotLen)
pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
targetPivotHigh = ta.pivothigh(high, 1, 1)
targetPivotLow = ta.pivotlow(low, 1, 1)
withinRuntimeWindow = bar_index >= last_bar_index - runtimeLookbackBars
int pivotLowBar = bar_index - pivotLen
int pivotHighBar = bar_index - pivotLen
int targetPivotHighBar = bar_index - 1
int targetPivotLowBar = bar_index - 1
canProcessRuntime = withinRuntimeWindow and barstate.isconfirmed and isPrimaryFiveMinute

if canProcessRuntime
    [demandValid, demandBaseIdx, demandConfirmationIdx, demandOriginBar, demandLegCandles, demandModel, demandTop, demandBottom, demandRejectReason] = resolveZoneCandidate(true, false)
    if demandValid
        int demandConfirmationBar = bar_index - demandConfirmationIdx
        [demandCreated, demandDuplicateSkipped] = createZone(demandBaseIdx, true, nextZoneId, demandLegCandles, demandModel, demandConfirmationBar)
        if demandCreated
            nextZoneId += 1

    if accSuppressedSymbol() and isBullish(0)
        int historicalDemandMaxBaseIdx = math.min(maxZoneAgeBars, bar_index - 1)
        bool historicalDemandCreatedAny = false
        if historicalDemandMaxBaseIdx > 0
            for historicalDemandBaseIdx = 1 to historicalDemandMaxBaseIdx
                if historicalDemandCreatedAny
                    break
                [historicalDemandValid, historicalDemandConfirmationIdx, historicalDemandLegCandles, historicalDemandRejectReason] = resolveHistoricalSuppressedStandardDemandCandidateAt(historicalDemandBaseIdx)
                if historicalDemandValid and historicalDemandConfirmationIdx == 0
                    [historicalDemandTop, historicalDemandBottom] = zoneBoundsForFinalModel(historicalDemandBaseIdx, true, historicalDemandLegCandles, MODEL_STANDARD)
                    bool historicalDemandBoundsValid = not na(historicalDemandTop) and not na(historicalDemandBottom) and historicalDemandTop > historicalDemandBottom
                    bool historicalDemandSeparated = historicalDemandBoundsValid and not hasActiveSimilarDemandZone(historicalDemandTop, historicalDemandBottom)
                    if historicalDemandSeparated
                        int historicalDemandConfirmationBar = bar_index
                        [historicalDemandCreated, historicalDemandDuplicateSkipped] = createZone(historicalDemandBaseIdx, true, nextZoneId, historicalDemandLegCandles, MODEL_STANDARD, historicalDemandConfirmationBar)
                        if historicalDemandCreated
                            nextZoneId += 1
                            historicalDemandCreatedAny := true

        int stackedDemandEventStartBar = currentEventConfirmationBar(true)
        int stackedDemandEventStartIdx = bar_index - stackedDemandEventStartBar
        int stackedDemandScanStart = math.max(stackedDemandEventStartIdx, 0)
        bool stackedDemandFoundOriginCluster = false
        int stackedDemandCreatedCount = 0
        for stackedDemandScan = 1 to formationLegScanBars
            int stackedDemandBaseIdx = stackedDemandScanStart + stackedDemandScan
            if stackedDemandBaseIdx >= bar_index or stackedDemandCreatedCount >= 2
                break

            if isValidBase(stackedDemandBaseIdx, true)
                stackedDemandFoundOriginCluster := true
                [stackedDemandValid, stackedDemandConfirmationIdx, stackedDemandLegCandles, stackedDemandRejectReason] = resolveStandardZoneCandidateAt(stackedDemandEventStartIdx, stackedDemandBaseIdx, true, 0)
                bool notPrimaryDemand = not demandValid or stackedDemandBaseIdx != demandBaseIdx
                if stackedDemandValid and notPrimaryDemand
                    int stackedDemandConfirmationBar = bar_index - stackedDemandConfirmationIdx
                    [stackedDemandCreated, stackedDemandDuplicateSkipped] = createZone(stackedDemandBaseIdx, true, nextZoneId, stackedDemandLegCandles, MODEL_STANDARD, stackedDemandConfirmationBar)
                    if stackedDemandCreated
                        nextZoneId += 1
                        stackedDemandCreatedCount += 1
            else if stackedDemandFoundOriginCluster
                bool stackedDemandOlderDirectionalBoundary = isBullish(stackedDemandBaseIdx)
                if stackedDemandOlderDirectionalBoundary
                    break

    [demandContValid, demandContBaseIdx, demandContConfirmationIdx, demandContOriginBar, demandContLegCandles, demandContModel, demandContTop, demandContBottom, demandContRejectReason] = resolveZoneCandidate(true, true)
    if demandContValid
        int demandContConfirmationBar = bar_index - demandContConfirmationIdx
        [demandContCreated, demandContDuplicateSkipped] = createZone(demandContBaseIdx, true, nextZoneId, demandContLegCandles, demandContModel, demandContConfirmationBar)
        if demandContCreated
            nextZoneId += 1

    [supplyValid, supplyBaseIdx, supplyConfirmationIdx, supplyOriginBar, supplyLegCandles, supplyModel, supplyTop, supplyBottom, supplyRejectReason] = resolveZoneCandidate(false, false)
    if supplyValid
        int supplyConfirmationBar = bar_index - supplyConfirmationIdx
        [supplyCreated, supplyDuplicateSkipped] = createZone(supplyBaseIdx, false, nextZoneId, supplyLegCandles, supplyModel, supplyConfirmationBar)
        if supplyCreated
            nextZoneId += 1

    if accSuppressedSymbol() and isBearish(0)
        int historicalSupplyMaxBaseIdx = math.min(maxZoneAgeBars, bar_index - 1)
        bool historicalSupplyCreated = false
        if historicalSupplyMaxBaseIdx > 0
            for historicalSupplyBaseIdx = 1 to historicalSupplyMaxBaseIdx
                if historicalSupplyCreated
                    break
                [historicalSupplyValid, historicalSupplyConfirmationIdx, historicalSupplyLegCandles, historicalSupplyRejectReason] = resolveHistoricalSuppressedStandardSupplyCandidateAt(historicalSupplyBaseIdx)
                if historicalSupplyValid and historicalSupplyConfirmationIdx == 0
                    [historicalSupplyTop, historicalSupplyBottom] = zoneBoundsForFinalModel(historicalSupplyBaseIdx, false, historicalSupplyLegCandles, MODEL_STANDARD)
                    bool historicalSupplyBoundsValid = not na(historicalSupplyTop) and not na(historicalSupplyBottom) and historicalSupplyTop > historicalSupplyBottom
                    bool historicalSupplySeparated = historicalSupplyBoundsValid and not hasActiveSimilarSupplyZone(historicalSupplyTop, historicalSupplyBottom)
                    if historicalSupplySeparated
                        int historicalSupplyConfirmationBar = bar_index
                        [historicalSupplyZoneCreated, historicalSupplyDuplicateSkipped] = createZone(historicalSupplyBaseIdx, false, nextZoneId, historicalSupplyLegCandles, MODEL_STANDARD, historicalSupplyConfirmationBar)
                        if historicalSupplyZoneCreated
                            nextZoneId += 1
                            historicalSupplyCreated := true

    [supplyContValid, supplyContBaseIdx, supplyContConfirmationIdx, supplyContOriginBar, supplyContLegCandles, supplyContModel, supplyContTop, supplyContBottom, supplyContRejectReason] = resolveZoneCandidate(false, true)
    if supplyContValid
        int supplyContConfirmationBar = bar_index - supplyContConfirmationIdx
        [supplyContCreated, supplyContDuplicateSkipped] = createZone(supplyContBaseIdx, false, nextZoneId, supplyContLegCandles, supplyContModel, supplyContConfirmationBar)
        if supplyContCreated
            nextZoneId += 1

processExistingZones(canProcessRuntime, pivotLow, pivotLowBar, pivotHigh, pivotHighBar, targetPivotHigh, targetPivotHighBar, targetPivotLow, targetPivotLowBar)
liquidityDebugTable := updateLiquidityDebugTable(liquidityDebugTable)
