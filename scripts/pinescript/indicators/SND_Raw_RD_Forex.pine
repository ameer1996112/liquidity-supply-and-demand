const bool plotLiq = true
const bool invalidateOnWick = true
const string rawMode = "Lifecycle"
const bool showInactiveZones = false
const bool enableContinuationZones = true
const float maxZoneAgeHours = 26.0
const bool useAccuracyBounds = true
const bool rejectFormationRetouch = true
const bool use_zone_touch_sweep_liq = true
