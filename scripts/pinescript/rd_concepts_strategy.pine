// RD Concepts Liquidity Supply & Demand Strategy
// Timeframe: 5-minute | Instruments: GBPJPY, XAUUSD

//@version=5
strategy("RD Concepts Liquidity S&D Strategy",
     overlay = true,
     max_bars_back = 5000,
     max_labels_count = 500,
     initial_capital = 10000,
     currency = currency.USD,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 1,
     pyramiding = 0,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     margin_long = 1,
     margin_short = 1)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                         CONFIGURATION & INPUTS                                ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// === SYMBOL DETECTION ===
var bool IS_GOLD = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
var bool IS_JPY = str.contains(syminfo.ticker, "JPY")

// === AUTO PIP SIZE ===
get_pip_size() =>
    if IS_JPY
        0.01
    else if IS_GOLD
        0.1
    else
        0.0001

pip_size = get_pip_size()

// === USER INPUTS ===
// Strategy Settings
grp_strategy = "Strategy Settings"
risk_per_trade = input.float(1.0, "Risk Per Trade (%)", minval = 0.1, maxval = 10, step = 0.1, group = grp_strategy)
tp_rr_ratio = input.float(10.0, "Take Profit (R:R)", minval = 1.0, step = 0.5, group = grp_strategy, tooltip = "Fixed 10R target")
sl_buffer_ticks = input.int(5, "SL Buffer (Ticks)", minval = 0, maxval = 20, group = grp_strategy, tooltip = "SL placed this many ticks beyond candle extreme")
min_rr_ratio = input.float(2.0, "Minimum R:R Required", minval = 1.0, step = 0.5, group = grp_strategy, tooltip = "Trades with lower R:R will be blocked")
enable_trailing = input.bool(true, "Enable M1 Trailing Stop", group = grp_strategy, tooltip = "Trail SL using M1 candle structure after +1R")

// Market Structure
grp_structure = "Market Structure"
major_fractal_period = input.int(2, "Major Fractal Period", minval = 1, maxval = 5, group = grp_structure, tooltip = "5-candle fractal uses period 2 (2 left + 2 right)")
minor_fractal_period = input.int(1, "Minor Fractal Period", minval = 1, maxval = 3, group = grp_structure, tooltip = "3-candle fractal uses period 1 (1 left + 1 right)")

// Displacement Settings
grp_displacement = "Displacement & Order Blocks"
displacement_mult = input.float(1.5, "Displacement ATR Multiplier", minval = 1.0, maxval = 3.0, step = 0.1, group = grp_displacement)
max_zones = input.int(20, "Max Zones on Chart", minval = 5, maxval = 50, group = grp_displacement)

// Inducement Settings
grp_inducement = "Inducement Verification"
inducement_atr_dist = input.float(1.0, "Inducement ATR Distance", minval = 0.5, maxval = 3.0, step = 0.1, group = grp_inducement, tooltip = "Max ATR distance for inducement swing from zone")

// Time Filters
grp_time = "Time Filters"
enable_time_filter = input.bool(true, "Enable London Session Filter", group = grp_time)
london_start_hour = input.int(7, "London Start Hour (UTC)", minval = 0, maxval = 23, group = grp_time)
london_end_hour = input.int(9, "London End Hour (UTC)", minval = 0, maxval = 23, group = grp_time)
avoid_m30_close = input.bool(true, "Avoid M30 Close (5 min)", group = grp_time)
avoid_h1_close = input.bool(true, "Avoid H1 Close (10 min)", group = grp_time)

// ATR Filter (Volatility)
grp_volatility = "Volatility Filter"
enable_atr_filter = input.bool(true, "Enable ATR Volatility Filter", group = grp_volatility, tooltip = "Prevent entries during low-liquidity periods")
atr_min_threshold = input.float(0.5, "Min ATR Threshold (× Avg)", minval = 0.1, maxval = 1.0, step = 0.1, group = grp_volatility)

// Display Settings
grp_display = "Display"
show_zones = input.bool(true, "Show Zones", group = grp_display)
show_swings = input.bool(false, "Show Swing Points", group = grp_display)
show_inducement = input.bool(true, "Show Inducement Levels", group = grp_display)
show_signals = input.bool(true, "Show Entry Signals", group = grp_display)
demand_color = input.color(color.new(#26a69a, 70), "Demand Zone Color", group = grp_display)
supply_color = input.color(color.new(#ef5350, 70), "Supply Zone Color", group = grp_display)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                              DATA STRUCTURES                                  ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// === SWING POINT TYPE ===
type SwingPoint
    int   barIdx
    float price
    bool  isMajor
    bool  isHigh

// === ZONE TYPE ===
type Zone
    int    id
    box    boxId
    float  top
    float  bottom
    bool   active
    int    createdBar
    bool   untapped
    bool   isBodyOnly
    string state           // "FRESH" | "BAIT_CONFIRMED" | "READY_FOR_ENTRY"
    bool   isDemand
    
    // Setup candle data (for accuracy refinement)
    float  setupOpen
    float  setupClose
    float  setupHigh
    float  setupLow
    int    setupBar
    
    // Inducement tracking
    float  inducementLevel
    int    inducementBar
    float  internalLevel
    int    internalBar
    bool   inducementSwept
    
    // Visualization
    line   inducementLine
    line   internalLine
    label  stateLabel

// === GLOBAL ARRAYS ===
var SwingPoint[] majorSwingHighs = array.new<SwingPoint>()
var SwingPoint[] majorSwingLows = array.new<SwingPoint>()
var SwingPoint[] minorSwingHighs = array.new<SwingPoint>()
var SwingPoint[] minorSwingLows = array.new<SwingPoint>()
var Zone[] demandZones = array.new<Zone>()
var Zone[] supplyZones = array.new<Zone>()

// === GLOBAL STATE ===
var string currentTrend = "NEUTRAL"
var float lastMajorSwingHigh = na
var float lastMajorSwingLow = na
var int lastMajorSwingHighBar = na
var int lastMajorSwingLowBar = na
var int zoneIdCounter = 0

// === GLOBAL CALCULATIONS ===
atr14 = ta.atr(14)
atr50_avg = ta.sma(atr14, 50)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                        COMPONENT 1: MARKET STRUCTURE ENGINE                   ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// --- 1.1 Major Swing Detection (5-candle fractal) ---
// Swing High: High[i] > High[i-1], High[i-2], High[i+1], High[i+2]
f_is_major_swing_high(offset) =>
    high[offset] > high[offset - 1] and high[offset] > high[offset - 2] and high[offset] > high[offset + 1] and high[offset] > high[offset + 2]

f_is_major_swing_low(offset) =>
    low[offset] < low[offset - 1] and low[offset] < low[offset - 2] and low[offset] < low[offset + 1] and low[offset] < low[offset + 2]

// --- 1.2 Minor Swing Detection (3-candle fractal) ---
// Used for inducement identification
f_is_minor_swing_high(offset) =>
    high[offset] > high[offset - 1] and high[offset] > high[offset + 1]

f_is_minor_swing_low(offset) =>
    low[offset] < low[offset - 1] and low[offset] < low[offset + 1]

// --- 1.3 Detect and Store Swings ---
if barstate.isconfirmed
    // Major swings (check at offset 2 for 5-candle fractal)
    if f_is_major_swing_high(2)
        swing = SwingPoint.new(bar_index - 2, high[2], true, true)
        array.push(majorSwingHighs, swing)
        lastMajorSwingHigh := high[2]
        lastMajorSwingHighBar := bar_index - 2
        
        if show_swings
            label.new(bar_index - 2, high[2], "HH", style = label.style_label_down, color = color.new(color.red, 50), textcolor = color.white, size = size.tiny)
    
    if f_is_major_swing_low(2)
        swing = SwingPoint.new(bar_index - 2, low[2], true, false)
        array.push(majorSwingLows, swing)
        lastMajorSwingLow := low[2]
        lastMajorSwingLowBar := bar_index - 2
        
        if show_swings
            label.new(bar_index - 2, low[2], "LL", style = label.style_label_up, color = color.new(color.green, 50), textcolor = color.white, size = size.tiny)
    
    // Minor swings (check at offset 1 for 3-candle fractal)
    if f_is_minor_swing_high(1)
        swing = SwingPoint.new(bar_index - 1, high[1], false, true)
        array.push(minorSwingHighs, swing)
    
    if f_is_minor_swing_low(1)
        swing = SwingPoint.new(bar_index - 1, low[1], false, false)
        array.push(minorSwingLows, swing)

// --- 1.4 Break of Structure (BOS) Detection ---
// Bullish BOS: Close > last Swing High
// Bearish BOS: Close < last Swing Low
f_detect_bos() =>
    string newTrend = currentTrend
    
    if barstate.isconfirmed
        // Bullish BOS
        if not na(lastMajorSwingHigh) and close > lastMajorSwingHigh
            newTrend := "BULLISH"
        
        // Bearish BOS
        if not na(lastMajorSwingLow) and close < lastMajorSwingLow
            newTrend := "BEARISH"
    
    newTrend

currentTrend := f_detect_bos()

// --- 1.5 Prune Old Swings (keep last 100) ---
f_prune_swings() =>
    max_swings = 100
    while array.size(majorSwingHighs) > max_swings
        array.shift(majorSwingHighs)
    while array.size(majorSwingLows) > max_swings
        array.shift(majorSwingLows)
    while array.size(minorSwingHighs) > max_swings
        array.shift(minorSwingHighs)
    while array.size(minorSwingLows) > max_swings
        array.shift(minorSwingLows)

if barstate.isconfirmed
    f_prune_swings()

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                   COMPONENT 2: DISPLACEMENT & ORDER BLOCK DETECTION           ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// --- 2.1 Displacement Detection ---
// Displacement = candle body > 1.5 × ATR(14) AND creates FVG
f_is_bullish_displacement(idx) =>
    body = math.abs(close[idx] - open[idx])
    is_bullish = close[idx] > open[idx]
    is_large = body > atr14[idx] * displacement_mult
    is_bullish and is_large

f_is_bearish_displacement(idx) =>
    body = math.abs(close[idx] - open[idx])
    is_bearish = close[idx] < open[idx]
    is_large = body > atr14[idx] * displacement_mult
    is_bearish and is_large

// --- 2.2 Fair Value Gap Detection ---
// Bullish FVG: Low[i+2] > High[i] (gap up)
f_has_bullish_fvg(idx) =>
    low[idx] > high[idx + 2]

// Bearish FVG: High[i+2] < Low[i] (gap down)
f_has_bearish_fvg(idx) =>
    high[idx] < low[idx + 2]

// --- 2.3 Find Last Opposite Candle (Order Block) ---
// For bullish displacement: find last bearish candle
// For bearish displacement: find last bullish candle
f_find_last_bearish_candle(from_offset) =>
    int result_offset = na
    for i = from_offset to from_offset + 10
        if i > 200
            break
        if close[i] < open[i]  // Bearish candle
            result_offset := i
            break
    result_offset

f_find_last_bullish_candle(from_offset) =>
    int result_offset = na
    for i = from_offset to from_offset + 10
        if i > 200
            break
        if close[i] > open[i]  // Bullish candle
            result_offset := i
            break
    result_offset

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                        COMPONENT 3: ACCURACY REFINEMENT                       ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// Compare Setup Candle vs Release Candle to determine zone type
// If setup wick overlaps release body OR release opens inside setup → Body-Only Zone
// Else → Full Wick Zone

f_calculate_zone_boundaries(setup_open, setup_close, setup_high, setup_low, release_open, release_close, release_high, release_low, is_demand) =>
    float zone_top = na
    float zone_bottom = na
    bool is_body_only = false
    
    // Check for overlap conditions
    setup_body_top = math.max(setup_open, setup_close)
    setup_body_bottom = math.min(setup_open, setup_close)
    release_body_top = math.max(release_open, release_close)
    release_body_bottom = math.min(release_open, release_close)
    
    // Condition 1: Setup wick overlaps release body
    bool wick_overlaps_top = setup_high > release_body_bottom and setup_high < release_body_top
    bool wick_overlaps_bottom = setup_low < release_body_top and setup_low > release_body_bottom
    setup_wick_overlaps_release = wick_overlaps_top or wick_overlaps_bottom
    
    // Condition 2: Release opens inside setup
    release_opens_inside = release_open >= setup_low and release_open <= setup_high
    
    if setup_wick_overlaps_release or release_opens_inside
        // Body-Only Zone
        is_body_only := true
        if is_demand
            zone_top := setup_body_top
            zone_bottom := setup_body_bottom
        else
            zone_top := setup_body_top
            zone_bottom := setup_body_bottom
    else
        // Full Wick Zone
        is_body_only := false
        if is_demand
            zone_top := setup_high
            zone_bottom := setup_low
        else
            zone_top := setup_high
            zone_bottom := setup_low
    
    [zone_top, zone_bottom, is_body_only]

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                        COMPONENT 4: ZONE STATE MACHINE                        ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// Zone states: FRESH → BAIT_CONFIRMED → READY_FOR_ENTRY
// Untapped: true until opposite-color retracement touches zone

f_is_retracement_candle(is_demand) =>
    if is_demand
        close < open  // Bearish candle for demand zone
    else
        close > open  // Bullish candle for supply zone

f_candle_touches_zone(zone_top, zone_bottom) =>
    low <= zone_top and high >= zone_bottom

f_update_zone_untapped(zone) =>
    if zone.untapped and zone.active
        touches = f_candle_touches_zone(zone.top, zone.bottom)
        is_retracement = f_is_retracement_candle(zone.isDemand)
        
        if touches and is_retracement
            zone.untapped := false
            zone.active := false

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                     COMPONENT 5: INDUCEMENT VERIFICATION ENGINE               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// For Demand Zones:
// 1. Find 3-candle swing low (L_ind) within ATR distance above zone.top
// 2. Identify internal high (H_int) before L_ind
// 3. If close > H_int → BAIT_CONFIRMED
// 4. If close < L_ind AND touches zone → READY_FOR_ENTRY

// For Supply Zones:
// 1. Find 3-candle swing high (H_ind) within ATR distance below zone.bottom
// 2. Identify internal low (L_int) before H_ind
// 3. If close < L_int → BAIT_CONFIRMED
// 4. If close > H_ind AND touches zone → READY_FOR_ENTRY

f_find_inducement_for_demand(zone) =>
    float ind_level = na
    int ind_bar = na
    float internal_level = na
    int internal_bar = na
    
    atr_distance = atr14 * inducement_atr_dist
    
    // Search for minor swing low above zone
    for i = 0 to array.size(minorSwingLows) - 1
        if i >= array.size(minorSwingLows)
            break
        swing = array.get(minorSwingLows, i)
        
        // Must be above zone.top and within ATR distance
        if swing.price > zone.top and swing.price < zone.top + atr_distance
            if swing.barIdx > zone.createdBar
                ind_level := swing.price
                ind_bar := swing.barIdx
                
                // Find internal high before this low
                for j = 0 to array.size(minorSwingHighs) - 1
                    if j >= array.size(minorSwingHighs)
                        break
                    h_swing = array.get(minorSwingHighs, j)
                    if h_swing.barIdx < swing.barIdx and h_swing.barIdx > zone.createdBar
                        internal_level := h_swing.price
                        internal_bar := h_swing.barIdx
                        break
                break
    
    [ind_level, ind_bar, internal_level, internal_bar]

f_find_inducement_for_supply(zone) =>
    float ind_level = na
    int ind_bar = na
    float internal_level = na
    int internal_bar = na
    
    atr_distance = atr14 * inducement_atr_dist
    
    // Search for minor swing high below zone
    for i = 0 to array.size(minorSwingHighs) - 1
        if i >= array.size(minorSwingHighs)
            break
        swing = array.get(minorSwingHighs, i)
        
        // Must be below zone.bottom and within ATR distance
        if swing.price < zone.bottom and swing.price > zone.bottom - atr_distance
            if swing.barIdx > zone.createdBar
                ind_level := swing.price
                ind_bar := swing.barIdx
                
                // Find internal low before this high
                for j = 0 to array.size(minorSwingLows) - 1
                    if j >= array.size(minorSwingLows)
                        break
                    l_swing = array.get(minorSwingLows, j)
                    if l_swing.barIdx < swing.barIdx and l_swing.barIdx > zone.createdBar
                        internal_level := l_swing.price
                        internal_bar := l_swing.barIdx
                        break
                break
    
    [ind_level, ind_bar, internal_level, internal_bar]

f_update_zone_inducement_state(zone) =>
    if zone.active and zone.untapped
        if zone.isDemand
            // Check for BAIT_CONFIRMED: close > internal high
            if not na(zone.internalLevel) and close > zone.internalLevel
                if zone.state == "FRESH"
                    zone.state := "BAIT_CONFIRMED"
            
            // Check for READY_FOR_ENTRY: close < inducement AND touches zone
            if not na(zone.inducementLevel) and zone.state == "BAIT_CONFIRMED"
                if close < zone.inducementLevel
                    zone.inducementSwept := true
                if zone.inducementSwept and f_candle_touches_zone(zone.top, zone.bottom)
                    zone.state := "READY_FOR_ENTRY"
        else
            // Supply zone
            // Check for BAIT_CONFIRMED: close < internal low
            if not na(zone.internalLevel) and close < zone.internalLevel
                if zone.state == "FRESH"
                    zone.state := "BAIT_CONFIRMED"
            
            // Check for READY_FOR_ENTRY: close > inducement AND touches zone
            if not na(zone.inducementLevel) and zone.state == "BAIT_CONFIRMED"
                if close > zone.inducementLevel
                    zone.inducementSwept := true
                if zone.inducementSwept and f_candle_touches_zone(zone.top, zone.bottom)
                    zone.state := "READY_FOR_ENTRY"

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                         COMPONENT 6: ENTRY CONFIRMATION                       ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// Entry conditions for M5 close
// Demand: bullish close > zone.top with rejection wick
// Supply: bearish close < zone.bottom with rejection wick

f_has_rejection_wick_demand() =>
    body = math.abs(close - open)
    lower_wick = math.min(open, close) - low
    lower_wick > body * 0.5  // Lower wick > 50% of body

f_has_rejection_wick_supply() =>
    body = math.abs(close - open)
    upper_wick = high - math.max(open, close)
    upper_wick > body * 0.5  // Upper wick > 50% of body

f_is_bullish_close() =>
    close > open

f_is_bearish_close() =>
    close < open

f_candle_closes_deep_in_zone(zone) =>
    zone_height = zone.top - zone.bottom
    if zone.isDemand
        // Deep = close below 50% of zone
        close < zone.bottom + zone_height * 0.5
    else
        // Deep = close above 50% of zone
        close > zone.top - zone_height * 0.5

f_validate_demand_entry(zone) =>
    valid = false
    if zone.state == "READY_FOR_ENTRY" and zone.active and zone.untapped
        if f_is_bullish_close()
            if close > zone.top  // Close above zone
                if f_has_rejection_wick_demand()
                    if not f_candle_closes_deep_in_zone(zone)
                        valid := true
    valid

f_validate_supply_entry(zone) =>
    valid = false
    if zone.state == "READY_FOR_ENTRY" and zone.active and zone.untapped
        if f_is_bearish_close()
            if close < zone.bottom  // Close below zone
                if f_has_rejection_wick_supply()
                    if not f_candle_closes_deep_in_zone(zone)
                        valid := true
    valid

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                          COMPONENT 7: RISK MANAGEMENT                         ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// --- 7.1 Calculate SL/TP ---
f_calculate_long_sl_tp(entry_bar_low) =>
    sl = entry_bar_low - sl_buffer_ticks * syminfo.mintick
    risk = close - sl
    tp = close + risk * tp_rr_ratio
    [sl, tp, risk]

f_calculate_short_sl_tp(entry_bar_high) =>
    sl = entry_bar_high + sl_buffer_ticks * syminfo.mintick
    risk = sl - close
    tp = close - risk * tp_rr_ratio
    [sl, tp, risk]

// --- 7.2 Position Sizing ---
f_calculate_position_size(entry, sl) =>
    risk_amount = strategy.equity * (risk_per_trade / 100)
    sl_distance = math.abs(entry - sl)
    
    if sl_distance > 0
        position = risk_amount / sl_distance
        math.max(position, 1)
    else
        1.0

// --- 7.3 M1 Trailing Stop ---
// Request M1 data
[m1_open, m1_close, m1_high, m1_low] = request.security(syminfo.tickerid, "1", [open, close, high, low], lookahead = barmerge.lookahead_off)
m1_body = math.abs(m1_close - m1_open)
m1_avg_body = ta.sma(m1_body, 20)
m1_is_bullish = m1_close > m1_open
m1_is_bearish = m1_close < m1_open

// Track trade state for trailing
var float entry_price = na
var float current_sl = na
var float current_tp = na
var bool trailing_active = false
var bool is_long_trade = false

f_update_trailing_stop() =>
    float new_sl = current_sl
    
    if strategy.position_size > 0 and enable_trailing and trailing_active
        if is_long_trade
            // For longs: trail to low of bullish M1 candle
            if m1_is_bullish
                if m1_body > m1_avg_body * 2
                    // Large candle: trail to 50% of body
                    mid_point = m1_low + m1_body * 0.5
                    new_sl := math.max(new_sl, mid_point)
                else
                    // Normal candle: trail to low
                    if IS_GOLD
                        // XAUUSD: use previous candle low (one-candle delay)
                        new_sl := math.max(new_sl, m1_low[1])
                    else
                        new_sl := math.max(new_sl, m1_low)
        else
            // For shorts: trail to high of bearish M1 candle
            if m1_is_bearish
                if m1_body > m1_avg_body * 2
                    mid_point = m1_high - m1_body * 0.5
                    new_sl := math.min(new_sl, mid_point)
                else
                    if IS_GOLD
                        new_sl := math.min(new_sl, m1_high[1])
                    else
                        new_sl := math.min(new_sl, m1_high)
    
    new_sl

// Check if +1R reached to activate trailing - returns true if should activate
f_should_activate_trailing() =>
    bool should_activate = false
    if strategy.position_size > 0 and not trailing_active
        if is_long_trade
            risk = entry_price - current_sl
            if not na(risk) and risk > 0 and close >= entry_price + risk
                should_activate := true
        else
            risk = current_sl - entry_price
            if not na(risk) and risk > 0 and close <= entry_price - risk
                should_activate := true
    should_activate

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                            COMPONENT 8: TIME FILTERS                          ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// --- 8.1 London Session Filter (07:00-09:00 UTC) ---
f_in_london_session() =>
    utc_hour = hour(time, "UTC")
    utc_hour >= london_start_hour and utc_hour < london_end_hour

// --- 8.2 Candle Close Filters ---
f_near_m30_close() =>
    minute(time) >= 25 and minute(time) < 30 or minute(time) >= 55

f_near_h1_close() =>
    minute(time) >= 50

// --- 8.3 Combined Time Filter ---
f_is_valid_entry_time() =>
    bool valid = true
    
    if enable_time_filter
        valid := valid and f_in_london_session()
    
    if avoid_m30_close
        valid := valid and not f_near_m30_close()
    
    if avoid_h1_close
        valid := valid and not f_near_h1_close()
    
    valid

// --- 8.4 ATR Volatility Filter ---
f_has_sufficient_volatility() =>
    if enable_atr_filter
        atr14 >= atr50_avg * atr_min_threshold
    else
        true

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                              ZONE CREATION                                    ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

f_create_demand_zone(setup_offset, release_offset) =>
    zone = Zone.new()
    zone.id := zoneIdCounter
    zoneIdCounter += 1
    
    // Get setup candle data
    zone.setupOpen := open[setup_offset]
    zone.setupClose := close[setup_offset]
    zone.setupHigh := high[setup_offset]
    zone.setupLow := low[setup_offset]
    zone.setupBar := bar_index - setup_offset
    
    // Calculate zone boundaries with accuracy refinement
    [zone_top, zone_bottom, is_body_only] = f_calculate_zone_boundaries(zone.setupOpen, zone.setupClose, zone.setupHigh, zone.setupLow, open[release_offset], close[release_offset], high[release_offset], low[release_offset], true)
    
    zone.top := zone_top
    zone.bottom := zone_bottom
    zone.isBodyOnly := is_body_only
    zone.active := true
    zone.untapped := true
    zone.createdBar := bar_index
    zone.isDemand := true
    zone.state := "FRESH"
    zone.inducementSwept := false
    
    if show_zones
        zone.boxId := box.new(bar_index - setup_offset, zone.top, bar_index + 50, zone.bottom, border_color = color.new(#26a69a, 40), bgcolor = demand_color, border_width = 1, border_style = line.style_solid)
    
    // Find inducement
    [ind_level, ind_bar, int_level, int_bar] = f_find_inducement_for_demand(zone)
    zone.inducementLevel := ind_level
    zone.inducementBar := ind_bar
    zone.internalLevel := int_level
    zone.internalBar := int_bar
    
    if show_inducement and not na(ind_level)
        zone.inducementLine := line.new(ind_bar, ind_level, bar_index, ind_level, color = color.new(color.yellow, 50), style = line.style_dashed, width = 1)
    
    zone

f_create_supply_zone(setup_offset, release_offset) =>
    zone = Zone.new()
    zone.id := zoneIdCounter
    zoneIdCounter += 1
    
    zone.setupOpen := open[setup_offset]
    zone.setupClose := close[setup_offset]
    zone.setupHigh := high[setup_offset]
    zone.setupLow := low[setup_offset]
    zone.setupBar := bar_index - setup_offset
    
    [zone_top, zone_bottom, is_body_only] = f_calculate_zone_boundaries(zone.setupOpen, zone.setupClose, zone.setupHigh, zone.setupLow, open[release_offset], close[release_offset], high[release_offset], low[release_offset], false)
    
    zone.top := zone_top
    zone.bottom := zone_bottom
    zone.isBodyOnly := is_body_only
    zone.active := true
    zone.untapped := true
    zone.createdBar := bar_index
    zone.isDemand := false
    zone.state := "FRESH"
    zone.inducementSwept := false
    
    if show_zones
        zone.boxId := box.new(bar_index - setup_offset, zone.top, bar_index + 50, zone.bottom, border_color = color.new(#ef5350, 40), bgcolor = supply_color, border_width = 1, border_style = line.style_solid)
    
    [ind_level, ind_bar, int_level, int_bar] = f_find_inducement_for_supply(zone)
    zone.inducementLevel := ind_level
    zone.inducementBar := ind_bar
    zone.internalLevel := int_level
    zone.internalBar := int_bar
    
    if show_inducement and not na(ind_level)
        zone.inducementLine := line.new(ind_bar, ind_level, bar_index, ind_level, color = color.new(color.orange, 50), style = line.style_dashed, width = 1)
    
    zone

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                              MAIN LOGIC                                       ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

if barstate.isconfirmed
    // --- Detect New Zones ---
    // Check for bullish displacement with FVG at offset 0
    if f_is_bullish_displacement(0) and f_has_bullish_fvg(0)
        setup_offset = f_find_last_bearish_candle(1)
        if not na(setup_offset)
            zone = f_create_demand_zone(setup_offset, 0)
            array.push(demandZones, zone)
    
    // Check for bearish displacement with FVG
    if f_is_bearish_displacement(0) and f_has_bearish_fvg(0)
        setup_offset = f_find_last_bullish_candle(1)
        if not na(setup_offset)
            zone = f_create_supply_zone(setup_offset, 0)
            array.push(supplyZones, zone)
    
    // --- Update Existing Zones ---
    // Update demand zones
    for i = 0 to array.size(demandZones) - 1
        if i >= array.size(demandZones)
            break
        zone = array.get(demandZones, i)
        
        // Update untapped state
        f_update_zone_untapped(zone)
        
        // Update inducement state
        f_update_zone_inducement_state(zone)
        
        // Extend zone box
        if not na(zone.boxId) and zone.active
            box.set_right(zone.boxId, bar_index + 50)
        
        array.set(demandZones, i, zone)
    
    // Update supply zones
    for i = 0 to array.size(supplyZones) - 1
        if i >= array.size(supplyZones)
            break
        zone = array.get(supplyZones, i)
        
        f_update_zone_untapped(zone)
        f_update_zone_inducement_state(zone)
        
        if not na(zone.boxId) and zone.active
            box.set_right(zone.boxId, bar_index + 50)
        
        array.set(supplyZones, i, zone)
    
    // --- Prune Old Zones ---
    while array.size(demandZones) > max_zones
        old_zone = array.shift(demandZones)
        if not na(old_zone.boxId)
            box.delete(old_zone.boxId)
        if not na(old_zone.inducementLine)
            line.delete(old_zone.inducementLine)
    
    while array.size(supplyZones) > max_zones
        old_zone = array.shift(supplyZones)
        if not na(old_zone.boxId)
            box.delete(old_zone.boxId)
        if not na(old_zone.inducementLine)
            line.delete(old_zone.inducementLine)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                              ENTRY EXECUTION                                  ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// Only execute entries when confirmed and no position
if barstate.isconfirmed and strategy.position_size == 0
    
    bool time_valid = f_is_valid_entry_time()
    bool vol_valid = f_has_sufficient_volatility()
    
    if time_valid and vol_valid
        // Check demand zones for long entries
        for i = 0 to array.size(demandZones) - 1
            if i >= array.size(demandZones)
                break
            zone = array.get(demandZones, i)
            
            if f_validate_demand_entry(zone)
                [sl, tp, risk] = f_calculate_long_sl_tp(low)
                
                // Validate minimum R:R
                actual_rr = (tp - close) / (close - sl)
                if actual_rr >= min_rr_ratio
                    qty = f_calculate_position_size(close, sl)
                    
                    strategy.entry("Long", strategy.long, qty = qty)
                    strategy.exit("Long Exit", "Long", stop = sl, limit = tp)
                    
                    // Store trade data
                    entry_price := close
                    current_sl := sl
                    current_tp := tp
                    is_long_trade := true
                    trailing_active := false
                    
                    // Mark zone as used
                    zone.untapped := false
                    zone.active := false
                    array.set(demandZones, i, zone)
                    
                    // Draw entry signal
                    if show_signals
                        label.new(bar_index, low, "▲ LONG", style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.small)
                    
                    break
        
        // Check supply zones for short entries
        for i = 0 to array.size(supplyZones) - 1
            if i >= array.size(supplyZones)
                break
            zone = array.get(supplyZones, i)
            
            if f_validate_supply_entry(zone)
                [sl, tp, risk] = f_calculate_short_sl_tp(high)
                
                actual_rr = (close - tp) / (sl - close)
                if actual_rr >= min_rr_ratio
                    qty = f_calculate_position_size(close, sl)
                    
                    strategy.entry("Short", strategy.short, qty = qty)
                    strategy.exit("Short Exit", "Short", stop = sl, limit = tp)
                    
                    entry_price := close
                    current_sl := sl
                    current_tp := tp
                    is_long_trade := false
                    trailing_active := false
                    
                    zone.untapped := false
                    zone.active := false
                    array.set(supplyZones, i, zone)
                    
                    if show_signals
                        label.new(bar_index, high, "▼ SHORT", style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)
                    
                    break

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                            TRAILING STOP UPDATE                               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

if strategy.position_size != 0
    if f_should_activate_trailing()
        trailing_active := true
    
    if trailing_active
        new_sl = f_update_trailing_stop()
        if new_sl != current_sl
            current_sl := new_sl
            if is_long_trade
                strategy.exit("Long Exit", "Long", stop = current_sl, limit = current_tp)
            else
                strategy.exit("Short Exit", "Short", stop = current_sl, limit = current_tp)

// Reset on position close
if strategy.position_size == 0 and strategy.position_size[1] != 0
    entry_price := na
    current_sl := na
    current_tp := na
    trailing_active := false

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                              VISUAL INDICATORS                                ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// Plot trend EMA for reference
plot(ta.ema(close, 200), "EMA 200", color = color.new(color.gray, 70), linewidth = 1)

// Plot current trend
trend_bg_color = currentTrend == "BULLISH" ? color.new(color.green, 95) : currentTrend == "BEARISH" ? color.new(color.red, 95) : na
bgcolor(trend_bg_color, title = "Trend Background")

// Plot session highlight
bgcolor(f_in_london_session() ? color.new(color.blue, 95) : na, title = "London Session")

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                              INFO TABLE                                       ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

var table infoTable = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 80))

if barstate.islast
    table.cell(infoTable, 0, 0, "RD Concepts Strategy", text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 0, "", text_color = color.white)
    
    table.cell(infoTable, 0, 1, "Trend:", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 1, currentTrend, text_color = currentTrend == "BULLISH" ? color.green : currentTrend == "BEARISH" ? color.red : color.gray, text_size = size.tiny)
    
    table.cell(infoTable, 0, 2, "ATR(14):", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 2, str.tostring(atr14, "#.#####"), text_color = color.white, text_size = size.tiny)
    
    table.cell(infoTable, 0, 3, "Demand Zones:", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(array.size(demandZones)), text_color = color.green, text_size = size.tiny)
    
    table.cell(infoTable, 0, 4, "Supply Zones:", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 4, str.tostring(array.size(supplyZones)), text_color = color.red, text_size = size.tiny)
    
    table.cell(infoTable, 0, 5, "London Session:", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 5, f_in_london_session() ? "ACTIVE" : "INACTIVE", text_color = f_in_london_session() ? color.green : color.gray, text_size = size.tiny)
    
    table.cell(infoTable, 0, 6, "Position:", text_color = color.gray, text_size = size.tiny)
    pos_text = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    pos_color = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(infoTable, 1, 6, pos_text, text_color = pos_color, text_size = size.tiny)
    
    table.cell(infoTable, 0, 7, "Trailing:", text_color = color.gray, text_size = size.tiny)
    table.cell(infoTable, 1, 7, trailing_active ? "ACTIVE" : "WAITING", text_color = trailing_active ? color.green : color.gray, text_size = size.tiny)
