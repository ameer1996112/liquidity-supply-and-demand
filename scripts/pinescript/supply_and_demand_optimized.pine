var float trade_tp1_price        = na
var bool  tp1_hit                = false
var string active_entry_id       = na  // Tracks which entry is active: "Long" or "Long Flip"
var float trade_be_trigger_rr      = na  // RR level when to move SL to BE
var float trade_be_sl_pips         = na  // Minimum SL in pips when moving to BE
var bool  trade_be_moved           = false  // Track if BE move has been executed

// === EXIT TELEMETRY TRACKING ===
var int   trade_entry_bar_index = na      // Bar index when trade was entered
var float trade_worst_price     = na      // Worst price during trade (for MAE)
var int   trade_zone_id         = na      // Zone ID that triggered entry
var float trade_zone_score      = na      // Zone score at entry
var int   trade_zone_freshness  = na      // Zone freshness (touch count) at entry
var int   trade_session         = na      // Session at entry
var float trade_atr_ratio       = na      // ATR ratio at entry
var int   trade_trend           = na      // Trend at entry
var float trade_rsi             = na      // RSI at entry
var int   trade_htf_trend       = na      // HTF trend at entry
var float trade_rvol            = na      // RVOL at entry
var float trade_adx             = na      // ADX at entry
var int   trade_touch_count     = na      // Touch count at entry
var float trade_base_quality    = na      // Base quality at entry
var float trade_departure_str   = na      // Departure strength at entry
var float trade_liq_distance    = na      // Liquidity distance at entry
var float trade_liq_spread      = na      // Liquidity spread at entry
var float trade_return_str      = na      // Return strength at entry
var bool  trade_liq_swept       = false   // Liquidity swept at entry
var bool  trade_target_swept    = false   // Target swept at entry
var bool  trade_caused_sweep    = false   // Caused sweep at entry
var bool  trade_is_accuracy     = false   // Is accuracy zone
