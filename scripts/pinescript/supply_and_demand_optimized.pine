// === TIMING FILTER FUNCTIONS (Moved from below) ===


// === GLOBAL TREND & SESSION TRACKERS ===
trend_ema = ta.ema(close, ema_trend_length)
is_uptrend = close > trend_ema
is_downtrend = close < trend_ema





// === UTILS ===

// === SCORING SYSTEM HELPERS ===
// Convert 0-100 score to grade
get_grade_from_score(float score) =>
    if score >= 90
        "A+"
    else if score >= 80
        "A"
    else if score >= 70
        "B+"
    else if score >= 60
        "B"
    else if score >= 50
        "C+"
    else
        "C"

// Convert grade to numeric value for comparison
get_grade_value(string grade) =>
    if grade == "A+"
        6
    else if grade == "A"
        5
    else if grade == "B+"
        4
    else if grade == "B"
        3
    else if grade == "C+"
        2
    else
        1

// Calculate Zone Quality Score (0-100)
calculate_zone_score(bool isDemand, float top, float bottom, int baseIdx, int legCandles, bool hasLiquidity, bool isLiquiditySweep, int candlesInBase, bool isAccuracy) =>
    float score = 0.0
    
    // 1. TREND ALIGNMENT (20 pts)
    // Check if zone direction aligns with HTF trend (EMA 200)
    // Using current close for simplicity, ideally should check at creation time but close enough
    if isDemand and is_uptrend
        score += 20
    else if not isDemand and is_downtrend
        score += 20
        
    // 2. STRENGTH OF MOVE (Displacement) (20 pts)
    // Heuristic: If it's an Accuracy zone or has high leg count, assume strong move
    if isAccuracy
        score += 20
    else if legCandles >= 3
        score += 15
    else
        score += 10 // Base for valid zone
        
    // 3. BASE QUALITY (20 pts)
    // Tight base (1-2 candles) is better
    if candlesInBase <= 2
        score += 20
    else if candlesInBase <= 4
        score += 10
    else
        score += 5
        
    // 4. LIQUIDITY (20 pts)
    if isLiquiditySweep
        score += 20
    else if hasLiquidity
        score += 10
        
    // 5. TIME & FRESHNESS (20 pts)
    // Bonus for high volatility sessions (London/NY)
    // We can check time of baseIdx
    int zoneTime = time[baseIdx]
    int zoneHour = hour(zoneTime, "UTC") // Approximate
    bool isLondon = zoneHour >= 7 and zoneHour <= 10
    bool isNY = zoneHour >= 13 and zoneHour <= 16
    
    if isLondon or isNY
        score += 10
    else
        score += 5
        
    // Freshness bonus (always fresh at creation)
    score += 10
    
    score

get_pip(x) =>
    x / pip_size

// === WEBHOOK PAYLOAD HELPERS ===
// Converts position size in units to lots based on symbol type
units_to_lots(_units) =>
    float lot_size = FOREX_LOT_SIZE  // Default forex
    ticker = syminfo.ticker
    if str.contains(ticker, "XAU") or str.contains(ticker, "GOLD")
        lot_size := 100.0      // Gold: 100 oz per lot
    else if str.contains(ticker, "XAG") or str.contains(ticker, "SILVER")
        lot_size := 5000.0     // Silver: 5000 oz per lot
    else if str.contains(ticker, "BTC") or str.contains(ticker, "ETH")
        lot_size := 1.0        // Crypto: 1 unit per lot
    _units / lot_size

// Helper to ensure valid JSON number format (dot decimal, no thousands separator)
to_json_num(float val, string fmt) =>
    if na(val)
        "null"
    else
        string s = str.tostring(val, fmt)
        // Remove potential thousands separators (if any) and ensure dot decimal
        start_idx = 0 
        str.replace(s, ",", ".")

// Builds JSON payload for webhook alert to Discord-MT5 bridge
// Returns: JSON string with trade details + Zone Inspector data + AI Features
build_webhook_payload(
     _symbol, _side, _entry, _sl, _tp, _size_lots, _zone_id, _zone_type,
     _zone_top, _zone_bottom, _rr_ratio, _sl_pips, _entry_model,
     _liq_swept, _target_swept, _caused_sweep, _is_accuracy,
     // AI Features (NEW)
     _score, _freshness, _session, _atr_ratio, _trend, _rsi,
     _htf_trend, _rvol, _adx, _touch_count, _base_quality,
     _departure_strength, _liq_distance, _liq_spread, _return_strength) =>

    string payload = '{"symbol":"' + _symbol + '"'
    payload := payload + ',"side":"' + _side + '"'
    payload := payload + ',"entry":' + to_json_num(_entry, "#.##########")
    payload := payload + ',"sl":' + to_json_num(_sl, "#.##########")
    payload := payload + ',"tp":' + to_json_num(_tp, "#.##########")
    payload := payload + ',"size":' + to_json_num(_size_lots, "#.##")

    // Zone Inspector Data
    if webhook_include_zone_id and not na(_zone_id)
        payload := payload + ',"zone_id":' + to_json_num(_zone_id, "#")
    payload := payload + ',"zone_type":"' + _zone_type + '"'

    if not na(_zone_top) and not na(_zone_bottom)
        payload := payload + ',"zone_top":' + to_json_num(_zone_top, "#.##########")
        payload := payload + ',"zone_bottom":' + to_json_num(_zone_bottom, "#.##########")
        float zone_size_pips = (_zone_top - _zone_bottom) / pip_size
        payload := payload + ',"zone_size_pips":' + to_json_num(zone_size_pips, "#.#")

    if not na(_rr_ratio)
        payload := payload + ',"rr_ratio":' + to_json_num(_rr_ratio, "#.##")
    if not na(_sl_pips)
        payload := payload + ',"sl_pips":' + to_json_num(_sl_pips, "#.#")

    payload := payload + ',"entry_model":"' + _entry_model + '"'
    payload := payload + ',"liq_swept":' + (_liq_swept ? "true" : "false")
    payload := payload + ',"target_swept":' + (_target_swept ? "true" : "false")
    payload := payload + ',"caused_sweep":' + (_caused_sweep ? "true" : "false")
    payload := payload + ',"is_accuracy":' + (_is_accuracy ? "true" : "false")

    // === AI FEATURES (NEW) ===
    payload := payload + ',"score":' + to_json_num(_score, "#.#")
    payload := payload + ',"freshness":' + str.tostring(_freshness, "#")
    payload := payload + ',"session":' + str.tostring(_session, "#")
    payload := payload + ',"atr_ratio":' + to_json_num(_atr_ratio, "#.####")
    payload := payload + ',"trend":' + str.tostring(_trend, "#")
    payload := payload + ',"rsi":' + to_json_num(_rsi, "#.##")
    payload := payload + ',"htf_trend":' + str.tostring(_htf_trend, "#")
    payload := payload + ',"rvol":' + to_json_num(_rvol, "#.##")
    payload := payload + ',"adx":' + to_json_num(_adx, "#.##")
    payload := payload + ',"touch_count":' + str.tostring(_touch_count, "#")
    payload := payload + ',"base_quality":' + to_json_num(_base_quality, "#.##")
    payload := payload + ',"departure_strength":' + to_json_num(_departure_strength, "#.##")
    payload := payload + ',"liquidity_distance":' + to_json_num(_liq_distance, "#.##")
    payload := payload + ',"liquidity_spread":' + to_json_num(_liq_spread, "#.##")
    payload := payload + ',"return_strength":' + to_json_num(_return_strength, "#.##")

    payload := payload + '}'
    payload

// Builds EXIT webhook payload
// Returns: JSON string with exit telemetry
build_exit_webhook_payload(_zone_id, _outcome, _bars_held, _close_price, _pnl_r, _exit_type, _mae_pips) =>
    string payload = '{"event_type":"exit"'
    payload := payload + ',"zone_id":' + str.tostring(_zone_id, "#")
    payload := payload + ',"outcome":"' + _outcome + '"'
    payload := payload + ',"bars_held":' + str.tostring(_bars_held, "#")
    payload := payload + ',"close_price":' + to_json_num(_close_price, "#.##########")
    payload := payload + ',"pnl_r":' + to_json_num(_pnl_r, "#.##")
    payload := payload + ',"exit_type":"' + _exit_type + '"'
    payload := payload + ',"mae_pips":' + to_json_num(_mae_pips, "#.#")
    payload := payload + ',"close_time":"' + str.format("{0,date,yyyy-MM-dd HH:mm:ss}", timenow) + '"'
    payload := payload + '}'
    payload

// === AI QUALITY SCORE CALCULATOR (V4 MODEL) ===
// Approximates backend Random Forest model using weighted feature scoring (V4 Weights)
// Top Predictors: RVOL (20%), Session (12%), isAccuracy (11%), Trend (9%), ADX (8%)
// Returns 0-100 score where 60+ indicates high probability
calculate_ai_quality_score(Zone z, bool isDemand) =>
    float quality_score = 0.0
    
    // 1. RVOL (20%) - Volume Strength
    float current_rvol = feature_rvol
    if current_rvol >= 2.0
        quality_score += 20.0
    else if current_rvol >= 1.5
        quality_score += 15.0
    else if current_rvol >= 1.0
        quality_score += 10.0
    else
        quality_score += 5.0

    // 2. Session (12%) - Time of Day
    int current_session = feature_session
    if current_session == 2 or current_session == 3  // London (2) or NY (3)
        quality_score += 12.0
    else if current_session == 1 // Asian
        quality_score += 5.0
    else
        quality_score += 2.0

    // 3. isAccuracy (11%) - Algo Tag
    if z.isAccuracy
        quality_score += 11.0

    // 4. Trend (9%) - Market Structure
    bool trend_aligned = isDemand ? (feature_trend > 0) : (feature_trend < 0)
    if trend_aligned
        quality_score += 9.0

    // 5. ADX (8%) - Trend Strength (New V4 Feature)
    if feature_adx >= 25.0
        quality_score += 8.0
    else if feature_adx >= 20.0
        quality_score += 5.0

    // 6. Freshness (8%) - First Touch
    // Note: touchCount is now incremented BEFORE checks, so 1 means "Fresh/First Touch"
    if (z.touchCount <= 1) 
        quality_score += 8.0
    else
        quality_score += 2.0

    // 7. HTF Trend (7%)
    bool htf_aligned = isDemand ? (feature_htf_trend > 0) : (feature_htf_trend < 0)
    if htf_aligned
        quality_score += 7.0

    // 8. RSI (7%) - Momentum
    // Demand: RSI not overbought (>70 bad). Supply: RSI not oversold (<30 bad).
    if isDemand
        if feature_rsi < 70
            quality_score += 7.0
    else
        if feature_rsi > 30
            quality_score += 7.0

    // 9. ATR Ratio (7%) - Zone Tightness
    float f_atr_ratio = (z.top - z.bottom) / atr14
    if f_atr_ratio < 1.0
        quality_score += 7.0
    else if f_atr_ratio < 2.0
        quality_score += 4.0
    // 10. Zone Base Score (11%) - Quality of imbalance
    if z.score >= 8
        quality_score += 11.0
    else if z.score >= 5
        quality_score += 6.0
    else
        quality_score += 2.0
    
    string breakdown = "RVOL:" + str.tostring(current_rvol, "#.1") + 
      " Sess:" + str.tostring(current_session) + 
      " Trend:" + (trend_aligned ? "YES" : "NO") + 
      " Fresh:" + (z.touchCount <= 1 ? "YES" : "NO") +
      " Score:" + str.tostring(z.score, "#.0")
      
    [quality_score, breakdown]

// === V6 AI FEATURES: BASE QUALITY & DEPARTURE STRENGTH ===
// Measures zone formation quality and departure conviction

// Calculate Base Quality: How many indecisive candles are in the base (0-100 score)
// Indecisive = small body relative to range (dojis, pin bars, etc.)
// Higher score = cleaner base with decisive candles
// OPTIMIZED: Only analyzes up to 5 most recent base candles for performance
calculate_base_quality(int base_start_idx, int base_end_idx) =>
    if base_start_idx < 0 or base_end_idx < 0 or base_start_idx < base_end_idx
        50.0  // Default if invalid indices
    else
        // PERFORMANCE: Limit to max 5 candles instead of entire base
        int total_candles = base_start_idx - base_end_idx + 1
        int candles_to_check = math.min(total_candles, 5)
        int indecisive_count = 0
        
        // SAFETY: Ensure we don't exceed Pine Script's 10000 bar limit
        int max_lookback = 10000
        
        // Count indecisive candles in base (last 5 only for speed)
        int start = base_start_idx
        int end_limit = start - candles_to_check + 1
        for i = end_limit to start
            int offset = bar_index - i
            // Skip if offset exceeds max lookback
            if offset >= 0 and offset < max_lookback
                float candle_high = high[offset]
                float candle_low = low[offset]
                float candle_open = open[offset]
                float candle_close = close[offset]
                
                float candle_range = candle_high - candle_low
                float body_size = math.abs(candle_close - candle_open)
                float body_percent = candle_range > 0 ? body_size / candle_range : 0.5
                
                // Indecisive if body is less than 30% of total range
                if body_percent < 0.30
                    indecisive_count += 1
        
        // Score: 100 = perfect (no indecisive), 0 = terrible (all indecisive)
        float quality = candles_to_check > 0 ? 100.0 * (1.0 - (indecisive_count / candles_to_check)) : 50.0
        quality

// Calculate Departure Strength: How aggressively price left the zone (0-100 score)
// Analyzes first 3 candles after base formation
// Higher score = bigger bodies + higher volume
// NOTE: This function is called on every bar for series consistency (Pine Script requirement)
calculate_departure_strength(int base_end_idx, bool isDemand) =>
    // Uses global vol_sma_20 (calculated on every bar for Pine Script series consistency)

    if base_end_idx < 3
        50.0  // Not enough history
    else
        int departure_candles = math.min(3, base_end_idx)  // Analyze up to 3 candles
        float total_body_percent = 0.0
        float total_rvol = 0.0
        int valid_candles = 0
        
        // SAFETY: Ensure we don't exceed Pine Script's 10000 bar limit
        int max_lookback = 10000
        
        // Analyze candles immediately after base
        for i = 1 to departure_candles
            int candle_idx = base_end_idx - i
            // Skip if candle_idx exceeds max lookback
            if candle_idx >= 0 and candle_idx < max_lookback
                float candle_high = high[candle_idx]
                float candle_low = low[candle_idx]
                float candle_open = open[candle_idx]
                float candle_close = close[candle_idx]
                float candle_volume = volume[candle_idx]
                
                float candle_range = candle_high - candle_low
                float body_size = math.abs(candle_close - candle_open)
                float body_percent = candle_range > 0 ? body_size / candle_range : 0.0
                
                // Check if candle is in correct direction
                bool correct_direction = isDemand ? (candle_close > candle_open) : (candle_close < candle_open)
                
                if correct_direction
                    total_body_percent += body_percent
                    
                    // Relative volume for this candle (using pre-calculated SMA)
                    float vol_avg_at_candle = vol_sma_20[candle_idx]
                    float candle_rvol = vol_avg_at_candle > 0 ? candle_volume / vol_avg_at_candle : 1.0
                    total_rvol += candle_rvol
                    
                    valid_candles += 1
        
        // Calculate strength: 50% from body size, 50% from volume
        float avg_body_percent = valid_candles > 0 ? total_body_percent / valid_candles : 0.0
        float avg_rvol = valid_candles > 0 ? total_rvol / valid_candles : 1.0
        
        // Normalize: body_percent (0-1) * 50 + rvol (typically 0-3, cap at 3) / 3 * 50
        float body_score = avg_body_percent * 50.0
        float rvol_score = math.min(avg_rvol / 3.0, 1.0) * 50.0
        
        float departure_strength = body_score + rvol_score
        departure_strength

// === V7.1 AI FEATURES: LIQUIDITY DISTANCE & SPREAD (IMPROVED) ===
// Replaces LiquidityQuality (was constant at 15, 0% importance)

// Calculate Liquidity Distance: How far liquidity sits from zone boundary (in pips)
// Hypothesis: Closer liquidity = Tighter setup = Higher win rate
// Expected importance: 10-15% (top 5 predictor)
calculate_liquidity_distance(float zone_boundary, float liq_price, bool isDemand) =>
    if na(zone_boundary) or na(liq_price)
        50.0  // Default if invalid
    else
        // For Demand: Distance from zone TOP to inducement LOW (above zone)
        // For Supply: Distance from zone BOTTOM to inducement HIGH (below zone)
        float distance_pips = math.abs(liq_price - zone_boundary) / pip_size
        
        // Normalize to 0-100 scale (0 = perfect contact, 100 = very far)
        // Invert so higher score = closer liquidity (better setup)
        // Cap at 50 pips distance = 0 score
        float score = distance_pips >= 50.0 ? 0.0 : (1.0 - (distance_pips / 50.0)) * 100.0
        score

// Calculate Liquidity Spread: Distance between inducement and target (in pips)
// Hypothesis: Wider spread = More conviction = Higher win rate
// Expected importance: 5-8% (moderate predictor)
calculate_liquidity_spread(float target_price, float inducement_price) =>
    if na(target_price) or na(inducement_price)
        50.0  // Default if invalid
    else
        // Distance between target and inducement
        float spread_pips = math.abs(target_price - inducement_price) / pip_size
        
        // Normalize to 0-100 scale
        // Wider spread = higher score (more conviction)
        // Cap at 100 pips spread = 100 score
        float score = math.min(spread_pips, 100.0)
        score

// Calculate Return Strength: How aggressively price returned after sweep (0-100 score)
// Analyzes bars between liquidity sweep and zone prime
// Faster return + bigger candles = higher conviction
// NOTE: This function is called on every bar for series consistency (Pine Script requirement)
calculate_return_strength(int sweep_bar_idx, int prime_bar_idx, bool isDemand) =>
    // Uses global vol_sma_20 (calculated on every bar for Pine Script series consistency)

    if na(sweep_bar_idx) or na(prime_bar_idx) or sweep_bar_idx >= prime_bar_idx
        50.0  // Default if no valid sweep or instant prime
    else
        int bars_after_sweep = prime_bar_idx - sweep_bar_idx
        
        // If primed immediately (1 bar), that's maximum conviction
        if bars_after_sweep == 1
            100.0
        
        // Analyze up to 5 bars of return journey
        int candles_to_analyze = math.min(bars_after_sweep, 5)
        float total_body_percent = 0.0
        float total_rvol = 0.0
        int valid_candles = 0
        
        // SAFETY: Ensure we don't exceed Pine Script's 10000 bar limit
        int max_lookback = 10000
        
        // Loop through bars between sweep and prime
        for i = 1 to candles_to_analyze
            int offset = prime_bar_idx - i
            int hist_offset = bar_index - offset
            // Skip if offset exceeds max lookback
            if offset >= 0 and hist_offset >= 0 and hist_offset < max_lookback
                float candle_high = high[hist_offset]
                float candle_low = low[hist_offset]
                float candle_open = open[hist_offset]
                float candle_close = close[hist_offset]
                float candle_volume = volume[hist_offset]
                
                float candle_range = candle_high - candle_low
                float body_size = math.abs(candle_close - candle_open)
                float body_percent = candle_range > 0 ? body_size / candle_range : 0.0
                
                // Check if candle is moving toward zone
                // For demand: bullish candles move toward zone (up)
                // For supply: bearish candles move toward zone (down)
                bool toward_zone = isDemand ? (candle_close > candle_open) : (candle_close < candle_open)
                
                if toward_zone
                    total_body_percent += body_percent
                    
                    // Relative volume (using pre-calculated SMA)
                    float vol_avg_at_candle = vol_sma_20[hist_offset]
                    float candle_rvol = vol_avg_at_candle > 0 ? candle_volume / vol_avg_at_candle : 1.0
                    total_rvol += candle_rvol
                    
                    valid_candles += 1
        
        // Calculate strength: 50% from body size, 50% from volume
        float avg_body_percent = valid_candles > 0 ? total_body_percent / valid_candles : 0.0
        float avg_rvol = valid_candles > 0 ? total_rvol / valid_candles : 1.0
        
        // Normalize scores
        float body_score = avg_body_percent * 50.0
        float rvol_score = math.min(avg_rvol / 3.0, 1.0) * 50.0
        
        // Bonus for fast return (fewer bars = higher conviction)
        float speed_bonus = bars_after_sweep <= 3 ? 20.0 : (bars_after_sweep <= 5 ? 10.0 : 0.0)
        
        float return_strength = math.min(body_score + rvol_score + speed_bonus, 100.0)
        return_strength

// === OPTIMIZED VALUE CACHING ===
// Cache frequently accessed bar values and conditions at the start of each bar to reduce redundant access
var float cached_close = na
var float cached_open = na
var float cached_high = na
var float cached_low = na
var int cached_bar_index = na
var bool cached_is_jpy_pair = false
var bool cached_is_usdjpy = false
var bool cached_is_confirmed = false

if barstate.isconfirmed
    cached_close := close
    cached_open := open
    cached_high := high
    cached_low := low
    cached_bar_index := bar_index
    cached_is_confirmed := true
    // Cache JPY pair checks (computed once per bar)
    cached_is_jpy_pair := str.contains(syminfo.ticker, "JPY")
    cached_is_usdjpy := str.contains(syminfo.ticker, "USDJPY")
else
    cached_is_confirmed := false

// === HELPER: COUNT OPPOSITE CANDLES (MULTI-MODE) ===
countOppositeCandlesInBand(bool isDemand, int fromBar, int toBar, float top, float bottom) =>
    int oppCount = 0
    if na(fromBar) or na(toBar) or na(top) or na(bottom) or fromBar > toBar
        oppCount
    else
        // XAUUSD FIX: Asset-specific overlap tolerance
        // Gold needs looser tolerance due to large pip size (0.1) and high volatility
        float overlapTolerance = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD") ? pip_size * 0.5 : syminfo.mintick / 2.0
        // Determine scan end: clamp to current bar_index
        scanEndBar = math.min(toBar, bar_index)

        // Scan from fromBar to scanEndBar (inclusive)
        if scanEndBar >= fromBar
            for scanOff = 0 to (scanEndBar - fromBar)
                scanBar = fromBar + scanOff
                if scanBar > bar_index
                    break

                // Calculate offset from current bar
                barOffset = bar_index - scanBar
                if barOffset < 0
                    continue

                // Check if candle overlaps with liquidity band
                float c_high_band = high[barOffset]
                float c_low_band  = low[barOffset]
                bool overlapsBand = c_high_band >= (bottom - overlapTolerance) and c_low_band <= (top + overlapTolerance)

                // --- MODE-BASED STRUCTURE DETECTION ---
                bool isStructure = false

                float c_open  = open[barOffset]
                float c_close = close[barOffset]
                float c_high  = high[barOffset]
                float c_low   = low[barOffset]
                float body_size = math.abs(c_close - c_open)
                float total_range = c_high - c_low

                if total_range > syminfo.mintick
                    bool isRed   = c_close < c_open
                    bool isGreen = c_close > c_open

                    // 1. RELAXED (Wicks & Dojis count)
                    if structure_mode == "Relaxed (Wicks)"
                        bool isDoji = body_size <= (total_range * 0.05)
                        if isDemand
                            float upper_wick = c_high - math.max(c_open, c_close)
                            // XAUUSD FIX: Lower wick threshold from 50% to 30% to catch more bearish structure
                            // Gold's high volatility means even 30% wicks are significant rejection
                            bool meaningfulUpperWick = total_range > 0 ? (upper_wick / total_range) >= 0.30 : false
                            isStructure := isRed or isDoji or meaningfulUpperWick
                        else
                            float lower_wick = math.min(c_open, c_close) - c_low
                            // XAUUSD FIX: Lower wick threshold for supply zones too
                            bool meaningfulLowerWick = total_range > 0 ? (lower_wick / total_range) >= 0.30 : false
                            isStructure := isGreen or isDoji or meaningfulLowerWick

                    // 2. STANDARD (Solid Bodies only)
                    else if structure_mode == "Standard (Bodies)"
                        // Must have some body (>10% range) and be opposite color
                        // Wicks do NOT count here
                        if isDemand
                            isStructure := isRed and (body_size > total_range * 0.10)
                        else
                            isStructure := isGreen and (body_size > total_range * 0.10)

                    // 3. STRICT (Strong Moves only)
                    else // Strict (Major Moves)
                        // Must be opposite color and significant body (>30% range)
                        if isDemand
                            isStructure := isRed and (body_size > total_range * 0.30)
                        else
                            isStructure := isGreen and (body_size > total_range * 0.30)

                // Require MEANINGFUL overlap with liquidity band, not just edge touches
                float overlapTop    = math.min(c_high_band, top)
                float overlapBottom = math.max(c_low_band, bottom)
                float overlapRange  = math.max(0.0, overlapTop - overlapBottom)
                // RELAXED: Any overlap with the band counts (no minimum percentage required)
                // This ensures all candles that touch the liquidity band are counted, regardless of candle size
                bool overlapsMeaningfully = overlapsBand and overlapRange > 0

                if overlapsMeaningfully and isStructure
                    // Count only; noisy per-candle debug labels removed to avoid chart spam
                    oppCount += 1
        oppCount

is_strong_body(idx) =>
    body        = math.abs(close[idx] - open[idx])
    total_range = high[idx] - low[idx]
    perc        = total_range > 0 ? body / total_range * 100 : 0
    perc >= min_body_perc

// =============================
// =============================
// =============================
// POSITION SIZE CALCULATOR (Myfxbook Formula)
// =============================
// Formula: Position Size (lots) = (Account Size × Risk %) / (Stop Loss in pips × Pip Value)
// Where Pip Value = (Pip Size / Exchange Rate) × Lot Size
// 
// For JPY pairs: Pip Value = (0.01 / USDJPY_rate) × 100,000
// For non-JPY pairs: Pip Value = 0.0001 × 100,000 = $10 per pip per lot
//
// @param entry: Entry price
// @param stop: Stop loss price
// @param balance: Account balance in USD
// @param risk_pct: Risk percentage per trade (e.g., 0.5 for 0.5%)
// @returns: Position size in lots
calc_pos_size(entry, stop, balance, risk_pct) =>
    // Step 1: Calculate risk amount in USD
    risk_usd = balance * (risk_pct / 100)
    
    // Step 2: Determine pip size based on pair type
    pip_sz = pip_size  // Use the auto-detected or manual pip size
    
    // Step 3: Calculate pip distance (absolute value)
    pip_distance = math.abs(stop - entry)
    sl_pips = pip_distance / pip_sz
    sl_pips := math.max(sl_pips, 0.1)  // Minimum 0.1 pips
    
    // Step 4: Standard lot size for forex (100,000 units)
    lot_size = FOREX_LOT_SIZE
    
    // Step 5: Calculate pip value per lot in USD
    // TradingView formula for pip value:
    // For XXX/USD pairs: pip_value = pip_size * lot_size = $10 per pip per lot
    // For XXX/YYY pairs: pip_value = (pip_size * lot_size) / quote_currency_rate
    float pip_value_per_lot = na
    
    if is_jpy_pair and not is_usdjpy
        // For JPY cross pairs (GBPJPY, EURJPY, etc.) - OPTIMIZED
        float usdjpy_rate = get_cached_usdjpy_rate()
        pip_value_per_lot := (pip_sz * lot_size) / usdjpy_rate
    else if str.contains(syminfo.ticker, "USDJPY")
        pip_value_per_lot := (pip_sz * lot_size) / entry
    else if str.contains(syminfo.ticker, "USD")
        // Pairs ending in USD (EURUSD, GBPUSD, etc.) - pip value is $10 per lot
        pip_value_per_lot := pip_sz * lot_size
    else
        // Cross pairs not ending in USD (GBPCAD, EURGBP, etc.)
        // Need to convert quote currency to USD
        // For GBPCAD: pip_value = (0.0001 * 100000) / USDCAD rate
        // Approximate: use entry price as a proxy (works for most pairs)
        pip_value_per_lot := (pip_sz * lot_size) / entry
    
    // Step 6: Ensure pip_value_per_lot is valid
    if na(pip_value_per_lot) or pip_value_per_lot <= 0
        pip_value_per_lot := pip_sz * lot_size
    
    // Step 7: Calculate position size in lots
    // Formula: Position Size (lots) = Risk USD / (SL pips × Pip Value per lot)
    qty_lots = risk_usd / (sl_pips * pip_value_per_lot)
    
    // Step 8: Validate and round
    if na(qty_lots) or qty_lots <= 0
        qty_lots := 0.001
    else
        qty_lots := math.max(qty_lots, 0.001)
    
    qty_lots := math.round(qty_lots * 1000) / 1000
    
    if na(qty_lots) or qty_lots <= 0
        qty_lots := 0.001
    
    qty_lots

// =============================
// CALCULATE POSITION SIZE IN UNITS (TradingView-compatible)
// =============================
// This function calculates position size in UNITS
// For USD Quote pairs (XAUUSD, EURUSD): 1 unit moving $1 = $1 P/L, so units = risk / price_distance
// For JPY pairs: Need to convert using USDJPY rate
// For USD Base pairs (USDCAD): Use pip-based calculation
// @param entry: Entry price
// @param stop: Stop loss price
// @param balance: Account balance in USD
// @param risk_pct: Risk percentage per trade
// @param is_short: true for short, false for long
// @returns: Position size in UNITS (not lots)
calc_pos_size_units(entry, stop, balance, risk_pct, is_short) =>
    // Step 1: Calculate risk amount in USD
    float risk_usd = balance * (risk_pct / 100)
    
    // Step 2: Calculate price distance (absolute)
    float price_distance = math.abs(entry - stop)
    
    // CRITICAL SAFETY CLAMP: Enforce minimum 2 pip distance to prevent massive position sizes
    // Without this, a 0.1 pip SL would cause position_units = 50 / 0.01 = 5000 units (on Forex)
    // or on Gold: position_units = 50 / 0.10 = 500 oz = 5 lots (way too big for tight SL)
    float min_distance = 2.0 * pip_size  // Minimum 2 pips
    float effective_distance = math.max(price_distance, min_distance)
    
    // Validate distance is positive
    if effective_distance <= 0
        0.0
    else
        float position_units = na
        ticker = syminfo.ticker

        // Detect symbol type (use local variables with different names to avoid shadowing)
        bool local_is_gold = str.contains(ticker, "XAU") or str.contains(ticker, "GOLD")
        bool local_is_silver = str.contains(ticker, "XAG") or str.contains(ticker, "SILVER")
        bool local_is_crypto = str.contains(ticker, "BTC") or str.contains(ticker, "ETH")
        bool local_is_jpy_pair = str.contains(ticker, "JPY")
        bool local_is_usd_base = str.startswith(ticker, "USD") and not str.endswith(ticker, "USD")
        // USD Quote pairs: Contains USD but doesn't start with USD (like EURUSD, GBPUSD)
        // Also includes Gold/Silver/Crypto which are quoted in USD
        bool local_is_usd_quote = (str.contains(ticker, "USD") and not local_is_usd_base) or local_is_gold or local_is_silver or local_is_crypto
        
        // Case 1: USD Quote pairs (XAUUSD, EURUSD, GBPUSD, AUDUSD, BTCUSD, etc.)
        // For these pairs: 1 unit moving $1 = $1 profit/loss
        // Formula: units = risk_usd / effective_distance
        // Example XAUUSD: $50 risk / $4.56 distance = 10.96 ≈ 11 units
        if local_is_usd_quote and not local_is_jpy_pair
            position_units := risk_usd / effective_distance

        // Case 2: JPY pairs (USDJPY, GBPJPY, EURJPY) - OPTIMIZED
        // Need to convert using USDJPY rate
        else if local_is_jpy_pair
            float usdjpy_rate = get_cached_usdjpy_rate()

            // For JPY pairs: (risk_usd * usdjpy_rate) / effective_distance
            position_units := (risk_usd * usdjpy_rate) / effective_distance
        
        // Case 3: Proper Cross-Pair Handling (Universal)
        else
            // Convert Quote Currency Value to USD
            // e.g. for GBPCAD (Quote CAD), we need value of 1 CAD in USD
            float quote_usd_rate = get_quote_to_usd_rate(syminfo.currency)
            
            // position_units = Risk_USD / (Stop Distance * Value_of_1_Unit_in_USD)
            // Value_of_1_Unit_in_USD = 1.0 * quote_usd_rate
            position_units := risk_usd / (effective_distance * quote_usd_rate)
        
        // Round to whole units
        position_units := math.round(position_units)
        
        // Validate - minimum 1 unit
        if na(position_units) or position_units <= 0
            position_units := 1.0
        
        position_units

// =============================
// TRADE EXECUTION VALIDATION
// =============================
// Validates all parameters before executing a trade to ensure it will execute correctly
// @param entry_price: Entry price
// @param stop_loss_price: Stop loss price  
// @param take_profit_price: Take profit price (can be na)
// @param qty_lots: Position size in lots
// @param contract_size: Contract size (100,000 for forex)
// @param is_long: true for long trades, false for short trades
// @returns: [is_valid, qty_units, error_message]
validate_trade_execution(entry_price, stop_loss_price, qty_lots, contract_size) =>
    bool is_valid = true
    int qty_units = na
    string error_msg = ""
    
    // Validate entry price
    if na(entry_price) or entry_price <= 0
        is_valid := false
        error_msg := "Invalid entry price"
    
    // Validate stop loss price
    if na(stop_loss_price) or stop_loss_price <= 0
        is_valid := false
        error_msg := "Invalid stop loss price"
    
    // For long trades: SL must be strictly below entry
    if is_valid and stop_loss_price >= entry_price
        is_valid := false
        error_msg := "SL must be below entry for longs"
    
    // Validate qty_lots
    if na(qty_lots) or qty_lots <= 0
        is_valid := false
        error_msg := "Invalid position size (lots)"
    
    // Calculate contract units - MUST be positive integer for TradingView
    if is_valid
        float raw_units = qty_lots * contract_size
        raw_units := math.round(raw_units)
        raw_units := math.max(raw_units, 1.0)  // Minimum 1 unit
        
        // Convert to integer explicitly
        qty_units := int(raw_units)
        
        // Final validation of contract units - must be positive integer
        if na(qty_units) or qty_units <= 0
            is_valid := false
            error_msg := "Invalid contract units"
    
    [is_valid, qty_units, error_msg]

// =============================
// FETCH USDJPY RATE WITH ERROR HANDLING
// =============================
// Fetches USDJPY rate for JPY pairs, returns [rate, success, error_message]
// @returns: [usdjpy_rate, is_success, error_message]
fetch_usdjpy_rate() =>
    // OPTIMIZED: Use cached rate instead of multiple security calls
    float rate = get_cached_usdjpy_rate()
    bool success = true
    string error_msg = rate == USDJPY_FALLBACK ? "Using fallback rate" : ""

    [rate, success, error_msg]

// =============================
// ENHANCED POSITION SIZING VALIDATION
// =============================
// Comprehensive validation of position size with min/max checks and USDJPY validation
// @param entry_price: Entry price
// @param stop_loss_price: Stop loss price
// @param balance: Account balance in USD
// @param risk_pct: Risk percentage per trade
// @param is_short: true for short trades, false for long trades
// @returns: [is_valid, qty_units, qty_lots, error_message, validation_details, sl_fixed]
validate_position_size(entry_price, stop_loss_price, balance, risk_pct, is_short) =>
    bool is_valid = true
    int qty_units = na
    float qty_lots = na
    string error_msg = ""
    string validation_details = ""
    float sl_fixed = stop_loss_price  // Local copy - function arguments are immutable in Pine Script
    
    // Step 1: Validate entry price
    if na(entry_price) or entry_price <= 0
        is_valid := false
        error_msg := "Invalid entry price"
        validation_details := "Entry price: " + (na(entry_price) ? "NA" : str.tostring(entry_price))
    
    // Step 2: Validate stop loss price
    if is_valid and (na(sl_fixed) or sl_fixed <= 0)
        is_valid := false
        error_msg := "Invalid stop loss price"
        validation_details := "Stop loss: " + (na(sl_fixed) ? "NA" : str.tostring(sl_fixed))
    
    // Step 3: Validate and AUTO-CORRECT price relationship (defensive layer)
    // Instead of rejecting, we auto-fix SL to ensure minimum gap
    // Minimum 2.0 pips gap to prevent "zero profit" trades in the strategy tester
    float minGap = math.max(syminfo.mintick * 2, pip_size * 2.0)  // At least 2 pips
    
    if is_valid
        if is_short
            // For shorts: SL must be ABOVE entry
            if sl_fixed <= entry_price + minGap
                sl_fixed := entry_price + minGap  // Auto-correct
        else
            // For longs: SL must be BELOW entry
            if sl_fixed >= entry_price - minGap
                sl_fixed := entry_price - minGap  // Auto-correct
    
    // Step 4: Validate USDJPY rate for JPY pairs
    if is_valid and str.contains(syminfo.ticker, "JPY")
        [val_usdjpy_rate_result, val_usdjpy_success_result, val_usdjpy_error_result] = fetch_usdjpy_rate()
        if not val_usdjpy_success_result
            is_valid := false
            error_msg := val_usdjpy_error_result
            validation_details := "USDJPY rate unavailable for JPY pairs"
    
    // Step 5: Calculate position size
    float qty_units_raw = na
    if is_valid
        qty_units_raw := calc_pos_size_units(entry_price, sl_fixed, balance, risk_pct, is_short)
        
        if na(qty_units_raw) or qty_units_raw <= 0
            is_valid := false
            error_msg := "Position size calculation failed"
            validation_details := "Calculated units: " + (na(qty_units_raw) ? "NA" : str.tostring(qty_units_raw))
        
        // Convert to integer
        if is_valid
            qty_units := int(math.round(qty_units_raw))
            
            // Determine contract size for units-to-lots conversion
            // Gold: 100 oz/lot, Silver: 5000 oz/lot, Crypto: 1 unit/lot, Forex: 100,000 units/lot
            float contract_size = FOREX_LOT_SIZE
            int effective_min_units = min_position_size_units
            
            if str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
                contract_size := 100.0
                effective_min_units := 1  // Gold: minimum 1 oz (0.01 lots)
            else if str.contains(syminfo.ticker, "XAG") or str.contains(syminfo.ticker, "SILVER")
                contract_size := 5000.0
                effective_min_units := 1  // Silver: minimum 1 oz
            else if str.contains(syminfo.ticker, "BTC") or str.contains(syminfo.ticker, "ETH")
                contract_size := 1.0
                effective_min_units := 1  // Crypto: minimum 1 unit
            else if is_index  // Indices: NAS100, SPX, etc.
                contract_size := 1.0
                effective_min_units := 1  // Index: minimum 1 contract
            
            qty_lots := qty_units / contract_size
            
            // Step 6: Minimum position size check (using asset-appropriate minimum)
            if qty_units < effective_min_units
                is_valid := false
                error_msg := "Position size below minimum"
                validation_details := "Units: " + str.tostring(qty_units) + " (min: " + str.tostring(effective_min_units) + ")"
            
            // Step 7: Maximum position size check
            if is_valid and qty_lots > max_position_size_lots
                is_valid := false
                error_msg := "Position size exceeds maximum"
                validation_details := "Lots: " + str.tostring(qty_lots, "#.####") + " (max: " + str.tostring(max_position_size_lots) + ")"
            
            // Step 8: Final validation - ensure qty_units is positive and not na
            if is_valid and (na(qty_units) or qty_units <= 0)
                is_valid := false
                error_msg := "Invalid quantity units"
                validation_details := "Final units: " + (na(qty_units) ? "NA" : str.tostring(qty_units))
    
    [is_valid, qty_units, qty_lots, error_msg, validation_details, sl_fixed]

// Helper: Check if bar index is already used as zone base
is_base_bar_used(barIdx, baseArray) =>
    if array.size(baseArray) == 0
        false
    else
        found = false
        for j = 0 to array.size(baseArray) - 1
            if array.get(baseArray, j) == barIdx
                found := true
                break
        found

// === ZONE DETECTION TRACKING ===
var array<int> used_demand_base_times = array.new_int()
var array<int> used_supply_base_times = array.new_int()
var bool initial_scan_done = false

// === FRACTALS LOGIC ===
// NOTE: These helpers are written so that ta.highest/ta.lowest are *always* called
// on every bar, which removes "should be called on each calculation" warnings
// without changing the logical conditions.
f_isFractalHigh(_n) =>
    float hh = ta.highest(high, _n * 2 + 1)
    bool enoughBars = _n >= 1 and bar_index >= _n + 1
    bool cond = high[_n] == hh and high[_n] > high[_n + 1] and high[_n] > high[_n - 1]
    enoughBars and cond

f_isFractalLow(_n) =>
    float ll = ta.lowest(low, _n * 2 + 1)
    bool enoughBars = _n >= 1 and bar_index >= _n + 1
    bool cond = low[_n] == ll and low[_n] < low[_n + 1] and low[_n] < low[_n - 1]
    enoughBars and cond

bool isFractalHigh_result = f_isFractalHigh(fractalsPeriod)
bool isFractalLow_result  = f_isFractalLow(fractalsPeriod)

fractalBarIdx  = bar_index - fractalsPeriod
isZoneBaseBar  = (isFractalHigh_result or isFractalLow_result) ? 
                 (is_base_bar_used(fractalBarIdx, used_demand_base_times) or 
                  is_base_bar_used(fractalBarIdx, used_supply_base_times)) : false

fractalHigh = (not isZoneBaseBar and isFractalHigh_result) ? high[fractalsPeriod] : na
fractalLow  = (not isZoneBaseBar and isFractalLow_result) ? low[fractalsPeriod] : na

plotshape(not na(fractalHigh), style = shape.triangleup,   location = location.abovebar, color = color.green, size = size.small, offset = -fractalsPeriod)
plotshape(not na(fractalLow),  style = shape.triangledown, location = location.belowbar, color = color.red,   size = size.small, offset = -fractalsPeriod)

// === PIVOT-BASED LIQUIDITY (SIMPLE 3-CANDLE LIKE MAKUCHAKU) ===
var array<float> liqPvtHighPrices = array.new_float()
var array<int>   liqPvtHighBars   = array.new_int()
var array<float> liqPvtLowPrices  = array.new_float()
var array<int>   liqPvtLowBars    = array.new_int()

// Simple 3-candle pivot detection (like "Liquidity by makuchaku")
// A pivot low forms when: low[2] > low[1] and low[1] < low[0]
// A pivot high forms when: high[2] < high[1] and high[1] > high[0]
bool isPvtLow  = low[2] > low[1] and low[1] < low[0]
bool isPvtHigh = high[2] < high[1] and high[1] > high[0]

if isPvtLow
    // Pivot is at bar_index - 1 (the middle candle)
    array.push(liqPvtLowPrices, low[1])
    array.push(liqPvtLowBars, bar_index - 1)

if isPvtHigh
    // Pivot is at bar_index - 1 (the middle candle)
    array.push(liqPvtHighPrices, high[1])
    array.push(liqPvtHighBars, bar_index - 1)

// Trim to at most pvtMax recent liquidity levels
while array.size(liqPvtHighPrices) > pvtMax
    array.shift(liqPvtHighPrices)
    array.shift(liqPvtHighBars)
while array.size(liqPvtLowPrices) > pvtMax
    array.shift(liqPvtLowPrices)
    array.shift(liqPvtLowBars)



// Find zone in DB by UZID
db_findIndexByUZID(int targetUZID) =>
    int result = na
    if array.size(zoneDB) > 0
        for i = 0 to array.size(zoneDB) - 1
            ZoneDBEntry entry = array.get(zoneDB, i)
            if entry.uzid == targetUZID
                result := i
                break
    result

// Upsert zone into DB (add new or update existing)
db_upsertZone(Zone z, string zoneType) =>
    int idx = db_findIndexByUZID(z.id)
    if na(idx)
        // Create new entry
        ZoneDBEntry entry = ZoneDBEntry.new(
             uzid = z.id,
             zoneType = zoneType,
             top = z.top,
             bottom = z.bottom,
             createdBar = z.createdBarIndex,
             lastUpdateBar = bar_index,
             active = true,
             inactiveReason = "",
             liqLowPrice = z.liqLowPrice,
             liqLowBar = z.liqLowBar,
             liqHighPrice = z.liqHighPrice,
             liqHighBar = z.liqHighBar,
             liqSource = z.liqSource,
             liquiditySwept = z.liquiditySwept,
             liquidityCandleCount = z.liquidityCandleCount,
             causedSweep = z.causedSweep,
             legCandleCount = z.legCandleCount)
        array.push(zoneDB, entry)
        // Trim if too large (remove oldest)
        while array.size(zoneDB) > DB_MAX_SIZE
            array.shift(zoneDB)
    else
        // Update existing entry
        ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.top := z.top
        entry.bottom := z.bottom
        entry.lastUpdateBar := bar_index
        entry.active := true
        entry.inactiveReason := ""
        entry.liqLowPrice := z.liqLowPrice
        entry.liqLowBar := z.liqLowBar
        entry.liqHighPrice := z.liqHighPrice
        entry.liqHighBar := z.liqHighBar
        entry.liqSource := z.liqSource
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
        entry.legCandleCount := z.legCandleCount
    true  // Consistent return type

// Mark zone as inactive in DB with reason
db_markInactive(int targetUZID, string reason) =>
    int idx = db_findIndexByUZID(targetUZID)
    if not na(idx)
        ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.active := false
        entry.inactiveReason := reason
        entry.lastUpdateBar := bar_index
    true  // Consistent return type

// Update zone in DB with latest liquidity data (called during zone updates)
db_updateZoneLiquidity(Zone z) =>
    int idx = db_findIndexByUZID(z.id)
    if not na(idx)
        ZoneDBEntry entry = array.get(zoneDB, idx)
        entry.lastUpdateBar := bar_index
        entry.liqLowPrice := z.liqLowPrice
        entry.liqLowBar := z.liqLowBar
        entry.liqHighPrice := z.liqHighPrice
        entry.liqHighBar := z.liqHighBar
        entry.liqSource := z.liqSource
        entry.liquiditySwept := z.liquiditySwept
        entry.liquidityCandleCount := z.liquidityCandleCount
        entry.causedSweep := z.causedSweep
    true  // Consistent return type

// === UZID COUNTERS (Guaranteed Unique IDs) ===
var int global_zone_id_counter = 0  // Single Global counter for ALL zones (Demand + Supply)

// === CONSECUTIVE OPPOSITE CANDLE COUNTER ===
// Counts consecutive opposite-direction candles starting from the bar AFTER liqBar (forward in time)
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// Returns count (0 if liqBar is na or no opposite candles found)
// === CONSECUTIVE OPPOSITE CANDLE COUNTER ===
// Counts consecutive opposite-direction candles starting from the bar AFTER liqBar (forward in time)
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// Returns count (0 if liqBar is na or no opposite candles found)
// Helper: Get highest High between two absolute bar indices
getMaxHighBetween(int startBarAbs, int endBarAbs) =>
    float maxH = -1.0e10
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        // Loop safely
        for i = offStart to offEnd
            if high[i] > maxH
                maxH := high[i]
    maxH

// Helper: Get lowest Low between two absolute bar indices
getMinLowBetween(int startBarAbs, int endBarAbs) =>
    float minL = 1.0e10
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        // Loop safely
        for i = offStart to offEnd
            if low[i] < minL
                minL := low[i]
    minL

// === PRECISE TARGET FINDERS (Return Bar Index, Not Price) ===
// Find the Bar Index of the Highest High between two bars (Inclusive)
// startBarAbs and endBarAbs are absolute bar indices
// Returns the bar_index of the candle with the highest high in that range
getBarOfMaxHigh(int startBarAbs, int endBarAbs) =>
    float maxH = -1.0e10
    int bestBar = startBarAbs
    // Ensure valid range
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        if offStart >= 0 and offEnd >= 0
            for i = offStart to offEnd
                if high[i] >= maxH
                    maxH := high[i]
                    bestBar := bar_index - i
    bestBar

// Find the Bar Index of the Lowest Low between two bars (Inclusive)
// startBarAbs and endBarAbs are absolute bar indices
// Returns the bar_index of the candle with the lowest low in that range
getBarOfMinLow(int startBarAbs, int endBarAbs) =>
    float minL = 1.0e10
    int bestBar = startBarAbs
    // Ensure valid range
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs
        int offStart = bar_index - endBarAbs
        int offEnd   = bar_index - startBarAbs
        if offStart >= 0 and offEnd >= 0
            for i = offStart to offEnd
                if low[i] <= minL
                    minL := low[i]
                    bestBar := bar_index - i
    bestBar

// Counts opposite candles INSIDE the liquidity range
// isDemand: true = count bearish (close < open), false = count bullish (close > open)
// NOTE: rangeLow and rangeHigh parameters are kept for API compatibility but NOT used
// We count ALL opposite candles between the bars, since the liquidity leg concept
// refers to the candles forming the movement, not just candles in a price band
countOppCandlesInLiquidityRange(int startBarAbs, int endBarAbs, bool isDemand, float rangeLow, float rangeHigh) =>
    int count = 0
    // Guards: endBarAbs should be >= startBarAbs (end is same or later in time)
    // CRITICAL: Also guard against bar indices greater than current bar_index (causes negative offsets)
    if not na(startBarAbs) and not na(endBarAbs) and endBarAbs >= startBarAbs and startBarAbs <= bar_index and endBarAbs <= bar_index
        int offStart = bar_index - endBarAbs      // Offset for the end bar (newer, lower offset)
        int offEnd   = bar_index - startBarAbs    // Offset for the start bar (older, higher offset)
        
        // Additional safety: ensure offsets are non-negative
        if offStart >= 0 and offEnd >= 0
            // Cap loop to avoid performance issues
            int max_steps = 200
            int steps = 0
            
            // Iterate from start bar to end bar (older to newer)
            // Higher offset = older bar, lower offset = newer bar
            // We iterate from offEnd (older) down to offStart (newer)
            for i = offEnd to offStart
                if steps > max_steps
                    break
                steps += 1
                
                // Check opposite color
                bool isOpp = isDemand ? (close[i] < open[i]) : (close[i] > open[i])
                
                // Count ALL opposite candles between the bars (no price range filter)
                // The liquidity leg includes all candles forming the movement
                if isOpp
                    count += 1
    count

countConsecutiveOppCandles(int liqBar, bool isDemand) =>
    int count = 0
    if na(liqBar) or liqBar > bar_index
        0  // Return 0 for invalid liqBar or future bar
    else
        int offset = bar_index - liqBar
        if offset >= 1  // Need at least 1 bar after liqBar
            // Start from the bar AFTER liqBar and walk toward current bar
            // Count ALL matching opposite candles (no break on mismatch)
            for i = 1 to liq_candle_count_max
                int idx = offset - i  // Bar index offset from current bar
                if idx < 0  // Reached current bar
                    break
                // Use WICKS (high/low) for range check, not body
                bool isOppCandle = isDemand ? (close[idx] < open[idx]) : (close[idx] > open[idx])
                if isOppCandle
                    count += 1
                // NO BREAK - count all matching candles in the range
        count  // Return actual count (can be 0)

// === LOCAL LIQUIDITY SCAN HELPERS ===
// Fallback scan to find nearest-by-price liquidity within constraints when no pivots are found

// Find closest-by-price LOW within distance
// Returns [price, bar_index] tuple (or [na, na] if none found)
// isInducement: true = look for Low >= zoneTop (Demand Inducement), false = look for Low <= zoneBottom (Standard)
findLocalDemandLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0
    
    // Scan history
    for off = 0 to lookback
        float candidate = low[off]
        // Check side tolerance
        bool isSideValid = isInducement ? (candidate >= refPrice - sideTol) : (candidate <= refPrice + sideTol)
        
        if isSideValid
            float dist = math.abs(candidate - refPrice)
            // Check max distance
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

// Find closest-by-price HIGH within distance
// Returns [price, bar_index] tuple (or [na, na] if none found)
// isInducement: true = look for High <= zoneBottom (Supply Inducement), false = look for High >= zoneTop (Standard)
findLocalSupplyLiquidity(float refPrice, float maxDistPrice, float sideTol, int lookback, bool isInducement) =>
    float bestPrice = na
    int bestBar = na
    float bestDist = 999999.0
    
    // Scan history
    for off = 0 to lookback
        float candidate = high[off]
        // Check side tolerance
        bool isSideValid = isInducement ? (candidate <= refPrice + sideTol) : (candidate >= refPrice - sideTol)
        
        if isSideValid
            float dist = math.abs(candidate - refPrice)
            // Check max distance
            if dist <= maxDistPrice
                if na(bestPrice) or dist < bestDist
                    bestDist := dist
                    bestPrice := candidate
                    bestBar := bar_index - off
    [bestPrice, bestBar]

// =============================
// MODULAR LIQUIDITY SCAN FUNCTIONS
// =============================
// These functions encapsulate the liquidity scanning logic to reduce main body size
// and implement chronological search: Inducement first, then Target BEFORE it

// === 3-CANDLE PIVOT HELPERS (Makuchaku Style) ===
// Objective pivot detection: checks if candle at [idx+1] is a structural turning point
// Looking at three consecutive candles: [idx], [idx+1], [idx+2]
// These are the building blocks of our liquidity detection
is_makuchaku_pvt_low(idx) =>
    low[idx+1] < low[idx] and low[idx+1] < low[idx+2]

is_makuchaku_pvt_high(idx) =>
    high[idx+1] > high[idx] and high[idx+1] > high[idx+2]

// NEW: Simple 3-Candle Pivot Scan for Demand Liquidity
// Finds the lowest valid pivot that sits above the zone (Inducement liquidity)
// FIXED: Now enforces absolute maximum high for Target (not just pivot highs)
f_scan_demand_liquidity(int zoneArrayIndex) =>
    Zone z = array.get(demandZones, zoneArrayIndex)

    // Skip if zone not eligible
    if na(z.createdBarIndex) or bar_index <= z.createdBarIndex or z.isHistorical
        true
    else
        // === STEP A: INDUCEMENT SCAN (LOWEST valid pivot low above zone) ===
        float bestLiqPrice = 1.0e10  // Start high, look for lowest valid pivot
        int bestLiqBar = na

        // Scan from zone creation forward to current bar
        // Maximum offset: we need at least 2 bars history for the pivot check
        int maxOff = bar_index - z.createdBarIndex - 2

        if maxOff >= 0
            for off = 0 to maxOff
                // Check if candle at [off+1] is a 3-candle pivot low
                // Condition: low[off+1] < low[off] AND low[off+1] < low[off+2]
                if is_makuchaku_pvt_low(off)
                    float pLow = low[off+1]
                    int pBar = bar_index - (off + 1)

                    // Pivot must be AFTER zone creation
                    if pBar > z.createdBarIndex
                        // VALIDATION: Check pivot location based on model selected
                        bool isValidLocation = false
                        float distFromZone = 0.0

                        if use_inducement_linking
                            // MODEL B (Inducement): Inducement must be ABOVE zone top
                            isValidLocation := pLow > z.top
                            distFromZone := pLow - z.top
                        else
                            // MODEL A (Standard): Inducement must be BELOW zone bottom
                            isValidLocation := pLow < z.bottom
                            distFromZone := z.bottom - pLow

                        if isValidLocation
                            // Check distance constraints if set
                            float maxDistPrice = effective_liq_max_dist * pip_size
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZone <= maxDistPrice

                            if distOK
                                // We want the LOWEST valid pivot (closest to zone = inducement)
                                if pLow < bestLiqPrice
                                    bestLiqPrice := pLow
                                    bestLiqBar := pBar
                                // Continue scanning - DO NOT BREAK

        // If we found a valid inducement pivot, configure the zone
        if not na(bestLiqBar) and bestLiqPrice < 1.0e10
            // === CHECK IF INDUCEMENT (LIQ LOW) CHANGED ===
            // If the inducement price has changed, reset the inducement sweep flag
            bool inductionChanged = na(z.liqLowPrice) or z.liqLowPrice != bestLiqPrice or na(z.liqLowBar) or z.liqLowBar != bestLiqBar

            z.liquidityPrice := bestLiqPrice
            z.liquidityBarIndex := bestLiqBar
            z.liqLowPrice := bestLiqPrice
            z.liqLowBar := bestLiqBar

            // Reset inducement sweep if it changed (force re-validation)
            if inductionChanged
                z.liquiditySwept := false
                z.liquiditySweptBarIndex := na

            // === STEP B: STRICT TARGET SCAN (ABSOLUTE HIGHEST price BEFORE inducement) ===
            // CRITICAL FIX: Find the ABSOLUTE HIGHEST high in the strict range:
            // [Zone Creation Bar ... Inducement Bar - 1]
            // This is NOT limited to 3-candle pivots - we need the true maximum!
            // NOTE: Target scan ALWAYS runs (not gated by targetSwept) to ensure proper data storage

            // Define the strict search range: must end STRICTLY BEFORE inducement bar
            int rangeStart = z.createdBarIndex
            int rangeEnd = bestLiqBar - 1  // STRICTLY before inducement

            // Initialize target values
            float bestTargetPrice = na
            int bestTargetBar = na

            // Validate range exists and is logical
            if rangeEnd >= rangeStart and rangeEnd <= bar_index and rangeStart >= 0
                // Use getBarOfMaxHigh to find the ABSOLUTE maximum high in the range
                // This includes ALL candles, not just 3-candle pivots
                // Returns the bar_index of the candle with highest high in [rangeStart, rangeEnd]
                bestTargetBar := getBarOfMaxHigh(rangeStart, rangeEnd)

                // If target bar found, retrieve the high price at that bar
                if not na(bestTargetBar) and bestTargetBar >= rangeStart and bestTargetBar <= rangeEnd
                    int targetOffset = bar_index - bestTargetBar
                    if targetOffset >= 0 and targetOffset < 5000  // Safety bounds
                        bestTargetPrice := high[targetOffset]

            // === CHECK IF TARGET (LIQ HIGH) CHANGED ===
            // If the target price has changed, reset the target sweep flag
            bool targetChanged = na(z.liqHighPrice) or z.liqHighPrice != bestTargetPrice or na(z.liqHighBar) or z.liqHighBar != bestTargetBar

            // Assign target values (even if na, this ensures explicit storage)
            z.liqHighBar := bestTargetBar
            z.liqHighPrice := bestTargetPrice

            // Reset target sweep if it changed (force re-validation)
            if targetChanged
                z.targetSwept := false
                z.targetSweptBarIndex := na

            // Mark zone as liquidity valid
            z.liquidityValid := true
            z.inactiveReason := na
            z.liquidityCandleCount := 3  // 3-candle pivot by definition
            z.legCandleCount := 3
            z.liqSource := "MAKUCHAKU_PIVOT"

            // Set structure sweep level (the target that must be swept)
            z.structureSweepLevel := z.liqHighPrice
            z.structureSweepLevelBar := z.liqHighBar

            // Store time values for multi-TF alignment (used for replay/multi-TF consistency)
            int indOff = bar_index - bestLiqBar
            int tgtOff = na(z.liqHighBar) ? na : (bar_index - z.liqHighBar)
            z.liqLowTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            z.liqHighTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na

            // === CRITICAL FIX: SAVE DATA TO DATABASE ===
            // Without this, data is lost when zone is pruned from live arrays!
            db_updateZoneLiquidity(z)
        else
            // No valid pivot found yet
            z.liquidityValid := false
            z.inactiveReason := "WAITING_PIVOT"

        true

// NEW: Simple 3-Candle Pivot Scan for Supply Liquidity
// Finds the highest valid pivot that sits below the zone (Inducement liquidity)
// FIXED: Now enforces absolute minimum low for Target (not just pivot lows)
f_scan_supply_liquidity(int zoneArrayIndex) =>
    Zone z = array.get(supplyZones, zoneArrayIndex)

    // Skip if zone not eligible
    if na(z.createdBarIndex) or bar_index <= z.createdBarIndex or z.isHistorical
        true
    else
        // === STEP A: INDUCEMENT SCAN (HIGHEST valid pivot high below zone) ===
        float bestLiqPrice = 0.0  // Start low, look for highest valid pivot
        int bestLiqBar = na

        // Scan from zone creation forward to current bar
        // Maximum offset: we need at least 2 bars history for the pivot check
        int maxOff = bar_index - z.createdBarIndex - 2

        if maxOff >= 0
            for off = 0 to maxOff
                // Check if candle at [off+1] is a 3-candle pivot high
                // Condition: high[off+1] > high[off] AND high[off+1] > high[off+2]
                if is_makuchaku_pvt_high(off)
                    float pHigh = high[off+1]
                    int pBar = bar_index - (off + 1)

                    // Pivot must be AFTER zone creation
                    if pBar > z.createdBarIndex
                        // VALIDATION: Check pivot location based on model selected
                        bool isValidLocation = false
                        float distFromZone = 0.0

                        if use_inducement_linking
                            // MODEL B (Inducement): Inducement must be BELOW zone bottom
                            isValidLocation := pHigh < z.bottom
                            distFromZone := z.bottom - pHigh
                        else
                            // MODEL A (Standard): Inducement must be ABOVE zone top
                            isValidLocation := pHigh > z.top
                            distFromZone := pHigh - z.top

                        if isValidLocation
                            // Check distance constraints if set
                            float distFromZoneCheck = distFromZone
                            float maxDistPrice = effective_liq_max_dist * pip_size
                            bool distOK = na(maxDistPrice) or maxDistPrice <= 0 or distFromZoneCheck <= maxDistPrice

                            if distOK
                                // We want the HIGHEST valid pivot (closest to zone = inducement)
                                if pHigh > bestLiqPrice
                                    bestLiqPrice := pHigh
                                    bestLiqBar := pBar
                                // Continue scanning - DO NOT BREAK

        // If we found a valid inducement pivot, configure the zone
        if not na(bestLiqBar) and bestLiqPrice > 0.0
            // === CHECK IF INDUCEMENT (LIQ HIGH) CHANGED ===
            // If the inducement price has changed, reset the inducement sweep flag
            bool inductionChanged = na(z.liqHighPrice) or z.liqHighPrice != bestLiqPrice or na(z.liqHighBar) or z.liqHighBar != bestLiqBar

            z.liquidityPrice := bestLiqPrice
            z.liquidityBarIndex := bestLiqBar
            z.liqHighPrice := bestLiqPrice
            z.liqHighBar := bestLiqBar

            // Reset inducement sweep if it changed (force re-validation)
            if inductionChanged
                z.liquiditySwept := false
                z.liquiditySweptBarIndex := na

            // === STEP B: STRICT TARGET SCAN (ABSOLUTE LOWEST price BEFORE inducement) ===
            // CRITICAL FIX: Find the ABSOLUTE LOWEST low in the strict range:
            // [Zone Creation Bar ... Inducement Bar - 1]
            // This is NOT limited to 3-candle pivots - we need the true minimum!
            // NOTE: Target scan ALWAYS runs (not gated by targetSwept) to ensure proper data storage

            // Define the strict search range: must end STRICTLY BEFORE inducement bar
            int rangeStart = z.createdBarIndex
            int rangeEnd = bestLiqBar - 1  // STRICTLY before inducement

            // Initialize target values
            float bestTargetPrice = na
            int bestTargetBar = na

            // Validate range exists and is logical
            if rangeEnd >= rangeStart and rangeEnd <= bar_index and rangeStart >= 0
                // Use getBarOfMinLow to find the ABSOLUTE minimum low in the range
                // This includes ALL candles, not just 3-candle pivots
                // Returns the bar_index of the candle with lowest low in [rangeStart, rangeEnd]
                bestTargetBar := getBarOfMinLow(rangeStart, rangeEnd)

                // If target bar found, retrieve the low price at that bar
                if not na(bestTargetBar) and bestTargetBar >= rangeStart and bestTargetBar <= rangeEnd
                    int targetOffset = bar_index - bestTargetBar
                    if targetOffset >= 0 and targetOffset < 5000  // Safety bounds
                        bestTargetPrice := low[targetOffset]

            // === CHECK IF TARGET (LIQ LOW) CHANGED ===
            // If the target price has changed, reset the target sweep flag
            bool targetChanged = na(z.liqLowPrice) or z.liqLowPrice != bestTargetPrice or na(z.liqLowBar) or z.liqLowBar != bestTargetBar

            // Assign target values (even if na, this ensures explicit storage)
            z.liqLowBar := bestTargetBar
            z.liqLowPrice := bestTargetPrice

            // Reset target sweep if it changed (force re-validation)
            if targetChanged
                z.targetSwept := false
                z.targetSweptBarIndex := na

            // Mark zone as liquidity valid
            z.liquidityValid := true
            z.inactiveReason := na
            z.liquidityCandleCount := 3  // 3-candle pivot by definition
            z.legCandleCount := 3
            z.liqSource := "MAKUCHAKU_PIVOT"

            // Set structure sweep level (the target that must be swept)
            z.structureSweepLevel := z.liqLowPrice
            z.structureSweepLevelBar := z.liqLowBar

            // Store time values for multi-TF alignment (used for replay/multi-TF consistency)
            int indOff = bar_index - bestLiqBar
            int tgtOff = na(z.liqLowBar) ? na : (bar_index - z.liqLowBar)
            z.liqHighTime := indOff >= 0 and indOff <= bar_index ? time[indOff] : na
            z.liqLowTime := not na(tgtOff) and tgtOff >= 0 and tgtOff <= bar_index ? time[tgtOff] : na

            // === CRITICAL FIX: SAVE DATA TO DATABASE ===
            // Without this, data is lost when zone is pruned from live arrays!
            db_updateZoneLiquidity(z)
        else
            // No valid pivot found yet
            z.liquidityValid := false
            z.inactiveReason := "WAITING_PIVOT"

        true

// Check inducement and target sweeps for demand zone
// Target Sweep detection requires liquidityValid (proper pivot scan completed)
// This ensures the Target High is correctly calculated before checking for sweep
f_check_demand_sweeps(int zoneArrayIndex) =>
    Zone z = array.get(demandZones, zoneArrayIndex)
    bool needsPersist = false
    
    // === INDUCEMENT SWEEP CHECK ===
    // Inducement Low for Demand: price drops to/below liqLowPrice
    if not na(z.liqLowPrice) and not z.liquiditySwept
        float sweepTolerance = pip_size * 0.5
        float sweepLevel = z.liqLowPrice + sweepTolerance
        
        if low <= sweepLevel
            z.liquiditySwept := true
            z.liquiditySweptBarIndex := bar_index
            z.causedSweep := true
            needsPersist := true
    
    // === TARGET SWEEP CHECK ===
    // Target High for Demand: price rises to/above liqHighPrice
    // CRITICAL: Only check AFTER liquidityValid is true (proper pivot scan completed)
    // This ensures liqHighPrice is correctly set before we check for sweep
    if z.liquidityValid and not na(z.liqHighPrice) and not na(z.liqHighBar) and not z.targetSwept
        float targetSweepTolerance = pip_size * 0.5
        float targetSweepLevel = z.liqHighPrice - targetSweepTolerance
        
        if high >= targetSweepLevel
            z.targetSwept := true
            z.targetSweptBarIndex := bar_index
            // Only set causedSweep if not already set by inducement
            if not z.causedSweep
                z.causedSweep := true
            needsPersist := true
    
    // === PERSIST CHANGES ONCE ===
    if needsPersist
        array.set(demandZones, zoneArrayIndex, z)
    true  // Return dummy value

// Check inducement and target sweeps for supply zone
// Target Sweep detection requires liquidityValid (proper pivot scan completed)
// This ensures the Target Low is correctly calculated before checking for sweep
f_check_supply_sweeps(int zoneArrayIndex) =>
    Zone z = array.get(supplyZones, zoneArrayIndex)
    bool needsPersist = false
    
    // === INDUCEMENT SWEEP CHECK ===
    // Inducement High for Supply: price rises to/above liqHighPrice
    if not na(z.liqHighPrice) and not z.liquiditySwept
        float sweepTolerance = pip_size * 0.5
        float sweepLevel = z.liqHighPrice - sweepTolerance
        
        if high >= sweepLevel
            z.liquiditySwept := true
            z.liquiditySweptBarIndex := bar_index
            z.causedSweep := true
            needsPersist := true
    
    // === TARGET SWEEP CHECK ===
    // Target Low for Supply: price drops to/below liqLowPrice
    // CRITICAL: Only check AFTER liquidityValid is true (proper pivot scan completed)
    // This ensures liqLowPrice is correctly set before we check for sweep
    if z.liquidityValid and not na(z.liqLowPrice) and not na(z.liqLowBar) and not z.targetSwept
        float targetSweepTolerance = pip_size * 0.5
        float targetSweepLevel = z.liqLowPrice + targetSweepTolerance
        
        if low <= targetSweepLevel
            z.targetSwept := true
            z.targetSweptBarIndex := bar_index
            // Only set causedSweep if not already set by inducement
            if not z.causedSweep
                z.causedSweep := true
            needsPersist := true
    
    // === PERSIST CHANGES ONCE ===
    if needsPersist
        array.set(supplyZones, zoneArrayIndex, z)
    true  // Return dummy value

// === OPTIMIZED ZONE REMOVAL HELPER ===
// Consolidated function to remove demand zone from all arrays (reduces code duplication)
// === UNIFIED ZONE MANAGEMENT HELPERS ===

// Trim base time arrays to prevent memory bloat
// Trim base time arrays to prevent memory bloat
trimBaseTimeArrays() =>
    maxCount = max_zones * 2
    while array.size(used_demand_base_times) > maxCount
        array.pop(used_demand_base_times)
    while array.size(used_supply_base_times) > maxCount
        array.pop(used_supply_base_times)

// Unified Array Trimming (keeps zone boxes and connector lines cleaned up)
trimZoneArrays(bool isDemand) =>
    maxCount = max_zones
    if isDemand
        while array.size(demandZones) > maxCount
            Zone z = array.pop(demandZones)
            db_markInactive(z.id, "max_pruned")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            if not na(z.idLabel)
                label.delete(z.idLabel)
    else
        while array.size(supplyZones) > maxCount
            Zone z = array.pop(supplyZones)
            db_markInactive(z.id, "max_pruned")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
            if not na(z.targetLine)
                line.delete(z.targetLine)
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
            if not na(z.idLabel)
                label.delete(z.idLabel)

// === MAIN ZONE CREATION FUNCTION ===
createZone(int baseIdx, bool isDemand, bool isHistorical, int candlesInBase, int legCandles, int zoneUZID) =>
    // Determine Base Candle (relative to current bar)
    // baseIdx is offset (e.g. 1 means bar_index - 1)
    baseBarIdx = bar_index - baseIdx
    
    // Check if base bar time is already used
    int baseTime = time[baseIdx]
    bool alreadyUsed = false
    if isDemand
        if array.includes(used_demand_base_times, baseTime)
            alreadyUsed := true
        else
            array.push(used_demand_base_times, baseTime)
            trimBaseTimeArrays()
    else
        if array.includes(used_supply_base_times, baseTime)
            alreadyUsed := true
        else
            array.push(used_supply_base_times, baseTime)
            trimBaseTimeArrays()
            
    if not alreadyUsed
        // Calculate Zone Coordinates
        float baseHigh = high[baseIdx]
        float baseLow  = low[baseIdx]
        float baseOpen = open[baseIdx]
        float baseClose = close[baseIdx]
        
        // === FVG / IMBALANCE CHECK ===
        // If FVG Confluence is enabled, only create zone if displacement left an FVG/Imbalance
        // Imbalance is between the BASE candle and the 2nd candle after it (Candle C)
        // Base = baseIdx
        // Reaction/Explosion = baseIdx - 1
        // Follow-through/Validation = baseIdx - 2
        bool hasFVG = false
        // Ensure we have enough history (need candle at baseIdx - 2)
        if use_fvg_confirmation and (baseIdx - 2) >= 0
            if isDemand
                // Demand FVG: Low of (baseIdx - 2) > High of (baseIdx)
                // Gap exists above the zone candle
                if low[baseIdx - 2] > high[baseIdx]
                    hasFVG := true
            else
                // Supply FVG: High of (baseIdx - 2) < Low of (baseIdx)
                // Gap exists below the zone candle
                if high[baseIdx - 2] < low[baseIdx]
                    hasFVG := true
            
            // If FVG required but not present, ABORT zone creation
            if not hasFVG
                // Return dummy void result (Pine Script functions are weird with void returns)
                // We'll just set zTop/zBottom to na and exit logic block if we could
                // But since we are in a function, we can't 'return' easily in middle
                // We will wrap the rest of the logic in a check
                na
        
        // Proceed only if FVG check passed (or disabled)
        bool proceed_creation = not use_fvg_confirmation or hasFVG
        
        // Define variable first
        bool isAccuracy = false

        if proceed_creation
            // Determine if it's an "Accuracy" zone:
            // Rule: Compare Zone Candle (baseIdx) to Reaction Candle (baseIdx - 1)
            // The reaction candle is the one that started the move AFTER the zone candle
    
            // Define the Reaction candle (The candle that started the move)
            // Since baseIdx is the offset from current bar, the candle "after" it in time is at (baseIdx - 1)
            int reactionIdx = baseIdx - 1
    
            // Only check for accuracy zones if enabled (disabled for XAUUSD, NAS100, etc.)
            if should_use_accuracy_zones and reactionIdx >= 0
                if isDemand
                    // DEMAND ACCURACY RULE:
                    // If the Zone Candle (Red) goes HIGHER than the Reaction Candle (Green)
                    // We use the Body (Open) as the Top.
                    // Condition: Zone High > Reaction High
                    if high[baseIdx] > high[reactionIdx]
                        isAccuracy := true
                else
                    // SUPPLY ACCURACY RULE:
                    // If the Zone Candle (Green) goes LOWER than the Reaction Candle (Red)
                    // We use the Body (Open) as the Bottom.
                    // Condition: Zone Low < Reaction Low
                    if low[baseIdx] < low[reactionIdx]
                        isAccuracy := true
    
        float zTop = na
        float zBottom = na

        // Only calculate coordinates if proceeding
        if proceed_creation
            if isAccuracy
                if isDemand
                    // Demand Accuracy: Ignore Top Wick
                    // Top = OPEN (Body Top)
                    // Bottom = LOW (Extreme)
                    zTop := baseOpen
                    zBottom := baseLow
                else
                    // Supply Accuracy: Ignore Bottom Wick
                    // Top = HIGH (Extreme)
                    // Bottom = OPEN (Body Bottom)
                    zTop := baseHigh
                    zBottom := baseOpen
            else
                // Normal zones: Full candle range
                zTop := baseHigh
                zBottom := baseLow
        
            // Cap zone size to avoid overly large zones
            max_zone_size = 50.0 * pip_size
            if (zTop - zBottom) > max_zone_size
                // Keep current range even if large - no adjustment needed
                true  // No-op, just for syntax

        // Initialize zone creation variables to defaults to ensure scope validity
        int zoneBorderWidth = 1
        color zoneBgColor = na
        color zoneBorderColorFinal = na
        
        // Only proceed with object creation if coordinates are valid (FVG check passed)
        if not na(zTop) and not na(zBottom)
            // Create Visual Box with thicker border and distinct color for Accuracy zones
            zoneBorderWidth := isAccuracy ? 2 : 1  // Slightly thicker border for accuracy zones
            
            if isAccuracy
                // Accuracy zones: Blue for demand, Purple for supply - more visible
                if isDemand
                    zoneBgColor := col_acc_demand_bg
                    zoneBorderColorFinal := col_acc_demand_border
                else
                    zoneBgColor := col_acc_supply_bg
                    zoneBorderColorFinal := col_acc_supply_border
            else
                // Normal zones: subtle colors
                zoneBgColor := isDemand ? col_demand_bg : col_supply_bg
                zoneBorderColorFinal := isDemand ? col_demand_border : col_supply_border

            box b = box.new(left = baseBarIdx, top = zTop, right = baseBarIdx + extend_bars, bottom = zBottom,
                 border_color = zoneBorderColorFinal,
                 border_width = zoneBorderWidth,
                 bgcolor = zoneBgColor,
                 xloc = xloc.bar_index)

            // Create ID Label with solid background for visibility
            string accTag = isAccuracy ? "⭐ ACC " : ""

            // DEBUG: Add comparison info to label if debug active
            if show_debug_labels and isAccuracy
                string debugInfo = ""
                if isDemand
                    float zoneHigh = high[baseIdx]
                    float reactionHigh = high[baseIdx - 1]
                    debugInfo := " [Z:" + str.tostring(zoneHigh, format.mintick) + " > R:" + str.tostring(reactionHigh, format.mintick) + "]"
                else
                    float zoneLow = low[baseIdx]
                    float reactionLow = low[baseIdx - 1]
                    debugInfo := " [Z:" + str.tostring(zoneLow, format.mintick) + " < R:" + str.tostring(reactionLow, format.mintick) + "]"

                accTag := accTag + debugInfo

            string id_text = " " + accTag + (isDemand ? "D-" : "S-") + str.tostring(zoneUZID) + " "
            float mid = (zTop + zBottom) / 2.0
            // Label colors match zone colors - accuracy zones use blue/purple
            color lbl_bg_color = na
            if isAccuracy
                lbl_bg_color := isDemand ? color.new(#2196F3, 0) : color.new(#AB47BC, 0)  // Blue for demand ACC, Purple for supply ACC
            else
                lbl_bg_color := isDemand ? color.new(#26a69a, 0) : color.new(#ef5350, 0)  // Teal for demand, Coral for supply
            label idLbl = label.new(x = baseBarIdx, y = mid, text = id_text,
                 style = label.style_label_left, textcolor = color.white, color = lbl_bg_color,
                 size = size.tiny,  // Forced tiny size for clean chart
                 textalign = text.align_center, xloc = xloc.bar_index)

            // Create Zone Object
            Zone z = Zone.new()
            z.id := zoneUZID
            z.boxId := b
            z.top := zTop
            z.bottom := zBottom
            z.active := true
            z.createdBarIndex := baseBarIdx
            z.isHistorical := isHistorical
            z.startTime := time[baseIdx]
            z.idLabel := idLbl
            z.touchCount := 0  // Initialize touch count for V5 AI tracking
            z.isAccuracy := isAccuracy  // Tag zone type for trade tracking

            // === SCORING SYSTEM INTEGRATION ===
            // Calculate Score (0-100)
            z.score := calculate_zone_score(isDemand, zTop, zBottom, baseIdx, legCandles, false, false, candlesInBase, isAccuracy)
            z.grade := get_grade_from_score(z.score)
            
            // === V6 AI FEATURES (CONDITIONAL - Only if enabled) ===
            // IMPORTANT: Call functions unconditionally for Pine Script series consistency
            float temp_base_quality = calculate_base_quality(baseBarIdx, baseIdx)
            float temp_departure_strength = calculate_departure_strength(baseIdx, isDemand)
            
            if enable_v6_v7_features
                z.baseQuality := temp_base_quality
                z.departureStrength := temp_departure_strength
            else
                // Default values when disabled (neutral 50)
                z.baseQuality := 50.0
                z.departureStrength := 50.0
            
            // Update Label with Grade if enabled
            if show_grade_on_zone
                // Recreate label text with grade
                string gradeStr = "[" + z.grade + "] "
                label.set_text(idLbl, gradeStr + id_text)
                 
            // Add to array and register in DB
            if isDemand
                array.unshift(demandZones, z)
                db_upsertZone(z, "DEMAND")
                trimZoneArrays(true)
            else
                array.unshift(supplyZones, z)
                db_upsertZone(z, "SUPPLY")
                trimZoneArrays(false)

// Unified Zone Removal
remove_zone_all_arrays(bool isDemand, int idx) =>
    if isDemand
        if idx >= 0 and idx < array.size(demandZones)
            Zone z = array.get(demandZones, idx)
            db_markInactive(z.id, "removed")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na  // Explicitly free memory
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na  // Explicitly free memory
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na  // Explicitly free memory
            if not na(z.idLabel)
                label.delete(z.idLabel)
                z.idLabel := na  // Explicitly free memory
            array.remove(demandZones, idx)
    else
        if idx >= 0 and idx < array.size(supplyZones)
            Zone z = array.get(supplyZones, idx)
            db_markInactive(z.id, "removed")  // Mark as inactive before removal
            box.delete(z.boxId)
            if not na(z.connectorLine)
                line.delete(z.connectorLine)
                z.connectorLine := na  // Explicitly free memory
            if not na(z.targetLine)
                line.delete(z.targetLine)
                z.targetLine := na  // Explicitly free memory
            if not na(z.inducementHLine)
                line.delete(z.inducementHLine)
                z.inducementHLine := na  // Explicitly free memory
            if not na(z.targetHLine)
                line.delete(z.targetHLine)
                z.targetHLine := na  // Explicitly free memory
            if not na(z.idLabel)
                label.delete(z.idLabel)
                z.idLabel := na  // Explicitly free memory
            array.remove(supplyZones, idx)

// === LIQUIDITY DISTANCE HELPER FUNCTIONS ===
// Calculate distance from zone edge to liquidity level in pips
// For Supply: zoneBottom - liqHighPrice (zone bottom is closest to the inducement high below)
// For Demand: liqLowPrice - zoneTop (zone top is closest to the inducement low above)
getLiquidityDistance(Zone z, bool isSupply) =>
    float dist = na
    if isSupply
        // Supply: distance from zone BOTTOM to the liquidity HIGH (inducement high)
        // The inducement high is BELOW the zone, so measure from zone bottom
        // Formula: supplyZoneBottom - supplyLiquidityHigh
        if not na(z.liqHighPrice) and not na(z.bottom)
            dist := (z.bottom - z.liqHighPrice) / pip_size
    else
        // Demand: distance from liquidity LOW (inducement low) to zone TOP
        // The inducement low is ABOVE the zone, so measure from zone top
        // Formula: demandLiquidityLow - demandZoneTop
        if not na(z.liqLowPrice) and not na(z.top)
            dist := (z.liqLowPrice - z.top) / pip_size
    // Return absolute value to ensure positive distance
    na(dist) ? na : math.abs(dist)

// Check if liquidity distance is within limit
// Returns true if within limit or if limit is 0 (no limit)
checkLiquidityDistance(Zone z, bool isSupply) =>
    if effective_liq_entry_max_dist == 0.0
        true  // No limit when set to 0
    else
        float dist = getLiquidityDistance(z, isSupply)
        na(dist) or dist <= effective_liq_entry_max_dist



// === TIME DEAD ZONE FILTER (Arger FX Rule) ===
// Block entries in the last 10 minutes of each hour (xx:50 - xx:00)
// This avoids volatility spikes at 1H candle closes
// NOTE: Defined here before validate_entry_conditions which calls it
is_time_dead_zone() =>
    if not filter_dead_zone
        false  // Filter disabled, allow all entries
    else
        int currentMinute = minute(time)
        // Dead zone: minutes 50-59 (last 10 minutes of each hour)
        currentMinute >= 50

// === TRADING HOURS FILTER (Israel Time) ===
// Block entries outside of 07:00-22:00 Israel time (GMT+2/GMT+3 depending on DST)
// This avoids:
// - Swap hour (around 00:00)
// - Low-liquidity Asian session hours (late night/early morning)
// - Late-night volatility spikes
is_outside_trading_hours() =>
    if not filter_trading_hours
        false  // Filter disabled, allow all entries
    else
        // Israel timezone: Use "Asia/Jerusalem" which handles DST automatically
        int israelHour = hour(time, "Asia/Jerusalem")
        // Block if hour is before start or at/after end
        // Example: start=7, end=22 means allow 07:00-21:59, block 22:00-06:59
        israelHour < trading_start_hour or israelHour >= trading_end_hour

// Unified Entry Validation
validate_entry_conditions(bool isDemand, int idx) =>
    bool canEnter = true
    string reason = ""
    Zone z = na

    if isDemand
        if idx < 0 or idx >= array.size(demandZones)
            canEnter := false
            reason := "Invalid demand zone index"
        else
            z := array.get(demandZones, idx)
    else
        if idx < 0 or idx >= array.size(supplyZones)
            canEnter := false
            reason := "Invalid supply zone index"
        else
            z := array.get(supplyZones, idx)

    if canEnter
        if not z.active
            canEnter := false
            reason := isDemand ? "Demand zone inactive" : "Supply zone inactive"

    // === TIME DEAD ZONE FILTER (Arger FX Rule) ===
    // Block entries in the last 10 minutes of each hour (xx:50 - xx:00)
    // Check this EARLY so user sees clear timing message
    if canEnter and is_time_dead_zone()
        canEnter := false
        reason := "Dead Zone: Blocked at " + str.tostring(minute(time)) + "m (avoid xx:50-xx:00)"

    // === TRADING HOURS FILTER (Israel Time) ===
    // Block entries outside allowed trading window (default: 07:00-22:00)
    if canEnter and is_outside_trading_hours()
        canEnter := false
        int israelHour = hour(time, "Asia/Jerusalem")
        reason := "Outside Trading Hours: " + str.tostring(israelHour) + ":00 (allowed: " + str.tostring(trading_start_hour) + ":00-" + str.tostring(trading_end_hour) + ":00)"

    if canEnter
        // Zone must not have been touched BEFORE sweep
        if z.touchedPreSweep
            canEnter := false
            reason := "Start Freshness Failed (Touched Pre-Sweep)"
            
        // Zone must have caused sweep & not be historical
        if canEnter and not z.causedSweep
            canEnter := false
            reason := isDemand ? "Waiting for Inducement Sweep (Demand)" : "Waiting for Inducement Sweep (Supply)"
        if canEnter and z.isHistorical
            canEnter := false
            reason := isDemand ? "Demand zone created in historical backfill" : "Supply zone created in historical backfill"

        // Liquidity existence (candle-count rule) & sweep timing
        if canEnter and require_liquidity_sweep
            if not z.liquidityValid
                canEnter := false
                reason := isDemand ? "Demand liquidity invalid (candle-count rule failed)" : "Supply liquidity invalid (candle-count rule failed)"
            else if not z.liquiditySwept
                canEnter := false
                reason := isDemand ? "Waiting for Inducement Sweep (Demand)" : "Waiting for Inducement Sweep (Supply)"
            else if not z.targetSwept
                canEnter := false
                reason := isDemand ? "Waiting for Target HIGH Sweep (Demand)" : "Waiting for Target LOW Sweep (Supply)"
            else if na(z.liquiditySweptBarIndex) or bar_index < z.liquiditySweptBarIndex
                canEnter := false
                reason := isDemand ? "Demand entry before liquidity sweep bar" : "Supply entry before liquidity sweep bar"
            // DOUBLE SWEEP GATE: Both Target and Inducement must be swept
            // NOTE: Target can be swept BEFORE Inducement in the "Double Sweep" model
            // (The rally that creates the Inducement Low often sweeps the Target High first)
            // Only require that both bar indices are set (both sweeps occurred)
            else if na(z.targetSweptBarIndex)
                canEnter := false
                reason := "Target sweep bar index not set"
            else
                // Check liquidity distance from zone boundary (using helper function)
                // For Supply: liqHighPrice to zone top
                // For Demand: liqLowPrice to zone bottom
                // Skip check if effective_liq_entry_max_dist is 0 (no limit)
                // SKIP FOR INDICES: NAS100 liquidity works differently, distance check not applicable
                if not is_index and effective_liq_entry_max_dist > 0.0 and not checkLiquidityDistance(z, not isDemand)
                    float liqDist = not na(z.liquidityDistance) ? z.liquidityDistance : 999.0
                    // Only reject if strictly worse (allow small tolerance)
                    canEnter := false
                    reason := "Liq distance too far (" + str.tostring(liqDist, "#.#") + " pips > " + str.tostring(effective_liq_entry_max_dist, "#.#") + ")"
        else if canEnter and not require_liquidity_sweep
            if not z.liquidityValid
                // Liquidity not strictly required, but we still report it for transparency
                reason := "OK (liquidity optional; none/invalid)"

        // LIQUIDITY SWEPT GATE (simplified): Just check if pivot was swept
        // No separate Target vs Inducement check needed with 3-candle logic

        // STRICT TOUCH CHECK - No tolerance buffer
        // For Demand: LOW must be inside zone (exact touch)
        // For Supply: HIGH must be inside zone (exact touch)
        float touchTolerance = 0.0  // Strict touch required
        bool wickIntoZone = false
        
        if canEnter
            // Check current bar for new touch
            bool currentTouch = false
            if isDemand
                // Demand: require LOW (wick down) to enter zone
                currentTouch := low <= (z.top + touchTolerance) and low >= (z.bottom - touchTolerance)
            else
                // Supply: require HIGH (wick up) to enter zone
                currentTouch := high >= (z.bottom - touchTolerance) and high <= (z.top + touchTolerance)
            
            // If current bar touches, mark zone as touched (persistent)
            if currentTouch
                z.wasTouched := true
            
            // STRICT VALIDATION: Ignore persistent history.
            // Require the touch to happen on the current trigger candle OR the setup candle (bar index - 1).
            bool prevTouch = isDemand ? (low[1] <= z.top + touchTolerance) : (high[1] >= z.bottom - touchTolerance)
            
            // Entry is valid only if we are touching NOW or just touched on the PREVIOUS bar
            wickIntoZone := currentTouch or prevTouch
            
            // STRICT CHECK: The zone MUST be touched. No exceptions.
            if not wickIntoZone
                canEnter := false
                reason := isDemand ? "No wick INTO demand zone" : "No wick INTO supply zone"

        // Zone not used yet
        bool zone_already_used = not na(z.lastEntryBar)
        if canEnter and zone_already_used
            canEnter := false
            reason := isDemand ? "Demand zone already used for a trade" : "Supply zone already used for a trade"

        // Zone not mitigated
        if canEnter and z.mitigated
            canEnter := false
            reason := isDemand ? "Demand zone mitigated before liquidity sweep" : "Supply zone mitigated before liquidity sweep"

        // 24h freshness
        bool zoneIsFresh = na(z.startTime) or (time - z.startTime) <= (24 * 60 * 60 * 1000)
        if canEnter and not zoneIsFresh
            canEnter := false
            reason := isDemand ? "Demand zone older than 24h" : "Supply zone older than 24h"

        // Minimum bar index for entries
        bool zone_created_after_min_bar = na(z.createdBarIndex) or z.createdBarIndex >= min_bar_index_for_entries
        if canEnter and not zone_created_after_min_bar
            canEnter := false
            reason := "Zone created before min bar index"

        // === AI QUALITY FILTER ===
        // Apply AI-based quality scoring to filter low-probability setups
        // This mirrors the backend Random Forest model (60% win rate threshold)
        if canEnter and enable_ai_quality_filter
            [ai_score, ai_breakdown] = calculate_ai_quality_score(z, isDemand)
            if ai_score < ai_quality_threshold
                canEnter := false
                reason := "AI Quality: " + str.tostring(ai_score, "#.0") + " < " + str.tostring(ai_quality_threshold) + " [" + ai_breakdown + "]"

    [canEnter, reason, z]

// === TRADE TRACKING VARIABLES ===
var float trade_entry_price      = na
var float trade_original_sl      = na
var float trade_original_sl_pips = na
var float trade_current_sl       = na
