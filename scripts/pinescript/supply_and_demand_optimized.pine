// === GOLD PIP SCALING FACTOR ===
// Since we changed Gold pip size from 0.1 to 0.01 (to match user perception),
// we must scale all pip-based inputs by 10x for Gold so they maintain their original "value" in USD.
// Example: Buffer 1.0 input -> was 1.0 * 0.1 = $0.10. Now 1.0 * 0.01 = $0.01 (too small).
//          Scaled Buffer -> 1.0 * 10 = 10.0. 10.0 * 0.01 = $0.10 (Correct).
// IMPORTANT: Indices (NAS100, SPX, etc.) use native tick size and do NOT need scaling.
float pip_scale_factor = is_gold and pip_size <= 0.011 ? 10.0 : 1.0

// Apply scaling to effective values
float effective_sl_buffer = stop_loss_buffer_pips * pip_scale_factor
float effective_min_tp_dist = min_tp_distance_pips * pip_scale_factor
float effective_liq_entry_max_dist = liq_entry_max_dist * pip_scale_factor
// Symbol-specific liquidity distance (no scaling needed - already specified per market)
float effective_liq_max_dist = is_index ? liq_max_distance_pips_index : (is_gold ? liq_max_distance_pips_gold : liq_max_distance_pips_forex)
float effective_tp_pips = take_profit_pips * pip_scale_factor

