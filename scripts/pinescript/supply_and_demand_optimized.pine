        risk_per_trade_pct := 0.5
        risk_reward_ratio := 3.0
        max_trades_per_day := 1
        min_tp_distance_pips := 15.0
    else if is_balanced
        pvtMax := 5
        liq_pivot_len := 5
        liq_max_distance_pips_forex := 15.0
        liq_max_distance_pips_gold := 300.0
        liq_entry_max_dist := 50.0
        ai_quality_threshold := 60
        min_entry_grade := "C+"
        min_return_strength := 30
        risk_per_trade_pct := 0.5
        risk_reward_ratio := 2.0
        max_trades_per_day := 2
        min_tp_distance_pips := 10.0
    else  // Aggressive
        pvtMax := 10
        liq_pivot_len := 3
        liq_max_distance_pips_forex := 20.0
        liq_max_distance_pips_gold := 500.0
        liq_entry_max_dist := 100.0
