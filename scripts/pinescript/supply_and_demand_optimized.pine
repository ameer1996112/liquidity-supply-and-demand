// Entry tolerance (2 ticks) for wick/close checks
// Improved tolerance (1 pip for JPY pairs)
float tol = pip_size * 1.0

// === JPY PAIRS SL/TP RULES ===
// Returns: [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]
// Rules for JPY pairs (USDJPY, EURJPY, GBPJPY, etc.):
// - SL <= 3 pips: Min RR 1:4.5. Move SL to 1:1 (min 2 pips) when 1:4 hits.
// - SL 3.1-7 pips: Min RR 1:3. Move SL to BE when 1:2 hits.
// - SL 7.1-11 pips: Close full at 1:2.5. Move SL to BE at 1:1.2.
// - SL 11.1+ pips: Close full at 1:2.
get_jpy_tp_rules(sl_pips) =>
    float tp_ratio = 2.0
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 3.0
        tp_ratio := 4.5
        be_trigger_rr := 4.0
        be_sl_pips_min := 2.0  // Move to 1:1 but min 2 pips
        move_to_be := true
    else if sl_pips <= 7.0
        tp_ratio := 3.0
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0  // Move to BE (entry)
        move_to_be := true
    else if sl_pips <= 11.0
        tp_ratio := 2.5
        be_trigger_rr := 1.2
        be_sl_pips_min := 0.0  // Move to BE (entry)
        move_to_be := true
    else
        tp_ratio := 2.0
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]

// === GENERIC FOREX TP RULES (Non-JPY pairs) ===
// Now uses the same SL-based rules as JPY pairs (unified Forex rules)
get_forex_tp_rules(sl_pips) =>
    // Use JPY rules for all Forex pairs (SL-based dynamic RR)
    get_jpy_tp_rules(sl_pips)

// Backward compatibility wrapper
get_updated_sl_tp_rules(sl_pips) =>
    get_jpy_tp_rules(sl_pips)

get_rd_forex_tp_ratio(sl_pips) =>
    [tp, _, _, _] = get_jpy_tp_rules(sl_pips)
    tp

// === DOUBLE TP MODE (OPTIONAL) ===
// When enabled: 1:2 becomes 1:4, 1:3 becomes 1:6, etc.
get_double_tp_ratio(base_ratio) =>
    base_ratio * 2.0

// === GOLD TP RULES (XAUUSD) ===
// Specific rules provided by user:
// - SL <= 50 pips: Min RR 1:4.5
// - SL 50-100 pips: Min RR 1:3, BE at 1:2.75
// - SL 100-150 pips: Close full at 1:2.5, BE at 1:2
// - SL 150-200 pips: Close full at 1:2, BE at 1:1.75
// - SL > 200 pips: Close full at 1:1.5
get_gold_tp_rules(sl_pips) =>
    float tp_ratio = 1.5
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 50.0
        tp_ratio := 4.5
        be_trigger_rr := 4.0   // Move to BE generally
        be_sl_pips_min := 5.0  // Min 5 pips profit
        move_to_be := true
    else if sl_pips <= 100.0
        tp_ratio := 3.0
        be_trigger_rr := 2.75
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else if sl_pips <= USDJPY_FALLBACK
        tp_ratio := 2.5
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else if sl_pips <= 200.0
        tp_ratio := 2.0
        be_trigger_rr := 1.75
        be_sl_pips_min := 0.0  // Move to Entry
        move_to_be := true
    else
        tp_ratio := 1.5
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]

// === INDEX TP RULES (NAS100, SPX, etc.) ===
// Fixed 1:4 ratio for all index trades regardless of SL size
get_index_tp_rules(sl_pips) =>
    float tp_ratio = 4.0           // Fixed 1:4 for all indices
    float be_trigger_rr = 2.0      // Move to BE at 1:2
    float be_sl_pips_min = 2.0     // Lock in 2 points (200 pips)
    bool move_to_be = true
    
    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]

// === 2025 TP LOOKUP DICTIONARIES ===
get_tp_ratio(symbol_type, sl_pips) =>
    // Default variables
    float base_ratio = 2.0
    float be_trig = na
    float be_sl = na
    bool move_be = false

    // CHECK: If custom RR override is enabled, use fixed ratio for everything except indices
    if use_custom_rr and not is_index
        base_ratio := risk_reward_ratio
        be_trig := na
        be_sl := na
        move_be := false
    // 1. Check for Indices first (NAS100, SPX, etc.) - Fixed 1:4
    else if is_index
        [i_tp, i_bet, i_bes, i_mbe] = get_index_tp_rules(sl_pips)
        base_ratio := i_tp
        be_trig := i_bet
        be_sl := i_bes
        move_be := i_mbe
    // 2. Check for Gold - Variable TP based on SL size
    else if is_gold
        [g_tp, g_bet, g_bes, g_mbe] = get_gold_tp_rules(sl_pips)
        base_ratio := g_tp
        be_trig := g_bet
        be_sl := g_bes
        move_be := g_mbe
    // 3. All Forex pairs (JPY and non-JPY) - Use SL-based rules
    else
        [f_tp, f_bet, f_bes, f_mbe] = get_forex_tp_rules(sl_pips)
        base_ratio := f_tp
        be_trig := f_bet
        be_sl := f_bes
        move_be := f_mbe

    // Apply double TP mode if enabled (only affects TP ratio, not BE rules)
    if enable_double_tp
        base_ratio := get_double_tp_ratio(base_ratio)

    [base_ratio, be_trig, be_sl, move_be]

// === DATA STRUCTURES (Moved to Top) ===
type Zone
    int   id
    box   boxId
    float top
    float bottom
    bool  active
    int   createdBarIndex
    bool  isHistorical
    int   startTime
    
    // Liquidity
    float liquidityPrice
    int   liquidityBarIndex
    bool  liquidityValid
    bool  liquiditySwept
    int   liquiditySweptBarIndex
    bool  causedSweep
    int   liquidityCandleCount
    float structureSweepLevel       // The level that must be swept: HIGH for demand, LOW for supply
    int   structureSweepLevelBar    // Bar index where structure level was found
    float liqHighPrice              // For demand: buy-side HIGH above zone; For supply: stored for band
    int   liqHighBar                // Bar index where liqHigh was found
    int   liqHighTime               // Time (unix ms) where liqHigh was found - for multi-TF alignment
    float liqLowPrice               // For supply: sell-side LOW below zone; For demand: stored for band
    int   liqLowBar                 // Bar index where liqLow was found
    int   liqLowTime                // Time (unix ms) where liqLow was found - for multi-TF alignment
    string liqSource                // Selection method: "PIVOT", "FALLBACK_SCAN", "LOW_FIRST_BACKWARD"
    bool  targetSwept               // True when the Target (HIGH for demand, LOW for supply) is swept AFTER inducement
    int   targetSweptBarIndex       // Bar index when target was swept (must be > liquiditySweptBarIndex)
    int   legCandleCount             // Count of directional candles in the leg (bearish for demand, bullish for supply)
    float pushHighPrice              // For demand: the PUSH HIGH price (departure peak) before retracement
    int   pushHighBar                // For demand: bar index of the push high
    string inactiveReason           // Reason zone was invalidated (e.g., "Inducement swept before target taken")
    
    // Trading
    int   lastEntryBar
    bool  mitigated
    int   mitigationTime
    bool  leftZone
    bool  leftWithBearish
    bool  primed           // True when zone is ready for entry on next valid candle
    int   primedBar        // Bar index when zone became primed
    float primedWickLevel  // Deepest wick of the priming candle (for flip SL)
    float primedRefClose   // Close of the priming candle (for BOC reference)
    float primedRefHigh    // High of the priming candle (for BOC reference)
    float primedRefLow     // Low of the priming candle (for BOC reference)
    bool  wasTouched       // True when zone has been touched by wick (persists until entry/mitigation)
    int   touchCount       // Number of times zone has been touched (for first-touch-only rule and V5 AI)
    int   lastTouchBar     // Bar index of the last touch (to track continuous engagements)
    bool  touchedPreSweep  // True if zone was touched BEFORE liquidity was swept (Permanently invalidates zone)
    float baseQuality      // V6: Quality of base construction (0-100, fewer indecisive candles = higher)
    float departureStrength // V6: Strength of price departure from zone (0-100, bigger candles + volume = higher)
    float liquidityDistance // V7.1: Distance from zone to liquidity in pips (0-100, closer = higher score)
    float liquiditySpread   // V7.1: Spread between inducement and target in pips (0-100, wider = higher)
    float returnStrength    // V7: Strength of return to zone after sweep (0-100, faster + bigger = higher)
    bool  isAccuracy      // Zone type: true = Accuracy zone, false = Normal zone
    float score           // Zone Quality Score (0-100)
    string grade          // Zone Grade (A+, A, B, C)
    
    // Visuals
    line  connectorLine
    line  targetLine      // For Supply: separate line to Target (Low)
    line  inducementHLine  // Horizontal line at inducement level
    line  targetHLine      // Horizontal line at target level
    label infoLabel
    label idLabel

// === AI FEATURE ENGINEERING ===
// Calculate indicators globally for training data collection
float feature_rsi = ta.rsi(close, 14)
float feature_ema200 = ta.ema(close, 200)
int feature_trend = close > feature_ema200 ? 1 : 0
// Added ADX Volatility Strength
[diplus, diminus, feature_adx] = ta.dmi(14, 14)
// Removed Volume (tick volume irrelevant for Forex structure) - added placeholder
int feature_hour = hour(time)

// Session ID for AI: 0=Asian, 1=London, 2=NY, 3=Off-hours
// Using UTC times: Asian=0-7, London=7-12, NY=12-21, Off=21-24
f_get_session_id() =>
    int h = hour(time, "UTC")
    if h >= 0 and h < 7
        0  // Asian
    else if h >= 7 and h < 12
        1  // London
    else if h >= 12 and h < 21
        2  // NY
    else
        3  // Off-hours

int feature_session = f_get_session_id()

// === V3 FEATURES: HTF Trend & RVOL ===
// 1. HTF Trend (1 Hour EMA 200)
// Get 60m data. If we are on > 60m chart, specific logic applies, but assuming < 60m execution:
float htf_ema200 = request.security(syminfo.tickerid, "60", ta.ema(close, 200))
float htf_close = request.security(syminfo.tickerid, "60", close)
int feature_htf_trend = htf_close > htf_ema200 ? 1 : 0

// 2. Relative Volume (RVOL)
// Volume relative to 20-period average volume
float vol_avg = ta.sma(volume, 20)
float feature_rvol = vol_avg > 0 ? volume / vol_avg : 0.0

