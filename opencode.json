{
  "$schema": "https://opencode.ai/config.json",

  "model": "google/gemini-2.5-pro",
  "small_model": "google/gemini-2.5-flash",

  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "google": {
      "options": {
        "apiKey": "{env:GOOGLE_AI_STUDIO_KEY}",
        "baseURL": "https://generativelanguage.googleapis.com/v1beta"
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },

  "instructions": ["./AGENTS.md"],
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": false,
  "permission": { "bash": "ask", "edit": "allow", "write": "allow" },
  "compaction": { "auto": true, "prune": true, "reserved": 6000 },
  "lsp": {},

  "mcp": {
    "token-saver": {
      "type": "local",
      "command": ["node", "/Users/ameeramer/token-saver/server.js"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },

  "watcher": {
    "ignore": [
      ".git/**", ".planning/**", ".antigravity/**", ".workspaces/**",
      ".opencode/**", ".gstack/**", ".claude/**", ".agents/**",
      ".ralph/**", ".bg-shell/**",
      "**/node_modules/**", "**/.next/**",
      "**/__pycache__/**", "**/.pytest_cache/**", "**/.ruff_cache/**",
      "**/.venv/**", "**/venv/**", "logs/**", "docs/**", "data/**",
      "scripts/optimization_results/**", "scripts/jira/**", "ml/**",
      "src/ai/**", "src/backtest/**", "src/agents/**",
      "frontend/**", "tests/**",
      "**/*.csv", "**/*.parquet", "**/*.log", "**/*.lock", "**/*.pkl",
      "**/migrations/**"
    ]
  }
}
