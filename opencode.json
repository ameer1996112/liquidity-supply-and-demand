{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5",
  "small_model": "opencode/minimax-m2.5-free",
  "instructions": ["./opencode-instructions.md", "./AGENTS.md"],
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": false,
  "permission": { "bash": "ask", "edit": "allow", "write": "allow" },
  "compaction": { "auto": true, "prune": true, "reserved": 6000 },
  "lsp": {},
  "watcher": {
    "ignore": [
      ".git/**", ".planning/**", ".antigravity/**", ".workspaces/**",
      ".opencode/**", "**/node_modules/**", "**/.next/**",
      "**/__pycache__/**", "**/.pytest_cache/**", "**/.ruff_cache/**",
      "**/.venv/**", "**/venv/**", "logs/**", "docs/**", "data/**",
      "scripts/optimization_results/**", "scripts/jira/**",
      "src/ai/**", "src/backtest/**", "src/agents/**",
      "frontend/**", "tests/**",
      "**/*.csv", "**/*.parquet", "**/*.log", "**/*.lock",
      "**/migrations/**"
    ]
  }
}
