{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "instructions": [
    "./opencode-instructions.md"
  ],
  "model": "google/gemini-2.0-flash",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 6000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".planning/**",
      ".antigravity/**",
      "**/node_modules/**",
      "**/.next/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/.venv/**",
      "**/venv/**",
      "logs/**",
      "docs/**",
      "docs/archive/**",
      "data/**",
      "data/raw/**",
      "data/historical/**",
      "data/backtest/**",
      "data/backtest_candles/**",
      "**/*.csv",
      "**/*.parquet",
      "**/*.log",
      "**/*.lock",
      "**/migrations/**",
      "scripts/pinescript/**",
      "tests/**"
    ]
  },
  "snapshot": false
}