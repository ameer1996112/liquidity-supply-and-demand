// ══════════════════════════════════════════════════════════
// OPTIMIZATION PATCH: Symbol-Specific Auto-Configuration
// ══════════════════════════════════════════════════════════
// Add this code to your SND_Strategy.pine after line 447
// (after the existing profile configurations)

// Auto-detect and apply optimal settings based on symbol type
if use_profile_defaults and is_aggressive
    // For indices and metals: Keep aggressive settings (proven to work)
    if is_gold or is_index
        // These are already set by Aggressive profile - no changes needed
        // pvtMax = 10, liq_max_distance_pips_gold = 500, etc.

    // For forex pairs: Apply "Forex-Optimized Aggressive" (hybrid approach)
    else
        // Tighten liquidity filters for forex
        liq_max_distance_pips_forex := 12.0  // ← Reduced from 20 (Balanced is 15, so split the difference)
        liq_entry_max_dist := 60.0           // ← Reduced from 100 (Balanced is 50)

        // Add quality filters (critical for forex!)
        min_return_strength := 25            // ← CRITICAL: Was 0! Now requires decent return speed
        min_entry_grade := "C+"              // ← Improved from "C"
        ai_quality_threshold := 55           // ← Improved from 50 (Balanced is 60)

        // Keep aggressive trade frequency (2 trades/day is fine)
        // Keep aggressive RR (1.5 is acceptable for forex if setup is good)
        // Keep aggressive pivot scanning (pvtMax = 10 for more opportunities)

        // Optional: Slightly tighter TP for forex volatility
        min_tp_distance_pips := 8.0          // ← Up from 5 (prevents spread eating profits)

// Display current optimization mode in table
var table optimizationTable = table.new(position.bottom_right, 2, 1,
     bgcolor = color.new(#1e1e1e, 10),
     frame_width = 1,
     frame_color = color.new(color.gray, 50))

if barstate.islast and use_profile_defaults and is_aggressive
    symbol_mode = is_gold or is_index ? "🔥 Full Aggressive (Indices/Metals)" : "⚡ Hybrid Aggressive (Forex-Optimized)"
    table.cell(optimizationTable, 0, 0, "Optimization Mode",
         text_color = color.rgb(200, 200, 200), text_halign = text.align_right)
    table.cell(optimizationTable, 1, 0, symbol_mode,
         text_color = is_gold or is_index ? color.lime : color.orange,
         text_halign = text.align_left)
