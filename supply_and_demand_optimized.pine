get_pip(x) =>
    x / pip_size

// ========================================
// === OPTIMIZED VALUE CACHING ===
// ========================================
// Cache bar values once per confirmed bar

var float cached_close = na
var float cached_open = na
var float cached_high = na
var float cached_low = na
var int cached_bar_index = na
var bool cached_is_confirmed = false

if barstate.isconfirmed
    cached_close := close
    cached_open := open
    cached_high := high
    cached_low := low
    cached_bar_index := bar_index
    cached_is_confirmed := true
else
    cached_is_confirmed := false

// ========================================
// === HELPER FUNCTIONS ===
// ========================================

is_strong_body(idx) =>
    body = math.abs(close[idx] - open[idx])
    total_range = high[idx] - low[idx]
    perc = total_range > 0 ? body / total_range * 100 : 0
    perc >= min_body_perc

is_strong_bull(idx) =>
    close[idx] > open[idx] and (math.abs(close[idx] - open[idx]) / (high[idx] - low[idx]) > 0.5)

is_strong_bear(idx) =>
    close[idx] < open[idx] and (math.abs(close[idx] - open[idx]) / (high[idx] - low[idx]) > 0.5)

is_bullish(idx) => close[idx] > open[idx]
is_bearish(idx) => close[idx] < open[idx]

// ========================================
// === OPTIMIZED OPPOSITE CANDLE COUNTER ===
// ========================================
// Reduced loop iterations and simplified logic

countOppositeCandlesInBand(bool isDemand, int fromBar, int toBar, float top, float bottom) =>
    int oppCount = 0
    if na(fromBar) or na(toBar) or na(top) or na(bottom) or fromBar > toBar
        oppCount
    else
        // Asset-specific tolerance
        float overlapTolerance = is_gold ? (pip_size * OVERLAP_TOLERANCE_GOLD) : (syminfo.mintick * OVERLAP_TOLERANCE_DEFAULT)
        scanEndBar = math.min(toBar, bar_index)

        // Limit scan range for performance
        scanRange = scanEndBar - fromBar
        if scanRange > MAX_BACKWARD_SCAN
            fromBar := scanEndBar - MAX_BACKWARD_SCAN

        if scanEndBar >= fromBar
            for scanOff = 0 to (scanEndBar - fromBar)
                scanBar = fromBar + scanOff
                if scanBar > bar_index
                    break

                barOffset = bar_index - scanBar
                if barOffset < 0
                    continue

                // Check overlap
                float c_high_band = high[barOffset]
                float c_low_band  = low[barOffset]
                bool overlapsBand = c_high_band >= (bottom - overlapTolerance) and c_low_band <= (top + overlapTolerance)

                if not overlapsBand
                    continue

                // Structure detection
                bool isStructure = false
                float c_open  = open[barOffset]
                float c_close = close[barOffset]
                float c_high  = high[barOffset]
                float c_low   = low[barOffset]
                float body_size = math.abs(c_close - c_open)
                float total_range = c_high - c_low

                if total_range > syminfo.mintick
                    bool isRed   = c_close < c_open
                    bool isGreen = c_close > c_open

                    if structure_mode == "Relaxed (Wicks)"
                        bool isDoji = body_size <= (total_range * DOJI_THRESHOLD)
                        if isDemand
                            float upper_wick = c_high - math.max(c_open, c_close)
                            bool meaningfulUpperWick = total_range > 0 ? (upper_wick / total_range) >= WICK_THRESHOLD_RELAXED : false
                            isStructure := isRed or isDoji or meaningfulUpperWick
                        else
                            float lower_wick = math.min(c_open, c_close) - c_low
                            bool meaningfulLowerWick = total_range > 0 ? (lower_wick / total_range) >= WICK_THRESHOLD_RELAXED : false
                            isStructure := isGreen or isDoji or meaningfulLowerWick
                    else if structure_mode == "Standard (Bodies)"
                        if isDemand
                            isStructure := isRed and (body_size > total_range * BODY_THRESHOLD_STANDARD)
                        else
                            isStructure := isGreen and (body_size > total_range * BODY_THRESHOLD_STANDARD)

                // Check meaningful overlap
                float overlapTop    = math.min(c_high_band, top)
                float overlapBottom = math.max(c_low_band, bottom)
                float overlapRange  = math.max(0.0, overlapTop - overlapBottom)
                bool overlapsMeaningfully = overlapsBand and overlapRange > 0

                if overlapsMeaningfully and isStructure
                    oppCount += 1
        oppCount

// ========================================
// === PERFORMANCE TRACKING ===
// ========================================

// Entry evaluation stats
var int stat_total_entry_checks            = 0
var int stat_entries_blocked_by_timing     = 0
var int stat_entries_blocked_by_liquidity  = 0

// Win rate by zone type
var int stat_trades_accuracy_total  = 0
var int stat_trades_accuracy_wins   = 0
var int stat_trades_accuracy_losses = 0

var int stat_trades_normal_total  = 0
var int stat_trades_normal_wins   = 0
var int stat_trades_normal_losses = 0

// RR by symbol
var float stat_rr_sum_xau   = 0.0
var int   stat_rr_count_xau = 0

var float stat_rr_sum_jpy   = 0.0
var int   stat_rr_count_jpy = 0

var float stat_rr_sum_other   = 0.0
var int   stat_rr_count_other = 0

// Helper functions
safe_percent(wins, total) =>
    total > 0 ? (wins * 100.0) / total : 0.0

get_symbol_bucket() =>
    sym = syminfo.ticker
    if str.contains(sym, "XAU")
        "XAU"
    else if str.contains(sym, "JPY")
        "JPY"
    else
        "OTHER"

// ========================================
// === TRADE TRACKING ===
// ========================================

var float trade_entry_price      = na
var float trade_original_sl      = na
var float trade_original_sl_pips = na
var float trade_current_sl       = na
var bool  labels_created         = false
var float trade_tp1_price        = na
var bool  tp1_hit                = false
var string active_entry_id       = na
var float trade_be_trigger_rr      = na
var float trade_be_sl_pips         = na
var bool  trade_be_moved           = false
var bool  trade_is_accuracy_zone = false

// Position sizing tracking
var int   last_pos_size_units    = na
var float last_pos_size_lots     = na
var float last_pos_size_entry    = na
var float last_pos_size_sl       = na
var float last_pos_size_balance  = na
var float last_pos_size_risk_pct = na
var float last_pos_size_sl_pips  = na
var float last_pos_size_usdjpy_rate = na
var bool  last_pos_size_valid    = false
var string last_pos_size_error   = ""
var bool  last_pos_size_dry_run  = false

// Pending entries
var bool  long_signal_pending    = false
var float long_pending_sl_price  = na
var float long_pending_tp_price  = na
var float long_pending_sl_pips   = na
var string long_pending_entry_type = na

var bool  short_signal_pending   = false
var float short_pending_sl_price = na
var float short_pending_tp_price = na
var float short_pending_sl_pips  = na

// Entry guards
var int last_global_long_entry_bar = na
var int last_global_short_entry_bar = na

// Zone inspector sync
var bool entryTriggeredThisBar = false
var int triggeredZoneId = na
var bool targetSweptThisBar = false

if barstate.isconfirmed[1] or barstate.isfirst
    entryTriggeredThisBar := false
    triggeredZoneId := na
    targetSweptThisBar := false

// Trade per day tracking
var int current_day_trades = 0
var int last_trade_day = na

is_late_friday() =>
    day_of_week = dayofweek(time, "Etc/GMT+5")
    current_hour = hour(time, "Etc/GMT+5")
    day_of_week == dayofweek.friday and current_hour >= 20

// Reset trade count if new day
current_day_start = time("D", "Etc/GMT+5")
if na(last_trade_day) or current_day_start != last_trade_day
    current_day_trades := 0
    last_trade_day := current_day_start

trades_allowed_today() =>
    current_day_trades < max_trades_per_day

// ========================================
// === PERFORMANCE TABLE ===
// ========================================

var table performanceTable = na

draw_performance_table(tbl) =>
    table result = tbl

    if show_performance_table and barstate.islastconfirmedhistory
        if na(result)
            result := table.new(position.top_right, 2, 6,
                 bgcolor = color.new(color.rgb(30, 35, 40), 5),
                 border_width = 1, border_color = color.new(color.white, 70),
                 frame_width = 1, frame_color = color.new(color.white, 70))

        if not na(result)
            // Strategy metrics
            float net_profit = strategy.netprofit
            int total_closed = strategy.closedtrades
            int total_open = strategy.opentrades
            int total_trades = total_closed + total_open
            float gross_profit = strategy.grossprofit
            float gross_loss = math.abs(strategy.grossloss)
            float max_dd = strategy.max_drawdown
            int win_trades = strategy.wintrades

            float win_rate = total_closed > 0 ? (float(win_trades) / float(total_closed)) * 100 : 0.0
            float profit_factor = gross_loss > 0 ? gross_profit / gross_loss : (gross_profit > 0 ? 999.99 : 0.0)

            color profit_color = net_profit >= 0 ? color.rgb(0, 200, 100) : color.rgb(255, 80, 80)

            // Header
            table.cell(result, 0, 0, "📊 RESULTS", text_color = color.white, bgcolor = color.rgb(40, 40, 40), text_size = size.small, text_halign = text.align_left)
            table.cell(result, 1, 0, "", bgcolor = color.rgb(40, 40, 40))

            // Net Profit
            table.cell(result, 0, 1, "Net Profit", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            string profit_str = (net_profit >= 0 ? "$" : "-$") + str.tostring(math.abs(net_profit), "#,##0.00")
            table.cell(result, 1, 1, profit_str, text_color = profit_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)

            // Total Trades
            table.cell(result, 0, 2, "Total Trades", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            table.cell(result, 1, 2, str.tostring(total_trades), text_color = color.rgb(200, 200, 200), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)

            // Win Rate
            table.cell(result, 0, 3, "Win Rate", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            string wr_str = str.tostring(win_rate, "#.00") + "% (" + str.tostring(win_trades) + "/" + str.tostring(total_closed) + ")"
            color wr_color = win_rate >= 50 ? color.rgb(0, 200, 100) : color.rgb(255, 180, 80)
            table.cell(result, 1, 3, wr_str, text_color = wr_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)

            // Profit Factor
            table.cell(result, 0, 4, "Profit Factor", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            string pf_str = gross_loss > 0 ? str.tostring(profit_factor, "#.00") : (gross_profit > 0 ? "∞" : "N/A")
            color pf_color = profit_factor >= 1.5 ? color.rgb(0, 200, 100) : (profit_factor >= 1.0 ? color.rgb(255, 180, 80) : color.rgb(255, 80, 80))
            table.cell(result, 1, 4, pf_str, text_color = pf_color, bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)

            // Max Drawdown
            table.cell(result, 0, 5, "Max Drawdown", text_color = color.rgb(180, 180, 180), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_right, text_size = size.small)
            string dd_str = "-$" + str.tostring(math.abs(max_dd), "#,##0.00")
            table.cell(result, 1, 5, dd_str, text_color = color.rgb(255, 100, 100), bgcolor = color.rgb(25, 25, 25), text_halign = text.align_left, text_size = size.small)

    result

// Draw performance table
performanceTable := draw_performance_table(performanceTable)

