strategy("Liquidity S&D Strategy [OPTIMIZED]",
     overlay = true,
     max_bars_back = 5000,
     initial_capital = 10000000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 100,
     pyramiding = 0,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     margin_long = 1,
     margin_short = 1)

// ========================================
// === CONFIGURATION CONSTANTS ===
// ========================================
// Centralized constants to avoid magic numbers throughout code

// Performance limits
const int MAX_BACKWARD_SCAN = 200
const int MAX_LOOP_ITERATIONS = 200
const int PIVOT_CACHE_SIZE = 100
const int DB_MAX_SIZE = 500

// Liquidity detection thresholds
const float OVERLAP_TOLERANCE_GOLD = 0.5
const float OVERLAP_TOLERANCE_DEFAULT = 0.0
const float DOJI_THRESHOLD = 0.05
const float WICK_THRESHOLD_RELAXED = 0.30
const float BODY_THRESHOLD_STANDARD = 0.10
const float BODY_THRESHOLD_STRICT = 0.30
const float MIN_DISTANCE_PIPS = 2.0
const float SWEEP_TOLERANCE_PIPS = 0.5
const float SWEEP_TOLERANCE_TICKS = 0.1

// Time constants
const int HOURS_24_MS = 86400000
const int MINUTES_IN_HOUR = 60
const int SECONDS_IN_MINUTE = 60

// Contract sizes
const float FOREX_LOT_SIZE = 100000.0
const float GOLD_LOT_SIZE = 100.0
const float SILVER_LOT_SIZE = 5000.0
const float CRYPTO_LOT_SIZE = 1.0

// Default fallback values
const float USDJPY_FALLBACK = 150.0
const float MIN_POSITION_SIZE_UNITS_DEFAULT = 1000.0

// ========================================
// === USER INPUTS ===
// ========================================

// Pip Size Detection
use_auto_pip_size    = input.bool(true, "Auto Detect Pip Size", tooltip = "Automatically detect pip size based on symbol.")
manual_pip_size      = input.float(0.0001, "Manual Pip Size", step = 0.0001, tooltip = "Only used if Auto Detect is disabled.")

// Auto-detect pip size (cached)
get_auto_pip_size() =>
    ticker = syminfo.ticker
    if str.contains(ticker, "JPY")
        0.01
    else if str.contains(ticker, "XAU") or str.contains(ticker, "GOLD")
        0.1
    else if str.contains(ticker, "XAG") or str.contains(ticker, "SILVER")
        0.01
    else if str.contains(ticker, "BTC") or str.contains(ticker, "ETH")
        1.0
    else if syminfo.mintick >= 0.01
        0.01
    else
        0.0001

pip_size = use_auto_pip_size ? get_auto_pip_size() : manual_pip_size

