// ========================================
// === SL/TP RULES ===
// ========================================

get_updated_sl_tp_rules(sl_pips) =>
    float tp_ratio = 2.0
    float be_trigger_rr = na
    float be_sl_pips_min = na
    bool move_to_be = false

    if sl_pips <= 3.0
        tp_ratio := 4.5
        be_trigger_rr := 4.0
        be_sl_pips_min := 2.0
        move_to_be := true
    else if sl_pips <= 7.0
        tp_ratio := 3.0
        be_trigger_rr := 2.0
        be_sl_pips_min := 0.0
        move_to_be := true
    else if sl_pips <= 11.0
        tp_ratio := 2.5
        be_trigger_rr := 1.2
        be_sl_pips_min := 0.0
        move_to_be := true
    else
        tp_ratio := 2.0
        be_trigger_rr := na
        be_sl_pips_min := na
        move_to_be := false

    [tp_ratio, be_trigger_rr, be_sl_pips_min, move_to_be]

get_rd_forex_tp_ratio(sl_pips) =>
    [tp, _, _, _] = get_updated_sl_tp_rules(sl_pips)
    tp

get_double_tp_ratio(base_ratio) =>
    base_ratio * 2.0

get_tp_ratio(symbol_type, sl_pips) =>
    base_ratio = get_rd_forex_tp_ratio(sl_pips)
    if enable_double_tp
        get_double_tp_ratio(base_ratio)
    else
        base_ratio

