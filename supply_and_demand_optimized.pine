// ========================================
// === OPTIMIZED POSITION SIZING ===
// ========================================
// Unified position sizing with built-in validation

calc_position_safe(entry, sl, balance, risk_pct, is_short) =>
    // Early validation
    if na(entry) or entry <= 0 or na(sl) or sl <= 0
        [0, "Invalid entry or SL"]
    else
        // Calculate risk amount
        risk_usd = balance * (risk_pct / 100)

        // Calculate distance with minimum enforcement
        distance = math.abs(entry - sl)
        min_distance = MIN_DISTANCE_PIPS * pip_size
        distance := math.max(distance, min_distance)

        // Auto-correct SL to ensure proper direction
        minGap = math.max(syminfo.mintick * 2, pip_size * MIN_DISTANCE_PIPS)
        sl_corrected = is_short ?
                       math.max(sl, entry + minGap) :
                       math.min(sl, entry - minGap)

        distance := math.abs(entry - sl_corrected)

        // Calculate units based on symbol type
        units = 0.0

        if is_gold or is_silver or is_crypto or (str.contains(syminfo.ticker, "USD") and not str.startswith(syminfo.ticker, "USD"))
            // USD quote pairs: simple calculation
            units := risk_usd / distance
        else if is_jpy_pair
            // JPY pairs: use cached rate
            usdjpy_rate = get_cached_usdjpy_rate()
            units := (risk_usd * usdjpy_rate) / distance
        else
            // Other cross pairs
            units := risk_usd / distance

        // Round and validate
        units := math.round(units)

        // Determine contract size for min/max validation
        contract_size = FOREX_LOT_SIZE
        min_units = min_position_size_units

        if is_gold
            contract_size := GOLD_LOT_SIZE
            min_units := 1.0
        else if is_silver
            contract_size := SILVER_LOT_SIZE
            min_units := 1.0
        else if is_crypto
            contract_size := CRYPTO_LOT_SIZE
            min_units := 1.0

        // Apply min/max limits
        if units < min_units
            [0, "Below minimum (" + str.tostring(min_units) + " units)"]
        else if (units / contract_size) > max_position_size_lots
            [0, "Exceeds maximum (" + str.tostring(max_position_size_lots) + " lots)"]
        else if na(units) or units <= 0
            [0, "Invalid calculation"]
        else
            [int(units), ""]

