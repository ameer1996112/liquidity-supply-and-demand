// =============================================================================
// PINE SCRIPT WEBHOOK PAYLOAD CONFIGURATION
// =============================================================================
// Add this code to your existing Pine Script strategy to send webhook alerts
// to the Python Discord-MT5 bridge.
//
// SETUP INSTRUCTIONS:
// 1. Add this code to your Pine Script strategy
// 2. In TradingView, go to the strategy settings
// 3. Set the Webhook URL to: http://YOUR_SERVER_IP:5000/webhook
// 4. The alert message will be automatically populated from strategy.entry()
//
// NOTE: Replace YOUR_SERVER_IP with your actual server IP or domain
// For testing locally, use: http://localhost:5000/webhook
// For production, use ngrok or a cloud server with public IP
// =============================================================================

//@version=6

// =============================================================================
// WEBHOOK PAYLOAD BUILDER FUNCTION
// =============================================================================
// Creates a JSON payload string for the webhook
//
// Parameters:
//   _symbol: Trading symbol (e.g., "GBPJPY")
//   _side: Trade direction ("buy" or "sell")
//   _entry: Entry price
//   _sl: Stop loss price
//   _tp: Take profit price
//   _size: Position size in LOTS (not units!)
//
// Returns: JSON string ready for webhook alert_message

build_webhook_payload(_symbol, _side, _entry, _sl, _tp, _size) =>
    // Build JSON payload - ensure all values are strings
    '{"symbol":"' + _symbol +
    '","side":"' + _side +
    '","entry":' + str.tostring(_entry, format.mintick) +
    '","sl":' + str.tostring(_sl, format.mintick) +
    '","tp":' + str.tostring(_tp, format.mintick) +
    '","size":' + str.tostring(_size, "#.##") + '}'


// =============================================================================
// INTEGRATION WITH YOUR EXISTING STRATEGY
// =============================================================================
// Here's how to integrate the webhook with your strategy.entry() calls.
//
// IMPORTANT: You need to calculate position size in LOTS, not units!
//
// For Forex: 1 lot = 100,000 units
// For Gold (XAUUSD): 1 lot = 100 oz
// For Indices: Varies by broker
//
// =============================================================================

// Example: Convert units to lots for position sizing
// Assuming your existing code calculates pos_qty_units (position size in units)

// For standard forex pairs:
// pos_qty_lots = pos_qty_units / 100000.0

// For XAUUSD (Gold):
// pos_qty_lots = pos_qty_units / 100.0

// Universal conversion function
units_to_lots(_units) =>
    float lot_size = 100000.0  // Default forex
    ticker = syminfo.ticker

    if str.contains(ticker, "XAU") or str.contains(ticker, "GOLD")
        lot_size := 100.0
    else if str.contains(ticker, "XAG") or str.contains(ticker, "SILVER")
        lot_size := 5000.0
    else if str.contains(ticker, "BTC") or str.contains(ticker, "ETH")
        lot_size := 1.0

    _units / lot_size


