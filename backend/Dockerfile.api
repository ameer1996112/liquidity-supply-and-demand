# API (Signal Receiver) - Zero-Drop: validate -> Redis -> 200
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn[standard] redis pydantic-settings python-dotenv

COPY config.py main.py ./

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
