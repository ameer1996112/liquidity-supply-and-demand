# =============================================================================
# Trading Alert Server Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# MICROSERVICES (main.py API + worker.py)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key (required for scripts/reset_system.py, test_full_system.py to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
REDIS_URL=redis://localhost:6379/0
# API base URL for E2E tests (e.g. https://your-api.up.railway.app or http://localhost:3000)
WEBHOOK_URL=http://localhost:3000
WEBHOOK_SECRET=optional-secret-for-POST-webhook

# -----------------------------------------------------------------------------
# NOTIFICATIONS (at least one required)
# -----------------------------------------------------------------------------

# Discord Webhook URL
# Get it from: Channel Settings -> Integrations -> Webhooks -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Telegram (optional) - for mobile notifications
# 1. Create bot: Message @BotFather on Telegram, send /newbot
# 2. Get chat ID: Message @userinfobot or @get_id_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Port to run on (default: 3000)
WEBHOOK_PORT=3000

# -----------------------------------------------------------------------------
# POSITION SIZING
# -----------------------------------------------------------------------------

# Your account balance for position size calculation
ACCOUNT_BALANCE=10000

# Risk percentage per trade (e.g., 1.0 = 1%)
RISK_PERCENT=1.0

# -----------------------------------------------------------------------------
# ALERT FILTERING (optional)
# -----------------------------------------------------------------------------

# Minimum Risk:Reward ratio to forward alerts (default: 1.0)
MIN_RR_RATIO=1.0

# Trading session hours in UTC (leave empty to disable)
# Format: "HH:MM-HH:MM" e.g., "08:00-17:00"
TRADING_SESSIONS=
