//@version=6
strategy("Liquidity S&D Multi-TF Strategy (5m/30m) + Williams Fractals",
     overlay = true,
     max_bars_back = 5000,
     initial_capital = 10000000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 100,
     pyramiding = 0,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     margin_long = 1,
     margin_short = 1)

// === USER INPUTS ===
tf_mode              = input.string("5", "Strategy Timeframe", options = ["5", "30"], tooltip = "Choose '5' for 5min rules, '30' for 30min rules (must match chart timeframe)")
use_auto_pip_size    = input.bool(true, "Auto Detect Pip Size", tooltip = "Automatically detect pip size based on symbol. Disable to use manual pip size.")
manual_pip_size      = input.float(0.0001, "Manual Pip Size", step = 0.0001, tooltip = "Only used if Auto Detect is disabled. 0.0001 for most pairs, 0.01 for JPY pairs, 0.1 for XAUUSD")

// Auto-detect pip size based on symbol
get_auto_pip_size() =>
    ticker = syminfo.ticker
    if str.contains(ticker, "JPY")
        0.01  // JPY pairs (USDJPY, GBPJPY, EURJPY, etc.)
    else if str.contains(ticker, "XAU") or str.contains(ticker, "GOLD")
        0.1   // Gold
    else if str.contains(ticker, "XAG") or str.contains(ticker, "SILVER")
        0.01  // Silver
    else if str.contains(ticker, "BTC") or str.contains(ticker, "ETH")
        1.0   // Crypto
    else if syminfo.mintick >= 0.01
        0.01  // 2 decimal places (like JPY)
    else
        0.0001  // Standard forex pairs (4-5 decimal places)

pip_size = use_auto_pip_size ? get_auto_pip_size() : manual_pip_size

// Zone Display Options
show_zones           = input.bool(true, "Show Zones", tooltip = "Enable/disable zone display")
zone_display_mode    = input.string("Both", "Zone Display Mode", options = ["Both", "Demand Only", "Supply Only"], tooltip = "Choose which zones to display")
show_demand_zones    = zone_display_mode == "Both" or zone_display_mode == "Demand Only"
show_supply_zones    = zone_display_mode == "Both" or zone_display_mode == "Supply Only"

show_entries         = input.bool(true, "Show Entries/Exits on Chart")
show_entry_labels    = input.bool(true, "Show Entry Labels", group = "Display Options", tooltip = "Show entry/exit labels on chart. Disabled when Zone Inspector is active.")
max_zones            = input.int(20, "Max Zones on Chart", minval = 1, maxval = 50)
extend_bars          = input.int(50, "Zone Extend Bars Right", minval = 5, maxval = 200)
min_body_perc        = input.float(50, "Min Body % of Candle (Strong Move)", minval = 10, maxval = 100)

// === AGGREGATION-BASED ZONE DETECTION (Additional Method) ===
enable_aggregation_zones   = input.bool(true, "Enable Aggregation-Based Zones", group = "Aggregation Zones", tooltip = "Enable additional zone detection using aggregation method")
aggregation_factor         = input.int(4, minval = 1, title = "Aggregation Factor (e.g., 4x current TF)", group = "Aggregation Zones")
agg_zone_length            = input.int(50, maxval = 500, title = "Aggregation Zone Length (bars)", group = "Aggregation Zones")
show_supply_zones_agg_input = input.bool(true, title = "Show Aggregation Supply Zones", group = "Aggregation Zones")
show_demand_zones_agg_input = input.bool(true, title = "Show Aggregation Demand Zones", group = "Aggregation Zones")
