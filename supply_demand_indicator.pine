// Consolidated function to remove demand zone from all arrays (reduces code duplication)
remove_demand_zone_all_arrays(idx) =>
    if idx >= 0
        if idx < array.size(demandBoxes)
            box.delete(array.get(demandBoxes, idx))
        if idx < array.size(demandZoneLabels)
            label lbl = array.get(demandZoneLabels, idx)
            if not na(lbl)
                label.delete(lbl)
            array.remove(demandZoneLabels, idx)
        if idx < array.size(demandLiqConnectorLines)
            line ln = array.get(demandLiqConnectorLines, idx)
            if not na(ln)
                line.delete(ln)
            array.remove(demandLiqConnectorLines, idx)
        if idx < array.size(demandLiqInfoLabels)
            label liq_lbl = array.get(demandLiqInfoLabels, idx)
            if not na(liq_lbl)
                label.delete(liq_lbl)
            array.remove(demandLiqInfoLabels, idx)
        if idx < array.size(demandHighs)
            array.remove(demandHighs, idx)
        if idx < array.size(demandLows)
            array.remove(demandLows, idx)
        if idx < array.size(demandActive)
            array.remove(demandActive, idx)
        if idx < array.size(demandBoxes)
            array.remove(demandBoxes, idx)
        if idx < array.size(demandLeftZone)
            array.remove(demandLeftZone, idx)
        if idx < array.size(demandLeftWithBearish)
            array.remove(demandLeftWithBearish, idx)
        if idx < array.size(demandZoneAccuracy)
            array.remove(demandZoneAccuracy, idx)
        if idx < array.size(demandZoneLiquidity)
            array.remove(demandZoneLiquidity, idx)
        if idx < array.size(demandZoneLiquiditySwept)
            array.remove(demandZoneLiquiditySwept, idx)
        if idx < array.size(demandZoneLiquidityBarIndex)
            array.remove(demandZoneLiquidityBarIndex, idx)
        if idx < array.size(demandZoneLiquiditySweptBarIndex)
            array.remove(demandZoneLiquiditySweptBarIndex, idx)
        if idx < array.size(demandZoneCreatedBarIndex)
            array.remove(demandZoneCreatedBarIndex, idx)
        if idx < array.size(demandZoneLastEntryBar)
            array.remove(demandZoneLastEntryBar, idx)
        if idx < array.size(demandZoneIsHistorical)
            array.remove(demandZoneIsHistorical, idx)
        if idx < array.size(demandZoneLiquidityValid)
            array.remove(demandZoneLiquidityValid, idx)
        if idx < array.size(demandZoneLiquidityCandleCount)
