                label.set_text(oldLb, txt)
                label.set_style(oldLb, label.style_label_left)
                label.set_textcolor(oldLb, color.white)
                label.set_color(oldLb, lbColor)
                label.set_size(oldLb, size.tiny)
                array.set(supplyLiqInfoLabels, idx, oldLb)
            else
                // Create new label at liquidity level (supply)
                label lbNew = label.new(x = liqBar, y = liq, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, textcolor = color.white, color = lbColor, size = size.tiny)
                if idx < array.size(supplyLiqInfoLabels)
                    array.set(supplyLiqInfoLabels, idx, lbNew)

// === LIQUIDITY VALIDATION: SINGLE SOURCE OF TRUTH ===
// This helper is the ONLY place that decides whether a detected liquidity level
// is structurally valid for entries, for both demand and supply zones.
// It enforces:
//  1) Geometric relationship (liq above demand zone / below supply zone)
//  2) Opposite-candle count in the band using `countOppositeCandlesInBand` data
//  3) 1‑candle vs 2‑candle rule (useOneCandleLiquidity)
//  4) Zone impulse must have caused a liquidity sweep at creation (zoneCausedSweep)
isLiquidityValidForEntry(isDemand, idx) =>
    if idx < 0
        false
    else
        float zHigh = na
        float zLow  = na
        int   zCreatedBar = na
        float liqLevel = na
        int   liqBar   = na
        int   oppCount = 0
        bool  zoneCausedSweep = false

        if isDemand
            if idx >= array.size(demandHighs) or idx >= array.size(demandLows)
                false
            else
                zHigh := array.get(demandHighs, idx)
                zLow  := array.get(demandLows, idx)
                if idx < array.size(demandZoneCreatedBarIndex)
                    zCreatedBar := array.get(demandZoneCreatedBarIndex, idx)
                if idx < array.size(demandZoneLiquidity)
                    liqLevel := array.get(demandZoneLiquidity, idx)
                if idx < array.size(demandZoneLiquidityBarIndex)
                    liqBar := array.get(demandZoneLiquidityBarIndex, idx)
                if idx < array.size(demandLiqCandles)
                    oppCount := array.get(demandLiqCandles, idx)
                if idx < array.size(demandZoneCausedSweep)
                    zoneCausedSweep := array.get(demandZoneCausedSweep, idx)
        else
            if idx >= array.size(supplyHighs) or idx >= array.size(supplyLows)
                false
            else
                zHigh := array.get(supplyHighs, idx)
                zLow  := array.get(supplyLows, idx)
                if idx < array.size(supplyZoneCreatedBarIndex)
                    zCreatedBar := array.get(supplyZoneCreatedBarIndex, idx)
                if idx < array.size(supplyZoneLiquidity)
                    liqLevel := array.get(supplyZoneLiquidity, idx)
                if idx < array.size(supplyZoneLiquidityBarIndex)
                    liqBar := array.get(supplyZoneLiquidityBarIndex, idx)
                if idx < array.size(supplyLiqCandles)
                    oppCount := array.get(supplyLiqCandles, idx)
                if idx < array.size(supplyZoneCausedSweep)
                    zoneCausedSweep := array.get(supplyZoneCausedSweep, idx)

        // 1) Geometric check: liquidity must be on the correct side of zone and strictly outside
        bool geomOk = false
        if isDemand
            // For demand, inducement low MUST be strictly above zoneHigh
            geomOk := not na(liqLevel) and liqLevel > zHigh
        else
            // For supply, inducement high MUST be strictly below zoneLow
            geomOk := not na(liqLevel) and liqLevel < zLow

        if not geomOk
            false
        else
            // 2) Liquidity must form after zone creation
            bool timingOk = not na(zCreatedBar) and not na(liqBar) and liqBar > zCreatedBar
            if not timingOk
                false
            else
                // 3) Opposite candle count rule (shared for demand & supply)
                int minCandles = useOneCandleLiquidity ? 1 : 2
                bool candlesOk = oppCount >= minCandles
                if not candlesOk
                    false
                else
                    // 4) Zone impulse must have caused a sweep at creation
                    zoneCausedSweep

// === UNIFIED ENTRY VALIDATION HELPERS (DEMAND & SUPPLY) ===
// These helpers centralise all shared entry checks for both regular and flip entries.
// They *do not* check flip‑specific conditions (strong flip, wick‑size %, 30m boundary, etc.)
// so those remain in the flip sections and are AND‑ed with the result of these functions.
//
// Each returns:
//   [canEnter: bool, reason: string]
// Where `reason` contains the first failing condition for debugging.

isValidDemandEntry(idx) =>
    bool canEnter = true
    string reason = ""

    // Basic index / array safety
    if idx < 0 or idx >= array.size(demandHighs) or idx >= array.size(demandLows)
        canEnter := false
        reason := "Invalid demand zone index"
    else
        // Zone must be active
        bool isActive = idx < array.size(demandActive) ? array.get(demandActive, idx) : false
        if not isActive
            canEnter := false
            reason := "Demand zone inactive"

    float zoneHigh = na
    float zoneLow  = na
    if canEnter
        zoneHigh := array.get(demandHighs, idx)
        zoneLow  := array.get(demandLows, idx)

    // Zone must have caused sweep & not be historical
    bool zoneCausedSweep = idx < array.size(demandZoneCausedSweep) ? array.get(demandZoneCausedSweep, idx) : false
    bool isHistoricalZone = idx < array.size(demandZoneIsHistorical) ? array.get(demandZoneIsHistorical, idx) : false
    if canEnter and (not zoneCausedSweep)
        canEnter := false
        reason := "Demand zone did not cause liquidity sweep"
    if canEnter and isHistoricalZone
        canEnter := false
        reason := "Demand zone created in historical backfill"

    // Liquidity existence (candle‑count rule) & sweep timing
    bool liqValid = idx < array.size(demandZoneLiquidityValid) ? array.get(demandZoneLiquidityValid, idx) : false
    bool liqSwept = idx < array.size(demandZoneLiquiditySwept) ? array.get(demandZoneLiquiditySwept, idx) : false
    int  liqSweptBarIndex = idx < array.size(demandZoneLiquiditySweptBarIndex) ? array.get(demandZoneLiquiditySweptBarIndex, idx) : na

    if canEnter and require_liquidity_sweep
        if not liqValid
            canEnter := false
            reason := "Demand liquidity invalid (candle‑count rule failed)"
        else if not liqSwept
            canEnter := false
            reason := "Demand liquidity not yet swept"
        else if na(liqSweptBarIndex) or bar_index < liqSweptBarIndex
            canEnter := false
            reason := "Demand entry before liquidity sweep bar"
    else if canEnter and not require_liquidity_sweep
        if not liqValid
            // Liquidity not strictly required, but we still report it for transparency
            reason := "OK (liquidity optional; none/invalid)"

    // Wick into zone (generic: any of last 3 bars touching zone)
    bool wickIntoZone = false
    if canEnter
        for w = 0 to 2
            if bar_index >= w
                float wLow = low[w]
                float wHigh = high[w]
                bool touches = (wLow <= zoneHigh and wLow >= zoneLow) or (wHigh <= zoneHigh and wHigh >= zoneLow) or (wHigh >= zoneLow and wLow <= zoneHigh)
                if touches
                    wickIntoZone := true
                    break
        if not wickIntoZone
            canEnter := false
            reason := "No wick into demand zone in last 3 bars"

    // Close outside zone & bullish candle
    float current_close = close
    float current_open  = open
    bool price_not_closed_inside = current_close < zoneLow or current_close > zoneHigh
    bool is_bullish_close = current_close > current_open
    if canEnter and not price_not_closed_inside
        canEnter := false
        reason := "Close inside demand zone"
    if canEnter and not is_bullish_close
        canEnter := false
        reason := "Entry candle not bullish for demand"

    // Zone not used yet
    int last_entry_bar = idx < array.size(demandZoneLastEntryBar) ? array.get(demandZoneLastEntryBar, idx) : na
    bool zone_already_used = not na(last_entry_bar)
    if canEnter and zone_already_used
        canEnter := false
        reason := "Demand zone already used for a trade"

    // Zone not mitigated
    bool zone_mitigated = idx < array.size(demandZoneMitigated) ? array.get(demandZoneMitigated, idx) : false
    if canEnter and zone_mitigated
        canEnter := false
        reason := "Demand zone mitigated before liquidity sweep"

    // 24h freshness
    int zTime = idx < array.size(demandZoneTime) ? array.get(demandZoneTime, idx) : na
    bool zoneIsFresh = na(zTime) or (time - zTime) <= (24 * 60 * 60 * 1000)
    if canEnter and not zoneIsFresh
        canEnter := false
        reason := "Demand zone older than 24h"

    // Minimum bar index for entries
    int zoneCreatedBar = idx < array.size(demandZoneCreatedBarIndex) ? array.get(demandZoneCreatedBarIndex, idx) : na
    bool zone_created_after_min_bar = na(zoneCreatedBar) or zoneCreatedBar >= min_bar_index_for_entries
    if canEnter and not zone_created_after_min_bar
        canEnter := false
        reason := "Demand zone created before min_bar_index_for_entries"

    // Timing filters (30m/1h boundaries)
    if canEnter and is_blocked_by_timing()
        canEnter := false
        reason := "Blocked by timing filters (before HTF candle)"

    // Daily trade limits
    if canEnter and not trades_allowed_today()
        canEnter := false
        reason := "Max trades per day reached"

    // Session time window
    if canEnter and not is_in_session()
        canEnter := false
        reason := "Outside allowed session time window"

    // Only one long entry per bar & no existing position
    bool noEntryThisBar = na(last_global_long_entry_bar) or bar_index > last_global_long_entry_bar
    if canEnter and not noEntryThisBar
        canEnter := false
        reason := "Long entry already taken this bar"

    if canEnter and strategy.position_size != 0
        canEnter := false
        reason := "Existing position open (no stacking)"

    // Default OK reason if everything passed and no explicit description set
    if canEnter and (reason == "" or str.length(reason) == 0)
        reason := "OK"

    [canEnter, reason]

isValidSupplyEntry(idx) =>
    bool canEnter = true
    string reason = ""

    // Basic index / array safety
    if idx < 0 or idx >= array.size(supplyHighs) or idx >= array.size(supplyLows)
        canEnter := false
        reason := "Invalid supply zone index"
    else
        // Zone must be active
        bool isActive = idx < array.size(supplyActive) ? array.get(supplyActive, idx) : false
        if not isActive
            canEnter := false
            reason := "Supply zone inactive"

    float zoneHigh = na
    float zoneLow  = na
    if canEnter
        zoneHigh := array.get(supplyHighs, idx)
        zoneLow  := array.get(supplyLows, idx)

    // Zone must have caused sweep & not be historical
    bool zoneCausedSweep = idx < array.size(supplyZoneCausedSweep) ? array.get(supplyZoneCausedSweep, idx) : false
    bool isHistoricalZone = idx < array.size(supplyZoneIsHistorical) ? array.get(supplyZoneIsHistorical, idx) : false
    if canEnter and (not zoneCausedSweep)
        canEnter := false
        reason := "Supply zone did not cause liquidity sweep"
    if canEnter and isHistoricalZone
        canEnter := false
        reason := "Supply zone created in historical backfill"

    // Liquidity existence (candle‑count rule) & sweep timing
    bool liqValid = idx < array.size(supplyZoneLiquidityValid) ? array.get(supplyZoneLiquidityValid, idx) : false
    bool liqSwept = idx < array.size(supplyZoneLiquiditySwept) ? array.get(supplyZoneLiquiditySwept, idx) : false
    int  liqSweptBarIndex = idx < array.size(supplyZoneLiquiditySweptBarIndex) ? array.get(supplyZoneLiquiditySweptBarIndex, idx) : na

    if canEnter and require_liquidity_sweep
        if not liqValid
            canEnter := false
            reason := "Supply liquidity invalid (candle‑count rule failed)"
        else if not liqSwept
            canEnter := false
            reason := "Supply liquidity not yet swept"
        else if na(liqSweptBarIndex) or bar_index < liqSweptBarIndex
            canEnter := false
            reason := "Supply entry before liquidity sweep bar"
    else if canEnter and not require_liquidity_sweep
        if not liqValid
            reason := "OK (liquidity optional; none/invalid)"

    // Wick into zone (generic: any of last 3 bars touching zone)
    bool wickIntoZone = false
    if canEnter
        for w = 0 to 2
            if bar_index >= w
                float wLow = low[w]
                float wHigh = high[w]
                bool touches = (wHigh >= zoneLow and wHigh <= zoneHigh) or (wLow >= zoneLow and wLow <= zoneHigh) or (wHigh >= zoneLow and wLow <= zoneHigh)
                if touches
                    wickIntoZone := true
                    break
        if not wickIntoZone
            canEnter := false
            reason := "No wick into supply zone in last 3 bars"

    // Close outside zone & bearish candle
    float current_close = close
    float current_open  = open
    bool price_not_closed_inside = current_close > zoneHigh or current_close < zoneLow
    bool is_bearish_close = current_close < current_open
    if canEnter and not price_not_closed_inside
        canEnter := false
        reason := "Close inside supply zone"
    if canEnter and not is_bearish_close
        canEnter := false
        reason := "Entry candle not bearish for supply"

    // Zone not used yet
    int last_entry_bar = idx < array.size(supplyZoneLastEntryBar) ? array.get(supplyZoneLastEntryBar, idx) : na
    bool zone_already_used = not na(last_entry_bar)
    if canEnter and zone_already_used
        canEnter := false
        reason := "Supply zone already used for a trade"

    // Zone not mitigated
    bool zone_mitigated = idx < array.size(supplyZoneMitigated) ? array.get(supplyZoneMitigated, idx) : false
    if canEnter and zone_mitigated
        canEnter := false
        reason := "Supply zone mitigated before liquidity sweep"

    // 24h freshness
    int zTime = idx < array.size(supplyZoneTime) ? array.get(supplyZoneTime, idx) : na
    bool zoneIsFresh = na(zTime) or (time - zTime) <= (24 * 60 * 60 * 1000)
    if canEnter and not zoneIsFresh
        canEnter := false
        reason := "Supply zone older than 24h"

    // Minimum bar index for entries
    int zoneCreatedBar = idx < array.size(supplyZoneCreatedBarIndex) ? array.get(supplyZoneCreatedBarIndex, idx) : na
    bool zone_created_after_min_bar = na(zoneCreatedBar) or zoneCreatedBar >= min_bar_index_for_entries
    if canEnter and not zone_created_after_min_bar
        canEnter := false
        reason := "Supply zone created before min_bar_index_for_entries"

    // Timing filters (30m/1h boundaries)
    if canEnter and is_blocked_by_timing()
        canEnter := false
        reason := "Blocked by timing filters (before HTF candle)"

    // Daily trade limits
    if canEnter and not trades_allowed_today()
        canEnter := false
        reason := "Max trades per day reached"

    // Session time window
    if canEnter and not is_in_session()
        canEnter := false
        reason := "Outside allowed session time window"

    // No existing position (no stacking)
    if canEnter and strategy.position_size != 0
        canEnter := false
        reason := "Existing position open (no stacking)"

    if canEnter and (reason == "" or str.length(reason) == 0)
        reason := "OK"

    [canEnter, reason]

// === TRACK LIQUIDITY AND ZONE STATUS (DEMAND) ===
// CRITICAL: Only validate liquidity sweeps for LIVE zones (not historical backfill)
if array.size(demandHighs) > 0 and barstate.isconfirmed
    current_close = close
    current_open = open
    
    for i = 0 to array.size(demandHighs) - 1
        if array.get(demandActive, i)
            // Skip historical zones - we don't validate sweeps for them
            bool isHistoricalZone = i < array.size(demandZoneIsHistorical) ? array.get(demandZoneIsHistorical, i) : false
            if isHistoricalZone
                continue  // Skip all liquidity validation for historical zones
            
            zoneHigh = array.get(demandHighs, i)
            zoneLow  = array.get(demandLows, i)
            liqLevel = array.get(demandZoneLiquidity, i)
            liqSwept = array.get(demandZoneLiquiditySwept, i)
            zoneCreatedBar = array.get(demandZoneCreatedBarIndex, i)
            
            // === VALIDATE EXISTING LIQUIDITY: Must be ABOVE zone ===
            // Clear invalid liquidity that's not actually above the zone
            if not na(liqLevel)
                // CRITICAL: For demand zones, liquidity MUST be above zoneHigh
                if liqLevel <= zoneHigh
                    // Invalid liquidity - clear it
                    array.set(demandZoneLiquidity, i, na)
                    array.set(demandZoneLiquidityBarIndex, i, na)
                    array.set(demandZoneLiquiditySwept, i, false)
                    array.set(demandZoneLiquiditySweptBarIndex, i, na)
                    if i < array.size(demandZoneCausedSweep)
                        array.set(demandZoneCausedSweep, i, false)
                    // Reset per-zone liquidity validity / count
                    if i < array.size(demandZoneLiquidityValid)
                        array.set(demandZoneLiquidityValid, i, false)
                    if i < array.size(demandZoneLiquidityCandleCount)
                        array.set(demandZoneLiquidityCandleCount, i, 0)
                    if i < array.size(demandLiqCandles)
                        array.set(demandLiqCandles, i, 0)  // Reset candle count when liquidity is cleared
                    // Reset liqLevel for this iteration
                    liqLevel := na
                // Clear any visual connector/label for this zone's liquidity
                clearDemandLiquidityVisual(i)
            
            // Detect INDUCEMENT (Lows) above the Demand Zone
            if na(liqLevel) and array.size(liqPvtLowPrices) > 0
                
                // Search for best valid Inducement Low
                int best_p_index = -1
                float best_p_price = 1000000.0 // Find Lowest valid inducement
                int best_p_bar = na
                int best_p_count = 0
                
                for p = array.size(liqPvtLowPrices) - 1 to 0
                    float pLow = array.get(liqPvtLowPrices, p)
                    int   pBar = array.get(liqPvtLowBars,   p)
                    
                    // 1. GEOMETRY: Inducement must be ABOVE the zone
                    bool isGeometricallyValid = pLow > zoneHigh and (na(zoneCreatedBar) or pBar > zoneCreatedBar)
                    
                    if isGeometricallyValid
                        // 2. CANDLE COUNT (Structure in the leg up to the inducement?)
                        // For Inducement, we scan from Zone to Pivot using helper
                        int cand_start = zoneCreatedBar + 1
                        int cand_end = pBar
                        int cand_oppCount = countOppositeCandlesInBand(true, cand_start, cand_end, pLow, zoneHigh)
                        
                        // 3. SELECTION: Find the LOWEST valid inducement (closest to zone)
                        // If 'require_major_liquidity' is OFF, pick the most recent one.
                        if cand_oppCount > 0
                            if best_p_index == -1 or (require_major_liquidity ? pLow < best_p_price : true)
                                best_p_index := p
                                best_p_price := pLow
                                best_p_bar   := pBar
                                best_p_count := cand_oppCount
                                if not require_major_liquidity
                                    break // Stop at first valid recent one
                
                // Set Data...
                if best_p_index != -1
                    array.set(demandZoneLiquidity, i, best_p_price) // This is now a LOW
                    array.set(demandZoneLiquidityBarIndex, i, best_p_bar)
                    array.set(demandZoneLiquiditySwept, i, false)
                    liqLevel := best_p_price
                    
                    if i < array.size(demandLiqCandles)
                        array.set(demandLiqCandles, i, best_p_count)
                    if i < array.size(demandZoneLiquidityCandleCount)
                        array.set(demandZoneLiquidityCandleCount, i, best_p_count)

            // Single-source-of-truth validation for demand liquidity
            bool liqValidDemand = isLiquidityValidForEntry(true, i)
            if i < array.size(demandZoneLiquidityValid)
                array.set(demandZoneLiquidityValid, i, liqValidDemand)

            // Update demand liquidity visuals (connector + label)
            updateDemandLiquidityVisual(i)

            // DEMAND SWEEP CHECK (Inducement Mode)
            if not na(liqLevel) and not liqSwept
                // Liquidity (Low) must be above zone (checked in search, but safe to keep)
                if liqLevel > zoneHigh
                    // SWEEP TRIGGER: Price drops BELOW the Inducement Low
                    if low < liqLevel
                        array.set(demandZoneLiquiditySwept, i, true)
                        array.set(demandZoneLiquiditySweptBarIndex, i, bar_index)
                        // Historical zones are already skipped at loop start, so this is guaranteed to be a live zone
                        if i < array.size(demandZoneCausedSweep)
                            array.set(demandZoneCausedSweep, i, true)
            
            if current_close > zoneHigh and not array.get(demandLeftZone, i)
                array.set(demandLeftZone, i, true)
                array.set(demandLeftWithBearish, i, current_close < current_open)
            
            // === STRICT MITIGATION CHECK (DEMAND) ===
            if i < array.size(demandZoneMitigated) and not array.get(demandZoneMitigated, i)
                // Check if bar is after creation
                bool is_future_bar = not na(zoneCreatedBar) and bar_index > zoneCreatedBar
                
                // ANY overlapping price action counts as mitigation
                bool touches_zone = low <= zoneHigh and high >= zoneLow
                
                // Only mitigate if liquidity hasn't been swept/activated yet
                // CRITICAL: a zone should only be mitigated if touched *before* its liquidity sweep.
                // We therefore require BOTH the swept flag to be false OR the current bar to be
                // strictly before the recorded sweep bar index.
                int liqSweptBarIdx = i < array.size(demandZoneLiquiditySweptBarIndex) ? array.get(demandZoneLiquiditySweptBarIndex, i) : na
                bool liquidity_not_swept_yet = (na(liqSweptBarIdx) and not liqSwept) or (not na(liqSweptBarIdx) and bar_index < liqSweptBarIdx)
                
                if is_future_bar and touches_zone and liquidity_not_swept_yet
                    array.set(demandZoneMitigated, i, true)
                    if i < array.size(demandZoneMitigationTime)
                        array.set(demandZoneMitigationTime, i, time)
                    // Visual feedback (Gray out zone)
                    if i < array.size(demandBoxes)
                        b = array.get(demandBoxes, i)
                        if not na(b)
                            box.set_bgcolor(b, color.new(color.gray, 85))
                            box.set_border_color(b, color.gray)

// === TRACK LIQUIDITY AND ZONE STATUS (SUPPLY) ===
// CRITICAL: Only validate liquidity sweeps for LIVE zones (not historical backfill)
// For supply zones, liquidity is BELOW the zone - must be a proper swing LOW
if array.size(supplyHighs) > 0 and barstate.isconfirmed
    current_close = close
    current_open = open
    current_low = low
    
    for i = 0 to array.size(supplyHighs) - 1
        if array.get(supplyActive, i)
            // Skip historical zones - we don't validate sweeps for them
            bool isHistoricalZone = i < array.size(supplyZoneIsHistorical) ? array.get(supplyZoneIsHistorical, i) : false
            if isHistoricalZone
                continue  // Skip all liquidity validation for historical zones
            
            zoneHigh = array.get(supplyHighs, i)
            zoneLow  = array.get(supplyLows, i)
            zoneCreatedBar = i < array.size(supplyZoneCreatedBarIndex) ? array.get(supplyZoneCreatedBarIndex, i) : na
            liqLevel = i < array.size(supplyZoneLiquidity) ? array.get(supplyZoneLiquidity, i) : na
            liqExists = i < array.size(supplyLiqExists) ? array.get(supplyLiqExists, i) : false
            liqSwept = i < array.size(supplyZoneLiquiditySwept) ? array.get(supplyZoneLiquiditySwept, i) : false
            
            // === VALIDATE EXISTING LIQUIDITY: Must be BELOW zone ===
            // Clear invalid liquidity that's not actually below the zone
            // This validation runs on EVERY bar to catch any invalid liquidity
            if liqExists or not na(liqLevel)
                // CRITICAL: For supply zones, liquidity MUST be below zoneLow
                // Use strict check: liquidity must be at least 0.1 pips below zone to account for floating point precision
                liquidityIsValid = not na(liqLevel) and liqLevel < (zoneLow - pip_size * 0.1)
                
                if not liquidityIsValid
                    // Invalid liquidity - clear it completely
                    if i < array.size(supplyZoneLiquidity)
                        array.set(supplyZoneLiquidity, i, na)
                    if i < array.size(supplyLiqExists)
                        array.set(supplyLiqExists, i, false)
                    if i < array.size(supplyZoneLiquidityBarIndex)
                        array.set(supplyZoneLiquidityBarIndex, i, na)
                    if i < array.size(supplyZoneLiquiditySwept)
                        array.set(supplyZoneLiquiditySwept, i, false)
                    if i < array.size(supplyZoneLiquiditySweptBarIndex)
                        array.set(supplyZoneLiquiditySweptBarIndex, i, na)
                    if i < array.size(supplyZoneCausedSweep)
                        array.set(supplyZoneCausedSweep, i, false)
                    // Reset candle count when liquidity is cleared
                    if i < array.size(supplyLiqCandles)
                        array.set(supplyLiqCandles, i, 0)
                    // Reset liqLevel and liqExists for this iteration
                    liqLevel := na
                    liqExists := false
                    liqSwept := false
                    // Clear any visual connector/label for this zone's liquidity
                    clearSupplyLiquidityVisual(i)

            // Detect INDUCEMENT (Lows) below the Supply Zone
            // Liquidity for supply zones is defined as swing LOWS that are:
            //  - Completely below the zone (no wicks touching the zone)
            //  - Formed AFTER the zone creation
            //  - Have sufficient opposite-candle structure in the band between the zone and the swing low
            if na(liqLevel) and array.size(liqPvtLowPrices) > 0
                
                int best_p_index = -1
                float best_p_price = 0.0 // Find LOWEST valid inducement (farthest below the zone when require_major_liquidity=true)
                int best_p_bar = na
                int best_p_count = 0

                for p = array.size(liqPvtLowPrices) - 1 to 0
                    float pLow = array.get(liqPvtLowPrices, p)
                    int   pBar = array.get(liqPvtLowBars,   p)
                    
                    // GEOMETRY:
                    //  1) Inducement low must be BELOW the zone
                    //  2) Entire bar must sit below the zone (no wicks touching the zone)
                    bool isBelowZone = pLow < zoneLow
                    // Convert stored bar_index to a safe historical offset.
                    // If the pivot is too far in the past, skip it to avoid "too far from current bar" errors.
                    int barOffset = bar_index - pBar
                    if barOffset < 0 or barOffset > 500
                        continue
                    float barHigh = high[barOffset]
                    bool barCompletelyBelow = barHigh < zoneLow
                    bool formedAfterZone  = na(zoneCreatedBar) or pBar > zoneCreatedBar
                    bool isGeometricallyValid = isBelowZone and barCompletelyBelow and formedAfterZone
                    
                    if isGeometricallyValid
                        // Opposite structure between zone and inducement:
                        // For supply (shorts), we want bullish candles in the band from zoneLow down to pLow.
                        int cand_start = zoneCreatedBar + 1
                        int cand_end = pBar
                        int cand_oppCount = countOppositeCandlesInBand(false, cand_start, cand_end, zoneLow, pLow)

                        if cand_oppCount > 0
                            if best_p_index == -1 or (require_major_liquidity ? pLow < best_p_price : true)
                                best_p_index := p
                                best_p_price := pLow
                                best_p_bar   := pBar
                                best_p_count := cand_oppCount
                                if not require_major_liquidity
                                    break

                // Persist chosen inducement for this supply zone
                if best_p_index != -1
                    if i < array.size(supplyZoneLiquidity)
                        array.set(supplyZoneLiquidity, i, best_p_price) // Store LOW below the zone
                    if i < array.size(supplyZoneLiquidityBarIndex)
                        array.set(supplyZoneLiquidityBarIndex, i, best_p_bar)
                    if i < array.size(supplyZoneLiquiditySwept)
                        array.set(supplyZoneLiquiditySwept, i, false)
                    liqLevel := best_p_price
                    
                    if i < array.size(supplyLiqCandles)
                        array.set(supplyLiqCandles, i, best_p_count)
                    if i < array.size(supplyLiqCandleCount)
                        array.set(supplyLiqCandleCount, i, best_p_count)

            // Single-source-of-truth validation for supply liquidity
            bool liqValidSupply = isLiquidityValidForEntry(false, i)
            if i < array.size(supplyLiqExists)
                array.set(supplyLiqExists, i, liqValidSupply)
            if i < array.size(supplyZoneLiquidityValid)
                array.set(supplyZoneLiquidityValid, i, liqValidSupply)
            liqExists := liqValidSupply

            // Update supply liquidity visuals (connector + label)
            updateSupplyLiquidityVisual(i)

            if current_close < zoneLow and not array.get(supplyLeftZone, i)
                array.set(supplyLeftZone, i, true)
            
            // === STRICT MITIGATION CHECK (SUPPLY) ===
            if i < array.size(supplyZoneMitigated) and not array.get(supplyZoneMitigated, i)
                bool is_future_bar = not na(zoneCreatedBar) and bar_index > zoneCreatedBar
                
                // ANY overlapping price action counts as mitigation
                bool touches_zone = high >= zoneLow and low <= zoneHigh
                
                // Only mitigate if liquidity hasn't been swept/activated yet
                // CRITICAL: a zone should only be mitigated if touched *before* its liquidity sweep.
                // We therefore require BOTH the swept flag to be false OR the current bar to be
                // strictly before the recorded sweep bar index.
                int liqSweptBarIdx = i < array.size(supplyZoneLiquiditySweptBarIndex) ? array.get(supplyZoneLiquiditySweptBarIndex, i) : na
                bool liquidity_not_swept_yet = (na(liqSweptBarIdx) and not liqSwept) or (not na(liqSweptBarIdx) and bar_index < liqSweptBarIdx)
                
                if is_future_bar and touches_zone and liquidity_not_swept_yet
                    array.set(supplyZoneMitigated, i, true)
                    if i < array.size(supplyZoneMitigationTime)
                        array.set(supplyZoneMitigationTime, i, time)
                    // Visual feedback
                    if i < array.size(supplyBoxes)
                        b = array.get(supplyBoxes, i)
                        if not na(b)
                            box.set_bgcolor(b, color.new(color.gray, 85))
                            box.set_border_color(b, color.gray)

// === ZONE INVALIDATION (DEMAND) ===
if array.size(demandHighs) > 0
    current_close = close
    current_open  = open
    current_low   = low
    // Keep candle color for wick-based invalidation after leaving the zone
    bool is_bearish_c  = current_close < current_open
    pip_buffer    = pip_size * 0.1
    
    for i = array.size(demandHighs) - 1 to 0
        if array.get(demandActive, i)
            hi = array.get(demandHighs, i)
            lo = array.get(demandLows, i)
            left_zone = array.get(demandLeftZone, i)
            left_with_bearish = array.get(demandLeftWithBearish, i)
            
            // Time Check
            int zTime = i < array.size(demandZoneTime) ? array.get(demandZoneTime, i) : na
            bool isTooOld = not na(zTime) and (time - zTime) > (24 * 60 * 60 * 1000)
            
            // Invalidation Conditions:
            // 1. Close inside (bearish)
            bearish_close_inside = current_close <= hi and current_close >= lo
            // 2. Close below (Standard invalidation)
            close_below_zone     = current_close < lo
            // 3. Mitigation (Bearish wick after leaving)
            wicks_into_zone      = current_low <= (hi + pip_buffer) and current_low >= (lo - pip_buffer)
            bearish_wick_after_leaving = left_zone and left_with_bearish and is_bearish_c and wicks_into_zone

            // REMOVED: 'wick_below_zone' check so wicks don't kill the zone
            if bearish_close_inside or close_below_zone or bearish_wick_after_leaving or isTooOld
                remove_demand_zone_all_arrays(i)

// === ZONE INVALIDATION (SUPPLY) ===
if array.size(supplyHighs) > 0
    current_close = close
    current_open  = open
    current_high  = high
    
    for i = array.size(supplyHighs) - 1 to 0
        if array.get(supplyActive, i)
            hi = array.get(supplyHighs, i)
            lo = array.get(supplyLows, i)
            
            // Time Check
            int zTime = i < array.size(supplyZoneTime) ? array.get(supplyZoneTime, i) : na
            bool isTooOld = not na(zTime) and (time - zTime) > (24 * 60 * 60 * 1000)
            
            // Invalidation Conditions:
            // 1. Close inside (bullish)
            bullish_close_inside = current_close >= lo and current_close <= hi
            // 2. Close above (Standard invalidation)
            close_above_zone     = current_close > hi

            // REMOVED: 'wick_above_zone' check
            if bullish_close_inside or close_above_zone or isTooOld
                remove_supply_zone_all_arrays(i)

// === UPDATE ZONE BOXES AND LABELS (Dynamic Extension + UZID) ===
// Update demand zone boxes to extend to exact bar count and update labels with UZID
if show_zones and show_demand_zones and array.size(demandBoxes) > 0 and barstate.isconfirmed
    for i = 0 to math.min(array.size(demandBoxes) - 1, array.size(demandHighs) - 1)
        if i < array.size(demandActive) and array.get(demandActive, i)
            // Get creation bar index and update box right edge to extend exactly 'extend_bars' bars
            if i < array.size(demandZoneCreatedBarIndex)
                creation_bar_index = array.get(demandZoneCreatedBarIndex, i)
                if not na(creation_bar_index)
                    left_bar_index = creation_bar_index
                    right_bar_index = left_bar_index + extend_bars
                    b = array.get(demandBoxes, i)
                    if not na(b)
                        // Update box right edge for exact extension
                        box.set_right(b, right_bar_index)
                        // Update colors to ensure consistency
                        box.set_bgcolor(b, col_demand_bg)
                        box.set_border_color(b, col_demand_border)
                        box.set_border_width(b, 1)
                        if i < array.size(demandZoneLabels)
                            label lbl_update = array.get(demandZoneLabels, i)
                            if not na(lbl_update)
                                float lbl_top = box.get_top(b)
                                float lbl_bottom = box.get_bottom(b)
                                int lbl_left = box.get_left(b)
                                float lbl_mid = (lbl_top + lbl_bottom) / 2
                                int lbl_x = lbl_left + 1
                                label.set_x(lbl_update, lbl_x)
                                label.set_y(lbl_update, lbl_mid)
                                if i < array.size(demandZoneUZID)
                                    label.set_text(lbl_update, "D-" + str.tostring(array.get(demandZoneUZID, i)))
                                label.set_style(lbl_update, label.style_label_left)
                                label.set_textcolor(lbl_update, color.black)
                                label.set_color(lbl_update, color.new(color.white, 100))
                                label.set_size(lbl_update, size.small)
                                label.set_textalign(lbl_update, text.align_center)
            
            // Zone ID is now displayed using plottext() in the main plotting section

// Update supply zone boxes to extend to exact bar count and update labels with UZID
if show_zones and show_supply_zones and array.size(supplyBoxes) > 0 and barstate.isconfirmed
    for i = 0 to math.min(array.size(supplyBoxes) - 1, array.size(supplyHighs) - 1)
        if i < array.size(supplyActive) and array.get(supplyActive, i)
            // Get creation bar index and update box right edge to extend exactly 'extend_bars' bars
            if i < array.size(supplyZoneCreatedBarIndex)
                creation_bar_index = array.get(supplyZoneCreatedBarIndex, i)
                if not na(creation_bar_index)
                    left_bar_index = creation_bar_index
                    right_bar_index = left_bar_index + extend_bars
                    b = array.get(supplyBoxes, i)
                    if not na(b)
                        // Update box right edge for exact extension
                        box.set_right(b, right_bar_index)
                        // Update colors to ensure consistency
                        box.set_bgcolor(b, col_supply_bg)
                        box.set_border_color(b, col_supply_border)
                        box.set_border_width(b, 1)
                        if i < array.size(supplyZoneLabels)
                            label lbl_update_s = array.get(supplyZoneLabels, i)
                            if not na(lbl_update_s)
                                float lbl_top_s = box.get_top(b)
                                float lbl_bottom_s = box.get_bottom(b)
                                int lbl_left_s = box.get_left(b)
                                float lbl_mid_s = (lbl_top_s + lbl_bottom_s) / 2
                                int lbl_x_s = lbl_left_s + 1
                                label.set_x(lbl_update_s, lbl_x_s)
                                label.set_y(lbl_update_s, lbl_mid_s)
                                if i < array.size(supplyZoneUZID)
                                    label.set_text(lbl_update_s, "S-" + str.tostring(array.get(supplyZoneUZID, i)))
                                label.set_style(lbl_update_s, label.style_label_left)
                                label.set_textcolor(lbl_update_s, color.black)
                                label.set_color(lbl_update_s, color.new(color.white, 100))
                                label.set_size(lbl_update_s, size.small)
                                label.set_textalign(lbl_update_s, text.align_center)
            
            // Zone ID is now displayed using plottext() in the main plotting section

// Zone IDs are created with labels when zones are created - see createDemandZone() and createSupplyZone()
// Labels are positioned at the left edge (creation bar) and remain anchored there

// === FLIP ENTRY DETECTION (30M CANDLE BOUNDARY) ===
var int last_30m_time = na

// Check if new 30m candle just opened
[thirty_min_time] = request.security(syminfo.tickerid, "30", [time], lookahead = barmerge.lookahead_off)
is_new_30m_candle = na(last_30m_time) or (thirty_min_time != last_30m_time)

if is_new_30m_candle
    last_30m_time := thirty_min_time

// Flip entry logic for demand zones - RESTORED TO ORIGINAL STRUCTURE
if enable_flip_entry and tf_mode == "5" and array.size(demandHighs) > 0 and allow_long_trades and is_new_30m_candle and strategy.position_size == 0
    current_close = close
    current_open = open
    current_low = low
    current_high = high
    is_bullish_candle = current_close > current_open
    
    for i = 0 to array.size(demandHighs) - 1
        if array.get(demandActive, i)
            zoneHigh = array.get(demandHighs, i)
            zoneLow = array.get(demandLows, i)
            zoneSize = zoneHigh - zoneLow
            liqLevel = array.get(demandZoneLiquidity, i)
            liqSwept = array.get(demandZoneLiquiditySwept, i)
            liqSweptBarIndex = array.get(demandZoneLiquiditySweptBarIndex, i)
            liqValid = array.get(demandZoneLiquidityValid, i)
            last_entry_bar = array.get(demandZoneLastEntryBar, i)
            zone_already_used = not na(last_entry_bar)
            
            // Check if wick goes into zone
            wick_into_zone = current_low <= zoneHigh and current_low >= zoneLow
            wick_size = current_close - current_low
            wick_percent_of_zone = zoneSize > 0 ? (wick_size / zoneSize * 100) : 0
            
            // === LIQUIDITY SWEEP VALIDATION FOR LONG FLIP ===
            // Use unified validation helper (shared with regular entries)
            [base_can_enter_demand, base_reason_demand] = isValidDemandEntry(i)
            
            // Strong flip in entry direction (bullish)
            strong_flip = is_bullish_candle and (current_close - current_open) > (current_high - current_low) * 0.6
            
            // Wick fully formed (bottom wick for longs)
            wick_fully_formed = current_low < current_open and current_low < current_close
            
            // Check if wick size meets threshold
            wick_threshold_met = wick_percent_of_zone >= flip_wick_threshold_pct
            
            // Timing and trade limits (ORIGINAL: checked per zone inside loop)
            timing_blocked = is_blocked_by_timing()
            trades_allowed = trades_allowed_today()
            
            // Check if zone is mitigated (bearish candle touched before liquidity sweep)
            zone_mitigated = i < array.size(demandZoneMitigated) ? array.get(demandZoneMitigated, i) : false
            
            // === 24-HOUR ZONE FRESHNESS CHECK ===
            zoneTime = i < array.size(demandZoneTime) ? array.get(demandZoneTime, i) : na
            zoneAgeMs = not na(zoneTime) ? (time - zoneTime) : 0
            maxAgeMs = 24 * 60 * 60 * 1000  // 24 hours in milliseconds
            zoneIsFresh = na(zoneTime) or zoneAgeMs <= maxAgeMs
            
            // === MINIMUM BAR INDEX CHECK ===
            // Only allow entries on zones created after minimum bar index to avoid backfill issues
            zoneCreatedBar = i < array.size(demandZoneCreatedBarIndex) ? array.get(demandZoneCreatedBarIndex, i) : na
            zone_created_after_min_bar = na(zoneCreatedBar) or zoneCreatedBar >= min_bar_index_for_entries
            
            // Flip-specific gate: base_can_enter_demand already enforces all shared rules
            can_flip_enter = enable_flip_entry and base_can_enter_demand and zoneIsFresh and wick_into_zone and strong_flip and wick_fully_formed and (wick_threshold_met or true) and not zone_already_used and not timing_blocked and trades_allowed and not zone_mitigated and zone_created_after_min_bar and is_in_session()
            
            // ORIGINAL structure: flipEntryAllowed with barstate.isconfirmed
            bool flipEntryAllowed = can_flip_enter and barstate.isconfirmed
            if flipEntryAllowed
                in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue
                
                // Flip entry: use PREVIOUS candle's close as entry price
                // This ensures consistency between chart labels and Strategy Tester
                entry_price = close[1]
                
                // SL directly under the previous candle (the flip candle)
                stop_loss_price = low[1]
                
                // Rule: Session open flip entries don't have sl directly above/below the candle, follow normal 1 or 2 pip placement
                if hour(time, time_window_tz) == start_hour
                    float flip_buffer = stop_loss_buffer_pips > 0 ? stop_loss_buffer_pips : 2.0
                    stop_loss_price := stop_loss_price - (flip_buffer * pip_size)
                
                // For LONG FLIP: SL is BELOW entry, so pip_distance = Entry - SL (must be positive)
                float pip_distance = entry_price - stop_loss_price
                
                // Validate: pip_distance must be positive for longs (SL below entry)
                if pip_distance <= 0
                    continue  // Invalid SL, skip this trade
                
                // SL pips = pip_distance / pip_size (always positive)
                float sl_pips = pip_distance / pip_size
                
                // Calculate setup score for flip entry
                setup_score = calculate_setup_score(true, i, zoneHigh, zoneLow, true, sl_pips)
                setup_rating = get_score_rating(setup_score)
                
                // Only take trades that meet minimum score requirement
                if setup_score < min_score_for_trade
                    continue
                
                // Calculate TP using RD_FOREX 5-minute rules
                // Calculate TP using Updated Rules
                float take_profit_price = na
                
                // Reset BE variables
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false
                
                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    
                    // Override with fixed RR
                    if use_fixed_rr
                        tp_r := fixed_rr_value
                        move_be := false
                        
                    // Apply double TP
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                        
                    if not na(tp_r)
                        take_profit_price := entry_price + (pip_distance * tp_r)
                        
                    // Store BE settings
                    if move_be and not use_fixed_rr
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl
                
                // Check for USDJPY rate failure for JPY pairs (before position sizing)
                if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                    // Fetch USDJPY rate using helper
                    [usdjpy_rate_check, usdjpy_success_check, usdjpy_err_check] = fetch_usdjpy_rate()
                    if not usdjpy_success_check
                        // Show warning label and skip trade
                        if show_entry_labels
                            label.new(x = bar_index, y = high, text = "⚠️ USDJPY Rate Fetch Failed\nTrade Skipped",
                                      style = label.style_label_down, color = color.new(color.orange, 0),
                                      textcolor = color.white, size = size.normal)
                        continue  // Skip this trade
                
                // Position sizing with enhanced validation
                balance  = account_size_usd
                risk_pct = risk_per_trade_pct
                
                // Apply 0.5R adjustment for second trade of the day
                if current_day_trades == 1 and max_trades_per_day == 2
                    risk_pct := risk_pct * 0.5
                
                // Enhanced position sizing validation
                [pos_is_valid, pos_qty_units, pos_qty_lots, pos_error_msg, pos_validation_details] = validate_position_size(entry_price, stop_loss_price, balance, risk_pct, false)
                
                // Store position sizing details for debug table
                last_pos_size_entry := entry_price
                last_pos_size_sl := stop_loss_price
                last_pos_size_balance := balance
                last_pos_size_risk_pct := risk_pct
                last_pos_size_sl_pips := sl_pips
                last_pos_size_valid := pos_is_valid
                last_pos_size_error := pos_error_msg
                last_pos_size_dry_run := dry_run_mode
                
                if pos_is_valid
                    last_pos_size_units := pos_qty_units
                    last_pos_size_lots := pos_qty_lots
                    
                    // Get USDJPY rate for tracking
                    if str.contains(syminfo.ticker, "JPY")
                        [usdjpy_track_rate_result, usdjpy_track_success_result, usdjpy_track_err_result] = fetch_usdjpy_rate()
                        if usdjpy_track_success_result
                            last_pos_size_usdjpy_rate := usdjpy_track_rate_result
                        else
                            last_pos_size_usdjpy_rate := na
                else
                    last_pos_size_units := na
                    last_pos_size_lots := na
                    last_pos_size_usdjpy_rate := na
                    
                    // Show warning label for validation failure
                    if show_entry_labels
                        label.new(x = bar_index, y = high, text = "⚠️ Position Size Invalid\n" + pos_error_msg,
                                  style = label.style_label_down, color = color.new(color.red, 0),
                                  textcolor = color.white, size = size.normal)

                // 🔥 ENTRY EXECUTION - ALL actions happen together
                if pos_is_valid and pos_qty_units > 0 and not na(pos_qty_units)
                    // Dry run mode: show what would be executed without actually executing
                    if dry_run_mode
                        if show_entry_labels
                            label.new(x = bar_index, y = entry_price, text = "🔵 DRY RUN: Long Flip\nQty: " + str.tostring(pos_qty_units) + " units\nSL: " + str.tostring(stop_loss_price, "#.####"),
                                      style = label.style_label_up, color = color.new(color.blue, 0),
                                      textcolor = color.white, size = size.normal)
                        
                        if not na(stop_loss_price)
                            sl_pips_display = not na(sl_pips) ? str.tostring(sl_pips, "#.##") + " pips" : "N/A"
                            label.new(x = bar_index, y = stop_loss_price,
                                      text = "DRY RUN SL: " + str.tostring(stop_loss_price, "#.####") + "\n(" + sl_pips_display + ")",
                                      style = label.style_label_left, color = color.new(color.orange, 0),
                                      textcolor = color.white, size = size.normal)
                    else
                        // 1. EXECUTE THE ENTRY (using close[1] as entry)
                        strategy.entry("Long Flip", strategy.long, qty = pos_qty_units)
                    
                    // 2. ATTACH EXIT ORDERS
                    if not na(take_profit_price) and take_profit_price > 0
                        strategy.exit("Long Flip SL/TP", "Long Flip", stop = stop_loss_price, limit = take_profit_price)
                    else
                        strategy.exit("Long Flip SL", "Long Flip", stop = stop_loss_price)
                    
                    // Zone and trade tracking (skip incrementing trade count in dry run)
                    if not dry_run_mode
                        // 3. SET ACTIVE ENTRY ID
                        active_entry_id := "Long Flip"
                    
                        // 4. INCREMENT TRADE COUNT
                        current_day_trades += 1
                    
                    // 5. MARK ZONE AS USED (even in dry run to avoid duplicate signals)
                    array.set(demandZoneLastEntryBar, i, bar_index)
                    array.set(demandActive, i, false)
                    last_global_long_entry_bar := bar_index
                    
                    // 6. DEACTIVATE ZONES
                    deactivateOverlappingDemandZones(zoneLow, zoneHigh)
                    
                    // 7. TRACK TRADE (even in dry run for display purposes)
                    trade_entry_price := entry_price
                    trade_original_sl := stop_loss_price
                    trade_current_sl := stop_loss_price
                    labels_created := false
                    tp1_hit := false
                    trade_tp1_price := na
                    if not na(stop_loss_price)
                        trade_original_sl_pips := (entry_price - stop_loss_price) / pip_size
                    if not na(take_profit_price) and take_profit_price > entry_price
                        trade_tp1_price := take_profit_price
                    
                    // 8. SHOW LABELS (inside entry block) - only if not dry run (dry run labels shown above)
                    if not dry_run_mode and show_entry_labels and not debug_mode
                        entry_text = show_score_labels ? "FLIP LONG\nScore: " + str.tostring(setup_score, "#") + " (" + setup_rating + ")" : "FLIP LONG"
                        label.new(x = bar_index, y = entry_price, text = entry_text,
                                  style = label.style_label_up, color = color.new(color.blue, 0),
                                  textcolor = color.white, size = size.normal)
                        
                        if not na(stop_loss_price)
                            sl_pips_display = not na(sl_pips) ? str.tostring(sl_pips, "#.##") + " pips" : "N/A"
                            label.new(x = bar_index, y = stop_loss_price,
                                      text = "SL: " + str.tostring(stop_loss_price, "#.####") + "\n(" + sl_pips_display + ")",
                                      style = label.style_label_left, color = color.new(color.red, 0),
                                      textcolor = color.white, size = size.normal)
                        
                        if not na(take_profit_price)
                            tp_rr_display = not na(sl_pips) and sl_pips > 0 ? str.tostring((take_profit_price - entry_price) / (entry_price - stop_loss_price), "#.##") + " RR" : "N/A"
                            label.new(x = bar_index, y = take_profit_price,
                                      text = "TP: " + str.tostring(take_profit_price, "#.####") + "\n(" + tp_rr_display + ")",
                                      style = label.style_label_left, color = color.new(color.green, 0),
                                      textcolor = color.white, size = size.normal)
                        
                        labels_created := true
                
                break

// Flip entry logic for supply zones (SHORT) - NEW
if enable_flip_entry and tf_mode == "5" and array.size(supplyHighs) > 0 and allow_short_trades and is_new_30m_candle and strategy.position_size == 0
    current_close = close
    current_open = open
    current_low = low
    current_high = high
    is_bearish_candle = current_close < current_open
    
    for i = 0 to array.size(supplyHighs) - 1
        if array.get(supplyActive, i)
            zoneHigh = array.get(supplyHighs, i)
            zoneLow = array.get(supplyLows, i)
            zoneSize = zoneHigh - zoneLow

            // ============================================
            // CRITICAL: HARD GATE ON zoneCausedSweep (FLIP) AND LIVE VS HISTORICAL
            // If this zone did NOT cause the liquidity sweep OR was created historically,
            // skip it entirely before checking ANY flip conditions.
            // ============================================
            // Shared validation (zoneCausedSweep, liquidity, timing, freshness, etc.)
            [base_can_enter_supply, base_reason_supply] = isValidSupplyEntry(i)
            if not base_can_enter_supply
                continue
            last_entry_bar = i < array.size(supplyZoneLastEntryBar) ? array.get(supplyZoneLastEntryBar, i) : na
            zone_already_used = not na(last_entry_bar)
            
            // === 24-HOUR ZONE FRESHNESS CHECK ===
            zoneTime = i < array.size(supplyZoneTime) ? array.get(supplyZoneTime, i) : na
            zoneAgeMs = not na(zoneTime) ? (time - zoneTime) : 0
            maxAgeMs = 24 * 60 * 60 * 1000  // 24 hours in milliseconds
            zoneIsFresh = na(zoneTime) or zoneAgeMs <= maxAgeMs
            
            // === MINIMUM BAR INDEX CHECK ===
            // Only allow entries on zones created after minimum bar index to avoid backfill issues
            zoneCreatedBar = i < array.size(supplyZoneCreatedBarIndex) ? array.get(supplyZoneCreatedBarIndex, i) : na
            zone_created_after_min_bar = na(zoneCreatedBar) or zoneCreatedBar >= min_bar_index_for_entries
            
            // Check if wick goes into zone
            wick_into_zone = current_high >= zoneLow and current_high <= zoneHigh
            wick_size = current_high - current_close
            wick_percent_of_zone = zoneSize > 0 ? (wick_size / zoneSize * 100) : 0
            
            // Strong flip in entry direction (bearish)
            strong_flip = is_bearish_candle and (current_open - current_close) > (current_high - current_low) * 0.6
            
            // Wick fully formed (top wick for shorts)
            wick_fully_formed = current_high > current_open and current_high > current_close
            
            // Check if wick size meets threshold
            wick_threshold_met = wick_percent_of_zone >= flip_wick_threshold_pct
            
            // Timing and trade limits
            timing_blocked = is_blocked_by_timing()
            trades_allowed = trades_allowed_today()
            
            // Check if zone is mitigated (bullish candle touched before liquidity sweep)
            zone_mitigated = i < array.size(supplyZoneMitigated) ? array.get(supplyZoneMitigated, i) : false
            
            can_flip_enter = enable_flip_entry and base_can_enter_supply and zoneIsFresh and wick_into_zone and strong_flip and wick_fully_formed and (wick_threshold_met or true) and not zone_already_used and not timing_blocked and trades_allowed and not zone_mitigated and zone_created_after_min_bar and is_in_session()
            
            bool flipEntryAllowed = can_flip_enter and barstate.isconfirmed
            if flipEntryAllowed
                in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue
                
                // Flip entry: use PREVIOUS candle's close as entry price
                entry_price = close[1]
                
                // SL directly above the previous candle (the flip candle)
                stop_loss_price = high[1]
                
                // Rule: Session open flip entries don't have sl directly above/below the candle, follow normal 1 or 2 pip placement
                if hour(time, time_window_tz) == start_hour
                    float flip_buffer = stop_loss_buffer_pips > 0 ? stop_loss_buffer_pips : 2.0
                    stop_loss_price := stop_loss_price + (flip_buffer * pip_size)
                
                // For SHORT FLIP: SL is ABOVE entry, so pip_distance = SL - Entry (must be positive)
                float pip_distance = stop_loss_price - entry_price
                
                // Validate: pip_distance must be positive for shorts (SL above entry)
                if pip_distance <= 0
                    continue  // Invalid SL, skip this trade
                
                // SL pips = pip_distance / pip_size (always positive)
                float sl_pips = pip_distance / pip_size
                
                // Calculate setup score for flip entry
                setup_score = calculate_setup_score(false, i, zoneHigh, zoneLow, true, sl_pips)
                setup_rating = get_score_rating(setup_score)
                
                // Only take trades that meet minimum score requirement
                if setup_score < min_score_for_trade
                    continue
                
                // Calculate TP using Updated Rules
                float take_profit_price = na
                
                // Reset BE variables
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false

                if use_take_profit and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    
                    // Override with fixed RR
                    if use_fixed_rr
                        tp_r := fixed_rr_value
                        move_be := false
                        
                    // Apply double TP
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                        
                    if not na(tp_r)
                        take_profit_price := entry_price - (pip_distance * tp_r)
                        
                    // Store BE settings
                    if move_be and not use_fixed_rr
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl
                
                // Position sizing using TradingView-compatible formula
                balance  = account_size_usd
                risk_pct = risk_per_trade_pct
                
                // Calculate position size in UNITS directly (matches TradingView Position Tool)
                float qty_units_raw = calc_pos_size_units(entry_price, stop_loss_price, balance, risk_pct, true)

                if current_day_trades == 1 and max_trades_per_day == 2
                    qty_units_raw := qty_units_raw * 0.5

                // 🔥 ENTRY EXECUTION - ALL actions happen together
                int qty_units = int(math.round(qty_units_raw))
                if qty_units > 0 and not na(qty_units)
                    // 1. EXECUTE THE ENTRY (using close[1] as entry)
                    strategy.entry("Short Flip", strategy.short, qty = qty_units)
                    
                    // 2. ATTACH EXIT ORDERS
                    if not na(take_profit_price) and take_profit_price > 0
                        strategy.exit("Short Flip SL/TP", "Short Flip", stop = stop_loss_price, limit = take_profit_price)
                    else
                        strategy.exit("Short Flip SL", "Short Flip", stop = stop_loss_price)
                    
                    // 3. SET ACTIVE ENTRY ID
                    active_entry_id := "Short Flip"
                    
                    // 4. INCREMENT TRADE COUNT
                    current_day_trades += 1
                    
                    // 5. MARK ZONE AS USED
                    array.set(supplyZoneLastEntryBar, i, bar_index)
                    array.set(supplyActive, i, false)
                    
                    // 6. TRACK TRADE
                    trade_entry_price := entry_price
                    trade_original_sl := stop_loss_price
                    trade_current_sl := stop_loss_price
                    labels_created := false
                    tp1_hit := false
                    trade_tp1_price := na
                    if not na(stop_loss_price)
                        trade_original_sl_pips := (stop_loss_price - entry_price) / pip_size
                    if not na(take_profit_price) and take_profit_price < entry_price
                        trade_tp1_price := take_profit_price
                    
                    // 7. SHOW LABELS (inside entry block)
                    if show_entry_labels and not debug_mode
                        entry_text = show_score_labels ? "FLIP SHORT\nScore: " + str.tostring(setup_score, "#") + " (" + setup_rating + ")" : "FLIP SHORT"
                        label.new(x = bar_index, y = entry_price, text = entry_text,
                                  style = label.style_label_down, color = color.new(color.blue, 0),
                                  textcolor = color.white, size = size.normal)
                        
                        if not na(stop_loss_price)
                            sl_pips_display = not na(sl_pips) ? str.tostring(sl_pips, "#.##") + " pips" : "N/A"
                            label.new(x = bar_index, y = stop_loss_price,
                                      text = "SL: " + str.tostring(stop_loss_price, "#.####") + "\n(" + sl_pips_display + ")",
                                      style = label.style_label_left, color = color.new(color.red, 0),
                                      textcolor = color.white, size = size.normal)
                        
                        if not na(take_profit_price)
                            tp_rr_display = not na(sl_pips) and sl_pips > 0 ? str.tostring((entry_price - take_profit_price) / (stop_loss_price - entry_price), "#.##") + " RR" : "N/A"
                            label.new(x = bar_index, y = take_profit_price,
                                      text = "TP: " + str.tostring(take_profit_price, "#.####") + "\n(" + tp_rr_display + ")",
                                      style = label.style_label_left, color = color.new(color.green, 0),
                                      textcolor = color.white, size = size.normal)
                        
                        labels_created := true
                
                break

// === LONG ENTRY DETECTION ===
if tf_mode == "5" and barstate.isconfirmed and array.size(demandHighs) > 0 and allow_long_trades
    current_close = close
    current_open  = open
    current_low   = low
    is_bullish_close = current_close > current_open
    
    for i = 0 to array.size(demandHighs) - 1
        if array.get(demandActive, i)
            zoneHigh = array.get(demandHighs, i)
            zoneLow  = array.get(demandLows, i)
            // Unified demand entry validation (shared with flip entries)
            [can_enter, entryReason] = isValidDemandEntry(i)

            // === PERFORMANCE STATS: ENTRY CHECKS (DEMAND) ===
            stat_total_entry_checks += 1
            if not can_enter
                if str.contains(entryReason, "timing")
                    stat_entries_blocked_by_timing += 1
                if str.contains(entryReason, "liquidity") or str.contains(entryReason, "Liq ")
                    stat_entries_blocked_by_liquidity += 1

            // Debug label for demand zones – shown whenever debug_mode + showZoneDebug are enabled,
            // even if the zone has already been used, so you can inspect historical behaviour.
            // Full debug: optional per-zone label near price. Gated to avoid spam and
            // additionally filtered by recent-bar window.
            if debug_full and barstate.isconfirmed and showZoneDebug and isRecentBarForDebug()
                zone_uzid = i < array.size(demandZoneUZID) ? array.get(demandZoneUZID, i) : na
                sweep_bar_info   = i < array.size(demandZoneLiquiditySweptBarIndex) and not na(array.get(demandZoneLiquiditySweptBarIndex, i)) ? "Bar " + str.tostring(array.get(demandZoneLiquiditySweptBarIndex, i)) : "N/A"
                entry_after_sweep = i < array.size(demandZoneLiquiditySweptBarIndex) and not na(array.get(demandZoneLiquiditySweptBarIndex, i)) ? (bar_index >= array.get(demandZoneLiquiditySweptBarIndex, i) ? "✓" : "✗") : "N/A"
                // Opposite-candle count for this zone (used for 1-/2-candle liquidity logic)
                int oppCntDebug = 0
                if i < array.size(demandLiqCandles)
                    oppCntDebug := array.get(demandLiqCandles, i)
                debug_text = "Zone " + str.tostring(i) + (not na(zone_uzid) ? " (D-" + str.tostring(zone_uzid) + ")" : "") + ":\n"
                debug_text += "Opp Candles in Liq: " + (not na(oppCntDebug) ? str.tostring(oppCntDebug) : "N/A") + "\n"
                debug_text += "1-Candle Enabled: " + (useOneCandleLiquidity ? "Yes" : "No") + "\n"
                bool zoneCausedSweepDbg = i < array.size(demandZoneCausedSweep) ? array.get(demandZoneCausedSweep, i) : false
                bool liqValidDbg = i < array.size(demandZoneLiquidityValid) ? array.get(demandZoneLiquidityValid, i) : false
                bool liqSweptDbg = i < array.size(demandZoneLiquiditySwept) ? array.get(demandZoneLiquiditySwept, i) : false
                debug_text += "Zone Caused Sweep: " + (zoneCausedSweepDbg ? "✓" : "✗") + "\n"
                debug_text += "Liq Required: "   + (require_liquidity_sweep ? "Yes" : "No") + "\n"
                debug_text += "Liq Exists (rule): "     + (liqValidDbg ? "✓" : "✗") + "\n"
                debug_text += "Liq Swept: "      + (liqSweptDbg ? "✓" : "✗") + "\n"
                debug_text += "Sweep Bar: "      + sweep_bar_info + "\n"
                debug_text += "Entry > Sweep: "  + entry_after_sweep + "\n"
                debug_text += "Can Enter (all): "      + (can_enter ? "✓" : "✗") + "\n"
                debug_text += "Reason: " + entryReason
                label.new(x = bar_index, y = high, text = debug_text,
                          style = label.style_label_down, color = color.gray,
                          textcolor = color.white, size = size.small)

            if can_enter
                in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue

                entry_price = current_close

                float deepest_wick_in_zone = na
                for j = 0 to 5
                    if low[j] <= zoneHigh and low[j] >= zoneLow
                        if na(deepest_wick_in_zone) or low[j] < deepest_wick_in_zone
                            deepest_wick_in_zone := low[j]
                
                if na(deepest_wick_in_zone)
                    deepest_wick_in_zone := current_low

                float stop_loss_price   = na
                float take_profit_price = na

                if use_stop_loss
                    stop_loss_price := deepest_wick_in_zone - (stop_loss_buffer_pips * pip_size)

                float sl_pips = na
                if use_stop_loss and not na(stop_loss_price) and not na(entry_price)
                    sl_pips := (entry_price - stop_loss_price) / pip_size

                // Calculate TP using Updated Rules
                // Reset BE variables
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false

                if use_take_profit and not na(sl_pips) and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    
                    // Override with fixed RR
                    if use_fixed_rr
                        tp_r := fixed_rr_value
                        move_be := false
                        
                    // Apply double TP
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                        
                    if not na(tp_r)
                        risk_amount = entry_price - stop_loss_price
                        take_profit_price := entry_price + (risk_amount * tp_r)
                        
                    // Store BE settings
                    if move_be and not use_fixed_rr
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl

                if strategy.position_size == 0
                    // Position sizing using Script 1's formula
                    balance  = account_size_usd
                    risk_pct = risk_per_trade_pct
                    float qty_units_raw = calc_pos_size_units(entry_price, stop_loss_price, balance, risk_pct, false)

                    if current_day_trades == 1 and max_trades_per_day == 2
                        qty_units_raw := qty_units_raw * 0.5
                    
                    int qty_units = int(math.round(qty_units_raw))
                    if qty_units > 0 and not na(qty_units)
                        // === SETUP SCORING CHECK ===
                        // Calculate setup score before entering trade
                        setup_score = calculate_setup_score(true, i, zoneHigh, zoneLow, false, sl_pips)
                        setup_rating = get_score_rating(setup_score)
                        
                        // Only take trades that meet minimum score requirement
                        if setup_score >= min_score_for_trade
                            strategy.entry("Long", strategy.long, qty = qty_units)
                            
                            // mark usage
                            array.set(demandZoneLastEntryBar, i, bar_index)
                            last_global_long_entry_bar := bar_index

                            // Track zone type for performance stats
                            bool isAcc = i < array.size(demandZoneAccuracy) ? array.get(demandZoneAccuracy, i) : false
                            trade_is_accuracy_zone := isAcc

                            // deactivate this zone and any overlapping zones so we never trade this block again
                            deactivateOverlappingDemandZones(zoneLow, zoneHigh)

                            active_entry_id := "Long"
                            current_day_trades += 1

                            trade_entry_price      := entry_price
                            trade_original_sl      := stop_loss_price
                            trade_current_sl       := stop_loss_price
                            labels_created         := false
                            tp1_hit                := false
                            
                            // Store score for tracking
                            trade_setup_score := setup_score
                        if not na(stop_loss_price)
                            trade_original_sl_pips := (entry_price - stop_loss_price) / pip_size
                        if not na(take_profit_price) and take_profit_price > entry_price
                            trade_tp1_price := take_profit_price

                        if use_stop_loss and not na(stop_loss_price) and not na(take_profit_price)
                            strategy.exit("Long SL/TP", "Long", stop = stop_loss_price, limit = take_profit_price)
                        else if use_stop_loss and not na(stop_loss_price)
                            strategy.exit("Long SL", "Long", stop = stop_loss_price)
                        else if use_take_profit and not na(take_profit_price)
                            strategy.exit("Long TP", "Long", limit = take_profit_price)

                        if show_entry_labels and not labels_created
                            entry_text = show_score_labels ? "ENTRY\nScore: " + str.tostring(setup_score, "#") + " (" + setup_rating + ")" : "ENTRY"
                            label.new(x = bar_index, y = entry_price, text = entry_text,
                                      style = label.style_label_up, color = color.new(color.green, 0),
                                      textcolor = color.white, size = size.normal)

                            if not na(stop_loss_price)
                                sl_pips_display = not na(sl_pips) ? str.tostring(sl_pips, "#.##") + " pips" : "N/A"
                                label.new(x = bar_index, y = stop_loss_price,
                                          text = "SL: " + str.tostring(stop_loss_price, "#.####") + "\n(" + sl_pips_display + ")",
                                          style = label.style_label_left, color = color.new(color.red, 0),
                                          textcolor = color.white, size = size.normal)

                            if not na(take_profit_price)
                                tp_rr_display = not na(sl_pips) and sl_pips > 0 ? str.tostring((take_profit_price - entry_price) / (entry_price - stop_loss_price), "#.##") + " RR" : "N/A"
                                label.new(x = bar_index, y = take_profit_price,
                                          text = "TP: " + str.tostring(take_profit_price, "#.####") + "\n(" + tp_rr_display + ")",
                                          style = label.style_label_left, color = color.new(color.green, 0),
                                          textcolor = color.white, size = size.normal)

                            labels_created := true
                break

// === SHORT ENTRY DETECTION ===
if tf_mode == "5" and barstate.isconfirmed and array.size(supplyHighs) > 0 and allow_short_trades
    current_close = close
    current_open  = open
    current_high  = high
    is_bearish_close = current_close < current_open
    
    for i = 0 to array.size(supplyHighs) - 1
        if array.get(supplyActive, i)
            zoneHigh = array.get(supplyHighs, i)
            zoneLow  = array.get(supplyLows, i)
            // Unified supply entry validation (shared with flip entries)
            [can_enter, entryReason] = isValidSupplyEntry(i)

            // Full debug: optional per-zone label near price. Gated to avoid spam and
            // additionally filtered by recent-bar window.
            if debug_full and array.get(supplyActive, i) and barstate.isconfirmed and isRecentBarForDebug()
                zone_uzid = i < array.size(supplyZoneUZID) ? array.get(supplyZoneUZID, i) : na
                sweep_bar_info   = i < array.size(supplyZoneLiquiditySweptBarIndex) and not na(array.get(supplyZoneLiquiditySweptBarIndex, i)) ? "Bar " + str.tostring(array.get(supplyZoneLiquiditySweptBarIndex, i)) : "N/A"
                entry_after_sweep = i < array.size(supplyZoneLiquiditySweptBarIndex) and not na(array.get(supplyZoneLiquiditySweptBarIndex, i)) ? (bar_index >= array.get(supplyZoneLiquiditySweptBarIndex, i) ? "✓" : "✗") : "N/A"
                debug_text = "Zone " + str.tostring(i) + (not na(zone_uzid) ? " (S-" + str.tostring(zone_uzid) + ")" : "") + ":\n"
                bool zoneCausedSweepDbg = i < array.size(supplyZoneCausedSweep) ? array.get(supplyZoneCausedSweep, i) : false
                bool liqExistsDbg = i < array.size(supplyZoneLiquidityValid) ? array.get(supplyZoneLiquidityValid, i) : false
                bool liqSweptDbg = i < array.size(supplyZoneLiquiditySwept) ? array.get(supplyZoneLiquiditySwept, i) : false
                debug_text += "Zone Caused Sweep: " + (zoneCausedSweepDbg ? "✓" : "✗") + "\n"
                debug_text += "Liq Required: "   + (require_liquidity_sweep ? "Yes" : "No") + "\n"
                debug_text += "Liq Exists: "     + (liqExistsDbg ? "✓" : "✗") + "\n"
                debug_text += "Liq Swept: "      + (liqSweptDbg ? "✓" : "✗") + "\n"
                debug_text += "Sweep Bar: "      + sweep_bar_info + "\n"
                debug_text += "Entry > Sweep: "  + entry_after_sweep + "\n"
                debug_text += "Can Enter: "      + (can_enter ? "✓" : "✗") + "\n"
                debug_text += "Reason: " + entryReason
                if not can_enter and showZoneDebug
                    label.new(x = bar_index, y = low, text = debug_text,
                              style = label.style_label_up, color = color.gray,
                              textcolor = color.white, size = size.small)

            if can_enter
                in_date_range = not enable_date_filter or (time >= start_date and time <= end_date)
                if not in_date_range
                    continue

                entry_price = current_close

                float highest_wick_in_zone = na
                for j = 0 to 5
                    if high[j] >= zoneLow and high[j] <= zoneHigh
                        if na(highest_wick_in_zone) or high[j] > highest_wick_in_zone
                            highest_wick_in_zone := high[j]
                
                if na(highest_wick_in_zone)
                    highest_wick_in_zone := current_high

                float stop_loss_price   = na
                float take_profit_price = na

                if use_stop_loss
                    stop_loss_price := highest_wick_in_zone + (stop_loss_buffer_pips * pip_size)

                float sl_pips = na
                if use_stop_loss and not na(stop_loss_price) and not na(entry_price)
                    sl_pips := (stop_loss_price - entry_price) / pip_size

                // Calculate TP using Updated Rules
                // Reset BE variables
                trade_be_trigger_rr := na
                trade_be_sl_pips := na
                trade_be_moved := false

                if use_take_profit and not na(sl_pips) and sl_pips > 0
                    [tp_r, be_trig, be_sl, move_be] = get_updated_sl_tp_rules(sl_pips)
                    
                    // Override with fixed RR
                    if use_fixed_rr
                        tp_r := fixed_rr_value
                        move_be := false
                        
                    // Apply double TP
                    if enable_double_tp
                        tp_r := tp_r * 2.0
                        
                    if not na(tp_r)
                        risk_amount = stop_loss_price - entry_price
                        take_profit_price := entry_price - (risk_amount * tp_r)
                        
                    // Store BE settings
                    if move_be and not use_fixed_rr
                        trade_be_trigger_rr := be_trig
                        trade_be_sl_pips := be_sl

                if strategy.position_size == 0
                    // Position sizing using Script 1's formula
                    balance  = account_size_usd
                    risk_pct = risk_per_trade_pct
                    float qty_units_raw = calc_pos_size_units(entry_price, stop_loss_price, balance, risk_pct, true)

                    if current_day_trades == 1 and max_trades_per_day == 2
                        qty_units_raw := qty_units_raw * 0.5
                    
                    int qty_units = int(math.round(qty_units_raw))
                    if qty_units > 0 and not na(qty_units)
                        // === SETUP SCORING CHECK ===
                        // Calculate setup score before entering trade
                        setup_score = calculate_setup_score(false, i, zoneHigh, zoneLow, false, sl_pips)
                        setup_rating = get_score_rating(setup_score)
                        
                        // Only take trades that meet minimum score requirement
                        if setup_score >= min_score_for_trade
                            strategy.entry("Short", strategy.short, qty = qty_units)
                            
                            // mark usage
                            array.set(supplyZoneLastEntryBar, i, bar_index)

                            array.set(supplyActive, i, false)

                            active_entry_id := "Short"
                            current_day_trades += 1

                            trade_entry_price      := entry_price
                            trade_original_sl      := stop_loss_price
                            trade_current_sl       := stop_loss_price
                            labels_created         := false
                            tp1_hit                := false
                            
                            // Store score for tracking
                            trade_setup_score := setup_score
                        if not na(stop_loss_price)
                            trade_original_sl_pips := (stop_loss_price - entry_price) / pip_size
                        if not na(take_profit_price) and take_profit_price < entry_price
                            trade_tp1_price := take_profit_price

                        if use_stop_loss and not na(stop_loss_price) and not na(take_profit_price)
                            strategy.exit("Short SL/TP", "Short", stop = stop_loss_price, limit = take_profit_price)
                        else if use_stop_loss and not na(stop_loss_price)
                            strategy.exit("Short SL", "Short", stop = stop_loss_price)
                        else if use_take_profit and not na(take_profit_price)
                            strategy.exit("Short TP", "Short", limit = take_profit_price)

                        if show_entry_labels and not labels_created
                            entry_text = show_score_labels ? "ENTRY\nScore: " + str.tostring(setup_score, "#") + " (" + setup_rating + ")" : "ENTRY"
                            label.new(x = bar_index, y = entry_price, text = entry_text,
                                      style = label.style_label_down, color = color.new(color.red, 0),
                                      textcolor = color.white, size = size.normal)

                            if not na(stop_loss_price)
                                sl_pips_display = not na(sl_pips) ? str.tostring(sl_pips, "#.##") + " pips" : "N/A"
                                label.new(x = bar_index, y = stop_loss_price,
                                          text = "SL: " + str.tostring(stop_loss_price, "#.####") + "\n(" + sl_pips_display + ")",
                                          style = label.style_label_left, color = color.new(color.red, 0),
                                          textcolor = color.white, size = size.normal)

                            if not na(take_profit_price)
                                tp_rr_display = not na(sl_pips) and sl_pips > 0 ? str.tostring((entry_price - take_profit_price) / (stop_loss_price - entry_price), "#.##") + " RR" : "N/A"
                                label.new(x = bar_index, y = take_profit_price,
                                          text = "TP: " + str.tostring(take_profit_price, "#.####") + "\n(" + tp_rr_display + ")",
                                          style = label.style_label_left, color = color.new(color.green, 0),
                                          textcolor = color.white, size = size.normal)

                            labels_created := true
                break

// =============================
// GLOBAL EXIT MANAGEMENT
// =============================
// CRITICAL: This section runs EVERY BAR when in a position to ensure SL/TP orders are always active
// TradingView requires exit orders to be submitted every bar - they do not persist automatically
if strategy.position_size != 0 and not na(active_entry_id) and not na(trade_current_sl) and trade_current_sl > 0
    // Validate SL based on position direction
    bool sl_valid = false
    if strategy.position_size > 0  // Long position
        sl_valid := not na(trade_entry_price) and trade_current_sl < trade_entry_price
    else if strategy.position_size < 0  // Short position
        sl_valid := not na(trade_entry_price) and trade_current_sl > trade_entry_price
    
    if sl_valid
        // Submit exit orders for the active entry
        if active_entry_id == "Long"
            if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                strategy.exit("Long SL/TP", "Long", stop = trade_current_sl, limit = trade_tp1_price)
            else
                strategy.exit("Long SL", "Long", stop = trade_current_sl)
        else if active_entry_id == "Long Flip"
            if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                strategy.exit("Long Flip SL/TP", "Long Flip", stop = trade_current_sl, limit = trade_tp1_price)
            else
                strategy.exit("Long Flip SL", "Long Flip", stop = trade_current_sl)
        else if active_entry_id == "Short"
            if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                strategy.exit("Short SL/TP", "Short", stop = trade_current_sl, limit = trade_tp1_price)
            else
                strategy.exit("Short SL", "Short", stop = trade_current_sl)
        else if active_entry_id == "Short Flip"
            if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                strategy.exit("Short Flip SL/TP", "Short Flip", stop = trade_current_sl, limit = trade_tp1_price)
            else
                strategy.exit("Short Flip SL", "Short Flip", stop = trade_current_sl)

// === BREAK-EVEN LOGIC (Updated Rules) ===
if strategy.position_size != 0 and not na(trade_entry_price) and not na(trade_original_sl_pips) and not na(active_entry_id) and not trade_be_moved
    // Check if BE rules apply
    if not na(trade_be_trigger_rr) and trade_be_trigger_rr > 0
        float current_profit_pips = 0.0
        float current_profit_rr = 0.0
        
        if strategy.position_size > 0  // Long
            current_profit_pips := (close - trade_entry_price) / pip_size
        else if strategy.position_size < 0  // Short
            current_profit_pips := (trade_entry_price - close) / pip_size
        
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0
        
        // Check if we've reached the BE trigger RR level
        if current_profit_rr >= trade_be_trigger_rr
            float new_be_sl = na
            float profit_lock_pips = 0.0
            
            // Logic: 
            // If trade_be_sl_pips > 0 (The <= 3 pip case), lock in Max(1R, 2 pips)
            // Else (The normal BE case), lock in 0 pips (Entry)
            if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                profit_lock_pips := math.max(trade_original_sl_pips, trade_be_sl_pips)
            else
                profit_lock_pips := 0.0
            
            if strategy.position_size > 0  // Long
                new_be_sl := trade_entry_price + (profit_lock_pips * pip_size)
            else if strategy.position_size < 0  // Short
                new_be_sl := trade_entry_price - (profit_lock_pips * pip_size)
            
            // Update SL to BE
            if not na(new_be_sl) and new_be_sl > 0
                trade_current_sl := new_be_sl
                trade_be_moved := true
                
                // Update exit orders with new BE SL
                if active_entry_id == "Long"
                    if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                        strategy.exit("Long SL/TP", "Long", stop = new_be_sl, limit = trade_tp1_price)
                    else
                        strategy.exit("Long SL", "Long", stop = new_be_sl)
                else if active_entry_id == "Long Flip"
                    if not na(trade_tp1_price) and trade_tp1_price > trade_entry_price
                        strategy.exit("Long Flip SL/TP", "Long Flip", stop = new_be_sl, limit = trade_tp1_price)
                    else
                        strategy.exit("Long Flip SL", "Long Flip", stop = new_be_sl)
                else if active_entry_id == "Short"
                    if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                        strategy.exit("Short SL/TP", "Short", stop = new_be_sl, limit = trade_tp1_price)
                    else
                        strategy.exit("Short SL", "Short", stop = new_be_sl)
                else if active_entry_id == "Short Flip"
                    if not na(trade_tp1_price) and trade_tp1_price < trade_entry_price
                        strategy.exit("Short Flip SL/TP", "Short Flip", stop = new_be_sl, limit = trade_tp1_price)
                    else
                        strategy.exit("Short Flip SL", "Short Flip", stop = new_be_sl)

// === CHECK IF TP1 IS HIT ===
if strategy.position_size != 0 and not na(trade_tp1_price) and not tp1_hit
    bool tp_hit = false
    if strategy.position_size > 0  // Long
        tp_hit := close >= trade_tp1_price
    else if strategy.position_size < 0  // Short
        tp_hit := close <= trade_tp1_price
    
    if tp_hit
        tp1_hit := true
        
        // Special case: For SL ≥ 11.1 pips, close full at 1:2 (no BE move)
        if false  // jpy_close_at_2r functionality removed
            if active_entry_id == "Long"
                strategy.close("Long", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Long Flip"
                strategy.close("Long Flip", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Short"
                strategy.close("Short", comment = "Close at 1:2 (JPY Rule)")
            else if active_entry_id == "Short Flip"
                strategy.close("Short Flip", comment = "Close at 1:2 (JPY Rule)")
        else
            // Move to break-even if enabled (standard BE mode)
            if use_break_even and not na(trade_entry_price) and trade_entry_price > 0 and not na(active_entry_id)
                if active_entry_id == "Long"
                    strategy.exit("Long BE", "Long", stop = trade_entry_price)
                else if active_entry_id == "Long Flip"
                    strategy.exit("Long Flip BE", "Long Flip", stop = trade_entry_price)
                else if active_entry_id == "Short"
                    strategy.exit("Short BE", "Short", stop = trade_entry_price)
                else if active_entry_id == "Short Flip"
                    strategy.exit("Short Flip BE", "Short Flip", stop = trade_entry_price)

// === 2025 TRAILING STOP LOGIC (1-MINUTE TRAILING AFTER TP1) ===
if strategy.position_size != 0 and use_stop_loss and not na(trade_entry_price) and not na(trade_original_sl) and not na(trade_original_sl_pips) and not na(active_entry_id)
    float risk_amount = 0.0
    float current_profit_pips = 0.0
    float current_profit_rr = 0.0
    
    if strategy.position_size > 0  // Long
        risk_amount := trade_entry_price - trade_original_sl
        current_profit_pips := (close - trade_entry_price) / pip_size
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0
    else if strategy.position_size < 0  // Short
        risk_amount := trade_original_sl - trade_entry_price
        current_profit_pips := (trade_entry_price - close) / pip_size
        current_profit_rr := trade_original_sl_pips != 0 ? current_profit_pips / trade_original_sl_pips : 0

    // Hard close at R=10 - use active_entry_id for correct close
    if current_profit_rr >= 10.0
        if active_entry_id == "Long"
            strategy.close("Long", comment = "Hard Close at 1:10")
        else if active_entry_id == "Long Flip"
            strategy.close("Long Flip", comment = "Hard Close at 1:10")
        else if active_entry_id == "Short"
            strategy.close("Short", comment = "Hard Close at 1:10")
        else if active_entry_id == "Short Flip"
            strategy.close("Short Flip", comment = "Hard Close at 1:10")

    float new_sl = na
    bool should_update_sl = false
    
    // 2025: 1-minute trailing stop after TP1 is hit (only if not JPY close-at-2R rule)
    if tp1_hit and false  // jpy_close_at_2r functionality removed
        // Get 1-minute data for trailing
        [one_min_close, one_min_open, one_min_high, one_min_low] = request.security(syminfo.tickerid, "1", [close, open, high, low], lookahead = barmerge.lookahead_off)
        
        // Declare candidate_sl with type
        float candidate_sl = na
        
        if strategy.position_size > 0  // Long position
            // Trail SL under each bullish 1m candle
            if one_min_close > one_min_open
                // Bullish 1m candle - trail under low
                candidate_sl := one_min_low
            else if one_min_close < one_min_open
                // Bearish 1m candle - for large candles, trail halfway
                candle_size = one_min_high - one_min_low
                large_candle_threshold = math.abs(trade_entry_price - trade_original_sl) * 0.5  // 50% of initial risk
                if candle_size > large_candle_threshold
                    candidate_sl := one_min_low + (candle_size * 0.5)  // Halfway inside
                else
                    candidate_sl := one_min_low
            else
                // Doji or equal open/close - trail under low
                candidate_sl := one_min_low
            
            // Only move SL up, never down (and respect JPY BE minimum SL if set)
            if not na(candidate_sl)
                // For trades with minimum locked profit requirement, ensure we don't go below it
                if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                    min_sl_price = trade_entry_price + (trade_be_sl_pips * pip_size)
                    candidate_sl := math.max(candidate_sl, min_sl_price)
                
                if na(trade_current_sl) or candidate_sl > trade_current_sl
                    new_sl := candidate_sl
                    should_update_sl := true
        else if strategy.position_size < 0  // Short position
            // Trail SL above each bearish 1m candle
            if one_min_close < one_min_open
                // Bearish 1m candle - trail above high
                candidate_sl := one_min_high
            else if one_min_close > one_min_open
                // Bullish 1m candle - for large candles, trail halfway inside
                candle_size = one_min_high - one_min_low
                large_candle_threshold = math.abs(trade_original_sl - trade_entry_price) * 0.5  // 50% of initial risk
                if candle_size > large_candle_threshold
                    candidate_sl := one_min_high - (candle_size * 0.5)  // Halfway inside
                else
                    candidate_sl := one_min_high
            else
                // Doji or equal open/close - trail above high
                candidate_sl := one_min_high
            
            // Only move SL down, never up (and respect JPY BE minimum SL if set)
            if not na(candidate_sl)
                // For trades with minimum locked profit requirement, ensure we don't go above it
                if not na(trade_be_sl_pips) and trade_be_sl_pips > 0
                    max_sl_price = trade_entry_price - (trade_be_sl_pips * pip_size)
                    candidate_sl := math.min(candidate_sl, max_sl_price)
                
                if na(trade_current_sl) or candidate_sl < trade_current_sl
                    new_sl := candidate_sl
                    should_update_sl := true
    else
        // No trailing active - check if we need to update SL for other reasons
        if strategy.position_size > 0  // Long: move SL up
            should_update_sl := na(trade_current_sl) or new_sl > trade_current_sl
        else if strategy.position_size < 0  // Short: move SL down
            should_update_sl := na(trade_current_sl) or new_sl < trade_current_sl
    
    if should_update_sl and (tp1_hit or not trade_be_moved)
        if active_entry_id == "Long"
            strategy.exit("Long Trailing", "Long", stop = new_sl)
        else if active_entry_id == "Long Flip"
            strategy.exit("Long Flip Trailing", "Long Flip", stop = new_sl)
        else if active_entry_id == "Short"
            strategy.exit("Short Trailing", "Short", stop = new_sl)
        else if active_entry_id == "Short Flip"
            strategy.exit("Short Flip Trailing", "Short Flip", stop = new_sl)
        trade_current_sl := new_sl

// Reset trade tracking when position is closed
if strategy.position_size == 0
    // If we just closed a trade, compute realized RR and update performance stats
    if not na(trade_entry_price) and not na(trade_original_sl)
        float risk = trade_entry_price - trade_original_sl
        float rr   = risk != 0 ? (close - trade_entry_price) / risk : na

        if not na(rr)
            // Win/Loss by zone type
            if trade_is_accuracy_zone
                stat_trades_accuracy_total += 1
                if rr > 0
                    stat_trades_accuracy_wins += 1
                else if rr < 0
                    stat_trades_accuracy_losses += 1
            else
                stat_trades_normal_total += 1
                if rr > 0
                    stat_trades_normal_wins += 1
                else if rr < 0
                    stat_trades_normal_losses += 1

            // RR by symbol bucket
            bucket = get_symbol_bucket()
            if bucket == "XAU"
                stat_rr_sum_xau += rr
                stat_rr_count_xau += 1
            else if bucket == "JPY"
                stat_rr_sum_jpy += rr
                stat_rr_count_jpy += 1
            else
                stat_rr_sum_other += rr
                stat_rr_count_other += 1

    // Reset tracking variables
    trade_entry_price      := na
    trade_original_sl      := na
    trade_original_sl_pips := na
    trade_current_sl       := na
    labels_created         := false
    tp1_hit                := false
    trade_tp1_price        := na
    active_entry_id        := na
    trade_is_accuracy_zone := false
    // Reset BE tracking
    trade_be_trigger_rr      := na
    trade_be_sl_pips         := na
    trade_be_moved := false

// === LIQUIDITY LINES CONTROL ===
// Extend lines forward while not crossed; when swept, recolor and stop extending
_controlLine(_lines, _activeFlags, __high, __low) =>
    sz = array.size(_lines)
    if sz > 0
        for i = 0 to sz - 1
            lineRef  = array.get(_lines, i)
            bool isActive = i < array.size(_activeFlags) ? array.get(_activeFlags, i) : false
            float y1 = line.get_y1(lineRef)
            float y2 = line.get_y2(lineRef)
            float lvlLow = math.min(y1, y2)
            float lvlHigh = math.max(y1, y2)
            // Add tolerance for sweep detection (0.1 pip tolerance)
            float tolerance = pip_size * 0.1
            bool isCrossed = (__high >= lvlLow - tolerance and __low <= lvlLow + tolerance) or (__high >= lvlHigh - tolerance and __low <= lvlHigh + tolerance)
            // If active and crossed first time → mark as swept & recolor
            if isActive and isCrossed
                line.set_color(lineRef, color.new(color.purple, 0))
                if i < array.size(_activeFlags)
                    array.set(_activeFlags, i, false)
                // Optional: Add label to show sweep point
                if debug_full and barstate.isconfirmed
                    label.new(x = bar_index, y = lvlLow, text = "SWEPT", color = color.yellow, textcolor = color.black, size = size.tiny)
            // Extend unswept lines to current bar+1
            if isActive and (not isCrossed) and bar_index >= line.get_x1(lineRef)
                line.set_x2(lineRef, bar_index + 1)

// === VISUAL LIQUIDITY LINES (same style as standalone Liquidity indicator) ===
// Use pivot lows/highs as liquidity bottoms/tops and recolor when swept.

// Pivot LOW → bottom liquidity line (use confirmed fractal low)
if not na(pLow_raw) and plotLiq
    int  pBar  = bar_index - liq_pivot_len
    float pLow = pLow_raw
    lowLine = line.new(x1 = pBar, y1 = pLow, x2 = bar_index, y2 = pLow,
                       extend = extend.none, color = pvtBtmColor, style = pvtStyle, xloc = xloc.bar_index)
    if array.size(_lowLiqLines) >= pvtMax
        line.delete(array.shift(_lowLiqLines))
        if array.size(_lowLiqActive) > 0
            array.shift(_lowLiqActive)
    array.push(_lowLiqLines, lowLine)
    array.push(_lowLiqActive, true)

// Pivot HIGH → top liquidity line (use confirmed fractal high)
if not na(pHigh_raw) and plotLiq
    int  pBar  = bar_index - liq_pivot_len
    float pHigh = pHigh_raw
    highLine = line.new(x1 = pBar, y1 = pHigh, x2 = bar_index, y2 = pHigh,extend = extend.none, color = pvtTopColor, style = pvtStyle, xloc = xloc.bar_index)
    if array.size(_highLiqLines) >= pvtMax
        line.delete(array.shift(_highLiqLines))
        if array.size(_highLiqActive) > 0
            array.shift(_highLiqActive)
    array.push(_highLiqLines, highLine)
    array.push(_highLiqActive, true)

if plotLiq
    _controlLine(_lowLiqLines, _lowLiqActive, high, low)
    _controlLine(_highLiqLines, _highLiqActive, high, low)

// === DEBUG TABLE ===
var table debugTable = na

// Full debug level: show global debug panel, but only on the most recent N bars
// to avoid heavy calculations on deep history.
if debug_full and isRecentBarForDebug()
    if na(debugTable)
        debugTable := table.new(position.top_right, 2, 10, 
                                 bgcolor = color.new(color.rgb(30, 35, 40), 5), 
                                 border_width = 1, 
                                 border_color = color.new(color.white, 70), 
                                 frame_width = 1, 
                                 frame_color = color.new(color.white, 70))
    
    if not na(debugTable) and barstate.isconfirmed
        // Find closest active zone
        float closestDemandDist = na
        int closestDemandIdx = na
        float closestSupplyDist = na
        int closestSupplyIdx = na
        float currentPrice = close
        
        // Find closest demand zone
        if array.size(demandHighs) > 0
            for i = 0 to array.size(demandHighs) - 1
                if array.get(demandActive, i)
                    zoneHigh = array.get(demandHighs, i)
                    dist = math.abs(currentPrice - zoneHigh)
                    if na(closestDemandDist) or dist < closestDemandDist
                        closestDemandDist := dist
                        closestDemandIdx := i
        
        // Find closest supply zone
        if array.size(supplyLows) > 0
            for i = 0 to array.size(supplyLows) - 1
                if array.get(supplyActive, i)
                    zoneLow = array.get(supplyLows, i)
                    dist = math.abs(currentPrice - zoneLow)
                    if na(closestSupplyDist) or dist < closestSupplyDist
                        closestSupplyDist := dist
                        closestSupplyIdx := i
        
        // Determine closest zone overall
        string closestType = "None"
        int closestIdx = na
        float closestDist = na
        bool isClosestDemand = false
        
        if not na(closestDemandDist) and not na(closestSupplyDist)
            if closestDemandDist < closestSupplyDist
                closestType := "Demand"
                closestIdx := closestDemandIdx
                closestDist := closestDemandDist
                isClosestDemand := true
            else
                closestType := "Supply"
                closestIdx := closestSupplyIdx
                closestDist := closestSupplyDist
                isClosestDemand := false
        else if not na(closestDemandDist)
            closestType := "Demand"
            closestIdx := closestDemandIdx
            closestDist := closestDemandDist
            isClosestDemand := true
        else if not na(closestSupplyDist)
            closestType := "Supply"
            closestIdx := closestSupplyIdx
            closestDist := closestSupplyDist
            isClosestDemand := false
        
        // Get zone details if found
        string zoneState = "N/A"
        string accuracyStatus = "N/A"
        string liqValidStatus = "N/A"
        bool isAccuracy = false
        bool liqValid = false
        bool liqExists = false
        float zoneEntryPrice = na
        float zoneLow = na
        float zoneHigh = na
        
        if not na(closestIdx)
            if isClosestDemand
                zoneHigh := array.get(demandHighs, closestIdx)
                zoneLow := array.get(demandLows, closestIdx)
                zoneEntryPrice := zoneHigh
                leftZone = array.get(demandLeftZone, closestIdx)
                zoneState := leftZone ? "Tapped" : "Untapped"
                
                // Accuracy zone
                isAccuracy := array.get(demandZoneAccuracy, closestIdx)
                accuracyStatus := isAccuracy ? "Accuracy Adjusted" : "Normal"
                
                // Liquidity validation
                liqValid := array.get(demandZoneLiquidityValid, closestIdx)
                liqExists := not na(array.get(demandZoneLiquidity, closestIdx))
                liqValidStatus := liqExists ? (liqValid ? "Yes" : "No") : "N/A"
            else
                zoneHigh := array.get(supplyHighs, closestIdx)
                zoneLow := array.get(supplyLows, closestIdx)
                zoneEntryPrice := zoneLow
                leftZone = array.get(supplyLeftZone, closestIdx)
                zoneState := leftZone ? "Tapped" : "Untapped"
                
                // Accuracy zone
                isAccuracy := array.get(supplyZoneAccuracy, closestIdx)
                accuracyStatus := isAccuracy ? "Accuracy Adjusted" : "Normal"
                
                // Liquidity validation (not tracked for supply yet)
                liqValidStatus := "N/A"
        
        // Check entry allowed (timing filters)
        bool entryAllowed = true
        if enable_timing_filters
            time_to_30m = get_time_to_next_30m()
            time_to_1h = get_time_to_next_1h()
            // Note: red news check would go here if implemented
            entryAllowed := (time_to_30m >= 5) and (time_to_1h >= 10)
        
        // Check flip entry available
        bool flipAvailable = false
        if enable_flip_entry and is_new_30m_candle
            flipAvailable := true
        
        // Header row (row 0) - spans both columns visually
        table.cell(debugTable, 0, 0, "🔍 DEBUG PANEL", text_color = color.white, bgcolor = color.rgb(45, 50, 55), text_size = size.normal, text_halign = text.align_left)
        table.cell(debugTable, 1, 0, "", bgcolor = color.rgb(45, 50, 55))
        
        // Row 1: Closest Zone Type
        table.cell(debugTable, 0, 1, "Zone Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        typeColor = closestType == "Demand" ? color.green : (closestType == "Supply" ? color.red : color.rgb(200, 200, 200))
        table.cell(debugTable, 1, 1, closestType, text_color = typeColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 2: Zone UZID (permanent unique ID)
        int closestZoneUZID = na
        if not na(closestIdx)
            if isClosestDemand and closestIdx < array.size(demandZoneUZID)
                closestZoneUZID := array.get(demandZoneUZID, closestIdx)
            else if not isClosestDemand and closestIdx < array.size(supplyZoneUZID)
                closestZoneUZID := array.get(supplyZoneUZID, closestIdx)
        table.cell(debugTable, 0, 2, "Zone UZID", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        uzidStr = not na(closestZoneUZID) ? str.tostring(closestZoneUZID) : "N/A"
        table.cell(debugTable, 1, 2, uzidStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 3: Zone Range
        table.cell(debugTable, 0, 3, "Zone Range", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        zoneRangeStr = (not na(zoneLow) and not na(zoneHigh)) ? str.format("{0} → {1}", str.tostring(zoneLow, format.mintick), str.tostring(zoneHigh, format.mintick)) : "N/A"
        table.cell(debugTable, 1, 3, zoneRangeStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 4: Distance to Price
        table.cell(debugTable, 0, 4, "Distance", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        distPips = not na(closestDist) ? str.tostring(math.round(closestDist / pip_size * 10) / 10, "#.#") + " pips" : "N/A"
        table.cell(debugTable, 1, 4, distPips, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 5: Zone State
        table.cell(debugTable, 0, 5, "Zone State", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        stateColor = getZoneStateColor(zoneState)
        table.cell(debugTable, 1, 5, zoneState, text_color = stateColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 6: Accuracy Zone
        table.cell(debugTable, 0, 6, "Accuracy Zone", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        accColor = getAccuracyColor(accuracyStatus)
        accDisplay = accuracyStatus == "Accuracy Adjusted" ? "Yes" : "No"
        table.cell(debugTable, 1, 6, accDisplay, text_color = accColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 7: Liquidity Valid
        table.cell(debugTable, 0, 7, "Liquidity Valid", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        liqColor = getLiquidityColor(liqValidStatus)
        table.cell(debugTable, 1, 7, liqValidStatus, text_color = liqColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 8: Entry Allowed Now
        table.cell(debugTable, 0, 8, "Entry Allowed", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        entryStr = entryAllowed ? "Yes" : "No"
        entryColor = entryAllowed ? color.new(color.green, 0) : color.new(color.red, 0)
        table.cell(debugTable, 1, 8, entryStr, text_color = entryColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 9: Flip Entry Available
        table.cell(debugTable, 0, 9, "Flip Entry", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        flipStr = flipAvailable ? "Yes" : "No"
        flipColor = flipAvailable ? color.orange : color.rgb(200, 200, 200)
        table.cell(debugTable, 1, 9, flipStr, text_color = flipColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

// === ZONE INSPECTOR TABLE ===
var table zoneInspector = na

// Show Zone Inspector only when debug is enabled (Basic or Full), and only on
// the most recent N bars according to the debug_last_bars filter.
if showZoneInspector and debug_enabled and isRecentBarForDebug()
    if na(zoneInspector)
        zoneInspector := table.new(position.top_right, 2, 17, bgcolor = color.new(color.rgb(30, 35, 40), 5), border_width = 1, border_color = color.new(color.white, 70), frame_width = 1, frame_color = color.new(color.white, 70))
    
    if not na(zoneInspector) and barstate.isconfirmed
        // Get additional zone details for inspector
        string zoneInspectorType = "None"
        int zoneInspectorIdx = na
        float zoneInspectorLow = na
        float zoneInspectorHigh = na
        float zoneInspectorSizePips = na
        int barsSinceCreation = na
        string liqRequired = "N/A"
        string liqExistsInspector = "N/A"
        string liqCandlesCountInspector = "N/A"
        string liqSweptInspector = "N/A"
        string sweepBarIdx = "N/A"
        string wickInZone = "N/A"
        string notClosedIn = "N/A"
        string bullishBearishClose = "N/A"
        string zoneUsedInspector = "N/A"
        string zoneCausedSweepInspector = "N/A"
        string entryAllowedInspector = "N/A"
        
        // === ALWAYS SELECT ZONE FROM MANUAL INPUT ===
        string manualInputClean = str.trim(manualZoneIdInput)
        string manualTypeHint = "Any"
        int manualZoneId = na
        if str.length(manualInputClean) > 0
            string working = manualInputClean
            string firstChar = str.upper(str.substring(working, 0, 1))
            if firstChar == "D" or firstChar == "S"
                manualTypeHint := firstChar == "D" ? "Demand" : "Supply"
                dashPos = str.pos(working, "-")
                if dashPos >= 0
                    working := str.substring(working, dashPos + 1, str.length(working))
                else
                    working := str.substring(working, 1, str.length(working))
            working := str.replace_all(working, " ", "")
            float parsedVal = str.tonumber(working)
            if not na(parsedVal)
                manualZoneId := int(math.round(parsedVal))
        
        int inspectIndex = na
        string inspectType = "None"
        if not na(manualZoneId)
            int demandIdxManual = na
            int supplyIdxManual = na
            if manualTypeHint == "Supply"
                supplyIdxManual := findSupplyZoneIndexByUZID(manualZoneId)
                if na(supplyIdxManual)
                    demandIdxManual := findDemandZoneIndexByUZID(manualZoneId)
            else if manualTypeHint == "Demand"
                demandIdxManual := findDemandZoneIndexByUZID(manualZoneId)
                if na(demandIdxManual)
                    supplyIdxManual := findSupplyZoneIndexByUZID(manualZoneId)
            else
                demandIdxManual := findDemandZoneIndexByUZID(manualZoneId)
                if na(demandIdxManual)
                    supplyIdxManual := findSupplyZoneIndexByUZID(manualZoneId)
            if not na(supplyIdxManual) and (manualTypeHint == "Supply" or na(demandIdxManual))
                inspectIndex := supplyIdxManual
                inspectType := "Supply"
            if not na(demandIdxManual) and inspectType == "None"
                inspectIndex := demandIdxManual
                inspectType := "Demand"
            if inspectType == "None" and not na(supplyIdxManual)
                inspectIndex := supplyIdxManual
                inspectType := "Supply"
        
        zoneInspectorIdx := inspectIndex
        zoneInspectorType := inspectType
        bool isInspectorDemand = inspectType == "Demand"
        
        // Get UZID for display (store for Zone ID row)
        int zoneInspectorUZID = na
        if not na(zoneInspectorIdx) and zoneInspectorType != "None"
            if isInspectorDemand and zoneInspectorIdx < array.size(demandZoneUZID)
                zoneInspectorUZID := array.get(demandZoneUZID, zoneInspectorIdx)
            else if not isInspectorDemand and zoneInspectorIdx < array.size(supplyZoneUZID)
                zoneInspectorUZID := array.get(supplyZoneUZID, zoneInspectorIdx)
        
        bool allowInactiveInspector = true
        bool inspectorZoneActive = false
        if not na(zoneInspectorIdx) and zoneInspectorType != "None"
            if isInspectorDemand and zoneInspectorIdx < array.size(demandActive)
                inspectorZoneActive := array.get(demandActive, zoneInspectorIdx)
            else if not isInspectorDemand and zoneInspectorIdx < array.size(supplyActive)
                inspectorZoneActive := array.get(supplyActive, zoneInspectorIdx)

        // Populate inspector fields if zone found
        if not na(zoneInspectorIdx) and zoneInspectorType != "None" and (inspectorZoneActive or allowInactiveInspector)
            if isInspectorDemand and zoneInspectorIdx < array.size(demandHighs) and zoneInspectorIdx < array.size(demandActive)
                zoneInspectorHigh := array.get(demandHighs, zoneInspectorIdx)
                zoneInspectorLow := array.get(demandLows, zoneInspectorIdx)
                
                // Zone Size in pips
                if not na(zoneInspectorLow) and not na(zoneInspectorHigh)
                    zoneInspectorSizePips := (zoneInspectorHigh - zoneInspectorLow) / pip_size
                
                // Bars Since Creation
                if zoneInspectorIdx < array.size(demandZoneCreatedBarIndex)
                    createdBarIdx = array.get(demandZoneCreatedBarIndex, zoneInspectorIdx)
                    if not na(createdBarIdx)
                        barsSinceCreation := bar_index - createdBarIdx
                
                // Liquidity Required
                liqRequired := require_liquidity_sweep ? "Yes" : "No"
                
                // Liquidity Exists (show count of opposite candles in band)
                // Get candle count from new array
                int oppCntInspector = 0
                if zoneInspectorIdx < array.size(demandLiqCandles)
                    oppCntInspector := array.get(demandLiqCandles, zoneInspectorIdx)
                
                float liqLevelInspector = na
                if zoneInspectorIdx < array.size(demandZoneLiquidity)
                    liqLevelInspector := array.get(demandZoneLiquidity, zoneInspectorIdx)
                
                // Derive "Liq Exists" by the same rule used in entry logic:
                // - 2+ candles in band  → always Yes
                // - 1 candle           → Yes only if one-candle mode enabled
                // - 0 candles → No
                int minCandles = useOneCandleLiquidity ? 1 : 2
                bool liqExistsBool = oppCntInspector >= minCandles
                
                string liqBaseStr = liqExistsBool ? "Yes" : "No"
                liqExistsInspector := liqBaseStr + " (" + str.tostring(oppCntInspector) + ")"
                
                // Store candle count for display in "Liq Candles" row
                liqCandlesCountInspector := str.tostring(oppCntInspector)
                
                // Liquidity Swept
                if zoneInspectorIdx < array.size(demandZoneLiquiditySwept)
                    liqSwept = array.get(demandZoneLiquiditySwept, zoneInspectorIdx)
                    liqSweptInspector := liqSwept ? "Yes" : "No"
                else
                    liqSweptInspector := "No"
                
                // Sweep Bar Index
                if zoneInspectorIdx < array.size(demandZoneLiquiditySweptBarIndex)
                    sweepBar = array.get(demandZoneLiquiditySweptBarIndex, zoneInspectorIdx)
                    sweepBarIdx := not na(sweepBar) ? str.tostring(sweepBar) : "N/A"
                else
                    sweepBarIdx := "N/A"
                
                // Wick In Zone (matches entry logic: checks current_low, low[1], and low[2])
                current_low_inspector = low
                wick_in_current = current_low_inspector <= zoneInspectorHigh and current_low_inspector >= zoneInspectorLow
                wick_in_prev1 = low[1] <= zoneInspectorHigh and low[1] >= zoneInspectorLow
                wick_in_prev2 = low[2] <= zoneInspectorHigh and low[2] >= zoneInspectorLow
                prev_bar_wicked_inspector = wick_in_current or wick_in_prev1 or wick_in_prev2
                wickInZone := prev_bar_wicked_inspector ? "Yes" : "No"
                
                // Not Closed In
                current_close_inspector = close
                price_not_closed_inside_inspector = current_close_inspector < zoneInspectorLow or current_close_inspector > zoneInspectorHigh
                notClosedIn := price_not_closed_inside_inspector ? "Yes" : "No"
                
                // Bullish/Bearish Close
                is_bullish_close_inspector = current_close_inspector > open
                bullishBearishClose := is_bullish_close_inspector ? "Bullish" : "Bearish"
                
                // Zone Used
                if zoneInspectorIdx < array.size(demandZoneLastEntryBar)
                    last_entry_bar = array.get(demandZoneLastEntryBar, zoneInspectorIdx)
                    zoneUsedInspector := not na(last_entry_bar) ? "Yes" : "No"
                else
                    zoneUsedInspector := "No"
                
                // Zone Caused Sweep (CRITICAL for entry)
                bool zoneCausedSweepInspectorBool = false
                if zoneInspectorIdx < array.size(demandZoneCausedSweep)
                    zoneCausedSweepInspectorBool := array.get(demandZoneCausedSweep, zoneInspectorIdx)
                zoneCausedSweepInspector := zoneCausedSweepInspectorBool ? "Yes" : "No"
                
                // Entry Allowed (check same conditions as actual entry logic - EXACT MATCH)
                bool entryAllowedInspectorBool = zoneCausedSweepInspectorBool  // CRITICAL: Must have zoneCausedSweep
                
                // Check liquidity timing (matches entry logic exactly)
                bool liqOkInspector = false
                if entryAllowedInspectorBool
                    if liqExistsInspector == "Yes" and liqSweptInspector == "Yes" and sweepBarIdx != "N/A"
                        sweepBarNum = str.tonumber(sweepBarIdx)
                        if not na(sweepBarNum)
                            liqOkInspector := bar_index > int(sweepBarNum)
                    else if not require_liquidity_sweep and zoneCausedSweepInspectorBool
                        liqOkInspector := true
                
                // Check all entry conditions (matching actual entry logic)
                if entryAllowedInspectorBool and liqOkInspector
                    // Timing filters
                    if enable_timing_filters
                        time_to_30m_inspector = get_time_to_next_30m()
                        time_to_1h_inspector = get_time_to_next_1h()
                        entryAllowedInspectorBool := (time_to_30m_inspector >= 5) and (time_to_1h_inspector >= 10)
                    
                    // Trades allowed today
                    entryAllowedInspectorBool := entryAllowedInspectorBool and trades_allowed_today()
                    
                    // Zone not already used (but show Yes if conditions met, even if used)
                    // We check this but don't block display if zone was used (entry already happened)
                    bool zoneNotUsed = (zoneUsedInspector == "No")
                    
                    // Wick in zone (current, bar[1], or bar[2])
                    bool wickOk = (wickInZone == "Yes")
                    
                    // Not closed inside
                    bool notClosedOk = (notClosedIn == "Yes")
                    
                    // Bullish close
                    bool bullishCloseOk = (bullishBearishClose == "Bullish")
                    
                    // Zone not mitigated
                    bool zoneNotMitigated = true
                    if zoneInspectorIdx < array.size(demandZoneMitigated)
                        zoneNotMitigated := not array.get(demandZoneMitigated, zoneInspectorIdx)
                    
                    // Zone freshness (24-hour check)
                    bool zoneIsFresh = true
                    if zoneInspectorIdx < array.size(demandZoneTime)
                        zoneTime = array.get(demandZoneTime, zoneInspectorIdx)
                        if not na(zoneTime)
                            zoneAgeMs = time - zoneTime
                            maxAgeMs = 24 * 60 * 60 * 1000
                            zoneIsFresh := zoneAgeMs <= maxAgeMs
                    
                    // Position size check (only if we have a position, this blocks entry)
                    bool noPosition = strategy.position_size == 0
                    
                    // Check if previous bar could have entered (for is_first_bullish_entry)
                    bool prevBarCouldEnter = false
                    if bar_index > 0
                        prevBarWicked = (low[1] <= zoneInspectorHigh and low[1] >= zoneInspectorLow) or 
                                       (low[2] <= zoneInspectorHigh and low[2] >= zoneInspectorLow) or 
                                       (low[3] <= zoneInspectorHigh and low[3] >= zoneInspectorLow)
                        prevBarNotClosed = close[1] < zoneInspectorLow or close[1] > zoneInspectorHigh
                        prevBarBullish = close[1] > open[1]
                        prevBarLiqOk = zoneCausedSweepInspectorBool and (not require_liquidity_sweep or (liqExistsInspector == "Yes" and liqSweptInspector == "Yes"))
                        prevBarCouldEnter := prevBarLiqOk and prevBarWicked and prevBarNotClosed and prevBarBullish
                    bool isFirstBullishEntry = not prevBarCouldEnter
                    
                    // No entry this bar (check last_global_long_entry_bar)
                    bool noEntryThisBar = na(last_global_long_entry_bar) or bar_index > last_global_long_entry_bar
                    
                    // All conditions must be met (including Session Time)
                    bool inSessionInspector = is_in_session()
                    entryAllowedInspectorBool := entryAllowedInspectorBool and wickOk and notClosedOk and bullishCloseOk and zoneNotMitigated and zoneIsFresh and noPosition and isFirstBullishEntry and noEntryThisBar and inSessionInspector
                
                entryAllowedInspector := entryAllowedInspectorBool ? "Yes" : "No"
            else if not isInspectorDemand and zoneInspectorIdx < array.size(supplyHighs) and zoneInspectorIdx < array.size(supplyActive)
                zoneInspectorHigh := array.get(supplyHighs, zoneInspectorIdx)
                zoneInspectorLow := array.get(supplyLows, zoneInspectorIdx)
                
                // Zone Size in pips
                if not na(zoneInspectorLow) and not na(zoneInspectorHigh)
                    zoneInspectorSizePips := (zoneInspectorHigh - zoneInspectorLow) / pip_size
                
                // Bars Since Creation
                if zoneInspectorIdx < array.size(supplyZoneCreatedBarIndex)
                    createdBarIdx = array.get(supplyZoneCreatedBarIndex, zoneInspectorIdx)
                    if not na(createdBarIdx)
                        barsSinceCreation := bar_index - createdBarIdx
                
                // Liquidity Required
                liqRequired := require_liquidity_sweep ? "Yes" : "No"
                
                // Liquidity Exists (for supply, liquidity is BELOW zone)
                // Use the SAME 1/2-candle rule as entry logic:
                // - 2+ opposite candles in band  → always Yes
                // - 1 candle                    → Yes only if one-candle mode enabled
                // - 0 candles                   → No, even if a structural level exists
                float liqLevelInspector = na
                if zoneInspectorIdx < array.size(supplyZoneLiquidity)
                    liqLevelInspector := array.get(supplyZoneLiquidity, zoneInspectorIdx)
                
                // Get candle count from new array
                int oppCntInspector = 0
                if zoneInspectorIdx < array.size(supplyLiqCandles)
                    oppCntInspector := array.get(supplyLiqCandles, zoneInspectorIdx)
                
                // Derive "Liq Exists" by the same rule used in entry logic
                int minCandles = useOneCandleLiquidity ? 1 : 2
                bool liqExistsBool = oppCntInspector >= minCandles
                
                string liqBaseStr = liqExistsBool ? "Yes" : "No"
                liqExistsInspector := liqBaseStr + " (" + str.tostring(oppCntInspector) + ")"
                
                // Store candle count for display in "Liq Candles" row
                liqCandlesCountInspector := str.tostring(oppCntInspector)
                
                // Liquidity Swept
                if zoneInspectorIdx < array.size(supplyZoneLiquiditySwept)
                    liqSwept = array.get(supplyZoneLiquiditySwept, zoneInspectorIdx)
                    liqSweptInspector := liqSwept ? "Yes" : "No"
                else
                    liqSweptInspector := "No"
                
                // Sweep Bar Index
                if zoneInspectorIdx < array.size(supplyZoneLiquiditySweptBarIndex)
                    sweepBar = array.get(supplyZoneLiquiditySweptBarIndex, zoneInspectorIdx)
                    sweepBarIdx := not na(sweepBar) ? str.tostring(sweepBar) : "N/A"
                else
                    sweepBarIdx := "N/A"
                
                // Wick In Zone (matches entry logic: checks current_high, high[1], and high[2])
                current_high_inspector = high
                wick_in_current = current_high_inspector >= zoneInspectorLow and current_high_inspector <= zoneInspectorHigh
                wick_in_prev1 = high[1] >= zoneInspectorLow and high[1] <= zoneInspectorHigh
                wick_in_prev2 = high[2] >= zoneInspectorLow and high[2] <= zoneInspectorHigh
                prev_bar_wicked_inspector = wick_in_current or wick_in_prev1 or wick_in_prev2
                wickInZone := prev_bar_wicked_inspector ? "Yes" : "No"
                
                // Not Closed In
                current_close_inspector = close
                price_not_closed_inside_inspector = current_close_inspector < zoneInspectorLow or current_close_inspector > zoneInspectorHigh
                notClosedIn := price_not_closed_inside_inspector ? "Yes" : "No"
                
                // Bullish/Bearish Close
                is_bullish_close_inspector = current_close_inspector > open
                bullishBearishClose := is_bullish_close_inspector ? "Bullish" : "Bearish"
                
                // Zone Used
                if zoneInspectorIdx < array.size(supplyZoneLastEntryBar)
                    lastEntryBar = array.get(supplyZoneLastEntryBar, zoneInspectorIdx)
                    zoneUsedInspector := not na(lastEntryBar) ? "Yes" : "No"
                else
                    zoneUsedInspector := "No"
                
                // Zone Mitigated
                bool zoneMitigatedInspector = false
                if zoneInspectorIdx < array.size(supplyZoneMitigated)
                    zoneMitigatedInspector := array.get(supplyZoneMitigated, zoneInspectorIdx)
                
                // Zone Caused Sweep (CRITICAL for entry)
                bool zoneCausedSweepInspectorBool = false
                if zoneInspectorIdx < array.size(supplyZoneCausedSweep)
                    zoneCausedSweepInspectorBool := array.get(supplyZoneCausedSweep, zoneInspectorIdx)
                zoneCausedSweepInspector := zoneCausedSweepInspectorBool ? "Yes" : "No"
                
                // Entry Allowed (check same conditions as actual entry logic - EXACT MATCH)
                bool entryAllowedInspectorBool = false
                if zoneCausedSweepInspectorBool
                    // Zone caused sweep - entry allowed if timing is right
                    if liqExistsInspector == "Yes" and liqSweptInspector == "Yes" and sweepBarIdx != "N/A"
                        sweepBarNum = str.tonumber(sweepBarIdx)
                        if not na(sweepBarNum) and bar_index > int(sweepBarNum)
                            entryAllowedInspectorBool := true
                    else if not require_liquidity_sweep
                        entryAllowedInspectorBool := true  // Zone caused sweep but timing check not required
                
                // Check all entry conditions (matching actual entry logic)
                if entryAllowedInspectorBool
                    // Timing filters
                    if enable_timing_filters
                        time_to_30m_inspector = get_time_to_next_30m()
                        time_to_1h_inspector = get_time_to_next_1h()
                        entryAllowedInspectorBool := (time_to_30m_inspector >= 5) and (time_to_1h_inspector >= 10)
                    
                    // Trades allowed today
                    entryAllowedInspectorBool := entryAllowedInspectorBool and trades_allowed_today()
                    
                    // Zone not already used (but show Yes if conditions met, even if used)
                    bool zoneNotUsed = (zoneUsedInspector == "No")
                    
                    // Wick in zone (current, bar[1], or bar[2])
                    bool wickOk = (wickInZone == "Yes")
                    
                    // Not closed inside
                    bool notClosedOk = (notClosedIn == "Yes")
                    
                    // Bearish close
                    bool bearishCloseOk = (bullishBearishClose == "Bearish")
                    
                    // Zone not mitigated
                    bool zoneNotMitigated = not zoneMitigatedInspector
                    
                    // Zone freshness (24-hour check)
                    bool zoneIsFresh = true
                    if zoneInspectorIdx < array.size(supplyZoneTime)
                        zoneTime = array.get(supplyZoneTime, zoneInspectorIdx)
                        if not na(zoneTime)
                            zoneAgeMs = time - zoneTime
                            maxAgeMs = 24 * 60 * 60 * 1000
                            zoneIsFresh := zoneAgeMs <= maxAgeMs
                    
                    // Position size check (only if we have a position, this blocks entry)
                    bool noPosition = strategy.position_size == 0
                    
                    // Check if previous bar could have entered (for is_first_bearish_entry)
                    bool prevBarCouldEnter = false
                    if bar_index > 0
                        prevBarWicked = (high[1] >= zoneInspectorLow and high[1] <= zoneInspectorHigh) or 
                                       (high[2] >= zoneInspectorLow and high[2] <= zoneInspectorHigh) or 
                                       (high[3] >= zoneInspectorLow and high[3] <= zoneInspectorHigh)
                        prevBarNotClosed = close[1] > zoneInspectorHigh or close[1] < zoneInspectorLow
                        prevBarBearish = close[1] < open[1]
                        prevBarEntryAllowed = zoneCausedSweepInspectorBool and (not require_liquidity_sweep or (liqExistsInspector == "Yes" and liqSweptInspector == "Yes"))
                        prevBarCouldEnter := prevBarEntryAllowed and prevBarWicked and prevBarNotClosed and prevBarBearish
                    bool isFirstBearishEntry = not prevBarCouldEnter
                    
                    // All conditions must be met (including Session Time; zoneNotUsed is ignored for display)
                    bool inSessionInspector = is_in_session()
                    entryAllowedInspectorBool := entryAllowedInspectorBool and wickOk and notClosedOk and bearishCloseOk and zoneNotMitigated and zoneIsFresh and noPosition and isFirstBearishEntry and inSessionInspector
                
                entryAllowedInspector := allow_short_trades ? (entryAllowedInspectorBool ? "Yes" : "No") : "Shorts Disabled"
        
        // Header row (row 0)
        table.cell(zoneInspector, 0, 0, "🟫 ZONE INSPECTOR", text_color = color.white, bgcolor = color.rgb(45, 50, 55), text_size = size.normal, text_halign = text.align_left)
        table.cell(zoneInspector, 1, 0, "", bgcolor = color.rgb(45, 50, 55))
        
        // Row 1: Zone ID (UZID - permanent unique ID)
        table.cell(zoneInspector, 0, 1, "Zone ID", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        zoneIdStr = not na(zoneInspectorUZID) ? str.tostring(zoneInspectorUZID) : "N/A"
        table.cell(zoneInspector, 1, 1, zoneIdStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 2: Type
        table.cell(zoneInspector, 0, 2, "Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        typeColorInspector = zoneInspectorType == "Demand" ? color.green : (zoneInspectorType == "Supply" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 2, zoneInspectorType, text_color = typeColorInspector, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 3: Range
        table.cell(zoneInspector, 0, 3, "Range", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        rangeStrInspector = (not na(zoneInspectorLow) and not na(zoneInspectorHigh)) ? str.format("{0} → {1}", str.tostring(zoneInspectorLow, format.mintick), str.tostring(zoneInspectorHigh, format.mintick)) : "N/A"
        table.cell(zoneInspector, 1, 3, rangeStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 4: Zone Size
        table.cell(zoneInspector, 0, 4, "Zone Size", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        sizeStrInspector = not na(zoneInspectorSizePips) ? str.tostring(math.round(zoneInspectorSizePips * 10) / 10, "#.#") + " pips" : "N/A"
        table.cell(zoneInspector, 1, 4, sizeStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 5: Bars Since Creation
        table.cell(zoneInspector, 0, 5, "Bars Since", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        barsStrInspector = not na(barsSinceCreation) ? str.tostring(barsSinceCreation) : "N/A"
        table.cell(zoneInspector, 1, 5, barsStrInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 6: Liquidity Required
        table.cell(zoneInspector, 0, 6, "Liq Required", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        liqReqColor = liqRequired == "Yes" ? color.yellow : (liqRequired == "No" ? color.gray : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 6, liqRequired, text_color = liqReqColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 7: Liquidity Exists
        table.cell(zoneInspector, 0, 7, "Liq Exists", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        liqExistsColor = liqExistsInspector == "Yes" ? color.green : (liqExistsInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 7, liqExistsInspector, text_color = liqExistsColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 8: Liq Candles
        table.cell(zoneInspector, 0, 8, "Liq Candles", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(zoneInspector, 1, 8, liqCandlesCountInspector, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 9: Liquidity Swept
        table.cell(zoneInspector, 0, 9, "Liq Swept", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        liqSweptColor = liqSweptInspector == "Yes" ? color.green : (liqSweptInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 9, liqSweptInspector, text_color = liqSweptColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 10: Sweep Bar Index
        table.cell(zoneInspector, 0, 10, "Sweep Bar", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(zoneInspector, 1, 10, sweepBarIdx, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 11: Zone Caused Sweep (CRITICAL)
        table.cell(zoneInspector, 0, 11, "Zone Caused Sweep", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        zoneCausedSweepColor = zoneCausedSweepInspector == "Yes" ? color.green : (zoneCausedSweepInspector == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 11, zoneCausedSweepInspector, text_color = zoneCausedSweepColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 12: Wick In Zone
        table.cell(zoneInspector, 0, 12, "Wick In Zone", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        wickColor = wickInZone == "Yes" ? color.green : (wickInZone == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 12, wickInZone, text_color = wickColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 13: Not Closed In
        table.cell(zoneInspector, 0, 13, "Not Closed In", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        notClosedColor = notClosedIn == "Yes" ? color.green : (notClosedIn == "No" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 13, notClosedIn, text_color = notClosedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 14: Bullish/Bearish Close
        table.cell(zoneInspector, 0, 14, "Close Type", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        closeColor = bullishBearishClose == "Bullish" ? color.green : (bullishBearishClose == "Bearish" ? color.red : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 14, bullishBearishClose, text_color = closeColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 15: Zone Used
        table.cell(zoneInspector, 0, 15, "Zone Used", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        usedColor = zoneUsedInspector == "Yes" ? color.red : (zoneUsedInspector == "No" ? color.green : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 15, zoneUsedInspector, text_color = usedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 16: Entry Allowed
        table.cell(zoneInspector, 0, 16, "Entry Allowed", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        entryAllowedColor = entryAllowedInspector == "Yes" ? color.new(color.green, 0) : (entryAllowedInspector == "No" ? color.new(color.red, 0) : color.rgb(200, 200, 200))
        table.cell(zoneInspector, 1, 16, entryAllowedInspector, text_color = entryAllowedColor, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
else
    // Hide/delete Zone Inspector when flag is disabled
    if not na(zoneInspector)
        table.delete(zoneInspector)
        zoneInspector := na

// === POSITION SIZING TABLE (Enhanced with Validation Details) ===
var table posSizeTable = na

// Show position sizing table when debug is enabled (Full level) or when show_pos_sizing_table is enabled
if show_pos_sizing_table and debug_full and isRecentBarForDebug()
    if na(posSizeTable)
        posSizeTable := table.new(position.bottom_right, 2, 12, bgcolor = color.new(color.rgb(30, 35, 40), 5), border_width = 1, border_color = color.new(color.white, 70), frame_width = 1, frame_color = color.new(color.white, 70))
    
    if not na(posSizeTable) and barstate.isconfirmed
        // Use last calculated values if available, otherwise show example values
        bool hasLastValues = not na(last_pos_size_entry) and not na(last_pos_size_sl) and last_pos_size_valid
        
        float display_entry = hasLastValues ? last_pos_size_entry : close[1]
        float display_sl = hasLastValues ? last_pos_size_sl : (close[1] - (11.5 * pip_size))
        float display_balance = hasLastValues and not na(last_pos_size_balance) ? last_pos_size_balance : account_size_usd
        float display_risk_pct = hasLastValues and not na(last_pos_size_risk_pct) ? last_pos_size_risk_pct : risk_per_trade_pct
        int display_units = hasLastValues and not na(last_pos_size_units) ? last_pos_size_units : na
        float display_lots = hasLastValues and not na(last_pos_size_lots) ? last_pos_size_lots : na
        float display_sl_pips = hasLastValues and not na(last_pos_size_sl_pips) ? last_pos_size_sl_pips : 11.5
        float display_usdjpy = hasLastValues and not na(last_pos_size_usdjpy_rate) ? last_pos_size_usdjpy_rate : na
        bool display_valid = hasLastValues ? last_pos_size_valid : true
        string display_error = hasLastValues ? last_pos_size_error : ""
        bool display_dry_run = hasLastValues ? last_pos_size_dry_run : false
        
        // Calculate if not using last values
        if not hasLastValues
            float example_qty_units_raw = calc_pos_size_units(display_entry, display_sl, display_balance, display_risk_pct, false)
            display_units := int(math.round(example_qty_units_raw))
            display_lots := display_units / 100000.0
            
            // Get USDJPY rate
            if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                if str.contains(syminfo.ticker, "VANTAGE")
                    display_usdjpy := request.security("VANTAGE:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
                if na(display_usdjpy)
                    display_usdjpy := request.security("USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
                if na(display_usdjpy)
                    display_usdjpy := 150.0  // Fallback
            else if str.contains(syminfo.ticker, "USDJPY")
                display_usdjpy := display_entry
            else
                display_usdjpy := 1.0
        
        // Also fetch USDJPY rate if we have last values but rate is na
        if hasLastValues and na(display_usdjpy) and str.contains(syminfo.ticker, "JPY")
            if str.contains(syminfo.ticker, "JPY") and not str.contains(syminfo.ticker, "USDJPY")
                if str.contains(syminfo.ticker, "VANTAGE")
                    display_usdjpy := request.security("VANTAGE:USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
                if na(display_usdjpy)
                    display_usdjpy := request.security("USDJPY", timeframe.period, close, lookahead = barmerge.lookahead_off)
                if na(display_usdjpy)
                    display_usdjpy := 150.0  // Fallback
            else if str.contains(syminfo.ticker, "USDJPY")
                display_usdjpy := display_entry
            else
                display_usdjpy := 1.0
        
        // Format display values
        float risk_usd = display_balance * (display_risk_pct / 100)
        risk_usd_str = "$" + str.tostring(risk_usd, "#.##")
        qty_lots_str = not na(display_lots) ? str.tostring(display_lots, "#.####") + " lots" : "N/A"
        qty_units_str = not na(display_units) ? str.tostring(display_units, "#,###") + " units" : "N/A"
        sl_pips_str = str.tostring(display_sl_pips, "#.##") + " pips"
        rate_str = not na(display_usdjpy) and str.contains(syminfo.ticker, "JPY") ? str.tostring(display_usdjpy, "#.####") : (str.contains(syminfo.ticker, "JPY") ? "Failed" : "N/A")
        valid_str = display_valid ? "✓ Valid" : "✗ Invalid"
        valid_color = display_valid ? color.green : color.red
        error_str = display_error != "" ? display_error : "None"
        dry_run_str = display_dry_run ? "DRY RUN" : "Live"
        min_max_str = not na(display_units) ? str.tostring(min_position_size_units) + " - " + str.tostring(int(max_position_size_lots * 100000)) + " units" : "N/A"
        
        // Header
        headerText = display_dry_run ? "💰 POSITION SIZING (DRY RUN)" : "💰 POSITION SIZING"
        table.cell(posSizeTable, 0, 0, headerText, text_color = color.white, bgcolor = color.rgb(45, 50, 55), text_size = size.normal, text_halign = text.align_left)
        table.cell(posSizeTable, 1, 0, "", bgcolor = color.rgb(45, 50, 55))
        
        // Row 1: Validation Status
        table.cell(posSizeTable, 0, 1, "Validation", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 1, valid_str, text_color = valid_color, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 2: Risk Amount
        table.cell(posSizeTable, 0, 2, "Risk Amount", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 2, risk_usd_str, text_color = color.yellow, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 3: Position Size (Lots)
        table.cell(posSizeTable, 0, 3, "Position Size (Lots)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 3, qty_lots_str, text_color = color.green, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 4: Position Size (Units)
        table.cell(posSizeTable, 0, 4, "Position Size (Units)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 4, qty_units_str, text_color = color.green, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 5: Stop Loss (Pips)
        table.cell(posSizeTable, 0, 5, "Stop Loss", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 5, sl_pips_str, text_color = color.red, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 6: Entry Price
        table.cell(posSizeTable, 0, 6, "Entry Price", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 6, str.tostring(display_entry, format.mintick), text_color = color.blue, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 7: Stop Loss Price
        table.cell(posSizeTable, 0, 7, "Stop Loss Price", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 7, str.tostring(display_sl, format.mintick), text_color = color.red, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 8: USDJPY Rate (if applicable)
        if str.contains(syminfo.ticker, "JPY")
            rate_label = "USDJPY Rate"
            rate_color = not na(display_usdjpy) and display_usdjpy > 0 ? color.blue : color.red
            table.cell(posSizeTable, 0, 8, rate_label, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            table.cell(posSizeTable, 1, 8, rate_str, text_color = rate_color, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 9: Min/Max Limits
        table.cell(posSizeTable, 0, 9, "Size Limits", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        table.cell(posSizeTable, 1, 9, min_max_str, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 10: Error Message (if any)
        if not display_valid and display_error != ""
            table.cell(posSizeTable, 0, 10, "Error", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            table.cell(posSizeTable, 1, 10, error_str, text_color = color.red, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)
        
        // Row 11: Mode
        table.cell(posSizeTable, 0, 11, "Mode", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
        mode_color = display_dry_run ? color.orange : color.green
        table.cell(posSizeTable, 1, 11, dry_run_str, text_color = mode_color, bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

// === PERFORMANCE TABLE ===
performanceTable := draw_performance_table(performanceTable)
