showZoneInspector     = input.bool(true, "Enable Zone Inspector Panel", group = "Display Options", tooltip = "Show the Zone Inspector panel with detailed zone information (Debug Level must be Basic or Full).")
zoneInspectMode       = input.string("Closest Zone", "Zone Inspector Mode", options = ["Closest Zone", "Deepest Demand", "Highest Supply", "Manual Index"], group = "Strategy Settings", tooltip = "Choose which zone to inspect in the Zone Inspector panel")
manualZoneIdInput     = input.string("", "Manual Zone ID", group = "Strategy Settings", tooltip = "Enter the exact zone label (e.g., D-17428 or S-120) or just the numeric UZID to inspect that zone")

// === 2025 NEW INPUTS ===
max_trades_per_day = input.int(1, "Max Trades Per Day", minval = 1, maxval = 2, group = "Strategy Settings", tooltip = "Maximum number of trades per day. Second trade uses 0.5R risk if max=2")
use_break_even     = input.bool(false, "Use Break-Even Mode", group = "Strategy Settings", tooltip = "Move SL to entry after TP1 hits")
