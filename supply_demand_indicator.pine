            array.set(supplyLiqConnectorLines, idx, na)
        if idx < array.size(supplyLiqInfoLabels)
            label lb = array.get(supplyLiqInfoLabels, idx)
            if not na(lb)
                label.delete(lb)
            array.set(supplyLiqInfoLabels, idx, na)

