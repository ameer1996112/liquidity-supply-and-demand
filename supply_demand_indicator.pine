// Default to Asia/Jerusalem for Israel time
time_window_tz      = input.string("Asia/Jerusalem", "Time Window Timezone", options=["Asia/Jerusalem", "UTC+2", "UTC", "America/New_York", "Etc/GMT+5"], group = "Strategy Settings", tooltip = "Use 'Asia/Jerusalem' for Israel time (handles DST automatically).")
start_hour          = input.int(8, "Start Hour (0-23)", minval=0, maxval=23, group = "Strategy Settings")
end_hour            = input.int(19, "End Hour (0-23)", minval=0, maxval=23, group = "Strategy Settings", tooltip = "Trades allowed until this hour (e.g., 19 means trading stops at 19:00)")
