// === FRACTALS INPUT ===
fractalsPeriod = input.int(2, "Fractals Period (Williams)", minval = 2, group = "Williams Fractals")

plotLiq    = input.bool(defval = true, title = "Plot Liquidity", group = "Liquidity")
useOneCandleLiquidity = input.bool(true, "Enable 1-Candle Liquidity", group = "Liquidity", tooltip = "Allow 1-candle swings in addition to 2-candle swings for liquidity detection. When enabled, zones with 1 opposite candle will have Liq Exists = Yes. When disabled, requires 2+ candles.")
