        if idx < array.size(supplyBoxes)
            array.remove(supplyBoxes, idx)
        if idx < array.size(supplyLeftZone)
            array.remove(supplyLeftZone, idx)
        if idx < array.size(supplyZoneAccuracy)
            array.remove(supplyZoneAccuracy, idx)
        if idx < array.size(supplyZoneUZID)
            array.remove(supplyZoneUZID, idx)
        if idx < array.size(supplyZoneCreatedBarIndex)
            array.remove(supplyZoneCreatedBarIndex, idx)
        if idx < array.size(supplyZoneLiquidity)
            array.remove(supplyZoneLiquidity, idx)
        if idx < array.size(supplyZoneLiquiditySwept)
            array.remove(supplyZoneLiquiditySwept, idx)
        if idx < array.size(supplyZoneLiquidityBarIndex)
            array.remove(supplyZoneLiquidityBarIndex, idx)
        if idx < array.size(supplyZoneLiquiditySweptBarIndex)
            array.remove(supplyZoneLiquiditySweptBarIndex, idx)
        if idx < array.size(supplyZoneLastEntryBar)
            array.remove(supplyZoneLastEntryBar, idx)
        if idx < array.size(supplyZoneIsHistorical)
            array.remove(supplyZoneIsHistorical, idx)
        if idx < array.size(supplyZoneLiquidityValid)
            array.remove(supplyZoneLiquidityValid, idx)
        if idx < array.size(supplyLiqExists)
            array.remove(supplyLiqExists, idx)
        if idx < array.size(supplyLiqCandleCount)
            array.remove(supplyLiqCandleCount, idx)
        if idx < array.size(supplyLiqCandles)
            array.remove(supplyLiqCandles, idx)
        if idx < array.size(supplyZoneMitigated)
            array.remove(supplyZoneMitigated, idx)
        if idx < array.size(supplyZoneCausedSweep)
            array.remove(supplyZoneCausedSweep, idx)
        if idx < array.size(supplyZoneTime)
            array.remove(supplyZoneTime, idx)
        if idx < array.size(supplyZoneMitigationTime)
            array.remove(supplyZoneMitigationTime, idx)

// === TRADE TRACKING VARIABLES ===
var float trade_entry_price      = na
var float trade_original_sl      = na
var float trade_original_sl_pips = na
var float trade_current_sl       = na
var bool  labels_created         = false
var float trade_tp1_price        = na
var bool  tp1_hit                = false
var string active_entry_id       = na  // Tracks which entry is active: "Long" or "Long Flip"
var float trade_be_trigger_rr      = na  // RR level when to move SL to BE
var float trade_be_sl_pips         = na  // Minimum SL in pips when moving to BE
var bool  trade_be_moved           = false  // Track if BE move has been executed
var float trade_setup_score        = na  // Track setup score for current trade

// Track whether current trade originated from an accuracy zone
var bool  trade_is_accuracy_zone = false

// === PERFORMANCE STATISTICS ===
// Entry evaluation stats
var int stat_total_entry_checks            = 0
var int stat_entries_blocked_by_timing     = 0
var int stat_entries_blocked_by_liquidity  = 0

// Win rate by zone type (Accuracy vs Normal)
var int stat_trades_accuracy_total  = 0
var int stat_trades_accuracy_wins   = 0
var int stat_trades_accuracy_losses = 0

var int stat_trades_normal_total  = 0
var int stat_trades_normal_wins   = 0
var int stat_trades_normal_losses = 0

// Average RR by symbol type
var float stat_rr_sum_xau   = 0.0
var int   stat_rr_count_xau = 0

var float stat_rr_sum_jpy   = 0.0
var int   stat_rr_count_jpy = 0

var float stat_rr_sum_other   = 0.0
var int   stat_rr_count_other = 0

// Helper: safe percentage
safe_percent(num, denom) =>
    denom > 0 ? (num * 100.0) / denom : na

// Helper: bucket symbol type for RR stats
get_symbol_bucket() =>
    sym = syminfo.ticker
    if str.contains(sym, "XAU")
        "XAU"
    else if str.contains(sym, "JPY")
        "JPY"
    else
        "OTHER"

// === PERFORMANCE TABLE STATE & RENDERER ===
var table performanceTable = na

draw_performance_table(tbl) =>
    table result = tbl

    if show_performance_table and barstate.islastconfirmedhistory
        if na(result)
            result := table.new(position.bottom_left, 2, 10, bgcolor = color.new(color.rgb(30, 35, 40), 5),border_width = 1,border_color = color.new(color.white, 70), frame_width = 1,frame_color = color.new(color.white, 70))

        if not na(result)
            // Derived zone stats (using persistent counters for totals)
            float totalDemandZones = float(demand_zone_counter)
            float totalSupplyZones = float(supply_zone_counter)

            int demandWithLiq = 0
            int supplyWithLiq = 0
            int demandCausedSweep = 0
            int supplyCausedSweep = 0
            int demandMitigatedBeforeEntry = 0
            int supplyMitigatedBeforeEntry = 0

            // Scan demand zones
            if array.size(demandHighs) > 0
                for i = 0 to array.size(demandHighs) - 1
                    bool liqValid = i < array.size(demandZoneLiquidityValid) ? array.get(demandZoneLiquidityValid, i) : false
                    bool caused   = i < array.size(demandZoneCausedSweep) ? array.get(demandZoneCausedSweep, i) : false
                    bool mitig    = i < array.size(demandZoneMitigated) ? array.get(demandZoneMitigated, i) : false
                    int lastEntry = i < array.size(demandZoneLastEntryBar) ? array.get(demandZoneLastEntryBar, i) : na

                    if liqValid
                        demandWithLiq += 1
                    if caused
                        demandCausedSweep += 1
                    if mitig and na(lastEntry)
                        demandMitigatedBeforeEntry += 1

            // Scan supply zones
            if array.size(supplyHighs) > 0
                for i = 0 to array.size(supplyHighs) - 1
                    bool liqValid = i < array.size(supplyZoneLiquidityValid) ? array.get(supplyZoneLiquidityValid, i) : false
                    bool caused   = i < array.size(supplyZoneCausedSweep) ? array.get(supplyZoneCausedSweep, i) : false
                    bool mitig    = i < array.size(supplyZoneMitigated) ? array.get(supplyZoneMitigated, i) : false
                    int lastEntry = i < array.size(supplyZoneLastEntryBar) ? array.get(supplyZoneLastEntryBar, i) : na

                    if liqValid
                        supplyWithLiq += 1
                    if caused
                        supplyCausedSweep += 1
                    if mitig and na(lastEntry)
                        supplyMitigatedBeforeEntry += 1

            // Percent helpers
            demandLiqPct   = safe_percent(demandWithLiq,   totalDemandZones)
            supplyLiqPct   = safe_percent(supplyWithLiq,   totalSupplyZones)
            demandSweepPct = safe_percent(demandCausedSweep, totalDemandZones)
            supplySweepPct = safe_percent(supplyCausedSweep, totalSupplyZones)
            demandMitigPct = safe_percent(demandMitigatedBeforeEntry, totalDemandZones)
            supplyMitigPct = safe_percent(supplyMitigatedBeforeEntry, totalSupplyZones)

            timingBlockPct = safe_percent(stat_entries_blocked_by_timing,   stat_total_entry_checks)
            missLiqPct     = safe_percent(stat_entries_blocked_by_liquidity, stat_total_entry_checks)

            accWinPct  = safe_percent(stat_trades_accuracy_wins, stat_trades_accuracy_total)
            normWinPct = safe_percent(stat_trades_normal_wins,   stat_trades_normal_total)

            rrAvgXau   = stat_rr_count_xau   > 0 ? stat_rr_sum_xau   / stat_rr_count_xau   : na
            rrAvgJpy   = stat_rr_count_jpy   > 0 ? stat_rr_sum_jpy   / stat_rr_count_jpy   : na
            rrAvgOther = stat_rr_count_other > 0 ? stat_rr_sum_other / stat_rr_count_other : na

            // Header
            table.cell(result, 0, 0, "📊 PERFORMANCE", text_color = color.white, bgcolor = color.rgb(45, 50, 55), text_size = size.normal, text_halign = text.align_left)
            table.cell(result, 1, 0, "", bgcolor = color.rgb(45, 50, 55))

            // 1. Total Zones Created (Demand/Supply)
            table.cell(result, 0, 1, "1. Total Zones (D / S)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            zonesStr = str.tostring(totalDemandZones, "#") + " / " + str.tostring(totalSupplyZones, "#")
            table.cell(result, 1, 1, zonesStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

            // 2. Zones with Valid Liquidity (%)
            table.cell(result, 0, 2, "2. Zones w/ Liquidity % (D / S)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            liqStr = str.tostring(demandLiqPct, "#.##") + " / " + str.tostring(supplyLiqPct, "#.##")
            table.cell(result, 1, 2, liqStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

            // 3. Zones that Caused Sweep (%)
            table.cell(result, 0, 3, "3. Zones Caused Sweep % (D / S)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            sweepStr = str.tostring(demandSweepPct, "#.##") + " / " + str.tostring(supplySweepPct, "#.##")
            table.cell(result, 1, 3, sweepStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

            // 4. Zones Mitigated Before Entry (%)
            table.cell(result, 0, 4, "4. Mitigated Before Entry % (D / S)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            mitigStr = str.tostring(demandMitigPct, "#.##") + " / " + str.tostring(supplyMitigPct, "#.##")
            table.cell(result, 1, 4, mitigStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

            // 5. Entries Blocked by Timing (%)
            table.cell(result, 0, 5, "5. Entries Blocked by Timing %", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            table.cell(result, 1, 5, str.tostring(timingBlockPct, "#.##"), text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

            // 6. Entries Blocked by Missing Liquidity (%)
            table.cell(result, 0, 6, "6. Entries Blocked by Liquidity %", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            table.cell(result, 1, 6, str.tostring(missLiqPct, "#.##"), text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

            // 7. Win Rate by Zone Type (Accuracy vs Normal)
            table.cell(result, 0, 7, "7. Win Rate (Acc / Norm) %", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            winStr = str.tostring(accWinPct, "#.##") + " / " + str.tostring(normWinPct, "#.##")
            table.cell(result, 1, 7, winStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

            // 8. Average RR by Symbol Type (XAUUSD, JPY, Other)
            table.cell(result, 0, 8, "8. Avg RR (XAU / JPY / Other)", text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_right)
            rrStr = str.tostring(rrAvgXau, "#.##") + " / " + str.tostring(rrAvgJpy, "#.##") + " / " + str.tostring(rrAvgOther, "#.##")
            table.cell(result, 1, 8, rrStr, text_color = color.rgb(200, 200, 200), bgcolor = color.new(color.rgb(30, 35, 40), 5), text_halign = text.align_left)

    result

// === POSITION SIZING TRACKING (for debug table) ===
var int   last_pos_size_units    = na  // Last calculated position size in units
var float last_pos_size_lots     = na  // Last calculated position size in lots
var float last_pos_size_entry    = na  // Last entry price used for position sizing
var float last_pos_size_sl       = na  // Last stop loss used for position sizing
var float last_pos_size_balance  = na  // Last account balance used
var float last_pos_size_risk_pct = na  // Last risk percentage used
var float last_pos_size_sl_pips  = na  // Last SL in pips
var float last_pos_size_usdjpy_rate = na  // Last USDJPY rate (if applicable)
var bool  last_pos_size_valid    = false  // Whether last position size was valid
var string last_pos_size_error   = ""  // Last position size error message
var bool  last_pos_size_dry_run  = false  // Whether last sizing was in dry run mode

// Pending long entry (for next-bar execution, non-repainting)
var bool  long_signal_pending    = false
var float long_pending_sl_price  = na
var float long_pending_tp_price  = na
var float long_pending_sl_pips   = na
var string long_pending_entry_type = na  // Entry type: "DIR LONG", "BOC LONG", "FLIP LONG"

// Pending short entry (for next-bar execution, non-repainting)
var bool  short_signal_pending   = false
var float short_pending_sl_price = na
var float short_pending_tp_price = na
var float short_pending_sl_pips  = na

// One global guard: only one long entry per bar
var int last_global_long_entry_bar = na

// === TRADE PER DAY TRACKING ===
var int current_day_trades = 0
var int last_trade_day = na

// === TIMING FILTER FUNCTIONS ===
get_time_to_next_30m() =>
    current_minute = minute(time, "Etc/GMT+5")
    minutes_past_30 = current_minute % 30
    minutes_to_next = 30 - minutes_past_30
    minutes_to_next

get_time_to_next_1h() =>
    current_minute = minute(time, "Etc/GMT+5")
    minutes_to_hour = 60 - current_minute
    minutes_to_hour

is_blocked_by_timing() =>
    if not enable_timing_filters
        false
    else
        time_to_30m = get_time_to_next_30m()
        time_to_1h = get_time_to_next_1h()
        (time_to_30m < 5) or (time_to_1h < 10)

is_late_friday() =>
    day_of_week = dayofweek(time, "Etc/GMT+5")
    current_hour = hour(time, "Etc/GMT+5")
    day_of_week == dayofweek.friday and current_hour >= 20

is_in_session() =>
    if not use_time_window
        true
    else
        // Check hour in the selected timezone
        h = hour(time, time_window_tz)
        h >= start_hour and h < end_hour

// === TRADE PER DAY TRACKING (INLINE) ===
// Reset trade count if new day
current_day_start = time("D", "Etc/GMT+5")
if na(last_trade_day) or current_day_start != last_trade_day
    current_day_trades := 0
    last_trade_day := current_day_start

// Helper to check if trades allowed
trades_allowed_today() =>
    current_day_trades < max_trades_per_day

// === DEBUG TABLE COLOR CODING FUNCTIONS ===
getZoneStateColor(state) =>
    state == "Untapped" ? color.aqua : color.red

getAccuracyColor(status) =>
    status == "Accuracy Adjusted" ? color.yellow : color.rgb(200, 200, 200)

getLiquidityColor(status) =>
    status == "Yes" ? color.green : (status == "No" ? color.red : color.rgb(200, 200, 200))

// === AGGREGATION-BASED ZONE ARRAYS ===
var box[]        agg_supply_zone_boxes = array.new_box()
var box[]        agg_demand_zone_boxes = array.new_box()
var array<float> agg_supply_highs      = array.new_float()
var array<float> agg_supply_lows       = array.new_float()
var array<bool>  agg_supply_active     = array.new_bool()
var array<int>   agg_supply_start_bar  = array.new_int()

var array<float> agg_demand_highs     = array.new_float()
var array<float> agg_demand_lows      = array.new_float()
var array<bool>  agg_demand_active    = array.new_bool()
var array<int>   agg_demand_start_bar = array.new_int()

// === AGGREGATION VARIABLES ===
var int   agg_group_start_time      = na
var int   agg_group_start_bar_index = na
var float agg_open                  = na
var float agg_high                  = na
var float agg_low                   = na
var float agg_close                 = na

var float prev_agg_supply_low      = na
var float prev_agg_supply_high     = na
var int   prev_agg_supply_start_time = na
var float prev_agg_demand_low      = na
var float prev_agg_demand_high     = na
var int   prev_agg_demand_start_time = na
var bool  agg_supply_zone_used     = false
var bool  agg_demand_zone_used     = false

// Helper: Remove aggregation zone from arrays
remove_agg_zone(idx, isSupply) =>
    if isSupply
        if idx < array.size(agg_supply_zone_boxes)
            box.delete(array.get(agg_supply_zone_boxes, idx))
        if idx < array.size(agg_supply_zone_boxes)
            array.remove(agg_supply_zone_boxes, idx)
        if idx < array.size(agg_supply_highs)
            array.remove(agg_supply_highs, idx)
        if idx < array.size(agg_supply_lows)
            array.remove(agg_supply_lows, idx)
        if idx < array.size(agg_supply_active)
            array.remove(agg_supply_active, idx)
        if idx < array.size(agg_supply_start_bar)
            array.remove(agg_supply_start_bar, idx)
    else
        if idx < array.size(agg_demand_zone_boxes)
            box.delete(array.get(agg_demand_zone_boxes, idx))
        if idx < array.size(agg_demand_zone_boxes)
            array.remove(agg_demand_zone_boxes, idx)
        if idx < array.size(agg_demand_highs)
            array.remove(agg_demand_highs, idx)
        if idx < array.size(agg_demand_lows)
            array.remove(agg_demand_lows, idx)
        if idx < array.size(agg_demand_active)
            array.remove(agg_demand_active, idx)
        if idx < array.size(agg_demand_start_bar)
            array.remove(agg_demand_start_bar, idx)

// === ARRAY TRIMMERS & HELPERS ===
trimDemandArrays() =>
    maxCount = max_zones
    while array.size(demandHighs) > maxCount
        // Delete visual elements first
        if array.size(demandBoxes) > 0
            box.delete(array.pop(demandBoxes))
        if array.size(demandZoneLabels) > 0
            label lbl_to_delete = array.pop(demandZoneLabels)
            if not na(lbl_to_delete)
                label.delete(lbl_to_delete)
        if array.size(demandLiqConnectorLines) > 0
            line ln_del = array.pop(demandLiqConnectorLines)
            if not na(ln_del)
                line.delete(ln_del)
        if array.size(demandLiqInfoLabels) > 0
            label liq_lbl_del = array.pop(demandLiqInfoLabels)
            if not na(liq_lbl_del)
                label.delete(liq_lbl_del)
        // Pop core arrays (always in sync with demandHighs)
        array.pop(demandHighs)
        array.pop(demandLows)
        array.pop(demandActive)
        array.pop(demandLeftZone)
        array.pop(demandLeftWithBearish)
        array.pop(demandZoneAccuracy)
        array.pop(demandZoneLiquidity)
        array.pop(demandZoneLiquiditySwept)
        array.pop(demandZoneLiquidityBarIndex)
        array.pop(demandZoneLiquiditySweptBarIndex)
        array.pop(demandZoneCreatedBarIndex)
        array.pop(demandZoneLastEntryBar)
        array.pop(demandZoneLiquidityValid)
        array.pop(demandZoneLiquidityCandleCount)
        array.pop(demandLiqCandles)
        array.pop(demandZoneUZID)
        // Pop optional arrays (check size to avoid errors)
        if array.size(demandZoneIsHistorical) > 0
            array.pop(demandZoneIsHistorical)
        if array.size(demandWickTouched) > 0
            array.pop(demandWickTouched)
        if array.size(demandZoneMitigated) > 0
            array.pop(demandZoneMitigated)
        if array.size(demandZoneTime) > 0
            array.pop(demandZoneTime)
        if array.size(demandZoneCausedSweep) > 0
            array.pop(demandZoneCausedSweep)
        if array.size(demandZoneMitigationTime) > 0
            array.pop(demandZoneMitigationTime)

trimSupplyArrays() =>
    maxCount = max_zones
    while array.size(supplyHighs) > maxCount
        // Delete visual elements first
        if array.size(supplyBoxes) > 0
            box.delete(array.pop(supplyBoxes))
        if array.size(supplyZoneLabels) > 0
            label lbl_to_delete_sup = array.pop(supplyZoneLabels)
            if not na(lbl_to_delete_sup)
                label.delete(lbl_to_delete_sup)
        if array.size(supplyLiqConnectorLines) > 0
            line ln_del_s = array.pop(supplyLiqConnectorLines)
            if not na(ln_del_s)
                line.delete(ln_del_s)
        if array.size(supplyLiqInfoLabels) > 0
            label liq_lbl_del_s = array.pop(supplyLiqInfoLabels)
            if not na(liq_lbl_del_s)
                label.delete(liq_lbl_del_s)
        // Pop core arrays (always in sync with supplyHighs)
        array.pop(supplyHighs)
        array.pop(supplyLows)
        array.pop(supplyActive)
        array.pop(supplyLeftZone)
        array.pop(supplyZoneAccuracy)
        array.pop(supplyZoneUZID)
        array.pop(supplyZoneCreatedBarIndex)
        array.pop(supplyZoneLiquidity)
        array.pop(supplyZoneLiquiditySwept)
        array.pop(supplyZoneLiquidityBarIndex)
        array.pop(supplyZoneLiquiditySweptBarIndex)
        array.pop(supplyZoneLastEntryBar)
        array.pop(supplyZoneLiquidityValid)
        array.pop(supplyLiqExists)
        array.pop(supplyLiqCandleCount)
        array.pop(supplyLiqCandles)
        // Pop optional arrays (check size to avoid errors)
        if array.size(supplyZoneIsHistorical) > 0
            array.pop(supplyZoneIsHistorical)
        if array.size(supplyZoneMitigated) > 0
            array.pop(supplyZoneMitigated)
        if array.size(supplyZoneTime) > 0
            array.pop(supplyZoneTime)
        if array.size(supplyZoneCausedSweep) > 0
            array.pop(supplyZoneCausedSweep)
        if array.size(supplyZoneMitigationTime) > 0
            array.pop(supplyZoneMitigationTime)

trimBaseTimeArrays() =>
    maxCount = max_zones * 2
    while array.size(used_demand_base_times) > maxCount
        array.pop(used_demand_base_times)
    while array.size(used_supply_base_times) > maxCount
        array.pop(used_supply_base_times)

trimAggArrays() =>
    maxAgg = 50
    while array.size(agg_supply_zone_boxes) > maxAgg
        box.delete(array.pop(agg_supply_zone_boxes))
        array.pop(agg_supply_highs)
        array.pop(agg_supply_lows)
        array.pop(agg_supply_active)
        array.pop(agg_supply_start_bar)
    while array.size(agg_demand_zone_boxes) > maxAgg
        box.delete(array.pop(agg_demand_zone_boxes))
        array.pop(agg_demand_highs)
        array.pop(agg_demand_lows)
        array.pop(agg_demand_active)
        array.pop(agg_demand_start_bar)

// === Helper: Bull/Bear ===
is_strong_bull(idx) =>
    close[idx] > open[idx] and (math.abs(close[idx] - open[idx]) / (high[idx] - low[idx]) > 0.5)

is_strong_bear(idx) =>
    close[idx] < open[idx] and (math.abs(close[idx] - open[idx]) / (high[idx] - low[idx]) > 0.5)

is_bullish(idx) => close[idx] > open[idx]
is_bearish(idx) => close[idx] < open[idx]

// Helper: locate zone index by UZID, with label-text fallback
findDemandZoneIndexByUZID(targetUZID) =>
    int idx = na
    if array.size(demandZoneUZID) > 0
        for i = 0 to array.size(demandZoneUZID) - 1
            if array.get(demandZoneUZID, i) == targetUZID
                idx := i  // keep updating so the last match (earliest zone) wins
    if na(idx) and array.size(demandZoneLabels) > 0
        string targetText = "D-" + str.tostring(targetUZID)
        for j = 0 to array.size(demandZoneLabels) - 1
            label lbl = array.get(demandZoneLabels, j)
            if not na(lbl)
                txt = label.get_text(lbl)
                if txt == targetText
                    idx := j
    idx

findSupplyZoneIndexByUZID(targetUZID) =>
    int idx = na
    if array.size(supplyZoneUZID) > 0
        for i = 0 to array.size(supplyZoneUZID) - 1
            if array.get(supplyZoneUZID, i) == targetUZID
                idx := i
    if na(idx) and array.size(supplyZoneLabels) > 0
        string targetText = "S-" + str.tostring(targetUZID)
        for j = 0 to array.size(supplyZoneLabels) - 1
            label lbl = array.get(supplyZoneLabels, j)
            if not na(lbl)
                txt = label.get_text(lbl)
                if txt == targetText
                    idx := j
    idx

// === Helper: deactivate demand zones after a trade ===
deactivateDemandZone(idx) =>
    if idx >= 0 and idx < array.size(demandActive)
        array.set(demandActive, idx, false)
        if idx < array.size(demandBoxes)
            b = array.get(demandBoxes, idx)
            box.set_bgcolor(b, col_demand_bg)
            box.set_border_color(b, col_demand_border)

deactivateOverlappingDemandZones(refLow, refHigh) =>
    for k = 0 to array.size(demandHighs) - 1
        if array.get(demandActive, k)
            zHigh = array.get(demandHighs, k)
            zLow  = array.get(demandLows, k)
            overlaps = not (zHigh < refLow or zLow > refHigh)
            if overlaps
                deactivateDemandZone(k)

// === DEMAND ZONE CREATION ===
// isHistorical = true  -> created during initial backfill scan
// isHistorical = false -> created in live processing (recent bars)
createDemandZone(baseIdx, isHistorical, zoneUZID) =>
    baseBarIdx = bar_index - baseIdx
    if not is_base_bar_used(baseBarIdx, used_demand_base_times)
        array.push(used_demand_base_times, baseBarIdx)
        trimBaseTimeArrays()

        baseHigh = high[baseIdx]
        baseLow  = low[baseIdx]
        baseOpen = open[baseIdx]

        firstBullHigh = high[baseIdx - 1]
        bool isAccuracy = baseHigh > firstBullHigh

        float hi = na
        float lo = na

        if isAccuracy
            hi := baseOpen
            lo := baseLow
        else
            hi := baseHigh
            lo := baseLow

        float lowest_bullish_wick = na
        if baseIdx - 1 >= 0 and is_bullish(baseIdx - 1)
            bullish_low = low[baseIdx - 1]
            if bullish_low < baseLow - pip_size
                lowest_bullish_wick := bullish_low
        
        if not na(lowest_bullish_wick) and lowest_bullish_wick < baseLow
            lo := lowest_bullish_wick

        max_zone_size_pips = 50.0
        max_zone_size = max_zone_size_pips * pip_size
        if hi - lo > max_zone_size
            lo := baseLow
            if isAccuracy
                hi := baseOpen
            else
                hi := baseHigh

        // Store creation bar index for zone extension (use bar_index relative to creation)
        creation_bar_index = bar_index - baseIdx

        array.unshift(demandHighs, hi)
        array.unshift(demandLows, lo)
        array.unshift(demandActive, true)
        array.unshift(demandLeftZone, false)
        array.unshift(demandLeftWithBearish, false)
        array.unshift(demandZoneAccuracy, isAccuracy)
        array.unshift(demandZoneLiquidity, na)
        array.unshift(demandZoneLiquiditySwept, false)
        array.unshift(demandZoneLiquidityBarIndex, na)
        array.unshift(demandZoneLiquiditySweptBarIndex, na)
        array.unshift(demandZoneCreatedBarIndex, creation_bar_index)
        array.unshift(demandZoneLastEntryBar, na)
        array.unshift(demandZoneIsHistorical, isHistorical)
        array.unshift(demandZoneLiquidityValid, false)
        array.unshift(demandZoneLiquidityCandleCount, 0)
        array.unshift(demandLiqCandles, 0)  // Initialize opposite candle count for this zone
        array.unshift(demandZoneMitigated, false)  // Not mitigated initially
        array.unshift(demandZoneTime, time)  // Store creation timestamp for 24-hour freshness
        array.unshift(demandLiqConnectorLines, na)
        array.unshift(demandLiqInfoLabels, na)
        array.unshift(demandZoneMitigationTime, na)
        
        // === CHECK IF ZONE'S IMPULSE CAUSED A LIQUIDITY SWEEP AT CREATION (LIVE ONLY) ===
        // For historical zones created in the initial scan, we CANNOT reliably validate sweeps,
        // so we force zoneCausedSweep = false and only evaluate this for live-created zones.
        // CRITICAL: Historical zones MUST have zoneCausedSweep = false (cannot validate historical sweeps)
        bool zoneSweptLiquidity = false
        if isHistorical
            // Force false for historical zones - we cannot validate sweeps reliably in backfill
            zoneSweptLiquidity := false
        else if not isHistorical
            // For DEMAND zones: Look for swing HIGH that existed BEFORE zone, check if impulse swept it
            // The bullish impulse candles (baseIdx-1, baseIdx-2, etc.) must have swept above existing swing highs
            float impulseHighest = high[baseIdx - 1]  // First bullish candle after base
            if baseIdx >= 2
                impulseHighest := math.max(impulseHighest, high[baseIdx - 2])
            if baseIdx >= 3
                impulseHighest := math.max(impulseHighest, high[baseIdx - 3])
            
            // Now look for swing highs that existed BEFORE the base candle
            for lookback = baseIdx + 2 to math.min(baseIdx + 20, bar_index - 1)
                // Check if this was a swing high (higher than neighbors)
                bool isSwingHigh = high[lookback] > high[lookback + 1] and high[lookback] > high[lookback - 1]
                // Also check 1-candle swing if enabled
                bool isOneCandleHigh = useOneCandleLiquidity and high[lookback] > high[lookback - 1]
                
                if (isSwingHigh or isOneCandleHigh) and high[lookback] > hi  // Swing high above zone
                    // Check if the impulse swept this swing high
                    if impulseHighest > high[lookback]
                        zoneSweptLiquidity := true
                        break
        
        array.unshift(demandZoneCausedSweep, zoneSweptLiquidity)  // Set based on actual sweep at creation
        // Use provided UZID from persistent counter
        array.unshift(demandZoneUZID, zoneUZID)

        if show_zones and show_demand_zones
            // Use bar_index for exact bar count extension
            left_bar_index = creation_bar_index
            right_bar_index = left_bar_index + extend_bars
            
            // Create new box with bar_index for exact extension
            // is_base_bar_used() already prevents duplicate zones, so we can safely create box here
            b = box.new(left = left_bar_index, bottom = lo, right = right_bar_index, top = hi,
                       bgcolor = col_demand_bg, border_color = col_demand_border,
                       border_width = 1,
                       xloc = xloc.bar_index, extend = extend.none)
            array.unshift(demandBoxes, b)
            
            // Anchor the ID label to the rectangle geometry so it never drifts
            zoneRect = b
            float top    = box.get_top(zoneRect)
            float bottom = box.get_bottom(zoneRect)
            int   left   = box.get_left(zoneRect)

            float mid = (top + bottom) / 2
            int xPos = left + 1
            id_text = "D-" + str.tostring(zoneUZID)

            lbl = label.new(
                 x = xPos,
                 y = mid,
                 text = id_text,
                 style = label.style_label_left,
                 textcolor = color.black,
                 color = color.new(color.white, 100),
                 size = size.small,
                 textalign = text.align_center,
                 xloc = xloc.bar_index)
            array.unshift(demandZoneLabels, lbl)

        trimDemandArrays()

// === SUPPLY ZONE CREATION ===
// isHistorical = true  -> created during initial backfill scan
// isHistorical = false -> created in live processing (recent bars)
createSupplyZone(baseIdx, isHistorical, zoneUZID) =>
    baseBarIdx = bar_index - baseIdx
    if not is_base_bar_used(baseBarIdx, used_supply_base_times)
        array.push(used_supply_base_times, baseBarIdx)
        trimBaseTimeArrays()

        baseHigh = high[baseIdx]
        baseLow  = low[baseIdx]
        baseOpen = open[baseIdx]

        firstBearLow = low[baseIdx - 1]
        bool isAccuracy = baseLow < firstBearLow

        float hi = na
        float lo = na

        if isAccuracy
            hi := baseHigh
            lo := baseOpen
        else
            hi := baseHigh
            lo := baseLow

        float highest_bearish_wick = na
        if baseIdx - 1 >= 0 and is_bearish(baseIdx - 1)
            bearish_high = high[baseIdx - 1]
            if bearish_high > baseHigh + pip_size
                highest_bearish_wick := bearish_high
        
        if not na(highest_bearish_wick) and highest_bearish_wick > baseHigh
            hi := highest_bearish_wick

        max_zone_size_pips = 50.0
        max_zone_size = max_zone_size_pips * pip_size
        if hi - lo > max_zone_size
            hi := baseHigh
            if isAccuracy
                lo := baseOpen
            else
                lo := baseLow

        // Store creation bar index for zone extension (use bar_index relative to creation)
        creation_bar_index = bar_index - baseIdx

        // ============================================================
        // CRITICAL: VALIDATE LIQUIDITY SWEEP AT ZONE CREATION (LIVE ONLY)
        // For historical zones created in the initial scan, we CANNOT reliably validate sweeps,
        // so we force zoneCausedSweep = false and only evaluate this for live-created zones.
        // ============================================================
        // CRITICAL: Historical zones MUST have zoneCausedSweep = false (cannot validate historical sweeps)
        bool zoneSweptLiquidity = false
        if isHistorical
            // Force false for historical zones - we cannot validate sweeps reliably in backfill
            zoneSweptLiquidity := false
        else if not isHistorical
            // Step 1: Calculate the lowest point of the bearish impulse
            float impulseLowest = low[baseIdx - 1]
            if baseIdx >= 2
                impulseLowest := math.min(impulseLowest, low[baseIdx - 2])
            if baseIdx >= 3
                impulseLowest := math.min(impulseLowest, low[baseIdx - 3])
            
            // Step 2: Look for swing lows that existed BEFORE the base candle
            // Search 5–25 bars BEFORE the base candle (baseIdx + 5 to baseIdx + 25)
            // This ensures we only find pre-existing liquidity, not retracement liquidity.
            int maxLookback = math.min(baseIdx + 25, bar_index - 3)
            for lookback = baseIdx + 5 to maxLookback
                if lookback >= 3 and lookback < bar_index - 1
                    // Classic 2-sided swing low
                    bool isSwingLow = low[lookback] < low[lookback + 1] and low[lookback] < low[lookback - 1]
                    
                    // Optional 1-candle swing if enabled
                    bool isOneCandleLow = false
                    if useOneCandleLiquidity and lookback >= 1
                        isOneCandleLow := low[lookback] < low[lookback - 1]
                    
                    if isSwingLow or isOneCandleLow
                        float historicalSwingLow = low[lookback]
                        
                        // 1) Swing low must be below the zone bottom
                        bool swingBelowZone = historicalSwingLow < lo
                        // 2) Entire bar must be below the zone (no wicks into zone)
                        bool barCompletelyBelow = high[lookback] < lo
                        // 3) Impulse must have swept it
                        bool impulseSweepValid = impulseLowest < historicalSwingLow
                        
                        if swingBelowZone and barCompletelyBelow and impulseSweepValid
                            zoneSweptLiquidity := true
                            break
        
        // Now persist the zone itself and its validation state
        array.unshift(supplyHighs, hi)
        array.unshift(supplyLows, lo)
        array.unshift(supplyActive, true)
        array.unshift(supplyLeftZone, false)
        array.unshift(supplyZoneAccuracy, isAccuracy)
        // Use provided UZID from persistent counter
        array.unshift(supplyZoneUZID, zoneUZID)
        array.unshift(supplyZoneCreatedBarIndex, creation_bar_index)
        // Initialize supply zone liquidity tracking arrays
        array.unshift(supplyZoneLiquidity, na)
        array.unshift(supplyZoneLiquiditySwept, false)
        array.unshift(supplyZoneLiquidityBarIndex, na)
        array.unshift(supplyZoneLiquiditySweptBarIndex, na)
        array.unshift(supplyZoneLastEntryBar, na)
        array.unshift(supplyZoneIsHistorical, isHistorical)
        array.unshift(supplyZoneLiquidityValid, false)
        array.unshift(supplyZoneMitigated, false)
        array.unshift(supplyZoneTime, time)  // Store creation timestamp for 24-hour freshness
        array.unshift(supplyZoneCreatedBarIndex, creation_bar_index)
        array.unshift(supplyLiqExists, false)  // Track if valid liquidity exists for SHORT entries
        array.unshift(supplyLiqCandleCount, 0)  // Legacy - kept for compatibility
        array.unshift(supplyLiqCandles, 0)  // Initialize opposite candle count for this zone
        // CRITICAL: Store the validation result – final and not overridden later
        array.unshift(supplyZoneCausedSweep, zoneSweptLiquidity)
        array.unshift(supplyLiqConnectorLines, na)
        array.unshift(supplyLiqInfoLabels, na)
        array.unshift(supplyZoneMitigationTime, na)

        if show_zones and show_supply_zones
            // Use bar_index for exact bar count extension
            left_bar_index = creation_bar_index
            right_bar_index = left_bar_index + extend_bars
            
            // Create new box with bar_index for exact extension
            // is_base_bar_used() already prevents duplicate zones, so we can safely create box here
            b = box.new(left = left_bar_index, bottom = lo, right = right_bar_index, top = hi,
                       bgcolor = col_supply_bg, border_color = col_supply_border,
                       border_width = 1,
                       xloc = xloc.bar_index, extend = extend.none)
            array.unshift(supplyBoxes, b)
            
            // Anchor the ID label to the rectangle geometry so it never drifts
            zoneRect = b
            float top    = box.get_top(zoneRect)
            float bottom = box.get_bottom(zoneRect)
            int   left   = box.get_left(zoneRect)

            float mid = (top + bottom) / 2
            int xPos = left + 1
            id_text = "S-" + str.tostring(zoneUZID)

            lbl = label.new(
                 x = xPos,
                 y = mid,
                 text = id_text,
                 style = label.style_label_left,
                 textcolor = color.black,
                 color = color.new(color.white, 100),
                 size = size.small,
                 textalign = text.align_center,
                 xloc = xloc.bar_index)
            array.unshift(supplyZoneLabels, lbl)

        trimSupplyArrays()

// --- 1. DEMAND ZONE DETECTION (recent bars) ---
if barstate.isconfirmed and bar_index > 10
    if is_bullish(0) and is_bullish(1) and is_bullish(2) and is_bearish(3)
        baseBarIdx = bar_index - 3
        if not is_base_bar_used(baseBarIdx, used_demand_base_times)
            demand_zone_counter += 1
            createDemandZone(3, false, demand_zone_counter)
    else if is_bullish(0) and is_bullish(1) and is_bearish(2)
        baseBarIdx = bar_index - 2
        if not is_base_bar_used(baseBarIdx, used_demand_base_times)
            demand_zone_counter += 1
            createDemandZone(2, false, demand_zone_counter)
    else if is_bullish(0) and is_bearish(1)
        baseBarIdx = bar_index - 1
        if not is_base_bar_used(baseBarIdx, used_demand_base_times)
            demand_zone_counter += 1
            createDemandZone(1, false, demand_zone_counter)

// Initial historical scan (once)
if barstate.isconfirmed and not initial_scan_done and bar_index > 50
    initial_scan_done := true
    max_scan = math.min(100, bar_index)

    for i = 2 to max_scan
        baseBarIdxDemand = bar_index - i
        if i >= 3 and is_bearish(i) and is_bullish(i - 1) and is_bullish(i - 2) and is_bullish(i - 3)
            if not is_base_bar_used(baseBarIdxDemand, used_demand_base_times)
                demand_zone_counter += 1
                createDemandZone(i, true, demand_zone_counter)
        else if is_bearish(i) and is_bullish(i - 1) and is_bullish(i - 2)
            if not is_base_bar_used(baseBarIdxDemand, used_demand_base_times)
                demand_zone_counter += 1
                createDemandZone(i, true, demand_zone_counter)
        else if is_bearish(i) and is_bullish(i - 1)
            if not is_base_bar_used(baseBarIdxDemand, used_demand_base_times)
                demand_zone_counter += 1
                createDemandZone(i, true, demand_zone_counter)

        baseBarIdxSupply = bar_index - i
        if i >= 3 and is_bullish(i) and is_bearish(i - 1) and is_bearish(i - 2) and is_bearish(i - 3)
            if not is_base_bar_used(baseBarIdxSupply, used_supply_base_times)
                supply_zone_counter += 1
                createSupplyZone(i, true, supply_zone_counter)
        else if is_bullish(i) and is_bearish(i - 1) and is_bearish(i - 2)
            if not is_base_bar_used(baseBarIdxSupply, used_supply_base_times)
                supply_zone_counter += 1
                createSupplyZone(i, true, supply_zone_counter)
        else if is_bullish(i) and is_bearish(i - 1)
            if not is_base_bar_used(baseBarIdxSupply, used_supply_base_times)
                supply_zone_counter += 1
                createSupplyZone(i, true, supply_zone_counter)

// --- 2. SUPPLY ZONE DETECTION (recent bars) ---
if barstate.isconfirmed and bar_index > 10
    if is_bearish(0) and is_bearish(1) and is_bearish(2) and is_bullish(3)
        baseBarIdx = bar_index - 3
        if not is_base_bar_used(baseBarIdx, used_supply_base_times)
            supply_zone_counter += 1
            createSupplyZone(3, false, supply_zone_counter)
    else if is_bearish(0) and is_bearish(1) and is_bullish(2)
        baseBarIdx = bar_index - 2
        if not is_base_bar_used(baseBarIdx, used_supply_base_times)
            supply_zone_counter += 1
            createSupplyZone(2, false, supply_zone_counter)
    else if is_bearish(0) and is_bullish(1)
        baseBarIdx = bar_index - 1
        if not is_base_bar_used(baseBarIdx, used_supply_base_times)
            supply_zone_counter += 1
            createSupplyZone(1, false, supply_zone_counter)

// === AGGREGATION-BASED ZONE DETECTION ===
if enable_aggregation_zones
    tf_ms    = timeframe.multiplier * 60000
    agg_tf_ms = aggregation_factor * tf_ms

    my_timezone      = "Etc/GMT+5"
    day_start_time   = time("D", my_timezone)
    elapsed_ms       = time - day_start_time
    agg_intervals    = math.floor(elapsed_ms / agg_tf_ms)
    current_group_start_time = day_start_time + agg_intervals * agg_tf_ms

    is_new_agg_group = na(agg_group_start_time) or (current_group_start_time != agg_group_start_time)

    current_price = close

    supply_idx = array.size(agg_supply_zone_boxes) - 1
    while supply_idx >= 0
        b = array.get(agg_supply_zone_boxes, supply_idx)
        top_val = math.max(box.get_top(b), box.get_bottom(b))
        if current_price > top_val
            remove_agg_zone(supply_idx, true)
        supply_idx -= 1

    demand_idx = array.size(agg_demand_zone_boxes) - 1
    while demand_idx >= 0
        b = array.get(agg_demand_zone_boxes, demand_idx)
        bottom_val = math.min(box.get_top(b), box.get_bottom(b))
        if current_price < bottom_val
            remove_agg_zone(demand_idx, false)
        demand_idx -= 1

    if not na(agg_high) and not na(agg_low)
        supply_idx2 = array.size(agg_supply_zone_boxes) - 1
        while supply_idx2 >= 0
            b = array.get(agg_supply_zone_boxes, supply_idx2)
            top_val = math.max(box.get_top(b), box.get_bottom(b))
            bottom_val = math.min(box.get_top(b), box.get_bottom(b))
            if agg_high >= bottom_val and agg_low <= top_val
                if delete_mitigated_zones_agg
                    remove_agg_zone(supply_idx2, true)
                else
                    box.set_bgcolor(b, col_supply_bg)
                    box.set_border_color(b, col_supply_border)
            supply_idx2 -= 1

        demand_idx2 = array.size(agg_demand_zone_boxes) - 1
        while demand_idx2 >= 0
            b = array.get(agg_demand_zone_boxes, demand_idx2)
            top_val = math.max(box.get_top(b), box.get_bottom(b))
            bottom_val = math.min(box.get_top(b), box.get_bottom(b))
            if agg_high >= bottom_val and agg_low <= top_val
                if delete_mitigated_zones_agg
                    remove_agg_zone(demand_idx2, false)
                else
                    box.set_bgcolor(b, col_demand_bg)
                    box.set_border_color(b, col_demand_border)
            demand_idx2 -= 1

    if is_new_agg_group and not na(agg_group_start_time)
        is_bull = agg_close >= agg_open

        if is_bull
            prev_agg_supply_low        := agg_low
            prev_agg_supply_high       := agg_high
            prev_agg_supply_start_time := agg_group_start_time
            agg_supply_zone_used       := false

            if show_demand_zones_agg and not na(prev_agg_demand_high) and agg_close > prev_agg_demand_high and not agg_demand_zone_used
                right_time = prev_agg_demand_start_time + agg_zone_length * timeframe.in_seconds() * 1000
                new_demand_box = box.new(left = prev_agg_demand_start_time,
                                         right = right_time,
                                         top = prev_agg_demand_high,
                                         bottom = prev_agg_demand_low,
                                         bgcolor = col_demand_bg,
                                         border_color = col_demand_border,
                                         border_width = 1,
                                         xloc = xloc.bar_time,
                                         extend = extend.none)
                array.push(agg_demand_zone_boxes, new_demand_box)
                array.push(agg_demand_highs, prev_agg_demand_high)
                array.push(agg_demand_lows, prev_agg_demand_low)
                array.push(agg_demand_active, true)
                array.push(agg_demand_start_bar, prev_agg_demand_start_time)
                agg_demand_zone_used := true
        else
            prev_agg_demand_low        := agg_low
            prev_agg_demand_high      := agg_high
            prev_agg_demand_start_time := agg_group_start_time
            agg_demand_zone_used       := false

            if show_supply_zones_agg and not na(prev_agg_supply_low) and agg_close < prev_agg_supply_low and not agg_supply_zone_used
                right_time = prev_agg_supply_start_time + agg_zone_length * timeframe.in_seconds() * 1000
                new_supply_box = box.new(left = prev_agg_supply_start_time,
                                         right = right_time,
                                         top = prev_agg_supply_high,
                                         bottom = prev_agg_supply_low,
                                         bgcolor = col_supply_bg,
                                         border_color = col_supply_border,
                                         border_width = 1,
                                         xloc = xloc.bar_time,
                                         extend = extend.none)
                array.push(agg_supply_zone_boxes, new_supply_box)
                array.push(agg_supply_highs, prev_agg_supply_high)
                array.push(agg_supply_lows, prev_agg_supply_low)
                array.push(agg_supply_active, true)
                array.push(agg_supply_start_bar, prev_agg_supply_start_time)
                agg_supply_zone_used := true

    if enable_aggregation_zones
        if is_new_agg_group
            agg_group_start_time      := current_group_start_time
            agg_group_start_bar_index := bar_index
            agg_open  := open
            agg_high  := high
            agg_low   := low
            agg_close := close
        else
            agg_high  := na(agg_high) ? high : math.max(agg_high, high)
            agg_low   := na(agg_low) ? low : math.min(agg_low, low)
            agg_close := close

        trimAggArrays()

// === LIQUIDITY VALIDATION FUNCTIONS ===
// Validate liquidity: must break previous structure by at least a few pips
// === SWING DETECTION FOR LIQUIDITY ===
// Check if a bar is a valid swing for liquidity detection
// barOffset is the offset from current bar_index where the liquidity/fractal occurred
// For example, if fractal is at bar_index - fractalsPeriod, then barOffset = fractalsPeriod
isValidSwingForLiquidity(barOffset, isHigh) =>
    // Check if the bar at barOffset is a valid swing
    // For 2-candle swing: bar[barOffset-1] must be lower/higher than both bar[barOffset-2] and bar[barOffset]
    // For 1-candle swing: bar[barOffset-1] must be lower/higher than bar[barOffset]
    
    // 2-candle swing detection (Williams Fractal pattern)
    isTwoCandleSwingLow = low[barOffset - 1] < low[barOffset - 2] and low[barOffset - 1] < low[barOffset]
    isTwoCandleSwingHigh = high[barOffset - 1] > high[barOffset - 2] and high[barOffset - 1] > high[barOffset]
    
    // 1-candle swing detection (simpler pattern)
    isOneCandleSwingLow = low[barOffset - 1] < low[barOffset]
    isOneCandleSwingHigh = high[barOffset - 1] > high[barOffset]
    
    // Combined validation
    if isHigh
        // For high liquidity: check if it's a valid swing high
        liqHighValid = isTwoCandleSwingHigh or (useOneCandleLiquidity and isOneCandleSwingHigh)
        liqHighValid
    else
        // For low liquidity: check if it's a valid swing low
        liqLowValid = isTwoCandleSwingLow or (useOneCandleLiquidity and isOneCandleSwingLow)
        liqLowValid

// Simplified validation - check if liquidity breaks previous swing
validate_liquidity_formation(liqBarIdx, zoneCreatedBarIdx, liqPrice, isHigh) =>
    if liqBarIdx <= zoneCreatedBarIdx
        false
    else
        // First, check if the liquidity bar itself is a valid swing
        // For new fractals being validated: fractalBar = bar_index - fractalsPeriod
        // So the offset from current bar_index to the fractal bar is fractalsPeriod
        // We check if the bar at offset fractalsPeriod is a valid swing
        // For existing liquidity, we can't reliably check historical swings, so we skip the check
        liqBarAge = liqBarIdx - zoneCreatedBarIdx
        is_new_fractal = (liqBarAge <= fractalsPeriod + 2)  // New fractal is close to current bar
        
        is_valid_swing = true  // Default to true for existing liquidity
        if is_new_fractal and fractalsPeriod >= 2  // Only check for new fractals with enough bars
            is_valid_swing := isValidSwingForLiquidity(fractalsPeriod, isHigh)
        
        if not is_valid_swing
            false  // Not a valid swing, reject
        else
            // Find previous swing high/low before liquidity formation
            float prev_swing = na
            bars_to_check = math.min(liqBarIdx - zoneCreatedBarIdx + 10, 30)  // Look back reasonable amount
            
            // Look back to find previous significant swing using the same swing logic,
            // without relying on additional fractal helper calls.
            for offset = fractalsPeriod to bars_to_check
                if isHigh
                    // Check if this offset forms a valid swing high
                    if isValidSwingForLiquidity(offset, true)
                        float swing_val = high[offset]
                        if na(prev_swing) or swing_val > prev_swing
                            prev_swing := swing_val
                else
                    // Check if this offset forms a valid swing low
                    if isValidSwingForLiquidity(offset, false)
                        float swing_val = low[offset]
                        if na(prev_swing) or swing_val < prev_swing
                            prev_swing := swing_val
            
            // Must break previous structure by at least 2 pips
            if not na(prev_swing)
                if isHigh
                    liqPrice > prev_swing + (pip_size * 2)
                else
                    liqPrice < prev_swing - (pip_size * 2)
            else
                true  // If no previous swing found, assume valid (first liquidity)

// === LIQUIDITY VISUAL HELPERS (CONNECTORS, LABELS, COLOR ON SWEEP) ===
clearDemandLiquidityVisual(idx) =>
    if idx >= 0
        if idx < array.size(demandLiqConnectorLines)
            line ln = array.get(demandLiqConnectorLines, idx)
            if not na(ln)
                line.delete(ln)
            array.set(demandLiqConnectorLines, idx, na)
        if idx < array.size(demandLiqInfoLabels)
            label lb = array.get(demandLiqInfoLabels, idx)
            if not na(lb)
                label.delete(lb)
            array.set(demandLiqInfoLabels, idx, na)

updateDemandLiquidityVisual(idx) =>
    if idx < 0
        na  // no-op for invalid index
    else if idx < array.size(demandHighs) and idx < array.size(demandLows) and idx < array.size(demandZoneLiquidity) and idx < array.size(demandZoneLiquidityBarIndex)
        float zHigh = array.get(demandHighs, idx)
        float zLow  = array.get(demandLows, idx)
        float liq   = array.get(demandZoneLiquidity, idx)
        int   liqBar = array.get(demandZoneLiquidityBarIndex, idx)
        bool  swept = idx < array.size(demandZoneLiquiditySwept) ? array.get(demandZoneLiquiditySwept, idx) : false
        bool  liqValid = idx < array.size(demandZoneLiquidityValid) ? array.get(demandZoneLiquidityValid, idx) : false
        int   oppCnt = idx < array.size(demandLiqCandles) ? array.get(demandLiqCandles, idx) : 0
        bool  zoneCaused = idx < array.size(demandZoneCausedSweep) ? array.get(demandZoneCausedSweep, idx) : false
        int   createdBar = idx < array.size(demandZoneCreatedBarIndex) ? array.get(demandZoneCreatedBarIndex, idx) : na

        if na(liq) or na(liqBar) or na(createdBar)
            clearDemandLiquidityVisual(idx)
        else
            float mid = (zHigh + zLow) / 2.0

            // Connector line zone ↔ liquidity
            line oldLn = idx < array.size(demandLiqConnectorLines) ? array.get(demandLiqConnectorLines, idx) : na
            if not na(oldLn)
                line.delete(oldLn)
            lineColor = swept ? color.new(color.lime, 0) : color.new(color.orange, 40)
            lineStyle = swept ? line.style_solid : line.style_dotted
            line lnNew = line.new(x1 = createdBar, y1 = mid, x2 = liqBar, y2 = liq,
                                  xloc = xloc.bar_index, extend = extend.none,
                                  color = lineColor, style = lineStyle, width = 2)
            if idx < array.size(demandLiqConnectorLines)
                array.set(demandLiqConnectorLines, idx, lnNew)

            // Info label at liquidity level
            label oldLb = idx < array.size(demandLiqInfoLabels) ? array.get(demandLiqInfoLabels, idx) : na
            string txt = "Liq " + str.tostring(oppCnt) + "c\n"
            txt += "Valid: " + (liqValid ? "✓" : "✗") + "\n"
            txt += "Sweep: " + (swept ? "✓" : "✗") + "\n"
            txt += "ZoneCaused: " + (zoneCaused ? "✓" : "✗")
            color lbColor = swept ? color.new(color.lime, 0) : color.new(color.orange, 0)
            if not na(oldLb)
                label.set_x(oldLb, liqBar)
                label.set_y(oldLb, liq)
                label.set_text(oldLb, txt)
                label.set_style(oldLb, label.style_label_left)
                label.set_textcolor(oldLb, color.white)
                label.set_color(oldLb, lbColor)
                label.set_size(oldLb, size.tiny)
                array.set(demandLiqInfoLabels, idx, oldLb)
            else
                // Create new label at liquidity level (demand)
                label lbNew = label.new(x = liqBar, y = liq, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, textcolor = color.white, color = lbColor, size = size.tiny)
                if idx < array.size(demandLiqInfoLabels)
                    array.set(demandLiqInfoLabels, idx, lbNew)

clearSupplyLiquidityVisual(idx) =>
    if idx >= 0
        if idx < array.size(supplyLiqConnectorLines)
            line ln = array.get(supplyLiqConnectorLines, idx)
            if not na(ln)
