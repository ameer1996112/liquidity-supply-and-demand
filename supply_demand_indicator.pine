show_pos_sizing_table  = input.bool(true, "Show Position Sizing Table (Debug)", group = "Display Options", tooltip = "Show detailed position sizing information in debug table when Debug Level is Full")

// Risk Management
use_stop_loss         = input.bool(true, "Use Stop Loss", group = "Strategy Settings")
stop_loss_buffer_pips = input.float(0, "Stop Loss Buffer (Pips)", minval = 0, step = 0.1, group = "Strategy Settings", tooltip = "Small buffer below the deepest wick. Set to 0 to place SL exactly at the wick low.")
use_take_profit       = input.bool(true, "Use Take Profit", group = "Strategy Settings")
take_profit_pips      = input.float(40, "Take Profit (Pips)", minval = 1, group = "Strategy Settings")
risk_reward_ratio     = input.float(2.0, "Risk:Reward Ratio", minval = 0.5, step = 0.1, group = "Strategy Settings", tooltip = "If set, Take Profit will be calculated based on Stop Loss")
require_liquidity_sweep = input.bool(true, "Require Liquidity Sweep", group = "Strategy Settings", tooltip = "Require liquidity above zone to exist and be swept before entry. Disable to allow entries even without liquidity (for testing)")
debug_mode            = input.bool(false, "Legacy Debug Toggle", group = "Strategy Settings", tooltip = "Legacy toggle. For new setups prefer Debug Level in Display Options.")
debug_entry_labels    = input.bool(false, "Debug Entry Signals", group = "Strategy Settings", tooltip = "Draw a label whenever the live entry condition actually triggers (Debug Level = Full only).")
show_zone_debug_labels = input.bool(false, "Show Zone Debug Labels", group = "Strategy Settings", tooltip = "Show debug labels on zones when price wicks into them (Debug Level = Full only).")
