        if idx < array.size(demandWickTouched)
            array.remove(demandWickTouched, idx)
        if idx < array.size(demandZoneMitigated)
            array.remove(demandZoneMitigated, idx)
        if idx < array.size(demandZoneCausedSweep)
            array.remove(demandZoneCausedSweep, idx)
        if idx < array.size(demandZoneTime)
            array.remove(demandZoneTime, idx)
        if idx < array.size(demandZoneMitigationTime)
            array.remove(demandZoneMitigationTime, idx)

