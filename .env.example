# =============================================================================
# ⚠️  SECURITY WARNING - READ THIS FIRST! ⚠️
# =============================================================================
# NEVER expose backend secrets to the frontend!
#
# ✅ SAFE FOR BROWSER (Frontend .env):
#    - NEXT_PUBLIC_* variables are embedded in browser JavaScript at BUILD time
#    - Examples: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_API_URL
#
# ❌ BACKEND ONLY (Never in frontend .env):
#    - SUPABASE_SERVICE_ROLE_KEY (bypasses Row Level Security!)
#    - REDIS_URL (internal infrastructure access)
#    - WEBHOOK_SECRET (API authentication)
#    - META_API_TOKEN (broker credentials)
#    - Any non-NEXT_PUBLIC_* variable
#
# If you accidentally expose backend secrets to frontend:
#    1. Rotate ALL compromised credentials immediately
#    2. Review Railway environment variables
#    3. Clear Next.js build cache: rm -rf frontend/.next
# =============================================================================

# =============================================================================
# ENVIRONMENT VARIABLES BY APP
# =============================================================================
# Copy to .env and fill in values. DO NOT commit .env with real credentials.
#
# Quick reference – required per app:
#
#   BACKEND (API)    Required: SUPABASE_URL, REDIS_URL
#   WORKER           Required: SUPABASE_URL, REDIS_URL (same .env as API)
#   FRONTEND         Required: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
#                    Optional: NEXT_PUBLIC_API_URL
#
# - Backend and Worker use project root .env (loaded by start.sh or Docker).
# - Frontend uses frontend/.env or Docker build args (NEXT_PUBLIC_* at build).
#
# REDUNDANT: Use ONE per group. Settings accept aliases; keep one and delete the rest.
#   Supabase anon: SUPABASE_ANON_KEY (or SUPABASE_KEY)
#   Supabase service: SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_SERVICE_KEY)
#   AI/LLM key: OPENAI_API_KEY (or AI_API_KEY or ANTHROPIC_API_KEY)
# =============================================================================

# -----------------------------------------------------------------------------
# JIRA INTEGRATION — used by scripts/jira-sync.js AND src/api_tickets.py
# -----------------------------------------------------------------------------
# How to get your Jira API Token:
#   1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
#   2. Click "Create API token" → give it a label → Copy the token
#
# How to find your Project Key:
#   1. Open your Jira project → look at the URL or the board header
#   2. Example: https://ameer1996112.atlassian.net/jira/software/projects/DEV/boards
#                                                                          ^^^  ← this is the key
#
JIRA_BASE_URL=https://ameer1996112.atlassian.net
JIRA_DOMAIN=https://ameer1996112.atlassian.net    # alias for jira-sync.js
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=DEV
JIRA_TASK_TYPE_ID=10003                            # Task issue type ID

# -----------------------------------------------------------------------------
# BACKEND (API) – required for uvicorn src.api:app
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
REDIS_URL=redis://localhost:6379

# Required: webhook auth — requests are rejected if WEBHOOK_SECRET is unset
WEBHOOK_SECRET=
# Required: admin API key — protects /admin, /api/v1/config, and /broker-profiles routes
ADMIN_API_KEY=

# Optional: signal queue backend ('redis' for production, 'memory' for tests)
SIGNAL_TRANSPORT=redis

# Optional: for scripts/simulate_signal.py – Railway backend URL (default: http://localhost:8000)
# API_BASE_URL=https://your-app.up.railway.app
# Or full webhook URL: API_WEBHOOK_URL=https://your-app.up.railway.app/webhook

# Optional: Supabase – set ONE anon key and optionally ONE service key
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: notifications
DISCORD_WEBHOOK_URL=           # Main channel (#trades) — trade signals
DISCORD_ALERTS_WEBHOOK_URL=    # Optional: separate channel (#alerts) for operational alerts
                               # (drawdown, consecutive losses, watchdog, TCA)
                               # Falls back to DISCORD_WEBHOOK_URL if not set
DISCORD_BOT_TOKEN=             # Optional: enables thread-per-trade (fill + close updates in thread)
                               # Create a bot at discord.com/developers, add to server with Manage Threads permission
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading hours filter (local timezone, auto-handles DST)
# Store as local clock hours — the system converts to UTC automatically.
# Israel switches DST in late March (UTC+2→UTC+3) and late October (UTC+3→UTC+2).
# No manual update needed when clocks change.
PINE_TRADING_TIMEZONE=Asia/Jerusalem
PINE_TRADING_START_HOUR_LOCAL=7
PINE_TRADING_END_HOUR_LOCAL=22

# Optional: execution
TRADING_KILL_SWITCH=false
# REMOVED: LIVE_TRADING / LIVE_TRADING_ENABLED
#   Execution mode is now controlled exclusively from the dashboard toggle.
#   Go to the dashboard → bottom of the sidebar → select DRY_RUN / PAPER / LIVE.
#   The mode is persisted in system_config.trading_mode (DB) and takes effect
#   within 30 seconds (cache TTL). No redeploy needed.
#
# RUN_MODE below is the fallback used only if system_config DB is unreachable.
RUN_MODE=DRY_RUN
LIVE_SHADOW=true
PAPER_TRADING_ENABLED=false
PAPER_AUTO_EXECUTE=true
PAPER_SYMBOLS=
PAPER_MAX_POSITIONS=10
PAPER_ACCOUNT_BALANCE=50000
ACCOUNT_BALANCE=50000

# Pine-aligned risk settings (Balanced profile)
RISK_PERCENT=0.5
MIN_RR_RATIO=2.0
STOP_LOSS_BUFFER_PIPS=1.0
MAX_LOT_SIZE=10.0
GOLD_PIP_DIVISOR=0.1

# Kelly Criterion position sizing (optional but recommended)
KELLY_ENABLED=false
KELLY_FRACTION=0.25

# Optional: AI Guardian + Ensemble Brain – set ONE of OPENAI_API_KEY / AI_API_KEY / ANTHROPIC_API_KEY
AI_FILTER_ENABLED=true
AI_PROVIDER=anthropic
OPENAI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MIN_CONFIDENCE=75
AI_TIMEOUT_SECONDS=5
AI_MODEL=llama-3.3-70b-versatile
LLM_MODEL_PRIMARY=llama-3.3-70b-versatile
LLM_MODEL_FALLBACK=llama-3.1-8b-instant

# Sprint 3.1: Two-tier LLM allocation (quick first, escalate to deep)
AI_ENABLED=true
AI_MODE=shadow
AI_QUICK_MODEL=llama-3.1-8b-instant
AI_DEEP_MODEL=llama-3.3-70b-versatile

# Sprint 3.4: Strategy graduation — cannot enable enforce unless thresholds met
AI_GRADUATION_MIN_SAMPLE_SIZE=50
AI_GRADUATION_MIN_EDGE_PCT=5.0

# Sprint 4.3: Reflection + Memory loop (optional, default off)
# When enabled: creates trade post-mortem on close, retrieves similar past situations for AI context
MEMORY_ENABLED=false
MEMORY_TOP_K=3

# Optional: ML Guardian (Random Forest win probability filter)
# ML_MIN_CONFIDENCE: Minimum RF win probability to allow trade execution
#   0.50 = Random (coin flip) - NOT RECOMMENDED
#   0.55 = Slight edge - Aggressive (many trades, lower quality)
#   0.60 = Moderate edge - Balanced (RECOMMENDED for live trading)
#   0.65 = Strong edge - Conservative (fewer trades, higher quality)
#   0.70+ = Very strong edge - Ultra-conservative (very few trades)
# NOTE: RF model accuracy depends on training data. Monitor live results!
ML_GUARDIAN_ENABLED=true
ML_MIN_CONFIDENCE=0.60

# Optional: Trinity / risk
TRINITY_ENABLED=true
TRINITY_MAX_DAILY_LOSS_PCT=4
TRINITY_MAX_DRAWDOWN_PCT=8
TRINITY_MAX_RISK_PER_TRADE_PCT=1
TRINITY_MAX_POSITIONS=3
TRINITY_MAX_CURRENCY_EXPOSURE=2
TRINITY_MAX_CORRELATION_GROUP=1
TRINITY_ALLOW_HEDGING=false

# Optional: pricing
USDJPY_RATE=150
US30_POINT_VALUE=1
NAS100_POINT_VALUE=1

# Optional: Evaluation Mode (Prop Firm Challenge Tracking)
EVALUATION_MODE=false

# -----------------------------------------------------------------------------
# MetaApi Configuration (for backtesting and live execution)
# -----------------------------------------------------------------------------
# Get your credentials from: https://app.metaapi.cloud/
#
# DEFAULT BROKER (e.g., Vantage for Forex)
META_API_TOKEN=your-vantage-metaapi-token-here
META_API_ACCOUNT_ID=your-vantage-account-id-here
META_API_REGION=new-york

# Real-time streaming (DEV-39) — set false to fall back to polling only
# When true (default), a persistent WebSocket connection to MetaApi fires
# on_deal_added events → Net PnL written to DB → Supabase Realtime pushes to frontend
METAAPI_STREAMING_ENABLED=true

# VANTAGE BROKER (Forex: EURUSD, GBPUSD, etc.)
META_API_TOKEN_VANTAGE=your-vantage-metaapi-token-here
META_API_ACCOUNT_ID_VANTAGE=your-vantage-account-id-here

# FXCM/IC MARKETS BROKER (Metals/Indices: XAUUSD, NAS100, US30, etc.)
# NOTE: FXCM REST API is deprecated. Use FXCM via MetaApi instead!
# Or use IC Markets/Pepperstone for metals/indices
META_API_TOKEN_FXCM=your-fxcm-or-icmarkets-metaapi-token-here
META_API_ACCOUNT_ID_FXCM=your-fxcm-or-icmarkets-account-id-here
EVALUATION_PHASE=phase1
EVALUATION_START_DATE=

# Phase 1 Rules — FTMO Standard $50k defaults
# FTMO firm limits: 5% daily loss ($2,500), 10% overall DD ($5,000), 10% profit target ($5,000)
# Bot kills at 80% of each limit to leave a safety buffer before hard breach.
# Bot daily kill: $2,000 (4% of $50k) — $500 buffer before FTMO's $2,500 limit
# Bot DD kill:    8% ($4,000)         — 2%  buffer before FTMO's 10% limit
PHASE1_PROFIT_TARGET=5000.0
PHASE1_MAX_DAILY_LOSS=2000.0
PHASE1_MAX_DRAWDOWN_PCT=8.0
PHASE1_MIN_TRADING_DAYS=4

# Phase 2 Rules — same loss limits as Phase 1 for FTMO
PHASE2_PROFIT_TARGET=2500.0
PHASE2_MAX_DAILY_LOSS=2000.0
PHASE2_MAX_DRAWDOWN_PCT=8.0
PHASE2_MIN_TRADING_DAYS=4

# Funded Account Rules — FTMO: 5% daily, 10% trailing DD
FUNDED_MAX_DAILY_LOSS=2000.0
FUNDED_MAX_DRAWDOWN_PCT=8.0

# Consistency Target
CONSISTENCY_TARGET_PCT=70.0

# Optional: Portfolio Risk Management
PORTFOLIO_VAR_ENABLED=true
PORTFOLIO_MAX_VAR_USD=500.0
PORTFOLIO_MAX_VAR_PCT=5.0
SECTOR_LIMIT_FOREX_MAJORS=0.40
SECTOR_LIMIT_FOREX_JPY=0.20
SECTOR_LIMIT_PRECIOUS_METALS=0.10
CORRELATION_MATRIX_ENABLED=true
MAX_AVG_PORTFOLIO_CORRELATION=0.7

# Optional: Transaction Cost Analysis
TCA_ENABLED=true
TCA_SLIPPAGE_THRESHOLD_PIPS=3.0
# TCA Latency Thresholds (2026-03-11 Fix: Split bot vs broker latency)
# - Total latency: Set to 30s to account for broker delays on minor pairs (NZDJPY, GBPJPY, etc.)
# - Bot latency: Alert if guard rails (AI, VaR, sector checks) take > 10s
# - Broker latency: Info alert if MetaAPI/broker execution takes > 20s (not critical, just FYI)
TCA_LATENCY_THRESHOLD_MS=30000
TCA_BOT_LATENCY_THRESHOLD_MS=10000
TCA_BROKER_LATENCY_THRESHOLD_MS=20000

# =============================================================================
# NEW: PROP FIRM PROTECTION FEATURES (Trinity Engine v3.0)
# =============================================================================

# MTM Guardian: Real-time floating PnL tracking
# CRITICAL: Prevents -5% FTMO breach by including open positions in kill switch
MTM_GUARDIAN_ENABLED=true
MTM_CACHE_TTL_SECONDS=10

# Staleness Guard: Webhook latency protection
# CRITICAL: Rejects signals >5s old or with >3 pips price deviation (slippage prevention)
ENABLE_STALENESS_GUARD=true
STALENESS_MAX_AGE_SECONDS=5
STALENESS_MAX_PRICE_DEVIATION_PIPS=3.0

# Consistency Analyzer: FTMO 40% rule enforcement
# CRITICAL: Prevents best day from exceeding 40% of total profit
CONSISTENCY_ENABLED=true
CONSISTENCY_LIMIT_PCT=40.0

# =============================================================================
# v1.1 POSITION MANAGEMENT OPTIMIZATION (Phase 9)
# =============================================================================

# Breakeven Buffer: pips above entry (buys) / below entry (sells) when BE fires
# Purpose: prevents tiny losses from spread when price returns to exact entry
# Default 3 pips. Set to 0 to use Pine-supplied be_sl_price as-is.
BREAKEVEN_BUFFER_PIPS=3

# Trailing Stop — auto-activated after breakeven fires
# Distances are per instrument type (forex uses pips, indices use points)
TRAIL_DISTANCE_PIPS_FOREX=15      # Forex pairs (EURUSD, GBPUSD, etc.)
TRAIL_DISTANCE_POINTS_INDICES=30  # Index CFDs (NAS100, US30, UK100, etc.)
TRAIL_DISTANCE_PIPS_GOLD=50       # Gold/Silver (XAUUSD, XAGUSD)

# Trailing Activation — min pips from entry before trailing starts after BE
# 0 = trail starts immediately once BE fires (recommended)
# 5 = wait for price to move 5 more pips past BE before trailing
TRAIL_ACTIVATION_PIPS=0

# Optional: MetaAPI Configuration (Multi-Account Execution)
META_API_TOKEN=your_metaapi_token_here
META_API_ACCOUNT_ID=your_account_id_here
META_API_REGION=new-york

# Optional: Account Management Feature Flags
ACCOUNT_SYNC_ENABLED=false
ACCOUNT_SYNC_INTERVAL_SECONDS=60
ACCOUNT_RECONCILIATION_ENABLED=false
ACCOUNT_DETAIL_PAGE_ENABLED=true
ACCOUNT_JOURNAL_ENABLED=false
METAAPI_POSITIONS_FETCH_ENABLED=false

# Optional: CORS (API reads this)
FRONTEND_URL=

# -----------------------------------------------------------------------------
# WORKER – uses same config as Backend (SUPABASE_URL, REDIS_URL required)
# -----------------------------------------------------------------------------
# No extra variables. Worker runs as: python -m src.worker
# and reads the same .env as the API (SUPABASE_URL, REDIS_URL, etc.).

# -----------------------------------------------------------------------------
# FRONTEND – set in frontend/.env or as build/runtime env for Docker
# -----------------------------------------------------------------------------
# Required for Supabase (signals, auth). NEXT_PUBLIC_* are baked at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: backend API base (for health checks, future server actions)
NEXT_PUBLIC_API_URL=http://localhost:8000
