# =============================================================================
# ENVIRONMENT VARIABLES BY APP
# =============================================================================
# Copy to .env and fill in values. DO NOT commit .env with real credentials.
#
# Quick reference – required per app:
#
#   BACKEND (API)    Required: SUPABASE_URL, REDIS_URL
#   WORKER           Required: SUPABASE_URL, REDIS_URL (same .env as API)
#   FRONTEND         Required: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
#                    Optional: NEXT_PUBLIC_API_URL
#
# - Backend and Worker use project root .env (loaded by start.sh or Docker).
# - Frontend uses frontend/.env or Docker build args (NEXT_PUBLIC_* at build).
#
# REDUNDANT: Use ONE per group. Settings accept aliases; keep one and delete the rest.
#   Supabase anon: SUPABASE_ANON_KEY (or SUPABASE_KEY)
#   Supabase service: SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_SERVICE_KEY)
#   AI/LLM key: OPENAI_API_KEY (or AI_API_KEY or ANTHROPIC_API_KEY)
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (API) – required for uvicorn src.api:app
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
REDIS_URL=redis://localhost:6379

# Optional: webhook auth (empty = no secret check)
WEBHOOK_SECRET=

# Optional: Supabase – set ONE anon key and optionally ONE service key
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: notifications
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: execution
TRADING_KILL_SWITCH=false
LIVE_TRADING=false
RUN_MODE=DRY_RUN
LIVE_SHADOW=true
PAPER_TRADING_ENABLED=false
PAPER_AUTO_EXECUTE=true
PAPER_SYMBOLS=
PAPER_MAX_POSITIONS=10
PAPER_ACCOUNT_BALANCE=10000
ACCOUNT_BALANCE=10000

# Pine-aligned risk settings (Balanced profile)
RISK_PERCENT=0.5
MIN_RR_RATIO=2.0
STOP_LOSS_BUFFER_PIPS=1.0
MAX_LOT_SIZE=10.0
GOLD_PIP_DIVISOR=0.1

# Kelly Criterion position sizing (optional but recommended)
KELLY_ENABLED=false
KELLY_FRACTION=0.25

# Optional: AI Guardian + Ensemble Brain – set ONE of OPENAI_API_KEY / AI_API_KEY / ANTHROPIC_API_KEY
AI_FILTER_ENABLED=true
AI_PROVIDER=anthropic
OPENAI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MIN_CONFIDENCE=75
AI_TIMEOUT_SECONDS=5
AI_MODEL=llama-3.3-70b-versatile

# Optional: ML Guardian (Random Forest win probability filter)
# ML_MIN_CONFIDENCE: Minimum RF win probability to allow trade execution
#   0.50 = Random (coin flip) - NOT RECOMMENDED
#   0.55 = Slight edge - Aggressive (many trades, lower quality)
#   0.60 = Moderate edge - Balanced (RECOMMENDED for live trading)
#   0.65 = Strong edge - Conservative (fewer trades, higher quality)
#   0.70+ = Very strong edge - Ultra-conservative (very few trades)
# NOTE: RF model accuracy depends on training data. Monitor live results!
ML_GUARDIAN_ENABLED=true
ML_MIN_CONFIDENCE=0.60

# Optional: Trinity / risk
TRINITY_ENABLED=true
TRINITY_MAX_DAILY_LOSS_PCT=4
TRINITY_MAX_DRAWDOWN_PCT=8
TRINITY_MAX_RISK_PER_TRADE_PCT=1
TRINITY_MAX_POSITIONS=3
TRINITY_MAX_CURRENCY_EXPOSURE=2
TRINITY_MAX_CORRELATION_GROUP=1
TRINITY_ALLOW_HEDGING=false

# Optional: pricing
USDJPY_RATE=150
US30_POINT_VALUE=1
NAS100_POINT_VALUE=1

# Optional: Evaluation Mode (Prop Firm Challenge Tracking)
EVALUATION_MODE=false

# -----------------------------------------------------------------------------
# MetaApi Configuration (for backtesting and live execution)
# -----------------------------------------------------------------------------
# Get your credentials from: https://app.metaapi.cloud/
#
# DEFAULT BROKER (e.g., Vantage for Forex)
META_API_TOKEN=your-vantage-metaapi-token-here
META_API_ACCOUNT_ID=your-vantage-account-id-here
META_API_REGION=new-york

# VANTAGE BROKER (Forex: EURUSD, GBPUSD, etc.)
META_API_TOKEN_VANTAGE=your-vantage-metaapi-token-here
META_API_ACCOUNT_ID_VANTAGE=your-vantage-account-id-here

# FXCM/IC MARKETS BROKER (Metals/Indices: XAUUSD, NAS100, US30, etc.)
# NOTE: FXCM REST API is deprecated. Use FXCM via MetaApi instead!
# Or use IC Markets/Pepperstone for metals/indices
META_API_TOKEN_FXCM=your-fxcm-or-icmarkets-metaapi-token-here
META_API_ACCOUNT_ID_FXCM=your-fxcm-or-icmarkets-account-id-here
EVALUATION_PHASE=phase1
EVALUATION_START_DATE=

# Phase 1 Rules (FTMO/MyFundedFX style)
PHASE1_PROFIT_TARGET=5000.0
PHASE1_MAX_DAILY_LOSS=500.0
PHASE1_MAX_DRAWDOWN_PCT=5.0
PHASE1_MIN_TRADING_DAYS=4

# Phase 2 Rules
PHASE2_PROFIT_TARGET=2500.0
PHASE2_MAX_DAILY_LOSS=500.0
PHASE2_MAX_DRAWDOWN_PCT=5.0
PHASE2_MIN_TRADING_DAYS=4

# Funded Account Rules
FUNDED_MAX_DAILY_LOSS=500.0
FUNDED_MAX_DRAWDOWN_PCT=10.0

# Consistency Target
CONSISTENCY_TARGET_PCT=70.0

# Optional: Portfolio Risk Management
PORTFOLIO_VAR_ENABLED=true
PORTFOLIO_MAX_VAR_USD=500.0
PORTFOLIO_MAX_VAR_PCT=5.0
SECTOR_LIMIT_FOREX_MAJORS=0.40
SECTOR_LIMIT_FOREX_JPY=0.20
SECTOR_LIMIT_PRECIOUS_METALS=0.10
CORRELATION_MATRIX_ENABLED=true
MAX_AVG_PORTFOLIO_CORRELATION=0.7

# Optional: Transaction Cost Analysis
TCA_ENABLED=true
TCA_SLIPPAGE_THRESHOLD_PIPS=3.0
TCA_LATENCY_THRESHOLD_MS=5000

# =============================================================================
# NEW: PROP FIRM PROTECTION FEATURES (Trinity Engine v3.0)
# =============================================================================

# MTM Guardian: Real-time floating PnL tracking
# CRITICAL: Prevents -5% FTMO breach by including open positions in kill switch
MTM_GUARDIAN_ENABLED=true
MTM_CACHE_TTL_SECONDS=10

# Staleness Guard: Webhook latency protection
# CRITICAL: Rejects signals >5s old or with >3 pips price deviation (slippage prevention)
ENABLE_STALENESS_GUARD=true
STALENESS_MAX_AGE_SECONDS=5
STALENESS_MAX_PRICE_DEVIATION_PIPS=3.0

# Consistency Analyzer: FTMO 40% rule enforcement
# CRITICAL: Prevents best day from exceeding 40% of total profit
CONSISTENCY_ENABLED=true
CONSISTENCY_LIMIT_PCT=40.0

# Optional: MetaAPI Configuration (Multi-Account Execution)
META_API_TOKEN=your_metaapi_token_here
META_API_ACCOUNT_ID=your_account_id_here
META_API_REGION=new-york

# Optional: Account Management Feature Flags
ACCOUNT_SYNC_ENABLED=false
ACCOUNT_SYNC_INTERVAL_SECONDS=60
ACCOUNT_RECONCILIATION_ENABLED=false
ACCOUNT_DETAIL_PAGE_ENABLED=true
ACCOUNT_JOURNAL_ENABLED=false
METAAPI_POSITIONS_FETCH_ENABLED=false

# Optional: CORS (API reads this)
FRONTEND_URL=

# -----------------------------------------------------------------------------
# WORKER – uses same config as Backend (SUPABASE_URL, REDIS_URL required)
# -----------------------------------------------------------------------------
# No extra variables. Worker runs as: python -m src.worker
# and reads the same .env as the API (SUPABASE_URL, REDIS_URL, etc.).

# -----------------------------------------------------------------------------
# FRONTEND – set in frontend/.env or as build/runtime env for Docker
# -----------------------------------------------------------------------------
# Required for Supabase (signals, auth). NEXT_PUBLIC_* are baked at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: backend API base (for health checks, future server actions)
NEXT_PUBLIC_API_URL=http://localhost:8000
