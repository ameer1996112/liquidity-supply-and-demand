# Supabase Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file with real credentials

# Your Supabase project URL
# Find this in: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous key (public key)
# Find this in: Supabase Dashboard > Settings > API > Project API keys > anon/public
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-key-here
