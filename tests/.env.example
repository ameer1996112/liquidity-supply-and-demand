# Test Configuration
# Copy this to .env and fill in your values

# Webhook Configuration
WEBHOOK_URL=https://grand-learning-production-bc96.up.railway.app
WEBHOOK_PASSPHRASE=your_webhook_passphrase_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Discord Webhook (Optional - for notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Railway Environment (Optional - for deployment tracking)
RAILWAY_ENVIRONMENT=local
RAILWAY_DEPLOYMENT_ID=manual
