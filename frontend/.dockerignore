# .dockerignore - Frontend (Dashboard) Service
# Excludes backend and unnecessary files from Next.js Docker builds

# ===== BACKEND (Python) - CRITICAL =====
# When Root Directory is set to /dashboard in Railway,
# these paths are relative to dashboard/ but we include
# them for safety if building from repo root
../backend/
../start.sh
../nixpacks.toml
../tests/
../scripts/
../docs/
../config/

# ===== Node.js artifacts =====
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== Build cache =====
.cache/
*.tsbuildinfo

# ===== Git & Version Control =====
.git/
.gitignore

# ===== IDE & Editor =====
.vscode/
.cursor/
.idea/
*.swp
*.swo
.DS_Store

# ===== Environment files =====
.env
.env.local
.env.*.local

# ===== Test files =====
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
coverage/
.nyc_output/

# ===== Documentation =====
*.md

# ===== Logs =====
*.log
