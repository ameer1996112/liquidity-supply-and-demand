# API (Signal Receiver) - v9 DDD
FROM python:3.11-slim

WORKDIR /app

# Install all Python dependencies for API + shared code (RAG, OpenAI, etc.)
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY config/ config/
COPY src/ src/
COPY ml/ ml/
COPY scripts/ scripts/
COPY start.sh .

ENV PYTHONPATH=/app

EXPOSE 8000

# Use the same entrypoint script as Railway (starts API + worker if desired)
CMD ["./start.sh"]
