# API (Signal Receiver) - v9 DDD
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir fastapi uvicorn[standard] redis pydantic-settings python-dotenv

COPY config/ config/
COPY src/ src/

ENV PYTHONPATH=/app

EXPOSE 8000
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
